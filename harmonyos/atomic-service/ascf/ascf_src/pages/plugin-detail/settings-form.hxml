  <view class="config-panel">
    <text has:if="{{!connected && !config}}" class="config-hint">{{ui['网关已断开，插件状态待重新连接确认']}}</text>
    <text has:if="{{configStatus === 'loading'}}" class="config-hint">{{ui['正在加载设置…']}}</text>
    <text has:if="{{configError}}" class="pdetail-err">{{ui[configError] !== undefined ? ui[configError] : configError}}</text>
    <button has:if="{{configStatus === 'error'}}" class="config-button" bindtap="loadSettings">{{ui['重试']}}</button>
    <block has:if="{{config}}">
      <text has:if="{{!connected}}" class="config-hint">{{ui['网关已断开，插件状态待重新连接确认']}}</text>
      <text has:if="{{!config.writable && config.kind !== 'voice'}}" class="config-hint">{{ui['本部署的设置为只读。']}}</text>
      <block has:if="{{config.kind === 'web-search'}}">
        <view class="config-toggle"><text class="config-label">{{config.labels.useSearchApi}}</text><dsh-switch checked="{{config.useSearchApi}}" disabled="{{config.disabled || !config.switchAvailable}}" bindchange="onSearchApiChange"/></view>
        <text class="config-hint">{{config.labels.useSearchApiHint}}</text>
        <text class="config-link" bindtap="openSearchGuide">{{config.labels.searchGuide}}</text>
        <view class="config-field"><text class="config-label">{{config.labels.apiKey}}</text>
          <input class="config-input" password value="{{config.secret}}" disabled="{{config.disabled || !config.credential.writable}}" bindinput="onConfigSecret" maxlength="8192"/>
          <text class="config-hint">{{config.labels.apiKeyHint}}</text>
          <text has:if="{{config.credential.unavailable}}" class="config-hint">{{ui['当前网关尚未开放此功能，请更新网关后重试。']}}</text>
          <text has:elif="{{config.credential}}" class="config-hint">{{config.credential.configured ? config.labels.apiKeySet : config.labels.apiKeyUnset}}</text>
        </view>
      </block>
      <block has:if="{{config.kind === 'cot-translation'}}">
        <text class="config-hint">{{config.labels.privacy}}</text>
        <text class="config-hint">{{config.translationPaid ? config.labels.paidNotice : config.labels.anonymousNotice}}</text>
        <text has:if="{{configProvidersUnavailable}}" class="config-hint">{{config.labels.providerUnavailable}}</text>
      </block>
      <text has:if="{{config.kind === 'subagent'}}" class="config-heading">{{config.labels.subagentLimitsTitle}}</text>
      <view has:for="{{config.fields}}" has:key="id" class="config-field">
        <view class="config-label-row"><text class="config-label">{{item.label}}</text><text has:if="{{item.overridden}}" class="config-tag">{{ui['已覆盖']}}</text><button has:if="{{item.overridden || config.dirty}}" class="config-reset" disabled="{{config.disabled || !item.available}}" data-id="{{item.id}}" bindtap="resetConfigField">{{ui['恢复默认']}}</button></view>
        <picker has:if="{{item.isChoice}}" range="{{item.choiceLabels}}" value="{{item.choiceIndex}}" disabled="{{config.disabled || !item.available || configProvidersUnavailable}}" data-id="{{item.id}}" bindchange="onConfigChoice"><view class="config-input config-select"><text>{{item.choiceLabel || item.value}}</text><view class="config-chevron"></view></view></picker>
        <input has:else class="config-input" value="{{item.value}}" placeholder="{{item.placeholder}}" disabled="{{config.disabled || !item.available}}" data-id="{{item.id}}" bindinput="onConfigInput" type="{{item.numeric ? 'digit' : 'text'}}" maxlength="2048"/>
        <text has:if="{{item.hint}}" class="config-hint">{{item.hint}}</text>
        <text has:if="{{!item.available}}" class="config-hint">{{ui['该插件当前未加载，暂时无法配置。']}}</text>
      </view>
      <block has:if="{{config.kind === 'voice'}}"><include src="voice-settings.hxml"/></block>
      <view has:if="{{config.kind !== 'voice'}}" class="config-actions"><button class="config-button config-save" disabled="{{config.disabled || !config.dirty}}" loading="{{configSaving}}" bindtap="saveSettings">{{configSaving ? ui['保存中…'] : ui['保存']}}</button><button class="config-button" disabled="{{configSaving}}" bindtap="discardSettings">{{ui['放弃修改']}}</button></view>
    </block>
  </view>
