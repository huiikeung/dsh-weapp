@import "../../styles/quota-sidebar.wxss";
/* 原生页面窗口底色：抽屉打开时圆角外露的上/下区域与抽屉保持一致。 */
page {
  background: #FFFFFF;
}

@media (prefers-color-scheme: dark) {
  page {
    background: #141518;
  }
}

/* 内容水平边距对齐 iOS WorkspaceView：.padding(.horizontal, 22) = 44rpx */
.home {
  padding: 30rpx 44rpx 60rpx;
}

/* ---------- 侧边栏（对齐 dsh-mobile WorkspaceView drawer） ---------- */

.home-root {
  position: relative;
  height: 100vh;
  overflow: hidden;
  /* Full-screen drawer surface beneath the moving home panel. */
  background: #FFFFFF;
}

.home-root.theme-dark {
  background: #141518;
}

.home-content-wrap {
  position: relative;
  z-index: 53;
  height: 100vh;
  background: var(--navy);
}

.home-content-wrap.shifted {
  overflow: hidden;
  /* 光边、内投影全部收进内容内部：圆角外露的是侧栏背板（.home-root），
     任何向外投影都会让它变色。这里用 inset 叠出悬浮玻璃质感。 */
  box-shadow:
    inset 3rpx 0 0 rgba(255, 255, 255, 0.24),
    inset 8rpx 0 18rpx rgba(255, 255, 255, 0.08),
    inset 12rpx 0 30rpx rgba(0, 0, 0, 0.16),
    inset 26rpx 0 60rpx rgba(0, 0, 0, 0.14);
}

/* 深色底保持侧栏原色：把更强的光边和悬浮内投影放在内容内部，
     圆角外露的 #141518 背板不会被提亮或压暗。 */
.theme-dark .home-content-wrap.shifted {
  border-left: 0;
  box-shadow:
    inset 3rpx 0 0 rgba(255, 255, 255, 0.40),
    inset 9rpx 0 22rpx rgba(255, 255, 255, 0.14),
    inset 14rpx 0 40rpx rgba(0, 0, 0, 0.42),
    inset 30rpx 0 78rpx rgba(0, 0, 0, 0.46);
}

/* 深海背景随内容位移：fixed → absolute（相对位移容器） */
.home-deep-bg {
  position: absolute;
  z-index: 0;
}

.home-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
}

.drawer-anim {
  transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1);
}

.home-content-wrap.drawer-anim {
  transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1), border-radius 0.38s cubic-bezier(0.32, 0.72, 0, 1), box-shadow 0.38s cubic-bezier(0.32, 0.72, 0, 1);
}

.drawer {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 52;
  background: #FFFFFF;
  transform: translateX(-100%);
}

.drawer-body {
  padding: calc(20rpx + env(safe-area-inset-top)) 36rpx calc(24rpx + env(safe-area-inset-bottom));
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* 底部组：额度卡片 + 设置入口贴底（卡片在设置上方） */
.drawer-bottom { width: 100%; margin-top: auto; flex-shrink: 0; }
.drawer-footer { width: 100%; padding-top: 24rpx; flex-shrink: 0; }
.drawer-settings { box-sizing: border-box; }

/* 侧栏额度卡片容器（卡片本体样式见 styles/quota-sidebar.wxss，四种布局共用） */
.qs-wrap { width: 100%; margin: 18rpx 0 12rpx; }
.qs-pressed { opacity: .78; }
.drawer-cost-unavailable { display: flex; width: 100%; box-sizing: border-box; flex-direction: column; gap: 6rpx; margin: 18rpx 0 12rpx; padding: 17rpx 22rpx; border: 1rpx solid rgba(122, 142, 175, .16); border-radius: 20rpx; background: rgba(116, 133, 161, .07); }
.drawer-cost-unavailable-title { color: var(--text); font-size: 26rpx; font-weight: 620; }
.drawer-cost-unavailable-hint { color: var(--text-3); font-size: 21rpx; line-height: 1.4; }

.drawer-brand {
  display: flex;
  align-items: center;
  padding: 0 0 32rpx 24rpx;
  width: 100%;
}

.drawer-whale {
  width: 58rpx;
  height: 58rpx;
  margin-right: 7rpx;      /* 缩小一半，与首页一致 */
  margin-top: -8rpx;
  flex: none;
}

.drawer-brand-badge {
  color: #FFFFFF;
  background: #10151F;
  border: 0;
  border-radius: 8rpx;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 30rpx;
  height: 30rpx;
  padding: 0 12rpx;
  margin-top: 1rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.drawer-whale-dark {
  display: none;
}

.drawer-item {
  display: flex;
  align-items: center;
  width: 100%;
  height: 104rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
}

.drawer-item-active {
  background: rgba(16, 19, 24, 0.06);
}

.drawer-item-ic {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.drawer-item-ic-clock {
  width: 44rpx;
  height: 44rpx;
  margin-left: 0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.drawer-item-ic-dark {
  display: none;
}

.drawer-item-text {
  font-size: 34rpx;
  color: var(--ink);
}

.drawer-mask {
  /* 压在 home-content-wrap（z-index: 53）内部：只压暗主内容本身。
     若留在根层会盖到页面根背景，在内容圆角处压出 16% 灰边，露出「断层」。 */
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: #000000;
}

.brand-dim {
  opacity: 0.7;
}


/* 顶部品牌行：固定在导航区（与胶囊同行），左边距与内容区对齐，不随内容滚动 */
.topbar {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  /* 与内容区同边距：品牌行 / 选择主机 / 标题 / 卡片左边缘严格对齐 */
  padding-left: 44rpx;
  padding-right: 44rpx;
  /* 透明：让深海背景自然延续到顶，不再出现深色条断层 */
  background: transparent;
}

/* 品牌行随内容滚动（在 scroll-view 内） */
.topbar-inline {
  display: flex;
  align-items: center;
  padding: 0;              /* 水平位置由 .home 的 44rpx 内边距决定，保持原位 */
  margin-bottom: 14px;     /* 与改动前一致（原间距是 px，不是 rpx） */
  flex-shrink: 0;
}

.host-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.host-row .host-bar {
  margin-bottom: 0;
  min-width: 0;
}

.host-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.brand-row {
  display: flex;
  align-items: center;
  transform: translateY(2px);
}

.brand-mark {
  font-size: 40rpx;
  margin-right: 14rpx;
}

.brand-badge {
  color: #10151F;
  background: #FFFFFF;
  border: 0;
  border-radius: 8rpx;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 30rpx;
  height: 30rpx;          /* 与 whaletail 大写字高一致 */
  padding: 0 12rpx;
  margin-top: 1rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

/* ---------- 配对菜单（对齐 dsh-mobile GatewayAuthenticationMenu） ---------- */

.pair-wrap {
  position: relative;
}

/* 配对菜单弹出时按钮本身隐藏（对齐工作区卡片被弹层替代的行为） */
.pair-wrap.pair-menu-open .icon-btn {
  visibility: hidden;
}

.pair-menu-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
}

/* 配对菜单：与底部弹窗同款深炭玻璃（深色底 + 强模糊 + 发丝亮边） */
.pair-menu {
  position: absolute;
  top: calc(100% + 12rpx);
  right: 0;
  z-index: 100;
  width: 496rpx;
  transform-origin: 100% 0;   /* 从按钮位置向左下展开 */
  animation: pair-menu-in 180ms cubic-bezier(0.32, 0.72, 0, 1) both;
  will-change: transform, opacity;
  padding: 12rpx 0;
  /* 与工作区选择弹窗完全一致：同一套白纱 + blur(8rpx) */
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border-radius: 36rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 16rpx 48rpx rgba(3, 14, 30, 0.26);
  overflow: hidden;
}

@keyframes pair-menu-in {
  from { opacity: 0; transform: scale(0.86) translateY(-10rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.pair-menu-item {
  display: flex;
  align-items: center;
  height: 116rpx;
  padding: 0 44rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.pair-menu-item-active {
  background: rgba(255, 255, 255, 0.08);
}

.pair-menu-ic {
  width: 36rpx;          /* 固定宽度：保证右侧文字对齐 */
  height: 36rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 扫描图标：CSS 绘制，矢量清晰（四角括 + 3 定位块 + 点阵） */
.ico-scan {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.ico-scan .corner {
  position: absolute;
  width: 11rpx;
  height: 11rpx;
  border: 3rpx solid #FFFFFF;
  box-sizing: border-box;
}

.ico-scan .corner.tl { left: 0; top: 0; border-right: 0; border-bottom: 0; border-top-left-radius: 5rpx; }
.ico-scan .corner.tr { right: 0; top: 0; border-left: 0; border-bottom: 0; border-top-right-radius: 5rpx; }
.ico-scan .corner.bl { left: 0; bottom: 0; border-right: 0; border-top: 0; border-bottom-left-radius: 5rpx; }
.ico-scan .corner.br { right: 0; bottom: 0; border-left: 0; border-top: 0; border-bottom-right-radius: 5rpx; }

.ico-scan .find {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #FFFFFF;
  box-sizing: border-box;
  border-radius: 2rpx;
}

.ico-scan .find::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 3rpx;
  margin-left: -1.5rpx;
  margin-top: -1.5rpx;
  background: #FFFFFF;
  border-radius: 1rpx;
}

.ico-scan .find.a { left: 7rpx; top: 7rpx; }
.ico-scan .find.b { right: 7rpx; top: 7rpx; }
.ico-scan .find.c { left: 7rpx; bottom: 7rpx; }

.ico-scan .dots {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 2rpx;
}

.ico-scan .dots view {
  width: 3rpx;
  height: 3rpx;
  background: #FFFFFF;
  border-radius: 1rpx;
}

/* 键盘图标：CSS 绘制（圆角外框 + 两排键 + 空格条） */
.ico-keyboard {
  position: relative;
  width: 36rpx;                 /* 与另两个图标等宽 */
  height: 26rpx;
  box-sizing: border-box;
  border: 2rpx solid #FFFFFF;
  border-radius: 6rpx;
  padding: 4rpx 4rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ico-keyboard .kb-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ico-keyboard .kb-row view {
  width: 4rpx;
  height: 4rpx;
  background: #FFFFFF;
  border-radius: 1rpx;
}

.ico-keyboard .kb-last {
  justify-content: space-between;
}

.ico-keyboard .kb-bar {
  flex: 1;
  width: auto;
  height: 4rpx;
  margin: 0 2rpx;
  border-radius: 2rpx;
}

.icon-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 18rpx;
  flex-shrink: 0;
  font-size: 38rpx;
  /* Liquid Glass 圆钮：左上高光渐变 + 顶部内发光 + 发丝亮边 */
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 8rpx 24rpx rgba(3, 14, 30, 0.24);
}

/* Hero（iOS：32pt bold 标题 + subheadline 副标题；区块间距 18pt = 36rpx） */
.hero {
  margin-top: 120rpx;     /* 标题及其以下内容整体下移 */
  margin-bottom: 36rpx;
}

.title-hero {
  color: #FFFFFF;
  font-size: 50rpx;      /* 连接/未连接统一 50rpx（未连接没有副标题） */
  font-weight: 700;
  letter-spacing: 0;
}

.subtitle-hero {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 26rpx;      /* 副标题比标题低一档，跟 50rpx 标题配比 */
}

/* 工作区卡片（与新建会话同款玻璃：渐变高光 + 顶部内发光 + 模糊提饱和） */
.workspace-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;   /* 高度减小一点 */
  margin-bottom: 36rpx;
  border-radius: 36rpx;
  /* 与「新建会话」同一套 Liquid Glass：高光渐变 + 发丝亮边 + 内高光 */
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 8rpx 32rpx rgba(3, 14, 30, 0.18);
}

.ws-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.ws-body {
  flex: 1;
  min-width: 0;
}

.ws-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.ws-path {
  color: rgba(255, 255, 255, 0.55);
  font-size: 24rpx;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ws-right {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.ws-chevron {
  width: 30rpx;
  height: 30rpx;
  margin-left: 18rpx;
}

/* 新建会话（iOS glassSurface radius 18pt + white 8% tint） */
.new-session {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  border-radius: 32rpx;
  padding: 18rpx 0;      /* 卡片高度减小 */
  margin-bottom: 36rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 8rpx 32rpx rgba(3, 14, 30, 0.18);
  transition: transform 0.18s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.18s ease;
}

.new-session:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.plus-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.20);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 22rpx;
}

.new-session-text {
  color: #FFFFFF;
  font-size: 30rpx;      /* iOS headline 17pt */
  font-weight: 600;
}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* 「最近会话」比全局 section-title 再小一档 */
.recent-header .section-title {
  font-size: 28rpx;
}

.conn-label {
  font-size: 24rpx;      /* iOS caption 12pt */
}

.conn-label.connected { color: var(--success); }
.conn-label.connecting { color: var(--amber); }
.conn-label.disconnected { color: rgba(255, 255, 255, 0.60); }
.conn-label.failed { color: var(--orange); }
.conn-label.dropped { color: #FF5A5F; }

.status-dot.connecting { background: var(--amber); }
.status-dot.disconnected { background: rgba(255, 255, 255, 0.34); }
/* 连接故障 = 橙；断链（曾连上又掉线）= 红 */
.status-dot.failed { background: var(--orange); }
.status-dot.dropped { background: #FF5A5F; box-shadow: 0 0 10rpx rgba(255, 90, 95, 0.55); }
/* 已连接绿点：加一点光晕 */
.status-dot.connected { box-shadow: 0 0 10rpx rgba(46, 184, 92, 0.55), 0 0 2rpx rgba(46, 184, 92, 0.35); }

/* 搜索框（与新建会话同款玻璃：渐变高光 + 顶部内发光 + 模糊提饱和） */
.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;      /* 比原来矮一档 */
  padding: 0 24rpx;
  border-radius: 26rpx;
  margin-bottom: 28rpx;   /* 与第一条会话再靠近一点 */
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
  border: 1rpx solid transparent;                            /* 边框用亚像素内阴影画，视觉更细 */
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 0 0 0.5rpx rgba(255, 255, 255, 0.10), inset 0 0.5rpx 0 rgba(255, 255, 255, 0.03), 0 8rpx 32rpx rgba(3, 14, 30, 0.16);
}

.search-icon {
  width: 40rpx;         /* 放大镜的圆更明显 */
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  opacity: 0.52;        /* 白色图标压暗，避免比占位文字还亮 */
}

.search-result-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

/* 配对按钮：对齐 dsh-mobile GlassCircleButton 52dp/22dp 比例 */
.pair-ic {
  width: 48rpx;
  height: 48rpx;
}

.plus-img {
  width: 30rpx;
  height: 30rpx;
}

.search-input {
  flex: 1;
  color: #FFFFFF;
  font-size: 30rpx;      /* 比正文再小一档 */
}

.home-data-hint {
  margin: -20rpx 0 16rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 24rpx;
}

.home-data-hint.home-connection-error {
  color: var(--orange);
}

/* 会话行（iOS sessionRow：padding-v 10pt / 间距 11pt / 点 7pt /
   分隔线 white 10% 缩进 18pt） */
.session-row {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  position: relative;
  background: transparent;
  border-radius: 16rpx;
}

.session-row::after {
  content: '';
  position: absolute;
  left: 36rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.10);
}

.session-swipe:last-child .session-row::after {
  display: none;
}

/* 会话行左滑手势 */
.session-swipe {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}

.session-swipe .session-row {
  position: relative;
  z-index: 1;
  transition: transform 0.18s ease;
  will-change: transform;
}

/* 菜单弹出时该行隐藏：弹窗原地占位 */
.session-row-hidden,
.session-row-hidden::after {
  visibility: hidden;
}

/* 滑动中的行需不透明底色，否则按钮会透出来 */
.session-swipe.open .session-row {
  background: var(--navy);
}

.session-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  /* 仅被滑动的那一行显示操作层（会话行为透明底） */
  visibility: hidden;
}

.session-actions.show {
  visibility: visible;
}

.session-action {
  width: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  line-height: 1.2;
}

.session-action.rename {
  background: rgba(46, 107, 230, 0.92);
}

.session-action.archive {
  background: rgba(214, 69, 69, 0.92);
}


/* 状态灯四态：默认灰点 / 完成 24h 内绿点 / 运行中旋转圆环 / 未读蓝点 */
.session-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  margin-right: 22rpx;
  flex-shrink: 0;
}

.session-dot.done {
  background: var(--success);
  box-shadow: 0 0 10rpx rgba(46, 184, 92, 0.55), 0 0 2rpx rgba(46, 184, 92, 0.35);   /* 绿点微光晕 */
}

.session-dot.running {
  width: 16rpx;
  height: 16rpx;
  box-sizing: border-box;
  background: transparent;
  box-shadow: none;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: rgba(255, 255, 255, 0.82);
  animation: sessionDotSpin 0.9s linear infinite;
}

.session-dot.unread {
  background: var(--ocean);
}

@keyframes sessionDotSpin {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .session-dot.running { animation-duration: 2s; }
}

.session-body {
  flex: 1;
  min-width: 0;
}

.session-title {
  color: #FFFFFF;
  font-size: 28rpx;      /* 比之前小一档 */
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-sub {
  color: rgba(255, 255, 255, 0.42);
  font-size: 20rpx;      /* 比原来小一档 */
  margin-top: 2rpx;      /* 与标题更贴近 */

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  color: rgba(255, 255, 255, 0.48);
  font-size: 22rpx;      /* 右侧时间比原来小一档 */
  margin-left: 18rpx;
  flex-shrink: 0;
}

.session-time.running {
  color: #0A84FF;
}

/* 空态（iOS emptySessions：white 4% 底 / radius 15pt / padding 18pt / 左对齐） */
.empty {
  color: rgba(255, 255, 255, 0.5);
  text-align: left;
  padding: 36rpx;
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 30rpx;
}

/* ---------- 切换主机（GatewaySwitcherBar / Sheet） ---------- */

.host-bar {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025));
  border: 1rpx solid rgba(255, 255, 255, 0.20);
  border-radius: 999rpx;
  margin-bottom: 48rpx;
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 8rpx 24rpx rgba(3, 14, 30, 0.22);
}

.host-kind {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.host-name {
  color: #FFFFFF;
  font-size: 24rpx;
  max-width: 340rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.host-dot {
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #8E8E93;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.host-dot.on {
  background: var(--success);
}
/* 已连接按线路族着色：局域网=绿、公网=蓝（与名字后的徽标同色） */
.host-dot.link-lan { background: var(--success); }
.host-dot.link-public { background: #6AA4FF; }
/* 连接故障 = 橙；断链（曾连上又掉线）= 红 */
.host-dot.failed { background: var(--orange); }
.host-dot.dropped { background: #FF5A5F; }

/* 主机线路徽标：名字后的小胶囊，局域网绿 / 公网蓝 */
.host-link-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-sizing: border-box;
  min-height: 30rpx;
  padding: 0 10rpx;
  margin-left: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.20);
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.2;
}

.host-link-badge.is-lan {
  color: #7BE39E;
  border-color: rgba(123, 227, 158, 0.35);
  background: rgba(123, 227, 158, 0.10);
}

.host-link-badge.is-public {
  color: #9CC2FF;
  border-color: rgba(156, 194, 255, 0.32);
  background: rgba(156, 194, 255, 0.10);
}

.host-chev {
  width: 22rpx;
  height: 22rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.host-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 60;
}

/* 主机切换 sheet（对齐 iOS 高 detent 弹层：深炭玻璃 + 抓手 +
   居中标题 + 左侧编辑玻璃钮 + 内嵌分组卡片；
   默认紧凑高度，抓手拖拽/点击展开到近全屏） */
.host-sheet {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 61;
  display: flex;
  flex-direction: column;
  height: auto;
  min-height: 46vh;      /* 默认高度更高 */
  max-height: 86vh;
  /* 切换主机：白纱回到卡片同款（0.10 → 0.04），模糊保留一档轻磨砂 */
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(14rpx) saturate(1.15);
  -webkit-backdrop-filter: blur(14rpx) saturate(1.15);
  border-radius: 40rpx;
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 16rpx 48rpx rgba(3, 14, 30, 0.26);
  transition: height 0.5s cubic-bezier(0.32, 0.72, 0, 1);
}

.host-sheet.expanded {
  height: calc(100vh - 200rpx);
}

/* 编辑主机：在原「切换主机」弹窗内直接展开，高度沿用原弹窗 */
.host-sheet.host-sheet-editing {
  padding-top: 8rpx;
}

.workspace-picker-sheet.expanded {
  height: calc(100vh - 200rpx);
}

.sheet-grabber-zone {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 4rpx;
  flex-shrink: 0;
}

.host-sheet-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  flex-shrink: 0;
}

.host-sheet-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  pointer-events: none;
}

.host-sheet-left {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.host-sheet-edit {
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.30);
}

.host-sheet-right {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.host-sheet-del {
  color: #FF3B30;
  font-size: 28rpx;
  margin-left: 20rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(165deg, rgba(255, 59, 48, 0.22), rgba(255, 59, 48, 0.10));
  border: 1rpx solid rgba(255, 59, 48, 0.45);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.host-diag {
  font-size: 24rpx;
  color: rgba(255, 176, 92, 0.95);
  padding: 10rpx 6rpx 0;
}

.host-section-label {
  color: rgba(255, 255, 255, 0.50);
  font-size: 28rpx;
  font-weight: 600;
  margin: 12rpx 8rpx 16rpx;
  flex-shrink: 0;
}

.host-list {
  flex: 1;
  overflow-y: auto;
}

.host-group {
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  overflow: hidden;
}

.host-opt {
  position: relative;
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
}

.host-opt::after {
  content: '';
  position: absolute;
  left: 100rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.10);
}

.host-opt:last-child::after {
  display: none;
}

.host-select {
  display: flex;
  align-items: center;
  margin-right: 18rpx;
}

.host-select-ic {
  width: 40rpx;
  height: 40rpx;
}

.host-row-kind {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.host-row-body {
  flex: 1;
  min-width: 0;
}

.host-row-title {
  display: flex;
  align-items: center;
  min-width: 0;
}

.host-row-name {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: 0 1 auto;
  min-width: 0;
}

.host-row-sub {
  color: rgba(255, 255, 255, 0.45);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.host-row-sub.on {
  color: rgba(255, 255, 255, 0.60);
}

.host-edit {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.host-edit-ic {
  width: 32rpx;
  height: 32rpx;
}

.host-empty {
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
}

/* 编辑主机：顶部 取消/标题/保存，下面一张玻璃卡片（输入 + 主机类型） */
.host-edit-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.host-edit-pill {
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06));
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
}

.host-edit-pill-save {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.08));
}

.host-edit-heading {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.host-edit-hint {
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.host-edit-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 28rpx;
  padding: 4rpx 24rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.10);
}

.host-edit-input {
  width: 100%;
  height: 92rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  padding: 0;
}

.host-edit-ph {
  color: rgba(255, 255, 255, 0.38);
}

.host-edit-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.10);
}

.host-edit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
}

.host-edit-row-label {
  color: #FFFFFF;
  font-size: 28rpx;
}

.host-edit-row-value {
  display: flex;
  align-items: center;
  color: #FFFFFF;
  font-size: 28rpx;
}

.host-edit-chev {
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
  opacity: 0.7;
}

.host-kind-ic {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  opacity: 0.78;
  flex: none;
}

/* 主机类型：锚点浮层菜单（对齐 iOS Menu：高亮选中项 + 图标） */
.host-edit-kind-anchor {
  position: relative;
}

/* 点菜单外任意区域关闭主机类型菜单（sheet 内一层 + 全屏一层：点到 sheet 上方也只关菜单） */
.host-kind-mask {
  position: absolute;
  inset: 0;
  z-index: 4;
  background: transparent;
}

.host-kind-outside-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: transparent;
}

.host-kind-menu {
  position: absolute;
  right: 0;
  top: calc(100% - 6rpx);
  width: 320rpx;
  z-index: 5;
  padding: 10rpx 0;
  border-radius: 28rpx;
  background: rgba(10, 14, 24, 0.30);            /* 默认主题色弹窗底 */
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30);
  backdrop-filter: blur(20rpx) saturate(1.2);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.2);
}

.host-kind-menu-item {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 20rpx;
  color: #FFFFFF;
  font-size: 30rpx;
}

.host-kind-menu-item .host-kind-ic {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.host-kind-check-slot {
  display: flex;
  align-items: center;
  width: 32rpx;
  margin-right: 12rpx;
  flex: none;
}

.host-kind-check {
  width: 26rpx;
  height: 26rpx;
}

/* ---------- 工作区选择弹窗 ---------- */

.workspace-picker-sheet {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 61;
  display: flex;
  flex-direction: column;
  height: auto;
  max-height: 86vh;
  background: rgba(10, 14, 24, 0.30);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx) saturate(1.2);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.2);
  border-radius: 40rpx;
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30);
  transition: height 0.5s cubic-bezier(0.32, 0.72, 0, 1);
}

.picker-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.picker-sheet-title {
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
}

.picker-sheet-close {
  color: #FF7178;
  font-size: 32rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.picker-list {
  max-height: 55vh;
  overflow-y: auto;
}

.picker-row {
  display: flex;
  align-items: center;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.picker-row-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.picker-row-body {
  flex: 1;
  min-width: 0;
}

.picker-row-title {
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-row-path {
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-row-check {
  width: 36rpx;
  height: 36rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.picker-empty {
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
}

.picker-new {
  margin-top: 50rpx;
}

/* ---------- 目录浏览器弹层（对齐 dsh-mobile v1.6.0 WorkspaceDirectoryBrowserSheet） ---------- */

.dir-sheet {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 62;
  display: flex;
  flex-direction: column;
  height: 80vh;
  /* 与工作区卡片同一套玻璃材质（白色渐变 + 发丝亮边 + 顶部内发光），模糊比卡片重一档 */
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(14rpx) saturate(1.1);
  -webkit-backdrop-filter: blur(14rpx) saturate(1.1);
  border-radius: 40rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 16rpx 48rpx rgba(3, 14, 30, 0.26);
  padding-bottom: calc(4rpx + env(safe-area-inset-bottom));
}

.dir-sheet-handle {
  width: 76rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(241, 244, 250, 0.30);
