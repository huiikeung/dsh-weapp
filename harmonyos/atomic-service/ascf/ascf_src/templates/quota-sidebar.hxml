
<template name="quota-sidebar"><view class="qs-root qs-{{mode}}"><block has:for="{{sections}}" has:key="key" has:for-item="sec"><view class="qs-sec qs-{{sec.kind}} {{sec.card ? 'qs-card' : ''}} {{activeKey === sec.key ? 'qs-active' : ''}} {{sec.kind === 'peak' && sec.peak.phaseClass ? 'qs-phase-' + sec.peak.phaseClass : ''}}" catchtap="onSidebarPartTap" data-key="{{sec.key}}"><block has:if="{{sec.kind === 'today'}}"><block has:if="{{mode === 'summary'}}"><view class="qs-row"><view class="qs-today-left"><text class="qs-label">{{ui['今日']}}</text><text has:if="{{model.today.showTokens}}" class="qs-tokens">{{model.today.tokensText}}</text></view><text has:if="{{model.today.showCost}}" class="qs-amount">{{model.today.amountText}}</text></view></block><block has:else><view class="qs-row"><text class="qs-label">{{ui['今日']}}</text><view class="qs-today-vals"><text has:if="{{model.today.showCost}}" class="qs-value">{{model.today.amountText}}</text><text has:if="{{model.today.showTokens}}" class="qs-tokens">{{model.today.tokensText}}</text></view></view></block></block><block has:elif="{{sec.kind === 'balance'}}"><view class="qs-row"><text class="qs-label">{{sec.balance.title}}<text class="qs-link"> ↗</text></text><text class="qs-value">{{sec.balance.amountText}}</text></view><view has:if="{{sec.balance.showProgressBar && sec.balance.segments}}" class="qs-bar qs-bar-split"><view has:for="{{sec.balance.segments}}" has:key="key" class="qs-bar-fill qs-bar-seg-{{item.key}}" style="width:{{item.width}};"></view></view></block><block has:elif="{{sec.kind === 'peak'}}"><block has:if="{{mode === 'summary'}}"><view class="qs-row qs-peak-summary-row"><view class="qs-peak-summary-left"><view class="qs-peak-label"><view class="qs-dot"></view><text class="qs-peak-name">{{sec.peak.shortLabel}}</text></view><text has:if="{{sec.peak.timeDisplay !== 'switch'}}" class="qs-peak-countdown">{{ui['剩余']}}{{sec.peak.shortDurationText}}</text></view><text has:if="{{sec.peak.timeDisplay !== 'countdown'}}" class="qs-value qs-peak-switch">{{sec.peak.switchText}}</text></view><view class="qs-bar"><view class="qs-bar-fill" style="width:{{sec.peak.progressText}};"></view></view></block><block has:elif="{{mode === 'compact'}}"><view class="qs-row qs-peak-inline"><text class="qs-label qs-peak-label"><text class="qs-dot"></text>{{sec.peak.shortLabel}}</text><view class="qs-bar qs-bar-inline"><view class="qs-bar-fill" style="width:{{sec.peak.progressText}};"></view></view><text class="qs-value qs-peak-inline-time">{{sec.peak.compactText}}</text></view></block><block has:elif="{{mode === 'simple'}}"><view class="qs-row"><text class="qs-label qs-peak-label"><text class="qs-dot"></text>{{sec.peak.shortLabel}}</text><text class="qs-value">{{sec.peak.timeDisplay === 'switch' ? sec.peak.switchText : sec.peak.remainingText}}</text></view><view class="qs-bar"><view class="qs-bar-fill" style="width:{{sec.peak.progressText}};"></view></view><text has:if="{{sec.peak.timeDisplay === 'both'}}" class="qs-meta">{{sec.peak.switchText}}</text></block><block has:else><view class="qs-row"><text class="qs-label qs-peak-label"><text class="qs-dot"></text>{{sec.peak.label}}</text><text has:if="{{sec.peak.timeDisplay === 'switch'}}" class="qs-value">{{sec.peak.switchText}}</text><text has:elif="{{sec.peak.remainingText}}" class="qs-value">{{sec.peak.remainingText}}</text></view><view class="qs-bar"><view class="qs-bar-fill" style="width:{{sec.peak.progressText}};"></view></view><view has:if="{{sec.peak.timeDisplay === 'both' && (sec.peak.startText || sec.peak.switchText)}}" class="qs-row qs-meta-row"><text class="qs-meta">{{sec.peak.startText}}</text><text class="qs-meta">{{sec.peak.switchText}}</text></view></block></block><block has:elif="{{sec.kind === 'budget'}}"><view class="qs-row"><text class="qs-title">{{sec.budget.label}}</text><text class="qs-value qs-budget-pct">{{sec.budget.percentText}}</text><text class="qs-value qs-budget-used">{{sec.budget.usedText}} / {{sec.budget.amountText}}</text></view><view class="qs-bar"><view class="qs-bar-fill" style="width:{{sec.budget.barWidth}};"></view></view><text class="qs-meta">{{ui['已用']}} {{sec.budget.usedText}} / {{sec.budget.amountText}}</text></block><block has:elif="{{sec.kind === 'go'}}"><view class="qs-row"><text class="qs-title">Go {{sec.go.mainRow.label}}</text><text class="qs-value">{{sec.go.mainRow.percentText}}</text></view><view class="qs-bar"><view class="qs-bar-fill" style="width:{{sec.go.mainRow.barWidth}};"></view></view><text has:if="{{sec.go.detail !== false && sec.go.metaText}}" class="qs-meta">{{sec.go.metaText}}</text><text has:if="{{sec.go.detail !== false && sec.go.mainRow.resetsText}}" class="qs-meta">{{ui['重置']}}:{{sec.go.mainRow.resetsText}}</text></block><block has:elif="{{sec.kind === 'plan'}}"><text class="qs-title">{{sec.plan.label}}</text><view class="qs-wins"><view has:for="{{sec.plan.rows}}" has:key="key" has:for-item="win" class="qs-win"><text class="qs-win-label">{{ui[win.label] !== undefined ? ui[win.label] : win.label}}</text><view class="qs-bar"><view class="qs-bar-fill" style="width:{{win.barWidth}};"></view></view><text class="qs-win-pct">{{win.percentText}}</text></view></view><text has:if="{{sec.plan.rows[0].resetsText}}" class="qs-meta">{{ui['重置']}} {{sec.plan.rows[0].resetsText}}</text></block><block has:elif="{{sec.kind === 'gateway'}}"><view class="qs-row"><text class="qs-label">{{sec.source.label}}</text><text class="qs-value">{{sec.source.accounts.length ? sec.source.accounts.length + ' ' + ui['个账号'] : (sec.source.status === 'ok' ? ui['正常'] : sec.source.status)}}</text></view></block><block has:elif="{{sec.kind === 'custom'}}"><view class="qs-row"><text class="qs-label">{{sec.custom.label}}</text><text class="qs-value">{{sec.custom.amountText}}</text></view><view has:if="{{sec.custom.percent !== null}}" class="qs-bar"><view class="qs-bar-fill" style="width:{{sec.custom.barWidth}};"></view></view><text has:if="{{sec.custom.maxText}}" class="qs-meta">{{ui['额度上限']}} {{sec.custom.maxText}}</text></block></view></block></view></template>
