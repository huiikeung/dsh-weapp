<page-meta page-style="{{pageStyle}}"/>
<import src="../../styles/proc-icon.hxml"/>
<template name="mdBlocks">
<view has:for="{{blocks}}" has:for-item="block" has:key="index" class="md-block">
<rich-text has:if="{{block.type === 'para'}}" class="md-para" nodes="{{block.html}}"></rich-text>
<rich-text has:elif="{{block.type === 'heading'}}" class="md-heading md-h{{block.level}}" nodes="{{block.html}}"></rich-text>
<view has:elif="{{block.type === 'table'}}" class="md-table">
<view class="md-tr md-tr-head">
<view has:for="{{block.header}}" has:for-item="cell" has:key="index" class="md-td md-th"><rich-text nodes="{{cell}}"></rich-text></view>
</view>
<view has:for="{{block.rows}}" has:for-item="row" has:key="index" class="md-tr">
<view has:for="{{row}}" has:for-item="cell" has:key="index" class="md-td"><rich-text nodes="{{cell}}"></rich-text></view>
</view>
</view>
<view has:elif="{{block.type === 'code'}}" class="code-block">
<view class="code-lang">{{block.lang || 'CODE'}}</view>
<view class="code-body">{{block.text}}</view>
<view class="code-copy" catchtap="copyCode" data-text="{{block.text}}">{{ui['复制']}}</view>
</view>
<view has:elif="{{block.type === 'image'}}" class="md-image-block">
<image has:if="{{block.imageState === 'remote'}}" class="md-image" src="{{block.src}}" mode="widthFix"/>
<image has:elif="{{block.imageState === 'local'}}" class="md-image" src="{{block.localPath}}" mode="widthFix" bindtap="previewMarkdownImage" data-key="{{rowKey}}" data-src="{{block.localPath}}"/>
<view has:elif="{{block.imageState === 'pending'}}" class="md-image-state">{{ui['图片加载中…']}}</view>
<view has:else class="md-image-state md-image-missing">{{ui['图片无法显示']}}</view>
</view>
<rich-text has:elif="{{block.type === 'quote'}}" class="md-quote" nodes="{{block.html}}"></rich-text>
<view has:elif="{{block.type === 'hr'}}" class="md-hr"></view>
<view has:elif="{{block.type === 'list'}}" class="md-list">
<view has:for="{{block.items}}" has:for-item="li" has:for-index="liIndex" has:key="liIndex" class="md-li">
<text class="md-li-marker">{{block.ordered ? (liIndex + 1) + '.' : '•'}}</text>
<rich-text class="md-li-text" nodes="{{li}}"></rich-text>
</view>
</view>
</view>
</template>
<view class="page session {{themeClass}} {{sessionGlassEnabled ? 'session-glass' : ''}}" style="{{contentFontStyle}}; --glass-alpha-top: {{glassAlphaTop}}; --glass-alpha-bottom: {{glassAlphaBottom}}; --glass-edge-alpha: {{glassEdgeAlpha}}; --glass-blur-card: {{glassBlurCard}}; --glass-blur-sheet: {{glassBlurSheet}}; --glass-radius-card: {{glassRadiusCard}}; --glass-radius-sheet: {{glassRadiusSheet}}; --glass-backdrop-brightness: {{glassBackdropBrightness}};">
<view class="session-header">
<view class="navbar" style="{{navbarStyle}}">
<view class="nav-back tap" hover-class="press-dim" bindtap="goBack">
<image class="nav-back-ic" src="/assets/icons/{{theme === 'dark' ? 'back-white.png' : 'back-black.png'}}"/>
</view>
<view class="nav-title"><view class="nav-title-inner">{{navTitle}}</view></view>
<view class="collab-trigger nav-collab {{collaborationOpen ? 'selected' : ''}}" bindtap="openCollaboration" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['协作详情']}}">
<image class="collab-icon" src="/assets/icons/{{theme === 'dark' ? 'dsh-team-dark.svg' : 'dsh-team.svg'}}" mode="aspectFit"/>
<text has:if="{{collaborationCount}}" class="collab-count">{{collaborationCount}}</text>
<view has:if="{{collaborationActive}}" class="collab-active-dot" aria-label="{{ui['运行中']}}"/>
</view>
</view>
<view class="segmented-row">
<view class="segmented">
<view class="segment {{tab === 'conversation' ? 'active' : ''}}" bindtap="switchTab" data-tab="conversation" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['对话']}}">{{ui['对话']}}</view>
<view class="segment {{tab === 'trajectory' ? 'active' : ''}}" bindtap="switchTab" data-tab="trajectory" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['轨迹']}}">{{ui['轨迹']}}</view>
<view has:if="{{showContextPanel}}" class="segment {{tab === 'context' ? 'active' : ''}}" bindtap="switchTab" data-tab="context" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['上下文']}}">{{ui['上下文']}}</view>
<view has:if="{{showFleetPanel}}" class="segment {{tab === 'fleet' ? 'active' : ''}}" bindtap="switchTab" data-tab="fleet" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['编队']}}">{{ui['编队']}}</view>
</view>
<view class="nav-actions">
<view class="nav-more glass-press" bindtap="moreActions" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['更多']}}"><image class="nav-ic" src="/assets/icons/more-black.png"/></view>
<view has:if="{{rows.length}}" class="session-switch-trigger glass-press" bindtap="openTurnNavigator" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['对话']}}">
<view class="session-switch-lines" aria-hidden="true"><view/><view/><view/></view>
</view>
</view>
</view>
</view>
<scroll-view hidden="{{tab !== 'conversation'}}" class="conversation {{tab !== 'conversation' ? 'session-panel-hidden' : ''}}" style="{{conversationStyle}}" scroll-y enhanced scroll-anchoring="{{false}}" show-scrollbar="{{false}}" scroll-into-view="{{scrollTarget}}" scroll-with-animation="{{scrollAnim}}" scroll-top="{{conversationScrollTop}}" bindscroll="onConvScroll" bindtouchstart="onPanelTouchStart" bindtouchmove="onPanelTouchMove" bindtouchend="onPanelTouchEnd" bindtouchcancel="onPanelTouchCancel" bindscrolltoupper="loadOlder" upper-threshold="80">
<view class="conversation-inner {{rows.length ? 'has-rows' : ''}}" style="{{conversationInnerStyle}}">
<view has:if="{{rows.length && (historyLoading || hasMoreHistory)}}" class="hist-banner {{historyLoading ? 'is-loading' : 'is-idle'}}" bindtap="onHistoryBannerTap" role="button" aria-label="{{ui['加载更早记录']}}">
<view has:if="{{historyLoading && !histError && connected}}" class="banner-spinner"></view>
<text class="banner-text">{{historyLoading ? historyProgressText : (histError || ui['加载更早记录'])}}</text>
<text has:if="{{histError && !historyLoading}}" class="banner-retry">{{ui['重试']}}</text>
</view>
<view has:if="{{historyState === 'creating'}}" class="conv-state">
<view class="state-spinner"></view>
<view class="state-title">{{ui['正在创建会话']}}</view>
<view class="state-sub">{{ui['正在从 Mobile Gateway 建立会话…']}}</view>
</view>
<view has:elif="{{historyState === 'error:create'}}" class="conv-state conv-fail">
<image class="hist-warn" src="/assets/icons/warn-orange.png"/>
<view class="state-title">{{ui['创建会话失败']}}</view>
<view class="state-sub state-err">{{ui[histError] !== undefined ? ui[histError] : histError}}</view>
<view class="state-btn" bindtap="retryCreate">{{ui['重试创建']}}</view>
</view>
<view has:elif="{{!rows.length && histError}}" class="conv-state conv-fail">
<image class="hist-warn" src="/assets/icons/warn-orange.png"/>
<view class="state-title">{{ui['历史记录加载失败']}}</view>
<view class="state-sub state-err">{{ui[histError] !== undefined ? ui[histError] : histError}}</view>
<view class="state-btn" bindtap="retryHistory">{{ui['重新加载历史']}}</view>
</view>
<view has:elif="{{!rows.length && historyLoading}}" class="conv-state">
<view class="state-spinner"></view>
<view class="state-title">{{ui['正在加载历史记录']}}</view>
<view class="state-sub">{{ui['正在定位到最新消息…']}}</view>
</view>
<view has:elif="{{!rows.length && historyLoaded}}" class="conv-empty">
<image class="conv-empty-logo" src="/assets/icons/{{theme === 'dark' ? 'whale-white.png' : 'whale-ink.png'}}" mode="aspectFit"/>
<view class="conv-empty-title">{{ui['操作远端 DSH Agent']}}</view>
<view class="conv-empty-desc">{{ui['发送任务后，工具调用、推理进度和最终回复会通过 Mobile Gateway 实时返回。']}}</view>
<view has:if="{{historyState === 'loaded:0ev'}}" class="state-sub">{{ui['网关返回 0 条历史事件（若这是旧会话，请检查 Host 连接后下拉重试）']}}</view>
</view>
<view style="height:{{conversationTopSpace}}px" aria-hidden="true"></view>
<view has:for="{{rows}}" has:for-index="rowIndex" has:key="key" class="conversation-window-row {{item.kind === 'files' || item.kind === 'changes' ? 'row-file-card' : ''}}">
<view has:if="{{item.kind === 'user'}}" class="row-user" id="{{item.key}}">
<view has:if="{{item.images.length === 1}}" class="user-image-single {{item.text ? 'with-text' : ''}}" style="{{item.singleStyle}}">
<image class="user-image-one" src="{{item.images[0].localUrl || item.images[0].thumbUrl || ''}}" mode="aspectFill" bindtap="previewAttachment" data-id="{{item.images[0].attachmentId}}"/>
</view>
<view has:elif="{{item.images.length > 1}}" class="user-image-stack {{item.text ? 'with-text' : ''}}" style="{{item.stackStyle}}">
<image has:for="{{item.stackImages}}" has:for-item="img" has:key="attachmentId" class="user-image-card" style="{{img.style}}" src="{{img.localUrl || img.thumbUrl || ''}}" mode="aspectFill" bindtap="previewAttachment" data-id="{{img.attachmentId}}"/>
<view has:if="{{item.images.length > 1}}" class="user-image-count" style="{{item.stackBadgeStyle}}">{{item.images.length}}{{ui['张']}}</view>
</view>
<view has:if="{{item.text}}" class="row-user-bubble">
<block has:if="{{item.blocks && item.blocks.length}}">
<template is="mdBlocks" data="{{blocks: item.blocks, rowKey: item.key}}"/>
</block>
<view has:elif="{{item.text}}" class="row-user-text" bindlongpress="openTextSelection" data-key="{{item.key}}">{{item.text}}</view>
</view>
<view has:if="{{item.attachments && item.attachments.length}}" class="message-attachments">
<view has:for="{{item.attachments}}" has:for-item="att" has:for-index="attachmentIndex" has:key="index" has:if="{{att.kind !== 'image'}}" class="message-attachment" bindtap="openMessageAttachment" data-row-index="{{rowIndex}}" data-attachment-index="{{attachmentIndex}}" hover-class="press-dim" role="button" aria-label="{{ui['预览']}} {{att.name || att.path || ui['附件']}}">
<image class="message-attachment-icon" src="{{att.kind === 'directory' ? '/assets/icons/ic-dir-folder-ink.png' : '/assets/icons/deliverable-document.svg'}}" mode="aspectFit"/>
<text class="message-attachment-name">{{att.name || att.path || ui['附件']}}</text>
</view>
</view>
<view has:if="{{item.copyText}}" class="copy-btn row-user-copy" bindtap="copyAssistantText" data-key="{{item.copyKey || item.key}}" data-text="{{item.copyText}}" hover-class="press-dim" role="button" aria-label="{{ui['复制']}}"><image class="copy-ic" src="{{copiedKey === (item.copyKey || item.key) ? '/assets/icons/check-ocean.png' : '/assets/icons/copy-gray.png'}}"/></view>
</view>
<view has:elif="{{item.kind === 'turnProcess'}}" class="process-block" id="{{item.key}}">
<view class="process-head" hover-class="{{item.foldable ? 'tool-head-hover' : 'none'}}" hover-start-time="0" hover-stay-time="200" bindtap="toggleFold" data-key="{{item.key}}">
<view class="command-icon-slot turn-process-slot" aria-hidden="true">
<image has:if="{{item.foldable}}" class="command-chevron {{folds[item.key] ? 'open' : ''}}" src="/assets/icons/chev-right-gray.png"/>
</view>
<text class="process-title">{{ui[item.title] !== undefined ? ui[item.title] : item.title}}</text>
<text has:if="{{item.summary || item.expandedSummary}}" class="process-summary">{{folds[item.key] && item.expandedSummary ? item.expandedSummary : (ui[item.summary] !== undefined ? ui[item.summary] : item.summary)}}</text>
<view class="event-spacer"></view>
</view>
</view>
<view has:elif="{{item.kind === 'processGroup'}}" class="process-block {{item.running ? 'running' : ''}}" id="{{item.key}}">
<view has:if="{{!item.headingHidden}}" class="process-head" hover-class="{{item.expandable ? 'tool-head-hover' : 'none'}}" hover-start-time="0" hover-stay-time="200" bindtap="toggleFold" data-key="{{item.key}}">
<view class="command-icon-slot {{folds[item.key] ? 'disclosed' : ''}}" aria-hidden="true">
<view has:if="{{item.running && !item.completed}}" class="proc-loader proc-look-{{procIconStyle}}">
<template is="procIconGlyph" data="{{styleId: procIconStyle}}"/>
</view>
<image has:if="{{!item.running}}" class="process-command-icon command-tool-icon" src="/assets/icons/{{theme === 'dark' ? item.darkIconFile : item.iconFile}}" mode="aspectFit"/>
<image has:if="{{!item.running}}" class="command-chevron {{folds[item.key] ? 'open' : ''}}" src="/assets/icons/chev-right-gray.png"/>
</view>
<text class="process-title {{item.failed ? 'failed' : ''}} {{item.titleWrap ? 'title-wrap' : ''}}">{{ui[item.title] !== undefined ? ui[item.title] : item.title}}</text>
<text has:if="{{item.liveDetail}}" class="process-live-detail">· {{item.liveDetail}}</text>
<text has:elif="{{item.summary}}" class="process-summary">{{ui[item.summary] !== undefined ? ui[item.summary] : item.summary}}</text>
<view class="event-spacer"></view>
</view>
<view has:if="{{item.failed && item.failureMessage}}" class="turn-error-card" role="alert">
<view class="turn-error-head"><view class="turn-error-bang">!</view><text class="turn-error-title">{{item.failureTitle || ui['本轮运行失败']}}</text></view>
<view class="turn-error-message">{{item.failureMessage}}</view>
<view has:if="{{item.failureCode}}" class="turn-error-code"><text class="turn-error-code-label">{{ui['错误码']}}</text><text class="turn-error-code-value" selectable>{{item.failureCode}}</text></view>
</view>
<scroll-view has:if="{{item.processBodyVisible}}" id="process-body-{{item.key}}" class="process-body {{item.processBodyCapped ? 'process-body-capped' : ''}}" scroll-y="{{item.processBodyCapped}}" scroll-top="{{item.processBodyScrollTop || 0}}" scroll-into-view="{{item.running ? processFollowTarget : ''}}" enhanced show-scrollbar="{{false}}" scroll-anchoring="{{false}}" bindtouchstart="onProcessBodyTouchStart" bindtouchmove="onProcessBodyTouchMove" bindtouchend="onProcessBodyTouchEnd" bindtouchcancel="onProcessBodyTouchCancel" bindscroll="onProcessBodyScroll" data-key="{{item.key}}">
<view has:if="{{item.commandDetail}}" class="process-command-detail">{{item.commandDetail}}</view>
<block has:for="{{item.children}}" has:for-item="node" has:key="key">
<view id="{{node.key}}" class="process-step-anchor" aria-hidden="true"/>
<view has:if="{{node.kind === 'reasoning' && !folds[node.key]}}" class="disclosure-head reasoning-collapsed" hover-class="tool-head-hover" hover-start-time="0" hover-stay-time="200" bindtap="toggleFold" data-key="{{node.key}}"><view class="command-icon-slot" aria-hidden="true"><image class="event-glyph command-tool-icon" src="/assets/icons/{{theme === 'dark' ? node.darkIconFile : node.iconFile}}"/><image class="command-chevron" src="/assets/icons/chev-right-gray.png"/></view><text class="event-title">{{ui['思考']}}</text><text has:if="{{node.showPreview}}" class="event-preview">{{node.preview}}</text></view>
<view has:elif="{{node.kind === 'reasoning'}}" class="reasoning-card reading-preview">
<view class="reasoning-card-head"><text class="reasoning-card-title">{{ui['思考']}}</text><text has:if="{{node.stepLabel}}" class="reasoning-step">{{ui[node.stepLabel] !== undefined ? ui[node.stepLabel] : node.stepLabel}}</text></view>
<view class="reasoning-reading-area">
<scroll-view class="reasoning-scroll" scroll-y="{{true}}" enhanced show-scrollbar="{{true}}" style="height:{{node.readingHeight}}rpx;">
<text class="reasoning-reading-text" selectable>{{node.text}}</text>
</scroll-view>
<view has:if="{{node.readingLong}}" class="reasoning-reading-fade"></view>
</view>
<view class="reasoning-card-footer">
<text class="reasoning-reading-hint">{{ui['完整内容']}}</text>
<view class="reasoning-reading-toggle" bindtap="toggleFold" data-key="{{node.key}}" role="button" aria-label="{{ui['收起阅读']}}">
<text>{{ui['收起阅读']}}</text><image class="reasoning-reading-chevron" src="/assets/icons/chev-right-gray.png"/>
</view>
</view>
</view>
<view has:elif="{{node.kind === 'narration'}}" class="process-narration">
<block has:if="{{node.blocks && node.blocks.length}}"><template is="mdBlocks" data="{{blocks: node.blocks, rowKey: node.formatKey || node.sourceKey || node.key}}"/></block>
<text has:elif="{{node.text}}" class="process-narration-text" selectable>{{node.text}}</text>
<view has:if="{{node.images && node.images.length}}" class="attach-grid"><image has:for="{{node.images}}" has:for-item="img" has:key="attachmentId" class="attach-img" src="{{img.localUrl || img.thumbUrl || ''}}" mode="aspectFill" bindtap="previewAttachment" data-id="{{img.attachmentId}}"/></view>
<view has:if="{{node.attachments && node.attachments.length}}" class="message-attachments assistant-attachments"><view has:for="{{node.attachments}}" has:for-item="att" has:for-index="attachmentIndex" has:key="index" class="message-attachment" bindtap="openProcessAttachment" data-source-key="{{node.sourceKey}}" data-attachment-index="{{attachmentIndex}}" hover-class="press-dim" role="button" aria-label="{{ui['预览']}} {{att.name || att.path || ui['附件']}}"><image class="message-attachment-icon" src="{{att.kind === 'directory' ? '/assets/icons/ic-dir-folder-ink.png' : '/assets/icons/deliverable-code.svg'}}" mode="aspectFit"/><text class="message-attachment-name">{{att.name || att.path || ui['附件']}}</text></view></view>
</view>
<view has:elif="{{node.kind === 'context'}}" class="disclosure">
<view class="disclosure-head" hover-class="tool-head-hover" hover-start-time="0" hover-stay-time="200" bindtap="toggleFold" data-key="{{node.key}}">
<view class="command-icon-slot {{folds[node.key] ? 'disclosed' : ''}}" aria-hidden="true"><image class="event-glyph command-tool-icon" src="/assets/icons/{{theme === 'dark' ? node.darkIconFile : node.iconFile}}" mode="aspectFit"/><image class="command-chevron {{folds[node.key] ? 'open' : ''}}" src="/assets/icons/chev-right-gray.png"/></view>
<text class="event-title tint-{{node.tint}}">{{ui[node.title] !== undefined ? ui[node.title] : node.title}}</text>
<text has:if="{{node.preview}}" class="event-dot">·</text>
<text has:if="{{node.preview}}" class="event-preview">{{node.preview}}</text>
<view class="event-spacer"></view>
</view>
<view has:if="{{folds[node.key]}}" class="event-body">
<view class="event-rule"></view>
<view class="event-body-text">{{node.text}}</view>
</view>
</view>
<view has:else class="disclosure tool-bundle">
<view class="tool-bundle-body">
<block has:for="{{node.tools}}" has:for-item="tool" has:key="key">
<view class="tool-node {{tool.isCommand ? 'command-node' : ''}}" style="{{tool.indentStyle}}">
<view has:for="{{tool.branchTracks}}" has:for-item="track" has:key="key" class="tool-branch-track" style="{{track.style}}" aria-hidden="true"/>
<view class="disclosure-head tool" hover-class="tool-head-hover" hover-start-time="0" hover-stay-time="200" bindtap="{{tool.phase === 'preparing' ? '' : 'toggleFold'}}" data-key="{{tool.key}}">
<view has:if="{{tool.phase !== 'preparing'}}" class="command-icon-slot {{folds[tool.key] ? 'disclosed' : ''}}" aria-hidden="true">
<image class="event-glyph tool-glyph-small command-tool-icon" src="/assets/icons/{{theme === 'dark' ? tool.darkIconFile : tool.iconFile}}" mode="aspectFit"/>
<image class="command-chevron {{folds[tool.key] ? 'open' : ''}}" src="/assets/icons/chev-right-gray.png"/>
</view>
<image has:else class="event-glyph tool-glyph-small" src="/assets/icons/{{theme === 'dark' ? tool.darkIconFile : tool.iconFile}}" mode="aspectFit"/>
<view class="tool-line">
<view class="tool-line-1">
<text class="tool-act">{{tool.actLabel || tool.name || ui['工具']}}</text>
<text has:if="{{tool.statusText}}" class="tool-status {{tool.isError ? 'err' : ''}}">{{ui[tool.statusText] !== undefined ? ui[tool.statusText] : tool.statusText}}</text>
<text has:if="{{tool.actDetail}}" class="tool-separator">·</text>
<text has:if="{{tool.actDetail}}" class="tool-note">{{tool.actDetail}}</text>
</view>
</view>
</view>
<view has:if="{{folds[tool.key] && tool.isCommand && tool.phase !== 'preparing'}}" class="command-card">
<view class="command-card-head">
<view class="command-state {{tool.waiting ? 'waiting' : (tool.isError ? 'failed' : (tool.statusText ? 'unknown' : 'done'))}}"></view>
<text class="command-cwd">{{tool.cwdLabel || ui['命令']}}</text>
<text has:if="{{tool.statusText}}" class="command-state-label">{{ui[tool.statusText] !== undefined ? ui[tool.statusText] : tool.statusText}}</text>
<text has:if="{{tool.commandText}}" class="command-copy" catchtap="copyToolCommand" data-text="{{tool.commandText}}" role="button" aria-label="{{ui['复制命令']}}">{{ui['复制']}}</text>
</view>
<scroll-view has:if="{{tool.commandText}}" class="command-input" scroll-x enhanced>
<view class="command-code-lines"><view has:for="{{tool.commandLines}}" has:for-item="line" has:key="index" class="command-code-line"><text class="command-prompt">$</text><text class="command-source" selectable>{{line.text}}</text></view></view>
</scroll-view>
<view has:else class="command-placeholder">{{tool.waiting ? ui['正在接收命令…'] : ui['未记录命令内容']}}</view>
<scroll-view has:if="{{tool.resultText}}" class="command-output {{tool.isError ? 'failed' : ''}}" scroll-x scroll-y enhanced>
<text class="command-output-text" selectable>{{tool.resultText}}</text>
</scroll-view>
<view has:elif="{{!tool.waiting}}" class="command-placeholder command-empty-output">{{tool.statusText || ui['无输出']}}</view>
</view>
<view has:elif="{{folds[tool.key] && tool.phase !== 'preparing'}}" class="tool-detail">
<view has:if="{{tool.argumentsText}}" class="tool-detail-section">
<view class="tool-detail-label">{{ui['调用参数']}}</view>
<view class="tool-detail-code">{{tool.argumentsText}}</view>
</view>
<view has:if="{{tool.resultText}}" class="tool-detail-section">
<view class="tool-detail-label {{tool.isError ? 'err' : ''}}">{{ui[tool.resultLabel] !== undefined ? ui[tool.resultLabel] : tool.resultLabel}}</view>
<view class="tool-detail-output">{{tool.resultText}}</view>
</view>
</view>
</view>
</block>
</view>
</view>
</block>
<view id="{{item.key}}/tail" class="process-step-anchor" aria-hidden="true"/>
<view id="{{item.key}}/tail-alt" class="process-step-anchor" aria-hidden="true"/>
</scroll-view>
</view>
<view has:elif="{{item.kind === 'assistant'}}" class="row-assistant {{item.processNarration ? 'narration-row' : ''}}" id="{{item.key}}" bindlongpress="openTextSelection" data-key="{{item.key}}">
<view has:if="{{item.title}}" class="row-streaming-title">{{ui[item.title] !== undefined ? ui[item.title] : item.title}}</view>
<block has:if="{{item.blocks.length}}">
<template is="mdBlocks" data="{{blocks: item.blocks, rowKey: item.key}}"/>
</block>
<text has:if="{{!item.blocks.length && item.text}}" class="assistant-plain-text" selectable>{{item.text}}</text>
<view has:if="{{item.images && item.images.length}}" class="attach-grid">
<image has:for="{{item.images}}" has:for-item="img" has:key="attachmentId" class="attach-img" src="{{img.localUrl || img.thumbUrl || ''}}" mode="aspectFill" bindtap="previewAttachment" data-id="{{img.attachmentId}}"/>
</view>
<view has:if="{{item.attachments && item.attachments.length}}" class="message-attachments assistant-attachments">
<view has:for="{{item.attachments}}" has:for-item="att" has:for-index="attachmentIndex" has:key="index" has:if="{{att.kind !== 'image'}}" class="message-attachment" bindtap="openMessageAttachment" data-row-index="{{rowIndex}}" data-attachment-index="{{attachmentIndex}}" hover-class="press-dim" role="button" aria-label="{{ui['预览']}} {{att.name || att.path || ui['附件']}}">
<image class="message-attachment-icon" src="{{att.kind === 'directory' ? '/assets/icons/ic-dir-folder-ink.png' : '/assets/icons/deliverable-document.svg'}}" mode="aspectFit"/>
<text class="message-attachment-name">{{att.name || att.path || ui['附件']}}</text>
</view>
</view>
</view>
<view has:elif="{{item.kind === 'changes'}}" class="file-card-wrap" id="{{item.key}}">
<view class="changed-files">
<view class="changed-files-head" bindtap="openChangedFile" data-row="{{item.key}}" data-index="0" hover-class="delivered-file-pressed" role="button" aria-label="{{item.singleFile ? item.files[0].display : item.title}}">
<view class="delivered-file-icon"><image src="{{item.singleFile ? item.files[0].icon : '/assets/icons/deliverable-code.svg'}}" mode="aspectFit"/></view>
<view class="delivered-file-copy"><text class="delivered-file-name">{{item.title}}</text>
<text has:if="{{item.statusNote}}" class="delivered-file-description">{{item.statusNote}}</text>
<view has:else class="changed-counts"><text class="changed-added">+{{item.added}}</text><text class="changed-deleted">−{{item.deleted}}</text></view>
</view>
</view>
<view has:if="{{!item.singleFile}}" class="changed-file-list">
<block has:for="{{item.files}}" has:for-item="file" has:for-index="fileIndex" has:key="key">
<view has:if="{{fileIndex < 4 || fileExpanded[item.key]}}" class="changed-file-row" bindtap="openChangedFile" data-row="{{item.key}}" data-index="{{fileIndex}}" hover-class="changed-file-pressed" role="button" aria-label="{{file.display}}">
<image class="changed-file-icon" src="{{file.icon}}" mode="aspectFit"/>
<view class="changed-file-copy"><text class="changed-file-name">{{file.name}}</text><text has:if="{{file.display !== file.name}}" class="changed-file-path">{{file.display}}</text><text has:if="{{file.statusNote}}" class="changed-file-path">{{file.statusNote}}</text></view>
<view has:if="{{file.hasCounts}}" class="changed-counts"><text class="changed-added">+{{file.added}}</text><text class="changed-deleted">−{{file.deleted}}</text></view>
</view>
</block>
</view>
<view has:if="{{item.files.length > 4}}" class="delivered-file-toggle" bindtap="toggleChangedFiles" data-key="{{item.key}}">{{fileExpanded[item.key] ? ui['收起'] : ui['显示全部文件'] + ' (' + item.files.length + ')'}}</view>
</view>
</view>
<view has:elif="{{item.kind === 'files'}}" class="file-card-wrap" id="{{item.key}}">
<view class="delivered-files">
<block has:for="{{item.files}}" has:for-item="file" has:for-index="fileIndex" has:key="key">
<view has:if="{{fileIndex < 4 || fileExpanded[item.key]}}" class="delivered-file" bindtap="openPresentedFile" data-key="{{file.key}}" hover-class="delivered-file-pressed" role="button" aria-label="{{ui['打开']}} {{file.name}}">
<view class="delivered-file-icon"><image src="{{file.icon}}" mode="aspectFit"/></view>
<view class="delivered-file-copy"><text class="delivered-file-name">{{file.name}}</text><text class="delivered-file-description">{{fileBusyKey === file.key ? ui['正在下载文件'] + ' ' + fileProgress + '%' : file.subtitle}}</text></view>
<view class="delivered-file-controls">
<view class="delivered-file-open" catchtap="openPresentedFile" data-key="{{file.key}}" role="button" aria-label="{{ui['预览']}}"><image src="/assets/icons/deliverable-open.svg"/></view>
</view>
</view>
</block>
<view has:if="{{item.files.length > 4}}" class="delivered-file-toggle" bindtap="toggleFileCards" data-key="{{item.key}}">{{fileExpanded[item.key] ? ui['收起'] : ui['显示全部文件'] + ' (' + item.files.length + ')'}}</view>
</view>
</view>
<view has:else class="row-event" id="{{item.key}}">
<image class="event-ic" src="/assets/icons/{{item.iconFile}}"/>
<view class="row-event-body">
<text class="event-tag {{item.isError ? 'error' : ''}}">{{ui[item.title] !== undefined ? ui[item.title] : item.title}}</text>
<text has:if="{{item.text}}" class="event-text">{{item.text}}</text>
</view>
</view>
<view has:if="{{item.footerVisible}}" class="turn-footer-wrap"><view class="turn-footer"><view class="turn-footer-left"><view has:if="{{item.copyText}}" class="copy-btn file-copy-btn" bindtap="copyAssistantText" data-key="{{item.copyKey || item.key}}" data-text="{{item.copyText}}"><image class="copy-ic" src="{{copiedKey === (item.copyKey || item.key) ? '/assets/icons/check-ocean.png' : '/assets/icons/copy-gray.png'}}"/></view><view class="copy-btn" bindtap="contextJumpFromChat" data-seq="{{item.seq}}" hover-class="press-dim" role="button" aria-label="{{ui['跳转到上下文']}}"><image class="copy-ic" src="/assets/icons/{{theme === 'dark' ? 'context-jump-dark.svg' : 'context-jump.svg'}}" mode="aspectFit"/></view><view has:if="{{item.turnMetaText}}" class="turn-meta" catchtap="openTurnUsage" data-key="{{item.turnMetaKey || item.copyKey || item.key}}" role="button" aria-label="{{item.turnMetaText}}"><image class="turn-meta-ic" src="/assets/icons/{{theme === 'dark' ? 'token-usage-dark.svg' : 'token-usage.svg'}}" mode="aspectFit"/><text class="turn-meta-text">{{item.turnMetaText}}</text></view></view><text has:if="{{item.turnTimeText}}" class="turn-time">{{item.turnTimeText}}</text></view></view>
</view>
<view style="height:{{conversationBottomSpace}}px" aria-hidden="true"></view>
<view has:if="{{running}}" class="progress-strip conversation-progress" id="deep-search-progress">
<view class="progress-row status-look-{{statusAppearance}}">
<view class="status-tail"><image class="status-tail-image status-tail-{{statusAppearance}} {{theme === 'dark' ? 'status-tail-dark' : 'status-tail-light'}}" mode="aspectFit" src="/assets/icons/dsh-running-whale.png" style="{{theme === 'dark' ? statusDarkTailAnimationStyle : statusLightTailAnimationStyle}}animation-delay:{{statusFlowDelay}}s;"/></view>
<view class="status-text-motion"><text class="status-gradient" style="{{theme === 'dark' ? statusDarkStyle : statusLightStyle}}animation-delay:{{statusFlowDelay}}s;">{{runPhrase}}{{ui['，用时']}} {{runElapsedText}}…</text></view>
</view>
</view>
<view id="conv-bottom" class="conv-bottom"></view>
</view>
</scroll-view>
<view has:if="{{trajectoryMounted}}" hidden="{{tab !== 'trajectory'}}" class="trajectory-panel {{tab !== 'trajectory' ? 'session-panel-hidden' : ''}}" style="{{trajectoryStyle}}" bindtouchstart="onPanelTouchStart" bindtouchmove="onPanelTouchMove" bindtouchend="onPanelTouchEnd" bindtouchcancel="onPanelTouchCancel">
<view class="trace-overview">
<view class="trace-overview-head">
<view class="trace-overview-head-label {{traceFocusMode === 'duration' ? 'active' : ''}}" bindtap="selectTraceMetric" data-mode="duration" hover-class="trace-overview-metric-pressed" role="button" aria-label="{{ui['时长']}}"><image class="trace-overview-clock" src="/assets/icons/{{theme === 'dark' ? 'dsh-clock-dark.svg' : 'dsh-clock.svg'}}" mode="aspectFit" aria-hidden="true"/><text>{{ui['时长']}}</text></view>
<view class="trace-overview-stat {{traceFocusMode === 'turns' ? 'active' : ''}}" bindtap="selectTraceMetric" data-mode="turns" hover-class="trace-overview-metric-pressed" role="button" aria-label="{{ui['轮次']}}"><image class="trace-overview-metric-icon" src="/assets/icons/{{theme === 'dark' ? 'dsh-checklist-dark.svg' : 'dsh-checklist.svg'}}" mode="aspectFit" aria-hidden="true"/><text>{{traceOverview.turns}}</text><text>{{ui['轮次']}}</text></view>
<view class="trace-overview-stat {{traceFocusMode === 'calls' ? 'active' : ''}}" bindtap="selectTraceMetric" data-mode="calls" hover-class="trace-overview-metric-pressed" role="button" aria-label="{{ui['调用']}}"><image class="trace-overview-metric-icon" src="/assets/icons/{{theme === 'dark' ? 'dsh-process-tool-dark.svg' : 'dsh-process-tool.svg'}}" mode="aspectFit" aria-hidden="true"/><text>{{traceOverview.calls}}</text><text>{{ui['调用']}}</text></view>
</view>
<view has:for="{{traceOverview.lanes}}" has:for-item="lane" has:key="id" class="trace-overview-lane">
<text class="trace-overview-label">{{ui[lane.label] !== undefined ? ui[lane.label] : lane.label}}</text>
<view class="trace-overview-track" data-lane="{{lane.id}}" catchtouchstart="onTraceTimelineTouchStart" catchtouchmove="onTraceTimelineTouchMove" catchtouchend="onTraceTimelineTouchEnd" catchtouchcancel="onTraceTimelineTouchCancel" catchtap="onTraceTimelineTap">
<view has:for="{{lane.segments}}" has:for-item="segment" has:key="key" class="trace-overview-bar {{segment.badgeClass}} {{segment.error ? 'error' : ''}} {{segment.selected ? 'selected' : ''}} {{segment.dimmed ? 'dimmed' : ''}}" style="{{segment.style}}" aria-hidden="true"/>
<view has:if="{{traceCursorVisible}}" class="trace-overview-cursor" style="left:{{traceCursorPercent}}%;" aria-hidden="true"/>
</view>
</view>
<view class="trace-overview-axis"><text>0 {{ui['秒']}}</text><text>{{ui[traceOverview.durationLabel] !== undefined ? ui[traceOverview.durationLabel] : traceOverview.durationLabel}}</text></view>
</view>
<scroll-view class="trajectory" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{traceScrollTarget}}" scroll-with-animation bindscroll="onTraceListScroll" bindscrolltoupper="loadOlder" upper-threshold="80">
<view has:if="{{historyLoading}}" class="hist-banner"><view class="banner-spinner"/><text class="banner-text">{{historyProgressText}}</text></view>
<view has:elif="{{hasMoreHistory}}" class="load-older" bindtap="loadOlder">{{histError || ui['加载更早记录']}}</view>
<view class="trace-list">
<view class="trace-window-spacer" style="height:{{traceSpacerTopRpx}}rpx;" aria-hidden="true"/>
<block has:for="{{trajectory}}" has:key="key">
<view has:if="{{item.kind === 'turn'}}" class="trace-turn {{traceFocusTouched ? 'trace-focus-muted' : ''}}"><view class="trace-turn-line" aria-hidden="true"/><text class="trace-turn-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text></view>
<view has:else id="trace-{{item.key}}" class="trace-native-row {{item.isError ? 'error' : ''}} {{item.running ? 'running' : ''}} {{traceHighlightedKey === item.key ? 'highlighted' : ''}} {{traceMetricTargetKey === item.key ? 'metric-target' : ''}} {{traceFocusTouched && traceFocusKey !== item.key ? 'trace-focus-muted' : ''}} {{traceDetail && traceDetail.key === item.key ? 'selected' : ''}} {{traceDetail && item.request && traceDetail.key === item.request.key ? 'selected' : ''}}" bindtap="openTraceDetail" data-key="{{item.key}}" hover-class="trace-row-pressed" hover-start-time="0" hover-stay-time="100" role="button" aria-label="{{ui['打开']}} {{item.displayBadge}} #{{ui[item.seqLabel] !== undefined ? ui[item.seqLabel] : item.seqLabel}}">
<view class="trace-request-gutter">
<view has:if="{{item.request}}" class="trace-dot-hit" catchtap="openTraceRequest" data-key="{{item.key}}" role="button" aria-label="{{ui['打开请求']}} #{{item.requestNumber}}"><view class="trace-node-dot request {{traceDetail && traceDetail.key === item.request.key ? 'active' : ''}} {{item.isError ? 'error' : ''}}"/></view>
</view>
<view class="trace-native-content">
<text class="trace-native-badge {{item.badgeClass}}">{{item.displayBadge}}</text>
<text has:if="{{item.badge !== 'USER' && item.badge !== 'ASSISTANT'}}" class="trace-native-name">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
<text class="trace-native-preview">{{item.preview}}</text>
<text class="trace-native-seq">#{{ui[item.seqLabel] !== undefined ? ui[item.seqLabel] : item.seqLabel}}</text><text class="trace-native-chevron">›</text>
</view>
</view>
</block>
<view class="trace-window-spacer" style="height:{{traceSpacerBottomRpx}}rpx;" aria-hidden="true"/>
<view has:if="{{!trajectory.length && !historyLoading}}" class="empty">{{histError || ui['暂无轨迹事件']}}</view>
</view>
</scroll-view>
</view>
<view has:if="{{contextMounted && showContextPanel}}" hidden="{{tab !== 'context'}}" class="context-panel {{tab !== 'context' ? 'session-panel-hidden' : ''}}" bindtouchstart="onPanelTouchStart" bindtouchmove="onPanelTouchMove" bindtouchend="onPanelTouchEnd" bindtouchcancel="onPanelTouchCancel">
<view class="context-toolbar">
<text has:if="{{contextPanel.meta.model}}" class="context-toolbar-title">{{contextPanel.meta.model}}</text>
<text has:if="{{contextPanel.meta.contextWindowText}}" class="context-toolbar-meta">{{contextPanel.meta.contextWindowText}}</text>
<view class="context-toolbar-spacer"></view>
<view has:if="{{contextPanel && contextPanel.status !== 'loading'}}" class="context-modal-open" bindtap="openContextModal" hover-class="press-dim" role="button" aria-label="{{ui['打开上下文弹窗']}}"><image class="context-toolbar-ic" src="/assets/icons/{{theme === 'dark' ? 'dsh-context-dark.svg' : 'dsh-context.svg'}}" mode="aspectFit"/></view>
<view has:if="{{contextPanel && contextPanel.status !== 'loading'}}" class="context-modal-open" bindtap="openContextInsights" hover-class="press-dim" role="button" aria-label="{{ui['上下文洞察']}}"><image class="context-toolbar-ic" src="/assets/icons/{{theme === 'dark' ? 'insight-white.svg' : 'insight-ink.svg'}}" mode="aspectFit"/></view>
</view>
<scroll-view class="context-scroll" scroll-y enhanced show-scrollbar="{{false}}" catchtap="closeContextBrowserPicker" bindscroll="contextPanelScroll" scroll-into-view="{{contextScrollTarget}}" scroll-with-animation>
<view id="ctxTop" class="ctx-top-anchor" aria-hidden="true"/>
<view has:if="{{!contextPanel || contextPanel.status === 'loading'}}" class="context-state">
<view class="state-spinner"></view>
<text class="context-state-text">{{ui['正在加载上下文…']}}</text>
<view class="ctx-skeleton"><view class="ctx-skeleton-row"/><view class="ctx-skeleton-row"/><view class="ctx-skeleton-row"/></view>
</view>
<view has:elif="{{contextPanel.status === 'disconnected' || contextPanel.status === 'empty'}}" class="context-state">
<text class="context-state-text">{{contextPanel.stateText}}</text>
</view>
<view has:elif="{{contextPanel.status === 'unsupported'}}" class="context-state">
<text class="context-state-title">{{contextPanel.stateText}}</text>
<text class="context-state-text">{{contextPanel.hintText}}</text>
</view>
<view has:elif="{{contextPanel.status === 'error'}}" class="context-state">
<text class="context-state-title">{{ui['上下文数据加载失败']}}</text>
<text class="context-state-text">{{contextPanel.errorText}}</text>
<view class="context-retry" bindtap="refreshContextDashboard" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['重试']}}">{{ui['重试']}}</view>
</view>
<block has:else>
<view class="ctx-card">
<view class="ctx-card-head">
<text class="ctx-card-title">{{ui['上下文统计']}}</text>
<view has:if="{{contextPanel.running}}" class="fleet-pulse on ctx-live-dot"></view>
</view>
<view class="ctx-flow" id="ctxFlow">
<view has:if="{{contextFlowLinks.length}}" class="ctx-flow-canvas" style="width:{{contextFlowW}}px;height:{{contextFlowH}}px;">
<view has:for="{{contextFlowLinks}}" has:key="key" class="ctx-flow-segment ctx-flow-{{item.kind}}" style="{{item.style}}"/>
</view>
<view class="ctx-flow-row ctx-flow-row-top">
<view class="ctx-flow-node" id="ctxNodeInputs">
<view class="ctx-flow-head"><text class="ctx-flow-label">{{ui['输入输出']}}</text><text class="ctx-flow-total">{{contextPanel.stats.ioTotalText}}</text></view>
<view class="ctx-pills">
<block has:for="{{contextPanel.stats.activity.chips}}" has:key="key">
<view has:if="{{!item.hidden}}" class="ctx-pill {{item.dim ? 'ctx-pill-dim' : ''}}" bindtap="contextStatsJump" data-key="{{item.key}}" hover-class="ctx-pill-pressed" role="button"><text class="ctx-pill-value">{{item.text}}</text><text class="ctx-pill-word">{{item.label}}</text><view has:if="{{item.key === 'userInputs'}}" class="ctx-stat-q" catchtap="contextStatTip" data-tip="humanInputs">?</view></view>
</block>
</view>
</view>
<view class="ctx-flow-node" id="ctxNodeEvents">
<view class="ctx-flow-head"><text class="ctx-flow-label">{{ui['上下文事件']}}</text><text class="ctx-flow-total">{{contextPanel.stats.eventTotalText}}</text></view>
<view class="ctx-pills">
<view has:for="{{contextPanel.stats.chips}}" has:key="key" class="ctx-pill ctx-pill-tint ctx-kind-{{item.key}} {{item.value === 0 ? 'ctx-pill-dim' : ''}}" bindtap="contextStatsJump" data-key="{{item.key}}" hover-class="ctx-pill-pressed" role="button"><text class="ctx-pill-value">{{item.text}}</text><text class="ctx-pill-word">{{item.label}}</text></view>
</view>
</view>
</view>
<view class="ctx-flow-mid">
<view class="ctx-flow-node ctx-flow-self" id="ctxNodeSession">
<text class="ctx-flow-label">{{ui['当前会话']}}</text>
<view class="ctx-flow-self-stats">
<view class="ctx-flow-kv"><text class="ctx-flow-kv-value">{{contextPanel.stats.turnsText}}</text><text class="ctx-flow-kv-label">{{ui['轮次']}}</text></view>
<view class="ctx-flow-kv"><text class="ctx-flow-kv-value">{{contextPanel.stats.stepsText}}</text><text class="ctx-flow-kv-label">{{ui['步数']}}</text></view>
</view>
<view class="ctx-flow-self-stats">
<view class="ctx-flow-kv ctx-flow-kv-btn" bindtap="contextStatsJump" data-key="skills" hover-class="ctx-flow-kv-pressed" role="button" aria-label="{{ui['在上下文浏览器中展开技能注入']}}"><text class="ctx-flow-kv-value">{{contextPanel.stats.skillsText}}</text><text class="ctx-flow-kv-label">{{ui['技能加载']}}</text></view>
<view class="ctx-flow-kv ctx-flow-kv-btn" bindtap="contextStatsJump" data-key="answers" hover-class="ctx-flow-kv-pressed" role="button" aria-label="{{ui['在上下文浏览器中筛选回答']}}"><text class="ctx-flow-kv-value">{{contextPanel.stats.answersText}}</text><text class="ctx-flow-kv-label">{{ui['模型回复']}}</text></view>
</view>
</view>
</view>
<view class="ctx-flow-row ctx-flow-row-bottom">
<view class="ctx-flow-node" id="ctxNodeTools">
<view class="ctx-flow-head"><text class="ctx-flow-label">{{ui['工具调用']}}</text><text class="ctx-flow-total">{{contextPanel.stats.toolTotalText}}</text></view>
<view class="ctx-pills ctx-pills-tools">
<view has:for="{{contextPanel.stats.toolPills}}" has:key="key" class="ctx-pill {{item.more ? 'ctx-pill-dim' : ''}}" hover-class="ctx-pill-pressed"><text class="ctx-pill-name">{{item.name}}</text><text has:if="{{item.countText}}" class="ctx-pill-count">{{item.countText}}</text></view>
</view>
</view>
<view class="ctx-flow-node ctx-flow-node-action" id="ctxNodeNet" bindtap="openContextFleet" hover-class="ctx-flow-node-pressed" role="button" aria-label="{{ui['编队总览']}}">
<view class="ctx-flow-head"><text class="ctx-flow-label">{{ui['Agent 网络']}}</text><view has:if="{{contextPanel.stats.network.hasData}}" class="ctx-stat-q" catchtap="contextStatTip" data-tip="subCost">?</view></view>
<view has:if="{{contextPanel.stats.network.hasData}}" class="ctx-flow-rows">
<view has:for="{{contextPanel.stats.network.rows}}" has:key="key" class="ctx-flow-rowline"><text class="ctx-flow-rowlabel">{{item.label}}</text><text class="ctx-flow-rowvalue">{{item.tokensText}}</text></view>
</view>
</view>
</view>
</view>
</view>
<view class="ctx-card">
<view class="ctx-card-head">
<text class="ctx-card-title">{{ui['当前上下文']}}</text>
<text has:if="{{contextPanel.current.modelText}}" class="ctx-card-sub">{{contextPanel.current.modelText}}</text>
</view>
<view has:if="{{!contextPanel.current.hasData}}" class="ctx-empty">{{ui['暂无上下文数据']}}</view>
<block has:else>
<view class="ctx-overview-num">
<text class="ctx-overview-value">{{contextPanel.current.numText}}</text>
<text class="ctx-overview-window">{{contextPanel.current.windowSuffix}}</text>
<view has:if="{{contextPanel.current.occupancyText}}" class="ctx-overview-pct"><text class="ctx-overview-pct-value">{{contextPanel.current.occupancyText}}</text><text class="ctx-overview-pct-label">{{ui['上下文已用']}}</text></view>
</view>
<view class="ctx-compose-bar">
<view has:for="{{contextPanel.current.barSegments}}" has:key="key" class="ctx-compose-seg ctx-c-{{item.key}} {{item.dim ? 'dim' : ''}} {{item.active ? 'active' : ''}}" style="width:{{item.width}}%;" bindtap="contextCurrentTap" data-key="{{item.key}}" role="button"/>
<view class="ctx-compose-free" style="width:{{contextPanel.current.freeWidth}}%;"/>
<view has:if="{{contextPanel.current.headroomMask}}" class="ctx-compose-mask ctx-mask-headroom" style="left:{{contextPanel.current.headroomMask.left}}%;width:{{contextPanel.current.headroomMask.width}}%;"/>
<view has:if="{{contextPanel.current.outputMask}}" class="ctx-compose-mask ctx-mask-output" style="left:{{contextPanel.current.outputMask.left}}%;width:{{contextPanel.current.outputMask.width}}%;"/>
<view has:if="{{contextPanel.current.triggerLeft !== null}}" class="ctx-compose-trigger" style="left:{{contextPanel.current.triggerLeft}}%;"/>
</view>
<view class="ctx-slice-grid ctx-slice-grid-flow">
<view has:for="{{contextPanel.current.rows}}" has:key="key" class="ctx-slice {{item.dim ? 'dim' : ''}} {{item.active ? 'active' : ''}}" bindtap="contextCurrentTap" data-key="{{item.key}}" hover-class="press-dim" role="button" aria-pressed="{{item.active}}">
<view class="ctx-slice-main"><view class="ctx-dot ctx-c-{{item.key}}"/><text class="ctx-slice-label">{{item.label}}</text><text class="ctx-slice-pct">{{item.pctText}}</text></view>
<text class="ctx-slice-sub">{{item.valueText}}</text>
</view>
</view>
</block>
</view>
<view class="ctx-card">
<view class="ctx-card-head">
<text class="ctx-card-title">{{ui['Token 统计']}}</text>
<text has:if="{{contextPanel.tokens.hasHit}}" class="ctx-card-rate" bindtap="contextStatTip" data-tip="cacheHit">{{ui['缓存命中']}} {{contextPanel.tokens.hitText}}%</text>
</view>
<view class="ctx-donut-row">
<view class="ctx-donut" style="{{contextPanel.tokens.donut.style}}">
<view class="ctx-donut-hole"><text class="ctx-donut-value">{{contextPanel.tokens.centerText}}</text><text class="ctx-donut-unit">{{contextPanel.tokens.centerSub}}</text></view>
</view>
<view class="ctx-slice-grid">
<block has:for="{{contextPanel.tokens.rows}}" has:key="key">
<view has:if="{{!item.hidden}}" class="ctx-slice">
<view class="ctx-slice-main"><view class="ctx-dot ctx-c-{{item.key}}"/><text class="ctx-slice-label">{{item.label}}</text><text class="ctx-slice-pct">{{item.pct}}</text></view>
<text class="ctx-slice-sub">{{item.subText}}</text>
</view>
</block>
</view>
</view>
</view>
<view class="ctx-card">
<view class="ctx-card-head">
<text class="ctx-card-title">{{ui['耗时统计']}}</text>
<text class="ctx-card-sub">{{contextPanel.timing.scopeText}}</text>
<text has:if="{{contextPanel.timing.hasSpeed}}" class="ctx-card-rate" bindtap="contextStatTip" data-tip="tps">{{ui['输出速度']}} {{contextPanel.timing.speedText}}</text>
</view>
<view has:if="{{!contextPanel.timing.hasData}}" class="ctx-empty">{{contextPanel.timing.emptyText}}</view>
<block has:else>
<view class="ctx-donut-row">
<view class="ctx-donut" style="{{contextPanel.timing.donutStyle}}">
<view class="ctx-donut-hole"><text class="ctx-donut-value">{{contextPanel.timing.activeText}}</text><text class="ctx-donut-unit">{{contextPanel.timing.activeLabel}}</text></view>
</view>
<view class="ctx-slice-grid">
<view has:for="{{contextPanel.timing.rows}}" has:key="key" class="ctx-slice">
<view class="ctx-slice-main"><view class="ctx-dot ctx-t-{{item.key}}"/><text class="ctx-slice-label">{{item.label}}</text><text class="ctx-slice-pct">{{item.pctText}}</text></view>
<text has:if="{{item.subText}}" class="ctx-slice-sub">{{item.subText}}</text>
</view>
</view>
</view>
<view has:if="{{contextPanel.timing.hasTimeline}}" class="ctx-tstrip">
<view class="ctx-tstrip-bar">
<view has:for="{{contextPanel.timing.timeline}}" has:key="key" class="ctx-tstrip-seg ctx-span-{{item.kind}}" style="{{item.style}}"/>
</view>
<view class="ctx-tstrip-axis">
<text has:for="{{contextPanel.timing.timelineTicks}}" has:key="key" class="ctx-tstrip-tick {{item.first ? 'ctx-tstrip-tick-first' : ''}} {{item.last ? 'ctx-tstrip-tick-last' : ''}}" style="left:{{item.left}}%;">{{item.text}}</text>
</view>
</view>
</block>
</view>
<view class="ctx-card">
<view class="ctx-card-head">
<text class="ctx-card-title">{{ui['上下文趋势']}}</text>
<text class="ctx-card-sub">{{contextPanel.trend.count}}/{{contextPanel.trend.totalCount}}</text>
</view>
<view class="ctx-trend-controls">
<view class="ctx-trend-control-group">
<view class="ctx-trend-control {{contextPanel.trend.dna ? 'active' : ''}}" catchtap="contextTrendDna" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.trend.dna}}">{{ui['DNA 模式']}}</view>
<view class="ctx-trend-control {{contextPanel.trend.adaptive ? 'active' : ''}}" catchtap="contextTrendAdaptive" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.trend.adaptive}}">{{ui['自适应']}}</view>
<view class="ctx-trend-control {{contextPanel.trend.showDuration ? 'active' : ''}}" catchtap="contextTrendDuration" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.trend.showDuration}}">{{ui['耗时']}}</view>
<view class="ctx-trend-control {{contextPanel.trend.overview ? 'active' : ''}}" catchtap="contextTrendOverview" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.trend.overview}}">{{ui['总览']}}</view>
</view>
<view class="ctx-trend-control-group">
<view class="ctx-trend-control {{contextPanel.trend.groupBy === 'step' ? 'active' : ''}}" catchtap="contextTrendGroup" data-group="step" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.trend.groupBy === 'step'}}">{{ui['步骤']}}</view>
<view class="ctx-trend-control {{contextPanel.trend.groupBy === 'turn' ? 'active' : ''}}" catchtap="contextTrendGroup" data-group="turn" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.trend.groupBy === 'turn'}}">{{ui['轮次']}}</view>
</view>
<view class="ctx-trend-control-group">
<view class="ctx-trend-control {{contextPanel.trend.displayMode === 'total' ? 'active' : ''}}" catchtap="contextTrendMode" data-mode="total" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.trend.displayMode === 'total'}}">{{ui['全量']}}</view>
<view class="ctx-trend-control {{contextPanel.trend.displayMode === 'delta' ? 'active' : ''}}" catchtap="contextTrendMode" data-mode="delta" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.trend.displayMode === 'delta'}}">{{ui['增量']}}</view>
</view>
<text has:if="{{contextPanel.trend.aggregated}}" class="ctx-trend-aggregate-note">{{ui['按轮聚合']}}</text>
</view>
<view has:if="{{contextPanel.trend.empty}}" class="ctx-empty">{{ui['暂无上下文数据']}}</view>
<view has:elif="{{contextPanel.trend.overview}}" class="ctx-trend-row ctx-trend-surface-overview">
<view class="ctx-trend-axis">
<text has:for="{{contextPanel.trend.axis}}" has:key="key" class="ctx-trend-axis-tick" style="top:{{item.top}}rpx;">{{item.text}}</text>
</view>
<view class="ctx-trend-main">
<view class="ctx-trend-fit" catchtouchstart="contextTrendTouchStart" catchtouchmove="contextTrendTouchMove" catchtouchend="contextTrendTouchEnd" catchtouchcancel="contextTrendTouchEnd">
<view class="ctx-trend-chart ctx-trend-chart-fit">
<view has:for="{{contextPanel.trend.grid}}" has:key="key" class="ctx-trend-grid ctx-trend-grid-{{item.key}}" style="top:{{item.top}}rpx;"/>
<view class="ctx-trend-columns">
<view has:for="{{contextPanel.trend.ribbon.columns}}" has:key="key" class="ctx-trend-column">
<view has:for="{{item.segments}}" has:for-item="seg" has:key="key" class="ctx-trend-column-seg ctx-c-{{seg.key}}" style="height:{{seg.px}}rpx;"></view>
</view>
</view>
<view has:if="{{contextPanel.trend.hasDuration}}" class="ctx-dur{{contextPanel.trendActiveTurn !== null && contextPanel.trendActiveTurn !== undefined ? ' ctx-dur-dim' : ''}}">
<view has:for="{{contextPanel.trend.ribbon.durationSegments}}" has:key="key" class="ctx-dur-seg {{item.halo ? 'ctx-dur-halo' : 'ctx-dur-core'}}" style="{{item.style}}"/>
<view has:for="{{contextPanel.trend.ribbon.durationDots}}" has:key="key" class="ctx-dur-dot {{item.halo ? 'ctx-dur-halo' : 'ctx-dur-core'}}" style="{{item.style}}"/>
</view>
<block has:for="{{contextPanel.trend.ribbon.flags}}" has:key="key">
<view class="ctx-trend-flagpole ctx-fit-flagpole" style="left:{{item.left}}%;">
<text class="ctx-trend-flaglabel">{{item.text}}</text>
</view>
</block>
<view has:if="{{contextPanel.trend.ribbon.cursorLeft >= 0}}" class="ctx-fit-cursor" style="left:{{contextPanel.trend.ribbon.cursorLeft}}%;"/>
<view has:if="{{contextPanel.trend.hoverLeft >= 0}}" class="ctx-trend-hoverline" style="left:{{contextPanel.trend.hoverLeft}}%;"/>
</view>
</view>
<view has:if="{{contextPanel.trend.tipLeft >= 0 && contextPanel.trendDetail.hasData}}" class="ctx-trend-tip" style="left:{{contextPanel.trend.tipLeft}}px;">
<block has:if="{{contextPanel.trendDetail.turnText || contextPanel.trendDetail.stepText}}">
<text class="ctx-trend-tip-head">{{contextPanel.trendDetail.turnText}}{{contextPanel.trendDetail.stepText ? ' · ' + contextPanel.trendDetail.stepText : ''}}</text>
</block>
<text has:else class="ctx-trend-tip-head">{{contextPanel.trendDetail.requestLabel}}</text>
<view class="ctx-trend-tip-metrics">
<text class="ctx-trend-tip-metric">{{contextPanel.trendDetail.estimatedText}}</text>
<text has:if="{{contextPanel.trendDetail.durationText}}" class="ctx-trend-tip-metric">{{contextPanel.trendDetail.durationLabel}} {{contextPanel.trendDetail.durationText}}</text>
<text has:if="{{contextPanel.trendDetail.deltaText !== '—'}}" class="ctx-trend-tip-metric ctx-trend-delta-{{contextPanel.trendDetail.deltaClass}}">Δ {{contextPanel.trendDetail.deltaText}}</text>
</view>
</view>
<view class="ctx-trend-turns ctx-trend-turns-fit{{contextPanel.trendActiveTurn !== null && contextPanel.trendActiveTurn !== undefined ? ' ctx-trend-turns-dim' : ''}}">
<view has:for="{{contextPanel.trend.turnStrip}}" has:key="key" class="ctx-trend-turn {{item.on ? 'on' : ''}} {{item.dimmed ? 'dimmed' : ''}} zebra-{{item.zebra}}" style="flex:{{item.flex}} 1 0;" data-turn="{{item.turn}}" bindtap="contextTrendPickTurn" hover-class="press-dim">
<text class="ctx-trend-turnlabel">{{item.turnText}}</text>
</view>
</view>
</view>
<view has:if="{{contextPanel.trend.hasDurationAxis}}" class="ctx-trend-axis ctx-trend-axis-r">
<text has:for="{{contextPanel.trend.durationAxis}}" has:key="key" class="ctx-trend-axis-tick" style="top:{{item.top}}rpx;">{{item.text}}</text>
</view>
</view>
<view has:else class="ctx-trend-row {{contextPanel.trend.dna ? 'ctx-trend-dna' : ''}}">
<view class="ctx-trend-axis">
<text has:for="{{contextPanel.trend.axis}}" has:key="key" class="ctx-trend-axis-tick" style="top:{{item.top}}rpx;">{{item.text}}</text>
</view>
<view class="ctx-trend-main">
<scroll-view class="ctx-trend-scroll" scroll-x enhanced show-scrollbar="{{false}}" catchtouchstart="contextTrendTouchStart" catchtouchmove="contextTrendTouchMove" catchtouchend="contextTrendTouchEnd" catchtouchcancel="contextTrendTouchEnd" bindscroll="contextTrendScroll" scroll-into-view="{{contextPanel.trendAnchor}}">
<view class="ctx-trend-chart" style="width:{{contextPanel.trend.chartWidth}}rpx;">
<view has:for="{{contextPanel.trend.grid}}" has:key="key" class="ctx-trend-grid ctx-trend-grid-{{item.key}}" style="top:{{item.top}}rpx;"/>
<block has:for="{{contextPanel.trend.bars}}" has:key="key">
<view has:if="{{item.flag}}" class="ctx-trend-flagpole" style="left:{{index * 28 + 26}}rpx;">
<text class="ctx-trend-flaglabel">{{item.flag}}</text>
</view>
</block>
<view has:for="{{contextPanel.trend.bars}}" has:key="key" class="ctx-trend-col {{item.selected ? 'selected' : ''}} {{item.dimmed ? 'dimmed' : ''}} {{item.seq === contextPanel.trend.hoverSeq ? 'hovered' : ''}}" data-seq="{{item.seq}}" bindtap="contextTrendSelect" bindlongpress="contextTrendSelect" hover-class="ctx-trend-pressed" role="button" aria-label="{{item.seqText}}">
<text has:if="{{item.marker}}" class="ctx-trend-bar-marker">✂</text>
<view class="ctx-trend-barwrap">
<block has:if="{{contextPanel.trend.dna && item.dna !== null}}">
<view class="ctx-trend-bar">
<view has:for="{{item.dna}}" has:for-item="band" has:key="key" class="ctx-trend-seg ctx-c-{{band.key}}" style="height:{{band.px}}rpx;"/>
</view>
</block>
<view has:elif="{{contextPanel.trend.displayMode === 'total'}}" class="ctx-trend-bar">
<view has:for="{{item.segments}}" has:for-item="seg" has:key="key" class="ctx-trend-seg ctx-c-{{seg.key}}" style="height:{{seg.px}}rpx;"/>
</view>
<view has:else class="ctx-trend-deltaplot">
<view class="ctx-trend-deltaarm down" style="top:{{item.upPx}}rpx;">
<view has:for="{{item.decreaseSegments}}" has:for-item="seg" has:key="key" class="ctx-trend-deltaseg ctx-c-{{seg.key}}" style="height:{{seg.px}}rpx;"/>
</view>
<view class="ctx-trend-deltaarm up" style="bottom:{{item.downPx}}rpx;">
<view has:for="{{item.segments}}" has:for-item="seg" has:key="key" class="ctx-trend-deltaseg ctx-c-{{seg.key}}" style="height:{{seg.px}}rpx;"/>
</view>
</view>
</view>
</view>
<view has:if="{{contextPanel.trend.hasDuration}}" class="ctx-dur{{contextPanel.trendActiveTurn !== null && contextPanel.trendActiveTurn !== undefined ? ' ctx-dur-dim' : ''}}">
<view has:for="{{contextPanel.trend.durationSegments}}" has:key="key" class="ctx-dur-seg {{item.halo ? 'ctx-dur-halo' : 'ctx-dur-core'}}" style="{{item.style}}"/>
<view has:for="{{contextPanel.trend.durationDots}}" has:key="key" class="ctx-dur-dot {{item.halo ? 'ctx-dur-halo' : 'ctx-dur-core'}}" style="{{item.style}}"/>
</view>
<view has:if="{{contextPanel.trend.hoverX >= 0}}" class="ctx-trend-hoverline" style="left:{{contextPanel.trend.hoverX}}rpx;"/>
</view>
</scroll-view>
<view has:if="{{contextPanel.trend.tipLeft >= 0 && contextPanel.trendDetail.hasData}}" class="ctx-trend-tip" style="left:{{contextPanel.trend.tipLeft}}px;">
<block has:if="{{contextPanel.trendDetail.turnText || contextPanel.trendDetail.stepText}}">
<text class="ctx-trend-tip-head">{{contextPanel.trendDetail.turnText}}{{contextPanel.trendDetail.stepText ? ' · ' + contextPanel.trendDetail.stepText : ''}}</text>
</block>
<text has:else class="ctx-trend-tip-head">{{contextPanel.trendDetail.requestLabel}}</text>
<view class="ctx-trend-tip-metrics">
<text class="ctx-trend-tip-metric">{{contextPanel.trendDetail.estimatedText}}</text>
<text has:if="{{contextPanel.trendDetail.durationText}}" class="ctx-trend-tip-metric">{{contextPanel.trendDetail.durationLabel}} {{contextPanel.trendDetail.durationText}}</text>
<text has:if="{{contextPanel.trendDetail.deltaText !== '—'}}" class="ctx-trend-tip-metric ctx-trend-delta-{{contextPanel.trendDetail.deltaClass}}">Δ {{contextPanel.trendDetail.deltaText}}</text>
</view>
</view>
<scroll-view class="ctx-trend-turnscroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-left="{{contextPanel.trendTurnLeft}}">
<view class="ctx-trend-turns" style="width:{{contextPanel.trend.turnStripWidth}}rpx;{{contextPanel.trend.labelFont ? 'font-size:' + contextPanel.trend.labelFont + ';' : ''}}">
<view has:for="{{contextPanel.trend.turnStrip}}" has:key="key" class="ctx-trend-turn {{item.on ? 'on' : ''}} {{item.dimmed ? 'dimmed' : ''}} zebra-{{item.zebra}}" style="width:{{item.width}}rpx;" data-turn="{{item.turn}}" bindtap="contextTrendPickTurn" hover-class="press-dim">
<text class="ctx-trend-turnlabel">{{item.turnText}}</text>
</view>
</view>
</scroll-view>
</view>
<view has:if="{{contextPanel.trend.hasDurationAxis}}" class="ctx-trend-axis ctx-trend-axis-r">
<text has:for="{{contextPanel.trend.durationAxis}}" has:key="key" class="ctx-trend-axis-tick" style="top:{{item.top}}rpx;">{{item.text}}</text>
</view>
</view>
<view has:if="{{contextPanel.trendDetail.hasData}}" class="ctx-trend-detail">
<view class="ctx-trend-detail-head">
<text class="ctx-trend-detail-title">{{contextPanel.trendDetail.requestLabel}}</text>
<text has:if="{{contextPanel.trendDetail.markerText}}" class="ctx-trend-marker-chip">✂ {{contextPanel.trendDetail.markerTimeText}}</text>
<text has:for="{{contextPanel.trendDetail.tags}}" has:key="key" class="ctx-trend-tag">{{item.label}}</text>
<text class="ctx-trend-detail-time">{{contextPanel.trendDetail.timeText}}</text>
</view>
<view class="ctx-trend-metrics">
<text class="ctx-trend-metric">{{contextPanel.trendDetail.estimatedLabel}} {{contextPanel.trendDetail.estimatedText}}</text>
<text has:if="{{contextPanel.trendDetail.actualPromptText !== '—'}}" class="ctx-trend-metric">{{contextPanel.trendDetail.promptLabel}} {{contextPanel.trendDetail.actualPromptText}}</text>
<text has:if="{{contextPanel.trendDetail.outputText !== '—'}}" class="ctx-trend-metric">{{contextPanel.trendDetail.outputLabel}} {{contextPanel.trendDetail.outputText}}</text>
<text has:if="{{contextPanel.trendDetail.cacheText}}" class="ctx-trend-metric">{{contextPanel.trendDetail.cacheLabel}} {{contextPanel.trendDetail.cacheText}}</text>
<text has:if="{{contextPanel.trendDetail.durationText}}" class="ctx-trend-metric">{{contextPanel.trendDetail.durationLabel}} {{contextPanel.trendDetail.durationText}}</text>
<text has:if="{{contextPanel.trendDetail.deltaText !== '—'}}" class="ctx-trend-metric ctx-trend-metric-delta ctx-trend-delta-{{contextPanel.trendDetail.deltaClass}}">Δ {{contextPanel.trendDetail.deltaClass === 'flat' ? '' : ''}}{{contextPanel.trendDetail.deltaText}}</text>
</view>
<view class="ctx-brief">
<view has:for="{{contextPanel.trendDetail.brief}}" has:key="key" class="ctx-brief-row {{item.empty ? 'empty' : ''}}" catchtap="contextBriefLocate" data-seq="{{item.locateSeq}}" data-cat="{{item.locateCat}}" hover-class="press-dim">
<text class="ctx-brief-tag">{{item.tag}}</text>
<block has:if="{{!item.empty}}">
<view has:for="{{item.chips}}" has:for-item="chip" has:key="key" class="ctx-brief-chip" catchtap="contextBriefLocate" data-seq="{{chip.seq}}" data-cat="{{chip.cat}}">
<view has:if="{{chip.error}}" class="ctx-br-errdot"></view>
<text>{{chip.label}}</text>
</view>
<text has:if="{{item.more}}" class="ctx-brief-more">+{{item.more}}</text>
</block>
<text has:elif="{{item.emptyText}}" class="ctx-brief-empty">{{item.emptyText}}</text>
</view>
</view>
<view has:if="{{contextPanel.trendDetail.markerText}}" class="ctx-trend-markernote">
<text class="ctx-trend-markernote-text">{{contextPanel.trendDetail.markerText}}</text>
</view>
<view class="ctx-trend-detail-rows">
<view has:for="{{contextPanel.trendDetail.rows}}" has:key="key" class="ctx-trend-detail-row">
<view class="ctx-dot ctx-c-{{item.key}}"/>
<text class="ctx-trend-detail-name">{{item.label}}</text>
<text class="ctx-trend-detail-pct">{{item.pctText}}</text>
<text class="ctx-trend-detail-value">{{item.valueText}}</text>
<text class="ctx-trend-detail-delta ctx-delta-{{item.deltaClass}}">{{item.deltaText}}</text>
</view>
</view>
</view>
</view>
<view class="ctx-card" id="ctxBrowserCard">
<view class="ctx-card-head">
<text class="ctx-card-title">{{ui['上下文浏览器']}}</text>
<view class="ctx-br-head-actions">
<view class="ctx-gran">
<view class="ctx-gran-btn {{contextPanel.browser.base === 'step' ? 'on' : ''}}" bindtap="setContextBrowserBase" data-base="step" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.browser.base === 'step'}}">{{ui['比前步']}}</view>
<view class="ctx-gran-btn {{contextPanel.browser.base === 'turn' ? 'on' : ''}}" bindtap="setContextBrowserBase" data-base="turn" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.browser.base === 'turn'}}">{{ui['比前轮']}}</view>
</view>
<view class="ctx-gran">
<view class="ctx-gran-btn {{contextPanel.browser.dna ? 'on' : ''}}" catchtap="contextTrendDna" hover-class="press-dim" role="button" aria-pressed="{{contextPanel.browser.dna}}">{{ui['DNA 模式']}}</view>
</view>
</view>
</view>
<view has:if="{{contextPanel.browser.empty}}" class="ctx-empty">{{ui['暂无请求记录']}}</view>
<block has:else>
<view class="ctx-br-nav">
<view class="ctx-browser-step {{contextPanel.browser.canPrev ? '' : 'disabled'}}" bindtap="contextBrowserStep" data-step="-1" hover-class="press-dim" role="button"><view class="ctx-browser-step-arrow left" aria-hidden="true"/><text>{{ui['上一步']}}</text></view>
<view class="ctx-browser-picker {{contextBrowserPickerOpen && !contextModalOpen ? 'open' : ''}}">
<view class="ctx-browser-picker-value" catchtap="contextBrowserPickerToggle" hover-class="press-dim" role="button" aria-haspopup="listbox" aria-expanded="{{contextBrowserPickerOpen && !contextModalOpen}}"><text class="ctx-browser-picker-label">{{contextPanel.browser.selectedLabel}}</text><view class="ctx-browser-caret {{contextBrowserPickerOpen && !contextModalOpen ? 'open' : ''}}" aria-hidden="true"/></view>
<scroll-view has:if="{{contextBrowserPickerOpen && !contextModalOpen}}" class="ctx-browser-options" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{contextBrowserPickerTarget}}" catchtap="noop" role="listbox" aria-label="{{ui['上下文浏览器']}}">
<view has:for="{{contextPanel.browser.options}}" has:for-index="index" has:key="key" id="ctxBrowserOption{{index}}" class="ctx-browser-option {{index === contextPanel.browser.selectedIndex ? 'selected' : ''}}" catchtap="contextBrowserPick" data-index="{{index}}" hover-class="press-dim" role="option" aria-selected="{{index === contextPanel.browser.selectedIndex}}"><text class="ctx-browser-option-label">{{item.label}}</text><text has:if="{{index === contextPanel.browser.selectedIndex}}" class="ctx-browser-option-check" aria-hidden="true">✓</text></view>
</scroll-view>
</view>
<view class="ctx-browser-step {{contextPanel.browser.canNext ? '' : 'disabled'}}" bindtap="contextBrowserStep" data-step="1" hover-class="press-dim" role="button"><text>{{ui['下一步']}}</text><view class="ctx-browser-step-arrow right" aria-hidden="true"/></view>
</view>
<view class="ctx-br-meta">
<text><text class="ctx-br-meta-strong">{{contextPanel.browser.selectedSeq === null ? ui['当前 · 下一次请求'] : contextPanel.browser.selectedLabel}}</text><text has:if="{{contextPanel.browser.timeText}}" class="ctx-br-meta-time"> {{contextPanel.browser.timeText}}</text></text>
<text class="ctx-br-meta-item">{{contextPanel.browser.estimatedLabel}} {{contextPanel.browser.estimatedText}}</text>
<text class="ctx-br-meta-item">{{contextPanel.browser.promptLabel}} {{contextPanel.browser.promptText}}</text>
</view>
<view class="ctx-br-bar">
<view has:for="{{contextPanel.browser.composition}}" has:key="key" class="ctx-br-bar-seg ctx-c-{{item.key}}" style="width:{{item.width}}%;"/>
</view>
<view has:if="{{contextPanel.browser.historyPartial}}" class="ctx-br-note">{{contextPanel.browser.historyPartialText}}</view>
<scroll-view has:if="{{contextPanel.browser.dna}}" class="ctx-br-scroll ctx-trend-dna" scroll-y enhanced show-scrollbar="{{false}}">
<view class="ctx-br-flat-head">
<text class="ctx-br-flat-title">{{contextPanel.browser.dnaCountText}}</text>
<text class="ctx-br-note-inline">{{ui['按模型阅读顺序（最新在上）']}}</text>
</view>
<view has:for="{{contextPanel.browser.dnaRows}}" has:key="key" class="ctx-br-flat-row {{contextNodeDetail && contextNodeDetail.seq === item.seq ? 'on' : ''}}" catchtap="toggleContextDnaNode" data-seq="{{item.seq}}">
<view class="ctx-br-flat-line">
<text class="ctx-br-pos">{{item.posText}}</text>
<text class="ctx-br-cat-chip ctx-c-{{item.category}}">{{item.categoryText}}</text>
<text class="ctx-br-flat-label">{{item.label}}</text>
<text has:if="{{item.stamp}}" class="ctx-br-stamp">{{item.stamp}}</text>
<text class="ctx-br-tok">{{item.tokenText}}</text>
</view>
<view has:if="{{item.metaText}}" class="ctx-br-flat-meta">{{item.metaText}}</view>
<text has:if="{{contextNodeDetail && contextNodeDetail.seq === item.seq}}" class="ctx-br-content" user-select>{{contextNodeDetail.text}}</text>
</view>
<text has:if="{{!contextPanel.browser.dnaRows.length}}" class="ctx-empty">{{ui['暂无请求记录']}}</text>
</scroll-view>
<scroll-view has:else class="ctx-br-scroll" scroll-y enhanced show-scrollbar="{{false}}">
<view has:for="{{contextPanel.browser.rows}}" has:key="key" class="ctx-br-cat {{item.empty ? 'empty' : ''}} {{item.expanded ? 'on' : ''}}">
<view class="ctx-br-cat-row" bindtap="toggleContextBrowserRow" data-key="{{item.key}}" hover-class="press-dim" role="button" aria-expanded="{{item.expanded}}">
<text class="ctx-br-chevron">{{item.expanded ? '▾' : '▸'}}</text>
<view class="ctx-br-swatch {{item.swatch}}"/>
<text class="ctx-br-cat-name">{{item.label}}</text>
<text has:if="{{item.countText}}" class="ctx-br-count">{{item.countText}}</text>
<text has:if="{{item.countDeltaText}}" class="ctx-br-delta ctx-delta-{{item.countDeltaClass}}">{{item.countDeltaText}}</text>
<text class="ctx-br-token">{{item.tokenText}}</text>
<text has:if="{{item.tokenDeltaText}}" class="ctx-br-delta ctx-delta-{{item.tokenDeltaClass}}">{{item.tokenDeltaText}}</text>
<text class="ctx-br-pct">{{item.pctText}}</text>
</view>
<view has:if="{{item.expanded}}" class="ctx-br-body">
<view class="ctx-br-toolbar">
<input class="ctx-br-search" value="{{contextPanel.browser.query}}" placeholder="{{ui['按内容过滤…']}}" confirm-type="search" maxlength="80" bindinput="setContextBrowserQuery"/>
<view has:if="{{item.key === 'assistant'}}" class="ctx-gran ctx-br-kinds">
<view has:for="{{contextPanel.browser.kindChips}}" has:for-item="chip" has:key="key" class="ctx-gran-btn {{chip.active ? 'on' : ''}}" bindtap="setContextBrowserKind" data-kind="{{chip.key}}" hover-class="press-dim" role="button" aria-pressed="{{chip.active}}">{{chip.label}}</view>
</view>
</view>
<view has:if="{{!item.nodes.length}}" class="ctx-br-note">{{ui['没有匹配当前过滤条件的行']}}</view>
<view has:for="{{item.nodes}}" has:for-item="node" has:key="key" class="ctx-br-elem {{node.expanded ? 'on' : ''}} {{contextNodeDetail && contextNodeDetail.seq === node.seq ? 'on' : ''}} {{node.cat === 'tools' ? 'ctx-br-tool-row' : ''}}" catchtap="contextBrowserNodeTap" data-cat="{{node.cat}}" data-seq="{{node.seq}}" data-name="{{node.chips[0]}}" hover-class="press-dim" role="button">
<view class="ctx-br-elem-row">
<view has:if="{{node.error}}" class="ctx-br-errdot"/>
<view has:for="{{node.chips}}" has:for-item="chip" has:key="*this" class="ctx-br-tag">{{chip}}</view>
<text has:if="{{node.source}}" class="ctx-br-source-chip">{{node.source}}</text>
<text class="ctx-br-preview">{{node.preview}}</text>
<text has:if="{{node.stamp}}" class="ctx-br-stamp">{{node.stamp}}</text>
<text has:if="{{node.timeText}}" class="ctx-br-time">{{node.timeText}}</text>
<text class="ctx-br-tok">{{node.tokenText}}</text>
</view>
<view has:if="{{node.expanded && node.cat === 'tools'}}" class="ctx-br-tool">
<view has:if="{{node.description}}" class="ctx-br-tool-desc">{{node.description}}</view>
<view has:if="{{node.params.length}}" class="ctx-br-params">
<view has:for="{{node.params}}" has:for-item="param" has:key="name" class="ctx-br-param">
<text class="ctx-br-param-name">{{param.name}}</text>
<text class="ctx-br-param-type">{{param.type}}</text>
<text class="ctx-br-param-req">{{param.required ? '✓' : '·'}}</text>
<text class="ctx-br-param-desc">{{param.description}}</text>
</view>
</view>
<view has:elif="{{node.metaOnly}}" class="ctx-br-note">{{ui['此环境不支持按需读取头部内容，仅显示 token 估算']}}</view>
<view has:else class="ctx-br-note">{{ui['（无参数）']}}</view>
</view>
<view has:if="{{node.cat !== 'tools' && contextNodeDetail && contextNodeDetail.seq === node.seq}}" class="ctx-br-detail">
<view class="ctx-br-detail-head"><text class="ctx-br-detail-meta">{{contextNodeDetail.lineText}}</text><view class="ctx-br-copy" catchtap="copyContextNodeText" role="button">{{contextNodeDetail.copied ? ui['已复制'] : ui['复制']}}</view></view>
<text class="ctx-br-content" user-select>{{contextNodeDetail.text}}</text>
<text has:if="{{contextNodeDetail.truncated}}" class="ctx-br-note">{{ui['内容已截断']}}</text>
</view>
</view>
<view has:if="{{item.moreNodes > 0}}" class="ctx-br-note">{{ui['还有更多项目']}} {{item.moreNodes}}</view>
</view>
</view>
</scroll-view>
</block>
</view>
<view has:if="{{contextPanel.events.hasData}}" id="ctxEventsCard" class="ctx-card">
<view class="ctx-card-head"><text class="ctx-card-title">{{ui['上下文事件']}}</text></view>
<view class="ctx-event-chips">
<view has:for="{{contextPanel.events.filters}}" has:key="key" class="ctx-event-chip {{item.active ? 'active ctx-kind-' + item.key : ''}}" bindtap="setContextEventFilter" data-filter="{{item.key}}" hover-class="press-dim" role="button" aria-pressed="{{item.active}}">{{item.label}}<text has:if="{{item.countText}}" class="ctx-event-chip-n">{{item.countText}}</text></view>
</view>
<view has:if="{{contextPanel.events.empty}}" class="ctx-empty">{{ui['暂无匹配的上下文事件']}}</view>
<scroll-view has:else class="ctx-event-lane" scroll-y enhanced show-scrollbar="{{false}}">
<view has:for="{{contextPanel.events.rows}}" has:key="key" class="ctx-event-row">
<text class="ctx-event-icon ctx-e-{{item.kindClass}}">{{item.icon}}</text>
<text class="ctx-event-kind ctx-e-{{item.kindClass}}">{{item.kindText}}</text>
<text class="ctx-event-name">{{item.name}}</text>
<text has:if="{{item.positionText}}" class="ctx-event-pos">{{item.positionText}}</text>
<text has:if="{{item.tokensText}}" class="ctx-event-tokens ctx-event-tokens-{{item.tokensClass}}">{{item.tokensText}}</text>
<text class="ctx-event-time">{{item.timeText}}</text>
</view>
</scroll-view>
</view>
<view class="ctx-card" id="ctxFileCard">
<view class="ctx-card-head">
<text class="ctx-card-title">{{ui['文件活动']}}</text>
<text class="ctx-card-sub">{{contextPanel.files.totalFilesText}}</text>
<text has:if="{{contextPanel.files.deltaText}}" class="ctx-card-sub">{{contextPanel.files.deltaText}}</text>
</view>
<view class="ctx-gran ctx-file-chips">
<view has:for="{{contextPanel.files.chips}}" has:key="key" class="ctx-gran-btn {{item.active ? 'on' : ''}}" bindtap="setContextFileFilter" data-filter="{{item.key}}" hover-class="press-dim" role="button">{{item.label}}<text class="ctx-file-chip-n">{{item.countText}}</text></view>
</view>
<view class="ctx-file-controls">
<input class="ctx-br-search" value="{{contextPanel.files.query}}" placeholder="{{ui['按路径过滤…']}}" confirm-type="search" maxlength="120" bindinput="setContextFileQuery"/>
<view class="ctx-gran ctx-file-sorts">
<view has:for="{{contextPanel.files.sorts}}" has:key="key" class="ctx-gran-btn {{item.active ? 'on' : ''}}" bindtap="setContextFileSort" data-sort="{{item.key}}" hover-class="press-dim" role="button">{{item.label}}</view>
</view>
</view>
<view has:if="{{contextPanel.files.empty}}" class="ctx-empty">{{ui['该范围内没有文件读取、写入或搜索操作']}}</view>
<view has:elif="{{contextPanel.files.noMatches}}" class="ctx-empty">{{ui['未找到匹配的文件活动']}}</view>
<scroll-view has:else class="ctx-file-lane" scroll-y enhanced show-scrollbar="{{false}}">
<view has:for="{{contextPanel.files.rows}}" has:key="key" class="ctx-file-row {{item.expanded ? 'on' : ''}}">
<view class="ctx-file-row-head" bindtap="contextFileActivitySelect" data-path="{{item.path}}" hover-class="press-dim" role="button">
<text class="ctx-file-chevron">{{item.expanded ? '▾' : '▸'}}</text>
<view has:if="{{item.glyph.emoji}}" class="ctx-file-glyph">{{item.glyph.label}}</view>
<view has:else class="ctx-file-lang" style="background:{{item.glyph.color}};color:{{item.glyph.color === '#f7df1e' || item.glyph.color === '#89e051' ? '#1f2328' : '#ffffff'}}">{{item.glyph.label}}</view>
<view class="ctx-file-name-wrap"><text class="ctx-file-pathdir">{{item.dirText}}</text><text class="ctx-file-pathname">{{item.nameText}}</text></view>
<view has:for="{{item.badges}}" has:for-item="badge" has:key="key" class="ctx-file-badge ctx-file-badge-{{badge.key}}"><text class="ctx-file-badge-dot"></text><text>{{badge.label}}</text><text class="ctx-file-badge-n">{{badge.count}}</text></view>
<text has:if="{{item.addedText}}" class="ctx-file-add">{{item.addedText}}</text>
<text has:if="{{item.removedText}}" class="ctx-file-del">{{item.removedText}}</text>
<text has:if="{{item.errorsText}}" class="ctx-file-error">{{item.errorsText}}</text>
<text class="ctx-file-time">{{item.timeText}}</text>
</view>
<view has:if="{{item.expanded}}" class="ctx-file-ops">
<view has:for="{{item.ops}}" has:for-item="op" has:key="key" class="ctx-file-op" catchtap="contextFileOpTap" data-seq="{{op.stepSeq}}" role="button" hover-class="press-dim">
<text class="ctx-file-op-tool">{{op.toolText}}</text>
<text class="ctx-file-op-detail">{{op.kindText}} · {{op.detail}}</text>
<text has:if="{{op.hitsText}}" class="ctx-file-op-meta">{{op.hitsText}}</text>
<text has:if="{{op.readText}}" class="ctx-file-op-meta">{{op.readText}}</text>
<text has:if="{{op.deltaText}}" class="ctx-file-op-meta">{{op.deltaText}}</text>
<view has:if="{{op.error}}" class="ctx-br-errdot"></view>
<text has:if="{{op.stamp}}" class="ctx-file-op-meta">{{op.stamp}}</text>
<text class="ctx-file-op-meta">{{op.timeText}}</text>
</view>
<text has:if="{{item.moreOps}}" class="ctx-br-note">{{ui['还有更多项目']}} {{item.moreOps}}</text>
</view>
</view>
</scroll-view>
<text has:if="{{contextPanel.files.moreCount}}" class="ctx-card-sub">{{ui['还有更多项目']}} {{contextPanel.files.moreCount}}</text>
<text has:if="{{contextPanel.files.truncated}}" class="ctx-card-sub">{{contextPanel.files.floorText}}</text>
</view>
<view has:if="{{contextPanel.commands.available}}" class="ctx-card" id="ctxCommandCard">
<view class="ctx-card-head">
<text class="ctx-card-title">{{ui['命令执行']}}</text>
<text class="ctx-card-sub">{{contextPanel.commands.countText}}</text>
</view>
<view class="ctx-cmd-kpi">
<view has:for="{{contextPanel.commands.kpi}}" has:key="key" class="ctx-cmd-kpi-item"><text class="ctx-cmd-kpi-value">{{item.valueText}}</text><text class="ctx-cmd-kpi-label">{{item.label}}</text></view>
</view>
<view class="ctx-event-chips">
<view has:for="{{contextPanel.commands.chunks}}" has:key="key" class="ctx-event-chip {{item.active ? 'active' : ''}}" bindtap="setContextCommandFilter" data-filter="{{item.key}}" hover-class="press-dim" role="button" aria-pressed="{{item.active}}">{{item.label}}<text class="ctx-event-chip-n">{{item.countText}}</text></view>
</view>
<view has:if="{{contextPanel.commands.noMatches}}" class="ctx-empty">{{contextPanel.commands.noMatchText}}</view>
<view has:else class="ctx-cmd-lane">
<view has:for="{{contextPanel.commands.rows}}" has:key="key" class="ctx-cmd-row {{item.expanded ? 'on' : ''}}">
<view class="ctx-cmd-line" bindtap="toggleContextCommand" data-key="{{item.key}}" hover-class="press-dim" role="button" aria-expanded="{{item.expanded}}">
<text class="ctx-cmd-status ctx-cmd-{{item.statusClass}}">{{item.statusGlyph}}</text>
<text class="ctx-cmd-time">{{item.timeText}}</text>
<text has:if="{{item.toolText}}" class="ctx-cmd-tool">{{item.toolText}}</text>
<text class="ctx-cmd-text">{{item.commandPreview}}</text>
<text has:if="{{item.background}}" class="ctx-br-tag">{{ui['后台']}}</text>
<text class="ctx-cmd-dur">{{item.durationText}}</text>
</view>
<view has:if="{{item.expanded}}" class="ctx-cmd-detail">
<text has:if="{{item.description}}" class="ctx-cmd-desc">{{item.description}}</text>
<text class="ctx-cmd-code" user-select>{{item.commandText}}</text>
<text has:if="{{item.factsText}}" class="ctx-cmd-facts">{{item.factsText}}</text>
<view class="ctx-cmd-actions">
<view class="ctx-br-copy" catchtap="copyContextCommand" data-key="{{item.key}}" role="button">{{contextPanel.commands.copyText}}</view>
<view class="ctx-br-copy" catchtap="locateContextCommand" data-seq="{{item.seq}}" role="button">{{contextPanel.commands.locateText}}</view>
</view>
</view>
</view>
<text has:if="{{contextPanel.commands.truncated}}" class="ctx-br-note">{{contextPanel.commands.truncatedText}}</text>
</view>
</view>
<view class="ctx-bottom-space"></view>
</block>
</scroll-view>
</view>
<view has:if="{{fleetMounted && showFleetPanel}}" hidden="{{tab !== 'fleet'}}" class="fleet-panel {{tab !== 'fleet' ? 'session-panel-hidden' : ''}}" bindtouchstart="onPanelTouchStart" bindtouchmove="onPanelTouchMove" bindtouchend="onPanelTouchEnd" bindtouchcancel="onPanelTouchCancel">
<view class="fleet-toolbar">
<text class="fleet-toolbar-title">{{ui['编队总览']}}</text>
<text has:if="{{fleetPanel.status === 'ready'}}" class="fleet-toolbar-meta">{{ui['Agent 数量']}} {{fleetPanel.overview.agentsText}} · {{ui['运行中']}} {{fleetPanel.overview.runningText}}</text>
<view class="fleet-toolbar-spacer"></view>
</view>
<scroll-view class="fleet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
<view id="fleetSection" class="cf-fleet-section" bindtap="closeFleetMemberSort">
<view has:if="{{!fleetPanel || fleetPanel.status === 'loading'}}" class="fleet-state">
<view class="state-spinner"></view>
<text class="fleet-state-text">{{ui['正在加载编队…']}}</text>
<view class="ctx-skeleton"><view class="ctx-skeleton-row"/><view class="ctx-skeleton-row"/><view class="ctx-skeleton-row"/></view>
</view>
<view has:elif="{{fleetPanel.status === 'disconnected' || fleetPanel.status === 'empty'}}" class="fleet-state">
<text class="fleet-state-text">{{fleetPanel.stateText}}</text>
</view>
<view has:elif="{{fleetPanel.status === 'unsupported'}}" class="fleet-state">
<text class="fleet-state-title">{{fleetPanel.stateText}}</text>
<text class="fleet-state-text">{{fleetPanel.hintText}}</text>
</view>
<view has:elif="{{fleetPanel.status === 'error'}}" class="fleet-state">
<text class="fleet-state-title">{{ui['编队数据加载失败']}}</text>
<text class="fleet-state-text">{{fleetPanel.errorText}}</text>
<view class="fleet-retry" bindtap="refreshContextFleet" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['重试']}}">{{ui['重试']}}</view>
</view>
<block has:else>
<view class="ctx-card fleet-summary">
<view class="fleet-summary-chips">
<view has:for="{{fleetPanel.summary.chips}}" has:key="key" class="fleet-chip {{item.on ? 'on' : ''}}">{{item.text}}</view>
</view>
<view has:if="{{fleetPanel.summary.progress}}" class="fleet-progress">
<text class="fleet-progress-label">{{fleetPanel.summary.progress.label}}</text>
<view class="fleet-progress-track"><view class="fleet-progress-fill {{fleetPanel.summary.progress.complete ? 'done' : ''}}" style="width:{{fleetPanel.summary.progress.width}}%;"/></view>
<text class="fleet-progress-text">{{fleetPanel.summary.progress.text}}</text>
</view>
</view>
<view class="fleet-workspace">
<view id="fleetGraphCard" class="ctx-card fleet-graph-card">
<view class="ctx-card-head">
<image class="fleet-title-ic" src="/assets/icons/fleet-network{{theme === 'dark' ? '-dark' : ''}}.svg" mode="aspectFit"/><text class="ctx-card-title">{{ui['Agent 网络']}}</text>
<text class="ctx-card-sub fleet-graph-sub">{{ui['当前 Agent 与子 Agent 的实时上下文 · 点击节点查看']}}</text>
</view>
<view class="fleet-chips">
<view has:for="{{fleetPanel.agentChips}}" has:key="key" class="fleet-chip {{item.on ? 'on' : ''}} {{item.brand ? 'brand' : ''}}">{{item.text}}</view>
<view has:if="{{fleetPanel.graph.height > 1120}}" class="fleet-chip fleet-chip-toggle" bindtap="fleetToggleAll" hover-class="press-dim" role="button" aria-expanded="{{fleetAllOpen}}">{{fleetAllOpen ? ui['收起'] : ui['展开全部']}}</view>
</view>
<view class="fleet-legend">
<view has:for="{{fleetPanel.legend}}" has:key="key" class="fleet-legend-item">
<view has:if="{{!item.free && !item.live}}" class="fleet-legend-swatch {{item.swatch}}"></view>
<view has:elif="{{item.free}}" class="fleet-legend-free"></view>
<view has:else class="fleet-legend-live"></view>
<text class="fleet-legend-label">{{item.label}}</text>
</view>
</view>
<view has:if="{{!fleetPanel.agents.length}}" class="ctx-empty">{{ui['暂无编队']}}</view>
<block has:else>
<scroll-view class="fleet-stage {{fleetAllOpen ? 'all' : ''}}" scroll-y enhanced show-scrollbar="{{false}}">
<view class="fleet-canvas" style="width:{{fleetPanel.graph.width}}px;height:{{fleetPanel.graph.height}}px;">
<image has:if="{{fleetLinksSrc}}" class="fleet-links-image" src="{{fleetLinksSrc}}" style="width:{{fleetPanel.graph.width}}px;height:{{fleetPanel.graph.height}}px;" mode="scaleToFill"/>
<canvas has:else type="2d" id="fleetLinks" class="fleet-links-canvas" style="width:{{fleetPanel.graph.width}}px;height:{{fleetPanel.graph.height}}px;"></canvas>
<view has:for="{{fleetPanel.graph.nodes}}" has:key="key" class="fleet-node {{item.isCurrent ? 'self' : ''}} {{item.selected ? 'selected' : ''}} {{item.running ? 'running' : ''}}" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.h}}px;" bindtap="fleetSelectAgent" data-id="{{item.id}}" hover-class="fleet-node-pressed" role="button" aria-label="{{item.title}}">
<view class="fleet-node-head">
<view class="fleet-node-state {{item.stateKind}}"></view>
<text class="fleet-node-title">{{item.title}}</text>
<text has:if="{{item.badgeText}}" class="fleet-node-badge">{{item.badgeText}}</text>
</view>
<text class="fleet-node-metric">{{item.tokensText}} tok</text>
<view class="fleet-node-bar">
<view has:for="{{item.segments}}" has:for-item="seg" has:key="key" class="fleet-node-seg ctx-c-{{seg.key}}" style="width:{{seg.width}}%;"/>
</view>
<view class="fleet-node-foot">
<text class="fleet-node-meta">{{item.metaText}}</text>
<text class="fleet-node-pct" style="color:{{item.pctColor}};">{{item.pctText}}</text>
<view class="fleet-node-open" catchtap="fleetOpenAgent" data-id="{{item.id}}" role="button" aria-label="{{ui['打开会话']}}">→</view>
</view>
</view>
</view>
</scroll-view>
<view has:if="{{fleetPanel.soloHint}}" class="ctx-br-note">{{fleetPanel.soloHint}}</view>
</block>
</view>
<view class="fleet-board-column">
<view class="ctx-card fleet-members">
<view class="ctx-card-head">
<image class="fleet-title-ic" src="/assets/icons/icon-users{{theme === 'dark' ? '-dark' : ''}}.svg" mode="aspectFit"/><text class="ctx-card-title">{{ui['编队成员']}}</text>
<text class="ctx-card-sub">{{fleetPanel.members.countText}}</text>
<text has:if="{{fleetPanel.members.failure}}" class="fleet-member-warn">{{ui['持久记录无效']}}</text>
</view>
<view has:if="{{fleetPanel.members.toolbar}}" class="fleet-member-toolbar">
<input class="ctx-br-search" value="{{fleetPanel.members.query}}" placeholder="{{ui['搜索名称…']}}" confirm-type="search" maxlength="60" bindinput="setFleetMemberQuery"/>
<view class="ctx-gran">
<view has:for="{{fleetPanel.members.statusChips}}" has:key="key" class="ctx-gran-btn {{item.active ? 'on' : ''}}" bindtap="setFleetMemberStatus" data-status="{{item.key}}" hover-class="press-dim" role="button">{{item.label}}<text class="fleet-member-chip-n">{{item.countText}}</text></view>
</view>
<view class="fleet-member-sort {{fleetMemberSortOpen ? 'open' : ''}}" catchtap="openFleetMemberSort" hover-class="press-dim" role="button" aria-haspopup="listbox" aria-expanded="{{fleetMemberSortOpen}}">
<view class="fleet-member-sort-inner"><text>{{fleetPanel.members.sortLabel}}</text><text class="fleet-member-sort-arrow">⌄</text></view>
<view has:if="{{fleetMemberSortOpen}}" class="fleet-sort-menu" catchtap="noop" role="listbox" aria-label="{{ui['排序方式']}}">
<view has:for="{{fleetPanel.members.sortOptions}}" has:key="key" class="fleet-sort-option {{item.active ? 'selected' : ''}}" catchtap="setFleetMemberSort" data-sort="{{item.key}}" hover-class="press-dim" role="option" aria-selected="{{item.active}}">
<text>{{item.label}}</text><text has:if="{{item.active}}" class="fleet-sort-option-check">✓</text>
</view>
</view>
</view>
</view>
<view has:if="{{fleetPanel.members.soloHint}}" class="ctx-br-note">{{fleetPanel.members.soloHint}}</view>
<view has:elif="{{fleetPanel.members.noMatches}}" class="ctx-empty">{{ui['没有匹配的 Agent']}}</view>
<view has:if="{{fleetPanel.members.groups.length}}" class="fleet-member-groups">
<view has:for="{{fleetPanel.members.groups}}" has:for-item="group" has:key="key" class="fleet-member-group">
<view class="fleet-member-group-head"><text>{{group.title}}</text><text class="fleet-member-group-count">{{group.countText}}</text></view>
<view class="fleet-member-list">
<view has:for="{{group.rows}}" has:for-item="member" has:key="key" class="fleet-member {{member.selected ? 'selected' : ''}}" style="border-top-color:{{member.kind === 'lead' ? 'var(--ink)' : member.hue}};" bindtap="fleetSelectAgent" data-id="{{member.id}}" hover-class="fleet-node-pressed" role="button" aria-label="{{member.title}}">
<view class="fleet-member-head">
<view class="fleet-member-icon" style="background:{{member.hue}}22;border-color:{{member.hue}}88;">
<image has:if="{{member.kind === 'lead'}}" class="fleet-member-ic" src="/assets/icons/icon-users{{theme === 'dark' ? '-dark' : ''}}.svg" mode="aspectFit"/>
<image has:else class="fleet-member-ic" src="/assets/icons/icon-user{{theme === 'dark' ? '-dark' : ''}}.svg" mode="aspectFit"/>
</view>
<text class="fleet-member-name">{{member.title}}</text>
<text has:if="{{member.isCurrent}}" class="fleet-node-badge">{{ui['当前']}}</text>
<text class="fleet-member-role">{{member.roleText}}</text>
<view class="fleet-member-dot {{member.stateKind}}"></view>
</view>
<view class="fleet-member-status"><text>{{member.statusText}}</text><text has:if="{{member.model}}" class="fleet-member-model">{{member.model}}</text></view>
<text has:if="{{member.error}}" class="fleet-member-error">{{member.error}}</text>
<view has:if="{{member.answerText}}" class="fleet-member-answer"><text class="fleet-member-answer-label">{{member.answerLabel}}</text><text class="fleet-member-answer-text">{{member.answerText}}</text></view>
<text has:if="{{member.metaText}}" class="fleet-member-meta">{{member.metaText}}</text>
<view class="fleet-member-foot">
<text class="fleet-member-tasks {{member.tasksCount > 0 ? 'on' : ''}}">{{member.tasksText}}</text>
<view class="fleet-node-open" catchtap="fleetOpenMember" data-id="{{member.id}}" role="button" aria-label="{{ui['打开会话']}}">→</view>
</view>
</view>
</view>
</view>
</view>
</view>
<view class="fleet-card fleet-task-card">
<view class="ctx-card-head">
<image class="fleet-title-ic" src="/assets/icons/dsh-checklist{{theme === 'dark' ? '-dark' : ''}}.svg" mode="aspectFit"/><text class="ctx-card-title">{{ui['任务']}}</text>
<text class="ctx-card-sub">{{ui['团队任务与子 Agent 委派']}}</text>
<text has:if="{{fleetPanel.team.taskCountText}}" class="ctx-card-sub">{{fleetPanel.team.taskCountText}}</text>
</view>
<input class="ctx-br-search fleet-task-search" value="{{fleetTaskQuery}}" placeholder="{{ui['搜索任务…']}}" confirm-type="search" maxlength="60" bindinput="setFleetTaskQuery"/>
<view class="ctx-gran fleet-task-gran">
<view has:for="{{fleetPanel.team.statusChips}}" has:key="key" class="ctx-gran-btn {{item.active ? 'on' : ''}}" bindtap="setFleetTaskStatus" data-status="{{item.key}}" hover-class="press-dim" role="button">{{item.label}}<text class="fleet-member-chip-n">{{item.count}}</text></view>
</view>
<view class="fleet-task-list">
<view has:if="{{fleetPanel.team.tasksEmpty}}" class="fleet-task-empty">{{fleetPanel.team.tasksEmptyText}}</view>
<view has:for="{{fleetPanel.team.tasks}}" has:key="key" class="fleet-task-row">
<view has:if="{{item.kind === 'agent'}}" class="fleet-task-icon" style="background:{{item.hue}}22;border-color:{{item.hue}}88;">
<image class="fleet-member-ic" src="/assets/icons/icon-user{{theme === 'dark' ? '-dark' : ''}}.svg" mode="aspectFit"/>
</view>
<view class="fleet-task-dot {{item.stateKind}}"></view>
<view class="fleet-task-main">
<view class="fleet-task-line">
<text class="fleet-task-subject">{{item.subject}}</text>
<text class="fleet-task-status ctx-task-{{item.statusClass}}">{{item.statusText}}</text>
</view>
<text has:if="{{item.bodyText}}" class="fleet-task-body">{{item.bodyText}}</text>
<view class="fleet-task-foot">
<text has:if="{{item.ownerText}}" class="fleet-task-owner">{{item.ownerText}}</text>
<text has:if="{{item.modelText}}" class="fleet-task-owner">{{item.modelText}}</text>
<text has:if="{{item.metaText}}" class="fleet-task-meta">{{item.metaText}}</text>
</view>
</view>
</view>
</view>
</view>
</view>
</view>
<view class="ctx-card fleet-comms">
<view class="ctx-card-head">
<image class="fleet-title-ic" src="/assets/icons/fleet-comms{{theme === 'dark' ? '-dark' : ''}}.svg" mode="aspectFit"/><text class="ctx-card-title">{{ui['通讯记录']}}</text>
<text class="ctx-card-sub">{{ui['跨 Agent 消息 · 按需扫描各会话日志']}}</text>
</view>
<view has:if="{{fleetPanel.comms.solo}}" class="ctx-br-note fleet-comms-solo">{{fleetPanel.comms.soloText}}</view>
<view has:if="{{!fleetPanel.comms.solo}}" class="fleet-comms-toolbar">
<view has:if="{{fleetCommsState === 'idle' || fleetCommsState === 'error'}}" class="fleet-comms-btn" bindtap="scanFleetComms" hover-class="press-dim" role="button">{{fleetCommsState === 'error' ? fleetPanel.comms.errorText : fleetPanel.comms.scanText}}</view>
<view has:elif="{{fleetCommsState === 'scanning'}}" class="fleet-comms-chip">{{fleetPanel.comms.scanningText}}</view>
<block has:else>
<view class="fleet-comms-chip">{{fleetPanel.comms.totalText}}</view>
<view has:if="{{fleetPanel.comms.stale}}" class="fleet-comms-chip stale">{{fleetPanel.comms.staleText}}</view>
<view class="fleet-comms-btn" bindtap="scanFleetComms" hover-class="press-dim" role="button">{{fleetPanel.comms.rescanText}}</view>
</block>
</view>
<view has:if="{{fleetCommsState === 'ready' && !fleetPanel.comms.solo}}" class="fleet-comms-filters">
<view has:for="{{fleetPanel.comms.filters}}" has:key="key" class="fleet-chip {{item.active ? 'on' : ''}}" bindtap="setFleetCommsFilter" data-id="{{item.key}}" hover-class="press-dim" role="button">{{item.label}}</view>
</view>
<view has:if="{{fleetCommsState === 'ready' && fleetPanel.comms.hasData}}" class="fleet-comms-lane">
<view has:if="{{!fleetPanel.comms.rows.length}}" class="ctx-empty">{{fleetPanel.comms.filters.length > 1 ? fleetPanel.comms.noMatchText : fleetPanel.comms.emptyText}}</view>
<view has:for="{{fleetPanel.comms.rows}}" has:key="key" class="fleet-comms-row fleet-comms-k-{{item.kindClass}}">
<view class="fleet-comms-line">
<text class="fleet-comms-time">{{item.timeText}}</text>
<text class="fleet-comms-kind">{{item.kindText}}</text>
<view class="fleet-comms-route">
<text has:if="{{item.fromLabel && item.fromId}}" class="fleet-comms-party" data-id="{{item.fromId}}" bindtap="setFleetCommsFilter">{{item.fromLabel}}</text>
<text has:elif="{{item.fromLabel}}" class="fleet-comms-party">{{item.fromLabel}}</text>
<view class="fleet-comms-arrow" aria-hidden="true"><view class="fleet-comms-arrow-shaft"></view></view>
<text has:if="{{item.toLabel && item.toId}}" class="fleet-comms-party" data-id="{{item.toId}}" bindtap="setFleetCommsFilter">{{item.toLabel}}</text>
<text has:elif="{{item.toLabel}}" class="fleet-comms-party">{{item.toLabel}}</text>
</view>
</view>
<text class="fleet-comms-text">{{item.text}}</text>
</view>
<text has:if="{{fleetPanel.comms.partial}}" class="ctx-br-note">{{fleetPanel.comms.partialText}}</text>
<text has:if="{{fleetPanel.comms.truncated}}" class="ctx-br-note">{{fleetPanel.comms.truncatedText}}</text>
</view>
</view>
<view class="ctx-bottom-space"></view>
</block>
</view>
</scroll-view>
</view>
<view has:if="{{contextModalOpen}}" class="ctx-modal-mask" bindtap="closeContextModal" catchtouchmove="noop">
<view class="ctx-modal" style="{{ctxModalDragStyle}}" catchtap="noop">
<view class="ctx-modal-grab" bindtouchstart="onContextModalGrabStart" catchtouchmove="onContextModalGrabMove" bindtouchend="onContextModalGrabEnd" bindtouchcancel="onContextModalGrabEnd" aria-hidden="true">
<view class="ctx-modal-grab-bar"></view>
</view>
<view class="ctx-modal-head">
<text class="ctx-modal-title">{{ui['上下文']}}</text>
<view class="ctx-modal-close" bindtap="closeContextModal" hover-class="press-dim" role="button" aria-label="{{ui['关闭']}}">×</view>
</view>
<scroll-view class="ctx-modal-body" scroll-y enhanced show-scrollbar="{{false}}" catchtap="closeContextBrowserPicker">
<view class="ctx-modal-card">
<view class="ctx-card-head">
<text class="ctx-card-title">{{ui['当前上下文']}}</text>
<text has:if="{{contextPanel.current.modelText}}" class="ctx-card-sub">{{contextPanel.current.modelText}}</text>
</view>
<view has:if="{{!contextPanel.current.hasData}}" class="ctx-empty">{{ui['暂无上下文数据']}}</view>
<block has:else>
<view class="ctx-overview-num">
<text class="ctx-overview-value">{{contextPanel.current.numText}}</text>
<text class="ctx-overview-window">{{contextPanel.current.windowSuffix}}</text>
<view has:if="{{contextPanel.current.occupancyText}}" class="ctx-overview-pct"><text class="ctx-overview-pct-value">{{contextPanel.current.occupancyText}}</text><text class="ctx-overview-pct-label">{{ui['上下文已用']}}</text></view>
</view>
<view class="ctx-compose-bar">
<view has:for="{{contextPanel.current.barSegments}}" has:key="key" class="ctx-compose-seg ctx-c-{{item.key}} {{item.dim ? 'dim' : ''}} {{item.active ? 'active' : ''}}" style="width:{{item.width}}%;" bindtap="contextCurrentTap" data-key="{{item.key}}" role="button"/>
<view class="ctx-compose-free" style="width:{{contextPanel.current.freeWidth}}%;"/>
<view has:if="{{contextPanel.current.headroomMask}}" class="ctx-compose-mask ctx-mask-headroom" style="left:{{contextPanel.current.headroomMask.left}}%;width:{{contextPanel.current.headroomMask.width}}%;"/>
<view has:if="{{contextPanel.current.outputMask}}" class="ctx-compose-mask ctx-mask-output" style="left:{{contextPanel.current.outputMask.left}}%;width:{{contextPanel.current.outputMask.width}}%;"/>
<view has:if="{{contextPanel.current.triggerLeft !== null}}" class="ctx-compose-trigger" style="left:{{contextPanel.current.triggerLeft}}%;"/>
</view>
<view class="ctx-slice-grid ctx-slice-grid-flow">
<view has:for="{{contextPanel.current.rows}}" has:key="key" class="ctx-slice {{item.dim ? 'dim' : ''}} {{item.active ? 'active' : ''}}" bindtap="contextCurrentTap" data-key="{{item.key}}" hover-class="press-dim" role="button" aria-pressed="{{item.active}}">
<view class="ctx-slice-main"><view class="ctx-dot ctx-c-{{item.key}}"/><text class="ctx-slice-label">{{item.label}}</text><text class="ctx-slice-pct">{{item.pctText}}</text></view>
<text class="ctx-slice-sub">{{item.valueText}}</text>
</view>
</view>
</block>
</view>
<view class="ctx-modal-card">
<view class="ctx-card-head">
<text class="ctx-card-title">{{ui['上下文浏览器']}}</text>
<view class="ctx-br-head-actions">
<view class="ctx-gran">
<view class="ctx-gran-btn {{contextPanel.browser.base === 'step' ? 'on' : ''}}" bindtap="setContextBrowserBase" data-base="step" hover-class="press-dim" role="button">{{ui['比前步']}}</view>
<view class="ctx-gran-btn {{contextPanel.browser.base === 'turn' ? 'on' : ''}}" bindtap="setContextBrowserBase" data-base="turn" hover-class="press-dim" role="button">{{ui['比前轮']}}</view>
</view>
<view class="ctx-gran">
<view class="ctx-gran-btn {{contextPanel.browser.dna ? 'on' : ''}}" catchtap="contextTrendDna" hover-class="press-dim" role="button">{{ui['DNA 模式']}}</view>
</view>
</view>
</view>
<view has:if="{{contextPanel.browser.empty}}" class="ctx-empty">{{ui['暂无请求记录']}}</view>
<block has:else>
<view class="ctx-br-nav">
<view class="ctx-browser-step {{contextPanel.browser.canPrev ? '' : 'disabled'}}" bindtap="contextBrowserStep" data-step="-1" hover-class="press-dim" role="button"><view class="ctx-browser-step-arrow left" aria-hidden="true"/><text>{{ui['上一步']}}</text></view>
<view class="ctx-browser-picker {{contextBrowserPickerOpen && contextModalOpen ? 'open' : ''}}">
<view class="ctx-browser-picker-value" catchtap="contextBrowserPickerToggle" hover-class="press-dim" role="button" aria-haspopup="listbox" aria-expanded="{{contextBrowserPickerOpen && contextModalOpen}}"><text class="ctx-browser-picker-label">{{contextPanel.browser.selectedLabel}}</text><view class="ctx-browser-caret {{contextBrowserPickerOpen && contextModalOpen ? 'open' : ''}}" aria-hidden="true"/></view>
<scroll-view has:if="{{contextBrowserPickerOpen && contextModalOpen}}" class="ctx-browser-options" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{contextBrowserPickerTarget}}" catchtap="noop" role="listbox" aria-label="{{ui['上下文浏览器']}}">
<view has:for="{{contextPanel.browser.options}}" has:for-index="index" has:key="key" id="ctxModalBrowserOption{{index}}" class="ctx-browser-option {{index === contextPanel.browser.selectedIndex ? 'selected' : ''}}" catchtap="contextBrowserPick" data-index="{{index}}" hover-class="press-dim" role="option" aria-selected="{{index === contextPanel.browser.selectedIndex}}"><text class="ctx-browser-option-label">{{item.label}}</text><text has:if="{{index === contextPanel.browser.selectedIndex}}" class="ctx-browser-option-check" aria-hidden="true">✓</text></view>
</scroll-view>
</view>
<view class="ctx-browser-step {{contextPanel.browser.canNext ? '' : 'disabled'}}" bindtap="contextBrowserStep" data-step="1" hover-class="press-dim" role="button"><text>{{ui['下一步']}}</text><view class="ctx-browser-step-arrow right" aria-hidden="true"/></view>
</view>
<view class="ctx-br-meta">
<text class="ctx-br-meta-strong">{{contextPanel.browser.selectedSeq === null ? ui['当前 · 下一次请求'] : contextPanel.browser.selectedLabel}}</text>
<text class="ctx-br-meta-item">{{contextPanel.browser.estimatedLabel}} {{contextPanel.browser.estimatedText}}</text>
<text class="ctx-br-meta-item">{{contextPanel.browser.promptLabel}} {{contextPanel.browser.promptText}}</text>
</view>
<view class="ctx-br-bar">
<view has:for="{{contextPanel.browser.composition}}" has:key="key" class="ctx-br-bar-seg ctx-c-{{item.key}}" style="width:{{item.width}}%;"/>
</view>
<block has:if="{{contextPanel.browser.dna}}">
<view class="ctx-br-flat-head">
<text class="ctx-br-flat-title">{{contextPanel.browser.dnaCountText}}</text>
<text class="ctx-br-note-inline">{{ui['按模型阅读顺序（最新在上）']}}</text>
</view>
<view has:for="{{contextPanel.browser.dnaRows}}" has:key="key" class="ctx-br-flat-row {{contextNodeDetail && contextNodeDetail.seq === item.seq ? 'on' : ''}}" catchtap="toggleContextDnaNode" data-seq="{{item.seq}}">
<view class="ctx-br-flat-line">
<text class="ctx-br-pos">{{item.posText}}</text>
<text class="ctx-br-cat-chip ctx-c-{{item.category}}">{{item.categoryText}}</text>
<text class="ctx-br-flat-label">{{item.label}}</text>
<text has:if="{{item.stamp}}" class="ctx-br-stamp">{{item.stamp}}</text>
<text class="ctx-br-tok">{{item.tokenText}}</text>
</view>
<view has:if="{{item.metaText}}" class="ctx-br-flat-meta">{{item.metaText}}</view>
<text has:if="{{contextNodeDetail && contextNodeDetail.seq === item.seq}}" class="ctx-br-content" user-select>{{contextNodeDetail.text}}</text>
</view>
<text has:if="{{!contextPanel.browser.dnaRows.length}}" class="ctx-empty">{{ui['暂无请求记录']}}</text>
</block>
<view has:else class="ctx-modal-cats">
<view has:for="{{contextPanel.browser.rows}}" has:key="key" class="ctx-br-cat-row {{item.disabled ? 'empty' : ''}}" bindtap="contextModalCategoryTap" data-key="{{item.key}}" hover-class="press-dim" role="button">
<text class="ctx-br-chevron">▸</text>
<view class="ctx-br-swatch {{item.swatch}}"/>
<text class="ctx-br-cat-name">{{item.label}}</text>
<text has:if="{{item.countText}}" class="ctx-br-count">{{item.countText}}</text>
<text has:if="{{item.countDeltaText}}" class="ctx-br-delta ctx-delta-{{item.countDeltaClass}}">{{item.countDeltaText}}</text>
<text class="ctx-br-token">{{item.tokenText}}</text>
<text has:if="{{item.tokenDeltaText}}" class="ctx-br-delta ctx-delta-{{item.tokenDeltaClass}}">{{item.tokenDeltaText}}</text>
<text class="ctx-br-pct">{{item.pctText}}</text>
</view>
</view>
</block>
</view>
</scroll-view>
</view>
</view>
<view hidden="{{tab !== 'conversation'}}" class="dock-stack {{voiceOverlayVisible ? 'voice-holding' : ''}} {{question ? 'question-active' : ''}} {{tab !== 'conversation' ? 'session-panel-hidden' : ''}}" style="{{dockStyle}}">
<view has:if="{{showJump && rows.length}}" class="jump-wrap">
<view class="jump-bottom" bindtap="jumpToBottom">
<view has:if="{{running}}" class="jump-ring"></view>
<image class="jump-ic" src="/assets/icons/{{theme === 'dark' ? 'arrow-down-light.png' : 'arrow-down-dark.png'}}"/>
</view>
</view>
<view has:if="{{approval}}" class="pending-card approval-card">
<view class="approval-head">
<view class="approval-dot"></view>
<text class="approval-head-title">{{ui['等待审批']}}</text>
<text has:if="{{approval.replay}}" class="approval-replayed">{{ui['· 已恢复']}}</text>
<view class="approval-spacer"></view>
</view>
<view class="approval-body">
<view class="approval-tool">{{approval.toolName}}</view>
<view class="approval-reason">{{approval.reason || approval.toolName + ui[' 请求执行需要审批的操作']}}</view>
</view>
<view class="pending-actions">
<view class="pending-btn ghost {{approvalBusy ? 'disabled' : ''}}" bindtap="rejectApproval">{{ui['拒绝']}}</view>
<view class="pending-btn primary {{approvalBusy ? 'disabled' : ''}}" bindtap="allowApproval">{{ui['允许一次']}}</view>
</view>
</view>
<view has:elif="{{question}}" class="pending-card question-card">
<view has:if="{{qCollapsed}}" class="q-collapsed" bindtap="toggleQCollapse">
<image class="q-ic" src="/assets/icons/q-bubble-ocean.png"/>
<view class="q-collapsed-main">
<text class="q-collapsed-title">{{ui['Agent 正在等待回答']}}</text>
<text class="q-collapsed-sub">{{question.questions[qIndex].question}}</text>
</view>
<image class="q-chev" src="/assets/icons/chev-up-gray.png"/>
</view>
<block has:else>
<view class="q-confirm-head">
<text class="q-header">{{question.questions[qIndex].header || ui['确认']}}</text>
<text has:if="{{question.replay}}" class="q-replayed">{{ui['已恢复']}}</text>
<view class="q-spacer"></view>
<view class="q-head-btn" bindtap="toggleQCollapse">
<image class="q-chev" src="/assets/icons/chev-down-gray.png"/>
</view>
<view class="q-head-btn" bindtap="cancelQuestion">
<image class="q-chev" src="/assets/icons/xmark-circle-dark.png"/>
</view>
</view>
<view class="q-item">
<view class="q-question">{{question.questions[qIndex].question}}</view>
<view has:if="{{question.questions[qIndex].detail}}" class="q-detail">{{question.questions[qIndex].detail}}</view>
<view has:if="{{question.questions[qIndex].allowsMultipleSelections}}" class="q-multi-hint">{{ui['☑ 可以选择多项']}}</view>
<view class="q-options">
<view has:for="{{question.questions[qIndex].options}}" has:for-item="opt" has:key="raw" class="q-option {{question.questions[qIndex].checked[opt.raw] ? 'selected' : ''}}" bindtap="toggleOption" data-qid="{{question.questions[qIndex].id}}" data-label="{{opt.raw}}" data-multi="{{question.questions[qIndex].allowsMultipleSelections ? 1 : 0}}">
<view class="q-sel option-number {{question.questions[qIndex].checked[opt.raw] ? 'selected' : ''}}">
<text>{{index + 1}}</text>
</view>
<view class="q-option-main">
<view class="q-option-label">{{ui[opt.label] !== undefined ? ui[opt.label] : opt.label}}<text has:if="{{opt.recommended}}" class="q-recommend">{{ui['推荐']}}</text></view>
<view has:if="{{opt.description}}" class="q-option-desc">{{opt.description}}</view>
</view>
</view>
<view has:if="{{!question.questions[qIndex].options.length}}" class="field q-custom">
<input confirm-type="done" show-confirm-bar="{{false}}" placeholder="{{ui['输入你的答案']}}" placeholder-class="field-placeholder" value="{{question.custom[question.questions[qIndex].id]}}" bindinput="onCustomInput" data-qid="{{question.questions[qIndex].id}}"/>
</view>
<view has:else class="q-custom-row">
<image class="q-pencil" src="/assets/icons/pencil-line-gray.png"/>
<input class="q-custom-input" confirm-type="done" show-confirm-bar="{{false}}" placeholder="{{ui['或输入自定义答案']}}" placeholder-class="field-placeholder" value="{{question.custom[question.questions[qIndex].id]}}" bindinput="onCustomInput" data-qid="{{question.questions[qIndex].id}}"/>
</view>
</view>
</view>
<view class="q-footer">
<view class="q-page-btn {{qIndex === 0 ? 'disabled' : ''}}" bindtap="qPrev">
<image class="q-chev flip" src="/assets/icons/chev-right-gray.png"/>
</view>
<text class="q-page-num">{{qIndex + 1}} / {{question.questions.length}}</text>
<view class="q-page-btn {{qIndex === question.questions.length - 1 ? 'disabled' : ''}}" bindtap="qNext">
<image class="q-chev" src="/assets/icons/chev-right-gray.png"/>
</view>
<view class="q-spacer"></view>
<view class="pending-btn ghost" bindtap="cancelQuestion">{{ui['跳过问题']}}</view>
<view has:if="{{qIndex < question.questions.length - 1}}" class="pending-btn primary {{questionBusy ? 'disabled' : ''}}" bindtap="qNext">{{ui['下一题']}}</view>
<view has:else class="pending-btn primary {{questionBusy ? 'disabled' : ''}}" bindtap="submitQuestion">{{ui['提交']}}</view>
</view>
</block>
</view>
<block has:else>
<block has:if="{{tab === 'conversation'}}">
<view has:if="{{queue.length}}" class="queue-dock {{queueExpanded || queue.length === 1 ? 'open' : ''}}">
<view class="queue-panel">
<view has:if="{{queue.length > 1}}" class="queue-head" bindtap="toggleQueue">
<view class="queue-lead"><image class="queue-head-ic" src="/assets/icons/bubble-gray.png"/></view>
<text class="queue-head-title">{{ui['排队消息 ·']}} {{queue.length}}</text>
<text has:if="{{queueSending}}" class="queue-head-status">{{ui['发送中…']}}</text>
<view class="event-spacer"></view>
<view class="queue-head-chev"><image class="queue-head-chev-ic" src="/assets/icons/{{queueExpanded ? 'chev-down-gray.png' : 'chev-up-gray.png'}}"/></view>
</view>
<scroll-view has:if="{{queueExpanded || queue.length === 1}}" class="queue-list {{queue.length > 4 ? 'capped' : ''}}" scroll-y>
<block has:for="{{queue}}" has:key="id">
<view class="queue-row">
<view has:if="{{queue.length === 1}}" class="queue-lead"><image class="queue-row-ic" src="/assets/icons/bubble-gray.png"/></view>
<view class="queue-content">
<text has:if="{{item.preview}}" class="queue-preview">{{item.preview}}</text>
<view has:if="{{item.attachments.length}}" class="queue-attachments">
<block has:for="{{item.attachments}}" has:for-item="attachment" has:key="key">
<image has:if="{{attachment.type === 'image'}}" class="queue-thumb" src="{{attachment.url}}" mode="aspectFill"/>
<view has:else class="queue-file">
<image class="queue-file-ic" src="/assets/icons/paperclip-gray.png"/>
<text class="queue-file-name">{{attachment.name}}</text>
</view>
</block>
</view>
<text has:if="{{item.attachmentCount}}" class="queue-attachment-label">{{ui[item.attachmentLabel] !== undefined ? ui[item.attachmentLabel] : item.attachmentLabel}}</text>
</view>
<text has:if="{{item.statusText}}" class="queue-status">{{ui[item.statusText] !== undefined ? ui[item.statusText] : item.statusText}}</text>
<view class="queue-actions">
<view has:if="{{item.editable}}" class="queue-ic-btn {{queueBusyId === item.id + ':edit' ? 'busy' : ''}}" bindtap="queueAction" data-id="{{item.id}}" data-action="edit"><image class="queue-ic" src="/assets/icons/pencil-line-gray.png"/></view>
<view class="queue-ic-btn {{queueBusyId === item.id + ':remove' ? 'busy' : ''}}" bindtap="queueAction" data-id="{{item.id}}" data-action="remove"><image class="queue-ic" src="/assets/icons/trash-gray.png"/></view>
<view has:if="{{running}}" class="queue-ic-btn {{queueBusyId === item.id + ':steer' ? 'busy' : ''}}" bindtap="queueAction" data-id="{{item.id}}" data-action="steer"><image class="queue-ic" src="/assets/icons/arrow-up-gray.png"/></view>
</view>
</view>
<view has:if="{{index < queue.length - 1}}" class="queue-sep"></view>
</block>
</scroll-view>
</view>
</view>
<view has:if="{{tasks}}" class="task-panel">
<view class="task-head" bindtap="toggleTasks">
<image class="task-head-ic" src="/assets/icons/tasks-list.svg" mode="aspectFit"/>
<text class="task-head-title">{{ui['任务']}}</text>
<text class="task-summary">{{ui[taskSummary] !== undefined ? ui[taskSummary] : taskSummary}}</text>
<view class="event-spacer"></view>
<image class="task-chev {{tasksExpanded ? 'open' : ''}}" src="/assets/icons/chev-down-gray.png"/>
</view>
<view has:if="{{tasksExpanded}}" class="task-list">
<view has:for="{{tasks}}" has:key="id" class="task-row {{item.status}}">
<image class="task-status-ic {{item.status === 'in_progress' ? 'spin' : ''}}" src="/assets/icons/{{item.icon}}"/>
<text class="task-content">{{item.content}}</text>
</view>
</view>
</view>
<view has:if="{{goal}}" class="goal-panel">
<image class="goal-ic" src="/assets/icons/target-gray.png"/>
<view class="goal-main">
<text class="goal-phase">{{ui[goal.phaseLabel] !== undefined ? ui[goal.phaseLabel] : goal.phaseLabel}}</text>
<text class="goal-objective">{{goal.objective}}</text>
</view>
<view has:if="{{goalBusy}}" class="goal-spinner"></view>
<block has:else>
<view class="goal-action" bindtap="goalAction" data-action="toggle">
<image class="goal-action-ic" src="/assets/icons/{{goal.active ? 'sched-clock-gray.png' : 'arrow-up-gray.png'}}"/>
</view>
<view class="goal-action" bindtap="goalAction" data-action="edit">
<image class="goal-action-ic" src="/assets/icons/pencil-line-gray.png"/>
</view>
<view class="goal-action" bindtap="goalAction" data-action="clear">
<image class="goal-action-ic" src="/assets/icons/trash-gray.png"/>
</view>
</block>
</view>
</block>
<view has:if="{{sessionPresetVisible}}" class="composer-top-row">
<view has:if="{{sessionPresetVisible}}" class="preset-capsule glass-press" bindtap="pickSessionPreset">
<image class="preset-capsule-ic" src="/assets/icons/preset-gray.png"/>
<text class="preset-capsule-text">{{sessionPresetName}}</text>
<image class="preset-capsule-chev" src="/assets/icons/chev-down-gray.png"/>
</view>
</view>
<view has:if="{{statsPopOpen}}" class="stats-pop-mask" bindtap="closeStatsPop"></view>
<view has:if="{{statsPopOpen}}" class="stats-pop {{statsPopKind}}">
<view class="stats-pop-title">
<image class="metric-icon" src="/assets/icons/{{statsPopKind === 'run' ? 'dsh-gauge' : 'dsh-storage'}}.svg" mode="aspectFit" aria-hidden="true"/>
<text class="stats-pop-heading">{{ui[statsPopTitle] !== undefined ? ui[statsPopTitle] : statsPopTitle}}</text>
<text has:if="{{statsPopTotal}}" class="stats-pop-total">{{statsPopTotal}}</text>
</view>
<view has:for="{{statsPopRows}}" has:key="label" class="stats-pop-row">
<text class="stats-pop-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
<text class="stats-pop-value">{{item.value}}</text>
</view>
</view>
<block has:if="{{showContextSheet && contextSheet}}">
<view class="ctx-pop-mask" bindtap="closeContextSheet"></view>
<view class="ctx-pop">
<view class="ctx-line">
<text class="ctx-label">{{ui['上下文已用']}}</text>
<text class="ctx-pct">{{contextSheet.pct}}%</text>
<text class="ctx-tokens">{{ui[contextSheet.usedLabel] !== undefined ? ui[contextSheet.usedLabel] : contextSheet.usedLabel}} / {{ui[contextSheet.windowLabel] !== undefined ? ui[contextSheet.windowLabel] : contextSheet.windowLabel}}</text>
</view>
<view class="ctx-bar"><view class="ctx-bar-fill" style="{{contextSheet.barStyle}}"></view></view>
<view has:for="{{contextSheet.rows}}" has:key="label" class="ctx-row">
<view class="ctx-dot {{item.cls}}"></view>
<text class="ctx-row-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
<text class="ctx-row-val">{{ui[item.valueLabel] !== undefined ? ui[item.valueLabel] : item.valueLabel}}</text>
</view>
</view>
</block>
<view has:if="{{commandMenu}}" class="command-menu-mask" catchtap="closeAttachMenu"></view>
<view has:if="{{commandMenu}}" class="command-menu {{commandMenu.type === 'catalog' ? 'command-catalog' : 'command-options'}}" catchtap="noop" role="dialog" aria-label="{{ui['添加与指令']}}">
<view has:if="{{commandMenu.type !== 'catalog'}}" class="command-menu-toolbar">
<view class="command-options-return" bindtap="backToComposerCommands" role="button" aria-label="{{ui['返回']}}" hover-class="command-row-pressed" hover-start-time="0" hover-stay-time="100"><image class="command-options-back command-monochrome" mode="aspectFit" src="/assets/icons/chev-right-gray.png"/><text class="command-options-title">{{commandMenu.title}}</text></view>
<view class="command-close" bindtap="closeAttachMenu" role="button" aria-label="{{ui['关闭']}}" hover-class="command-row-pressed" hover-start-time="0" hover-stay-time="100"><view class="command-close-glyph"></view></view>
</view>
<view has:if="{{commandMenu.type === 'options'}}" class="command-search-field"><image class="command-search-icon" mode="aspectFit" src="/assets/icons/dsh-search{{theme === 'dark' ? '-dark' : ''}}.svg"/><input class="command-search" value="{{commandMenuQuery}}" bindinput="onCommandMenuSearch" placeholder="{{ui['搜索指令或选项']}}" aria-label="{{ui['搜索指令或选项']}}" placeholder-class="command-search-placeholder" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight"/></view>
<view has:if="{{commandPaletteLoading || commandLoading}}" class="command-loading"><view class="command-loading-bar"></view></view>
<scroll-view class="command-scroll" scroll-y enhanced show-scrollbar="{{false}}">
<block has:if="{{commandMenu.type === 'catalog'}}">
<block has:for="{{commandMenu.groups}}" has:key="id" has:for-item="group">
<view class="command-group-title">{{ui[group.title] !== undefined ? ui[group.title] : group.title}}</view>
<view has:for="{{group.items}}" has:key="id" has:for-item="command" class="command-row" bindtap="selectCommand" data-name="{{command.name}}" data-id="{{command.id}}" data-action="{{command.action}}" role="button" aria-label="{{command.label}} {{command.name}} {{command.description}}" hover-class="command-row-pressed" hover-start-time="0" hover-stay-time="100">
<view class="command-menu-icon-slot"><image class="command-menu-icon {{command.action ? 'command-monochrome' : ''}}" mode="aspectFit" src="/assets/icons/{{command.icon}}"/></view>
<view class="command-identity"><text class="command-name">{{command.label}}</text><text has:if="{{command.label !== '/' + command.name && !command.action}}" class="command-alias">{{command.name}}</text></view>
<text has:if="{{!command.action && command.description}}" class="command-desc">{{command.description}}</text>
</view>
</block>
<view has:if="{{!commandMenu.groups.length && !commandLoading && !commandPaletteLoading}}" class="command-empty">{{ui['没有匹配的命令']}}</view>
</block>
<block has:else>
<view has:for="{{commandMenu.options}}" has:key="id" class="command-option {{item.selected ? 'selected' : ''}}" bindtap="selectCommandOption" data-id="{{item.id}}" role="button" aria-pressed="{{item.selected}}" aria-disabled="{{commandPaletteLoading}}" aria-label="{{ui[item.label] !== undefined ? ui[item.label] : item.label}} {{item.badge || ''}} {{item.detail}}" hover-class="command-row-pressed" hover-start-time="0" hover-stay-time="100">
<view class="command-option-main"><text class="command-option-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text><text has:if="{{item.badge}}" class="command-option-badge">{{item.badge}}</text></view>
<text has:if="{{item.detail}}" class="command-option-detail">{{ui[item.detail] !== undefined ? ui[item.detail] : item.detail}}</text>
<view class="command-check-slot" aria-hidden="true"><view has:if="{{item.selected}}" class="command-check"></view></view>
</view>
<view has:if="{{!commandMenu.options.length && !commandPaletteLoading}}" class="command-empty">{{ui['没有匹配的选项']}}</view>
</block>
</scroll-view>
<view has:if="{{commandPaletteError || commandError}}" class="command-error"><text>{{commandPaletteError || commandError}}</text><view class="command-retry" bindtap="refreshComposerCommands" role="button">{{ui['重试']}}</view></view>
</view>
<view has:if="{{fileMentionOpen}}" class="file-mention-menu" catchtap="noop" role="dialog" aria-label="{{ui['工作区文件']}}">
<view class="file-mention-head">
<view class="file-mention-heading">
<text class="file-mention-title">{{ui['文件与文件夹']}}</text>
<text class="file-mention-path">{{fileMentionPathLabel}}</text>
</view>
<view class="file-mention-close" bindtap="closeFileMention" role="button" aria-label="{{ui['关闭']}}"><view class="sheet-close-x"></view></view>
</view>
<scroll-view class="file-mention-scroll" scroll-y enhanced show-scrollbar="{{false}}">
<view has:if="{{fileMentionLoading && !fileMentionEntries.length}}" class="file-mention-state">{{ui['正在读取工作区文件…']}}</view>
<view has:if="{{fileMentionError}}" class="file-mention-state file-mention-error">
<text>{{ui[fileMentionError] !== undefined ? ui[fileMentionError] : fileMentionError}}</text>
<view class="file-mention-retry" bindtap="retryFileMention" role="button">{{ui['重试']}}</view>
</view>
<view has:if="{{!fileMentionLoading && !fileMentionError && !fileMentionEntries.length && !fileMentionSessionGroups.length && fileMentionQuery}}" class="file-mention-state">{{ui['没有匹配的文件或文件夹']}}</view>
<view has:if="{{!fileMentionLoading && !fileMentionError && !fileMentionEntries.length && !fileMentionSessionGroups.length && !fileMentionQuery}}" class="file-mention-state">{{ui['此目录为空']}}</view>
<view has:for="{{fileMentionEntries}}" has:key="key" class="file-mention-row" bindtap="selectFileMention" data-index="{{index}}" role="button">
<image class="file-mention-icon" src="/assets/icons/{{item.iconFile}}" mode="aspectFit"/>
<text class="file-mention-name">{{item.name}}{{item.kind === 'dir' ? '/' : ''}}</text>
<view has:if="{{item.kind === 'dir'}}" class="file-mention-drill" catchtap="drillFileMention" data-index="{{index}}" role="button" aria-label="{{ui['进入目录'] || '进入目录'}}">
<image class="file-mention-chevron" src="/assets/icons/chev-right-gray.png" mode="aspectFit"/>
</view>
</view>
<block has:for="{{fileMentionSessionGroups}}" has:key="key" has:for-item="group">
<view class="file-mention-group-title">{{group.label}}</view>
<view has:for="{{group.items}}" has:key="key" has:for-item="session" class="file-mention-row file-mention-session-row" bindtap="selectSessionMention" data-id="{{session.id}}" data-title="{{session.title}}" role="button">
<image class="file-mention-icon" src="/assets/icons/menu-chat-session.svg" mode="aspectFit"/>
<text class="file-mention-name">{{session.title}}</text>
<text has:if="{{session.detail}}" class="file-mention-session-detail">{{session.detail}}</text>
</view>
</block>
<view class="file-mention-bottom-space" aria-hidden="true"></view>
</scroll-view>
</view>
<view class="composer-surface {{voiceOverlayVisible ? 'voice-holding' : ''}}">
<view class="composer-backdrop" aria-hidden="true"></view>
<view class="composer">
<view class="voice-input-wrap">
<view class="composer-input-row composer-live {{composerPreview ? 'previewing' : ''}}">
<scroll-view hidden="{{!(composerPreview && composerPreviewBlocks.length)}}" class="composer-veil {{composerPreview && composerPreviewBlocks.length ? 'on' : ''}}" scroll-y enhanced show-scrollbar="{{false}}" bindtap="exitComposerPreviewEdit">
<view class="composer-veil-inner">
<template is="mdBlocks" data="{{blocks: composerPreviewBlocks, rowKey: 'live'}}"/>
</view>
</scroll-view>
<view hidden="{{!(commandToken && draft)}}" class="composer-slash-chip {{commandToken && draft ? 'on' : ''}}" catchtap="clearCommandToken" hover-class="press-dim" role="button" aria-label="{{ui['移除指令']}}">
<text class="composer-slash-token">{{commandTokenLabel}}</text>
<text class="composer-slash-x">×</text>
</view>
<view hidden="{{!composerRefs.length}}" class="composer-refs {{composerRefs.length ? 'on' : ''}}">
<view has:for="{{composerRefs}}" has:key="key" class="composer-ref-chip">
<image class="composer-ref-icon" src="/assets/icons/{{item.icon}}" mode="aspectFit"/>
<text class="composer-ref-label">{{item.label}}</text>
<view class="composer-ref-remove" catchtap="removeComposerRef" data-index="{{index}}" hover-class="press-dim" role="button" aria-label="{{ui['移除引用']}}"><text class="composer-ref-x">×</text></view>
</view>
</view>
<textarea class="composer-input" style="height:{{composerInputHeightPx}}px" placeholder="{{ui[composerPlaceholder] !== undefined ? ui[composerPlaceholder] : composerPlaceholder}}" placeholder-class="composer-placeholder" placeholder-style="{{theme === 'dark' ? 'color:rgba(241,244,250,0.36)' : 'color:rgba(16,19,24,0.28)'}}" value="{{composerValue}}" cursor="{{composerCursor}}" bindinput="onDraftInput" bindlinechange="onComposerLineChange" bindfocus="onComposerFocus" bindconfirm="send" confirm-type="send" focus="{{composerFocus}}" disabled="{{voiceOverlayVisible}}" auto-height="{{true}}" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindblur="onKeyboardHide" show-confirm-bar="{{false}}" cursor-spacing="20" maxlength="-1"/>
</view>
<view has:if="{{voiceEnabled && ((!composerFocused && !voiceTyping && voicePhase === 'idle') || voiceOverlayVisible)}}" class="voice-touch-surface" catchtouchstart="onVoiceTouchStart" catchtouchmove="onVoiceTouchMove" catchtouchend="onVoiceTouchEnd" catchtouchcancel="cancelVoice" role="button" aria-label="{{ui['轻点输入，按住说话，上滑取消']}}"></view>
</view>
<view has:if="{{voicePhase === 'transcribing' || voicePhase === 'stopping'}}" class="voice-progress"><text>{{ui['正在转文字…']}}</text><view class="voice-inline-action" bindtap="cancelVoice" role="button">{{ui['取消']}}</view></view>
<view has:if="{{voicePendingText}}" class="voice-transcript"><text class="voice-transcript-hint">{{ui['草稿已修改，识别文字待插入']}}</text><text class="voice-transcript-text" selectable>{{voicePendingText}}</text><view class="voice-transcript-actions"><view class="voice-inline-action" bindtap="discardPendingVoiceText" role="button">{{ui['丢弃识别文字']}}</view><view class="voice-inline-action" bindtap="insertPendingVoiceText" role="button">{{ui['插入文字']}}</view></view></view>
<view has:if="{{images.length}}" class="composer-images">
<block has:for="{{images}}" has:key="id">
<view has:if="{{item.isFile}}" class="pending-file" catchtap="previewPendingFile" data-index="{{index}}" role="button" aria-label="{{ui['预览']}} {{item.name}}">
<image class="pending-file-ic" src="/assets/icons/paperclip-gray.png"/>
<text class="pending-file-name">{{item.name}}</text>
<view class="composer-thumb-remove" catchtap="removeImage" data-index="{{index}}"><image class="thumb-x" src="/assets/icons/xmark-circle-dark.png"/></view>
</view>
<view has:else class="composer-thumb">
<image src="{{item.tempPath}}" mode="aspectFill" class="composer-thumb-img" bindtap="previewPendingImage" data-index="{{index}}"/>
<view class="composer-thumb-remove" catchtap="removeImage" data-index="{{index}}"><image class="thumb-x" src="/assets/icons/xmark-circle-dark.png"/></view>
</view>
</block>
</view>
<view class="composer-bar">
<view class="chip icon composer-plus {{attachSheetOpen ? 'active' : ''}}" bindtap="attachMenu" role="button" aria-label="{{ui['添加与指令']}}" aria-expanded="{{attachSheetOpen}}"><image class="attach-ic" src="/assets/icons/plus-gray.png"/></view>
<view class="chip permission-chip" bindtap="pickPermission" role="button" aria-label="{{ui['权限']}}" aria-expanded="{{permissionSheet.length > 0}}">
<image class="chip-ic" src="/assets/icons/{{permissionIcon}}" mode="aspectFit"/>
<text has:if="{{!permissionChipIconOnly}}" class="chip-label">{{ui[permissionLabel] !== undefined ? ui[permissionLabel] : permissionLabel}}</text>
<text class="chip-label-probe" aria-hidden="true">{{ui[permissionLabel] !== undefined ? ui[permissionLabel] : permissionLabel}}</text>
<view class="permission-chip-chevron {{permissionSheet.length ? 'open' : ''}}"></view>
</view>
<view class="composer-spacer"></view>
<view class="chip model-chip" bindtap="pickModel" hover-class="model-trigger-pressed" hover-start-time="0" hover-stay-time="100" role="button" aria-label="{{ui['模型']}} {{modelLabel}} {{effortLabel}}" aria-expanded="{{modelSheetOpen || effortSheetOpen}}"><text class="chip-model-name">{{modelLabel}}</text><text has:if="{{modelBadge}}" class="model-release-badge">{{modelBadge}}</text><text class="model-trigger-effort">{{effortLabel}}</text><view class="model-trigger-chevron {{modelSheetOpen || effortSheetOpen ? 'open' : ''}}"></view></view>
<view has:if="{{running && !canSend}}" class="send-btn stop glass-press" bindtap="stopAgent"><view class="stop-square"></view></view>
<view has:else class="send-btn {{canSend || voiceEnabled ? '' : 'disabled'}} glass-press" bindtap="onComposerAction" role="button" aria-label="{{canSend || !voiceEnabled ? ui['发送'] : (voiceTyping ? ui['切换到语音输入'] : ui['切换到文字输入'])}}"><image class="send-ic" src="/assets/icons/{{canSend || !voiceEnabled ? 'arrow-up-white.png' : (voiceTyping ? 'voice-wave.svg' : 'voice-keyboard.svg')}}"/></view>
</view>
</view>
<view class="composer-metrics">
<view class="composer-metric run" bindtap="showStats">
<image class="metric-icon metric-gauge" src="/assets/icons/dsh-gauge.svg" mode="aspectFit"/>
<text class="composer-metric-text">{{composerRunMetric}}</text>
</view>
<view class="composer-metric token" bindtap="showTokenStats">
<image class="metric-icon metric-storage" src="/assets/icons/dsh-storage.svg" mode="aspectFit"/>
<text class="composer-metric-text">{{composerTokenMetric}}</text>
</view>
<view class="composer-metric context" bindtap="openContextSheet">
<view class="metric-context-ring" style="{{contextRingStyle}}"><view class="metric-context-in"></view></view>
<text class="composer-metric-text">{{composerContextMetric}}</text>
</view>
</view>
</view>
</block>
</view>
<view has:if="{{permissionSheet.length}}" class="opt-mask" bindtap="closePickSheets"></view>
<view has:if="{{permissionSheet.length}}" class="opt-pop permission-pop" role="dialog" aria-label="{{ui['权限']}}">
<scroll-view class="permission-pop-scroll" scroll-y enhanced show-scrollbar="{{false}}">
<view has:for="{{permissionSheet}}" has:key="value" class="opt-row {{item.current ? 'current' : ''}}" bindtap="pickPermissionOption" data-value="{{item.value}}" role="button" aria-pressed="{{item.current}}" aria-label="{{item.name}} {{item.badge || ''}}" hover-class="permission-row-pressed" hover-start-time="0" hover-stay-time="100">
<view class="permission-icon-slot"><image class="opt-ic" src="/assets/icons/{{item.icon}}" mode="aspectFit"/></view>
<view class="permission-option-name"><text class="opt-label">{{item.name}}</text><text has:if="{{item.badge}}" class="permission-option-badge">{{item.badge}}</text></view>
<view class="permission-check-slot" aria-hidden="true"><view has:if="{{item.current}}" class="permission-check"></view></view>
</view>
</scroll-view>
</view>
<view has:if="{{modeSheet.length}}" class="opt-mask" bindtap="closePickSheets"></view>
<view has:if="{{modeSheet.length}}" class="opt-pop">
<view has:for="{{modeSheet}}" has:key="id" class="opt-row {{item.current ? 'current' : ''}}" bindtap="pickModeOption" data-id="{{item.id}}">
<view class="opt-main">
<text class="opt-label">{{item.name}}</text>
<text has:if="{{item.desc}}" class="opt-desc">{{ui[item.desc] !== undefined ? ui[item.desc] : item.desc}}</text>
</view>
<image has:if="{{item.current}}" class="opt-check" src="/assets/icons/check-ocean.png"/>
</view>
</view>
<view has:if="{{modelSheetOpen}}" class="opt-mask" bindtap="closeModelSheet"></view>
<view has:if="{{modelSheetOpen}}" class="opt-pop model-pop {{modelMenuPane === 'root' ? 'model-root' : 'model-list'}}" role="dialog" aria-label="{{ui['模型']}}">
<block has:if="{{modelMenuPane === 'root'}}">
<view class="model-row model-menu-entry" bindtap="openModelList" role="button" hover-class="model-row-pressed" hover-start-time="0" hover-stay-time="100"><text class="model-entry-label">{{ui['模型']}}</text><view class="model-entry-value"><text class="model-value-text">{{modelLabel}}</text><text has:if="{{modelBadge}}" class="model-release-badge">{{modelBadge}}</text></view><view class="model-entry-chevron"></view></view>
<view class="model-row model-menu-entry" bindtap="pickEffort" role="button" hover-class="model-row-pressed" hover-start-time="0" hover-stay-time="100"><text class="model-entry-label">{{ui['推理等级']}}</text><view class="model-entry-value">{{effortLabel}}</view><view class="model-entry-chevron"></view></view>
</block>
<block has:else>
<scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="model-pop-scroll">
<block has:for="{{modelGroups}}" has:key="id" has:for-item="g">
<view class="model-group-title">{{g.name}}</view>
<view has:for="{{g.models}}" has:key="model" has:for-item="m" class="model-row {{m.current ? 'current' : ''}}" bindtap="pickModelOption" data-provider="{{m.provider}}" data-model="{{m.model}}" data-effort="{{m.effort}}" role="button" aria-label="{{g.name}} {{m.name}}" aria-pressed="{{m.current}}" hover-class="model-row-pressed" hover-start-time="0" hover-stay-time="100">
<view class="model-identity"><text class="model-name">{{m.name}}</text><text has:if="{{m.badge}}" class="model-release-badge">{{m.badge}}</text></view>
<view class="model-check-slot" aria-hidden="true"><view has:if="{{m.current}}" class="model-check"></view></view>
</view>
</block>
</scroll-view>
</block>
</view>
<view has:if="{{effortSheetOpen}}" class="opt-mask" bindtap="closeEffortSheet"></view>
<view has:if="{{effortSheetOpen}}" class="opt-pop model-pop" role="dialog" aria-label="{{ui['推理等级']}}">
<view class="model-row model-menu-back" bindtap="backToModelMenu" role="button" aria-label="{{ui['返回']}}" hover-class="model-row-pressed" hover-start-time="0" hover-stay-time="100"><view class="model-entry-chevron"></view><text>{{ui['推理等级']}}</text></view>
<view has:for="{{effortSheet}}" has:key="value" has:for-item="e" class="model-row {{e.current ? 'current' : ''}}" bindtap="pickEffortOption" data-value="{{e.value}}" role="button" aria-pressed="{{e.current}}" hover-class="model-row-pressed" hover-start-time="0" hover-stay-time="100">
<text class="model-name">{{e.name}}</text>
<view class="model-check-slot" aria-hidden="true"><view has:if="{{e.current}}" class="model-check"></view></view>
</view>
</view>
<view has:if="{{filePreview}}" class="sheet-mask" catchtap="closeFilePreview">
<view class="sheet delivered-preview" catchtap="noop">
<view class="sheet-handle"/><view class="delivered-sheet-head"><image has:if="{{filePreview.icon}}" class="delivered-preview-icon" src="{{filePreview.icon}}" mode="aspectFit"/><text class="delivered-preview-name">{{filePreview.name}}</text><view class="close-x-wrap" bindtap="closeFilePreview"><view class="sheet-close-x"></view></view></view>
<text has:if="{{filePreview.typeLabel}}" class="delivered-preview-meta">{{filePreview.typeLabel}}{{filePreview.sizeLabel ? ' · ' + filePreview.sizeLabel : ''}}</text>
<block has:if="{{fileBusyKey && fileBusyKey === filePreview.key}}">
<view class="delivered-progress"><view class="delivered-progress-bar" style="width:{{fileProgress}}%"></view></view>
<text class="delivered-preview-note">{{ui['正在下载文件']}} {{fileProgress}}%</text>
</block>
<block has:elif="{{filePreview.error}}"><text class="delivered-preview-note">{{filePreview.error}}</text></block>
<block has:elif="{{filePreview.previewKind === 'image' && filePreview.localPath}}">
<scroll-view scroll-y class="delivered-preview-scroll"><image class="delivered-preview-image" src="{{filePreview.localPath}}" mode="aspectFit"/></scroll-view>
</block>
<block has:elif="{{filePreview.previewKind === 'document' || filePreview.previewKind === 'file'}}">
<view class="delivered-preview-doc"><image class="delivered-preview-doc-icon" src="{{filePreview.icon}}" mode="aspectFit"/><text class="delivered-preview-note">{{ui['正文由微信查看器打开']}}</text></view>
</block>
<block has:else>
<text has:if="{{filePreview.selection}}" class="delivered-preview-note">{{ui['长按文字可选择，或点下方复制']}}</text>
<text has:if="{{filePreview.sourceCode}}" class="delivered-preview-note">{{ui['安全源码预览，不执行脚本']}}</text>
<text has:if="{{filePreview.truncated}}" class="delivered-preview-note">{{ui['仅预览前 128 KB，完整内容请转发文件查看']}}</text>
<scroll-view scroll-y class="delivered-preview-scroll"><text selectable class="delivered-preview-text" style="{{filePreview.selection ? 'font-family:inherit;' : ''}}">{{filePreview.text || ui['空文件']}}</text></scroll-view>
</block>
<block has:if="{{filePreview.selection}}">
<view class="delivered-selection-actions">
<view class="delivered-action" bindtap="copyTextSelection" role="button">{{ui['复制']}}</view>
</view>
</block>
<block has:else>
<view class="delivered-action" bindtap="filePreviewPrimary" role="button" aria-disabled="{{!!fileBusyKey}}">{{filePreview.primary || ui['复制']}}</view>
<view has:if="{{filePreview.canShare}}" class="delivered-action" bindtap="shareSelectedFile" role="button" aria-disabled="{{!!fileBusyKey || !!fileSharingKey}}">{{fileSharingKey ? ui['正在打开微信转发…'] : ui['转发到微信']}}</view>
<view has:if="{{filePreview.canCopyPath}}" class="delivered-action delivered-action-secondary" bindtap="copyPresentedPath">{{ui['复制文件路径']}}</view>
</block>
</view>
</view>
<view has:if="{{changesDiff}}" class="sheet-mask" catchtap="closeChangesDiff" catchtouchmove="noop">
<view class="sheet delivered-preview changes-preview" catchtap="noop">
<view class="sheet-handle"/><view class="delivered-sheet-head"><text>{{changesDiff.title}}</text><view class="close-x-wrap" bindtap="closeChangesDiff"><view class="sheet-close-x"></view></view></view>
<text has:if="{{changesDiff.loading}}" class="delivered-preview-note">{{ui['正在加载文件变更…']}}</text>
<text has:if="{{changesDiff.note}}" class="delivered-preview-note">{{changesDiff.note}}</text>
<scroll-view scroll-y class="delivered-preview-scroll">
<view has:for="{{changesDiff.hunks}}" has:for-item="hunk" has:key="key" class="changes-hunk">
<text class="changes-hunk-label">{{hunk.label}}</text>
<text has:for="{{hunk.lines}}" has:for-item="line" has:key="key" selectable class="changes-line {{line.kind}}">{{line.text}}</text>
</view>
</scroll-view>
</view>
</view>
<view has:if="{{collaborationOpen}}" class="sheet-mask collab-mask" catchtap="closeCollaboration" catchtouchmove="noop">
<view class="sheet collab-sheet {{collaborationExpanded ? 'is-expanded' : ''}}" catchtap="noop" role="dialog" aria-label="{{ui['协作详情']}}">
<view class="collab-resize-handle" catchtouchstart="collabGrabStart" catchtouchmove="collabGrabMove" catchtouchend="collabGrabEnd" role="button" aria-expanded="{{collaborationExpanded}}" aria-label="{{collaborationExpanded ? ui['收起协作面板'] : ui['展开协作面板至九成屏幕']}}">
<view class="sheet-handle" aria-hidden="true"/>
</view>
<view class="collab-heading">
<text class="collab-title">{{ui['协作']}}</text>
<view class="collab-mode">
<image class="collab-mode-icon" src="/assets/icons/{{connected ? (theme === 'dark' ? 'dsh-agent-green-dark.svg' : 'dsh-agent-green.svg') : (theme === 'dark' ? 'dsh-agent-dark.svg' : 'dsh-agent.svg')}}" mode="aspectFit" aria-hidden="true"/>
<text class="collab-mode-text">{{presetLabel}}</text>
</view>
<view class="collab-action collab-refresh {{collaborationBusy ? 'busy' : ''}} {{connected ? 'online' : 'offline'}} {{running ? 'is-running' : 'is-idle'}}" bindtap="refreshCollaboration" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['刷新协作状态']}}" aria-disabled="{{collaborationBusy}}">
<view class="collab-action-disc"><view class="collab-breathe" aria-hidden="true"><view class="collab-breathe-halo"/><view class="collab-breathe-dot"/></view></view>
</view>
<view class="collab-action collab-close" bindtap="closeCollaboration" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" role="button" aria-label="{{ui['关闭']}}">
<view class="collab-action-disc"><image class="collab-action-icon" src="/assets/icons/collab-close{{theme === 'dark' ? '-dark' : ''}}.svg" mode="aspectFit" aria-hidden="true"/></view>
</view>
</view>
<scroll-view class="collab-tabs" scroll-x enhanced show-scrollbar="{{false}}" enable-flex>
<view class="collab-tabs-track">
<view has:for="{{collaborationTabs}}" has:key="id" class="collab-tab {{collaborationTab === item.id ? 'active' : ''}}" bindtap="selectCollaborationTab" data-id="{{item.id}}" role="button" aria-label="{{item.label}} {{item.count}}" aria-pressed="{{collaborationTab === item.id}}" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
<view class="collab-tab-summary">
<image class="collab-tab-icon" src="/assets/icons/{{item.icon}}{{theme === 'dark' ? '-dark' : ''}}.svg" mode="aspectFit" aria-hidden="true"/>
<text class="collab-tab-count">{{item.count}}</text>
</view>
<text class="collab-tab-label">{{item.label}}</text>
<view class="collab-tab-indicator" aria-hidden="true"/>
</view>
</view>
</scroll-view>
<scroll-view class="collab-scroll" scroll-y enhanced show-scrollbar="{{false}}">
<view has:if="{{collaborationPreview}}" class="collab-preview">
<view class="collab-back" bindtap="backCollaborationList" role="button">‹ {{ui['返回列表']}}</view>
<view class="collab-preview-title">{{collaborationPreview.title}}</view>
<view has:if="{{!collaborationPreview.task}}" class="collab-note">{{ui['只读记录，不会切换当前对话或发送任务']}}</view>
<view has:if="{{collaborationPreview.loading}}" class="collab-empty">{{ui['正在加载记录…']}}</view>
<view has:elif="{{collaborationPreview.error}}" class="collab-empty">{{collaborationPreview.errorText || ui['加载记录失败，请重试']}}</view>
<block has:elif="{{collaborationPreview.task}}">
<view class="collab-task-meta">{{collaborationPreview.statusText}} · {{collaborationPreview.owner}}</view>
<text class="collab-message-text" selectable>{{collaborationPreview.text}}</text>
<view has:if="{{collaborationPreview.blocked}}" class="collab-note">{{ui['阻塞任务']}} · {{collaborationPreview.blocked}}</view>
</block>
<block has:else>
<view has:if="{{collaborationPreview.children.length}}" class="collab-section-label">{{ui['下级子智能体']}}</view>
<view has:for="{{collaborationPreview.children}}" has:key="id" class="collab-row" bindtap="openCollaborationItem" data-id="{{item.id}}" role="button"><view class="collab-row-copy"><text class="collab-row-title">{{item.title}}</text><text class="collab-subtitle">{{item.subtitle}}</text></view><text class="collab-status">{{item.statusText}}</text><view class="collab-chevron"/></view>
<view has:for="{{collaborationPreview.rows}}" has:key="key" class="collab-message"><text class="collab-section-label">{{item.role}}</text><text class="collab-message-text" selectable>{{item.text}}</text></view>
<view has:if="{{!collaborationPreview.rows.length}}" class="collab-empty">{{ui['暂无可显示的消息']}}</view>
<view has:if="{{collaborationPreview.hasMore}}" class="collab-note">{{ui['更多记录可在 DSH 客户端查看']}}</view>
</block>
</view>
<view has:else class="collab-list">
<view has:if="{{collaborationNote}}" class="collab-note">{{collaborationNote}}</view>
<view has:for="{{collaborationRows}}" has:key="id" class="collab-row {{item.current ? 'current' : ''}}" bindtap="openCollaborationItem" data-id="{{item.id}}" hover-class="press-dim" role="button" aria-disabled="{{!item.canOpen && collaborationTab !== 'tasks'}}">
<view class="collab-state {{item.status}}"/>
<view class="collab-row-copy"><text class="collab-row-title">{{item.title}}</text><text class="collab-subtitle">{{item.subtitle}}</text><text has:if="{{item.error}}" class="collab-error">{{item.error}}</text></view>
<view class="collab-row-meta"><text class="collab-status {{item.status}}">{{item.statusText}}</text><text has:if="{{item.current}}" class="collab-current">{{ui['当前会话']}}</text></view>
<view has:if="{{item.canOpen || collaborationTab === 'tasks'}}" class="collab-chevron"/>
</view>
<view has:if="{{!collaborationRows.length}}" class="collab-empty">{{collaborationTab === 'members' ? ui['暂无成员'] : collaborationTab === 'children' ? ui['暂无子智能体'] : collaborationTab === 'tasks' ? ui['暂无团队任务'] : ui['暂无工具调用']}}</view>
</view>
</scroll-view>
</view>
</view>
<view hidden="{{!turnNavOpen}}" class="turn-overlay {{!turnNavOpen ? 'session-panel-hidden' : ''}}" catchtap="closeTurnNavigator" catchtouchmove="noop">
<view class="turn-overlay-inner" catchtap="closeTurnNavigator" role="dialog" aria-label="{{ui['对话']}}">
<view class="turn-scrub-body" id="turn-scrub-body">
<view has:if="{{turnNavWarming}}" class="turn-history-status">{{turnNavWarmText}} · {{turnNavItems.length}}</view>
<view has:elif="{{historyLoading}}" class="turn-history-status">{{historyProgressText}} · {{turnNavItems.length}}</view>
<view has:elif="{{hasMoreHistory && histError}}" class="turn-history-status turn-history-error" catchtap="retryTurnNavigatorHistory">{{histError}} · {{ui['重试']}}</view>
<view has:elif="{{turnNavHistoryComplete && turnNavItems.length}}" class="turn-history-status turn-history-complete">{{turnNavHistoryText}} · {{turnNavItems.length}}</view>
<view has:elif="{{turnNavHistoryPending && turnNavItems.length}}" class="turn-history-status">{{turnNavHistoryText}} · {{turnNavItems.length}}</view>
<view has:elif="{{turnNavWarmText}}" class="turn-history-status">{{turnNavWarmText}} · {{turnNavItems.length}}</view>
<scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="turn-scrub-list" id="turn-scrub-list" style="height: 76vh;" scroll-top="{{turnNavScrollTop}}" bindscroll="onTurnListScroll" bindtouchstart="onTurnScrubStart" bindtouchend="onTurnScrubEnd" bindtouchcancel="onTurnScrubCancel">
<view class="turn-scrub-inner">
<view class="turn-scrub-spacer" style="height: {{turnNavTopPadPx}}px;"></view>
<view has:for="{{turnNavVisibleItems}}" has:key="key" class="turn-scrub-row {{turnNavActiveIndex === item.index ? 'active' : ''}}" style="{{turnNavRowStyles[item.index] || ''}}" data-key="{{item.key}}" catchtap="jumpToTurn" role="button">
<view class="turn-scrub-row-copy">
<text class="turn-scrub-row-title">{{item.label}}</text>
</view>
<view class="turn-scrub-tick-slot" aria-hidden="true"><view class="turn-scrub-tick"/></view>
</view>
<view class="turn-scrub-spacer" style="height: {{turnNavBottomPadPx}}px;"></view>
</view>
</scroll-view>
<view has:if="{{!turnNavItems.length}}" class="turn-nav-empty">{{ui['暂无可显示的消息']}}</view>
</view>
</view>
</view>
<view class="sheet-mask session-menu-mask {{moreSheetOpen ? 'is-open' : ''}}" aria-hidden="{{!moreSheetOpen}}" catchtap="closeMoreActions" catchtouchmove="noop">
<view class="sheet session-menu {{moreSheetExpanded ? 'expanded' : ''}}" style="margin-bottom: {{renameKeyboard}}px;" catchtap="noop">
<view class="session-menu-grabber-zone" catchtouchstart="moreSheetGrabStart" catchtouchmove="moreSheetGrabMove" catchtouchend="moreSheetGrabEnd" role="button" aria-label="{{moreSheetExpanded ? ui['收起'] : ui['展开']}}">
<view class="sheet-handle"></view>
</view>
<view class="session-menu-head">
<view class="session-menu-heading">
<view has:if="{{morePane !== 'menu'}}" class="session-menu-back" bindtap="backToMoreMenu" hover-class="session-menu-back-pressed" role="button" aria-label="{{ui['返回']}}">
<image class="session-menu-back-ic" src="/assets/icons/chev-right-gray.png" mode="aspectFit"/>
</view>
<text class="session-menu-title">{{morePane === 'rename' ? ui['重命名会话'] : morePane === 'stats' ? ui['会话状态'] : morePane === 'files' ? ui['工作区文件'] : ui['更多']}}</text>
</view>
<view class="session-menu-close" bindtap="closeMoreActions" role="button"><view class="sheet-close-x"></view></view>
</view>
<scroll-view has:if="{{morePane === 'menu'}}" scroll-y enhanced show-scrollbar="{{false}}" class="session-menu-scroll">
<view class="session-menu-group">
<view class="session-menu-row" bindtap="selectMoreAction" data-action="rename" hover-class="session-menu-pressed" role="button">
<image class="session-menu-icon" src="/assets/icons/pencil-line-gray.png" mode="aspectFit"/><text class="session-menu-label">{{ui['重命名会话']}}</text><image class="session-menu-chevron" src="/assets/icons/chev-right-gray.png"/>
</view>
<view class="session-menu-row" bindtap="selectMoreAction" data-action="stats" hover-class="session-menu-pressed" role="button">
<image class="session-menu-icon" src="/assets/icons/dsh-gauge.svg" mode="aspectFit"/><text class="session-menu-label">{{ui['查看统计']}}</text><image class="session-menu-chevron" src="/assets/icons/chev-right-gray.png"/>
</view>
<view class="session-menu-row" bindtap="selectMoreAction" data-action="files" hover-class="session-menu-pressed" role="button">
<image class="session-menu-icon session-menu-folder" src="/assets/icons/{{theme === 'dark' ? 'ic-dir-folder-white.png' : 'ic-dir-folder-ink.png'}}" mode="aspectFit"/><text class="session-menu-label">{{ui['工作区文件']}}</text><image class="session-menu-chevron" src="/assets/icons/chev-right-gray.png"/>
</view>
<view class="session-menu-row" bindtap="selectMoreAction" data-action="switchSessions" hover-class="session-menu-pressed" role="button">
<image class="session-menu-icon" src="/assets/icons/list-gray.png" mode="aspectFit"/><text class="session-menu-label">{{ui['会话快捷切换']}}</text><image class="session-menu-chevron" src="/assets/icons/chev-right-gray.png"/>
</view>
</view>
<view class="session-menu-group">
<view class="session-menu-row" bindtap="selectMoreAction" data-action="browsePlugins" hover-class="session-menu-pressed" role="button">
<image class="session-menu-icon" src="/assets/icons/{{theme === 'dark' ? 'pinwheel-white.png' : 'pinwheel-gray.png'}}" mode="aspectFit"/><text class="session-menu-label">{{ui['浏览更多插件']}}</text><image class="session-menu-chevron" src="/assets/icons/chev-right-gray.png"/>
</view>
<view class="session-menu-row" bindtap="selectMoreAction" data-action="createPlugin" hover-class="session-menu-pressed" role="button">
<image class="session-menu-icon" src="/assets/icons/{{theme === 'dark' ? 'plus-white.png' : 'plus-gray.png'}}" mode="aspectFit"/><text class="session-menu-label">{{ui['创建你的插件']}}</text><image class="session-menu-chevron" src="/assets/icons/chev-right-gray.png"/>
</view>
</view>
<view class="session-menu-group">
<view class="session-menu-row {{running ? '' : 'disabled'}}" bindtap="selectMoreAction" data-action="cancel" hover-class="{{running ? 'session-menu-pressed' : 'none'}}" role="button" aria-disabled="{{!running}}">
<image class="session-menu-icon" src="/assets/icons/session-stop.svg" mode="aspectFit"/><text class="session-menu-label">{{ui['取消当前回合']}}</text>
</view>
<view class="session-menu-row" bindtap="selectMoreAction" data-action="archive" hover-class="session-menu-pressed" role="button">
<image class="session-menu-icon" src="/assets/icons/session-archive.svg" mode="aspectFit"/><text class="session-menu-label">{{ui['归档会话']}}</text>
</view>
</view>
</scroll-view>
<view has:elif="{{morePane === 'rename'}}" class="session-menu-pane">
<view class="session-sheet-field">
<input class="session-sheet-input" value="{{renameValue}}" focus="{{morePane === 'rename'}}" bindinput="onRenameInput" bindfocus="onRenameFocus" bindblur="onRenameBlur" bindkeyboardheightchange="onRenameKeyboard" maxlength="60" cursor-spacing="24" adjust-position="{{false}}" placeholder="{{ui['重命名会话']}}" placeholder-class="session-sheet-placeholder" confirm-type="done" bindconfirm="confirmRename"/>
</view>
<view class="session-sheet-actions">
<view class="session-sheet-ghost" bindtap="backToMoreMenu" role="button">{{ui['取消']}}</view>
<view class="session-sheet-primary" bindtap="confirmRename" role="button">{{ui['保存']}}</view>
</view>
</view>
<view has:elif="{{morePane === 'switch'}}" class="session-menu-pane">
<view class="session-switch-search">
<image class="session-switch-search-icon" src="/assets/icons/search-white.png" mode="aspectFit"/>
<input class="session-switch-search-input" value="{{sessionSwitcherQuery}}" placeholder="{{ui['搜索会话内容']}}" placeholder-class="field-placeholder" bindinput="onSessionSwitcherSearch" confirm-type="search"/>
</view>
<scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="session-menu-scroll">
<view has:for="{{sessionSwitcherItems}}" has:key="sessionId" class="session-switch-row {{item.current ? 'current' : ''}}" bindtap="switchSessionFromMore" data-session-id="{{item.sessionId}}" hover-class="session-switch-row-pressed" role="button" aria-label="{{item.displayTitle}}">
<view class="session-switch-state {{item.current ? 'current' : ''}} {{item.running ? 'running' : ''}} {{item.hasUnread ? 'unread' : ''}}"/>
<view class="session-switch-copy">
<text class="session-switch-row-title">{{item.displayTitle}}</text>
<text has:if="{{item.activityLabel}}" class="session-switch-activity">{{item.activityLabel}}</text>
</view>
<text has:if="{{item.current}}" class="session-switch-current">{{ui['当前会话']}}</text>
</view>
<view has:if="{{!sessionSwitcherItems.length}}" class="session-switch-empty">{{ui['没有匹配的会话']}}</view>
</scroll-view>
</view>
<scroll-view has:elif="{{morePane === 'stats'}}" scroll-y enhanced show-scrollbar="{{false}}" class="session-menu-scroll session-menu-stats">
<view has:for="{{statsSheet}}" has:key="title" class="session-stat-group">
<view class="session-stat-group-title">{{ui[item.title] !== undefined ? ui[item.title] : item.title}}</view>
<view has:for="{{item.rows}}" has:for-item="row" has:key="index" class="session-stat-row">
<text class="session-stat-label">{{row[0]}}</text>
<text class="session-stat-value">{{row[1]}}</text>
</view>
</view>
<view class="session-sheet-note">{{ui['会话状态']}}</view>
</scroll-view>
<view has:elif="{{morePane === 'files'}}" class="session-menu-pane session-menu-files">
<view class="more-files-toolbar">
<view has:if="{{!filesIsRoot}}" class="more-files-up" bindtap="sessionFilesGoUp" role="button">{{ui['‹ 上一级']}}</view>
<view has:else class="more-files-up disabled"></view>
</view>
<scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="more-files-scroll session-menu-files-scroll">
<view has:if="{{filesLoading && !filesEntries.length}}" class="more-files-center">{{ui['正在读取工作区文件…']}}</view>
<view has:elif="{{filesError}}" class="more-files-center">{{ui[filesError] !== undefined ? ui[filesError] : filesError}}</view>
<view has:elif="{{!filesEntries.length}}" class="more-files-center">{{ui['此目录为空']}}</view>
<block has:else>
<view has:for="{{filesEntries}}" has:key="key" class="more-files-row" data-index="{{index}}" bindtap="openSessionFile" hover-class="session-menu-pressed" role="button">
<image class="more-files-icon" src="/assets/icons/{{item.iconFile}}" mode="aspectFit"/>
<text class="more-files-name">{{item.name}}</text>
<text has:if="{{item.kind === 'dir'}}" class="more-files-chev">›</text>
</view>
</block>
</scroll-view>
<view class="more-files-path">{{filesPathLabel}}</view>
</view>
</view>
</view>
<view class="session-switch-overlay {{sessionSwitcherOpen ? 'is-open' : ''}}" aria-hidden="{{!sessionSwitcherOpen}}" catchtap="closeSessionSwitcher" catchtouchmove="noop">
<view class="session-switch-top" style="top: {{navPadTop}}px; height: {{navHeight}}px;" catchtap="noop">
<view class="session-switch-search {{sessionSwitcherSearchOpen ? 'open' : ''}}" style="{{sessionSwitcherSearchOpen ? 'width: min(520rpx, calc(100vw - ' + (navMoreRight + 48) + 'px));' : ''}}" catchtap="expandSwitcherSearch" role="button" aria-label="{{ui['搜索会话内容']}}">
<image class="session-switch-search-icon" src="/assets/icons/search-white.png" mode="aspectFit"/>
<input has:if="{{sessionSwitcherSearchOpen}}" class="session-switch-search-input" focus="{{sessionSwitcherSearchOpen}}" value="{{sessionSwitcherQuery}}" placeholder="{{ui['搜索会话内容']}}" placeholder-class="field-placeholder" bindinput="onSessionSwitcherSearch" confirm-type="search"/>
</view>
</view>
<view class="session-switch-panel" style="padding-top: {{navPadTop + navHeight - 16}}px;" role="dialog" aria-label="{{ui['会话快捷切换']}}">
<scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="session-switch-list" style="max-height: calc(90vh - {{navPadTop + navHeight + 8}}px);" bindtap="closeSessionSwitcher">
<block has:for="{{sessionSwitcherItems}}" has:key="key">
<view has:if="{{item.header}}" class="session-switch-group">
<text class="session-switch-group-title">{{item.title}}</text>
<text class="session-switch-group-count">{{item.count}}</text>
</view>
<view has:else class="session-switch-row {{item.current ? 'current' : ''}}" bindtap="switchSessionFromSwitcher" data-session-id="{{item.sessionId}}" hover-class="session-switch-row-pressed" role="button" aria-label="{{item.displayTitle}}">
<view class="session-switch-state {{item.current ? 'current' : ''}} {{item.running ? 'running' : ''}} {{item.hasUnread ? 'unread' : ''}}"/>
<view class="session-switch-copy">
<text class="session-switch-row-title">{{item.displayTitle}}</text>
<text has:if="{{item.activityLabel}}" class="session-switch-activity">{{item.activityLabel}}</text>
</view>
<text has:if="{{item.current}}" class="session-switch-current">{{ui['当前会话']}}</text>
</view>
</block>
<view has:if="{{!sessionSwitcherItems.length}}" class="session-switch-empty">{{ui['没有匹配的会话']}}</view>
</scroll-view>
</view>
</view>
<view has:if="{{filesSheetOpen}}" class="sheet-mask" catchtap="closeFilesSheet" catchtouchmove="noop">
<view class="sheet more-files-sheet" style="height: {{filesSheetExpanded ? 90 : 62}}vh;" catchtap="noop" role="dialog" aria-label="{{ui['工作区文件']}}">
<view class="files-grabber-zone" catchtouchstart="filesGrabStart" catchtouchmove="filesGrabMove" catchtouchend="filesGrabEnd">
<view class="sheet-handle"></view>
</view>
<view class="session-menu-head">
<text class="session-menu-title">{{fileReferenceMode ? ui['引用工作区文件'] : ui['工作区文件']}}</text>
<view class="session-menu-close" bindtap="closeFilesSheet" role="button"><view class="sheet-close-x"></view></view>
</view>
<view class="more-files-toolbar">
<view has:if="{{!filesIsRoot}}" class="more-files-up" bindtap="sessionFilesGoUp" role="button">{{ui['‹ 上一级']}}</view>
<view has:else class="more-files-up disabled"></view>
</view>
<scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="more-files-scroll">
<view has:if="{{filesLoading && !filesEntries.length}}" class="more-files-center">{{ui['正在读取工作区文件…']}}</view>
<view has:elif="{{filesError}}" class="more-files-center">{{ui[filesError] !== undefined ? ui[filesError] : filesError}}</view>
<view has:elif="{{!filesEntries.length}}" class="more-files-center">{{ui['此目录为空']}}</view>
<block has:else>
<view has:for="{{filesEntries}}" has:key="key" class="more-files-row" data-index="{{index}}" bindtap="openSessionFile" hover-class="session-menu-pressed" role="button">
<image class="more-files-icon" src="/assets/icons/{{item.iconFile}}" mode="aspectFit"/>
<text class="more-files-name">{{item.name}}</text>
<text has:if="{{item.kind === 'dir'}}" class="more-files-chev">›</text>
</view>
</block>
</scroll-view>
<view class="more-files-path">{{filesPathLabel}}</view>
</view>
</view>
<view has:if="{{confirmSheet}}" class="sheet-mask" catchtap="closeConfirmSheet" catchtouchmove="noop">
<view class="sheet confirm-sheet" catchtap="noop" role="dialog">
<view class="sheet-handle"></view>
<view class="confirm-title">{{confirmSheet === 'cancel' ? ui['停止当前回合'] : ui['归档会话']}}</view>
<view class="confirm-body">{{confirmSheet === 'cancel' ? ui['将取消 Agent 正在执行的回合。'] : ui['归档后会话将从列表隐藏。']}}</view>
<view class="confirm-actions">
<view class="confirm-cancel" bindtap="closeConfirmSheet" role="button">{{ui['取消']}}</view>
<view class="confirm-ok {{confirmSheet === 'cancel' ? 'danger' : ''}}" bindtap="runConfirmSheet" role="button">{{confirmSheet === 'cancel' ? ui['停止当前回合'] : ui['归档会话']}}</view>
</view>
</view>
</view>
<view has:if="{{traceDetail}}" class="sheet-mask trace-inspector-mask" catchtap="closeTraceDetail" catchtouchmove="noop">
<view class="trace-inspector" catchtap="noop">
<view class="trace-inspector-handle"/>
<view class="trace-inspector-head"><view class="trace-inspector-dot {{traceDetail.badgeClass}}" aria-hidden="true"/><text class="trace-inspector-title">{{ui[traceDetail.label] !== undefined ? ui[traceDetail.label] : traceDetail.label}}</text><text class="trace-inspector-close" bindtap="closeTraceDetail" role="button">{{ui['完成']}}</text></view>
<view class="trace-detail-tab-strip"><view has:for="{{traceDetailTabs}}" has:key="id" class="trace-detail-tab {{traceDetailTab === item.id ? 'active' : ''}}" bindtap="selectTraceDetailTab" data-id="{{item.id}}" role="button">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</view></view>
<scroll-view class="trace-inspector-body" scroll-y enhanced show-scrollbar="{{false}}">
<view class="trace-inspector-page">
<view has:for="{{traceDetailSection.fields}}" has:for-item="field" has:key="label" class="trace-detail-field"><text class="trace-detail-field-label">{{ui[field.label] !== undefined ? ui[field.label] : field.label}}</text><text class="trace-detail-field-value" selectable>{{field.value}}</text></view>
<view has:for="{{traceDetailSection.blocks}}" has:for-item="section" has:key="title" class="trace-detail-section">
<view has:if="{{section.collapsible}}" class="trace-section-title trace-thinking-toggle" bindtap="toggleTraceThinking" role="button"><text>{{ui[section.title] !== undefined ? ui[section.title] : section.title}}</text><text>{{traceThinkingExpanded ? '⌄' : '›'}}</text></view>
<view has:else class="trace-section-title">{{ui[section.title] !== undefined ? ui[section.title] : section.title}}</view>
<block has:if="{{!section.collapsible || traceThinkingExpanded}}">
<text has:if="{{section.code}}" class="trace-section-code" selectable>{{section.text}}</text>
<block has:else>
<block has:for="{{section.blocks}}" has:for-item="block" has:for-index="blockIndex" has:key="blockIndex">
<rich-text has:if="{{block.type === 'para'}}" class="md-para" nodes="{{block.html}}" user-select/>
<rich-text has:elif="{{block.type === 'heading'}}" class="md-heading md-h{{block.level}}" nodes="{{block.html}}" user-select/>
<text has:elif="{{block.type === 'code'}}" class="trace-section-code" selectable>{{block.text}}</text>
<rich-text has:elif="{{block.type === 'quote'}}" class="md-quote" nodes="{{block.html}}" user-select/>
<view has:elif="{{block.type === 'hr'}}" class="md-hr"/>
<view has:elif="{{block.type === 'list'}}" class="md-list"><view has:for="{{block.items}}" has:for-item="li" has:for-index="liIndex" has:key="liIndex" class="md-li"><text class="md-li-marker">{{block.ordered ? (liIndex + 1) + '.' : '•'}}</text><rich-text class="md-li-text" nodes="{{li}}" user-select/></view></view>
<scroll-view has:elif="{{block.type === 'table'}}" scroll-x><view class="md-table"><view class="md-tr md-tr-head"><view has:for="{{block.header}}" has:for-item="cell" has:for-index="cellIndex" has:key="cellIndex" class="md-td md-th"><rich-text nodes="{{cell}}" user-select/></view></view><view has:for="{{block.rows}}" has:for-item="tableRow" has:for-index="rowIndex" has:key="rowIndex" class="md-tr"><view has:for="{{tableRow}}" has:for-item="cell" has:for-index="cellIndex" has:key="cellIndex" class="md-td"><rich-text nodes="{{cell}}" user-select/></view></view></view></scroll-view>
</block>
</block>
</block>
</view>
</view>
</scroll-view>
<view class="trace-inspector-footer"><text>{{traceDetail.displayBadge}} · #{{ui[traceDetail.seqLabel] !== undefined ? ui[traceDetail.seqLabel] : traceDetail.seqLabel}}</text><view bindtap="copyTraceDetail" role="button">{{ui['复制']}}{{ui[traceDetailSection.label] !== undefined ? ui[traceDetailSection.label] : traceDetailSection.label}}</view></view>
</view>
</view>
<view has:if="{{turnUsageOpen}}" class="turn-usage-mask" catchtap="closeTurnUsage" catchtouchmove="noop">
<view class="turn-usage-card {{turnUsagePos.placeBelow ? 'below' : 'above'}}" style="left:{{turnUsagePos.left}}px; top:{{turnUsagePos.top}}px; width:{{turnUsagePos.width}}px;" catchtap="noop" role="dialog" aria-label="{{ui['本轮用量']}}">
<view class="turn-usage-total">
<image class="turn-usage-ic" src="/assets/icons/{{theme === 'dark' ? 'token-usage-dark.svg' : 'token-usage.svg'}}" mode="aspectFit"/>
<text class="turn-usage-total-label">{{ui['本轮用量']}}</text>
<text class="turn-usage-total-value">{{turnUsageSheet.total}} tok</text>
</view>
<view class="turn-usage-rows">
<view has:if="{{turnUsageSheet.routes}}" class="turn-usage-row"><text class="turn-usage-label">{{ui['提供方 / 模型']}}</text><text class="turn-usage-value">{{turnUsageSheet.routes}}</text></view>
<view has:if="{{turnUsageSheet.cacheHit !== null}}" class="turn-usage-row"><text class="turn-usage-label">{{ui['缓存命中']}}</text><text class="turn-usage-value">{{turnUsageSheet.cacheHit}}%</text></view>
<view class="turn-usage-row"><text class="turn-usage-label">{{ui['未缓存输入']}}</text><text class="turn-usage-value">{{turnUsageSheet.uncached}} tok</text></view>
<view class="turn-usage-row"><text class="turn-usage-label">{{ui['缓存读取']}}</text><text class="turn-usage-value">{{turnUsageSheet.cacheRead}} tok</text></view>
<view class="turn-usage-row"><text class="turn-usage-label">{{ui['缓存写入']}}</text><text class="turn-usage-value">{{turnUsageSheet.cacheWrite}} tok</text></view>
<view class="turn-usage-row"><text class="turn-usage-label">{{ui['输出']}}</text><text class="turn-usage-value">{{turnUsageSheet.output}} tok</text></view>
</view>
</view>
</view>
<voice-overlay id="voice-overlay" visible="{{voiceOverlayVisible && tab === 'conversation'}}" theme="{{theme}}" cancel-armed="{{voiceCancelArmed}}" status="{{voiceStatus}}"/>
<public-access-dialog visible="{{publicAccessDialogOpen}}" dialog="{{publicAccessDialog}}" theme="{{theme}}" bindconfirm="onPublicAccessDialogConfirm"/>
</view>
