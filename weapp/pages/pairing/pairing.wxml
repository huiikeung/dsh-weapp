<view class="page page-dark pairing">
  <view class="deep-bg">
    <view class="deep-grid"></view>
    <image class="deep-whale" src="../../assets/icons/bg-whale.png" mode="aspectFit" />
  </view>
  <view class="hero">
    <view class="brand-row">
      <image class="brand-whale" src="/assets/icons/whale-white.png" mode="aspectFit"/>
      <view class="brand-text">deepseek</view>
      <view class="brand-badge">HARNESS</view>
    </view>
    <view class="title-hero">连接 DeepSeek Harness</view>
    <view class="subtitle-hero">扫描 WebUI 生成的配对二维码，或手动输入一次性配对信息</view>
  </view>

  <view class="actions">
    <view class="btn-glass glass-press" bindtap="scanQR">
      <text>扫描配对二维码</text>
    </view>
  </view>

  <view class="manual glass">
    <view class="manual-title">手动配对</view>
    <input
      class="field-dark input"
      placeholder="粘贴二维码内容（Base64URL）或完整配对信息"
      placeholder-class="field-placeholder"
      value="{{pairingPayload}}"
      bindinput="onPayloadInput"
      confirm-type="done"
    />
    <view class="btn-primary glass-press" bindtap="pairManual">连接</view>
  </view>

  <view class="hint">
    <view>1. 在 DeepSeek Harness 中启用 dsh-plugin-mobile-gateway</view>
    <view>2. 打开 WebUI「移动设备」面板并生成配对二维码</view>
    <view>3. 公网部署必须使用 wss:// 并启用设备鉴权</view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{statusText}}" class="status-text">{{statusText}}</view>

  <view class="btn-text restore" bindtap="restoreSaved">使用已保存的凭据重试</view>
</view>
