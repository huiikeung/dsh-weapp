border-top-color: #FFFFFF;
width: 38rpx;
height: 38rpx;
margin-right: 18rpx;
}
@keyframes dir-spin {
to {
transform: rotate(360deg);
}
}
.manual-sheet {
position: fixed;
left: 16rpx;
right: 16rpx;
bottom: 16rpx;
z-index: 62;
display: flex;
flex-direction: column;
height: auto;
max-height: 62vh;
background: rgba(10, 14, 24, 0.30);
border: 1rpx solid rgba(255, 255, 255, 0.12);
border-radius: 40rpx;
padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
backdrop-filter: blur(20rpx) saturate(1.2);
-webkit-backdrop-filter: blur(20rpx) saturate(1.2);
box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30);
transition: height 0.5s cubic-bezier(0.32, 0.72, 0, 1);
}
.manual-sheet.expanded {
height: calc(100vh - 200rpx);
max-height: none;
}
.manual-sheet-head {
position: relative;
display: flex;
align-items: center;
height: 96rpx;
flex-shrink: 0;
}
.manual-sheet-title {
position: absolute;
left: 0;
right: 0;
text-align: center;
font-size: 34rpx;
font-weight: 700;
color: #FFFFFF;
pointer-events: none;
}
.manual-sheet-done {
position: absolute;
right: 0;
top: 50%;
transform: translateY(-50%);
height: 60rpx;
padding: 0 22rpx;
border-radius: 999rpx;
background: rgba(255, 255, 255, 0.12);
border: 1rpx solid rgba(255, 255, 255, 0.20);
color: #FFFFFF;
display: flex;
align-items: center;
justify-content: center;
font-size: 26rpx;
font-weight: 500;
}
.manual-sheet-body {
flex: 1;
min-height: 0;
box-sizing: border-box;
padding: 44rpx;
}
.manual-sec-title {
font-size: 34rpx;
font-weight: 700;
color: #F1F4FA;
}
.manual-sec-desc {
font-size: 30rpx;
line-height: 1.5;
color: rgba(241, 244, 250, 0.52);
margin: 12rpx 0 44rpx;
}
.manual-input {
width: 100%;
min-height: 420rpx;
box-sizing: border-box;
background: rgba(6, 12, 24, 0.52);
border: 1rpx solid rgba(241, 244, 250, 0.16);
border-radius: 28rpx;
box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
padding: 30rpx;
font-size: 26rpx;
line-height: 1.5;
color: rgba(241, 244, 250, 0.92);
transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}
.manual-input.focused {
background: rgba(6, 12, 24, 0.68);
border-color: rgba(76, 140, 245, 0.85);
box-shadow: 0 0 0 5rpx rgba(46, 107, 230, 0.18), inset 0 2rpx 6rpx rgba(0, 0, 0, 0.30);
}
.manual-input-ph {
color: rgba(241, 244, 250, 0.34);
}
.manual-result {
margin-top: 24rpx;
font-size: 28rpx;
}
.manual-result.connecting {
color: var(--mist);
}
.manual-result.error {
color: #FF8589;
}
.manual-connect {
display: flex;
align-items: center;
justify-content: center;
width: 100%;
height: 96rpx;
border-radius: 999rpx;
background: linear-gradient(135deg, #5B95FF 0%, #2E6BE6 52%, #1E55C8 100%);
box-shadow: 0 14rpx 34rpx rgba(46, 107, 230, 0.42), inset 0 1rpx 0 rgba(255, 255, 255, 0.42);
margin-top: 44rpx;
font-size: 31rpx;
font-weight: 600;
letter-spacing: 2rpx;
color: #FFFFFF;
transition: transform 0.12s ease, opacity 0.12s ease;
}
.manual-connect-press {
transform: scale(0.985);
opacity: 0.9;
}
.manual-connect.disabled {
background: rgba(46, 107, 230, 0.28);
box-shadow: none;
color: rgba(255, 255, 255, 0.5);
}
.manual-connect-ic {
width: 36rpx;
height: 36rpx;
margin-right: 14rpx;
opacity: 0.95;
}
.small-spin {
width: 38rpx;
height: 38rpx;
border-width: 3rpx;
margin-right: 18rpx;
}
.pair-guide-icon { display: block; width: 36rpx; height: 36rpx; flex-shrink: 0; }
.deep-whale-swim {
position: absolute;
left: 50%;
top: 34%;
width: 880rpx;
height: 880rpx;
mix-blend-mode: screen;
pointer-events: none;
will-change: transform, opacity;
animation: whaleSwimCycle 16s ease-in-out infinite;
}
@keyframes whaleSwimCycle {
0%   { opacity: 1; transform: translate(-50%, -50%) translate3d(0, 0, 0) scale(1) rotate(0deg) skewX(0deg); }
12%  { opacity: 1; transform: translate(-50%, -50%) translate3d(-14rpx, -18rpx, 0) scale(1.02) rotate(-2.6deg) skewX(-1.6deg); }
25%  { opacity: 1; transform: translate(-50%, -50%) translate3d(10rpx, 16rpx, 0) scale(1.005) rotate(2.8deg) skewX(1.8deg); }
38%  { opacity: 1; transform: translate(-50%, -50%) translate3d(-8rpx, -14rpx, 0) scale(1.018) rotate(-2.2deg) skewX(-1.4deg); }
50%  { opacity: 1; transform: translate(-50%, -50%) translate3d(6rpx, 10rpx, 0) scale(1) rotate(2deg) skewX(1.2deg); }
62%  { opacity: 1; transform: translate(-50%, -50%) translate3d(-12rpx, -8rpx, 0) scale(1.015) rotate(-2.4deg) skewX(-1.2deg); }
75%  { opacity: 1; transform: translate(-50%, -50%) translate3d(8rpx, 14rpx, 0) scale(1.005) rotate(2.6deg) skewX(1.5deg); }
88%  { opacity: 1; transform: translate(-50%, -50%) translate3d(-6rpx, -10rpx, 0) scale(1.012) rotate(-1.8deg) skewX(-1deg); }
100% { opacity: 1; transform: translate(-50%, -50%) translate3d(0, 0, 0) scale(1) rotate(0deg) skewX(0deg); }
}
.field-placeholder {
color: rgba(255, 255, 255, 0.58);
}
.drawer.drawer-dark {
background: #141518;
}
.drawer-dark .drawer-item-text {
color: #F1F4FA;
}
.drawer-dark .drawer-item-active {
background: rgba(241, 244, 250, 0.08);
}
.drawer-dark .drawer-brand-badge {
color: #10151F;
background: #FFFFFF;
}
.drawer-dark .drawer-whale-light,
.drawer-dark .drawer-item-ic:not(.drawer-item-ic-dark) {
display: none;
}
.drawer-dark .drawer-whale-dark,
.drawer-dark .drawer-item-ic-dark {
display: block;
}
.workspace-card-menu-open {
visibility: hidden;
pointer-events: none;
}
.ws-pop-mask {
position: fixed;
left: 0;
top: 0;
right: 0;
bottom: 0;
z-index: 60;
background: transparent;
}
.ws-pop {
position: fixed;
z-index: 61;
box-sizing: border-box;
border-radius: 64rpx;
background: linear-gradient(145deg, rgba(173, 196, 229, 0.88), rgba(200, 212, 231, 0.83));
border: 1rpx solid rgba(235, 244, 255, 0.40);
box-shadow: 0 24rpx 72rpx rgba(4, 12, 28, 0.28), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.38);
backdrop-filter: blur(48rpx) saturate(1.25);
-webkit-backdrop-filter: blur(48rpx) saturate(1.25);
overflow: hidden;
animation: ws-pop-appear 180ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
.ws-pop.workspace-menu {
background: linear-gradient(165deg, rgba(255, 255, 255, var(--glass-alpha-top, 0.10)), rgba(255, 255, 255, var(--glass-alpha-bottom, 0.04)));
border: 1rpx solid rgba(255, 255, 255, 0.38);
box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 24rpx 72rpx rgba(3, 14, 30, 0.26);
backdrop-filter: blur(8rpx);
-webkit-backdrop-filter: blur(8rpx);
}
.ws-pop.workspace-menu .ws-pop-label {
color: #FFFFFF;
}
.ws-pop.workspace-menu .ws-pop-row-pressed {
background: rgba(255, 255, 255, 0.10);
}
.ws-pop.workspace-menu .ws-pop-divider {
background: rgba(255, 255, 255, 0.14);
}
.ws-pop-scroll {
height: 100%;
}
.ws-pop-content {
padding: 16rpx 0;
}
.ws-pop-row {
display: flex;
align-items: center;
gap: 24rpx;
height: 84rpx;
min-height: 44px;
padding: 0 48rpx;
box-sizing: border-box;
}
.ws-pop-row-pressed {
background: rgba(16, 19, 26, 0.06);
}
.ws-pop-ic {
width: 36rpx;
height: 36rpx;
flex-shrink: 0;
}
.ws-pop-ic-tray {
transform: scaleX(1.12);
}
.ws-pop-stack {
position: relative;
}
.ws-pop-stack-top,
.ws-pop-stack-back {
position: absolute;
left: 50%;
transform: translateX(-50%);
height: 3rpx;
border-radius: 1.5rpx;
background: rgba(255, 255, 255, 0.95);
}
.ws-pop-stack-top {
top: 1rpx;
width: 12rpx;
}
.ws-pop-stack-back {
top: 6rpx;
width: 18rpx;
}
.ws-pop-stack-front {
position: absolute;
left: 50%;
top: 11rpx;
transform: translateX(-50%);
width: 24rpx;
height: 24rpx;
box-sizing: border-box;
border: 3rpx solid rgba(255, 255, 255, 0.95);
border-radius: 5rpx;
}
.ws-pop-row-danger .ws-pop-label {
color: #FF3B30;
}
.ws-pop-label {
font-size: 32rpx;
color: #10131A;
min-width: 0;
flex: 1;
line-height: 1.3;
overflow: hidden;
white-space: nowrap;
text-overflow: ellipsis;
}
.ws-pop.session-menu {
background: linear-gradient(165deg, rgba(255, 255, 255, var(--glass-alpha-top, 0.10)), rgba(255, 255, 255, var(--glass-alpha-bottom, 0.04)));
border: 1rpx solid rgba(255, 255, 255, 0.38);
box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 24rpx 72rpx rgba(3, 14, 30, 0.26);
backdrop-filter: blur(8rpx);
-webkit-backdrop-filter: blur(8rpx);
}
.ws-pop.session-menu .ws-pop-divider {
background: rgba(255, 255, 255, 0.14);
}
.session-menu .ws-pop-label {
font-size: 28rpx;
color: #F1F4FA;
}
.session-menu .ws-pop-row-pressed {
background: rgba(255, 255, 255, 0.08);
}
.session-menu .ws-pop-row-danger .ws-pop-label {
color: #FF3B30;
}
.ws-pop-divider {
height: 1rpx;
margin: 12rpx 44rpx;
background: rgba(25, 49, 78, 0.12);
}
@keyframes ws-pop-appear {
from { opacity: 0; transform: scale(0.92); }
to { opacity: 1; transform: scale(1); }
}
@media (prefers-reduced-motion: reduce) {
.ws-pop { animation: none; }
}
.drawer .drawer-item-text {
color: #10131A;
}
.drawer.drawer-dark .drawer-item-text {
color: #F1F4FA;
}
.brand-wordmark {
width: 168.75rpx;
height: auto;
margin-right: 18rpx;
flex: none;
display: block;
}
.drawer .drawer-wordmark-light {
display: block;
}
.drawer .drawer-wordmark-dark {
display: none;
}
.drawer.drawer-dark .drawer-wordmark-light {
display: none;
}
.drawer.drawer-dark .drawer-wordmark-dark {
display: block;
}
.host-confirm-mask {
position: fixed;
inset: 0;
z-index: 220;
display: flex;
align-items: flex-end;
background: rgba(0, 0, 0, 0.46);
}
.host-confirm {
width: calc(100% - 32rpx);
margin: 0 16rpx 16rpx;
box-sizing: border-box;
padding: 16rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
border-radius: 36rpx;
background: rgba(16, 22, 34, 0.94);
border: 1rpx solid rgba(255, 255, 255, 0.14);
backdrop-filter: blur(28rpx) saturate(1.2);
-webkit-backdrop-filter: blur(28rpx) saturate(1.2);
color: #F1F4FA;
display: flex;
flex-direction: column;
box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.45);
animation: hostConfirmRise 0.2s ease-out;
}
@keyframes hostConfirmRise {
from { transform: translateY(24rpx); opacity: 0.6; }
to { transform: translateY(0); opacity: 1; }
}
.host-confirm-title {
margin: 12rpx 0 8rpx;
font-size: 34rpx;
font-weight: 650;
text-align: center;
}
.host-confirm-names {
margin: 4rpx auto 0;
max-width: 100%;
font-size: 25rpx;
color: rgba(241, 244, 250, 0.6);
text-align: center;
overflow: hidden;
text-overflow: ellipsis;
white-space: nowrap;
}
.host-confirm-body {
margin: 16rpx auto 32rpx;
max-width: 560rpx;
font-size: 26rpx;
line-height: 1.65;
color: rgba(241, 244, 250, 0.66);
text-align: center;
}
.host-confirm-actions {
display: flex;
gap: 20rpx;
}
.host-confirm-cancel,
.host-confirm-ok {
flex: 1;
min-height: 92rpx;
border-radius: 999rpx;
display: flex;
align-items: center;
justify-content: center;
font-size: 29rpx;
font-weight: 600;
}
.host-confirm-cancel {
background: rgba(241, 244, 250, 0.10);
color: #F1F4FA;
}
.host-confirm-ok {
background: linear-gradient(135deg, #F0565B, #D93A41);
color: #FFFFFF;
box-shadow: 0 10rpx 24rpx rgba(217, 58, 65, 0.3);
}
