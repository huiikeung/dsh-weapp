/* 插件页（对齐 dsh-mobile PluginsView） */

.plugins {
  --pg-bg: #FFFFFF;
  --pg-text: #000000;
  --pg-text2: rgba(60, 60, 67, 0.6);
  --pg-fallback: #E5E5EA;
  --pg-badge-text: #0034DB;
  --pg-badge-bg: rgba(0, 0, 255, 0.1);
  --pg-divider: rgba(60, 60, 67, 0.12);
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--pg-bg);
  color: var(--pg-text);
}

.plugins.theme-dark {
  --pg-bg: #000000;
  --pg-text: #FFFFFF;
  --pg-text2: rgba(235, 235, 245, 0.6);
  --pg-fallback: #3A3A3C;
  --pg-badge-text: #8CADFF;
  --pg-badge-bg: rgba(0, 0, 255, 0.2);
}

/* ---------- 头部 ---------- */

.plugins-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx 24rpx;
  flex-shrink: 0;
}

.plugins-back {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--pg-bg);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plugins.theme-dark .plugins-back {
  border-color: rgba(255, 255, 255, 0.10);
}

.sched-back-hover {
  opacity: 0.7;
}

.plugins-back-ic {
  width: 36rpx;
  height: 36rpx;
}

.plugins-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--pg-text);
}

.plugins-refresh {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plugins-refresh.disabled {
  opacity: 0.4;
}

.plugins-refresh-ic {
  width: 40rpx;
  height: 40rpx;
}

.brand-dim {
  opacity: 0.6;
}

/* ---------- 列表 ---------- */

.plugins-scroll {
  flex: 1;
  min-height: 0;
}

.plugins-body {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 52rpx;
}

.plugins-hint {
  font-size: 30rpx;
  color: var(--pg-text2);
}

.plugins-warn {
  font-size: 30rpx;
  color: #FF9500;
}

.plugins-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 0;
}

.plugins-state-ic {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
}

.plugins-state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--pg-text);
  text-align: center;
}

.plugins-state-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--pg-text2);
}

.plugins-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid rgba(120, 120, 128, 0.24);
  border-top-color: var(--pg-text2);
  border-radius: 50%;
  animation: plugins-spin 0.8s linear infinite;
}

.plugins-spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 3rpx;
}

@keyframes plugins-spin {
  to { transform: rotate(360deg); }
}

/* ---------- 分组与行 ---------- */

.plugin-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plugin-section-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.plugin-section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--pg-text);
}

.plugin-section-count {
  font-size: 30rpx;
  color: var(--pg-text2);
}

.plugin-row {
  display: flex;
  align-items: center;
  min-height: 136rpx;
  gap: 8rpx;
}

.plugin-line {
  display: flex;
  align-items: center;
  gap: 26rpx;
  flex: 1;
  min-width: 0;
}

.plugin-line-hover {
  opacity: 0.65;
}

.plugin-icon {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.plugin-icon-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
}

.plugin-icon-fallback {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: var(--pg-fallback);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plugin-icon-fallback text {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--pg-text);
  text-transform: uppercase;
}

.plugin-line-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.plugin-line-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.plugin-line-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--pg-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plugin-badge {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--pg-badge-text);
  background: var(--pg-badge-bg);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.plugin-line-sub {
  font-size: 26rpx;
  color: var(--pg-text2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.plugin-chev {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.plugin-switch {
  flex-shrink: 0;
  transform: scale(0.86);
  transform-origin: right center;
}
