}
.nav-title-inner {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.nav-preset {
  gap: 8rpx;
  margin: 0 4rpx 0 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}
.nav-more {
  width: 56rpx;
