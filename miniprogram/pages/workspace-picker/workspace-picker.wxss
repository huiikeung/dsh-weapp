/* 工作区目录选择页 —— 对齐 dsh-mobile WorkspaceFilesBottomSheet 版式
   头部（上一级/标题/取消）+ 路径栏 + 扁平列表 + 底部创建栏 */

.wp {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ===== 头部 ===== */
.wp-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 108rpx;
  padding: 0 24rpx;
}

.wp-back {
  position: absolute;
  left: 24rpx;
  top: 0;
  height: 108rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--text);
}

.wp-back-ph {
  position: absolute;
  left: 24rpx;
  width: 120rpx;
}

.wp-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.wp-done {
  position: absolute;
  right: 24rpx;
  height: 76rpx;
  padding: 0 36rpx;
  border-radius: 38rpx;
  background: var(--surface);
  box-shadow: var(--float-shadow);
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
}

/* ===== 路径栏 ===== */
.wp-pathbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 40rpx;
}

.wp-path-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.wp-path {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  color: var(--text-2);
}

.wp-bar-divider {
  height: 1px;
  background: var(--divider);
  margin: 0 24rpx;
}

/* ===== 列表 ===== */
.wp-list {
  flex: 1;
  min-height: 0;
}

.wp-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx;
}

.wp-center-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--text-3);
}

.wp-row {
  display: flex;
  align-items: center;
  min-height: 144rpx;
  padding: 20rpx 24rpx 20rpx 44rpx;
  border-radius: 24rpx;
}

.wp-row-hover {
  background: rgba(16, 19, 26, 0.04);
}

.theme-dark .wp-row-hover {
  background: rgba(241, 244, 250, 0.06);
}

.wp-row.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.wp-row.highlight {
  background: rgba(46, 107, 230, 0.18);
}

.wp-row-icon-wrap {
  position: relative;
  width: 68rpx;
  flex-shrink: 0;
}

.wp-row-icon {
  width: 50rpx;
  height: 50rpx;
}

.wp-row-badge {
  position: absolute;
  right: 2rpx;
  top: -8rpx;
  width: 26rpx;
  height: 26rpx;
}

.wp-row-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.wp-row-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.wp-row-sub {
  font-size: 24rpx;
  color: var(--text-3);
}

.wp-row-chev {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.wp-divider {
  height: 1px;
  background: var(--divider);
  margin-left: 134rpx;
}

.wp-list-spacer {
  height: env(safe-area-inset-bottom);
}

/* ===== 底部创建栏 ===== */
.wp-bottom {
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.wp-bottom-path {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.wp-bottom-btns {
  display: flex;
  gap: 18rpx;
}

/* 新建文件夹：次级按钮 */
.wp-btn-new {
  flex: 1;
  height: 100rpx;
  border-radius: 28rpx;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
}

.wp-btn-new.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 创建工作区：黑色主按钮 */
.wp-btn-create {
  flex: 2;
  height: 100rpx;
  border-radius: 28rpx;
  background: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.wp-btn-create.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.wp-btn-add {
  width: 32rpx;
  height: 32rpx;
}

/* ===== Spinner ===== */
.wp-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid rgba(120, 120, 128, 0.28);
  border-top-color: var(--ocean);
  border-radius: 50%;
  animation: wp-spin 0.8s linear infinite;
  flex-shrink: 0;
}

.wp-spinner.large {
  width: 44rpx;
  height: 44rpx;
  border-width: 4rpx;
}

.wp-spinner.light {
  border-color: rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
}

@keyframes wp-spin {
  to {
    transform: rotate(360deg);
  }
}
