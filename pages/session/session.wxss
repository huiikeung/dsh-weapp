  margin-right: 0;
  flex: 0 0 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border-strong);
  border-radius: 50%;
  background: var(--surface);
  box-shadow: 0 4rpx 14rpx rgba(7, 24, 43, 0.08);
}

.theme-dark .segmented-row .nav-more {
  background: rgba(255,255,255,0.08);
  box-shadow: none;
}

.nav-back {
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.nav-back-ic {
  width: 36rpx;
  height: 36rpx;
}

.nav-title {
  min-width: 0;
  margin: 0;
  text-align: center;
}

.nav-title-inner {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.nav-preset {
  gap: 8rpx;
  margin: 0 4rpx 0 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.nav-more {
  width: 56rpx;
  height: 56rpx;
  background: transparent;
  border: 0;
  border-radius: 50%;
  box-shadow: none;
}

.segmented-row {
  padding: 12rpx 132rpx;
}

.segmented {
  height: 64rpx;
  padding: 4rpx;
  border-radius: 18rpx;
  background: var(--fill-2);
}

.segment {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 15rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.segment.active {
  background: var(--surface);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.12);
}

.conversation,
.trajectory {
  padding: 16rpx 40rpx 0;
  background: transparent;
}

.conversation,
.trajectory {
  padding-bottom: 330rpx;
}

.segmented {
  border-radius: 999rpx;
}
.segment {
  border-radius: 999rpx;
}

.row-user {
  gap: 0;
  padding: 24rpx 0 24rpx 68rpx;
}

.row-user-bubble {
  max-width: 100%;
  border-radius: 30rpx;
  padding: 20rpx 28rpx;
  background: rgba(46, 107, 230, 0.11);
  border: 1.4rpx solid rgba(46, 107, 230, 0.08);
}

.theme-dark .row-user-bubble {
  background: rgba(46, 107, 230, 0.24);
  border-color: rgba(46, 107, 230, 0.34);
}

.user-image-single,
.user-image-stack {
  position: relative;
  max-width: 100%;
  overflow: visible;
  margin-bottom: 16rpx;
}

.user-image-single {
  width: min(640rpx, calc(100vw - 148rpx));
  height: 640rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: var(--fill);
}

.user-image-one {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
}

.user-image-stack {
  flex-shrink: 0;
}

.user-image-card {
  position: absolute;
  box-sizing: border-box;
  border: 4rpx solid var(--bg);
  border-radius: 36rpx;
  background: var(--fill);
}

.user-image-count {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  z-index: 5;
  padding: 4rpx 12rpx;
  border-radius: 24rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.58);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.row-user-text {
  font-size: 34rpx;
  line-height: 1.42;
}

.row-assistant {
  padding: 30rpx 0;
}

.row-status {
  padding: 12rpx 0;
}

.row-event {
  margin: 0;
  padding: 20rpx;
}

.event-text {
  font-size: 24rpx;
  color: var(--text-2);
  white-space: normal;
  overflow: visible;
}

.process-block {
  margin: 0;
}

.progress-strip {
  margin-top: 16rpx;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 500;
  color: transparent;
  background-image: linear-gradient(100deg, #18365A 0%, #18365A 38%, #5B7FA9 50%, #18365A 62%, #18365A 100%);
  background-size: 220% 100%;
  background-repeat: no-repeat;
  -webkit-background-clip: text;
  background-clip: text;
  animation: runShimmer 2.2s linear infinite;
}
.theme-dark .progress-text {
  background-image: linear-gradient(100deg, #A8BEDB 0%, #A8BEDB 38%, #D5E3F4 50%, #A8BEDB 62%, #A8BEDB 100%);
}

/* 系统材质渐隐层：只覆盖 composer 后方，不拦截滚动或点击 */
.composer-backdrop {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 320rpx;
  z-index: 50;
  pointer-events: none;
  background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0.72) 42%, var(--bg) 78%);
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
}

.theme-dark .composer-backdrop {
  background: linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,0.74) 42%, #000000 78%);
}

.dock-stack {
  left: 28rpx;
  right: 28rpx;
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  z-index: 60;
}

.composer-top-row {
  position: relative;
  z-index: 2;
  justify-content: flex-start;
  gap: 16rpx;
  margin: 0 0 12rpx;
  padding: 0 28rpx;
}

.preset-capsule,
.stats-pill {
  box-shadow: none;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.preset-capsule {
  border-radius: 32rpx;
}

.stats-pill {
  margin-left: auto;
}

.queue-dock {
  position: relative;
  z-index: 2;
}

.composer {
  z-index: 2;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 48rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.10);
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.10);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.theme-dark .composer {
  border-color: rgba(255, 255, 255, 0.13);
  background: rgba(28, 28, 30, 0.88);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.34);
}

/* DSH composer footer：轮次/步骤、Token/缓存、上下文均位于输入卡下方 */
.composer-metrics {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  gap: 20rpx;
  padding: 12rpx 18rpx 0;
  color: var(--text-2);
  box-sizing: border-box;
}

.composer-metric {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 6rpx;
  opacity: 0.78;
}

.composer-metric.run,
.composer-metric.context {
  flex-shrink: 0;
}

.composer-metric.token {
  flex: 0 0 auto;
  justify-content: flex-start;
}

.composer-metric-text,
.composer-metric-dot {
  color: var(--text-2);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: 0;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.composer-metric-dot {
  margin: 0 -2rpx;
}

.metric-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  opacity: 0.92;
}

.metric-storage {
  width: 28rpx;
  height: 28rpx;
}

.theme-dark .metric-icon {
  filter: brightness(0) invert(1);
  opacity: 0.82;
}

.metric-context-ring {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  padding: 5rpx;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.metric-context-in {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--bg);
}

@media (max-width: 350px) {
  .composer-metrics {
    gap: 20rpx;
    padding-left: 10rpx;
    padding-right: 10rpx;
  }

  .composer-metric { gap: 5rpx; }
  .composer-metric-text,
  .composer-metric-dot { font-size: 24rpx; }
}

.composer-input {
  min-height: 76rpx;
  max-height: 320rpx;
  font-size: 34rpx;
  line-height: 1.35;
}

.composer-placeholder {
  font-size: 28rpx;
  color: rgba(16, 19, 24, 0.28) !important;
}

.theme-dark .composer-placeholder {
  color: rgba(241, 244, 250, 0.36) !important;
}

.composer-bar {
  gap: 14rpx;
  margin-top: 24rpx;
}

.chip {
  padding: 6rpx 0;
  margin: 0;
  font-size: 24rpx;
}

.chip.icon {
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid var(--border-strong);
}

.send-btn {
  width: 84rpx;
  height: 84rpx;
}

.stop-square {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
}

.conv-empty,
.conv-state {
  box-sizing: border-box;
  justify-content: center;
  min-height: calc(100vh - 420rpx);
  padding: 0 56rpx 180rpx;
  gap: 28rpx;
  text-align: center;
}

.conv-empty-logo {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  display: block;
  margin: 0;
}

.conv-empty-title {
  font-size: 40rpx;
  font-weight: 600;
}

.conv-empty-desc {
  font-size: 30rpx;
  line-height: 1.45;
}

.state-sub {
  max-width: 100%;
  line-height: 1.45;
  text-align: center;
}

.state-spinner {
  width: 56rpx;
  height: 56rpx;
  border-width: 5rpx;
}

.state-btn {
  margin-top: 0;
  border-radius: 16rpx;
  padding: 14rpx 28rpx;
}

/* Final session navigation alignment: leave the native capsule safe area clear. */
.navbar {
  grid-template-columns: 64rpx minmax(0, 1fr) minmax(0, auto);
  padding-right: 0;
  box-sizing: border-box;
}
.nav-title {
  min-width: 0;
  text-align: left;
  overflow: hidden;
}
.nav-title-inner {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}
.nav-preset {
  min-width: 0;
  max-width: 250rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  overflow: hidden;
}
.nav-preset text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
@media (prefers-reduced-motion: reduce) {
  .run-tail-sprite,
