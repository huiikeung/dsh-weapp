.picker {
  padding: 40rpx;
}

.picker-title {
  margin-bottom: 30rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
}

.row-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-title {
  color: var(--text);
  font-size: 32rpx;
  font-weight: 500;
}

.row-path {
  color: var(--text-3);
  font-size: 24rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-check {
  width: 36rpx;
  height: 36rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.empty {
  color: var(--text-4);
  text-align: center;
  padding: 60rpx 0;
}

.new-workspace {
  margin-top: 50rpx;
}

/* 浅色下的玻璃按钮覆盖（深色沿用 app.wxss 白色透明样式） */
.picker .btn-glass {
  background: var(--fill-2);
  border: 1rpx solid var(--border-strong);
  color: var(--text);
}
