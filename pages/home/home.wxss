}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.conn-label {
  font-size: 26rpx;
}

.conn-label.connected { color: var(--success); }
.conn-label.connecting { color: var(--amber); }
.conn-label.disconnected { color: var(--gray); }
.conn-label.failed { color: #FF8589; }

.search-box {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-result-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

/* 配对按钮：对齐 dsh-mobile GlassCircleButton 52dp/22dp 比例 */
