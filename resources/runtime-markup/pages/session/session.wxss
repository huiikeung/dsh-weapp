@import "../../styles/status-appearance.wxss";
@import "../../styles/trajectory.wxss";
@import "../../styles/proc-icon.wxss";
.session {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}
/* Keep mounted lists and the draft intact; flex layouts must also honor hidden. */
.session-panel-hidden { display: none !important; }
/* ---------- 椤堕儴瀵艰埅 ---------- */
.navbar {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx;
  flex-shrink: 0;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 4rpx 14rpx rgba(7, 24, 43, 0.06);
}
.session.theme-dark .nav-back {
  background: rgba(255, 255, 255, 0.10);
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: none;
}
.nav-back-ic {
  width: 32rpx;
  height: 32rpx;
}
.press-dim {
  opacity: 0.65;
}
.nav-more {
  width: 64rpx;
  height: 64rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 16rpx rgba(7, 24, 43, 0.08);
  flex-shrink: 0;
}
.nav-title {
  flex: 1;
  margin: 0 20rpx;
  overflow: hidden;
  white-space: nowrap;
}
.nav-title-inner {
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;   /* 涓庡璇?杞ㄨ抗鍒囨崲瀛楀彿涓€鑷?*/
  font-weight: 600;
  color: var(--ink);
  vertical-align: middle;
}
.nav-preset {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--gray);
  margin-right: 16rpx;
  flex-shrink: 0;
}
/* ---------- 瀵硅瘽/杞ㄨ抗 鍒嗘鎺т欢 + 鏇村锛堝悓琛岋級 ---------- */
.segmented-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 40rpx 12rpx;
  flex-shrink: 0;
}
.segmented {
  display: flex;
  flex: 1;
  min-width: 0;
  border-radius: 28rpx;
  padding: 3rpx;
  background: var(--fill-2);
}
.segment {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 25rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.segment.active {
  background: var(--segment-active-bg);
  color: var(--segment-active-text);
  font-weight: 600;
}
/* Keep collaboration beside the view switcher; never reserve a second toolbar. */
.collab-trigger { display:flex;align-items:center;justify-content:center;gap:8rpx;min-height:88rpx;max-width:190rpx;flex-shrink:0;font-size:24rpx;color:var(--text-2);position:relative; }
.collab-trigger.selected { color:var(--ink); }
.collab-icon { width:30rpx;height:30rpx;flex-shrink:0; }
.collab-count { min-width:24rpx;font-size:22rpx;text-align:center;max-width:56rpx;overflow:hidden;text-overflow:ellipsis; }
.collab-active-dot { width:10rpx;height:10rpx;border-radius:50%;background:#358A68;flex-shrink:0; }
.collab-mask { z-index:120; }
.sheet.collab-sheet { display:flex;flex-direction:column;height:76vh;max-height:90vh;padding:0 0 env(safe-area-inset-bottom);background:var(--surface);color:var(--ink);transition:height 220ms ease; }
.sheet.collab-sheet.is-expanded { height:90vh; }
.collab-resize-handle { display:flex;align-items:center;justify-content:center;align-self:center;width:180rpx;min-height:40rpx;padding:4rpx 0;flex-shrink:0; }
.collab-resize-handle .sheet-handle { height:8rpx;margin:0;flex-shrink:0; }
@media (prefers-reduced-motion:reduce) { .sheet.collab-sheet { transition:none; } }
.collab-heading { display:flex;align-items:center;gap:0;padding:0 20rpx 32rpx 32rpx;flex-shrink:0; }
.collab-title { flex:1;min-width:0;font-size:34rpx;font-weight:600; }
.collab-action { width:88rpx;height:88rpx;min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.collab-action-disc { width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--fill); }
.collab-action-icon { width:34rpx;height:34rpx;display:block; }
/* 呼吸灯：替代右上角刷新图标，点按仍触发刷新；连线时常绿、断开置灰、刷新中加速 */
.collab-breathe { position:relative;width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center; }
.collab-breathe-dot { width:16rpx;height:16rpx;border-radius:50%;background:var(--success);animation:collab-breathe-dot 2.4s ease-in-out infinite; }
.collab-breathe-halo { position:absolute;width:16rpx;height:16rpx;border-radius:50%;background:var(--success);opacity:0;animation:collab-breathe-halo 2.4s ease-out infinite; }
.collab-refresh.offline .collab-breathe-dot,.collab-refresh.offline .collab-breathe-halo { background:var(--text-4); }
.collab-refresh.is-idle .collab-breathe-dot { background:var(--text-4);animation:none; }
.collab-refresh.is-idle .collab-breathe-halo { opacity:0;animation:none; }
.collab-refresh.busy { opacity:.55; }
.collab-refresh.busy.is-running .collab-breathe-dot,.collab-refresh.busy.is-running .collab-breathe-halo { animation-duration:.9s; }
@keyframes collab-breathe-dot { 0%,100%{transform:scale(.78);opacity:.72} 50%{transform:scale(1);opacity:1} }
@keyframes collab-breathe-halo { 0%{transform:scale(.7);opacity:.45} 70%,100%{transform:scale(2);opacity:0} }
.collab-tabs { margin:0;flex-shrink:0;border-bottom:1rpx solid var(--divider); white-space:nowrap; overflow:hidden; }
/* 默认一屏正好显示 4 个标签，两端对齐；更多标签横向滑动查看。
   两端 28rpx 缩进放在可滚动轨道上（而不是 scroll-view 的 margin）：
   左滑到底时右侧由轨道 padding 保证同样的 28rpx，四个标签两端距离始终一致。 */
.collab-tabs-track { display:flex; gap:0; align-items:stretch; width:max-content; padding:0 28rpx; box-sizing:border-box; }
.collab-tab { position:relative;display:flex;flex:0 0 calc((750rpx - 56rpx) / 4);min-width:0;min-height:44px;box-sizing:border-box;padding:12rpx 4rpx 20rpx;align-items:center;justify-content:center;flex-direction:column;gap:10rpx;font-size:24rpx;line-height:1.4;color:var(--text-2); }
.collab-tab.active { color:var(--ink);font-weight:600; }
.collab-tab-summary { display:flex;align-items:center;justify-content:center;gap:10rpx;max-width:100%;height:34rpx; }
.collab-tab-icon { width:32rpx;height:32rpx;flex-shrink:0; }
.collab-tab.active .collab-tab-icon { filter:brightness(0); }
.theme-dark .collab-tab.active .collab-tab-icon { filter:brightness(0) invert(.95); }
.collab-tab-count { min-width:24rpx;max-width:70rpx;box-sizing:border-box;padding:0 8rpx;border-radius:8rpx;background:var(--fill);font-size:20rpx;font-weight:500;line-height:30rpx;text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.collab-tab.active .collab-tab-count { background:var(--fill-2); }
.collab-tab-label { max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.collab-tab-indicator { position:absolute;bottom:-1rpx;left:50%;width:32rpx;height:4rpx;border-radius:4rpx;background:var(--ink);transform:translateX(-50%);opacity:0;transition:opacity 150ms ease; }
.collab-tab.active .collab-tab-indicator { opacity:1; }
@media (prefers-reduced-motion:reduce) { .collab-breathe-dot,.collab-breathe-halo { animation:none; }.collab-breathe-halo{opacity:0}.collab-tab-indicator { transition:none; } }
.collab-scroll { flex:1;height:0;min-height:0; }
.collab-list,.collab-preview { padding:28rpx 28rpx 48rpx; }
.collab-note { font-size:23rpx;line-height:1.6;color:var(--text-2);margin:12rpx 4rpx 28rpx;overflow-wrap:anywhere; }
.collab-row { display:flex;align-items:center;gap:20rpx;padding:28rpx 22rpx;min-height:104rpx;box-sizing:border-box;border:1rpx solid var(--border);border-radius:22rpx;margin-bottom:24rpx;background:var(--surface); }
.collab-row.current { background:var(--fill-2); }
.collab-row-copy { flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx; }
.collab-row-title { font-size:27rpx;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.collab-subtitle { font-size:23rpx;color:var(--text-2);line-height:1.5;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow-wrap:anywhere; }
.collab-row-meta { display:flex;flex-direction:column;gap:6rpx;align-items:flex-end;max-width:140rpx;flex-shrink:0; }
.collab-status,.collab-current { font-size:22rpx;color:var(--text-2); }
.collab-state { width:12rpx;height:12rpx;border-radius:50%;background:var(--text-2);opacity:.7;flex-shrink:0; }
.collab-state.running,.collab-state.done { background:#358A68;opacity:1; }
.collab-state.failed { background:#E5484D;opacity:1; }
.collab-state.pending { background:#C28220;opacity:1; }
.collab-status.running { color:#287750; }.collab-status.failed,.collab-error { color:#C53E48; }
.collab-error { font-size:23rpx;line-height:1.5;overflow-wrap:anywhere; }
.collab-chevron { width:10rpx;height:10rpx;border-top:2rpx solid var(--text-2);border-right:2rpx solid var(--text-2);transform:rotate(45deg);flex-shrink:0; }
.collab-empty { padding:60rpx 20rpx;text-align:center;color:var(--text-2);font-size:26rpx; }
.collab-back { min-height:88rpx;display:flex;align-items:center;color:var(--text-2);font-size:26rpx; }
.collab-preview-title { font-size:30rpx;font-weight:600;overflow-wrap:anywhere;margin-bottom:16rpx; }
.collab-message { padding:32rpx 0;border-bottom:1rpx solid var(--border); }
.collab-section-label { display:block;font-size:23rpx;color:var(--text-2);margin:16rpx 0; }
.collab-message-text { display:block;font-size:27rpx;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere; }
.collab-task-meta { margin:24rpx 0;color:var(--text-2);font-size:24rpx; }
.theme-dark .collab-status.failed,.theme-dark .collab-error { color:#FF7178; }
.theme-dark .collab-status.running { color:#73C7A0; }
@media (max-width:350px) { .segmented-row { padding-left:24rpx;padding-right:24rpx;gap:12rpx; }.collab-trigger { gap:6rpx; }.collab-tab { font-size:22rpx; } }
/* ---------- 瀵硅瘽 ---------- */
/* 闅愯棌婊氬姩鏉★細瀵硅瘽 / 杞ㄨ抗鍙繚鐣欐墜鍔挎粴鍔紝涓嶆樉绀烘粦鍧?
   锛坰croll-view 鐨?show-scrollbar 鍦ㄩ儴鍒嗗钩鍙颁笉鐢熸晥锛岃繖閲屽啀鍏滀竴灞傦級 */
.conversation::-webkit-scrollbar,
.trajectory::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}
.conversation,
.trajectory {
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.conversation,
.trajectory {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 16rpx 40rpx 0;   /* iOS锛歷iewport .padding(.horizontal, 20) .padding(.top, 8) */
}
/* ChatLayout 鍚屾锛氬唴瀹逛笉瓒充竴灞忔椂璐磋繎杈撳叆鍖猴紝鑰屼笉鏄妸鍓╀綑楂樺害
   鍏ㄧ暀鍦ㄦ渶鍚庝竴鏉℃秷鎭笅鏂癸紱瓒呰繃涓€灞忓悗浠嶆寜鑷劧楂樺害婊氬姩銆?*/
.conversation-inner {
  display: flex;
  flex-direction: column;
}
.conversation-inner.has-rows {
  box-sizing: border-box;
  justify-content: flex-end;
}
/* Reserve space OUTSIDE the native scroll viewport, so no row can enter the mask. */
.conversation-inner > view { flex-shrink: 0; }
.conversation { height: 0; overflow: hidden; }
/* 搴曢儴鏍堝浐瀹氬悗锛屽垪琛ㄩ鐣欑┖闂达細鑳跺泭琛?+ 杈撳叆鍗?+ 婊氬埌搴曟寜閽殑瀹屾暣楂樺害 */
.conversation,
.trajectory {
  padding-bottom: 330rpx;
}
.task-panel,
.goal-panel,
.command-menu {
  position: relative;
  z-index: 2;
  margin: 0 0 12rpx;
  border: 1rpx solid var(--border-strong);
  background: var(--surface);
  box-shadow: 0 8rpx 24rpx rgba(7, 24, 43, 0.08);
}
.task-panel,
.goal-panel {
  border-radius: 36rpx;
}
.task-head {
  min-height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.task-head-ic, .goal-ic { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.task-head-title, .goal-phase { font-size: 29rpx; font-weight: 650; color: var(--text); }
.task-summary { font-size: 25rpx; color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.task-chev { width: 26rpx; height: 26rpx; transition: transform .18s ease; }
.task-chev.open { transform: rotate(180deg); }
.task-list { padding: 0 28rpx 24rpx; }
.task-row { display: flex; align-items: flex-start; gap: 18rpx; padding: 10rpx 0; }
.task-status-ic { width: 32rpx; height: 32rpx; margin-top: 3rpx; flex-shrink: 0; }
.task-status-ic.spin, .goal-spinner { animation: state-spin .9s linear infinite; }
.task-content { font-size: 29rpx; line-height: 1.45; color: var(--text); }
.task-row.completed .task-content { color: var(--text-2); }
.goal-panel { min-height: 92rpx; padding: 0 24rpx 0 28rpx; display: flex; align-items: center; gap: 16rpx; }
.goal-main { display: flex; min-width: 0; flex: 1; align-items: baseline; gap: 16rpx; }
.goal-phase { flex-shrink: 0; }
.goal-objective { min-width: 0; font-size: 28rpx; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goal-action { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.goal-action-ic { width: 36rpx; height: 36rpx; }
.goal-spinner { width: 30rpx; height: 30rpx; border: 4rpx solid rgba(46,107,230,.18); border-top-color: #2E6BE6; border-radius: 50%; }
.command-menu-mask{position:fixed;inset:0;z-index:30;background:transparent}
.command-menu{z-index:31;border-radius:12px;border-color:var(--border);padding:4px;box-sizing:border-box;overflow:hidden;max-height:52vh;display:flex;flex-direction:column}
.file-mention-menu{position:relative;z-index:32;margin:0 12rpx 14rpx;border:1rpx solid var(--border-strong);border-radius:24rpx;background:var(--surface);box-shadow:0 12rpx 36rpx rgba(7,24,43,.18);overflow:hidden;max-height:54vh;display:flex;flex-direction:column}
.file-mention-head{min-height:76rpx;padding:16rpx 20rpx 12rpx 26rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx;border-bottom:1rpx solid var(--divider);flex-shrink:0}
.file-mention-heading{min-width:0;display:flex;flex-direction:column;gap:3rpx}
.file-mention-title{font-size:25rpx;font-weight:550;line-height:1.35;color:var(--text-2)}
.file-mention-path{min-width:0;font-size:21rpx;line-height:1.3;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.file-mention-close{width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:14rpx}
.file-mention-close:active{background:var(--fill-2)}
.file-mention-close .sheet-close-x{width:38rpx;height:38rpx}
.file-mention-scroll{min-height:0;max-height:calc(54vh - 78rpx);padding:6rpx 10rpx 0;box-sizing:border-box}
.file-mention-bottom-space{height:180rpx;flex-shrink:0}
.file-mention-row{min-height:78rpx;padding:8rpx 14rpx;display:flex;align-items:center;gap:18rpx;border-radius:14rpx;box-sizing:border-box}
.file-mention-row:active{background:var(--fill-2)}
.file-mention-icon{width:36rpx;height:36rpx;flex:0 0 36rpx;opacity:.88}
.theme-dark .file-mention-icon{filter:brightness(0) invert(.9)}
.file-mention-name{flex:1;min-width:0;font-size:28rpx;line-height:1.4;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.file-mention-drill{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:14rpx}
.file-mention-drill:active{background:var(--fill)}
.file-mention-chevron{width:28rpx;height:28rpx;opacity:.85}
.file-mention-group-title{margin:10rpx 14rpx 2rpx;padding-top:10rpx;border-top:1rpx solid var(--divider);font-size:22rpx;line-height:1.4;color:var(--text-3)}
.file-mention-session-detail{max-width:32%;flex-shrink:0;font-size:21rpx;line-height:1.3;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.file-mention-state{min-height:112rpx;padding:24rpx;display:flex;align-items:center;justify-content:center;gap:18rpx;box-sizing:border-box;text-align:center;font-size:25rpx;color:var(--text-2)}
.file-mention-error{color:var(--danger,#d94343)}
.file-mention-retry{padding:12rpx 18rpx;border:1rpx solid var(--border);border-radius:999rpx;color:var(--text);font-size:23rpx}
.command-menu-toolbar{display:flex;align-items:center;gap:4px;padding:0;flex-shrink:0}
.command-search{flex:1;min-width:0;height:30px;padding:0;color:var(--text);background:transparent;font-size:12px}
.command-search-placeholder{color:var(--text-3)}
.command-search-field{display:flex;align-items:center;gap:6px;margin:2px 2px 4px;padding:0 7px;border:1px solid transparent;border-radius:6px;flex-shrink:0}
.command-search-field:focus-within{border-color:var(--border-strong);background:var(--fill)}
.command-search-icon{width:14px;height:14px;flex:0 0 14px;opacity:.8}
.command-options{max-height:min(52vh,360px)}
.command-options .command-scroll{max-height:calc(min(52vh,360px) - 76px)}
.command-options-return{min-width:0;flex:1;min-height:30px;display:flex;align-items:center;gap:6px;padding:0 7px;border-radius:6px;cursor:pointer}
.command-options-back{display:block;width:14px;height:14px;flex:0 0 14px;transform:rotate(180deg)}
.command-options-title{min-width:0;font-size:12px;line-height:18px;color:var(--text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.command-options .command-close{width:30px;height:30px;border-radius:6px;cursor:pointer}
.command-close-glyph{position:relative;width:14px;height:14px;color:var(--text-2)}
.command-close-glyph::before,.command-close-glyph::after{content:'';position:absolute;left:6.5px;top:1px;width:1px;height:12px;background:currentColor;border-radius:1px;transform:rotate(45deg)}
.command-close-glyph::after{transform:rotate(-45deg)}
.command-close{width:56rpx;height:56rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.command-close .sheet-close-x{width:46rpx;height:46rpx}
.command-menu-icon-slot{width:20px;height:20px;flex:0 0 20px;display:flex;align-items:center;justify-content:center}
.command-menu-icon{display:block;width:16px;height:16px;flex-shrink:0;filter:grayscale(1);opacity:.85}
.theme-dark .command-monochrome{filter:brightness(0) invert(1);opacity:.8}
.command-row-pressed{background:var(--fill-2)}
.command-retry{flex-shrink:0;padding:8rpx 14rpx;color:var(--text)}
.composer-plus.active{background:var(--fill-2)}
.command-group-title{padding:8px 6px 6px;font-size:11px;font-weight:400;line-height:16px;color:var(--text-3)}
.command-scroll{max-height:36vh;min-height:0}
.command-catalog .command-scroll{max-height:calc(52vh - 10px)}
.command-row,.command-option{min-height:34px;padding:0 8px;box-sizing:border-box;border-radius:8px;display:flex;align-items:center;gap:6px;cursor:pointer}
.command-row:active,.command-option:active,.command-row:focus-visible,.command-option:focus-visible{background:var(--fill-2)}
.command-identity{display:flex;align-items:baseline;gap:6px;min-width:0;max-width:62%;flex:0 1 auto}
.command-name,.command-option-label{min-width:0;font-size:14px;line-height:20px;font-weight:400;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.command-alias{max-width:100px;flex-shrink:0;font-size:12px;line-height:18px;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.command-desc{min-width:0;flex:1;margin-left:8px;font-size:12px;line-height:18px;color:var(--text-3);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media (hover:hover) and (pointer:fine){.command-row:hover,.command-option:hover{background:var(--fill-2)}
}
@media (hover:none),(pointer:coarse){.command-row,.command-option{min-height:44px}
}
.command-options .command-option{min-height:30px;padding:5px 7px;gap:6px;border-radius:6px;font-size:12px;color:var(--text)}
.command-option.selected{background:var(--fill)}
.command-option-main{min-width:0;max-width:65%;flex:0 1 auto;display:flex;align-items:baseline;gap:4px}
.command-options .command-option-label{font-size:12px;line-height:18px}
.command-option-badge{max-width:48px;flex-shrink:0;align-self:flex-start;margin-top:-1px;font-size:8px;line-height:10px;font-weight:600;letter-spacing:.2px;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.command-option-detail{min-width:0;flex:1;margin-left:8px;font-size:11px;line-height:18px;color:var(--text-3);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.command-check-slot{width:14px;height:18px;flex:0 0 14px;margin-left:auto;display:flex;align-items:center;justify-content:center}
.command-check{width:8px;height:4px;border-left:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:translateY(-1px) rotate(-45deg)}
.command-option.command-row-pressed,.command-options-return:active,.command-options .command-close:active{background:var(--fill-2)}
@media (hover:hover) and (pointer:fine){.command-options .command-option:hover,.command-options-return:hover,.command-options .command-close:hover{background:var(--fill-2)}
}
@media (hover:none),(pointer:coarse){.command-options .command-option,.command-options-return{min-height:44px}
.command-options .command-close{width:44px;height:44px}
.command-search{height:40px;font-size:14px}
.command-options .command-option-label{font-size:14px;line-height:20px}
.command-option-detail{font-size:12px;line-height:20px}
.command-options .command-scroll{max-height:calc(52vh - 100px)}
.command-options{max-height:52vh}
}
.command-empty,.command-error{padding:28rpx;text-align:center;font-size:26rpx;color:var(--text-2)}
.command-error{color:#E5484D;display:flex;align-items:center;justify-content:space-between;gap:12rpx;font-size:23rpx}
.command-loading{height:4rpx;overflow:hidden;background:rgba(46,107,230,.12)}
.command-loading-bar{width:42%;height:100%;background:#2E6BE6;animation:command-load 1.1s ease-in-out infinite}
@keyframes command-load{from{transform:translateX(-120%)}
to{transform:translateX(340%)}
}
/* 鍘嗗彶鍔犺浇妯箙锛坕OS historyLoadingBanner锛氳浆鍦?+ caption + Spacer锛宧10 v8锛?*/
.hist-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;               /* spacing 9 */
  padding: 16rpx 20rpx;     /* h10 v8 */
  min-height: 76rpx;        /* 加载/空闲同高，避免切换时内容位移 */
  box-sizing: border-box;
}
.hist-banner.is-idle .banner-text { color: #2E6BE6; }
.banner-retry { color: #2E6BE6; font-size: 24rpx; flex-shrink: 0; }
.banner-spinner {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(46, 107, 230, 0.18);
  border-top-color: #2E6BE6;
  animation: state-spin 0.9s linear infinite;
  flex-shrink: 0;
}
.banner-text {
  font-size: 24rpx;         /* caption 12pt */
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 鍔犺浇鏇存棭璁板綍锛坕OS锛歝aption 鍏ㄥ鎸夐挳锛?*/
.load-older {
  font-size: 24rpx;         /* caption 12pt */
  color: #2E6BE6;
  text-align: center;
  padding: 20rpx 0;
}
/* 鐢ㄦ埛娑堟伅锛坕OS .user锛氬彸瀵归綈锛沴eading 34pt锛涜 v12锛涙皵娉′笌澶嶅埗閽棿璺?5pt锛?*/
.row-user {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding: 24rpx 0 24rpx 68rpx;   /* leading 34pt / vertical 12pt */
}
/* 发送的消息下面只留一个复制按钮，靠右（父级 align-items:flex-end 已右对齐，
   这里只是去掉 .copy-btn 默认的居中占位，保证贴右下角）。 */
.row-user-copy {
  align-self: flex-end;
}
/* iOS userBubbleFill锛歰cean 11%锛堟祬锛?24%锛堟繁锛夛紱鎻忚竟 8%/34%锛涘崐寰?15pt */
.row-user-bubble {
  max-width: 100%;
  box-sizing: border-box;
  border-radius: 30rpx;
  padding: 20rpx 28rpx;           /* iOS 鐢熶骇璺緞锛欻14 / V10 */
  background: rgba(46, 107, 230, 0.11);
  border: 1.4rpx solid rgba(46, 107, 230, 0.08);   /* 0.7pt */
}
.theme-dark .row-user-bubble {
  background: rgba(46, 107, 230, 0.24);
  border-color: rgba(46, 107, 230, 0.34);
}
.row-user-bubble .attach-grid {
  margin-bottom: 16rpx;           /* spacing 8 */
}
.row-user-bubble .attach-grid:last-child {
  margin-bottom: 0;
}
.row-user-text {
  font-size: 34rpx;               /* body 17pt */
  color: var(--text);
  line-height: 1.45;
  white-space: pre-wrap;
  word-break: break-word;
}
/* 用户气泡内的 Markdown 块沿用气泡文字口径，只是不再显示原始 * 和 # 语法 */
.row-user-bubble .md-block{margin:0}
.row-user-bubble .md-block + .md-block{margin-top:12rpx}
.row-user-bubble .md-para,.row-user-bubble .md-quote,.row-user-bubble .md-li-text{font-size:34rpx;color:var(--text);line-height:1.45}
.row-user-bubble .md-heading{color:var(--text);font-weight:600}
.row-user-bubble .md-h1{font-size:38rpx}
.row-user-bubble .md-h2{font-size:36rpx}
.row-user-bubble .md-h3,.row-user-bubble .md-h4,.row-user-bubble .md-h5,.row-user-bubble .md-h6{font-size:34rpx}
.row-user-bubble .md-list{padding-left:8rpx}
.row-user-bubble .code-block{background:rgba(46,107,230,.08)}
.theme-dark .row-user-bubble .code-block{background:rgba(46,107,230,.16)}
/* 澶嶅埗閽紙iOS CopyMessageButton锛?6x26pt锛屼綅浜庢皵娉′笅鏂?5pt锛?*/
.copy-btn {
  width: 52rpx;                   /* 26pt */
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;              /* spacing 5pt */
}
.copy-ic {
  width: 32rpx;                   /* 16pt */
  height: 32rpx;
}
/* 鍔╂墜娑堟伅锛坕OS .assistant锛氬叏瀹?Markdown锛寁12锛涘鍒堕挳 padding-bottom 8锛?*/
.row-assistant {
  padding: 24rpx 0;               /* vertical 12pt */
}
.conversation-window-row { display: flow-root; }
.assistant-plain-text { display: block; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.75; }
/* 原来这里还有 padding-bottom: 16rpx —— 它把 52rpx 的按钮内容区压到 36rpx，
   图标被顶高 8rpx；而同一行的用量胶囊是正常居中的，于是图标整体比胶囊高 8rpx。
   去掉后两侧中心都落在 26rpx，同一条水平线。 */
.row-assistant .copy-btn {
  margin-top: 0;
}
.row-streaming-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;               /* subheadline */
  font-weight: 500;
  color: var(--text-2);
  margin-bottom: 14rpx;           /* spacing 7 */
}
/* 鍏跺畠浜嬩欢琛岋紙iOS .system锛歴pacing 9锛沺adding 10锛泃int 6% 搴曪紱radius 11锛?*/
.row-event {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;                     /* spacing 9 */
  padding: 20rpx;                 /* padding 10 */
  margin: 12rpx 0;                /* vertical 6 */
  border-radius: 22rpx;           /* radius 11 */
  background: rgba(46, 107, 230, 0.06);
}
.row-event .event-ic {
  width: 26rpx;                   /* 13pt */
  height: 26rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
}
.row-event-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;                      /* spacing 3 */
  min-width: 0;
}
.event-tag {
  font-size: 24rpx;               /* caption 12pt */
  font-weight: 600;               /* semibold */
  color: #2E6BE6;
}
.event-tag.error {
  color: #E5533C;
}
.event-text {
  font-size: 24rpx;               /* caption 12pt */
  color: var(--text-2);
  word-break: break-word;
}
.event-text {
  font-size: 26rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* ---------- 鎶樺彔琛岋紙鎬濊€?/ 宸ュ叿锛?---------- */
.fold {
  background: var(--fill);
  border: 1rpx solid var(--border-strong);
  border-radius: 18rpx;
  margin: 14rpx 0;
  overflow: hidden;
}
.tool-glyph {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.fold-chevron.open {
  transform: rotate(0deg);
}
.tool-status {
  font-size: 24rpx;
  color: var(--text-3);
  margin-left: 14rpx;
  flex-shrink: 0;
}
.tool-status.done { color: var(--success); }
.tool-status.error { color: #E5484D; }
/* ---------- Markdown ---------- */
.md-block {
  margin: 10rpx 0;
}
.md-para {
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--text);
  display: block;
}
.md-heading {
  display: block;
  color: var(--text);
  font-weight: 700;
  margin-top: 20rpx;
}
.md-h1 { font-size: 40rpx; }
.md-h2 { font-size: 36rpx; }
.md-h3 { font-size: 33rpx; }
.md-h4, .md-h5, .md-h6 { font-size: 31rpx; }
.md-inline-code {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 0.86em;
  color: var(--text);
  background: var(--fill);
  border-radius: 12rpx;
  padding: 2rpx 8rpx;
}
.md-quote {
  display: block;
  border-left: 6rpx solid rgba(191, 212, 255, 0.45);
  padding-left: 20rpx;
  color: var(--text-2);
  font-size: 29rpx;
  margin: 16rpx 0;
}
.md-image-block {
  margin: 16rpx 0;
}
.md-image {
  display: block;
  width: 100%;
  border-radius: 16rpx;
  background: var(--fill);
}
.md-image-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--fill);
  color: var(--text-3);
  font-size: 26rpx;
}
.md-image-missing {
  min-height: 96rpx;
}
.md-hr {
  height: 1rpx;
  background: var(--border-strong);
  margin: 30rpx 0;
}
.md-list {
  margin: 10rpx 0;
}
.md-li {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0;
}
.md-li-marker {
  color: var(--text-3);
  margin-right: 16rpx;
  font-size: 29rpx;
  flex-shrink: 0;
}
.md-li-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text);
}
/* ---------- Markdown 琛ㄦ牸锛堟繁鑹诧紝iOS 瀵归綈锛?---------- */
/* 瀵归綈 dsh-mobile Markwon TablePlugin锛氳竟妗?onSurface 20%銆佽〃澶村簳鑹?onSurface 8%銆侀殧琛?3.5% */
.md-table {
  margin: 20rpx 0;
  border: 1rpx solid var(--border-strong);
  border-radius: 10rpx;
  overflow: hidden;
}
.md-tr {
  display: flex;
  border-bottom: 1rpx solid var(--border-strong);
}
.md-tr:last-child {
  border-bottom: none;
}
.md-tr:nth-child(odd):not(.md-tr-head) {
  background: var(--fill);
}
.md-td {
  flex: 1;
  min-width: 0;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--text);
  border-left: 1rpx solid var(--border-strong);
  word-break: break-word;
}
.md-td:first-child {
  border-left: none;
}
.md-tr-head .md-td {
  font-weight: 600;
  color: var(--text);
  font-size: 30rpx;
  background: var(--fill);
}
/* ---------- 浠ｇ爜鍧?---------- */
.code-block {
  position: relative;
  background: var(--fill);
  border: 1rpx solid var(--border-strong);
  border-radius: 20rpx;
  overflow: hidden;
  margin: 20rpx 0;
}
.code-lang {
  font-size: 22rpx;               /* caption2 11pt */
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  color: var(--text-2);           /* secondary */
  padding: 16rpx 28rpx 0;
}
.code-body {
  padding: 12rpx 28rpx 26rpx;
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text);
  white-space: pre-wrap;
  word-break: break-all;
  max-height: 480rpx;
  overflow-y: auto;
}
.code-copy {
  position: absolute;
  top: 14rpx;
  right: 20rpx;
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--fill-2);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
/* ---------- 鍥剧墖闄勪欢 ---------- */
.attach-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
/* 发送/交付的文件附件：右对齐（助手侧左对齐）的全圆角胶囊，单行文件名。
   完整路径不进气泡——点开底部弹窗后有「复制文件路径」。 */
.message-attachments { display:flex; flex-direction:column; align-items:flex-end; gap:16rpx; margin-top:12rpx; max-width:100%; }
.message-attachments.assistant-attachments { align-items:flex-start; }
.message-attachment { display:flex; align-items:center; gap:14rpx; max-width:600rpx; min-height:72rpx; padding:12rpx 30rpx; border-radius:999rpx; background:rgba(16,19,24,.08); }
.theme-dark .message-attachment { background:rgba(255,255,255,.12); }
.message-attachment-icon { width:34rpx; height:34rpx; flex:none; }
.message-attachment-name { max-width:440rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:26rpx; color:var(--text); }
.assistant-attachments { margin-left:0; }
/* 鍗曞浘锛歮ax 640脳560 aspectFit锛涘鍥撅細鍙屽垪 aspectFill 鍦嗚22 鐧芥弿杈?*/
.attach-grid.single .attach-img {
  width: 640rpx;
  height: 560rpx;
  border-radius: 22rpx;
  background: rgba(16, 19, 24, 0.06);
}
.attach-grid:not(.single) .attach-img {
  width: 360rpx;
  height: 560rpx;
  max-width: 46%;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  margin: 0 12rpx 12rpx 0;
  background: rgba(16, 19, 24, 0.06);
}
.conv-bottom {
  height: 20rpx;
}
.empty {
  text-align: center;
  color: var(--text-4);
  padding: 80rpx 0;
  font-size: 27rpx;
}
/* ---------- 寰呭鐞嗗崱鐗?---------- */
.pending-card {
  margin: 0 40rpx 20rpx;
  background: var(--surface);
  border: 1rpx solid rgba(46, 107, 230, 0.45);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--float-shadow);
  flex-shrink: 0;
}
.question-card {
  margin: 0 0 20rpx;
  box-sizing: border-box;
  border-color: rgba(16, 19, 24, 0.12);
  border-radius: 32rpx;
}
.theme-dark .question-card {
  background: #2C2C2E;
  border-color: rgba(255, 255, 255, 0.10);
}
.q-item {
  margin-bottom: 18rpx;
}
.q-question {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 8rpx;
}
.q-detail {
  font-size: 25rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
}
.q-options {
  display: flex;
  flex-direction: column;
}
.q-option {
  border: 1rpx solid var(--border-strong);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}
.q-option.selected {
  border-color: var(--ocean);
  background: rgba(46, 107, 230, 0.18);
}
.q-option-label {
  font-size: 28rpx;
  color: var(--text);
}
.q-option-desc {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}
.q-custom {
  background: var(--fill);
  border: 1rpx solid var(--border-strong);
  color: var(--text);
}
.pending-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}
.pending-btn {
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  margin-left: 18rpx;
}
.pending-btn.ghost {
  color: var(--text-2);
  border: 1rpx solid var(--border-strong);
}
.pending-btn.primary {
  color: #FFFFFF;
  background: var(--ocean);
}
.pending-btn.disabled {
  opacity: 0.5;
}
.approval-tool {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 30rpx;
  color: var(--text);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.approval-reason {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 10rpx;
}
/* ---------- composer 涓婃柟琛岋紙棰勮鑳跺泭 + 缁熻鑳跺泭锛?---------- */
.composer-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.preset-capsule {
  display: flex;
  align-items: center;
  height: 68rpx;                  /* 楂?34 */
  box-sizing: border-box;
  padding: 0 24rpx;               /* padding h12 */
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 32rpx;           /* radius 16 */
  box-shadow: var(--float-shadow);
  max-width: 60%;
}
.preset-capsule-ic {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.preset-capsule-text {
  font-size: 30rpx;               /* subheadline 15pt */
  font-weight: 500;               /* medium */
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.preset-capsule-chev {
  width: 22rpx;                   /* caption2 semibold */
  height: 22rpx;
  margin-left: 12rpx;
  opacity: 0.4;                   /* tertiary */
  flex-shrink: 0;
}
/* ---------- 杈撳叆闈㈡澘 ---------- */
/* 搴曢儴缁熶竴鏍堬紙瀵归綈 iOS 搴曢儴 VStack锛夛細婊氬埌搴?/ 瀹℃壒路鎻愰棶鍗?/ 鎺掗槦鎵樼洏 / 鑳跺泭琛?/ 杈撳叆鍗?
   閿洏寮瑰嚭鏃舵暣鏍?bottom = 閿洏楂樺害锛屾墍鏈夊厓绱犲悓姝ユ诞璧凤紝浜掍笉閬尅 */
.dock-stack {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  z-index: 60;
  display: flex;
  flex-direction: column;
  transition: bottom 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  padding-bottom: 1px;
}
/* 微信里 CSS 的 display 会盖过 hidden 属性：不补这条，切到上下文/编队 Tab 时
   输入栈仍然 fixed 在底部（z-index 60），把面板底部内容整块盖住。 */
.dock-stack[hidden] { display: none !important; }
.composer {
  position: relative;
  z-index: 1;                    /* 杈撳叆鍗″彔鍘嬫帓闃熸墭鐩樹笅娌匡紙iOS zIndex(1) + spacing -24锛?*/
  padding: 28rpx 28rpx 24rpx;     /* h14 / t14 / b12 */
  border-radius: 48rpx;           /* radius 24 */
  background: var(--surface);
  border: 1rpx solid var(--border-strong);
  box-shadow: var(--float-shadow);
}
.voice-input-wrap { position:relative; }
.dock-stack.voice-holding { opacity:0; }
.voice-touch-surface { position:absolute; inset:0; z-index:2; min-height:44px; }
.voice-progress { display:flex; justify-content:space-between; align-items:center; color:var(--text-2); font-size:24rpx; }
.voice-inline-action { padding:18rpx 12rpx; min-height:44px; box-sizing:border-box; display:flex; align-items:center; color:var(--text); }
.voice-transcript { border-top:1rpx solid var(--divider); margin-top:12rpx; font-size:26rpx; }
.voice-transcript-hint { display:block; color:var(--text-2); padding-top:16rpx; font-size:24rpx; }
.voice-transcript-text { display:block; max-height:180rpx; overflow:auto; padding-top:12rpx; color:var(--text); }
.voice-transcript-actions { display:flex; justify-content:flex-end; gap:20rpx; }
.composer-input-row { display:flex; align-items:flex-start; gap:8rpx; width:100%; }
.composer-input-row .composer-input { flex:1 1 auto; width:auto; min-width:0; }
/* 芯片只保留纯文字 + 主色，不加背景；字号与输入框一致（30rpx）。
   芯片与输入框同为 30rpx/42rpx 行盒，文字中心都在 21rpx，
   不需要任何垂直偏移（3/6rpx 实测都偏低）。 */
/* 灰色占位文字在 textarea 里的渲染位置比实际输入行高 ~4rpx（组件内部差异），
   芯片和它并排显示，所以上提 4rpx 对齐占位文字。 */
/* 行高回原生默认后，芯片与输入文字靠 flex 居中同排，不再依赖行盒数值匹配。 */
.composer-slash-chip { display: none; align-items: center; gap: 2rpx; flex-shrink: 0; align-self: center; margin-right: 4rpx; }
.composer-slash-chip.on { display: flex; }
.composer-slash-token { color: var(--ocean); font-size: 28rpx; }
.composer-slash-x { padding: 0 2rpx; color: var(--ocean); font-size: 18rpx; opacity: .66; }
/* 引用 chip（对话 / 文件夹 / 文件）：与指令 chip 同一语言——只保留图标 + 主色
   文字，不加背景；排在输入框上方，多个引用自动换行。蓝色取桌面端引用芯片的
   #5483E8，暗色主题提亮保证对比度。 */
.composer-refs { display: none; flex-wrap: wrap; align-items: center; gap: 2rpx 22rpx; margin: 2rpx 0 8rpx; }
.composer-refs.on { display: flex; }
.composer-refs[hidden] { display: none !important; }
.composer-ref-chip { display: flex; align-items: center; gap: 8rpx; min-width: 0; max-width: 100%; padding: 4rpx 4rpx 4rpx 2rpx; border-radius: 12rpx; }
.composer-ref-icon { width: 30rpx; height: 30rpx; flex: 0 0 30rpx; }
.theme-dark .composer-ref-icon { filter: brightness(1.5); }
.composer-ref-label { min-width: 0; max-width: 520rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; line-height: 1.4; color: #5483E8; }
.theme-dark .composer-ref-label { color: #8FB4F2; }
.composer-ref-remove { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; }
.composer-ref-remove:active { background: var(--fill-2); }
.composer-ref-x { font-size: 24rpx; line-height: 1; color: #5483E8; opacity: .6; }
.theme-dark .composer-ref-x { color: #8FB4F2; }
/* 输入文字 28rpx / 字重 350；行盒固定 42rpx，芯片与占位文字的对齐不受字号影响。 */
/* auto-height + 自定义行高时微信算出的高度少一行：补底部内边距圈住最后一行。 */
.composer-input {
  width: 100%;
  min-height: 76rpx;
  max-height: 320rpx;
  font-size: 28rpx;
  font-weight: 350;
  color: var(--text);
  box-sizing: border-box;
}
.composer-placeholder {
  color: rgba(16, 19, 24, 0.28) !important;
}
.theme-dark .composer-placeholder {
  color: rgba(241, 244, 250, 0.36) !important;
}
/* 输入框 Markdown 预览：字号与输入一致，块间距收紧，代码块用中性底 */
.composer-preview{display:block;width:100%;max-height:320rpx;white-space:normal;word-break:break-word}
.composer-preview .md-block{margin:0}
.composer-preview .md-block + .md-block{margin-top:12rpx}
.composer-preview .md-para,.composer-preview .md-quote,.composer-preview .md-li-text{font-size:28rpx;color:var(--text);line-height:1.5}
.composer-preview .md-heading{color:var(--text);font-weight:600}
.composer-preview .md-h1{font-size:34rpx}
.composer-preview .md-h2{font-size:32rpx}
.composer-preview .md-h3,.composer-preview .md-h4,.composer-preview .md-h5,.composer-preview .md-h6{font-size:28rpx}
.composer-preview-tip { margin-top: 8rpx; padding-top: 10rpx; border-top: 1rpx dashed var(--divider); font-size: 20rpx; color: var(--text-3); text-align: center; }
.composer-preview .code-block{background:rgba(142,142,147,.1)}
.theme-dark .composer-preview .code-block{background:rgba(142,142,147,.18)}
.composer-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.composer-thumb {
  position: relative;
  margin-right: 14rpx;
}
.composer-thumb-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
}
.composer-thumb-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.7);
  color: var(--text);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.composer-bar {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
/* 瀵归綈 dsh-mobile锛氳緭鍏ユ爮鎺т欢涓烘墎骞冲浘鏍?鏂囧瓧锛坥nSurface 62%锛夛紝鏃犺兌鍥婂簳鑹?*/
.chip {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-2);
  padding: 10rpx 8rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}
.chip.icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  padding: 0;
  margin-right: 0;
}
.composer-spacer {
  flex: 1;
}
.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--ocean);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.send-btn.disabled {
  opacity: 0.48;
}
.send-btn.stop {
  background: var(--ocean);
}
.stop-square {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: #FFFFFF;
}
/* ---------- 鎶藉眽 ---------- */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 75vh;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--surface);
}
.sheet-handle {
  width: 72rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--text-3);
  opacity: 0.75;
  margin: 6rpx auto 20rpx;
}
/* ===== 鍥炬爣璧勪骇灏哄锛坕OS 瀵归綈锛?===== */
.session-menu-mask { background: rgba(0, 0, 0, .42); z-index: 1000; visibility: hidden; pointer-events: none; opacity: 0; transition: opacity 160ms ease-out, visibility 0s 160ms; }
.session-menu-mask.is-open { visibility: visible; pointer-events: auto; opacity: 1; transition-delay: 0s; }
.sheet.session-menu { padding: 10rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; color: var(--text); transform: translateY(32rpx); transition: transform 160ms ease-out, height 0.24s cubic-bezier(0.32, 0.72, 0, 1); }
.sheet.session-menu.expanded { height: 86vh; max-height: 86vh; }
.session-menu-mask.is-open .session-menu { transform: translateY(0); }
.session-menu-grabber-zone { padding: 10rpx 0 6rpx; margin: -10rpx 0 0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.session-menu .sheet-handle { height: 8rpx; margin: 10rpx auto 12rpx; background: var(--border-strong); opacity: 1; flex-shrink: 0; }
.session-menu-head { display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; flex-shrink: 0; }
.session-menu-heading { display: flex; flex-direction: row; align-items: center; gap: 12rpx; flex: 1; min-width: 0; }
.session-menu-back { flex: none; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin-left: -10rpx; border-radius: 50%; background: transparent; border: 1rpx solid var(--border); box-sizing: border-box; }
.session-menu-back-pressed { background: var(--fill); opacity: .85; }
.session-menu-back-ic { width: 24rpx; height: 24rpx; transform: rotate(180deg); opacity: .75; }
.session-menu-title { font-size: 34rpx; font-weight: 650; color: var(--text); }
.session-menu-close { flex: none; margin-left: auto; display: flex; align-items: center; justify-content: flex-end; width: 64rpx; height: 64rpx; padding: 0; flex-shrink: 0; }
.session-menu-scroll { min-height: 0; max-height: 55vh; }
.session-menu-group { overflow: hidden; border-radius: 24rpx; border: 1rpx solid var(--border); background: var(--fill); margin-bottom: 16rpx; }
.session-menu-row { min-height: 100rpx; display: flex; align-items: center; gap: 22rpx; padding: 12rpx 24rpx; box-sizing: border-box; }
.session-menu-row + .session-menu-row { border-top: 1rpx solid var(--divider); }
.session-menu-icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.session-menu-folder { opacity: .65; }
.session-menu-label { flex: 1; min-width: 0; font-size: 29rpx; line-height: 1.5; color: var(--text); overflow-wrap: anywhere; }
.session-menu-chevron { width: 24rpx; height: 24rpx; opacity: .55; flex-shrink: 0; }
.session-menu-pressed { background: var(--surface); }
.session-menu-row.disabled { opacity: .4; }
/* 鏇村寮瑰眰鍐呯殑浜岀骇椤甸潰锛堥噸鍛藉悕 / 鏌ョ湅缁熻 / 宸ヤ綔鍖烘枃浠讹級锛氬湪褰撳墠寮瑰眰鍐呭垏鎹紝涓嶅啀鍙﹀紑搴曢儴寮圭獥 */
.session-menu-pane { padding: 8rpx 0 4rpx; animation: session-menu-pane-in 180ms ease-out; }
.session-menu-pane .session-sheet-input { height: 88rpx; }
.session-menu-stats { max-height: 60vh; }
.sheet.session-menu.expanded .session-menu-scroll { max-height: none; }
.sheet.session-menu.expanded .session-menu-scroll.session-menu-stats { flex: 1 1 auto; min-height: 0; }
.session-menu-files { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; padding: 0; }
.session-menu-files-scroll { flex: 1 1 auto; min-height: 0; max-height: 46vh; }
.sheet.session-menu.expanded .session-menu-files-scroll { max-height: none; }
@keyframes session-menu-pane-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) { .session-menu-mask, .sheet.session-menu, .session-menu-pane { transition: none; animation: none; } }
.nav-ic {
  width: 20rpx;      /* 涓変釜鐐瑰浘鏍囷紝杩涗竴姝ョ缉灏?*/
  height: 20rpx;
  display: block;
}
.event-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.q-ic {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.chip {
  display: flex;
  align-items: center;
}
.chip-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}
/* 绐勫睆锛堟墜鏈猴級锛氭ā寮忚姱鐗囦粎鏄剧ず鍥炬爣锛涘灞忔樉绀哄浘鏍?鏂囧瓧 */
.chip-label {
  display: none;
}
@media (min-width: 560px) {
  .chip-label {
    display: inline;
  }
}
.context-ring {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  padding: 4rpx;
  box-sizing: border-box;
  margin-right: 16rpx;
  position: relative;
  flex-shrink: 0;
}
.ctx-line {
  display: flex;
  align-items: baseline;
}
.ctx-label {
  font-size: 28rpx;
  color: var(--text-2);
}
.ctx-pct {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-left: 16rpx;
}
.ctx-tokens {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
.ctx-bar {
  height: 10rpx;
  border-radius: 6rpx;
  background: var(--fill);
  overflow: hidden;
  margin: 22rpx 0 26rpx;
}
.ctx-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--ocean);
}
.ctx-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}
.ctx-row-label {
  flex: 1 1 auto;
  min-width: 0;
}
.ctx-row-val {
  flex: 0 0 auto;
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.ctx-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 6rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.ctx-dot.gray { background: var(--text-3); }
.ctx-dot.purple { background: var(--purple); }
.ctx-dot.ocean { background: var(--ocean); }
.ctx-dot.orange { background: var(--amber); }
.attach-ic {
  width: 36rpx;
  height: 36rpx;
  display: block;
}
.thumb-x {
  width: 34rpx;
  height: 34rpx;
  display: block;
}
.send-ic {
  width: 40rpx;
  height: 40rpx;
  display: block;
}
.copy-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}
/* ---------- 娣辫壊琛ュ厖瑕嗙洊锛坱heme-dark锛岄殢澶栬妯″紡鍒囨崲锛?---------- */
.theme-dark .nav-more {
  background: var(--fill-2);
  border: 1rpx solid var(--border-strong);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}
/* 娣辫壊妯″紡鍥炬爣鍙嶈壊 */
.theme-dark .nav-ic {
  filter: invert(1) brightness(0.9);
}
/* ---------- 杩囩▼鍒嗙粍琛岋紙瀵归綈 dsh-mobile ConversationProcessRow锛?---------- */
/* 杩囩▼缁勶紙瀵归綈 DSH锛氬乏绠ご 鈻?鏀惰捣 / 鈻?灞曞紑 + 鏍囬 + 搴曢儴鍙戜笣绾匡級 */
.process-block {
  padding: 0;
  margin: 0;
}
.process-block.running .process-title {
  color: #18365A;
}
.theme-dark .process-block.running .process-title {
  color: #A8BEDB;
}
.process-head {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;                     /* spacing 7 */
  min-width: 0;
  padding: 14rpx 0;               /* vertical 7 */
}
.process-title {
  font-size: 30rpx;               /* subheadline 15pt */
  font-weight: 500;               /* medium */
  color: var(--text-2);           /* secondary */
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 简洁模式：组标题显示完全，长标题换行而不是省略号 */
.process-title.title-wrap {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
  flex: 1 1 auto;
  max-width: none;
}
.process-command-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  transition: opacity 0.14s ease;
}
.process-chevron.open {
  transform: rotate(-90deg);      /* 灞曞紑锛氣柎 */
}
/* 本轮运行失败卡片：红感叹号 + 红框 + DSH 原文（对齐桌面端 message.turnError） */
.turn-error-card{display:flex;flex-direction:column;gap:10rpx;margin:14rpx 0 6rpx;padding:20rpx 24rpx;border:1rpx solid rgba(235,87,87,.42);border-radius:16rpx;background:rgba(235,87,87,.08)}
.theme-dark .turn-error-card{border-color:rgba(255,113,120,.46);background:rgba(255,113,120,.12)}
.turn-error-head{display:flex;align-items:center;gap:12rpx;min-width:0}
.turn-error-bang{flex-shrink:0;width:30rpx;height:30rpx;border-radius:50%;background:#EB5757;color:#FFF;font-size:22rpx;font-weight:700;line-height:30rpx;text-align:center}
.theme-dark .turn-error-bang{background:#FF7178;color:#2A0C0E}
.turn-error-title{font-size:28rpx;font-weight:600;color:#C0392B;min-width:0}
.theme-dark .turn-error-title{color:#FF9B9F}
.turn-error-message{font-size:26rpx;line-height:1.5;color:var(--text-2);overflow-wrap:anywhere;white-space:pre-wrap}
.turn-error-code{display:flex;align-items:baseline;gap:10rpx;flex-wrap:wrap}
.turn-error-code-label{font-size:22rpx;color:var(--text-3);flex-shrink:0}
.turn-error-code-value{font-family:var(--font-mono,monospace);font-size:22rpx;color:var(--text-2);overflow-wrap:anywhere}
.process-body {
  padding: 0;
}
.process-step-anchor {
height: 1rpx;
}
.process-body-capped {
max-height: min(400px, 50vh);
overscroll-behavior-y: auto;
}
.process-command-detail {
  margin: 10rpx 0 14rpx 4rpx;
  padding: 22rpx 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  background: var(--surface-glass);
  color: var(--text);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 26rpx;
  line-height: 1.48;
  white-space: pre-wrap;
  word-break: break-word;
}
/* 灞曞紑鍐呯殑 disclosure锛圱hink / 宸ュ叿锛屽榻?ProcessDisclosure锛?*/
/* ===== 浜嬩欢琛岋紙iOS ConversationFallbackEventRow锛氬浘鏍?8瀹?+ 鏍囬 tint + 路 + 棰勮锛?===== */
.event-row {
  padding: 4rpx 0;                /* vertical 2 */
}
.event-head {
  display: flex;
  align-items: center;
  gap: 16rpx;                     /* spacing 8 */
  min-width: 0;
}
.event-glyph {
  width: 36rpx;                   /* frame width 18 */
  height: 36rpx;
  flex-shrink: 0;
}
.event-title {
  font-size: 30rpx;               /* subheadline 15pt */
  color: var(--text);
  flex-shrink: 0;
  max-width: 46%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.event-title.tint-green { color: #34A853; }    /* iOS .green */
.event-title.tint-purple { color: #7A54C7; }   /* DSHColor.purple */
.event-title.tint-orange { color: #F07D14; }   /* DSHColor.orange */
.event-dot {
  color: var(--text-3);           /* tertiary */
  flex-shrink: 0;
}
.event-preview {
  font-size: 30rpx;               /* subheadline */
  color: var(--text-2);           /* secondary */
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.event-spacer {
  flex: 1;
}
.event-chevron {
  width: 26rpx;                   /* caption semibold */
  height: 26rpx;
  flex-shrink: 0;
  transition: transform 0.18s ease;
}
.event-chevron.open {
  transform: rotate(90deg);
}
/* 浜嬩欢璇︽儏浣擄紙iOS锛?px 鐏扮嚎 + compact markdown secondary锛沴eading 5/top 5/bottom 3锛?*/
.event-body {
  display: flex;
  gap: 20rpx;                     /* spacing 10 */
  padding: 10rpx 0 6rpx 10rpx;    /* leading 5 / top 5 / bottom 3 */
}
.event-rule {
  width: 2rpx;                    /* 1pt gray 24% */
  background: rgba(142, 142, 147, 0.24);
  flex-shrink: 0;
  border-radius: 1rpx;
}
.event-body-text {
