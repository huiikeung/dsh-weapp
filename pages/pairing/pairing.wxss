.pairing {
  padding: 60rpx 48rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  padding-top: 40rpx;
  margin-bottom: 60rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.brand-mark {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.brand-text {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 18rpx;
}

.brand-badge {
  color: var(--mist);
  border: 1rpx solid rgba(191, 212, 255, 0.5);
  border-radius: 12rpx;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  letter-spacing: 2rpx;
}

.actions {
  margin-bottom: 40rpx;
}

.manual {
  padding: 36rpx 32rpx;
  margin-bottom: 40rpx;
  /* 原生 <input> 在 backdrop-filter 祖先下无法聚焦、光标不显示、键盘不弹出，故此卡片取消模糊 */
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.manual-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.input {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 30rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.hint {
  color: rgba(255, 255, 255, 0.5);
  font-size: 25rpx;
  line-height: 1.7;
  margin-bottom: 30rpx;
}

.error {
  color: #FF8589;
  font-size: 27rpx;
  margin-bottom: 20rpx;
}

.status-text {
  color: var(--mist);
  font-size: 27rpx;
  margin-bottom: 20rpx;
}

.restore {
  text-align: center;
  color: var(--mist);
}
