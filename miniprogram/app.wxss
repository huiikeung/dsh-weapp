/* DeepSeek Harness Mobile — 全局样式
 * 视觉语言对齐 iOS 端 Design/design-spec.md：
 * 深海蓝氛围 + 纸白内容面 + 海洋蓝点缀 + 液态玻璃控件。
 */

page {
  /* 品牌色（双主题共用） */
  --navy: #07182B;
  --navy-raised: #0D2340;
  --ocean: #2E6BE6;
  --mist: #BFD4FF;
  --ink: #101318;
  --paper: #F7F8FA;
  --purple: #7A54C7;
  --orange: #F07D14;
  --amber: #FFAE1F;
  --success: #2EB85C;

  /* 语义色：浅色默认，深色在下方 @media 覆盖（跟随微信 darkmode） */
  --bg: #FFFFFF;
  --surface: #FFFFFF;
  --fill: rgba(16, 19, 24, 0.05);
  --fill-2: rgba(16, 19, 24, 0.07);
  --border: rgba(16, 19, 24, 0.10);
  --border-strong: rgba(16, 19, 24, 0.16);
  --divider: rgba(16, 19, 24, 0.08);
  --text: #10131A;
  --text-2: rgba(16, 19, 24, 0.62);
  --text-3: rgba(16, 19, 24, 0.55);
  --text-4: rgba(16, 19, 24, 0.45);
  --placeholder: rgba(16, 19, 24, 0.28);
  --ring-track: rgba(16, 19, 24, 0.22);
  --segment-active-bg: #FFFFFF;
  --segment-active-text: #10131A;
  --float-shadow: 0 10rpx 30rpx rgba(7, 24, 43, 0.10);
  --card-shadow: 0 2rpx 12rpx rgba(7, 24, 43, 0.05);

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 手动指定主题时，页面根节点挂 .theme-light / .theme-dark，
   整体覆盖语义变量（与 page 级媒体查询内容一致） */

.theme-light {
  --bg: #FFFFFF;
  --surface: #FFFFFF;
  --fill: rgba(16, 19, 24, 0.05);
  --fill-2: rgba(16, 19, 24, 0.07);
  --border: rgba(16, 19, 24, 0.10);
  --border-strong: rgba(16, 19, 24, 0.16);
  --divider: rgba(16, 19, 24, 0.08);
  --text: #10131A;
  --text-2: rgba(16, 19, 24, 0.62);
  --text-3: rgba(16, 19, 24, 0.55);
  --text-4: rgba(16, 19, 24, 0.45);
  --placeholder: rgba(16, 19, 24, 0.28);
  --ring-track: rgba(16, 19, 24, 0.22);
  --segment-active-bg: #FFFFFF;
  --segment-active-text: #10131A;
  --float-shadow: 0 10rpx 30rpx rgba(7, 24, 43, 0.10);
  --card-shadow: 0 2rpx 12rpx rgba(7, 24, 43, 0.05);
  --ink: #101318;
  --gray: #7D8592;
}

.theme-dark {
  --bg: #000000;
  --surface: #1C1C1E;
  --fill: rgba(255, 255, 255, 0.06);
  --fill-2: rgba(255, 255, 255, 0.10);
  --border: rgba(255, 255, 255, 0.10);
  --border-strong: rgba(255, 255, 255, 0.16);
  --divider: rgba(255, 255, 255, 0.08);
  --text: #F1F4FA;
  --text-2: rgba(241, 244, 250, 0.62);
  --text-3: rgba(241, 244, 250, 0.55);
  --text-4: rgba(241, 244, 250, 0.45);
  --placeholder: rgba(241, 244, 250, 0.36);
  --ring-track: rgba(241, 244, 250, 0.22);
  --segment-active-bg: #636366;
  --segment-active-text: #FFFFFF;
  --float-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.45);
  --card-shadow: none;
  --ink: #F1F4FA;
  --gray: rgba(241, 244, 250, 0.55);
}

@media (prefers-color-scheme: dark) {
  page {
    --bg: #000000;
    --surface: #1C1C1E;
    --fill: rgba(255, 255, 255, 0.06);
    --fill-2: rgba(255, 255, 255, 0.10);
    --border: rgba(255, 255, 255, 0.10);
    --border-strong: rgba(255, 255, 255, 0.16);
    --divider: rgba(255, 255, 255, 0.08);
    --text: #F1F4FA;
    --text-2: rgba(241, 244, 250, 0.62);
    --text-3: rgba(241, 244, 250, 0.55);
    --text-4: rgba(241, 244, 250, 0.45);
    --placeholder: rgba(241, 244, 250, 0.36);
    --ring-track: rgba(241, 244, 250, 0.22);
    --segment-active-bg: #636366;
    --segment-active-text: #FFFFFF;
    --float-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.45);
  --card-shadow: none;
    /* 旧样式里 var(--ink)/var(--gray) 大量用于“正文/次要文字”，
       深色下一并翻转为 onSurface 色板，避免逐条覆盖 */
    --ink: #F1F4FA;
    --gray: rgba(241, 244, 250, 0.55);
  }
}

/* ---------- 通用容器 ---------- */

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

.page-light {
  background: #F2F2F7;
}

.page-dark {
  background: transparent;
}

/* 弹层抓手（iOS sheet grabber：中性灰胶囊） */
.sheet-grabber {
  width: 72rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(150, 150, 155, 0.55);
  margin: 14rpx auto 6rpx;
  flex-shrink: 0;
}

/* ---------- 液态玻璃（对齐 iOS Liquid Glass / ultraThinMaterial：
   渐变高光 + 强模糊提饱和 + 顶部内发光 + 发丝亮边） ---------- */

.glass {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.10), 0 8rpx 32rpx rgba(3, 14, 30, 0.18);
}

.glass-light {
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(16, 19, 24, 0.06);
  border-radius: 28rpx;
  backdrop-filter: blur(24rpx);
  box-shadow: 0 8rpx 28rpx rgba(7, 24, 43, 0.10);
}

/* 玻璃表面按压反馈（对齐 iOS 按钮交互：轻微缩放 + 提亮） */
.glass-press {
  transition: transform 0.18s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.18s ease;
}

.glass-press:active {
  transform: scale(0.96);
  opacity: 0.82;
}

/* ---------- 文本 ---------- */

.title-hero {
  font-size: 64rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.subtitle-hero {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.62);
  margin-top: 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.section-title-light {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.text-quiet {
  color: var(--gray);
  font-size: 26rpx;
}

.text-mono {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

/* ---------- 状态点 ---------- */

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 12rpx;
}

.status-dot.connected { background: var(--success); }
.status-dot.connecting { background: var(--amber); }
.status-dot.disconnected { background: var(--gray); }
.status-dot.failed { background: #E5484D; }

/* ---------- 按钮 ---------- */

.btn-primary {
  background: var(--ocean);
  color: #FFFFFF;
  border-radius: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 26rpx 0;
  text-align: center;
  transition: transform 0.12s ease;
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-primary[disabled] {
  background: rgba(46, 107, 230, 0.35);
  color: rgba(255, 255, 255, 0.6);
}

.btn-glass {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
  border-radius: 28rpx;
  font-size: 32rpx;
  padding: 26rpx 0;
  text-align: center;
  transition: transform 0.12s ease;
}

.btn-glass:active {
  transform: scale(0.98);
}

.btn-text {
  color: var(--ocean);
  font-size: 30rpx;
  padding: 20rpx 0;
}

.btn-text-danger {
  color: #E5484D;
  font-size: 30rpx;
  padding: 20rpx 0;
}

/* ---------- 表单 ---------- */

.field {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: var(--ink);
  box-sizing: border-box;
  width: 100%;
}

.field-dark {
  background: var(--fill);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: var(--text);
  box-sizing: border-box;
  width: 100%;
}

.field-placeholder {
  color: var(--gray);
}

/* ---------- 列表卡片（设置/弹层通用） ---------- */

.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--card-shadow);
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  min-height: 44px;
  box-sizing: border-box;
}

.card-row + .card-row {
  border-top: 1rpx solid var(--divider);
}

.card-row-label {
  font-size: 31rpx;
  color: var(--ink);
}

.card-row-value {
  font-size: 30rpx;
  color: var(--gray);
  display: flex;
  align-items: center;
}

.group-title {
  font-size: 30rpx;
  color: var(--gray);
  margin: 40rpx 16rpx 18rpx;
  font-weight: 500;
}

.group-hint {
  font-size: 25rpx;
  color: var(--gray);
  margin: 18rpx 24rpx 0;
  line-height: 1.55;
}

/* ---------- 代码块 ---------- */

.code-block {
  background: var(--fill);
  border-radius: 20rpx;
  overflow: hidden;
  margin: 20rpx 0;
}

.code-lang {
  font-size: 24rpx;
  color: var(--gray);
  padding: 18rpx 28rpx 0;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.code-body {
  padding: 12rpx 28rpx 26rpx;
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-all;
}

.code-block-dark {
  background: rgba(255, 255, 255, 0.07);
}

.code-block-dark .code-body {
  color: var(--mist);
}

.code-block-dark .code-lang {
  color: rgba(191, 212, 255, 0.55);
}

/* ---------- 品牌图标 ---------- */

.brand-whale {
  width: 58rpx;
  height: 58rpx;
  margin-right: 7rpx;      /* 缩小一半 */
  margin-top: -8rpx;      /* 下移一点，与文字基线视觉对齐 */
  flex-shrink: 0;
}

/* ---------- 深海蓝背景（对齐 v1.7.2 HarnessAnimatedBackground 实际观感：
   亮蓝底 + 顶部辉光 + 斜向流体光带 + 底部压暗到近黑） ---------- */

.deep-bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  overflow: hidden;
  background: linear-gradient(180deg, #1D3A6B 0%, #17315B 38%, #0D2044 68%, #071527 100%);
  pointer-events: none;
}

/* 流体光效层（近似 iOS Metal 流体场：多层光带缓慢漂移 + 呼吸） */
.deep-fluid {
  position: absolute;
  left: -20%;
  top: -20%;
  right: -20%;
  bottom: -20%;
  background:
    linear-gradient(118deg, rgba(150, 185, 235, 0) 34%, rgba(165, 200, 245, 0.16) 46%, rgba(205, 226, 250, 0.10) 52%, rgba(150, 185, 235, 0) 63%),
    linear-gradient(62deg, rgba(120, 158, 215, 0) 42%, rgba(140, 175, 230, 0.13) 56%, rgba(120, 158, 215, 0) 70%),
    radial-gradient(85% 55% at 72% 8%, rgba(74, 124, 210, 0.40) 0%, rgba(30, 62, 120, 0) 62%),
    radial-gradient(110% 70% at 10% 36%, rgba(60, 104, 182, 0.30) 0%, rgba(22, 48, 95, 0) 62%);
  filter: blur(2rpx);
  will-change: transform, opacity;
  animation: fluidDrift 26s ease-in-out infinite alternate;
}

@keyframes fluidDrift {
  0%   { transform: translate3d(-2%, -1%, 0) scale(1.02); opacity: 0.85; }
  50%  { transform: translate3d(1.5%, 2%, 0) scale(1.06); opacity: 1; }
  100% { transform: translate3d(3%, -2%, 0) scale(1.03); opacity: 0.9; }
}

/* 缓慢加深的压暗层（背景颜色会慢慢变深） */
.deep-shade {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(2, 6, 14, 0) 42%, rgba(2, 6, 14, 0.34) 72%, rgba(0, 0, 0, 0.66) 100%);
  opacity: 0.55;
  will-change: opacity;
  animation: shadeBreath 22s ease-in-out infinite alternate;
}

@keyframes shadeBreath {
  0%   { opacity: 0.42; }
  100% { opacity: 1; }
}

/* Hero 区域光带（标题/卡片背后的一道柔光，缓慢明暗） */
.deep-glow {
  position: absolute;
  left: -12%;
  right: -12%;
  top: 16%;
  height: 46%;
  background:
    radial-gradient(60% 100% at 46% 42%, rgba(175, 210, 255, 0.26) 0%, rgba(120, 165, 235, 0.12) 42%, rgba(30, 70, 130, 0) 74%),
    linear-gradient(180deg, rgba(190, 220, 255, 0) 0%, rgba(190, 220, 255, 0.10) 38%, rgba(190, 220, 255, 0) 78%);
  filter: blur(24rpx);
  will-change: opacity, transform;
  animation: glowBreath 18s ease-in-out infinite alternate;
}

@keyframes glowBreath {
  0%   { opacity: 0.55; transform: translate3d(-1%, 4rpx, 0) scale(0.98); }
  50%  { opacity: 0.9; transform: translate3d(1%, -6rpx, 0) scale(1.03); }
  100% { opacity: 0.7; transform: translate3d(2%, 2rpx, 0) scale(1); }
}

/* 技术网格：42pt(84rpx) 方格，顶部实、向底部渐隐（iOS 同款遮罩，线色已调浅） */
.deep-grid {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-image:
    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.014) 0 1px, transparent 1px 84rpx),
    repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.014) 0 1px, transparent 1px 84rpx);
  -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.8) 0%, #000 56%, transparent 100%);
  mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.8) 0%, #000 56%, transparent 100%);
}

/* 鲸鱼粒子剪影：screen 混合（iOS WhaleField 同款 blendMode） */
.deep-whale {
  position: absolute;
  left: 50%;
  top: 34%;
  transform: translate(-50%, -50%);
  width: 862rpx;
  height: 862rpx;
  mix-blend-mode: screen;
  opacity: 1;
}
/* User-selected body family does not change the UI font size. */
.page { font-family: var(--dsh-font-family-text, -apple-system, BlinkMacSystemFont, sans-serif); }
