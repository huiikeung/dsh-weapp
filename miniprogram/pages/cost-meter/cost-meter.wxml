<import src="../../templates/quota-sidebar.wxml"/>
<view class="page page-dark home-root {{themeClass}}" style="{{contentFontStyle}}">
  <view class="cost-page {{themeClass}}">
    <view class="cost-nav" style="padding-top:{{navPadTop}}px;height:{{navHeight}}px;">
      <view class="cost-nav-back" bindtap="goBack" hover-class="cost-pressed" role="button" aria-label="{{ui['返回']}}">
        <image class="cost-nav-back-icon" src="/assets/icons/{{theme === 'dark' ? 'back-white.png' : 'back-black.png'}}"/>
      </view>
      <text class="cost-nav-title">{{ui['额度卡片']}}</text>
      <view class="cost-nav-refresh {{loading || refreshing ? 'is-loading' : ''}}" bindtap="onRefresh" hover-class="cost-pressed" role="button" aria-label="{{ui['刷新']}}">↻</view>
    </view>
    <view class="cost-nav-placeholder" style="height:{{navPadTop + navHeight}}px;"></view>

    <view wx:if="{{error}}" class="cost-notice {{!connected || !supported ? 'cost-notice-warn' : ''}}">
      <text class="cost-notice-title">{{!connected ? ui['尚未连接'] : !supported ? ui['网关尚未启用额度卡片'] : ui['读取失败']}}</text>
      <text class="cost-notice-body">{{error}}</text>
      <view wx:if="{{connected && supported}}" class="cost-retry" bindtap="onRefresh" role="button">{{ui['重试']}}</view>
    </view>

    <!-- 显示与左侧栏样式：开关决定下面所有分区是否展示 -->
    <view wx:if="{{connected && supported}}" class="cost-section">
      <text class="cost-section-title">{{ui['显示设置']}}</text>
      <view class="cost-card cost-entry-card">
        <view class="cost-row" bindtap="openDisplaySheet" role="button" aria-label="{{ui['显示设置']}}">
          <view class="cost-row-copy">
            <text class="cost-row-label">{{ui['左侧栏样式']}}</text>
            <text class="cost-row-hint">{{displayForm.sidebarStyle === 'summary' ? ui['合并卡片'] : displayForm.sidebarStyle === 'simple' ? ui['简洁'] : displayForm.sidebarStyle === 'compact' ? ui['紧凑'] : ui['标准']}} · {{ui['货币单位']}} {{displayForm.currency}}</text>
          </view>
          <view class="cost-row-value"><text class="cost-chevron">›</text></view>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row">
          <view class="cost-row-copy">
            <text class="cost-row-label">{{ui['显示额度卡片']}}</text>
            <text class="cost-row-hint">{{ui['在左侧栏显示余额与额度卡片']}}</text>
          </view>
          <switch color="#16856D" checked="{{displayForm.sidebarVisible}}" bindchange="toggleSidebarVisible"/>
        </view>
      </view>
    </view>

    <!-- 开关关闭时隐藏下面所有配置分区 -->
    <block wx:if="{{displayForm.sidebarVisible}}">

    <!-- ============ 显示：四个开关型组件合成一张卡 ============ -->
    <view wx:if="{{connected && supported && (balanceForm || goForm || budgetForm || peakForm)}}" class="cost-section">
      <text class="cost-section-title">{{ui['显示']}}</text>
      <view class="cost-card cost-entry-card">
        <block wx:if="{{balanceForm}}">
          <view class="cost-row" bindtap="openBalanceSheet" role="button" aria-label="{{ui['官方账户余额']}}">
            <view class="cost-row-copy">
              <text class="cost-row-label">{{ui['官方账户余额']}}</text>
              <text class="cost-row-hint">{{view.balance.status === 'ok' ? view.balance.amountText + ' · ' + ui['正常'] : (view.balance.message || ui['待刷新'])}}</text>
            </view>
            <switch color="#16856D" checked="{{balanceForm.enabled}}" bindchange="toggleBalance"/>
          </view>
          <view class="cost-divider"></view>
        </block>
        <block wx:if="{{goForm}}">
          <view class="cost-row" bindtap="openGoSheet" role="button" aria-label="{{ui['OpenCode Go 订阅额度']}}">
            <view class="cost-row-copy">
              <text class="cost-row-label">OpenCode Go</text>
              <text class="cost-row-hint">{{goForm.enabled ? (view.go && view.go.rows.length ? view.go.rows[0].percentText : ui['待刷新']) : ui['未启用']}}</text>
            </view>
            <switch color="#16856D" checked="{{goForm.enabled}}" bindchange="toggleGo"/>
          </view>
          <view class="cost-divider"></view>
        </block>
        <block wx:if="{{budgetForm}}">
          <view class="cost-row" bindtap="openBudgetSheet" role="button" aria-label="{{ui['预算']}}">
            <view class="cost-row-copy">
              <text class="cost-row-label">{{ui['预算']}}</text>
              <text class="cost-row-hint">{{budgetForm.enabled ? (budgetForm.amountText + ' · ' + budgetForm.percentText) : ui['未启用']}}</text>
            </view>
            <switch color="#16856D" checked="{{budgetForm.enabled}}" bindchange="toggleBudget"/>
          </view>
          <view class="cost-divider"></view>
        </block>
        <block wx:if="{{peakForm}}">
          <view class="cost-row" bindtap="openPeakSheet" role="button" aria-label="{{ui['峰谷时段']}}">
            <view class="cost-row-copy">
              <text class="cost-row-label">{{ui['峰谷时段']}}</text>
              <text class="cost-row-hint">{{peakForm.enabled ? (view.peak && view.peak.enabled ? (view.peak.label + ' · ' + view.peak.remainingText) : ui['待刷新']) : ui['未启用']}}</text>
            </view>
            <switch color="#16856D" checked="{{peakForm.enabled}}" bindchange="togglePeak"/>
          </view>
        </block>
      </view>
    </view>

    <!-- ============ 额度：Coding Plan / 网关 / 自定义全部收进一张卡 ============ -->
    <view wx:if="{{connected && supported}}" class="cost-section">
      <text class="cost-section-title">{{ui['额度']}}</text>
      <text class="cost-source-note">{{ui['逐家启用；凭据保存在电脑端 DSH 凭据库，移动端只显示是否已配置。点卡片配置。']}}</text>

      <view class="cost-card cost-entry-card">
        <!-- Coding Plan -->
        <block wx:if="{{planCells.length}}">
          <view class="cost-group-label">{{ui['Coding Plan 订阅额度']}}</view>
          <block wx:for="{{planCells}}" wx:key="id">
            <view class="cost-row" bindtap="openPlanSheet" data-index="{{index}}" role="button" aria-label="{{item.label}}">
              <view class="cost-row-copy">
                <text class="cost-row-label">{{item.label}}</text>
                <text class="cost-row-hint {{item.status === 'error' ? 'is-error' : ''}}">{{item.status === 'ok' ? (item.rows.length ? item.rows[0].percentText : ui['正常']) : item.status === 'unconfigured' ? ui['未配置凭据'] : item.status === 'off' ? ui['未启用或无订阅'] : item.message || ui['待刷新']}}</text>
              </view>
              <switch color="#16856D" checked="{{item.enabled}}" data-index="{{index}}" bindchange="togglePlan"/>
            </view>
            <view class="cost-divider"></view>
          </block>
        </block>

        <!-- CLIProxyAPI 网关 -->
        <block wx:if="{{gatewayCells.length}}">
          <view class="cost-group-label">{{ui['CLIProxyAPI 网关额度']}}</view>
          <block wx:for="{{gatewayCells}}" wx:key="id">
            <view class="cost-row" bindtap="openGatewaySheet" data-index="{{index}}" role="button" aria-label="{{item.label}}">
              <view class="cost-row-copy">
                <text class="cost-row-label">{{item.label || item.id}}</text>
                <text class="cost-row-hint {{item.status === 'error' ? 'is-error' : ''}}">{{item.status === 'ok' ? (item.accounts.length ? item.accounts.length + ' ' + ui['个账号'] : ui['正常']) : item.status === 'partial' ? ui['部分可用'] : item.message || ui['待刷新']}}</text>
              </view>
              <switch color="#16856D" checked="{{item.enabled}}" data-index="{{index}}" bindchange="toggleGateway"/>
            </view>
            <view class="cost-divider"></view>
          </block>
        </block>

        <!-- 自定义 Provider -->
        <block wx:if="{{customCells.length}}">
          <view class="cost-group-label">{{ui['自定义 Provider 余额']}}</view>
          <block wx:for="{{customCells}}" wx:key="index">
            <view class="cost-row" bindtap="openCustomSheet" data-index="{{index}}" role="button" aria-label="{{item.label}}">
              <view class="cost-row-copy">
                <text class="cost-row-label">{{item.label || ui['自定义余额']}}</text>
                <text class="cost-row-hint {{item.status === 'error' ? 'is-error' : ''}}">{{item.status === 'ok' ? item.amountText : item.message || ui['待刷新']}}</text>
              </view>
              <switch color="#16856D" checked="{{item.enabled}}" data-index="{{index}}" bindchange="toggleCustom"/>
            </view>
            <view wx:if="{{index < customCells.length - 1}}" class="cost-divider"></view>
          </block>
        </block>

        <!-- 卡内添加入口：与行样式一致，点一下新增来源 -->
        <view class="cost-divider"></view>
        <view class="cost-row" bindtap="addGateway" role="button">
          <view class="cost-row-copy"><text class="cost-row-label cost-row-add">{{ui['＋ 添加网关额度来源']}}</text></view>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row" bindtap="addCustom" role="button">
          <view class="cost-row-copy"><text class="cost-row-label cost-row-add">{{ui['＋ 添加自定义余额']}}</text></view>
        </view>
      </view>

      <view class="cost-preset-row">
        <view class="cost-mini-btn" bindtap="addCustomPreset" data-kind="aliyun">{{ui['＋ 千问 / 阿里云余额']}}</view>
        <view class="cost-mini-btn" bindtap="addCustomPreset" data-kind="tokenrhythm">{{ui['＋ Token Rhythm 余额']}}</view>
        <view class="cost-mini-btn" bindtap="addCustomPreset" data-kind="workbuddy">{{ui['＋ WorkBuddy2API 积分']}}</view>
        <view class="cost-mini-btn" bindtap="addCustomPreset" data-kind="saibo">{{ui['＋ 赛博 / Saibo 余额']}}</view>
      </view>
    </view>
    </block>

    <view wx:if="{{loading && !view}}" class="cost-loading"><view class="cost-spinner"></view><text>{{ui['正在读取额度…']}}</text></view>
  </view>

  <!-- ============ 弹窗：显示设置（含侧栏预览与确认） ============ -->
  <view wx:if="{{sheet === 'display'}}" class="cost-sheet-mask" bindtap="closeSheet">
    <view class="cost-sheet {{sheetDragging ? 'dragging' : ''}}" style="transform: translateY({{sheetDragY}}px);" catchtap="noop">
      <view class="cost-sheet-grabber" catchtouchstart="onSheetGrabStart" catchtouchmove="onSheetGrabMove" catchtouchend="onSheetGrabEnd" aria-hidden="true">
        <view class="cost-sheet-grabbar"></view>
      </view>
      <view class="cost-sheet-head">
        <text class="cost-sheet-title">{{ui['显示设置']}}</text>
        <view class="cost-sheet-close" bindtap="closeSheet" role="button" aria-label="{{ui['关闭']}}">✕</view>
      </view>
      <scroll-view scroll-y class="cost-sheet-body">
        <view class="cost-row" bindtap="pickCurrency" role="button">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['货币单位']}}</text><text class="cost-row-hint">{{ui['显示金额使用的币种']}}</text></view>
          <view class="cost-row-value">{{displayForm.currency}}<text class="cost-chevron">›</text></view>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['货币符号']}}</text><text class="cost-row-hint">{{ui['金额前缀，留空自动选择']}}</text></view>
          <input class="cost-inline-input" value="{{displayForm.symbol}}" bindinput="onSymbolInput" bindblur="commitDisplay" maxlength="8"/>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['小数位数']}}</text><text class="cost-row-hint">{{ui['2–6 位']}}</text></view>
          <input class="cost-inline-input short" type="number" value="{{displayForm.decimals}}" bindinput="onDecimalsInput" bindblur="commitDisplay" maxlength="1"/>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['汇率']}}</text><text class="cost-row-hint">{{ui['1 美元 = ? 目标币种']}}</text></view>
          <input class="cost-inline-input" type="digit" value="{{displayForm.exchangeRate}}" bindinput="onExchangeRateInput" bindblur="commitDisplay"/>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['在左侧栏显示额度卡片']}}</text><text class="cost-row-hint">{{ui['关闭后侧栏不显示额度卡片']}}</text></view>
          <switch color="#16856D" checked="{{displayForm.sidebarVisible}}" bindchange="toggleSidebarVisible"/>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row" bindtap="pickTodayMetric" role="button">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['今日显示项']}}</text><text class="cost-row-hint">{{ui['侧栏今日行显示金额 / Token / 两者']}}</text></view>
          <view class="cost-row-value">{{displayForm.sidebarTodayMetric === 'amount' ? ui['仅金额'] : displayForm.sidebarTodayMetric === 'tokens' ? ui['仅 Token'] : ui['金额 + Token']}}<text class="cost-chevron">›</text></view>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row" bindtap="pickPeakTimeDisplay" role="button">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['峰谷时间显示']}}</text><text class="cost-row-hint">{{ui['倒计时与切换时间的显示方式']}}</text></view>
          <view class="cost-row-value">{{displayForm.peakTimeDisplay === 'countdown' ? ui['只看倒计时'] : displayForm.peakTimeDisplay === 'switch' ? ui['只看切换时间'] : ui['倒计时 + 切换时间']}}<text class="cost-chevron">›</text></view>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['今日与余额同行']}}</text><text class="cost-row-hint">{{ui['侧栏今日行与余额行并排显示']}}</text></view>
          <switch color="#16856D" checked="{{displayForm.sidebarTodayBalanceInline}}" bindchange="toggleTodayInline"/>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row" bindtap="pickBalanceBarDirection" role="button">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['余额进度条方向']}}</text><text class="cost-row-hint">{{ui['已用或剩余']}}</text></view>
          <view class="cost-row-value">{{balanceForm.barDirection === 'used' ? ui['已用'] : ui['剩余']}}<text class="cost-chevron">›</text></view>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row" bindtap="pickBudgetBarDirection" role="button">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['预算进度条方向']}}</text><text class="cost-row-hint">{{ui['已用或剩余']}}</text></view>
          <view class="cost-row-value">{{budgetForm.barDirection === 'used' ? ui['已用'] : ui['剩余']}}<text class="cost-chevron">›</text></view>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row" bindtap="pickPeakStyle" role="button">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['峰谷样式']}}</text><text class="cost-row-hint">{{ui['进度条或经典条']}}</text></view>
          <view class="cost-row-value">{{displayForm.peakStyle === 'classic' ? ui['经典'] : ui['进度条']}}<text class="cost-chevron">›</text></view>
        </view>

        <!-- 侧栏样式选择 + 实时预览 -->
        <view class="cost-divider"></view>
        <view class="cost-row-block">
          <text class="cost-row-label">{{ui['侧栏样式']}}</text>
          <view class="cost-style-row">
            <view wx:for="{{styleOptions}}" wx:key="id" class="cost-style-chip {{displayForm.sidebarStyle === item.id ? 'active' : ''}}" bindtap="pickSidebarStyle" data-id="{{item.id}}">
              <text>{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
            </view>
          </view>
          <view class="cost-preview">
            <view class="cost-preview-rail">
              <view class="cost-preview-brand"><view class="cost-preview-dot"></view><view class="cost-preview-dot"></view><view class="cost-preview-dot"></view></view>
              <text class="cost-preview-rail-label">{{ui['工作区']}}</text>
            </view>
            <scroll-view scroll-y class="cost-preview-body">
              <block wx:if="{{previewSidebar}}">
                <view class="drawer-quota drawer-quota-{{previewSidebar.style}}">
                  <template is="quota-sidebar" data="{{sections: previewSections, mode: previewSidebar.style, model: previewSidebar, ui: ui}}"/>
                </view>
                <view class="drawer-footer"><view class="drawer-item drawer-settings"><image class="drawer-item-ic" src="/assets/icons/settings-white.svg" mode="aspectFit"/><text class="drawer-item-text">{{ui['设置']}}</text></view></view>
              </block>
              <view wx:elif="{{!previewSidebar}}" class="cost-preview-empty">{{ui['侧栏卡片已关闭，打开「在左侧栏显示额度卡片」后可见']}}</view>
            </scroll-view>
          </view>
          <text class="cost-source-note">{{ui['预览使用当前额度数据；切换样式可对比四种布局。']}}</text>
        </view>

        <!-- 组件检查器 -->
        <view class="cost-divider"></view>
        <view class="cost-row-block">
          <text class="cost-row-label">{{ui['调整组件']}}</text>
          <view class="cost-row" bindtap="pickPreviewComponent" role="button">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['组件']}}</text></view>
            <view class="cost-row-value">{{previewComponentLabel}}<text class="cost-chevron">›</text></view>
          </view>
          <view class="cost-row">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['显示此组件']}}</text></view>
            <switch color="#16856D" checked="{{previewComponentEnabled}}" bindchange="togglePreviewComponent"/>
          </view>
          <view wx:if="{{previewComponent === 'budget'}}" class="cost-row">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['预算图框详细信息']}}</text></view>
            <switch color="#16856D" checked="{{budgetForm.detail}}" bindchange="toggleBudgetDetail"/>
          </view>
          <view wx:if="{{previewComponent === 'budget'}}" class="cost-row">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['今日消费与余额同行']}}</text></view>
            <switch color="#16856D" checked="{{displayForm.sidebarTodayBalanceInline}}" bindchange="toggleTodayInline"/>
          </view>
          <view wx:if="{{previewComponent === 'balance'}}" class="cost-row">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['显示进度条']}}</text></view>
            <switch color="#16856D" checked="{{balanceForm.showProgressBar}}" bindchange="toggleBalanceProgress"/>
          </view>
          <view wx:if="{{previewComponent === 'go'}}" class="cost-row">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['显示详情']}}</text></view>
            <switch color="#16856D" checked="{{goForm.detail}}" bindchange="toggleGoDetail"/>
          </view>
          <view class="cost-row">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['显示位置']}}</text></view>
            <view class="cost-row-value" bindtap="pickPreviewDisplay">{{previewComponentDisplayLabel}}<text class="cost-chevron">›</text></view>
          </view>
        </view>

        <!-- 侧栏卡片顺序 -->
        <view class="cost-divider"></view>
        <view class="cost-row-block">
          <text class="cost-row-label">{{ui['侧栏卡片顺序']}}</text>
          <text class="cost-row-hint">{{ui['用上下按钮调整左侧栏卡片的先后顺序']}}</text>
          <view class="cost-order-list">
            <view wx:for="{{sidebarOrderCells}}" wx:key="key" class="cost-order-row">
              <text class="cost-order-index">{{index + 1}}</text>
              <text class="cost-order-label">{{item.label}}</text>
              <view class="cost-order-actions">
                <view class="cost-mini-btn {{index === 0 ? 'is-disabled' : ''}}" bindtap="moveSidebarOrder" data-index="{{index}}" data-dir="-1">{{ui['上移']}}</view>
                <view class="cost-mini-btn {{index === sidebarOrderCells.length - 1 ? 'is-disabled' : ''}}" bindtap="moveSidebarOrder" data-index="{{index}}" data-dir="1">{{ui['下移']}}</view>
              </view>
            </view>
          </view>
          <view class="cost-row-buttons">
            <view class="cost-mini-btn" bindtap="resetSidebarOrder">{{ui['恢复默认顺序']}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="cost-sheet-foot">
        <view class="cost-sheet-btn primary" bindtap="closeSheet" role="button">{{ui['完成']}}</view>
      </view>
    </view>
  </view>

  <!-- ============ 弹窗：官方余额 ============ -->
  <view wx:if="{{sheet === 'balance'}}" class="cost-sheet-mask" bindtap="closeSheet">
    <view class="cost-sheet {{sheetDragging ? 'dragging' : ''}}" style="transform: translateY({{sheetDragY}}px);" catchtap="noop">
      <view class="cost-sheet-grabber" catchtouchstart="onSheetGrabStart" catchtouchmove="onSheetGrabMove" catchtouchend="onSheetGrabEnd" aria-hidden="true">
        <view class="cost-sheet-grabbar"></view>
      </view>
      <view class="cost-sheet-head">
        <text class="cost-sheet-title">{{ui['官方账户余额']}}</text>
        <view class="cost-sheet-close" bindtap="closeSheet" role="button" aria-label="{{ui['关闭']}}">✕</view>
      </view>
      <scroll-view scroll-y class="cost-sheet-body">
        <view class="cost-row">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['启用官方余额']}}</text><text class="cost-row-hint">{{ui['优先读取 DSH 登录账号余额']}}</text></view>
          <switch color="#16856D" checked="{{balanceForm.enabled}}" bindchange="toggleBalance"/>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row" bindtap="pickBalanceDisplay" role="button">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['显示位置']}}</text></view>
          <view class="cost-row-value">{{balanceForm.display === 'both' ? ui['侧栏 + 设置页'] : balanceForm.display === 'sidebar' ? ui['仅侧栏'] : balanceForm.display === 'settings' ? ui['仅设置页'] : ui['关闭']}}<text class="cost-chevron">›</text></view>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row" bindtap="pickBalanceRefresh" role="button">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['刷新间隔']}}</text></view>
          <view class="cost-row-value">{{balanceForm.refreshMinutes}} {{ui['分钟']}}<text class="cost-chevron">›</text></view>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-row">
