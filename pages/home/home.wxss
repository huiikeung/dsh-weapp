/* 内容水平边距对齐 iOS WorkspaceView：.padding(.horizontal, 22) = 44rpx */
.home {
  padding: 30rpx 44rpx 60rpx;
}

/* ---------- 侧边栏（对齐 dsh-mobile WorkspaceView drawer） ---------- */

.home-root {
  position: relative;
  height: 100vh;
  overflow: hidden;
  /* 内容右移后露出的底层：浅色白 / 深色 #242426（对齐 iOS drawer 底色） */
  background: #FFFFFF;
}

@media (prefers-color-scheme: dark) {
  .home-root {
    background: #242426;
  }
}

.home-content-wrap {
  position: relative;
  height: 100vh;
  background: var(--navy);
  transition: border-radius 0.38s cubic-bezier(0.32, 0.72, 0, 1);
}

.home-content-wrap.shifted {
  border-radius: 96rpx;
  overflow: hidden;
  box-shadow: -4rpx 0 18rpx rgba(0, 0, 0, 0.12), -8rpx 0 52rpx rgba(0, 0, 0, 0.30);
}

/* 深海背景随内容位移：fixed → absolute（相对位移容器） */
.home-deep-bg {
  position: absolute;
}

.home-scroll {
  position: relative;
  height: 100vh;
}

.drawer-anim {
  transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1);
}

.drawer {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 52;
  background: #FFFFFF;
  transform: translateX(-100%);
}

@media (prefers-color-scheme: dark) {
  .drawer {
    background: #242426;
  }
}

.drawer-visible {
  box-shadow: 8rpx 0 40rpx rgba(0, 0, 0, 0.18);
}

.drawer-body {
  padding: calc(20rpx + env(safe-area-inset-top)) 36rpx 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.drawer-brand {
  padding: 0 0 32rpx 24rpx;
  width: 100%;
}

.drawer-wordmark {
  width: 100%;
  max-width: 432rpx;
  height: 48rpx;
}

.drawer-wordmark-dark {
  display: none;
}

.drawer-item {
  display: flex;
  align-items: center;
  width: 100%;
  height: 104rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
}

.drawer-item-active {
  background: rgba(16, 19, 24, 0.06);
}

.drawer-item-ic {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.drawer-item-ic-clock {
  width: 40rpx;
  height: 40rpx;
  margin-left: 2rpx;
  margin-right: 22rpx;
}

.drawer-item-ic-dark {
  display: none;
}

.drawer-item-text {
  font-size: 34rpx;
  color: var(--ink);
}

@media (prefers-color-scheme: dark) {
  .drawer-item-text {
    color: #F1F4FA;
  }
  .drawer-wordmark-light,
  .drawer-item-ic:not(.drawer-item-ic-dark) {
    display: none;
  }
  .drawer-wordmark-dark,
  .drawer-item-ic-dark {
    display: block;
  }
  .drawer-item-active {
    background: rgba(241, 244, 250, 0.08);
  }
}

.drawer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.16);
}

.brand-dim {
  opacity: 0.7;
}


/* 顶部品牌行：固定在导航区（与胶囊同行），左边距与内容区对齐，不随内容滚动 */
.topbar {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  /* 与内容区同边距：品牌行 / 选择主机 / 标题 / 卡片左边缘严格对齐 */
  padding-left: 44rpx;
  padding-right: 44rpx;
  /* 透明：让深海背景自然延续到顶，不再出现深色条断层 */
  background: transparent;
}

.host-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.host-row .host-bar {
  margin-bottom: 0;
  min-width: 0;
}

.host-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-mark {
  font-size: 40rpx;
  margin-right: 14rpx;
}

.brand-text {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.brand-badge {
  color: var(--mist);
  border: 2rpx solid rgba(191, 212, 255, 0.5);
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1;
  padding: 8rpx 14rpx;
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

/* ---------- 配对菜单（对齐 dsh-mobile GatewayAuthenticationMenu） ---------- */

.pair-wrap {
  position: relative;
}

.pair-menu-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
}

/* 配对菜单：与底部弹窗同款深炭玻璃（深色底 + 强模糊 + 发丝亮边） */
.pair-menu {
  position: absolute;
  top: calc(100% + 12rpx);
  right: 0;
  z-index: 100;
  width: 496rpx;
  padding: 12rpx 0;
  background: rgba(10, 14, 24, 0.30);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx) saturate(1.2);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.2);
  border-radius: 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30);
  overflow: hidden;
}

.pair-menu-item {
  display: flex;
  align-items: center;
  height: 116rpx;
  padding: 0 44rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.pair-menu-item-active {
  background: rgba(255, 255, 255, 0.08);
}

.pair-menu-ic {
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 18rpx;
  flex-shrink: 0;
  font-size: 38rpx;
  /* Liquid Glass 圆钮：左上高光渐变 + 顶部内发光 + 发丝亮边 */
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 8rpx 24rpx rgba(3, 14, 30, 0.24);
}

/* Hero（iOS：32pt bold 标题 + subheadline 副标题；区块间距 18pt = 36rpx） */
.hero {
  margin-bottom: 36rpx;
}

.title-hero {
  color: #FFFFFF;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.subtitle-hero {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 30rpx;
}

/* 工作区卡片（与新建会话同款玻璃：渐变高光 + 顶部内发光 + 模糊提饱和） */
.workspace-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 36rpx;
  border-radius: 36rpx;
  /* 与「新建会话」同一套 Liquid Glass：高光渐变 + 发丝亮边 + 内高光 */
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 8rpx 32rpx rgba(3, 14, 30, 0.18);
}

.ws-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.ws-body {
  flex: 1;
  min-width: 0;
}

.ws-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.ws-path {
  color: rgba(255, 255, 255, 0.55);
  font-size: 24rpx;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ws-right {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.ws-chevron {
  width: 30rpx;
  height: 30rpx;
  margin-left: 18rpx;
}

/* 新建会话（iOS glassSurface radius 18pt + white 8% tint） */
.new-session {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  border-radius: 36rpx;
  padding: 34rpx 0;
  margin-bottom: 36rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 8rpx 32rpx rgba(3, 14, 30, 0.18);
  transition: transform 0.18s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.18s ease;
}

.new-session:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.plus-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.20);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 22rpx;
}

.new-session-text {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.conn-label {
  font-size: 26rpx;
}

.conn-label.connected { color: var(--success); }
.conn-label.connecting { color: var(--amber); }
.conn-label.disconnected { color: rgba(255, 255, 255, 0.60); }
.conn-label.failed { color: #FF8589; }

.status-dot.connecting { background: var(--amber); }
.status-dot.disconnected { background: rgba(255, 255, 255, 0.34); }
.status-dot.failed { background: #FF8589; }

/* 搜索框（与新建会话同款玻璃：渐变高光 + 顶部内发光 + 模糊提饱和） */
.search-box {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  margin-bottom: 36rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 8rpx 32rpx rgba(3, 14, 30, 0.16);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-result-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

/* 配对按钮：对齐 dsh-mobile GlassCircleButton 52dp/22dp 比例 */
.pair-ic {
  width: 48rpx;
  height: 48rpx;
}

.plus-img {
  width: 30rpx;
  height: 30rpx;
}

.search-input {
  flex: 1;
  color: #FFFFFF;
  font-size: 29rpx;
}

.home-data-hint {
  margin: -20rpx 0 16rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 24rpx;
}

/* 会话行（iOS sessionRow：padding-v 10pt / 间距 11pt / 点 7pt /
   分隔线 white 10% 缩进 18pt） */
.session-row {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  position: relative;
  background: transparent;
  border-radius: 16rpx;
}

.session-row::after {
  content: '';
  position: absolute;
  left: 36rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.10);
}

.session-row:last-child::after {
  display: none;
}

.session-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  margin-right: 22rpx;
  flex-shrink: 0;
}

.session-dot.running {
  background: var(--success);
  box-shadow: 0 0 10rpx rgba(46, 184, 92, 0.65);
}

.session-dot.unread {
  background: var(--ocean);
}

.session-body {
  flex: 1;
  min-width: 0;
}

.session-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-sub {
  color: rgba(255, 255, 255, 0.42);
  font-size: 22rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  color: rgba(255, 255, 255, 0.48);
  font-size: 24rpx;
  margin-left: 18rpx;
  flex-shrink: 0;
}

.session-time.running {
  color: #0A84FF;
}

/* 空态（iOS emptySessions：white 4% 底 / radius 15pt / padding 18pt / 左对齐） */
.empty {
  color: rgba(255, 255, 255, 0.5);
  text-align: left;
  padding: 36rpx;
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 30rpx;
}

/* ---------- 切换主机（GatewaySwitcherBar / Sheet） ---------- */

.host-bar {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025));
  border: 1rpx solid rgba(255, 255, 255, 0.20);
  border-radius: 999rpx;
  margin-bottom: 48rpx;
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 8rpx 24rpx rgba(3, 14, 30, 0.22);
}

.host-kind {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.host-name {
  color: #FFFFFF;
  font-size: 24rpx;
  max-width: 340rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.host-dot {
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #8E8E93;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.host-dot.on {
  background: var(--success);
}

.host-chev {
  width: 22rpx;
  height: 22rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.host-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 60;
}

/* 主机切换 sheet（对齐 iOS 高 detent 弹层：深炭玻璃 + 抓手 +
   居中标题 + 左侧编辑玻璃钮 + 内嵌分组卡片；
   默认紧凑高度，抓手拖拽/点击展开到近全屏） */
.host-sheet {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 61;
  display: flex;
  flex-direction: column;
  height: auto;
  max-height: 86vh;
  background: rgba(10, 14, 24, 0.30);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx) saturate(1.2);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.2);
  border-radius: 40rpx;
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30);
  transition: height 0.5s cubic-bezier(0.32, 0.72, 0, 1);
}

.host-sheet.expanded {
  height: calc(100vh - 200rpx);
}

.workspace-picker-sheet.expanded {
  height: calc(100vh - 200rpx);
}

.sheet-grabber-zone {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 4rpx;
  flex-shrink: 0;
}

.host-sheet-head {
  position: relative;
  display: flex;
  align-items: center;
  height: 96rpx;
  flex-shrink: 0;
}

.host-sheet-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  pointer-events: none;
}

.host-sheet-left {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.host-sheet-edit {
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.30);
}

.host-sheet-del {
  color: #FF3B30;
  font-size: 26rpx;
  margin-right: 20rpx;
}

.host-diag {
  font-size: 24rpx;
  color: rgba(255, 176, 92, 0.95);
  padding: 10rpx 6rpx 0;
}

.host-section-label {
  color: rgba(255, 255, 255, 0.50);
  font-size: 28rpx;
  font-weight: 600;
  margin: 12rpx 8rpx 16rpx;
  flex-shrink: 0;
}

.host-list {
  flex: 1;
  overflow-y: auto;
}

.host-group {
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  overflow: hidden;
}

.host-opt {
  position: relative;
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
}

.host-opt::after {
  content: '';
  position: absolute;
  left: 100rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.10);
}

.host-opt:last-child::after {
  display: none;
}

.host-select {
  display: flex;
  align-items: center;
  margin-right: 18rpx;
}

.host-select-ic {
  width: 40rpx;
  height: 40rpx;
}

.host-row-kind {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.host-row-body {
  flex: 1;
  min-width: 0;
}

.host-row-name {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.host-row-sub {
  color: rgba(255, 255, 255, 0.45);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.host-row-sub.on {
  color: rgba(255, 255, 255, 0.60);
}

.host-edit {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.host-edit-ic {
  width: 32rpx;
  height: 32rpx;
}

.host-empty {
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
}

.host-edit-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 63;
  background: rgba(10, 14, 24, 0.30);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx) saturate(1.2);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.2);
  border-radius: 40rpx 40rpx 0 0;
  padding: 34rpx 34rpx 60rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.28), 0 10rpx 40rpx rgba(3, 14, 30, 0.38);
}

.host-edit-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.host-edit-hint {
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  margin-bottom: 24rpx;
}

.host-edit-input {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 20rpx;
  color: #FFFFFF;
  font-size: 27rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 26rpx;
}

.host-edit-ph {
  color: rgba(255, 255, 255, 0.35);
}

.host-edit-sub {
  color: rgba(255, 255, 255, 0.55);
  font-size: 23rpx;
  margin-bottom: 14rpx;
}

.host-kind-row {
  display: flex;
  margin-bottom: 30rpx;
}

.host-kind-opt {
  color: rgba(255, 255, 255, 0.6);
  font-size: 25rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 12rpx 34rpx;
  margin-right: 20rpx;
}

.host-kind-opt.on {
  color: #FFFFFF;
  background: var(--ocean);
  border-color: var(--ocean);
}

.host-edit-actions {
  display: flex;
}

.host-edit-btn-cancel {
  flex: 1;
  text-align: center;
  color: rgba(255, 255, 255, 0.65);
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 22rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  margin-right: 20rpx;
}

.host-edit-btn-save {
  flex: 1;
  text-align: center;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 22rpx 0;
  background: var(--ocean);
}

/* ---------- 工作区选择弹窗 ---------- */

.workspace-picker-sheet {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 61;
  display: flex;
  flex-direction: column;
  height: auto;
  max-height: 86vh;
  background: rgba(10, 14, 24, 0.30);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx) saturate(1.2);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.2);
  border-radius: 40rpx;
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30);
  transition: height 0.5s cubic-bezier(0.32, 0.72, 0, 1);
}

.picker-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.picker-sheet-title {
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
}

.picker-sheet-close {
  color: rgba(255, 255, 255, 0.60);
  font-size: 28rpx;
}

.picker-list {
  max-height: 55vh;
  overflow-y: auto;
}

.picker-row {
  display: flex;
  align-items: center;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.picker-row-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.picker-row-body {
  flex: 1;
  min-width: 0;
}

.picker-row-title {
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-row-path {
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-row-check {
  width: 36rpx;
  height: 36rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.picker-empty {
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
}

.picker-new {
  margin-top: 50rpx;
}

/* ---------- 目录浏览器弹层（对齐 dsh-mobile v1.6.0 WorkspaceDirectoryBrowserSheet） ---------- */

.dir-sheet {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 62;
  display: flex;
  flex-direction: column;
  height: 80vh;
  background: rgba(10, 14, 24, 0.30);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx) saturate(1.2);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.2);
  border-radius: 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.dir-sheet-handle {
  width: 76rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(241, 244, 250, 0.30);
  margin: 16rpx auto 8rpx;
  flex-shrink: 0;
}

.dir-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 132rpx;
  padding: 0 36rpx;
  flex-shrink: 0;
}

.dir-head-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #F1F4FA;
}

.dir-head-btn {
  position: absolute;
  left: 36rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dir-head-btn.disabled {
  opacity: 0.4;
}

.dir-head-folder {
  width: 52rpx;
  height: 52rpx;
}

.dir-head-badge {
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #171A20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dir-head-badge text {
  font-size: 22rpx;
  line-height: 22rpx;
  font-weight: 700;
  color: #F1F4FA;
  margin-top: -4rpx;
}

.dir-head-cancel {
  position: absolute;
  right: 36rpx;
  height: 96rpx;
  padding: 0 40rpx;
  border-radius: 48rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #F1F4FA;
}

.dir-cwd {
  padding: 0 44rpx;
  flex-shrink: 0;
}

.dir-cwd-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(241, 244, 250, 0.52);
}

.dir-cwd-path {
  display: block;
  font-size: 26rpx;
  color: rgba(241, 244, 250, 0.40);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dir-list-card {
  flex: 1;
  min-height: 0;
  margin: 28rpx 36rpx 0;
  background: #22262D;
  border-radius: 56rpx 56rpx 0 0;
  overflow: hidden;
}

.dir-list {
  height: 100%;
  box-sizing: border-box;
  padding: 20rpx 36rpx;
}

.dir-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 80rpx 0;
  color: rgba(241, 244, 250, 0.58);
  font-size: 30rpx;
}

.dir-row {
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
}

.dir-row.disabled {
  opacity: 0.3;
}

.dir-row.highlight {
  background: rgba(46, 107, 230, 0.20);
}

.dir-row-hover {
  background: rgba(241, 244, 250, 0.06);
}

.dir-row-icon {
  position: relative;
  width: 68rpx;
  flex-shrink: 0;
}

.dir-row-ic {
  width: 50rpx;
  height: 50rpx;
}

.dir-row-badge {
  position: absolute;
  right: 6rpx;
  top: -6rpx;
  width: 26rpx;
  height: 26rpx;
}

.dir-row-body {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.dir-row-name {
  display: block;
  font-size: 32rpx;
  color: #F1F4FA;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dir-row-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(241, 244, 250, 0.46);
  margin-top: 2rpx;
}

.dir-row-chev {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.dir-divider {
  height: 1rpx;
  margin-left: 116rpx;
  background: rgba(241, 244, 250, 0.10);
}

.dir-create-bar {
  padding: 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.dir-create-path {
  font-size: 24rpx;
  color: rgba(241, 244, 250, 0.42);
  max-width: 100%;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dir-create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 104rpx;
  border-radius: 28rpx;
  background: #000000;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.dir-create-btn.disabled {
  opacity: 0.45;
}

.dir-create-add {
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
}

.dir-creating-hint {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: rgba(241, 244, 250, 0.52);
  font-size: 24rpx;
}

.dir-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(241, 244, 250, 0.25);
  border-top-color: rgba(241, 244, 250, 0.9);
  border-radius: 50%;
  animation: dir-spin 0.8s linear infinite;
}

.dir-spinner.small {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
  margin-right: 16rpx;
}

.dir-spinner.light {
  border-color: rgba(255, 255, 255, 0.30);
  border-top-color: #FFFFFF;
  width: 38rpx;
  height: 38rpx;
  margin-right: 18rpx;
}

@keyframes dir-spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---------- 手动配对弹层（对齐 dsh-mobile v1.6.0 ManualGatewayPairingSheet） ---------- */

.manual-sheet {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 62;
  display: flex;
  flex-direction: column;
  height: auto;
  max-height: 62vh;
  background: rgba(10, 14, 24, 0.30);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 40rpx;
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
  backdrop-filter: blur(20rpx) saturate(1.2);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.2);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30);
  transition: height 0.5s cubic-bezier(0.32, 0.72, 0, 1);
}

.manual-sheet.expanded {
  height: calc(100vh - 200rpx);
  max-height: none;
}

.manual-sheet-head {
  position: relative;
  display: flex;
  align-items: center;
  height: 96rpx;
  flex-shrink: 0;
}

.manual-sheet-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  pointer-events: none;
}

.manual-sheet-done {
  position: absolute;
  right: 0;
  height: 96rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 500;
  color: #10141A;
}

.manual-sheet-body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 44rpx;
}

.manual-sec-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #F1F4FA;
}

.manual-sec-desc {
  font-size: 30rpx;
  line-height: 1.5;
  color: rgba(241, 244, 250, 0.52);
  margin: 12rpx 0 44rpx;
}

.manual-input {
  width: 100%;
  min-height: 420rpx;
  box-sizing: border-box;
  background: rgba(241, 244, 250, 0.025);
  border: 1rpx solid rgba(241, 244, 250, 0.10);
  border-radius: 40rpx;
  padding: 32rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: rgba(241, 244, 250, 0.88);
}

.manual-input-ph {
  color: rgba(241, 244, 250, 0.25);
}

.manual-result {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.manual-result.connecting {
  color: var(--mist);
}

.manual-result.error {
  color: #FF8589;
}

.manual-connect {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100rpx;
  border-radius: 32rpx;
  background: var(--ocean);
  margin-top: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.manual-connect.disabled {
  background: rgba(46, 107, 230, 0.45);
}

.manual-connect-ic {
  width: 40rpx;
  height: 40rpx;
  margin-right: 18rpx;
}

.small-spin {
  width: 38rpx;
  height: 38rpx;
  border-width: 3rpx;
  margin-right: 18rpx;
}
