    <view class="sheet-grabber-zone" data-sheet="procIcon" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
    <view class="status-style-head"><view><view class="status-style-title">{{ui['执行图标']}}</view><view class="status-style-hint">{{ui['只改变执行中标题前的方形动效，标题与步骤保持不变']}}</view></view></view>
    <scroll-view class="status-style-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{procIconChoices}}" wx:key="id" class="status-style-option {{procIconStyle === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseProcIcon" role="button" aria-label="{{ui[item.label] !== undefined ? ui[item.label] : item.label}} {{procIconStyle === item.id ? ui['已选择'] : ''}}">
        <view class="status-style-option-head"><text class="status-style-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text><text class="status-style-check">{{procIconStyle === item.id ? ui['已选择'] : ''}}</text></view>
        <view class="status-style-preview proc-preview"><view class="proc-loader proc-look-{{item.id}}"><template is="procIconGlyph" data="{{styleId: item.id}}" /></view><text class="proc-preview-title">{{ui['正在执行命令']}}</text></view>
