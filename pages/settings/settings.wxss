.settings {
  padding: 20rpx 40rpx 80rpx;
}

.chevron {
  color: var(--gray);
  font-size: 34rpx;
  margin-left: 12rpx;
}

.chevron-img {
  width: 26rpx;
  height: 26rpx;
  margin-left: 12rpx;
  opacity: 0.55;
}

.check-img {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.gw-url {
  font-size: 28rpx;
  color: var(--ink);
  word-break: break-all;
}

.gw-status {
  display: flex;
  align-items: center;
}

.gw-cwd {
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exp-copy {
  display: flex;
  flex-direction: column;
  margin-right: 24rpx;
  flex: 1;
}

.exp-desc {
  font-size: 24rpx;
  color: var(--gray);
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 双主题：基础样式已全部变量化（app.wxss / 上方规则），无需 page-dark 覆盖 */
