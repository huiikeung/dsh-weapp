}

.dir-row-chev {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.dir-divider {
  height: 1rpx;
  margin-left: 108rpx;
  background: rgba(241, 244, 250, 0.07);
}

.dir-create-bar {
  padding: 18rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.dir-create-path {
  font-size: 24rpx;
  color: rgba(241, 244, 250, 0.42);
  max-width: 100%;
  margin-bottom: 16rpx;
