/* 三横线：保持原有字形（100% / 78% / 90%，右对齐）。
   总宽 34→30rpx（三条等比收短），线粗 3rpx，间距 12→8rpx（1:2.7，不再散）。 */
.session-switch-lines {
  width: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.session-switch-lines view {
  width: 100%;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}
.session-switch-lines view:nth-child(2) { width: 78%; }
.session-switch-lines view:nth-child(3) { width: 90%; }
/* 浼氳瘽蹇嵎鍒囨崲锛氫笌瀵硅瘽鑺傜偣涓€鑷寸殑鍏ㄥ睆钂欑増锛屽唴瀹规牱寮忎繚鎸佸師鏍?*/
.session-switch-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(env(safe-area-inset-top) + 20rpx) 0 calc(env(safe-area-inset-bottom) + 20rpx);
  box-sizing: border-box;
  background: rgba(8, 10, 16, 0.72);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  visibility: hidden;
  pointer-events: none;
  opacity: 0;
  transition: opacity 160ms ease-out, visibility 0s 160ms;
}
.session-switch-overlay.is-open {
  visibility: visible;
  pointer-events: auto;
  opacity: 1;
  transition-delay: 0s;
}
.session-switch-panel {
  width: 100%;
  max-height: 90vh;
  padding: 8rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: transparent;
  color: var(--text);
}
.session-switch-top {
  position: absolute;
