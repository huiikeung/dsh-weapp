:host { pointer-events:none; }
.voice-overlay { position:fixed; bottom:0; left:0; right:0; height:40vh; z-index:160; pointer-events:none; opacity:0; visibility:hidden; transform:translateY(18px); --voice-base:#73A9E7; --voice-glow:#AFD7FA; --voice-ink:#173C65; --voice-halo:#fff; }
.voice-overlay.visible { opacity:1; visibility:visible; transform:translateY(0); transition:opacity 160ms cubic-bezier(0,0,.2,1),transform 160ms cubic-bezier(0,0,.2,1); }
.voice-overlay.leaving { opacity:0; visibility:visible; transform:translateY(0); transition:opacity 280ms ease-in-out; }
.voice-overlay.dark { --voice-base:#203B5C; --voice-glow:#39658F; --voice-ink:#E3F0FF; --voice-halo:#000; }
.voice-overlay.cancelling { --voice-base:#F0ACBA; --voice-glow:#FFD6DA; --voice-ink:#642434; }
.voice-overlay.dark.cancelling { --voice-base:#5B3543; --voice-glow:#895668; --voice-ink:#FAE5EB; }
/* iOS uses two elliptical masks, with an opaque lower 28% including the safe area. */
.voice-halo { position:absolute; inset:0; background:var(--voice-halo); -webkit-mask-image:radial-gradient(ellipse 112vw 31.2vh at 50% 78%,#000 50%,rgba(0,0,0,.844) 62.5%,rgba(0,0,0,.5) 75%,rgba(0,0,0,.156) 87.5%,transparent 100%); mask-image:radial-gradient(ellipse 112vw 31.2vh at 50% 78%,#000 50%,rgba(0,0,0,.844) 62.5%,rgba(0,0,0,.5) 75%,rgba(0,0,0,.156) 87.5%,transparent 100%); }
.voice-masked { position:absolute; inset:0; overflow:hidden; background:var(--voice-base); transition:background-color 200ms ease-in-out; -webkit-mask-image:linear-gradient(to bottom,transparent 71.9%,#000 72%),radial-gradient(ellipse 100vw 28.8vh at 50% 72%,#000 50%,rgba(0,0,0,.957) 56.25%,rgba(0,0,0,.844) 62.5%,rgba(0,0,0,.684) 68.75%,rgba(0,0,0,.5) 75%,rgba(0,0,0,.316) 81.25%,rgba(0,0,0,.156) 87.5%,rgba(0,0,0,.043) 93.75%,transparent 100%); mask-image:linear-gradient(to bottom,transparent 71.9%,#000 72%),radial-gradient(ellipse 100vw 28.8vh at 50% 72%,#000 50%,rgba(0,0,0,.957) 56.25%,rgba(0,0,0,.844) 62.5%,rgba(0,0,0,.684) 68.75%,rgba(0,0,0,.5) 75%,rgba(0,0,0,.316) 81.25%,rgba(0,0,0,.156) 87.5%,rgba(0,0,0,.043) 93.75%,transparent 100%); }
.voice-glow { position:absolute; left:-25%; top:calc(5% + 20px); width:150%; height:90%; border-radius:50%; background:var(--voice-glow); filter:blur(34px); opacity:.8; transition:background-color 200ms ease-in-out; }
.voice-particles { position:absolute; inset:0; width:100%; height:100%; }
.voice-status { position:absolute; top:40%; left:24px; right:24px; text-align:center; color:var(--voice-ink); opacity:.9; font-size:17px; line-height:24px; font-weight:500; transform:translateY(-50%); transition:color 200ms ease-in-out; }
@media (prefers-reduced-motion:reduce) { .voice-overlay,.voice-overlay.visible { transform:none; } .voice-overlay.visible,.voice-overlay.leaving { transition-duration:80ms; } }
