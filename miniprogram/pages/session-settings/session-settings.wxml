<page-meta page-style="{{pageStyle}}" />
<view class="page session-settings {{themeClass}}" style="{{contentFontStyle}}; --glass-alpha-top: {{glassAlphaTop}}; --glass-alpha-bottom: {{glassAlphaBottom}}; --glass-edge-alpha: {{glassEdgeAlpha}}; --glass-blur-sheet: {{glassBlurSheet}}; --glass-blur-card: {{glassBlurCard}}; --glass-radius-sheet: {{glassRadiusSheet}}; --glass-radius-card: {{glassRadiusCard}}; --glass-radius-choice: {{glassRadiusChoice}}; --glass-backdrop-brightness: {{glassBackdropBrightness}}; {{settingsGlassEnabled ? '' : '--surface: ' + nativeSurfaceColor + '; --fill: ' + nativeFillColor + ';'}};">
  <view class="session-nav" style="padding-top:{{navPadTop}}px;height:{{navHeight}}px;">
    <view class="session-nav-back" bindtap="goBack" hover-class="session-nav-pressed" role="button" aria-label="{{ui['返回']}}">
      <image class="session-nav-back-icon" src="/assets/icons/{{theme === 'dark' ? 'back-white.png' : 'back-black.png'}}"/>
    </view>
    <text class="session-nav-title" style="top:{{navPadTop}}px;height:{{navHeight}}px;">{{ui['会话设置']}}</text>
  </view>
  <view class="session-nav-placeholder" style="height:{{navPadTop + navHeight}}px;" aria-hidden="true"></view>
  <!-- DSH 客户端账号区：结构与桌面端 AccountSection / 设置页一致。
       是否显示由设置页「通用设置 → 显示账号卡片」的开关决定（默认关闭）。 -->
  <view wx:if="{{dshAccountVisible && showAccountCard}}" class="dsh-account-section" aria-label="{{ui['账号与余额']}}">
    <view class="dsh-account-card {{dshAccount.signedIn ? 'tappable has-chevron' : ''}}" bindtap="toggleDshBalance" hover-class="press-dim" role="button" aria-expanded="{{dshBalanceExpanded}}" aria-label="{{ui['账号与余额']}}">
      <view class="dsh-account-identity">
        <view class="dsh-account-avatar">
          <image wx:if="{{dshAccount.avatarUrl}}" class="dsh-account-avatar-image" src="{{dshAccount.avatarUrl}}" mode="aspectFill"/>
          <image wx:else class="dsh-account-avatar-user" mode="aspectFit" src="/assets/icons/account-user{{theme === 'dark' ? '-dark' : ''}}.svg"/>
        </view>
        <view class="dsh-account-identity-copy">
          <text class="dsh-account-name">{{dshAccount.name}}</text>
          <text class="dsh-account-status">{{dshAccountBusy ? ui['加载中…'] : dshAccount.status}}</text>
        </view>
        <image wx:if="{{dshAccount.signedIn}}" class="dsh-account-chevron {{dshBalanceExpanded ? 'open' : ''}}" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
    <view wx:if="{{dshBalanceExpanded && dshAccount.signedIn}}" class="dsh-balance-card">
      <view class="dsh-balance-row">
        <text>{{ui['充值余额']}}</text>
        <view wx:if="{{dshAccount.balanceText}}" class="dsh-balance-amount"><text>{{dshAccount.balanceText}}</text></view>
        <text wx:elif="{{dshAccount.balanceState === 'signed-out'}}" class="dsh-account-muted">{{ui['登录后查看']}}</text>
        <text wx:elif="{{dshAccount.balanceState === 'loading'}}" class="dsh-account-muted">{{ui['加载中…']}}</text>
        <text wx:else class="dsh-account-unavailable" data-url="{{dshAccount.usageUrl}}" bindtap="openDshAccountLink" role="button">{{ui['前往开放平台查看']}}</text>
      </view>
      <block wx:if="{{dshAccount.showBonusRow}}">
        <view class="dsh-account-divider"></view>
        <view class="dsh-balance-row">
          <text>{{ui['赠金余额']}}</text>
          <view wx:if="{{dshAccount.bonusBalance.length}}" class="dsh-balance-bonus"><view class="dsh-balance-amount"><text wx:for="{{dshAccount.bonusBalance}}" wx:key="*this">{{item}}</text></view></view>
          <text wx:else class="dsh-account-muted">{{ui['加载中…']}}</text>
        </view>
      </block>
    </view>
  </view>
  <view class="group-title">{{ui['新会话默认配置']}}</view>
  <view class="card {{settingsGlassEnabled ? 'settings-glass-card' : ''}}">
    <view id="agent-preset-row" class="card-row" bindtap="pickAgentPreset" role="button"><text class="card-row-label">{{ui['Agent 预设']}}</text><view class="card-row-value"><text>{{ui[presetLabel] !== undefined ? ui[presetLabel] : presetLabel}}</text><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view></view>
    <view id="default-model-row" class="card-row" bindtap="pickDefaultModel" role="button"><text class="card-row-label">{{ui['默认模型']}}</text><view class="card-row-value"><text>{{modelLabel}}</text><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view></view>
    <view id="default-permission-row" class="card-row" bindtap="pickDefaultPermission" role="button"><text class="card-row-label">{{ui['权限']}}</text><view class="card-row-value"><text>{{ui[permissionLabel] !== undefined ? ui[permissionLabel] : permissionLabel}}</text><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view></view>
  </view>
  <view class="group-hint">{{ui['与 WebUI 使用同一份部署级设置。修改只影响之后新建的会话，运行中的会话保持启动时的配置。']}}</view>
  <view class="group-title">{{ui['功能']}}</view>
  <view class="card {{settingsGlassEnabled ? 'settings-glass-card' : ''}}">
    <view id="diagnostics-row" class="card-row" bindtap="showDiagnostics" role="button"><text class="card-row-label">{{ui['诊断信息']}}</text><view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view></view>
    <view id="clear-cache-row" class="card-row" bindtap="clearLocalCache" role="button"><text class="card-row-label">{{ui['清理缓存']}}</text><view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view></view>
  </view>
  <view class="group-title">{{ui['主机信息']}}</view>
  <view class="card {{settingsGlassEnabled ? 'settings-glass-card' : ''}}">
    <view class="card-row"><text class="card-row-label">{{ui['模型服务商']}}</text><text class="card-row-value host-value" selectable>{{hostInfo.provider}}</text></view>
    <view class="card-row"><text class="card-row-label">{{ui['模型']}}</text><text class="card-row-value host-value" selectable>{{hostInfo.model}}</text></view>
    <view class="card-row"><text class="card-row-label">{{ui['已连接会话']}}</text><text class="card-row-value host-value">{{host.attachedSessions !== undefined ? host.attachedSessions : '—'}}</text></view>
    <view class="card-row"><text class="card-row-label">{{ui['工作目录']}}</text><text class="card-row-value host-value text-mono" selectable>{{host.cwd || '—'}}</text></view>
  </view>
  <!-- 原生 UI：保留原先的底部选择弹窗（玻璃风格开关关闭时使用） -->
  <view wx:if="{{picker && !settingsGlassEnabled}}" class="pair-sheet-mask native-picker-mask" catchtap="closePickerSheet" catchtouchmove="noop">
    <view class="pair-sheet resizable {{sheetExpanded.picker ? 'expanded' : ''}}" style="{{sheetExpanded.picker ? 'height: 90vh;' : ''}}max-height: {{sheetMaxH}}px;" catchtap="noop" role="dialog" aria-label="{{pickerTitle}}">
      <view class="sheet-grabber-zone" data-sheet="picker" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
      <view class="pair-sheet-head">
        <text class="pair-sheet-title">{{pickerTitle}}</text>
        <view class="pair-sheet-close tap" bindtap="closePickerSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <scroll-view class="picker-option-list {{picker === 'preset' ? 'preset-picker-list' : picker === 'model' ? 'model-picker-list' : picker === 'permission' ? 'permission-picker-list' : ''}}" style="max-height: {{picker === 'preset' && presetCreatorAvailable ? pickerCreatorListH : pickerListH}}px;" scroll-y enhanced show-scrollbar="{{false}}" enable-flex>
        <view wx:if="{{pickerIntro}}" class="picker-intro">{{ui[pickerIntro] !== undefined ? ui[pickerIntro] : pickerIntro}}</view>
        <block wx:if="{{picker === 'preset'}}">
          <view wx:for="{{pickerOptions}}" wx:key="id" class="preset-option-card {{item.checked ? 'selected' : ''}} {{item.broken ? 'broken' : ''}}" data-index="{{index}}" bindtap="choosePicker" hover-class="picker-card-hover" role="button">
            <view class="preset-card-head">
              <text class="preset-card-name">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
              <text class="preset-card-id">{{item.id}}</text>
              <text wx:if="{{item.checked}}" class="picker-current-badge">{{ui['当前使用']}}</text>
            </view>
            <text class="preset-card-description">{{ui[item.description] !== undefined ? ui[item.description] : item.description}}</text>
            <text wx:if="{{item.broken}}" class="preset-card-warning">⚠ {{ui[item.brokenReason] !== undefined ? ui[item.brokenReason] : item.brokenReason || ui['该预设存在配置错误，暂时不能设为默认值']}}</text>
          </view>
        </block>
        <block wx:elif="{{picker === 'model'}}">
          <block wx:for="{{pickerOptions}}" wx:for-index="optionIndex" wx:key="key">
            <view wx:if="{{item.header}}" class="picker-provider-title">{{ui[item.header] !== undefined ? ui[item.header] : item.header}}</view>
            <view wx:else class="model-option-card {{item.checked ? 'selected' : ''}}">
              <view class="model-option-main" data-index="{{optionIndex}}" bindtap="choosePicker" hover-class="model-option-main-hover" role="button">
                <text class="model-option-name">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
                <text wx:if="{{item.checked}}" class="picker-current-badge">{{ui['当前使用']}}</text>
              </view>
              <view wx:if="{{item.efforts && item.efforts.length}}" class="model-effort-section">
                <text class="model-effort-label">{{ui['思考等级']}}</text>
                <view class="model-effort-options">
                  <view wx:for="{{item.efforts}}" wx:for-item="effort" wx:for-index="effortIndex" wx:key="id" class="model-effort-chip {{effort.checked ? 'selected' : ''}}" data-option-index="{{optionIndex}}" data-effort-index="{{effortIndex}}" catchtap="chooseModelEffort" hover-class="model-effort-chip-hover" role="button">{{effort.label}}</view>
                </view>
              </view>
            </view>
          </block>
        </block>
        <block wx:elif="{{picker === 'permission'}}">
          <view wx:for="{{pickerOptions}}" wx:key="id" class="preset-option-card permission-option-card {{item.checked ? 'selected' : ''}}" data-index="{{index}}" bindtap="choosePicker" hover-class="picker-card-hover" role="button">
            <view class="permission-card-head">
              <image class="permission-card-icon" src="/assets/icons/{{item.icon}}" mode="aspectFit"/>
              <text class="preset-card-name">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
              <text class="preset-card-id">{{item.id}}</text>
              <text wx:if="{{item.badge}}" class="permission-experimental-badge">{{item.badge}}</text>
              <text wx:if="{{item.checked}}" class="picker-current-badge">{{ui['当前使用']}}</text>
            </view>
            <text class="preset-card-description">{{ui[item.description] !== undefined ? ui[item.description] : item.description}}</text>
          </view>
        </block>
        <block wx:else>
          <block wx:for="{{pickerOptions}}" wx:key="key">
            <view wx:if="{{item.header}}" class="picker-group">{{item.header}}</view>
            <view wx:else class="picker-option {{item.checked ? 'checked' : ''}}" data-index="{{index}}" bindtap="choosePicker" role="button">
              <text class="picker-option-label">{{picker === 'effort' ? item.label : ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
              <text wx:if="{{item.checked}}" class="picker-option-check">✓</text>
            </view>
          </block>
        </block>
      </scroll-view>
      <view wx:if="{{picker === 'preset' && presetCreatorAvailable}}" class="preset-create-entry {{creatingPreset ? 'busy' : ''}}" bindtap="createCustomAgentPreset" hover-class="preset-create-pressed" role="button" aria-disabled="{{creatingPreset}}">
        <view class="preset-create-plus">+</view>
        <view class="preset-create-copy">
          <text class="preset-create-title">{{creatingPreset ? ui['正在打开…'] : ui['添加自定义 Agent 预设']}}</text>
          <text class="preset-create-description">{{ui['新建创造模式会话，让 Agent 创建或维护预设']}}</text>
        </view>
        <image class="preset-create-chevron" src="/assets/icons/chev-right-gray.png" mode="aspectFit"/>
      </view>
    </view>
  </view>

  <!-- 玻璃弹窗：由设置页「底部弹窗」开关决定形态。
       开 = 玻璃底部弹窗（抓手 + 标题 + 关闭 + 列表），与原生一致，只换材质；
       关 = 贴着触发行的锚点玻璃菜单（与首页工作区选择弹窗同款）。
       两种形态共用同一份内容模板，选择 / 诊断 / 缓存 / 预设逻辑完全一致。 -->
  <template name="picker-pop-content">
    <view class="picker-pop-content">
      <block wx:if="{{picker === 'preset'}}">
        <view
          wx:for="{{pickerOptions}}"
          wx:key="id"
          class="picker-pop-row picker-pop-preset {{item.checked ? 'checked' : ''}} {{item.broken ? 'broken' : ''}}"
          data-index="{{index}}"
          bindtap="choosePicker"
          hover-class="picker-pop-row-pressed"
          role="button"
          aria-disabled="{{item.broken}}"
          aria-label="{{ui[item.label] !== undefined ? ui[item.label] : item.label}}"
        >
          <image class="picker-pop-ic" src="/assets/icons/{{item.checked ? 'check-fill-white.png' : 'circle-white.png'}}" mode="aspectFit"/>
          <view class="picker-pop-body">
            <text class="picker-pop-name">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
            <text class="picker-pop-desc">{{ui[item.description] !== undefined ? ui[item.description] : item.description}}</text>
            <text wx:if="{{item.broken}}" class="picker-pop-warn">⚠ {{ui[item.brokenReason] !== undefined ? ui[item.brokenReason] : item.brokenReason || ui['该预设存在配置错误，暂时不能设为默认值']}}</text>
          </view>
        </view>
        <block wx:if="{{presetCreatorAvailable}}">
          <view class="picker-pop-divider"></view>
          <view class="picker-pop-row {{creatingPreset ? 'busy' : ''}}" bindtap="createCustomAgentPreset" hover-class="picker-pop-row-pressed" role="button" aria-disabled="{{creatingPreset}}">
            <image class="picker-pop-ic" src="/assets/icons/plus-white.png" mode="aspectFit"/>
            <view class="picker-pop-body">
              <text class="picker-pop-name">{{creatingPreset ? ui['正在打开…'] : ui['添加自定义 Agent 预设']}}</text>
              <text class="picker-pop-desc">{{ui['新建创造模式会话，让 Agent 创建或维护预设']}}</text>
            </view>
          </view>
        </block>
      </block>
      <block wx:elif="{{picker === 'model'}}">
        <block wx:for="{{pickerOptions}}" wx:for-index="optionIndex" wx:key="key">
          <view wx:if="{{item.header}}" class="picker-pop-group">{{ui[item.header] !== undefined ? ui[item.header] : item.header}}</view>
          <view
            wx:else
            class="picker-pop-row picker-pop-model {{item.checked ? 'checked' : ''}}"
            data-index="{{optionIndex}}"
            bindtap="choosePicker"
            hover-class="picker-pop-row-pressed"
            role="button"
            aria-label="{{ui[item.label] !== undefined ? ui[item.label] : item.label}}"
          >
            <image class="picker-pop-ic" src="/assets/icons/{{item.checked ? 'check-fill-white.png' : 'circle-white.png'}}" mode="aspectFit"/>
            <view class="picker-pop-model-line">
              <text class="picker-pop-name">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
              <text wx:if="{{item.effortSuffix}}" class="picker-pop-suffix">· {{item.effortSuffix}}</text>
            </view>
          </view>
        </block>
      </block>
      <block wx:elif="{{picker === 'effort'}}">
        <view
          wx:for="{{pickerOptions}}"
          wx:key="id"
          class="picker-pop-row picker-pop-effort {{item.checked ? 'checked' : ''}}"
          data-index="{{index}}"
          bindtap="choosePicker"
          hover-class="picker-pop-row-pressed"
          role="button"
          aria-label="{{item.label}}"
        >
          <image class="picker-pop-ic" src="/assets/icons/{{item.checked ? 'check-fill-white.png' : 'circle-white.png'}}" mode="aspectFit"/>
          <text class="picker-pop-name">{{item.label}}</text>
        </view>
      </block>
      <block wx:elif="{{picker === 'permission'}}">
        <view
          wx:for="{{pickerOptions}}"
          wx:key="id"
          class="picker-pop-row picker-pop-permission {{item.checked ? 'checked' : ''}}"
          data-index="{{index}}"
          bindtap="choosePicker"
          hover-class="picker-pop-row-pressed"
          role="button"
          aria-label="{{ui[item.label] !== undefined ? ui[item.label] : item.label}}"
        >
          <image class="picker-pop-ic picker-pop-shield" src="/assets/icons/{{item.icon}}" mode="aspectFit"/>
          <view class="picker-pop-body">
            <view class="picker-pop-permission-line">
              <text class="picker-pop-name">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
              <text wx:if="{{item.badge}}" class="picker-pop-badge">{{item.badge}}</text>
              <image wx:if="{{item.checked}}" class="picker-pop-check" src="/assets/icons/check-fill-white.png" mode="aspectFit"/>
            </view>
            <text class="picker-pop-desc">{{ui[item.description] !== undefined ? ui[item.description] : item.description}}</text>
          </view>
        </view>
      </block>
      <block wx:elif="{{picker === 'diagnostics'}}">
        <view wx:for="{{diagnostics}}" wx:key="label" class="picker-pop-diag-row">
          <text class="picker-pop-diag-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
          <text class="picker-pop-diag-value {{item.mono ? 'text-mono' : ''}}" selectable>{{item.value}}</text>
        </view>
      </block>
      <block wx:elif="{{picker === 'cache'}}">
        <view class="picker-pop-cache-desc">{{ui['仅清理本机的会话列表与正文缓存，下次打开时重新加载。']}}</view>
        <view class="picker-pop-cache-note">{{ui['不会删除聊天记录、配对信息或公网有效期。']}}</view>
        <view wx:if="{{cacheError}}" class="picker-pop-error">{{ui[cacheError] !== undefined ? ui[cacheError] : cacheError}}</view>
        <view class="picker-pop-actions">
          <view class="picker-pop-action picker-pop-action-cancel {{cacheClearing ? 'picker-pop-action-disabled' : ''}}" bindtap="closePickerSheet" hover-class="picker-pop-action-pressed" role="button" aria-disabled="{{cacheClearing}}">{{ui['取消']}}</view>
          <view class="picker-pop-action picker-pop-action-confirm {{cacheClearing ? 'picker-pop-action-disabled' : ''}}" bindtap="confirmClearCache" hover-class="picker-pop-action-pressed" role="button" aria-disabled="{{cacheClearing}}">{{cacheClearing ? ui['清理中…'] : ui['确认清理']}}</view>
        </view>
      </block>
      <view wx:if="{{pickerIntro}}" class="picker-pop-hint">{{ui[pickerIntro] !== undefined ? ui[pickerIntro] : pickerIntro}}</view>
    </view>
  </template>

  <!-- 形态一：玻璃底部弹窗 -->
  <view wx:if="{{picker && settingsGlassEnabled && settingsGlassSheetEnabled}}" class="pair-sheet-mask" catchtap="closePickerSheet" catchtouchmove="noop">
    <view class="picker-glass-sheet resizable {{sheetExpanded.picker ? 'expanded' : ''}}" style="{{sheetExpanded.picker ? 'height: 90vh;' : ''}}max-height: {{sheetMaxH}}px;" catchtap="noop" role="dialog" aria-label="{{pickerTitle}}">
      <view class="sheet-grabber-zone" data-sheet="picker" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
      <view class="pair-sheet-head">
        <text class="pair-sheet-title">{{pickerTitle}}</text>
        <view class="pair-sheet-close tap" bindtap="closePickerSheet" role="button" aria-label="{{ui['关闭弹窗']}}"><view class="sheet-close-x"></view></view>
      </view>
      <scroll-view class="picker-sheet-scroll" style="{{sheetExpanded.picker ? '' : 'max-height: ' + (picker === 'preset' && presetCreatorAvailable ? pickerCreatorListH : pickerListH) + 'px;'}}" scroll-y enhanced show-scrollbar="{{false}}">
        <template is="picker-pop-content" data="{{picker: picker, pickerOptions: pickerOptions, pickerIntro: pickerIntro, diagnostics: diagnostics, cacheError: cacheError, cacheClearing: cacheClearing, presetCreatorAvailable: presetCreatorAvailable, creatingPreset: creatingPreset, ui: ui}}"/>
      </scroll-view>
    </view>
  </view>

  <!-- 形态二：锚点玻璃菜单 -->
  <view wx:if="{{picker && settingsGlassEnabled && !settingsGlassSheetEnabled}}" class="picker-pop-mask" catchtap="closePickerPopover" catchtouchmove="noop"></view>
  <view
    wx:if="{{picker && settingsGlassEnabled && !settingsGlassSheetEnabled}}"
    class="picker-pop"
    style="left: {{pickerPopLeft}}px; top: {{pickerPopTop}}px; width: {{pickerPopWidth}}px; max-height: {{pickerPopMaxH}}px; transform-origin: {{pickerPopOrigin}};"
    catchtap="noop"
    role="dialog"
    aria-label="{{pickerTitle}}"
  >
    <scroll-view class="picker-pop-scroll" style="max-height: {{pickerPopMaxH}}px;" scroll-y enhanced show-scrollbar="{{false}}">
      <template is="picker-pop-content" data="{{picker: picker, pickerOptions: pickerOptions, pickerIntro: pickerIntro, diagnostics: diagnostics, cacheError: cacheError, cacheClearing: cacheClearing, presetCreatorAvailable: presetCreatorAvailable, creatingPreset: creatingPreset, ui: ui}}"/>
    </scroll-view>
  </view>

  <!-- 工作区文件弹窗：与选择弹窗同款底部弹窗 -->
  <view wx:if="{{filesSheet}}" class="pair-sheet-mask" catchtap="closeFiles" catchtouchmove="noop">
    <view class="pair-sheet resizable" style="height: {{sheetExpanded.files ? 90 : 62}}vh; max-height: {{sheetMaxH}}px;" catchtap="noop" role="dialog" aria-label="{{ui['工作区文件']}}">
      <view class="sheet-grabber-zone" data-sheet="files" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
      <view class="pair-sheet-head">
        <text class="pair-sheet-title">{{ui['工作区文件']}}</text>
        <view class="pair-sheet-close tap" bindtap="closeFiles" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <view class="files-toolbar">
        <view wx:if="{{!filesIsRoot}}" class="files-up tap" bindtap="filesGoUp">{{ui['‹ 上一级']}}</view>
        <view wx:else class="files-up disabled"></view>
      </view>
      <scroll-view class="files-list" style="max-height: {{filesListH}}px;" scroll-y enhanced show-scrollbar="{{false}}" enable-flex>
        <view wx:if="{{filesLoading && !filesEntries.length}}" class="files-center">{{ui['正在读取工作区文件…']}}</view>
        <view wx:elif="{{filesError}}" class="files-center">{{ui[filesError] !== undefined ? ui[filesError] : filesError}}</view>
        <view wx:elif="{{!filesEntries.length}}" class="files-center">{{ui['此目录为空']}}</view>
        <block wx:else>
          <view
            wx:for="{{filesEntries}}"
            wx:key="key"
            class="files-row"
            data-index="{{index}}"
            bindtap="filesOpenEntry"
            hover-class="files-row-hover"
          >
            <image class="files-row-icon" src="/assets/icons/{{item.iconFile}}"/>
            <view class="files-row-body">
              <text class="files-row-name">{{item.name}}</text>
              <text wx:if="{{item.subLabel}}" class="files-row-sub">{{item.subLabel}}</text>
            </view>
            <text wx:if="{{item.kind === 'dir'}}" class="files-row-chevron">›</text>
          </view>
        </block>
      </scroll-view>
      <view class="files-path-footer">{{filesPathLabel}}</view>
    </view>
  </view>
  <!-- 关闭玻璃 UI 时保留原生诊断 / 缓存底部弹窗 -->
  <view wx:if="{{utilitySheet && !settingsGlassEnabled}}" class="utility-mask" catchtap="closeUtilitySheet" catchtouchmove="noop">
    <view class="utility-sheet resizable {{sheetExpanded.utility ? 'expanded' : ''}}" style="{{sheetExpanded.utility ? 'height: 90vh;' : ''}}max-height: 92vh;" catchtap="noop" role="dialog" aria-label="{{utilitySheet === 'diagnostics' ? ui['诊断信息'] : ui['清理缓存']}}">
      <view class="sheet-grabber-zone" data-sheet="utility" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
      <view class="utility-header">
        <text class="utility-title">{{utilitySheet === 'diagnostics' ? ui['诊断信息'] : ui['清理缓存']}}</text>
        <button wx:if="{{utilitySheet === 'diagnostics'}}" class="utility-close" bindtap="closeUtilitySheet" disabled="{{cacheClearing}}" aria-label="{{ui['关闭弹窗']}}"><view class="sheet-close-x"></view></button>
      </view>
      <scroll-view scroll-y enhanced class="utility-scroll">
        <view wx:if="{{utilitySheet === 'diagnostics'}}" class="diagnostic-list">
          <view wx:for="{{diagnostics}}" wx:key="label" class="diagnostic-row">
            <text class="diagnostic-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
            <text class="diagnostic-value {{item.mono ? 'text-mono' : ''}}" selectable>{{item.value}}</text>
          </view>
        </view>
        <view wx:else class="cache-description">
          <text>{{ui['仅清理本机的会话列表与正文缓存，下次打开时重新加载。']}}</text>
          <text class="cache-note">{{ui['不会删除聊天记录、配对信息或公网有效期。']}}</text>
          <text wx:if="{{cacheError}}" class="cache-error">{{ui[cacheError] !== undefined ? ui[cacheError] : cacheError}}</text>
        </view>
      </scroll-view>
      <view wx:if="{{utilitySheet === 'cache'}}" class="utility-actions">
        <button class="utility-button utility-cancel" bindtap="closeUtilitySheet" disabled="{{cacheClearing}}">{{ui['取消']}}</button>
        <button class="utility-button utility-confirm" bindtap="confirmClearCache" disabled="{{cacheClearing}}">{{cacheClearing ? ui['清理中…'] : ui['确认清理']}}</button>
      </view>
      <button wx:else class="utility-button utility-done" bindtap="closeUtilitySheet">{{ui['知道了']}}</button>
    </view>
  </view>
</view>
