/* Keep the overflow menu at the far right of the second navigation row. */
.segmented-row {
  position: relative;
  padding-left: 40rpx;
  padding-right: 20rpx;
}
.segmented-row .segmented {
  width: min(520rpx, calc(100% - 80rpx));
  flex: 0 1 520rpx;
}
.segmented-row .nav-more {
  position: absolute;
  right: 20rpx;
  top: 12rpx;
  margin: 0;
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}



/* Center the whole conversation/trajectory segmented control. */
.segmented-row {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 12rpx 0;
}
.segmented-row .segmented {
  position: static;
  left: auto;
  transform: none;
  width: min(420rpx, calc(100% - 180rpx));
  height: 56rpx;
  flex: 0 0 auto;
}
.segmented-row .nav-more {
  position: absolute;
  right: 20rpx;
  top: 12rpx;
  margin: 0;
}



/* Collaboration shares the switcher row; override earlier centered-only layouts. */
.session .segmented-row { position:relative;padding:8rpx 24rpx;gap:16rpx;justify-content:space-between; }
/* 对话/轨迹：绝对居中，协作与更多分居两侧 */
.session .segmented-row .segmented { position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);flex:0 0 auto;min-width:0;width:min(340rpx, calc(100% - 260rpx));margin:0; }
.session .segmented-row .nav-more { position:static;flex:0 0 64rpx;margin:0;align-self:center;top:auto;right:auto;display:flex;align-items:center;justify-content:center; }
@media (max-width:350px) { .session .segmented-row { padding-left:24rpx;gap:12rpx; } }

/* 加号按钮与权限图标同尺寸（24rpx） */
.composer-bar .chip.icon {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
}
.composer-bar .chip.icon .attach-ic { width: 24rpx; height: 24rpx; }
.composer-bar .chip-ic { width: 34rpx; height: 34rpx; margin-right: 8rpx; }

/* 权限控件：图标固定，文字使用剩余宽度，过长时省略 */
.composer-bar .permission-chip {
  flex: 0 0 auto;
  min-width: 0;
  max-width: 38%;
  overflow: hidden;
  white-space: nowrap;
}
.composer-bar .permission-chip .chip-ic {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  margin-right: 8rpx;
}
.composer-bar .permission-chip .chip-label {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: var(--text-2);
}

/* One model trigger: plain effort text, shared pointer/touch feedback. */
.composer-bar .chip.model-chip{flex:0 1 auto;max-width:min(360px,60%);min-width:0;height:28px;padding:0 4px 0 8px;gap:4px;border-radius:6px;box-sizing:border-box;overflow:hidden;font-size:13px;font-weight:400;line-height:20px;cursor:pointer}
.chip-model-name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.model-trigger-effort{flex:none;color:var(--text-4);white-space:nowrap}
.model-trigger-chevron{flex:0 0 5px;width:5px;height:5px;margin:0 3px;border-right:1px solid var(--text-4);border-bottom:1px solid var(--text-4);transform:translateY(-1px) rotate(45deg);transition:transform .12s}
.model-chip.model-trigger-pressed,.model-chip:active,.model-chip:focus-visible{background:var(--fill-2)}

/* DSH two-level model / effort picker. */
.model-pop{left:auto;right:28rpx;bottom:calc(132rpx + env(safe-area-inset-bottom));width:max-content;min-width:min(240px, calc(100vw - 32px));max-width:min(420px, calc(100vw - 32px));border-radius:10px;border:1px solid var(--border);box-shadow:0 4px 16px rgba(7,24,43,.12);padding:4px;box-sizing:border-box;overflow:hidden}
.model-pop-scroll{max-height:min(360px, 48vh);overflow-x:hidden}
.model-list{width:250px}
.model-group-title{padding:2px 7px;font-size:11px;line-height:16px;font-weight:400;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.model-identity{display:flex;align-items:center;gap:4px;flex:1;min-width:0}
.model-identity .model-name{flex:0 1 auto}
.model-pop .model-row{display:flex;align-items:center;box-sizing:border-box;width:100%;min-width:0;min-height:34px;padding:5px 7px;gap:6px;border-radius:6px;color:var(--text);cursor:pointer}
.model-name{display:block;flex:1;min-width:0;font-size:13px;line-height:18px;font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.model-pop .model-row.current{background:var(--fill)}
.model-pop .model-row.model-row-pressed,.model-pop .model-row:active,.model-pop .model-row:focus-visible{background:var(--fill-2)}
.model-check-slot{width:14px;height:18px;flex:0 0 14px;display:flex;align-items:center;justify-content:center}
.model-check{width:8px;height:4px;border-left:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:translateY(-1px) rotate(-45deg)}
.model-entry-label{flex-shrink:0;font-size:13px;line-height:20px}
.model-entry-value{flex:1;min-width:0;display:flex;align-items:center;justify-content:flex-end;gap:4px;color:var(--text-3);font-size:13px;line-height:20px}
.model-value-text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.model-entry-chevron{width:4px;height:4px;flex:0 0 4px;border-right:1px solid var(--text-3);border-top:1px solid var(--text-3);transform:rotate(45deg);margin:0 4px}
.model-release-badge{flex-shrink:0;padding:1px 6px;border-radius:10px;font-size:10px;line-height:16px;color:var(--ocean);background:rgba(46,107,230,.08)}
.theme-dark .model-release-badge{color:#9bb6ff;background:rgba(110,145,255,.15)}
.model-menu-back{font-size:12px;line-height:18px}
.model-menu-back .model-entry-chevron{transform:rotate(-135deg)}
.model-trigger-chevron.open{transform:translateY(1px) rotate(225deg)}
.theme-dark .model-pop{box-shadow:0 4px 16px rgba(0,0,0,.35)}
@media (hover: hover) and (pointer: fine){.model-pop .model-row:hover,.model-chip:hover{background:var(--fill-2)}}
@media (hover: none), (pointer: coarse){.model-pop .model-row{min-height:44px}.composer-bar .chip.model-chip{height:44px}.model-name{font-size:14px;line-height:20px}}

.navbar .nav-back {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}
.navbar .nav-back::after {
  border: 0 !important;
}



/* 弹窗菜单使用正常字号与图标尺寸（输入栏 + 图标尺寸不受影响） */
.opt-pop .opt-ic { width: 36rpx; height: 36rpx; }
/* 夜间模式：灰阶图标统一反白，保证对比度 */
.theme-dark .opt-pop .opt-ic {
  filter: brightness(0) invert(1);
  opacity: 0.92;
}
.theme-dark .composer-bar .chip-ic,
.theme-dark .composer-bar .attach-ic,
.theme-dark .pending-file-ic {
  filter: brightness(0) invert(1);
  opacity: 0.92;
}

.opt-pop.permission-pop{left:72rpx;right:auto;bottom:calc(132rpx + env(safe-area-inset-bottom));width:184px;min-width:0;max-width:calc(100vw - 48px);box-sizing:border-box;border-radius:10px;padding:4px;border:1px solid var(--border);box-shadow:0 4px 16px rgba(7,24,43,.12);overflow:hidden}
.permission-pop-scroll{max-height:45vh}
.opt-pop.permission-pop .opt-row{min-height:34px;padding:5px 7px;box-sizing:border-box;gap:6px;border-radius:6px;color:var(--text);cursor:pointer}
.permission-icon-slot{width:18px;height:18px;flex:0 0 18px;display:flex;align-items:center;justify-content:center}
.opt-pop.permission-pop .opt-ic{display:block;width:16px;height:16px}
.permission-option-name{display:flex;align-items:baseline;gap:3px;min-width:0;flex:1}
.opt-pop.permission-pop .opt-label{min-width:0;font-size:14px;line-height:20px;font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.permission-option-badge{flex-shrink:0;font-size:8px;line-height:10px;color:var(--text-3);align-self:flex-start;margin-top:1px}
.permission-check-slot{width:14px;height:18px;flex:0 0 14px;display:flex;align-items:center;justify-content:center}
.permission-check{width:8px;height:4px;border-left:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:translateY(-1px) rotate(-45deg)}
.opt-pop.permission-pop .opt-row.current{background:var(--fill)}
.opt-pop.permission-pop .opt-row.permission-row-pressed,.opt-pop.permission-pop .opt-row:active,.opt-pop.permission-pop .opt-row:focus-visible{background:var(--fill-2)}
.theme-dark .opt-pop.permission-pop{box-shadow:0 4px 16px rgba(0,0,0,.35)}
@media (hover:hover) and (pointer:fine){.opt-pop.permission-pop .opt-row:hover{background:var(--fill-2)}
}
@media (hover:none),(pointer:coarse){.opt-pop.permission-pop .opt-row{min-height:44px}
}



/* Desktop reading-view process rows: one icon gutter, no nested tool gate. */
.process-head { gap: 12rpx; min-height: 64rpx; padding: 12rpx 0; }
.process-title { font-size: 28rpx; font-weight: 400; flex-shrink: 0; max-width: 48%; }
.process-title.failed { color: #D4545B; }
.process-command-icon, .event-glyph, .tool-glyph-small { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.process-summary { padding: 0; color: var(--text-3); font-size: 22rpx; line-height: 1.5; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.process-head .event-spacer { flex: 1 0 0; }
.process-chevron { width: 24rpx; height: 24rpx; }
.event-chevron { width: 24rpx; height: 24rpx; opacity: .7; }
.process-body { padding: 8rpx 0 12rpx; }
/* Live status follows its details, directly above the whale progress strip.
   Settled groups retain their normal header-first disclosure layout. */
.process-block.running { display:flex;flex-direction:column; }
.process-block.running > .process-body { order:0; }
.process-block.running > .process-hairline { order:1; display:none; }
.process-block.running > .process-head { order:2; }
.disclosure { border-bottom: 0; }
.disclosure-head, .disclosure-head.tool { gap: 12rpx; padding: 12rpx 0; min-height: 66rpx; }
.tool-bundle-body { padding: 0; }
.tool-node { border-top: 0; }
.event-title, .event-preview { font-size: 26rpx; color: var(--text-2); }
.event-body { margin-left: 15rpx; padding-left: 0; gap: 27rpx; }
.event-body-text { font-size: 26rpx; line-height: 1.65; }
.tool-detail { padding-left: 44rpx; }
.tool-act { color: var(--text-2); font-size: 26rpx; font-weight: 400; }
.tool-line-1 { min-width: 0; width: 100%; flex-wrap: nowrap; }
.tool-act, .tool-status { flex-shrink: 0; }
.tool-act { max-width: 48%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tool-note { font-size: 23rpx; line-height: 1.55; min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Desktop BashRow: disclosure, description, one unified command/output card. */
.tool-note { font-family:inherit; }
.tool-separator { color:var(--text-3);flex-shrink:0;font-size:24rpx; }
.command-icon-slot { position:relative;display:flex;align-items:center;justify-content:center;width:32rpx;height:32rpx;flex-shrink:0; }
.command-tool-icon { opacity:1; }
.command-chevron { position:absolute;left:4rpx;top:4rpx;width:24rpx;height:24rpx;transform:rotate(90deg);opacity:0;pointer-events:none; }
.command-chevron.open { transform:rotate(-90deg); }
.command-chevron.completed-chevron { opacity:.65; }
/* Expanded state persists after touch ends; tapping again restores the glyph. */
.command-icon-slot.disclosed .command-tool-icon { opacity:0; }
.command-icon-slot.disclosed .command-chevron { opacity:.65; }
.tool-head-hover { background:var(--fill); }
.command-node .disclosure-head.tool { gap:10rpx; }
.command-node .tool-line-1 { gap:10rpx; }
.command-node .tool-act { font-size:26rpx; }
.command-node .tool-note { font-size:24rpx; }
.command-card { margin:0 0 16rpx 0;border:1rpx solid var(--border);border-radius:22rpx;background:var(--fill);overflow:hidden; }
.command-card-head { display:flex;align-items:center;gap:14rpx;padding:18rpx 20rpx 8rpx;min-width:0; }
.command-state { width:10rpx;height:10rpx;border-radius:50%;flex-shrink:0;background:var(--text-3); }
.command-state.done { background:#28B970; }
.command-state.waiting { background:#D59A31; }
.command-state.failed { background:#DC555C; }
.command-cwd { min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-3);font-size:20rpx;font-family:monospace; }
.command-state-label { color:var(--text-3);font-size:20rpx;white-space:nowrap; }
.command-copy { margin-left:auto;flex-shrink:0;color:var(--text-2);font-size:24rpx;padding:4rpx 0 4rpx 14rpx; }
.command-input { width:100%; }
.command-code-lines { padding:4rpx 20rpx 20rpx;min-width:100%;display:inline-block;box-sizing:border-box; }
.command-code-line { display:flex;gap:14rpx;min-height:34rpx;font-family:monospace;font-size:22rpx;line-height:1.6; }
.command-prompt { color:var(--text-3);flex-shrink:0; }
.command-source { color:var(--text);white-space:pre; }
.command-output { border-top:1rpx solid var(--border);max-height:440rpx;width:100%; }
.command-output-text { display:block;min-width:100%;width:max-content;padding:20rpx 44rpx;font-family:monospace;font-size:22rpx;line-height:1.6;white-space:pre;color:var(--text); }
.command-output.failed .command-output-text { color:#D4545B; }
.command-placeholder { color:var(--text-3);padding:16rpx 24rpx;font-size:22rpx; }
.command-empty-output { border-top:1rpx solid var(--border); }

/* Reading-view reasoning card; expansion is independent of the process fold. */
.reasoning-card { --reading-bg:#F5F6F7;margin:14rpx 0 18rpx;border:1rpx solid var(--border);border-radius:20rpx;background:var(--reading-bg);padding:20rpx 28rpx 12rpx;overflow:hidden; }
.theme-dark .reasoning-card { --reading-bg:#17191D; }
.reasoning-card-head { display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:18rpx; }
.reasoning-card-title,.reasoning-step { font-size:22rpx;color:var(--text-2);font-weight:400; }
.reasoning-reading-area { position:relative; }
.reasoning-scroll { width:100%; }
.reasoning-reading-text { display:block;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;font-size:26rpx;line-height:1.85;color:var(--text-2);padding-right:10rpx; }
.reasoning-reading-fade { position:absolute;left:0;right:0;bottom:0;height:48rpx;background:linear-gradient(to bottom,transparent,var(--reading-bg));pointer-events:none; }
.reasoning-card-footer { display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:12rpx;min-height:52rpx; }
.reasoning-reading-hint { font-size:22rpx;color:var(--text-2); }
.reasoning-reading-toggle { display:flex;align-items:center;gap:8rpx;min-height:52rpx;padding-left:16rpx;font-size:22rpx;color:var(--text-2); }
.reasoning-reading-chevron { width:20rpx;height:20rpx;transform:rotate(90deg);opacity:.7; }
.reasoning-reading-chevron.open { transform:rotate(-90deg); }
.reading-expanded .reasoning-scroll { height:auto; }

.process-live-detail { color:var(--text-3);font-size:24rpx;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis; }
/* DSH General > Font size: 10-22px, default 14px; content only. */
.session .row-user-text,
.session .md-para,
.session .md-li-text,
.session .md-li-marker,
.session .md-quote,
.session .md-td,
.session .reasoning-reading-text,
.session .event-body-text { font-size: var(--dsh-content-font-size, 14px); line-height: 1.65; }
.session .md-h1 { font-size: calc(var(--dsh-content-font-size, 14px) + 8px); }
.session .md-h2 { font-size: calc(var(--dsh-content-font-size, 14px) + 6px); }
.session .md-h3 { font-size: calc(var(--dsh-content-font-size, 14px) + 4px); }
.session .md-h4, .session .md-h5, .session .md-h6 { font-size: calc(var(--dsh-content-font-size, 14px) + 2px); }
/* Code and tool output have independent sizes in the desktop client. */
.session .code-body, .session .md-inline-code, .session .trace-section-code { font-size: 11px; }
.session .row-user-text, .session .md-para, .session .md-heading, .session .md-li-text, .session .md-quote, .session .md-td, .session .reasoning-reading-text { font-family: var(--dsh-font-family-text, sans-serif); }
.session .code-body, .session .md-inline-code, .session .trace-section-code, .session .command-code-line, .session .command-output-text, .session .tool-output, .session .tool-args {
  font-family: var(--dsh-font-family-code, Menlo, Consolas, monospace); font-size: var(--dsh-code-font-size, 11px);
}
.session .tool-detail-code, .session .tool-detail-output { font-family: var(--dsh-font-family-code, monospace); font-size: var(--dsh-code-font-size, 11px); }

/* ---------- 更多菜单内的底部弹窗 ---------- */
.more-files-sheet {
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  transition: height 0.24s cubic-bezier(0.32, 0.72, 0, 1);
}

/* 抓手整块可点/可拖：点击或上拖增高到 90% */
.files-grabber-zone {
  padding: 10rpx 0 6rpx;
  margin: -10rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.more-files-toolbar { display: flex; align-items: center; margin-bottom: 8rpx; flex-shrink: 0; }
.more-files-up { padding: 12rpx 8rpx; font-size: 26rpx; color: var(--ocean); }
.more-files-up.disabled { visibility: hidden; }
.more-files-scroll { flex: 1; min-height: 0; }
.more-files-center { padding: 40rpx 16rpx; text-align: center; color: var(--text-2); font-size: 27rpx; }
.more-files-row { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 16rpx; border-radius: 16rpx; }
.more-files-row + .more-files-row { border-top: 1rpx solid var(--divider); }
.more-files-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.more-files-name { flex: 1; min-width: 0; font-size: 28rpx; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.more-files-chev { flex: none; color: var(--text-3); font-size: 30rpx; }
.more-files-path { padding: 16rpx 8rpx 4rpx; font-size: 23rpx; color: var(--text-3); flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.rename-input { width: 100%; box-sizing: border-box; margin: 8rpx 0 20rpx; padding: 22rpx 24rpx; border-radius: 18rpx; background: var(--fill); border: 1rpx solid var(--border); color: var(--text); font-size: 29rpx; }
.rename-placeholder { color: var(--text-3); }
.rename-actions { display: flex; }
.rename-save { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: 999rpx; background: var(--ocean); color: #FFFFFF; font-size: 29rpx; font-weight: 600; }

.confirm-sheet {
  padding-top: 24rpx;
}

.confirm-title {
  font-size: 33rpx;
  font-weight: 650;
  color: var(--text);
  text-align: center;
  margin: 16rpx 0 10rpx;
}

.confirm-body {
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--text-2);
  text-align: center;
  margin: 0 auto 32rpx;
  max-width: 520rpx;
}

.confirm-actions { display: flex; gap: 20rpx; }

.confirm-cancel,
.confirm-ok {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.confirm-cancel {
  background: var(--fill);
  color: var(--text);
}

.confirm-ok {
  background: linear-gradient(135deg, #4C8BF5, #2E6BE6);
  color: #FFFFFF;
}

.confirm-ok.danger {
  background: linear-gradient(135deg, #F0565B, #D93A41);
  box-shadow: 0 10rpx 24rpx rgba(217, 58, 65, 0.28);
}

/* ---------- 会话设置类弹窗（统计 / 重命名等统一设计） ---------- */
.session-card-sheet {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.session-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.session-sheet-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 650;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-sheet-close {
  flex: none;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 64rpx;
  height: 64rpx;
}

.session-sheet-scroll {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
}

.session-sheet-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.session-sheet-field-label {
  font-size: 25rpx;
  color: var(--text-2);
}

.session-sheet-input {
  width: 100%;
  box-sizing: border-box;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: var(--fill);
  border: 1rpx solid var(--border);
  color: var(--text);
  font-size: 29rpx;
}

.session-sheet-placeholder {
  color: var(--text-3);
}

.session-sheet-note {
  margin-top: 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-3);
}

.session-sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  flex-shrink: 0;
}

.session-sheet-primary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4C8BF5, #2E6BE6);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
}

.session-sheet-ghost {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--text-2);
  font-size: 29rpx;
  font-weight: 500;
}

.session-stat-group {
  border: 1rpx solid var(--border);
  border-radius: 22rpx;
  background: var(--fill);
  padding: 6rpx 24rpx 14rpx;
  margin-bottom: 16rpx;
}

.session-stat-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2);
  padding: 16rpx 0 6rpx;
}

.session-stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
}

.session-stat-row + .session-stat-row {
  border-top: 1rpx solid var(--divider);
}

.session-stat-label {
  flex: none;
  font-size: 26rpx;
  color: var(--text-2);
}

.session-stat-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  overflow-wrap: anywhere;
}

/* ---------- 执行中：方形格子闪动加载图标（styles/proc-icon.wxss） ---------- */

/* Quick session switching: a bottom sheet on phones, a DSH-style right popover on wide screens. */
.session .segmented-row .nav-actions {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 72rpx;
}
.session .segmented-row .nav-actions .nav-more {
  position: static;
  margin: 0;
}
.session .segmented-row .segmented {
  width: min(340rpx, calc(100% - 340rpx));
}
.session-switch-trigger {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--text-2);
}
.session-switch-lines {
  width: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 7rpx;
}
.session-switch-lines view {
  width: 100%;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}
.session-switch-lines view:nth-child(2) { width: 78%; }
.session-switch-lines view:nth-child(3) { width: 90%; }

/* 会话快捷切换：与对话节点一致的全屏蒙版，内容样式保持原样 */
.session-switch-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(env(safe-area-inset-top) + 20rpx) 0 calc(env(safe-area-inset-bottom) + 20rpx);
  box-sizing: border-box;
  background: rgba(8, 10, 16, 0.72);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  visibility: hidden;
  pointer-events: none;
  opacity: 0;
  transition: opacity 160ms ease-out, visibility 0s 160ms;
}
.session-switch-overlay.is-open {
  visibility: visible;
  pointer-events: auto;
  opacity: 1;
  transition-delay: 0s;
}
.session-switch-panel {
  width: 100%;
  max-height: 90vh;
  padding: 8rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: transparent;
  color: var(--text);
}
.session-switch-handle-zone {
  width: 100%;
  height: 44rpx;
  margin: -4rpx auto 4rpx;
  flex: 0 0 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.session-switch-handle {
  width: 84rpx;
  height: 8rpx;
  margin: 0;
  flex: 0 0 84rpx;
  border-radius: 999rpx;
  background: var(--text-3);
  opacity: .7;
}
.session-switch-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex: 0 0 auto;
}
.session-switch-title { flex: 1; min-width: 0; font-size: 34rpx; font-weight: 600; }
.session-switch-close {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.session-switch-top {
  position: absolute;
  left: 40rpx;                 /* 图标靠左 */
  display: flex;
  align-items: center;         /* 与胶囊垂直居中对齐 */
  justify-content: flex-start;
  z-index: 2;
  pointer-events: none;
}

.session-switch-top .session-switch-search { pointer-events: auto; }

.session-switch-search {
  height: 64rpx;
  width: 64rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  transition: width 0.18s ease, padding 0.18s ease, background 0.18s ease;
  gap: 14rpx;
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  background: var(--fill);
  flex: 0 0 auto;
}
.session-switch-search-icon { width: 32rpx; height: 32rpx; flex: 0 0 32rpx; opacity: .8; }
.theme-light .session-switch-search-icon { filter: brightness(0); }
.session-switch-search-input { flex: 1; min-width: 0; color: var(--text); font-size: 26rpx; }
.session-switch-list { min-height: 0; padding-top: 0; }
.session-switch-list::-webkit-scrollbar { display: none; width: 0; height: 0; }
.session-switch-row {
  min-height: 96rpx;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 18rpx;
}
.session-switch-row.current { background: var(--fill-2); }
.session-switch-row-pressed { background: var(--fill); }
.session-switch-state {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 12rpx;
  border-radius: 50%;
  background: var(--text-3);
  opacity: .42;
}
.session-switch-state.running { background: #31b77a; opacity: 1; box-shadow: 0 0 0 5rpx rgba(49, 183, 122, .13); }
.session-switch-state.unread { background: var(--ocean); opacity: 1; }
.session-switch-state.current { background: #31b77a; opacity: 1; box-shadow: 0 0 0 5rpx rgba(49, 183, 122, .13); }
.session-switch-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.session-switch-row-title { overflow: hidden; color: var(--text); font-size: 28rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.session-switch-activity { color: var(--text-3); font-size: 22rpx; line-height: 1.2; }
.session-switch-current { flex: 0 0 auto; color: var(--ocean); font-size: 22rpx; font-weight: 600; }
.session-switch-empty { padding: 48rpx 16rpx; color: var(--text-3); font-size: 26rpx; text-align: center; }
.session .nav-more .nav-ic { width: 28rpx; height: 28rpx; }
.session .segmented-row .nav-actions .nav-more {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  flex: 0 0 64rpx;
  border: 0;
  background: transparent;
  box-shadow: none;
}
.session .segmented-row .nav-actions .nav-more::before {
  content: '';
  position: absolute;
  z-index: 0;
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border-strong);
  border-radius: 50%;
  background: var(--surface);
  box-shadow: 0 2rpx 8rpx rgba(7, 24, 43, .08);
}
.session .segmented-row .nav-actions .nav-more .nav-ic {
  position: relative;
  z-index: 1;
  width: 24rpx;
  height: 24rpx;
}
.theme-dark .session .segmented-row .nav-actions .nav-more::before {
  border-color: rgba(255, 255, 255, .14);
  background: rgba(255, 255, 255, .08);
  box-shadow: none;
}
.session-switch-lines { gap: 12rpx; }
.session-switch-lines view { height: 3rpx; }

@media (min-width: 700px) {
  .session .segmented-row .nav-actions { right: 28rpx; gap: 8rpx; }
  .session .segmented-row .nav-actions .nav-more { width: 48px; height: 48px; min-width: 48px; max-width: 48px; flex: 0 0 48px; }
  .session .segmented-row .nav-actions .nav-more::before { width: 36px; height: 36px; }
  .session .segmented-row .nav-actions .nav-more .nav-ic { width: 18px; height: 18px; }
  .session-switch-trigger {
    width: 44px;
    height: 48px;
    flex: 0 0 44px;
    border-radius: 8px;
    background: transparent !important;
    box-shadow: none !important;
  }
  .session-switch-lines { width: 20px; gap: 7px; }
  .session-switch-lines view { height: 2px; }
  .session-switch-mask { align-items: flex-start; background: rgba(0, 0, 0, 0); }
  .session-switch-panel {
    position: fixed;
    top: 132px;
    right: 16px;
    width: min(360px, calc(100vw - 32px));
    height: auto !important;
    max-height: min(72vh, 720px);
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: 0 18px 54px rgba(8, 22, 37, .2);
    transform: translateY(-6px) translateX(8px);
  }
  .session-switch-mask.is-open .session-switch-panel { transform: translateY(0) translateX(0); }
  .session-switch-handle-zone { display: none; }
  .session-switch-head { margin: 0 4px 12px; }
  .session-switch-title { font-size: 17px; }
  .session-switch-close { width: 32px; height: 32px; flex-basis: 32px; }
  .session-switch-search { height: 40px; padding: 0 10px; margin-bottom: 8px; gap: 8px; border-radius: 10px; }
  .session-switch-search-icon { width: 16px; height: 16px; flex-basis: 16px; }
  .session-switch-search-input { font-size: 13px; }
  .session-switch-list { max-height: min(62vh, 560px); }
  .session-switch-row { min-height: 56px; padding: 8px 10px; gap: 10px; border-radius: 10px; }
  .session-switch-state { width: 7px; height: 7px; flex-basis: 7px; }
  .session-switch-state.running { box-shadow: 0 0 0 3px rgba(49, 183, 122, .13); }
  .session-switch-state.current { box-shadow: 0 0 0 3px rgba(49, 183, 122, .13); }
  .session-switch-copy { gap: 2px; }
  .session-switch-row-title { font-size: 13px; }
  .session-switch-activity, .session-switch-current { font-size: 11px; }
  .session-switch-empty { padding: 28px 8px; font-size: 13px; }
  .session .nav-more .nav-ic { width: 20px; height: 20px; }
}

@media (prefers-reduced-motion: reduce) {
  .session-switch-mask, .session-switch-panel { transition: none; }
}

/* ---------- 对话节点定位：全屏蒙版 + 垂直居中的对话大纲 ---------- */
.turn-overlay {
  position: fixed;
  inset: 0;
  z-index: 220;
  background: rgba(8, 10, 16, 0.72);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: calc(env(safe-area-inset-top) + 20rpx) 0 calc(env(safe-area-inset-bottom) + 20rpx);
  animation: turnOverlayIn 0.18s ease-out;
}

@keyframes turnOverlayIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.turn-overlay-inner {
  width: 100%;
  max-height: 90vh;              /* 内容最高占屏幕 90% */
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.turn-scrub-body {
  position: relative;
  width: 100%;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.turn-scrub-list {
  height: 76vh;
  max-height: 90vh;
}

.turn-scrub-inner {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  padding: 0;
  box-sizing: border-box;
}

.turn-scrub-spacer { width: 1px; flex: none; }

.turn-scrub-row {
  flex-shrink: 0;
  height: 76rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  border: 1rpx solid transparent;
  transition: opacity 0.12s ease, filter 0.12s ease, transform 0.12s ease, background 0.16s ease, border-color 0.16s ease;
  will-change: opacity, filter, transform;
}

.turn-scrub-row.active {
  background: linear-gradient(90deg, rgba(255, 122, 69, 0.24), rgba(255, 122, 69, 0.06) 72%, transparent);
  border-color: rgba(255, 122, 69, 0.48);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.30), 0 0 28rpx rgba(255, 122, 69, 0.10);
}

.turn-scrub-row-copy {
  flex: 1;
  min-width: 0;
  max-width: 90%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0;
  padding: 0;
}

.turn-scrub-row-title {
  font-size: 27rpx;
  line-height: 1.4;
  color: rgba(241, 244, 250, 0.68);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: color 0.14s ease;
}

.turn-scrub-row.active .turn-scrub-row-title {
  color: #FFFFFF;
  font-weight: 600;
}

/* 右侧横线列：线靠右，圆点在线右侧 */
.turn-scrub-rail-cell {
  width: 108rpx;
  height: 100%;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.turn-scrub-row-line {
  height: 4rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, rgba(241, 244, 250, 0.04), rgba(241, 244, 250, 0.42));
  transition: width 0.16s ease, background 0.16s ease;
}

.turn-scrub-row.active .turn-scrub-row-line {
  height: 6rpx;
  background: linear-gradient(90deg, rgba(255, 122, 69, 0.15), #FF7A45);
  box-shadow: 0 0 16rpx rgba(255, 122, 69, 0.55);
}

.turn-scrub-dot {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #FFD7A8, #FF7A45 70%);
  box-shadow: 0 0 18rpx rgba(255, 122, 69, 0.7);
}

.turn-nav-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 45%;
  text-align: center;
  color: rgba(241, 244, 250, 0.6);
  font-size: 26rpx;
}

.turn-history-status {
  position: absolute;
  z-index: 2;
  top: 0;
  left: 8rpx;
  right: 8rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(19, 24, 33, 0.72);
  color: rgba(241, 244, 250, 0.64);
  font-size: 22rpx;
  text-align: center;
  pointer-events: none;
}
.turn-history-error { color: #FFB49B; pointer-events: auto; }

/* 切换器在蒙版上使用浅色文字，保证可读性（内容结构不变） */
.session-switch-overlay .session-switch-title { color: #F1F4FA; }
.session-switch-overlay .session-switch-close .sheet-close-x { background: rgba(241, 244, 250, 0.12); }
.session-switch-overlay .session-switch-close .sheet-close-x::before,
.session-switch-overlay .session-switch-close .sheet-close-x::after { background: #C0C4CC; }
.session-switch-overlay .session-switch-search {
  background: rgba(241, 244, 250, 0.08);
  border-color: rgba(241, 244, 250, 0.16);
}
.session-switch-overlay .session-switch-search-input { color: #F1F4FA; }
.session-switch-overlay .session-switch-search-icon { filter: none; opacity: .55; }
.session-switch-overlay .session-switch-row-title { color: rgba(241, 244, 250, 0.92); }
.session-switch-overlay .session-switch-activity { color: rgba(241, 244, 250, 0.45); }
.session-switch-overlay .session-switch-current { color: #8EB7FF; }
.session-switch-overlay .session-switch-empty { color: rgba(241, 244, 250, 0.5); }
.session-switch-overlay .session-switch-row.current { background: rgba(241, 244, 250, 0.10); }
.session-switch-overlay .session-switch-row-pressed { background: rgba(241, 244, 250, 0.06); }
.session-switch-overlay .session-switch-state { background: rgba(241, 244, 250, 0.38); }

/* 蒙版上的搜索框：默认 64rpx 圆钮，点击展开为全圆角搜索框 */
.session-switch-overlay .session-switch-search {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  justify-content: center;
  background: rgba(241, 244, 250, 0.10);
  border: 1rpx solid rgba(241, 244, 250, 0.16);
  backdrop-filter: blur(12rpx);
}

.session-switch-overlay .session-switch-search.open {
  padding: 0 22rpx;
  justify-content: flex-start;
  background: rgba(241, 244, 250, 0.12);
}

.session-switch-overlay .session-switch-search-icon {
  filter: none;
  opacity: 0.85;
}

/* 快捷切换：工作区分组标题 */
.session-switch-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 4rpx 8rpx 4rpx;
}

.session-switch-group-title {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: rgba(241, 244, 250, 0.55);
  text-transform: uppercase;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-switch-group-count {
  flex: none;
  font-size: 21rpx;
  color: rgba(241, 244, 250, 0.4);
}
