/* 定时任务页（对齐 dsh-mobile ScheduledTasksView）
 * 浅色：systemBackground 纯白 + 白卡片；深色：黑底 + #1C1C1E 卡片。
 * pt→rpx 按 ×2 换算（iOS 20pt ≈ 40rpx）。 */

.sched {
  --sp-bg: #FFFFFF;
  --sp-card: #FFFFFF;
  --sp-btn: rgba(255, 255, 255, 0.92);
  --sp-tertiary: #F2F2F7;
  --sp-border: rgba(0, 0, 0, 0.07);
  --sp-divider: rgba(0, 0, 0, 0.09);
  --sp-text: #000000;
  --sp-text2: rgba(60, 60, 67, 0.6);
  --sp-rule: #0882F7;
  --sp-danger: #D64F52;
  --sp-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.045);
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--sp-bg);
  color: var(--sp-text);
}

.sched.theme-dark {
  --sp-bg: #000000;
  --sp-card: #1C1C1E;
  --sp-btn: #1C1C1E;
  --sp-tertiary: #2C2C2E;
  --sp-border: rgba(255, 255, 255, 0.14);
  --sp-divider: rgba(255, 255, 255, 0.16);
  --sp-text: #FFFFFF;
  --sp-text2: rgba(235, 235, 245, 0.6);
  --sp-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.55);
}

/* ---------- 头部 ---------- */

.sched-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx 24rpx;
  flex-shrink: 0;
}

.sched-back {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--sp-btn);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sched.theme-dark .sched-back {
  border-color: rgba(255, 255, 255, 0.10);
}

.sched-back-hover {
  opacity: 0.7;
}

.sched-back-ic {
  width: 36rpx;
  height: 36rpx;
}

.sched-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--sp-text);
}

.sched-back-spacer {
  width: 92rpx;
  height: 92rpx;
}

/* ---------- 列表 ---------- */

.sched-scroll {
  flex: 1;
  min-height: 0;
}

.sched-list {
  padding: 36rpx 40rpx 56rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.sched-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 0;
}

.sched-state-ic {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
}

.sched-state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--sp-text);
}

.sched-state-text,
.sched-state-desc {
  font-size: 26rpx;
  color: var(--sp-text2);
  margin-top: 12rpx;
  text-align: center;
}

.sched-retry {
  margin-top: 32rpx;
  color: #007AFF; /* iOS 默认控件色调 */
  font-size: 28rpx;
  font-weight: 500;
  padding: 12rpx 36rpx;
}

.sched-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid rgba(120, 120, 128, 0.24);
  border-top-color: var(--sp-text2);
  border-radius: 50%;
  animation: sched-spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

.sched-spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 3rpx;
  margin: 0 14rpx 0 0;
}

@keyframes sched-spin {
  to { transform: rotate(360deg); }
}

/* ---------- 任务卡片（左滑揭示） ---------- */

.task-wrap {
  position: relative;
}

.task-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  padding-right: 18rpx;
}

.task-action-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-action-edit {
  background: var(--sp-tertiary);
}

.task-action-del {
  background: var(--sp-danger);
}

.task-action-btn.disabled {
  opacity: 0.4;
}

.task-action-ic {
  width: 44rpx;
  height: 44rpx;
}

.task-card {
  position: relative;
  background: var(--sp-card);
  border-radius: 56rpx;
  border: 1rpx solid var(--sp-border);
  box-shadow: var(--sp-shadow);
  overflow: hidden;
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
}

.task-card.dragging {
  transition: none;
}

.task-main {
  display: block;
  padding: 40rpx 40rpx 36rpx;
}

.task-rule {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--sp-rule);
}

.task-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 600;
  color: var(--sp-text);
}

.task-prompt {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  margin-top: 6rpx;
  padding-top: 10rpx;
  font-size: 32rpx;
  color: var(--sp-text2);
}

.task-divider {
  height: 1rpx;
  background: var(--sp-divider);
  margin: 0 40rpx;
}

.task-footer {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx 20rpx 40rpx;
}

.task-date {
  flex: 1;
  font-size: 30rpx;
  color: var(--sp-text2);
}

.task-chev {
  width: 56rpx;
  height: 68rpx;
  transition: transform 0.22s ease;
}

.task-chev.up {
  transform: rotate(180deg);
}

/* 展开详情（max-height 动画近似 iOS 高度测量动画） */
.task-details {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.22s ease;
}

.task-details.open {
  max-height: 800rpx;
}

.td-row {
  display: flex;
  align-items: flex-start;
  padding: 0 40rpx;
  margin-bottom: 26rpx;
  font-size: 28rpx;
}

.task-details .td-row:first-child {
  margin-top: 36rpx;
}

.task-details .td-row:last-child {
  margin-bottom: 44rpx;
}

.td-label {
  width: 184rpx;
  flex-shrink: 0;
  color: var(--sp-text2);
}

.td-value {
  flex: 1;
  color: var(--sp-text);
  word-break: break-all;
}

/* ---------- 编辑弹层 ---------- */

.edit-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 70;
}

.edit-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 71;
  height: 92vh;
  display: flex;
  flex-direction: column;
  background: var(--sp-bg);
  border-radius: 36rpx 36rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.edit-handle {
  width: 76rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(120, 120, 128, 0.28);
  margin: 16rpx auto 4rpx;
  flex-shrink: 0;
}

.edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx 24rpx;
  flex-shrink: 0;
}

.edit-cancel {
  color: #007AFF; /* iOS 默认控件色调 */
  font-size: 32rpx;
  min-width: 96rpx;
}

.edit-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--sp-text);
}

.edit-save {
  color: #007AFF; /* iOS 默认控件色调 */
  font-size: 32rpx;
  font-weight: 600;
  min-width: 96rpx;
  text-align: right;
}

.edit-save.disabled {
  color: var(--sp-text2);
  opacity: 0.5;
}

.btn-dim {
  opacity: 0.6;
}

.edit-body {
  flex: 1;
  min-height: 0;
}

.edit-form {
  padding: 28rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  gap: 44rpx;
}

.edit-sec {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.edit-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--sp-text);
}

.edit-input {
  background: var(--sp-tertiary);
  border-radius: 24rpx;
  padding: 26rpx;
  font-size: 30rpx;
  color: var(--sp-text);
}

.edit-ph {
  color: rgba(60, 60, 67, 0.35);
}

.sched.theme-dark .edit-ph {
  color: rgba(235, 235, 245, 0.4);
}

.edit-caption {
  font-size: 22rpx;
  color: var(--sp-text2);
}

.edit-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 260rpx;
  background: var(--sp-tertiary);
  border-radius: 24rpx;
  padding: 16rpx 26rpx;
  font-size: 30rpx;
  color: var(--sp-text);
}

.edit-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.edit-switch-label {
  font-size: 30rpx;
  color: var(--sp-text);
}

.edit-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--sp-tertiary);
  border-radius: 24rpx;
  padding: 26rpx;
}

.edit-picker-label {
  font-size: 30rpx;
  color: var(--sp-text);
}

.edit-picker-value {
  font-size: 30rpx;
  color: var(--sp-rule);
}

.edit-hint {
  font-size: 28rpx;
  color: var(--sp-text2);
  line-height: 1.5;
}

.edit-warning {
  font-size: 22rpx;
  color: #FF3B30;
}

.edit-error {
  font-size: 28rpx;
  color: #FF3B30;
}

.edit-saving {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--sp-text2);
}
