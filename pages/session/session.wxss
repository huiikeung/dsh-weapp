  margin-bottom: 12rpx;
}

.q-confirm-head .q-header {
  margin: 0;
  font-size: 26rpx;
  font-weight: 500;
}

.question-card .q-question {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.38;
  margin-bottom: 20rpx;
}

.question-card .q-option {
  box-sizing: border-box;
  gap: 16rpx;
  padding: 12rpx 4rpx;
  margin-bottom: 8rpx;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  background: transparent;
}

.question-card .q-option.selected {
  border-color: rgba(46, 107, 230, 0.4);
  background: rgba(46, 107, 230, 0.08);
}

.question-card .q-sel.option-number {
  width: 48rpx;
  height: 48rpx;
  margin-top: 0;
  border: 0;
  border-radius: 10rpx;
  background: #74787D;
  color: #FFFFFF;
  font-size: 26rpx;
  line-height: 48rpx;
}

.question-card .q-sel.option-number.selected {
  background: #2E6BE6;
}

.question-card .q-option-label {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}

.question-card .q-option-desc {
  margin-top: 2rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.question-card .q-footer {
  box-sizing: border-box;
  gap: 8rpx;
  padding: 18rpx 0 0;
  margin-top: 12rpx;
}

.question-card .q-page-btn {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  padding: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.question-card .q-page-num {
  flex: 0 0 auto;
  white-space: nowrap;
}

.question-card .q-footer .pending-btn {
  flex: 0 0 auto;
  box-sizing: border-box;
  min-height: 72rpx;
  padding: 12rpx 22rpx;
  margin-left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  font-size: 26rpx;
}

/* 历史诊断行（临时） */

/* 过程组活标题（对齐 iOS 组头：耗时 X · N 项上下文） */
.run-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx 18rpx 0;
}

.run-group-title {
  font-size: 30rpx;
  color: var(--text-2, #5B6472);
}

.run-group-divider {
  height: 1rpx;
  background: var(--divider, rgba(0, 0, 0, 0.08));
  margin: 0 0 18rpx;
}

/* ============ 会话区三态（对齐 iOS ConversationView） ============ */
.conv-state {
  padding: 120rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.state-spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(46, 107, 230, 0.18);
  border-top-color: #2E6BE6;
  animation: state-spin 0.9s linear infinite;
}

@keyframes state-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.state-title {
  font-size: 40rpx;               /* title3 20pt semibold */
  font-weight: 600;
  color: var(--text, #1A1D24);
}

.state-sub {
  font-size: 26rpx;
  color: var(--text-2, #5B6472);
}

.state-err {
  font-size: 24rpx;             /* subheadline */
  line-height: 1.6;
  text-align: center;
}

/* 重新加载历史（iOS .bordered 按钮） */
.state-btn {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #2E6BE6;
  border: 1.4rpx solid rgba(46, 107, 230, 0.4);
  border-radius: 40rpx;
  padding: 14rpx 44rpx;
}

.conv-fail .state-title {
  color: var(--text);
}

.hist-warn {
  width: 68rpx;                   /* largeTitle 34pt */
  height: 68rpx;
  margin-bottom: 4rpx;
}

/* ===== dsh-mobile ConversationView parity layer ===== */
.session {
