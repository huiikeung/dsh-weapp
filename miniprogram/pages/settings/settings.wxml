<!-- 弹窗浮层都在页面根节点之外，单独包一层主题容器，保证深/浅色变量与文字色可用 -->
<view class="{{themeClass}}" style="--glass-alpha-top: {{glassAlphaTop}}; --glass-alpha-bottom: {{glassAlphaBottom}}; --glass-edge-alpha: {{glassEdgeAlpha}}; --glass-blur-sheet: {{glassBlurSheet}}; --glass-blur-card: {{glassBlurCard}}; --glass-radius-sheet: {{glassRadiusSheet}}; --glass-radius-card: {{glassRadiusCard}}; --glass-radius-choice: {{glassRadiusChoice}}; --glass-backdrop-brightness: {{glassBackdropBrightness}};">
<!-- 玻璃样式设置弹窗（仅玻璃模式）：玻璃皮肤，底部弹窗 / 非底部浮层两种形态 -->
<view wx:if="{{glassStyleOpen}}" class="{{settingsGlassSheetEnabled ? 'glass-style-mask' : 'glass-style-mask glass-style-mask-pass'}}" catchtap="closeGlassStyleSheet" catchtouchmove="noop"></view>
<view
  wx:if="{{glassStyleOpen}}"
  class="{{settingsGlassSheetEnabled ? 'glass-style-sheet' : 'glass-style-pop'}}"
  style="--glass-paint: {{glassStylePaint ? 1 : 0}}; {{settingsGlassSheetEnabled ? '' : 'left: ' + glassStyleLeft + 'px; top: ' + glassStyleTop + 'px; width: ' + glassStyleWidth + 'px; transform-origin: 50% ' + glassStyleOriginY + 'px;'}}"
  catchtap="noop"
  role="dialog"
  aria-label="{{ui['玻璃样式设置']}}"
>
  <view wx:if="{{settingsGlassSheetEnabled}}" class="sheet-grabber"></view>
  <view class="glass-style-head">
    <text class="glass-style-title">{{ui['玻璃样式设置']}}</text>
    <view class="glass-style-actions">
      <view class="glass-style-reset tap" catchtap="resetGlassStyle" role="button">{{ui['重置为默认']}}</view>
      <view class="glass-style-done tap" catchtap="closeGlassStyleSheet" role="button">{{ui['完成']}}</view>
    </view>
  </view>
  <view class="card-preview-stage plain">
    <view class="card-preview-card" style="border-radius: {{glassRadiusCard}}; background: linear-gradient(165deg, rgba(255, 255, 255, {{glassPreviewTop}}), rgba(255, 255, 255, {{glassPreviewBottom}})), {{glassPreviewBase}}; box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.20), inset 0 0 0 1px rgba(255, 255, 255, {{glassPreviewEdge}}), 0 12px 32px rgba(3, 14, 30, 0.30); backdrop-filter: blur({{glassBlurSheet}}) brightness({{glassBackdropBrightness}}); -webkit-backdrop-filter: blur({{glassBlurSheet}}) brightness({{glassBackdropBrightness}});">
      <view class="card-preview-dot"></view>
      <view class="card-preview-copy">
        <text class="card-preview-title">{{ui['预览']}}</text>
        <text class="card-preview-sub">{{glassAlpha}}% · {{glassBlur}}rpx · {{glassEdge}}% · {{glassRadius}}rpx</text>
      </view>
    </view>
  </view>
          <view class="glass-alpha-row">
            <text class="glass-style-label">{{ui['玻璃透明度']}}</text>
            <view class="glass-alpha-control">
              <slider
                class="glass-alpha-slider"
                min="{{glassAlphaMin}}"
                max="{{glassAlphaMax}}"
                step="1"
                value="{{glassAlpha}}"
                activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}"
                backgroundColor="rgba(150, 150, 155, 0.35)"
                block-size="22"
                data-field="alpha"
                bindchanging="onGlassStyleChanging"
                bindchange="onGlassStyleChange"
              />
              <text class="glass-alpha-value">{{glassAlpha}}%</text>
            </view>
          </view>
          <view class="glass-alpha-row">
            <text class="glass-style-label">{{ui['玻璃模糊']}}</text>
            <view class="glass-alpha-control">
              <slider
                class="glass-alpha-slider"
                min="{{glassBlurMin}}"
                max="{{glassBlurMax}}"
                step="1"
                value="{{glassBlur}}"
                activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}"
                backgroundColor="rgba(150, 150, 155, 0.35)"
                block-size="22"
                data-field="blur"
                bindchanging="onGlassStyleChanging"
                bindchange="onGlassStyleChange"
              />
              <text class="glass-alpha-value">{{glassBlur}}rpx</text>
            </view>
          </view>
          <view class="glass-alpha-row">
            <text class="glass-style-label">{{ui['玻璃亮度']}}</text>
            <view class="glass-alpha-control">
              <slider
                class="glass-alpha-slider"
                min="{{glassBrightnessMin}}"
                max="{{glassBrightnessMax}}"
                step="1"
                value="{{glassBrightness}}"
                activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}"
                backgroundColor="rgba(150, 150, 155, 0.35)"
                block-size="22"
                data-field="brightness"
                bindchanging="onGlassStyleChanging"
                bindchange="onGlassStyleChange"
              />
              <text class="glass-alpha-value">{{glassBrightness}}%</text>
            </view>
          </view>
          <view class="glass-alpha-row">
            <text class="glass-style-label">{{ui['玻璃亮边']}}</text>
            <view class="glass-alpha-control">
              <slider
                class="glass-alpha-slider"
                min="{{glassEdgeMin}}"
                max="{{glassEdgeMax}}"
                step="1"
                value="{{glassEdge}}"
                activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}"
                backgroundColor="rgba(150, 150, 155, 0.35)"
                block-size="22"
                data-field="edge"
                bindchanging="onGlassStyleChanging"
                bindchange="onGlassStyleChange"
              />
              <text class="glass-alpha-value">{{glassEdge}}%</text>
            </view>
          </view>
          <view class="glass-alpha-row">
            <text class="glass-style-label">{{ui['玻璃圆角']}}</text>
            <view class="glass-alpha-control">
              <slider
                class="glass-alpha-slider"
                min="{{glassRadiusMin}}"
                max="{{glassRadiusMax}}"
                step="1"
                value="{{glassRadius}}"
                activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}"
                backgroundColor="rgba(150, 150, 155, 0.35)"
                block-size="22"
                data-field="radius"
                bindchanging="onGlassStyleChanging"
                bindchange="onGlassStyleChange"
              />
              <text class="glass-alpha-value">{{glassRadius}}rpx</text>
            </view>
          </view>
          
</view>

<!-- 原生样式设置弹窗（仅原生模式）：原生皮肤，背景随原生背景亮度即时变化 -->
<view wx:if="{{nativeStyleOpen}}" class="glass-style-mask glass-style-mask-pass" catchtap="closeNativeStyleSheet" catchtouchmove="noop"></view>
<view
  wx:if="{{nativeStyleOpen}}"
  class="native-skin {{settingsGlassSheetEnabled ? 'glass-style-sheet' : 'glass-style-pop'}}"
  style="background-color: {{nativeSurfaceColor}}; {{settingsGlassSheetEnabled ? '' : 'left: ' + glassStyleLeft + 'px; top: ' + glassStyleTop + 'px; width: ' + glassStyleWidth + 'px; transform-origin: 50% ' + glassStyleOriginY + 'px;'}}"
  catchtap="noop"
  role="dialog"
  aria-label="{{ui['原生样式设置']}}"
>
  <view wx:if="{{settingsGlassSheetEnabled}}" class="sheet-grabber"></view>
  <view class="glass-style-head">
    <text class="glass-style-title">{{ui['原生样式设置']}}</text>
    <view class="glass-style-actions">
      <view class="glass-style-done tap" catchtap="closeNativeStyleSheet" role="button">{{ui['完成']}}</view>
    </view>
  </view>
          <view class="glass-alpha-row">
            <text class="glass-style-label">{{ui['原生背景亮度']}}</text>
