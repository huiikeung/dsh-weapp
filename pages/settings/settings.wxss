}

.public-share-meta {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.public-share-expiry {
  color: var(--text-2);
  font-size: 22rpx;
}

.public-share-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.public-share-actions button {
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 10rpx;
  background: var(--fill);
  color: var(--ocean);
  font-size: 23rpx;
  line-height: 56rpx;
}

.public-share-actions button::after {
  border: 0;
}

.public-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.public-actions .public-share {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.public-redeem {
  flex: 1;
  min-width: 0;
  margin: 0;
  height: 88rpx;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--ocean);
  font-size: 28rpx;
  line-height: 88rpx;
}

.public-redeem::after {
  border: 0;
}

.public-redeem[disabled] {
