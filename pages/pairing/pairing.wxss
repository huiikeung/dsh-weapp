/* 浅色为基础，深色在底部 @media 恢复深海蓝品牌视觉 */

.pairing {
  padding: 60rpx 48rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  padding-top: 40rpx;
  margin-bottom: 60rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.brand-mark {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.brand-text {
  color: var(--text);
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 18rpx;
}

.brand-badge {
  color: var(--text-2);
  border: 1rpx solid var(--border-strong);
  border-radius: 12rpx;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  letter-spacing: 2rpx;
}

.actions {
  margin-bottom: 40rpx;
}

.manual {
  padding: 36rpx 32rpx;
  margin-bottom: 40rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  /* 原生 <input> 在 backdrop-filter 祖先下无法聚焦、光标不显示、键盘不弹出，故此卡片取消模糊 */
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.manual-title {
  color: var(--text);
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.input {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 30rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.hint {
  color: var(--text-3);
  font-size: 25rpx;
  line-height: 1.7;
  margin-bottom: 30rpx;
}

.error {
  color: #E5484D;
  font-size: 27rpx;
  margin-bottom: 20rpx;
}

.status-text {
  color: var(--ocean);
  font-size: 27rpx;
  margin-bottom: 20rpx;
}

.restore {
  text-align: center;
  color: var(--text-2);
}

/* 浅色下的品牌与玻璃控件覆盖（theme-light，随外观模式切换） */
.theme-light .deep-bg {
  display: none;
}

.theme-light .brand-whale {
  filter: brightness(0);
  opacity: 0.85;
}

.theme-light .title-hero {
  color: var(--text);
}

.theme-light .subtitle-hero {
  color: var(--text-2);
}

.theme-light .btn-glass {
  background: var(--fill-2);
  border: 1rpx solid var(--border-strong);
  color: var(--text);
}

/* ---------- 深色：恢复深海蓝品牌视觉（theme-dark） ---------- */

.theme-dark .deep-bg {
  display: block;
}

.theme-dark .brand-whale {
  filter: none;
  opacity: 1;
}

.theme-dark .btn-glass {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
}

.theme-dark .manual {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(255, 255, 255, 0.14);
}

.theme-dark .brand-badge {
  color: var(--mist);
  border-color: rgba(191, 212, 255, 0.5);
}

.theme-dark .status-text,
.theme-dark .restore {
  color: var(--mist);
}

.theme-dark .error {
  color: #FF8589;
}
