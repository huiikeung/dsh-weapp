/* Desktop reading-view process rows: one icon gutter, no nested tool gate. */
/* 去掉组头下方的分隔横线后，收窄组头/组体的上下内边距，过程组更紧凑。 */
.process-head { gap: 12rpx; min-height: 50rpx; padding: 6rpx 0; }
.process-title { font-size: 28rpx; font-weight: 400; flex-shrink: 0; max-width: 48%; }
.process-title.failed { color: #D4545B; }
.process-command-icon, .event-glyph, .tool-glyph-small { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.process-summary { padding: 0; color: var(--text-3); font-size: 22rpx; line-height: 1.5; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.process-head .event-spacer { flex: 1 0 0; }
.event-chevron { width: 24rpx; height: 24rpx; opacity: .7; }
.process-body { padding: 2rpx 0 6rpx; }
.process-narration { margin:4rpx 0 16rpx; }
.process-narration-text { display:block;white-space:pre-wrap;overflow-wrap:anywhere; }
/* Live status follows its details, directly above the whale progress strip.
   Settled groups retain their normal header-first disclosure layout. */
.process-block.running { display:flex;flex-direction:column; }
.process-block.running > .process-body { order:0; }
.process-block.running > .process-head { order:1; }
.disclosure { border-bottom: 0; }
.disclosure-head, .disclosure-head.tool { gap: 10rpx; padding: 8rpx 0; min-height: 56rpx; }
.tool-bundle-body { padding: 0; }
.tool-node { border-top: 0; }
.event-title, .event-preview { font-size: 26rpx; color: var(--text-2); }
.event-body { margin-left: 15rpx; padding-left: 0; gap: 27rpx; }
.event-body-text { font-size: 26rpx; line-height: 1.65; }
.tool-detail { padding-left: 44rpx; }
.tool-act { color: var(--text-2); font-size: 26rpx; font-weight: 400; }
.tool-line-1 { min-width: 0; width: 100%; flex-wrap: nowrap; }
.tool-act, .tool-status { flex-shrink: 0; }
.tool-act { max-width: 48%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tool-note { font-size: 23rpx; line-height: 1.55; min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* Desktop BashRow: disclosure, description, one unified command/output card. */
.tool-note { font-family:inherit; }
.tool-separator { color:var(--text-3);flex-shrink:0;font-size:24rpx; }
.command-icon-slot { position:relative;display:flex;align-items:center;justify-content:center;width:32rpx;height:32rpx;flex-shrink:0; }
.command-tool-icon { opacity:1; }
.command-chevron { position:absolute;left:4rpx;top:4rpx;width:24rpx;height:24rpx;transform:rotate(90deg);opacity:0;pointer-events:none; }
.command-chevron.open { transform:rotate(-90deg); }
/* 回合级「已完成」行前面只有箭头（对齐桌面端 TurnProcessNodeView），常驻可见 */
.turn-process-slot .command-chevron { opacity:.65; }
/* Expanded state persists after touch ends; tapping again restores the glyph. */
.command-icon-slot.disclosed .command-tool-icon { opacity:0; }
.command-icon-slot.disclosed .command-chevron { opacity:.65; }
.tool-head-hover { background:var(--fill); }
.command-node .disclosure-head.tool { gap:10rpx; }
.command-node .tool-line-1 { gap:10rpx; }
.command-node .tool-act { font-size:26rpx; }
.command-node .tool-note { font-size:24rpx; }
.command-card { margin:0 0 16rpx 0;border:1rpx solid var(--border);border-radius:22rpx;background:var(--fill);overflow:hidden; }
.command-card-head { display:flex;align-items:center;gap:14rpx;padding:18rpx 20rpx 8rpx;min-width:0; }
.command-state { width:10rpx;height:10rpx;border-radius:50%;flex-shrink:0;background:var(--text-3); }
.command-state.done { background:#28B970; }
.command-state.waiting { background:#D59A31; }
.command-state.failed { background:#DC555C; }
.command-cwd { min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-3);font-size:20rpx;font-family:monospace; }
.command-state-label { color:var(--text-3);font-size:20rpx;white-space:nowrap; }
.command-copy { margin-left:auto;flex-shrink:0;color:var(--text-2);font-size:24rpx;padding:4rpx 0 4rpx 14rpx; }
.command-input { width:100%; }
.command-code-lines { padding:4rpx 20rpx 20rpx;min-width:100%;display:inline-block;box-sizing:border-box; }
.command-code-line { display:flex;gap:14rpx;min-height:34rpx;font-family:monospace;font-size:22rpx;line-height:1.6; }
.command-prompt { color:var(--text-3);flex-shrink:0; }
.command-source { color:var(--text);white-space:pre; }
.command-output { border-top:1rpx solid var(--border);max-height:440rpx;width:100%; }
.command-output-text { display:block;min-width:100%;width:max-content;padding:20rpx 44rpx;font-family:monospace;font-size:22rpx;line-height:1.6;white-space:pre;color:var(--text); }
.command-output.failed .command-output-text { color:#D4545B; }
.command-placeholder { color:var(--text-3);padding:16rpx 24rpx;font-size:22rpx; }
.command-empty-output { border-top:1rpx solid var(--border); }
/* Reading-view reasoning card; expansion is independent of the process fold. */
.reasoning-card { --reading-bg:#F5F6F7;margin:14rpx 0 18rpx;border:1rpx solid var(--border);border-radius:20rpx;background:var(--reading-bg);padding:20rpx 28rpx 12rpx;overflow:hidden; }
.theme-dark .reasoning-card { --reading-bg:#17191D; }
.reasoning-card-head { display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:18rpx; }
.reasoning-card-title,.reasoning-step { font-size:22rpx;color:var(--text-2);font-weight:400; }
.reasoning-reading-area { position:relative; }
.reasoning-scroll { width:100%; }
