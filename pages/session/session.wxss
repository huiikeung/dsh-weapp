.session {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* ---------- 顶部导航 ---------- */

.navbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  flex-shrink: 0;
}

.nav-back,
.nav-more {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 16rpx rgba(7, 24, 43, 0.08);
  flex-shrink: 0;
}

.nav-more {
  font-size: 34rpx;
  letter-spacing: 2rpx;
}

.nav-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin: 0 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-preset {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--gray);
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* ---------- 分段控件 ---------- */

.segmented {
  display: flex;
  margin: 8rpx 40rpx 20rpx;
  border-radius: 999rpx;
  padding: 8rpx;
  background: rgba(16, 19, 24, 0.06);
  box-shadow: none;
  border: none;
  flex-shrink: 0;
}

.segment {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  color: var(--gray);
}

.segment.active {
  background: #FFFFFF;
  color: var(--ink);
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(7, 24, 43, 0.10);
}

/* ---------- 对话 ---------- */

.conversation,
.trajectory {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 0 40rpx;
}

.load-more {
  text-align: center;
  color: var(--gray);
  font-size: 25rpx;
  padding: 20rpx 0;
}

.row-user {
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(16, 19, 24, 0.06);
}

.row-user-title {
  font-size: 26rpx;
  color: var(--gray);
  margin-bottom: 10rpx;
}

.row-user-text {
  font-size: 31rpx;
  color: var(--ink);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.row-assistant {
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(16, 19, 24, 0.06);
}

.row-streaming-title {
  font-size: 25rpx;
  color: var(--ocean);
  margin-bottom: 14rpx;
}

.row-event {
  padding: 20rpx 0;
  display: flex;
  align-items: center;
}

.event-tag {
  font-size: 22rpx;
  color: var(--gray);
  background: rgba(16, 19, 24, 0.06);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.event-tag.error {
  color: #E5484D;
  background: rgba(229, 72, 77, 0.10);
}

.event-text {
  font-size: 26rpx;
  color: var(--gray);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 折叠行（思考 / 工具） ---------- */

.fold {
  background: rgba(16, 19, 24, 0.04);
  border-radius: 18rpx;
  margin: 14rpx 0;
  overflow: hidden;
}

.fold-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.fold-glyph {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.tool-glyph {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.fold-title {
  flex: 1;
  font-size: 27rpx;
  color: var(--ink);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fold-chevron {
  width: 24rpx;
  height: 24rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
  transform: rotate(-90deg);
  transition: transform 0.18s ease;
}

.fold-chevron.open {
  transform: rotate(0deg);
}

.tool-status {
  font-size: 24rpx;
  color: var(--gray);
  margin-left: 14rpx;
  flex-shrink: 0;
}

.tool-status.done { color: var(--success); }
.tool-status.error { color: #E5484D; }

.fold-body {
  padding: 0 24rpx 20rpx;
  font-size: 26rpx;
  color: var(--gray);
  white-space: pre-wrap;
  word-break: break-all;
}

/* ---------- Markdown ---------- */

.md-block {
  margin: 10rpx 0;
}

.md-para {
  font-size: 31rpx;
  line-height: 1.65;
  color: var(--ink);
  display: block;
}

.md-heading {
  display: block;
  color: var(--ink);
  font-weight: 700;
  margin-top: 20rpx;
}

.md-h1 { font-size: 40rpx; }
.md-h2 { font-size: 36rpx; }
.md-h3 { font-size: 33rpx; }
.md-h4, .md-h5, .md-h6 { font-size: 31rpx; }

.md-quote {
  display: block;
  border-left: 6rpx solid var(--mist);
  padding-left: 20rpx;
  color: var(--gray);
  font-size: 29rpx;
  margin: 16rpx 0;
}

.md-hr {
  height: 1rpx;
  background: rgba(16, 19, 24, 0.12);
  margin: 30rpx 0;
}

.md-list {
  margin: 10rpx 0;
}

.md-li {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0;
}

.md-li-marker {
  color: var(--gray);
  margin-right: 16rpx;
  font-size: 29rpx;
  flex-shrink: 0;
}

.md-li-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--ink);
}

/* ---------- 代码块 ---------- */

.code-block {
  position: relative;
  background: #ECEDEF;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 20rpx 0;
}

.code-lang {
  font-size: 23rpx;
  color: var(--gray);
  padding: 18rpx 28rpx 0;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.code-body {
  padding: 12rpx 28rpx 26rpx;
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-all;
  max-height: 480rpx;
  overflow-y: auto;
}

.code-copy {
  position: absolute;
  top: 14rpx;
  right: 20rpx;
  font-size: 22rpx;
  color: var(--ocean);
  background: rgba(255, 255, 255, 0.85);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

/* ---------- 图片附件 ---------- */

.attach-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.attach-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  margin: 0 16rpx 16rpx 0;
  background: rgba(16, 19, 24, 0.06);
}

.conv-bottom {
  height: 20rpx;
}

/* ---------- 轨迹 ---------- */

.trace-summary {
  background: rgba(16, 19, 24, 0.05);
  border-radius: 22rpx;
  padding: 28rpx 28rpx 22rpx;
  margin-bottom: 24rpx;
}

.trace-summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: var(--ink);
  margin-bottom: 22rpx;
}

.trace-total {
  color: var(--ink);
  font-weight: 600;
}

.trace-lane {
  display: flex;
  align-items: center;
  margin: 12rpx 0;
}

.lane-label {
  width: 110rpx;
  font-size: 25rpx;
  color: var(--gray);
  flex-shrink: 0;
}

.lane-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(16, 19, 24, 0.08);
  overflow: hidden;
}

.lane-fill {
  height: 100%;
  border-radius: 999rpx;
}

.lane-fill.input { background: var(--ocean); }
.lane-fill.model { background: var(--purple); }
.lane-fill.tools { background: var(--orange); }

.trace-axis {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  color: var(--gray);
  margin-top: 14rpx;
}

.trace-turn {
  display: flex;
  align-items: center;
  margin: 28rpx 0 10rpx;
}

.trace-turn text {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 26rpx;
  color: var(--gray);
  flex-shrink: 0;
  margin-right: 18rpx;
}

.trace-turn-line {
  flex: 1;
  height: 1rpx;
  background: rgba(16, 19, 24, 0.12);
}

.trace-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(16, 19, 24, 0.05);
}

.trace-badge {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 21rpx;
  border-radius: 10rpx;
  padding: 5rpx 12rpx;
  flex-shrink: 0;
  margin-right: 14rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.trace-badge.user {
  color: var(--ocean);
  background: rgba(46, 107, 230, 0.14);
}

.trace-badge.assistant {
  color: var(--purple);
  background: rgba(122, 84, 199, 0.14);
}

.trace-badge.tool {
  color: var(--orange);
  background: rgba(240, 125, 20, 0.14);
}

.trace-badge.event {
  color: var(--gray);
  background: rgba(16, 19, 24, 0.08);
}

.trace-label {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 600;
  margin-right: 14rpx;
  flex-shrink: 0;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trace-preview {
  flex: 1;
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 25rpx;
  color: var(--gray);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trace-seq {
  font-size: 24rpx;
  color: var(--gray);
  margin: 0 10rpx 0 14rpx;
  flex-shrink: 0;
}

.trace-chevron {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.empty {
  text-align: center;
  color: var(--gray);
  padding: 80rpx 0;
  font-size: 27rpx;
}

/* ---------- 待处理卡片 ---------- */

.pending-card {
  margin: 0 40rpx 20rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(46, 107, 230, 0.25);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(7, 24, 43, 0.10);
  flex-shrink: 0;
}

.pending-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.q-item {
  margin-bottom: 18rpx;
}

.q-question {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.q-detail {
  font-size: 25rpx;
  color: var(--gray);
  margin-bottom: 12rpx;
}

.q-options {
  display: flex;
  flex-direction: column;
}

.q-option {
  border: 1rpx solid rgba(16, 19, 24, 0.14);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}

.q-option.selected {
  border-color: var(--ocean);
  background: rgba(46, 107, 230, 0.08);
}

.q-option-label {
  font-size: 28rpx;
  color: var(--ink);
}

.q-option-desc {
  font-size: 24rpx;
  color: var(--gray);
  margin-top: 4rpx;
}

.q-custom {
  background: var(--paper);
  border: 1rpx solid rgba(16, 19, 24, 0.1);
}

.pending-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.pending-btn {
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  margin-left: 18rpx;
}

.pending-btn.ghost {
  color: var(--gray);
  border: 1rpx solid rgba(16, 19, 24, 0.16);
}

.pending-btn.primary {
  color: #FFFFFF;
  background: var(--ocean);
}

.pending-btn.disabled {
  opacity: 0.5;
}

.approval-tool {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.approval-reason {
  font-size: 26rpx;
  color: var(--gray);
  margin-bottom: 10rpx;
}

/* ---------- 输入面板 ---------- */

.composer {
  margin: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  padding: 24rpx 28rpx 18rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.composer-input {
  width: 100%;
  min-height: 72rpx;
  max-height: 320rpx;
  font-size: 30rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.composer-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.composer-thumb {
  position: relative;
  margin-right: 14rpx;
}

.composer-thumb-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
}

.composer-thumb-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(16, 19, 24, 0.65);
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-bar {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.chip {
  font-size: 24rpx;
  color: var(--gray);
  background: rgba(16, 19, 24, 0.06);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.chip.effort {
  background: rgba(122, 84, 199, 0.14);
  color: var(--purple);
}

.chip.icon {
  font-size: 26rpx;
  padding: 10rpx 18rpx;
}

.composer-spacer {
  flex: 1;
}

.send-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--ocean);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.send-btn.disabled {
  background: rgba(46, 107, 230, 0.35);
}

.send-btn.stop {
  background: var(--gray);
  font-size: 28rpx;
}

.composer-stats {
  text-align: right;
  font-size: 23rpx;
  color: var(--gray);
  margin-top: 12rpx;
}

/* ---------- 抽屉 ---------- */

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(7, 24, 43, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 75vh;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(16, 19, 24, 0.18);
  margin: 8rpx auto 24rpx;
}

.sheet-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.sheet-title-text {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 600;
  margin-left: 16rpx;
}

.sheet-body {
  flex: 1;
  min-height: 0;
}

.sheet-copy {
  text-align: center;
  flex-shrink: 0;
}

/* ===== 图标资产尺寸（iOS 对齐） ===== */
.nav-ic {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.event-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.trace-summary-stats {
  display: flex;
  align-items: center;
}

.stat-ic {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.trace-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.trace-dot.dot-user { background: var(--ocean); }
.trace-dot.dot-assistant { background: var(--purple); }
.trace-dot.dot-tool { background: var(--orange); }
.trace-dot.dot-event { background: var(--gray); }

.pending-title {
  display: flex;
  align-items: center;
}

.q-ic {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.chip {
  display: flex;
  align-items: center;
}

.chip-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.chip-ud {
  width: 22rpx;
  height: 22rpx;
  margin-left: 8rpx;
}

.chip.effort,
.effort-pill {
  color: var(--purple);
  background: rgba(122, 84, 199, 0.14);
  border-radius: 14rpx;
  padding: 4rpx 14rpx;
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.chip.effort {
  border: 0;
  padding: 8rpx 18rpx;
}

.context-ring {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  position: relative;
  flex-shrink: 0;
}

.context-ring-in {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  border-radius: 50%;
  background: var(--paper);
}

.attach-ic {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.thumb-x {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.send-ic {
  width: 38rpx;
  height: 38rpx;
  display: block;
}

.sheet-copy {
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.trace-badge.event {
  background: rgba(142, 142, 147, 0.14);
  color: var(--gray);
}

/* ---------- 深色模式覆盖（page-dark） ---------- */

.page-dark .nav-back,
.page-dark .nav-more {
  background: rgba(255, 255, 255, 0.08);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.page-dark .nav-title {
  color: #FFFFFF;
}

.page-dark .row-user-text {
  color: #FFFFFF;
}

.page-dark .fold-title {
  color: #FFFFFF;
}

.page-dark .fold-body {
  color: rgba(255, 255, 255, 0.7);
}

.page-dark .fold {
  background: rgba(255, 255, 255, 0.05);
}

.page-dark .md-para {
  color: #E5E5EA;
}

.page-dark .md-heading {
  color: #FFFFFF;
}

.page-dark .md-li-text {
  color: #E5E5EA;
}

.page-dark .code-block {
  background: rgba(0, 0, 0, 0.35);
}

.page-dark .code-body {
  color: #E5E5EA;
}

.page-dark .code-copy {
  background: rgba(255, 255, 255, 0.1);
  color: #FFFFFF;
}

.page-dark .pending-card {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.15);
}

.page-dark .q-custom {
  background: rgba(255, 255, 255, 0.05);
}

.page-dark .composer-input {
  color: #FFFFFF;
}

.page-dark .composer {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.page-dark .context-ring-in {
  background: rgba(255, 255, 255, 0.1);
}

/* 深色模式图标反色 */
.page-dark .nav-ic {
  filter: invert(1) brightness(0.85);
}
