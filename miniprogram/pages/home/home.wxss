@import "../../styles/quota-sidebar.wxss";
page {
background: #FFFFFF;
}
@media (prefers-color-scheme: dark) {
page {
background: #141518;
}
}
.home {
padding: 30rpx 44rpx 60rpx;
}
.home-root {
position: relative;
height: 100vh;
overflow: hidden;
background: #FFFFFF;
}
.home-root.theme-dark {
background: #141518;
}
.home-content-wrap {
position: relative;
z-index: 53;
height: 100vh;
background: var(--navy);
}
.home-content-wrap.shifted {
overflow: hidden;
box-shadow:
inset 3rpx 0 0 rgba(255, 255, 255, 0.24),
inset 8rpx 0 18rpx rgba(255, 255, 255, 0.08),
inset 12rpx 0 30rpx rgba(0, 0, 0, 0.16),
inset 26rpx 0 60rpx rgba(0, 0, 0, 0.14);
}
.theme-dark .home-content-wrap.shifted {
border-left: 0;
box-shadow:
inset 3rpx 0 0 rgba(255, 255, 255, 0.40),
inset 9rpx 0 22rpx rgba(255, 255, 255, 0.14),
inset 14rpx 0 40rpx rgba(0, 0, 0, 0.42),
inset 30rpx 0 78rpx rgba(0, 0, 0, 0.46);
}
.home-deep-bg {
position: absolute;
z-index: 0;
}
.home-scroll {
position: relative;
z-index: 1;
height: 100vh;
}
.drawer-anim {
transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1);
}
.home-content-wrap.drawer-anim {
transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1), border-radius 0.38s cubic-bezier(0.32, 0.72, 0, 1), box-shadow 0.38s cubic-bezier(0.32, 0.72, 0, 1);
}
.drawer {
position: fixed;
left: 0;
top: 0;
bottom: 0;
z-index: 52;
background: #FFFFFF;
transform: translateX(-100%);
}
.drawer-body {
padding: calc(20rpx + env(safe-area-inset-top)) 36rpx calc(24rpx + env(safe-area-inset-bottom));
height: 100%;
box-sizing: border-box;
display: flex;
flex-direction: column;
align-items: flex-start;
}
.drawer-bottom { width: 100%; margin-top: auto; flex-shrink: 0; }
.drawer-footer { width: 100%; padding-top: 24rpx; flex-shrink: 0; }
.drawer-settings { box-sizing: border-box; }
.qs-wrap { width: 100%; margin: 18rpx 0 12rpx; }
.qs-pressed { opacity: .78; }
.drawer-cost-unavailable { display: flex; width: 100%; box-sizing: border-box; flex-direction: column; gap: 6rpx; margin: 18rpx 0 12rpx; padding: 17rpx 22rpx; border: 1rpx solid rgba(122, 142, 175, .16); border-radius: 20rpx; background: rgba(116, 133, 161, .07); }
.drawer-cost-unavailable-title { color: var(--text); font-size: 26rpx; font-weight: 620; }
.drawer-cost-unavailable-hint { color: var(--text-3); font-size: 21rpx; line-height: 1.4; }
.drawer-brand {
display: flex;
align-items: center;
padding: 0 0 32rpx 24rpx;
width: 100%;
}
.drawer-whale {
width: 58rpx;
height: 58rpx;
margin-right: 7rpx;
margin-top: -8rpx;
flex: none;
}
.drawer-brand-badge {
color: #FFFFFF;
background: #10151F;
border: 0;
border-radius: 8rpx;
font-size: 19rpx;
font-weight: 600;
line-height: 30rpx;
height: 30rpx;
padding: 0 12rpx;
margin-top: 1rpx;
letter-spacing: 1rpx;
flex-shrink: 0;
}
.drawer-whale-dark {
display: none;
}
.drawer-item {
display: flex;
align-items: center;
width: 100%;
height: 104rpx;
padding: 0 28rpx;
border-radius: 24rpx;
}
.drawer-item-active {
background: rgba(16, 19, 24, 0.06);
}
.drawer-item-ic {
width: 44rpx;
height: 44rpx;
margin-right: 20rpx;
flex-shrink: 0;
}
.drawer-item-ic-clock {
width: 44rpx;
height: 44rpx;
margin-left: 0;
margin-right: 20rpx;
flex-shrink: 0;
}
.drawer-item-ic-dark {
display: none;
}
.drawer-item-text {
font-size: 34rpx;
color: var(--ink);
}
.drawer-mask {
position: absolute;
left: 0;
top: 0;
right: 0;
bottom: 0;
z-index: 30;
background: #000000;
}
.brand-dim {
opacity: 0.7;
}
.topbar {
position: absolute;
left: 0;
right: 0;
z-index: 5;
display: flex;
align-items: center;
padding-left: 44rpx;
padding-right: 44rpx;
background: transparent;
}
.topbar-inline {
display: flex;
align-items: center;
padding: 0;
margin-bottom: 14px;
flex-shrink: 0;
}
.host-row {
display: flex;
align-items: center;
justify-content: space-between;
gap: 16rpx;
margin-bottom: 48rpx;
}
.host-row .host-bar {
margin-bottom: 0;
min-width: 0;
}
.host-actions {
display: flex;
align-items: center;
flex-shrink: 0;
}
.brand-row {
display: flex;
align-items: center;
transform: translateY(2px);
}
.brand-mark {
font-size: 40rpx;
margin-right: 14rpx;
}
.brand-badge {
color: #10151F;
background: #FFFFFF;
border: 0;
border-radius: 8rpx;
font-size: 19rpx;
font-weight: 600;
line-height: 30rpx;
height: 30rpx;
padding: 0 12rpx;
margin-top: 1rpx;
letter-spacing: 1rpx;
flex-shrink: 0;
}
.pair-wrap {
position: relative;
}
.pair-wrap.pair-menu-open .icon-btn {
visibility: hidden;
}
.pair-menu-mask {
position: fixed;
inset: 0;
z-index: 90;
}
.pair-menu {
position: absolute;
top: calc(100% + 12rpx);
right: 0;
z-index: 100;
width: 496rpx;
transform-origin: 100% 0;
animation: pair-menu-in 180ms cubic-bezier(0.32, 0.72, 0, 1) both;
will-change: transform, opacity;
padding: 12rpx 0;
background: linear-gradient(165deg, rgba(255, 255, 255, var(--glass-alpha-top, 0.10)), rgba(255, 255, 255, var(--glass-alpha-bottom, 0.04)));
border: 1rpx solid rgba(255, 255, 255, 0.38);
backdrop-filter: blur(8rpx);
-webkit-backdrop-filter: blur(8rpx);
border-radius: 36rpx;
box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 16rpx 48rpx rgba(3, 14, 30, 0.26);
overflow: hidden;
}
@keyframes pair-menu-in {
from { opacity: 0; transform: scale(0.86) translateY(-10rpx); }
to { opacity: 1; transform: scale(1) translateY(0); }
}
.pair-menu-item {
display: flex;
align-items: center;
height: 116rpx;
padding: 0 44rpx;
font-size: 34rpx;
font-weight: 500;
color: #FFFFFF;
}
.pair-menu-item-active {
background: rgba(255, 255, 255, 0.08);
}
.pair-menu-ic {
width: 36rpx;
height: 36rpx;
margin-right: 14rpx;
flex-shrink: 0;
display: flex;
align-items: center;
justify-content: center;
}
.ico-scan {
position: relative;
width: 36rpx;
height: 36rpx;
}
.ico-scan .corner {
position: absolute;
width: 11rpx;
height: 11rpx;
border: 3rpx solid #FFFFFF;
box-sizing: border-box;
}
.ico-scan .corner.tl { left: 0; top: 0; border-right: 0; border-bottom: 0; border-top-left-radius: 5rpx; }
.ico-scan .corner.tr { right: 0; top: 0; border-left: 0; border-bottom: 0; border-top-right-radius: 5rpx; }
.ico-scan .corner.bl { left: 0; bottom: 0; border-right: 0; border-top: 0; border-bottom-left-radius: 5rpx; }
.ico-scan .corner.br { right: 0; bottom: 0; border-left: 0; border-top: 0; border-bottom-right-radius: 5rpx; }
.ico-scan .find {
position: absolute;
width: 10rpx;
height: 10rpx;
border: 2rpx solid #FFFFFF;
box-sizing: border-box;
border-radius: 2rpx;
}
.ico-scan .find::after {
content: '';
position: absolute;
left: 50%;
top: 50%;
width: 3rpx;
height: 3rpx;
margin-left: -1.5rpx;
margin-top: -1.5rpx;
background: #FFFFFF;
border-radius: 1rpx;
}
.ico-scan .find.a { left: 7rpx; top: 7rpx; }
.ico-scan .find.b { right: 7rpx; top: 7rpx; }
.ico-scan .find.c { left: 7rpx; bottom: 7rpx; }
.ico-scan .dots {
position: absolute;
right: 6rpx;
bottom: 6rpx;
width: 8rpx;
height: 8rpx;
display: flex;
flex-wrap: wrap;
gap: 2rpx;
}
.ico-scan .dots view {
width: 3rpx;
height: 3rpx;
background: #FFFFFF;
border-radius: 1rpx;
}
.ico-keyboard {
position: relative;
width: 36rpx;
height: 26rpx;
box-sizing: border-box;
border: 2rpx solid #FFFFFF;
border-radius: 6rpx;
padding: 4rpx 4rpx;
display: flex;
flex-direction: column;
justify-content: space-between;
}
.ico-keyboard .kb-row {
display: flex;
justify-content: space-between;
align-items: center;
}
.ico-keyboard .kb-row view {
width: 4rpx;
height: 4rpx;
background: #FFFFFF;
border-radius: 1rpx;
}
.ico-keyboard .kb-last {
justify-content: space-between;
}
.ico-keyboard .kb-bar {
flex: 1;
width: auto;
height: 4rpx;
margin: 0 2rpx;
border-radius: 2rpx;
}
.icon-btn {
width: 84rpx;
height: 84rpx;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
margin-left: 18rpx;
flex-shrink: 0;
font-size: 38rpx;
background: linear-gradient(165deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
border: 1rpx solid rgba(255, 255, 255, 0.24);
backdrop-filter: blur(3rpx);
-webkit-backdrop-filter: blur(3rpx);
box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 8rpx 24rpx rgba(3, 14, 30, 0.24);
}
.hero {
margin-top: 120rpx;
margin-bottom: 36rpx;
}
.title-hero {
color: #FFFFFF;
font-size: 50rpx;
font-weight: 700;
letter-spacing: 0;
}
.subtitle-hero {
margin-top: 12rpx;
color: rgba(255, 255, 255, 0.65);
font-size: 26rpx;
}
.workspace-card {
display: flex;
align-items: center;
padding: 24rpx 28rpx;
margin-bottom: 36rpx;
border-radius: 36rpx;
background: linear-gradient(165deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
border: 1rpx solid rgba(255, 255, 255, 0.38);
backdrop-filter: blur(3rpx);
-webkit-backdrop-filter: blur(3rpx);
box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 8rpx 32rpx rgba(3, 14, 30, 0.18);
}
.ws-icon {
width: 48rpx;
height: 48rpx;
margin-right: 24rpx;
flex-shrink: 0;
}
.ws-body {
flex: 1;
min-width: 0;
}
.ws-title {
color: #FFFFFF;
font-size: 30rpx;
font-weight: 600;
}
.ws-path {
color: rgba(255, 255, 255, 0.55);
font-size: 24rpx;
margin-top: 4rpx;
overflow: hidden;
text-overflow: ellipsis;
white-space: nowrap;
}
.ws-right {
display: flex;
align-items: center;
margin-left: 16rpx;
}
.ws-chevron {
width: 30rpx;
height: 30rpx;
margin-left: 18rpx;
}
.new-session {
display: flex;
align-items: center;
justify-content: center;
border: 1rpx solid rgba(255, 255, 255, 0.38);
border-radius: 32rpx;
padding: 18rpx 0;
margin-bottom: 36rpx;
background: linear-gradient(165deg, rgba(255, 255, 255, var(--glass-alpha-top, 0.06)), rgba(255, 255, 255, var(--glass-alpha-bottom, 0.015)));
backdrop-filter: blur(3rpx);
-webkit-backdrop-filter: blur(3rpx);
box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 8rpx 32rpx rgba(3, 14, 30, 0.18);
transition: transform 0.18s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.18s ease;
}
.new-session:active {
transform: scale(0.97);
opacity: 0.85;
}
.plus-circle {
width: 48rpx;
height: 48rpx;
border-radius: 50%;
background: linear-gradient(165deg, rgba(255, 255, 255, var(--glass-alpha-top, 0.10)), rgba(255, 255, 255, var(--glass-alpha-bottom, 0.04)));
border: 1rpx solid rgba(255, 255, 255, 0.20);
box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
color: #FFFFFF;
display: flex;
align-items: center;
justify-content: center;
font-size: 34rpx;
margin-right: 22rpx;
}
.new-session-text {
color: #FFFFFF;
font-size: 30rpx;
font-weight: 600;
}
.recent-header {
display: flex;
align-items: center;
justify-content: space-between;
margin-bottom: 24rpx;
}
.recent-header .section-title {
font-size: 28rpx;
}
.conn-label {
font-size: 24rpx;
}
.conn-label.connected { color: var(--success); }
.conn-label.connecting { color: var(--amber); }
.conn-label.disconnected { color: rgba(255, 255, 255, 0.60); }
.conn-label.failed { color: var(--orange); }
.conn-label.dropped { color: #FF5A5F; }
.status-dot.connecting { background: var(--amber); }
.status-dot.disconnected { background: rgba(255, 255, 255, 0.34); }
.status-dot.failed { background: var(--orange); }
.status-dot.dropped { background: #FF5A5F; box-shadow: 0 0 10rpx rgba(255, 90, 95, 0.55); }
.status-dot.connected { box-shadow: 0 0 10rpx rgba(46, 184, 92, 0.55), 0 0 2rpx rgba(46, 184, 92, 0.35); }
.search-box {
display: flex;
align-items: center;
height: 72rpx;
padding: 0 24rpx;
border-radius: 26rpx;
margin-bottom: 28rpx;
background: linear-gradient(165deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
border: 1rpx solid transparent;
backdrop-filter: blur(3rpx);
-webkit-backdrop-filter: blur(3rpx);
box-shadow: inset 0 0 0 0.5rpx rgba(255, 255, 255, 0.10), inset 0 0.5rpx 0 rgba(255, 255, 255, 0.03), 0 8rpx 32rpx rgba(3, 14, 30, 0.16);
}
.search-icon {
width: 40rpx;
height: 40rpx;
margin-right: 16rpx;
flex-shrink: 0;
opacity: 0.52;
}
.search-result-ic {
width: 28rpx;
height: 28rpx;
margin-right: 12rpx;
flex-shrink: 0;
}
.icon-img {
width: 40rpx;
height: 40rpx;
display: block;
}
.pair-ic {
width: 48rpx;
height: 48rpx;
}
.plus-img {
width: 30rpx;
height: 30rpx;
}
.search-input {
flex: 1;
color: #FFFFFF;
font-size: 30rpx;
}
.home-data-hint {
margin: -20rpx 0 16rpx;
color: rgba(255, 255, 255, 0.52);
font-size: 24rpx;
}
.home-data-hint.home-connection-error {
color: var(--orange);
}
.session-row {
display: flex;
align-items: center;
padding: 20rpx 8rpx;
position: relative;
background: transparent;
border-radius: 16rpx;
}
.session-row::after {
content: '';
position: absolute;
left: 36rpx;
right: 0;
bottom: 0;
height: 1rpx;
background: rgba(255, 255, 255, 0.10);
}
.session-swipe:last-child .session-row::after {
display: none;
}
.session-swipe {
position: relative;
overflow: hidden;
border-radius: 16rpx;
}
.session-swipe .session-row {
position: relative;
z-index: 1;
transition: transform 0.18s ease;
will-change: transform;
}
.session-row-hidden,
.session-row-hidden::after {
visibility: hidden;
}
.session-swipe.open .session-row {
background: var(--navy);
}
.session-actions {
position: absolute;
top: 0;
right: 0;
bottom: 0;
display: flex;
align-items: stretch;
visibility: hidden;
}
.session-actions.show {
visibility: visible;
}
.session-action {
width: 150rpx;
display: flex;
align-items: center;
justify-content: center;
color: #FFFFFF;
font-size: 26rpx;
line-height: 1.2;
}
.session-action.rename {
background: rgba(46, 107, 230, 0.92);
}
.session-action.archive {
background: rgba(214, 69, 69, 0.92);
}
.session-dot {
width: 14rpx;
height: 14rpx;
border-radius: 50%;
background: rgba(255, 255, 255, 0.4);
margin-right: 22rpx;
flex-shrink: 0;
}
.session-dot.done {
background: var(--success);
box-shadow: 0 0 10rpx rgba(46, 184, 92, 0.55), 0 0 2rpx rgba(46, 184, 92, 0.35);
}
.session-dot.running {
width: 16rpx;
height: 16rpx;
box-sizing: border-box;
background: transparent;
box-shadow: none;
border: 2rpx solid rgba(255, 255, 255, 0.2);
border-top-color: rgba(255, 255, 255, 0.82);
animation: sessionDotSpin 0.9s linear infinite;
}
.session-dot.unread {
background: var(--ocean);
}
@keyframes sessionDotSpin {
to { transform: rotate(360deg); }
}
@media (prefers-reduced-motion: reduce) {
.session-dot.running { animation-duration: 2s; }
}
.session-body {
flex: 1;
min-width: 0;
}
.session-title {
color: #FFFFFF;
font-size: 28rpx;
font-weight: 500;
overflow: hidden;
text-overflow: ellipsis;
white-space: nowrap;
}
.session-sub {
color: rgba(255, 255, 255, 0.42);
font-size: 20rpx;
margin-top: 2rpx;
overflow: hidden;
text-overflow: ellipsis;
white-space: nowrap;
}
.session-time {
color: rgba(255, 255, 255, 0.48);
font-size: 22rpx;
margin-left: 18rpx;
flex-shrink: 0;
}
.session-time.running {
color: #0A84FF;
}
.session-section {
display: flex;
align-items: center;
gap: 20rpx;
margin-top: 48rpx;
padding-bottom: 16rpx;
}
.session-section.session-section-first {
margin-top: 16rpx;
}
.session-section-title {
color: rgba(255, 255, 255, 0.55);
font-size: 24rpx;
font-weight: 500;
line-height: 1.3;
max-width: 55%;
overflow: hidden;
white-space: nowrap;
text-overflow: ellipsis;
flex-shrink: 0;
}
.session-section-line {
flex: 1;
height: 1rpx;
background: rgba(255, 255, 255, 0.12);
}
.session-section-count {
color: rgba(255, 255, 255, 0.55);
font-size: 22rpx;
flex-shrink: 0;
}
.session-section-toggle {
display: flex;
align-items: center;
gap: 6rpx;
min-height: 88rpx;
padding-left: 36rpx;
box-sizing: border-box;
}
.session-section-toggle-label {
color: rgba(255, 255, 255, 0.62);
font-size: 26rpx;
line-height: 1.2;
}
.session-section-toggle-ic {
width: 22rpx;
height: 22rpx;
opacity: 0.62;
}
.empty {
color: rgba(255, 255, 255, 0.5);
text-align: left;
padding: 36rpx;
font-size: 30rpx;
background: rgba(255, 255, 255, 0.04);
border-radius: 30rpx;
}
.host-bar {
display: inline-flex;
align-items: center;
padding: 12rpx 24rpx;
background: linear-gradient(165deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025));
border: 1rpx solid rgba(255, 255, 255, 0.20);
border-radius: 999rpx;
margin-bottom: 48rpx;
backdrop-filter: blur(3rpx);
-webkit-backdrop-filter: blur(3rpx);
box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 8rpx 24rpx rgba(3, 14, 30, 0.22);
}
.host-kind {
width: 30rpx;
height: 30rpx;
margin-right: 14rpx;
flex-shrink: 0;
}
.host-name {
color: #FFFFFF;
font-size: 24rpx;
max-width: 340rpx;
overflow: hidden;
white-space: nowrap;
text-overflow: ellipsis;
}
.host-dot {
width: 13rpx;
height: 13rpx;
border-radius: 50%;
background: #8E8E93;
margin-left: 16rpx;
flex-shrink: 0;
}
.host-dot.on {
background: var(--success);
}
.host-dot.link-lan { background: var(--success); }
.host-dot.link-public { background: #6AA4FF; }
.host-dot.failed { background: var(--orange); }
.host-dot.dropped { background: #FF5A5F; }
.host-link-badge {
display: inline-flex;
align-items: center;
justify-content: center;
flex: none;
box-sizing: border-box;
min-height: 30rpx;
padding: 0 10rpx;
margin-left: 10rpx;
border: 1rpx solid rgba(255, 255, 255, 0.20);
border-radius: 999rpx;
font-size: 18rpx;
font-weight: 500;
line-height: 1.2;
}
.host-link-badge.is-lan {
color: #7BE39E;
border-color: rgba(123, 227, 158, 0.35);
background: rgba(123, 227, 158, 0.10);
}
.host-link-badge.is-public {
color: #9CC2FF;
border-color: rgba(156, 194, 255, 0.32);
background: rgba(156, 194, 255, 0.10);
}
.host-chev {
width: 22rpx;
height: 22rpx;
margin-left: 14rpx;
flex-shrink: 0;
}
.host-mask {
position: fixed;
left: 0;
top: 0;
right: 0;
bottom: 0;
background: rgba(0, 0, 0, 0.55);
z-index: 60;
}
.host-sheet {
position: fixed;
left: 12px;
right: 12px;
bottom: 24px;
z-index: 61;
display: flex;
flex-direction: column;
height: auto;
min-height: 46vh;
max-height: 86vh;
background: linear-gradient(165deg, rgba(255, 255, 255, var(--glass-alpha-top, 0.10)), rgba(255, 255, 255, var(--glass-alpha-bottom, 0.04)));
border: 1rpx solid rgba(255, 255, 255, var(--glass-edge-alpha, 0.38));
border-radius: var(--glass-radius-sheet, 32rpx);
