/* ---------- 涓婁笅鏂囬潰鏉匡紙绉绘 dsh-context Context tab锛?---------- */
.context-panel { flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }
/* 上下文与编队合并成一个滚动（对齐客户端侧栏 Context 面板）：编队一节接在上下文卡片后 */
/* 编队是独立面板：工具栏与上下文工具栏同样固定在滚动区上方，尺寸/内边距完全一致。 */
.cf-fleet-section { margin-top: 0; }
.context-toolbar { flex-shrink: 0; display: flex; align-items: center; gap: 12rpx; padding: 22rpx 40rpx 4rpx; }
.context-toolbar-title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.context-toolbar-meta { max-width: 260rpx; font-size: 22rpx; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.context-toolbar-spacer { flex: 1; }
.context-modal-open { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--text-3); }
.context-toolbar-ic { width: 38rpx; height: 38rpx; opacity: .86; }
/* /context 等价弹窗（contextModal.css） */
.ctx-modal-mask { position: fixed; inset: 0; z-index: 300; display: flex; align-items: flex-end; justify-content: center; padding: 0; background: rgba(0, 0, 0, .45); }
/* height 必须显式给出：只写 max-height 时 flex 列的高度由内容决定，子级
   `flex:1; height:0` 解析不出高度，scroll-view 会按内容撑开再被裁掉、滚不动
   （collab-sheet 一直带 height，所以它没这个问题）。 */
.ctx-modal { width: 100vw; height: 90vh; max-height: 90vh; box-sizing: border-box; display: flex; flex-direction: column; padding: 0 36rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 24rpx 24rpx 0 0; background: var(--surface); border: 1rpx solid var(--border); box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, .28); transition: transform .18s ease; will-change: transform; }
/* 底部抽屉的拖动条：44rpx 抓取区里居中一条 72×8 的小横杠；
   手指按在上面才能拖（弹窗正文的滚动仍归 scroll-view，两者不抢手势）。 */
.ctx-modal-grab { flex: none; height: 44rpx; display: flex; align-items: center; justify-content: center; }
.ctx-modal-grab-bar { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: var(--border-strong); }
.ctx-modal-head { flex: none; display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 24rpx; }
.ctx-modal-title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.ctx-modal-close { margin-left: auto; width: 56rpx; height: 56rpx; line-height: 50rpx; text-align: center; border-radius: 12rpx; font-size: 40rpx; color: var(--text-2); }
/* height:0 不能省：微信里 scroll-view 在 flex 列中缺了它会按内容高度展开，
   超过 .ctx-modal 的 max-height 后被直接裁掉且无法滚动（与 collab/context-scroll 同一写法）。 */
.ctx-modal-body { flex: 1; height: 0; min-height: 0; }
.ctx-modal-card { margin-bottom: 20rpx; }
.ctx-modal-cats { display: flex; flex-direction: column; }
.ctx-modal-cats .ctx-br-cat-row { border-top: 1rpx solid var(--divider); }
.ctx-modal-cats .ctx-br-cat-row:first-child { border-top: 0; }
/* scroll-view 的 padding-bottom 在微信里不算「可滚动内容」，是视口外的一条死区：
   写成 calc(40rpx + env(safe-area-inset-bottom)) 时，面板底部会留一条 98rpx 的纯页面底色黑边，
   内容还会提前被裁掉（上下文/编队页底部那层“黑色遮罩”就是它）。
   底部留白改由滚动内容末尾的 .ctx-bottom-space 提供，它跟着内容一起滚。 */
.context-scroll { flex: 1; height: 0; box-sizing: border-box; padding: 8rpx 32rpx 0; }
.ctx-top-anchor { height: 0; }
.context-state { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 100rpx 24rpx 40rpx; text-align: center; }
.context-state-title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.context-state-text { font-size: 26rpx; line-height: 1.7; color: var(--text-3); overflow-wrap: anywhere; }
.context-retry { margin-top: 8rpx; min-height: 44px; padding: 0 44rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--fill-2); color: var(--text); font-size: 26rpx; }
.ctx-skeleton { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.ctx-skeleton-row { width: 100%; height: 30rpx; border-radius: 10rpx; background: var(--fill-2); animation: ctx-pulse 1.2s ease-in-out infinite; }
.ctx-skeleton-row:nth-child(2) { width: 82%; }
.ctx-skeleton-row:nth-child(3) { width: 63%; }
@keyframes ctx-pulse { 0%, 100% { opacity: .45; } 50% { opacity: 1; } }
.ctx-card { margin-top: 14rpx; padding: 14rpx 16rpx; border-radius: 20rpx; background: var(--surface); border: 1rpx solid var(--border); box-shadow: var(--card-shadow); }
.ctx-card-head { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 20rpx; flex-wrap: wrap; }
.ctx-card-title { font-size: 26rpx; font-weight: 600; color: var(--text); white-space: nowrap; }
.ctx-card-sub { margin-left: auto; font-size: 24rpx; color: var(--text-2); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ctx-card-sub + .ctx-card-sub { margin-left: 12rpx; }
.ctx-chip-pressed { background: var(--fill-2); }
.ctx-chip-value { font-size: 26rpx; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
.ctx-chip-label { font-size: 20rpx; color: var(--text-3); }
.ctx-chip-inject { border-color: rgba(122, 84, 199, .35); }
.ctx-chip-compaction { border-color: rgba(240, 125, 20, .35); }
.ctx-chip-prune { border-color: rgba(46, 107, 230, .35); }
.ctx-empty { padding: 28rpx 0; text-align: center; color: var(--text-3); font-size: 24rpx; }
.ctx-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
/* ---------- 上下文趋势（几何逐值对齐 dsh-context trendChart.css） ----------
   dsh: BAR_W 14px / BAR_GAP 2px / CHART_H 112px / 顶 padding 18px / 容器 130px
        / 轮次条 14px + margin-top 4px / 轴宽 40px / 轴字 11px
   小程序按 rpx = px × 2 落地，375pt 机上真实像素与 Web 面板一致。 */
.ctx-trend-row { display: flex; align-items: stretch; }
.ctx-trend-axis { position: relative; width: 80rpx; height: 260rpx; padding-top: 36rpx; box-sizing: border-box; flex: none; color: var(--text-4); font-size: 22rpx; }
.ctx-trend-axis-tick { position: absolute; right: 0; line-height: 1; white-space: nowrap; }
/* 右侧时长轴：比左轴窄，刻度贴左（dsh-context .lc-axis-r） */
.ctx-trend-axis-r { width: 68rpx; }
.ctx-trend-axis-r .ctx-trend-axis-tick { left: 0; right: auto; }
/* ---------- 总览：整段压成一条连续堆叠带，不横向滚动 ---------- */
.ctx-trend-fit { width: 100%; }
.ctx-trend-chart-fit { width: 100% !important; padding-left: 0; padding-right: 0; }
/* WXML 不支持内联 <svg>：总览带用等价 CSS 堆叠列渲染（bounded 采样，视觉连续）。 */
.ctx-trend-columns { position: absolute; top: 36rpx; left: 0; right: 0; height: 224rpx; z-index: 1; display: flex; align-items: flex-end; pointer-events: none; }
.ctx-trend-column { flex: 1 1 0; min-width: 0; height: 100%; display: flex; flex-direction: column-reverse; }
.ctx-trend-column-seg { width: 100%; }
.ctx-fit-flagpole { left: auto !important; }
.ctx-fit-cursor { position: absolute; top: 36rpx; bottom: 0; width: 0; border-left: 2rpx solid var(--text); z-index: 2; pointer-events: none; transition: left .2s cubic-bezier(.2,.7,.2,1); }
/* 实时探针竖线：品牌色，与「选中光标」的 --text 区分；dsh-context 的 hover 线同为品牌色 */
.ctx-trend-hoverline { position: absolute; top: 36rpx; bottom: 0; width: 0; border-left: 2rpx solid var(--ocean); z-index: 3; pointer-events: none; }
.ctx-trend-turns-fit { width: 100%; gap: 0; }
.ctx-trend-turns-fit .ctx-trend-turn { border-radius: 0; min-width: 0; overflow: hidden; }
.ctx-trend-turns-dim .ctx-trend-turn { opacity: .35; }
.ctx-trend-turns-dim .ctx-trend-turn.on { opacity: 1; }
/* 指标卡的定位父级：卡片在滚动区外，锚在可视区内（dsh-context 的 .lc-chart-tip 同理） */
.ctx-trend-main { position: relative; flex: 1; min-width: 0; }
/* 实时指标卡：跟随竖线顶端，translateX(-50%) 以线为中心；max-width 收住长文本 */
.ctx-trend-tip { position: absolute; top: 2rpx; z-index: 6; transform: translateX(-50%); display: flex; flex-direction: column; gap: 2rpx; max-width: 480rpx; box-sizing: border-box; padding: 6rpx 12rpx; border: 1rpx solid var(--border-strong); border-radius: 10rpx; background: var(--surface); box-shadow: var(--float-shadow); pointer-events: none; white-space: nowrap; }
.ctx-trend-tip-head { font-size: 20rpx; font-weight: 600; color: var(--text); }
.ctx-trend-tip-metrics { display: flex; align-items: baseline; gap: 10rpx; }
.ctx-trend-tip-metric { font-size: 20rpx; color: var(--text-3); font-variant-numeric: tabular-nums; }
.ctx-trend-scroll { width: 100%; white-space: nowrap; }
.ctx-trend-chart { position: relative; display: flex; align-items: flex-end; gap: 4rpx; height: 260rpx; padding: 36rpx 4rpx 0; box-sizing: border-box; overflow: hidden; }
.ctx-trend-grid { position: absolute; left: 0; right: 0; height: 1rpx; border-top: 1rpx dashed var(--border-strong); pointer-events: none; }
.ctx-trend-grid-zero { border-top-style: solid; border-top-color: var(--text-3); }
/* 步进旗标：1px 极线 + 编号盒，向左伸绝不增加横向滚动宽度 */
.ctx-trend-flagpole { position: absolute; top: 34rpx; bottom: 0; width: 1rpx; background: var(--border-strong); z-index: 2; pointer-events: none; }
.ctx-trend-flaglabel { position: absolute; top: 0; right: 0; box-sizing: border-box; padding: 2rpx 6rpx; border: 1rpx solid var(--border-strong); border-radius: 6rpx; background: var(--surface); font-size: 18rpx; line-height: 1; font-weight: 600; color: var(--text-4); white-space: nowrap; }
.ctx-trend-col { position: relative; width: 28rpx; flex: none; height: 100%; display: flex; align-items: flex-end; border-radius: 4rpx; transition: opacity .2s ease, background-color .2s ease; }
.ctx-trend-col.dimmed { opacity: .35; }
/* 扫读悬停：品牌色描边，与选中的 --text-3 区分。selected 必须声明在后（同等特异性），
   否则指针停在刚点过的柱子上时悬停描边会盖掉选中态（dsh-context 同款顺序）。 */
.ctx-trend-col.hovered { box-shadow: 0 0 0 2rpx var(--ocean); }
.ctx-trend-col.selected { background: var(--fill-2); box-shadow: 0 0 0 2rpx var(--text-3); }
.ctx-trend-barwrap { position: relative; width: 100%; height: 224rpx; display: flex; align-items: flex-end; }
.ctx-trend-bar { width: 100%; display: flex; flex-direction: column-reverse; overflow: hidden; }
.ctx-trend-seg { width: 100%; }
.ctx-trend-bar > view:first-child { border-radius: 0 0 4rpx 4rpx; }
.ctx-trend-bar > view:last-child { border-radius: 4rpx 4rpx 0 0; }
.ctx-trend-bar > view:only-child { border-radius: 4rpx; }
.ctx-trend-deltaplot { position: relative; width: 100%; height: 100%; }
.ctx-trend-deltaarm { position: absolute; left: 0; right: 0; display: flex; overflow: hidden; }
.ctx-trend-deltaarm.up { flex-direction: column-reverse; border-radius: 4rpx 4rpx 0 0; }
.ctx-trend-deltaarm.down { flex-direction: column; border-radius: 0 0 4rpx 4rpx; }
.ctx-trend-deltaseg { width: 100%; }
/* 耗时折线：原生 view 旋转细段拼接。微信小程序对内联 SVG 支持不稳定（会话页
   ctx-flow 的连接带同为此改用原生线段），halo 层用卡面色垫出对比，core 是曲线；
   圆头（半径=半高）代替 stroke-linecap: round，接缝处自然收口。
   .ctx-dur 是绝对定位的透明承载层：不占 flex 位、不吃触摸事件，
   子段的 left/top 相对它的 padding box，与柱心/网格同一坐标系。 */
.ctx-dur { position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 1; pointer-events: none; }
.ctx-dur-seg { position: absolute; pointer-events: none; }
.ctx-dur-dot { position: absolute; border-radius: 50%; pointer-events: none; }
.ctx-dur-halo { background: var(--surface); opacity: .9; border-radius: 3rpx; }
.ctx-dur-core { background: var(--text-4); border-radius: 1.25rpx; }
/* 轮次聚焦时曲线随柱子一起淡出（dsh-context 的 .lc-chart-dim .lc-duration） */
.ctx-dur-dim .ctx-dur-halo, .ctx-dur-dim .ctx-dur-core { opacity: .35; }
/* 轮次条：与柱网同一栅格，中性斑马纹（永不用分类色） */
.ctx-trend-turnscroll { width: 100%; white-space: nowrap; }
.ctx-trend-turns { display: flex; gap: 4rpx; margin-top: 8rpx; }
.ctx-trend-turn { flex: none; box-sizing: border-box; height: 28rpx; line-height: 28rpx; text-align: center; font-size: 20rpx; font-weight: 600; color: var(--text-4); border-radius: 6rpx; white-space: nowrap; transition: filter .2s ease, opacity .2s ease; }
.ctx-trend-turn.zebra-even { background: var(--fill); }
.ctx-trend-turn.zebra-odd { background: var(--fill-2); }
.ctx-trend-turn.on { filter: brightness(1.35); color: var(--text); }
.ctx-trend-turn.dimmed { opacity: .35; }
.ctx-trend-turnlabel { display: inline-block; }
.ctx-trend-pressed { opacity: .65; }
.ctx-event-chips { display: flex; flex-wrap: wrap; gap: 4rpx; padding: 2rpx; border-radius: 12rpx; background: var(--fill); border: 1rpx solid var(--border); margin-bottom: 16rpx; }
.ctx-event-chip { padding: 6rpx 16rpx; border-radius: 10rpx; font-size: 22rpx; line-height: 1.2; color: var(--text-2); }
.ctx-event-chip.active { color: var(--text); }
.ctx-event-chip.active.ctx-kind-inject { background: rgba(34, 197, 94, .15); color: #22C55E; }
.ctx-event-chip.active.ctx-kind-compaction { background: rgba(236, 19, 19, .15); color: #EC1313; }
.ctx-event-chip.active.ctx-kind-prune { background: rgba(142, 81, 255, .15); color: #8E51FF; }
.ctx-event-chip.active.ctx-kind-model { background: rgba(16, 19, 24, .08); color: var(--text); }
.ctx-event-chip.active.ctx-kind-mode { background: rgba(16, 19, 24, .08); color: var(--text-2); }
.theme-dark .ctx-event-chip.active.ctx-kind-compaction { color: #F25A5A; }
.theme-dark .ctx-event-chip.active.ctx-kind-model,
.theme-dark .ctx-event-chip.active.ctx-kind-mode { background: rgba(255, 255, 255, .10); }
.ctx-event-chip-n { margin-left: 8rpx; opacity: .65; font-variant-numeric: tabular-nums; }
.ctx-event-chip.active .ctx-event-chip-n { opacity: .85; }
.ctx-event-lane { max-height: 640rpx; }
.ctx-event-row { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; padding: 6rpx 0; border-bottom: 1rpx solid var(--divider); font-size: 24rpx; color: var(--text-2); }
.ctx-event-row:last-child { border-bottom: 0; }
.ctx-event-icon { width: 36rpx; flex: none; text-align: center; font-size: 22rpx; }
.ctx-event-kind { flex: none; padding: 2rpx 12rpx; border-radius: 8rpx; font-size: 20rpx; font-weight: 600; background: var(--fill-2); }
.ctx-event-name { flex: 1 1 260rpx; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); }
.ctx-event-pos { flex: none; font-size: 22rpx; color: var(--text-3); font-variant-numeric: tabular-nums; }
.ctx-event-tokens { flex: none; font-weight: 600; font-variant-numeric: tabular-nums; }
.ctx-event-tokens-up { color: var(--amber); }
.ctx-event-tokens-down { color: var(--success); }
.ctx-event-time { flex: none; font-size: 22rpx; color: var(--text-4); font-variant-numeric: tabular-nums; }
.ctx-e-inject { color: #22C55E; background: rgba(34,197,94,.15); }
.ctx-e-compaction { color: #EC1313; background: rgba(236,19,19,.15); }
.ctx-e-prune { color: #8E51FF; background: rgba(142,81,255,.15); }
/* 滚动内容末尾的留白：把原来写在 scroll-view 上的 40rpx + 安全区挪到这里，
   这样最后一张卡片能滚到 Home 指示条上方，底部也不再露出页面底色。 */
.ctx-bottom-space { height: calc(24rpx + env(safe-area-inset-bottom)); }
/* 缁勬垚鑹叉澘锛堜笌 dsh-context CATS 璇箟涓€鑷达紱娣辫壊涓婚涓嬪悓涓€缁勮壊浠嶅彲杈級 */
.ctx-c-system { background: #615FFF; }
.ctx-c-tools { background: #FE9A00; }
.ctx-c-user { background: #00C950; }
.ctx-c-inject { background: #AD46FF; }
.ctx-c-skill { background: #FF6900; }
.ctx-c-assistant { background: #2B7FFF; }
.ctx-c-tool { background: #00BBA7; }
.ctx-c-output { background: #F6339A; }
.ctx-t-wait { background: #2B7FFF; }
.ctx-t-reply { background: #8E51FF; }
.ctx-t-tools { background: #00BBA7; }
.ctx-e-inject { color: #A855F7; }
.ctx-e-compaction { color: #C28220; }
.ctx-e-prune { color: #2E6BE6; }
.theme-dark .ctx-e-compaction { color: #F25A5A; }
.theme-dark .ctx-e-prune { color: #8E51FF; }
@media (max-width: 350px) { .context-scroll { padding-left: 24rpx; padding-right: 24rpx; } }
/* 椤堕儴鑳屾櫙閬僵锛氳鐩栧鑸笌鍒囨崲鏍忥紝搴曡竟鎴鍦ㄣ€屽璇?杞ㄨ抗銆嶄笅鍒掔嚎澶?*/
.session-header {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  background: var(--bg);
}
/* ---------- 缂栭槦闈㈡澘锛堝綋鍓?Agent 鐨勫鏃忕綉缁滐級 ---------- */
.fleet-panel { flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }
.fleet-toolbar { flex-shrink: 0; display: flex; align-items: center; gap: 12rpx; padding: 22rpx 40rpx 4rpx; }
.fleet-toolbar-title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.fleet-toolbar-meta { max-width: 320rpx; font-size: 22rpx; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fleet-toolbar-spacer { flex: 1; }
.fleet-scroll { flex: 1; height: 0; box-sizing: border-box; padding: 8rpx 32rpx 0; }
.fleet-state { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 100rpx 24rpx 40rpx; text-align: center; }
.fleet-state-title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.fleet-state-text { font-size: 26rpx; line-height: 1.7; color: var(--text-3); overflow-wrap: anywhere; }
.fleet-retry { margin-top: 8rpx; min-height: 44px; padding: 0 44rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--fill-2); color: var(--text); font-size: 26rpx; }
.fleet-card { position: relative; z-index: 1; margin-top: 0; padding: 24rpx 26rpx; border-radius: 24rpx; background: var(--surface); border: 1rpx solid var(--border); box-shadow: var(--card-shadow); }
.fleet-card.current { border-color: var(--ink); box-shadow: 0 0 0 2rpx var(--ink); }
.fleet-pulse { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; background: var(--text-4); }
.fleet-pulse.on { background: #22C55E; animation: fleet-pulse 1.4s ease-in-out infinite; }
@keyframes fleet-pulse { 0%, 100% { opacity: .35; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.15); } }
@media (max-width: 350px) { .fleet-scroll { padding-left: 24rpx; padding-right: 24rpx; } .fleet-card { padding: 20rpx; } }
/* 鍒囨崲琛屽簳閮ㄤ笉鐣欑┖闅欙細涓嬪垝绾垮嵆椤堕儴鍖哄煙鏈€浣庣偣 */
.session .session-header .segmented-row {
  padding-bottom: 0 !important;
  margin-bottom: 0 !important;
}
.session .session-header .segmented-row .segment {
  padding: 16rpx 4rpx;   /* symmetric: label centers on the buttons' axis */
}
.session .session-header .segmented-row .segment.active::after {
  bottom: 0;
}
/* 椤堕儴閬僵涓ユ牸姝簬鍒囨崲涓嬪垝绾匡細瀹瑰櫒涓庡悗缁唴瀹归兘涓嶅啀杩藉姞鐣欑櫧 */
.session .session-header {
  padding-bottom: 0 !important;
  margin-bottom: 0 !important;
  border-bottom: 0 !important;
  box-shadow: none !important;
}
.session .session-header .segmented-row {
  min-height: 0 !important;
  margin: 0 !important;
}
.session .conversation,
.session .trajectory {
  padding-top: 0 !important;
}
/* 绗簩琛屾暣浣撲笅绉伙紝鎷夊紑涓庡彸涓婅鑳跺泭鐨勫瀭鐩磋窛绂伙紙涓嶆敼鍙樺乏鍙充綅缃級 */
.session .session-header .segmented-row {
  margin-top: 12px !important;
}
/* Header background ends at the tab underline; each panel owns its top gap. */
.session .session-header .segmented-row {
  padding-bottom: 0 !important;
}
/* ================= v2锛氫笂涓嬫枃/缂栭槦瀹屾暣鍗＄墖锛堝榻?dsh-context Context/Fleet tab锛?================= */
.session{--ctx-c-system:#615FFF;--ctx-c-tools:#FE9A00;--ctx-c-user:#00C950;--ctx-c-inject:#AD46FF;--ctx-c-skill:#FF6900;--ctx-c-assistant:#2B7FFF;--ctx-c-tool:#00BBA7;--ctx-c-output:#F6339A;--ctx-t-wait:#2B7FFF;--ctx-t-reasoning:#8E51FF;--ctx-t-text:#F6339A;--ctx-t-toolarg:#FE9A00;--ctx-t-tools:#00BBA7;--ctx-t-reply:#8E51FF;--ctx-t-other:#90A1B9;--ctx-window-rest:rgba(115,115,115,.18);--ctx-window-reserve:rgba(65,118,230,.24);}
.session.theme-dark{--ctx-window-rest:rgba(241,244,250,.08);--ctx-window-reserve:rgba(241,244,250,.14);}
.ctx-live-dot{width:16rpx;height:16rpx;margin-left:auto;}
.ctx-chip-io-userInputs{border-color:rgba(34,197,94,.35);}
.ctx-chip-io-reads{border-color:rgba(99,102,241,.35);}
.ctx-chip-io-writes{border-color:rgba(245,158,11,.35);}
.ctx-chip-io-searches{border-color:rgba(20,184,166,.35);}
.ctx-chip-io-images{border-color:rgba(236,72,153,.35);}
.ctx-donut{position:relative;width:192rpx;height:192rpx;flex-shrink:0;border-radius:50%;background:rgba(115,115,115,.18);transition:background .45s ease;}
.ctx-donut-hole{position:absolute;inset:18rpx;border-radius:50%;background:var(--surface);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rpx;}
.ctx-donut-value{font-size:24rpx;font-weight:700;color:var(--text);font-variant-numeric:tabular-nums;line-height:1.1;}
.ctx-donut-unit{font-size:20rpx;color:var(--text-3);}
/* ---- 统计类卡片：共用图例网格 / 环形行 / 组成条（逐值对齐 dsh-context stats.css + stackedBar.css） ---- */
.ctx-card-rate { margin-left: auto; flex: none; font-size: 24rpx; line-height: 36rpx; color: var(--text-2); font-variant-numeric: tabular-nums; }
.ctx-donut-row { display: flex; align-items: center; gap: 24rpx; min-width: 0; }
.ctx-slice-grid { flex: 1; min-width: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr)); gap: 8rpx 16rpx; overflow: hidden; }
.ctx-slice-grid-flow { margin-top: 20rpx; }
.ctx-slice { display: flex; flex-direction: column; gap: 2rpx; min-width: 0; padding: 2rpx 0; font-size: 24rpx; }
.ctx-slice-main { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.ctx-slice-label { flex: 1 1 auto; min-width: 0; font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ctx-slice-pct { flex: none; min-width: 60rpx; text-align: right; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
.ctx-slice-sub { margin-left: 28rpx; font-size: 22rpx; color: var(--text-2); font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ctx-slice { border-radius: 10rpx; transition: opacity .2s ease, background-color .2s ease; }
.ctx-slice.dim { opacity: .45; }
.ctx-slice.active { background: var(--fill-2); }
/* 当前上下文：大号数值 + 16px 组成条 + 两段 45° 斜线预留遮罩 + 触发线 */
.ctx-overview-num { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.ctx-overview-value { font-size: 40rpx; font-weight: 600; line-height: 1.1; color: var(--text); font-variant-numeric: tabular-nums; }
.ctx-overview-window { font-size: 26rpx; color: var(--text-2); font-variant-numeric: tabular-nums; }
.ctx-overview-pct { margin-left: auto; display: flex; align-items: baseline; gap: 8rpx; font-size: 22rpx; color: var(--text-2); }
.ctx-overview-pct-value { font-size: 40rpx; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
.ctx-overview-pct-label { font-size: 22rpx; color: var(--text-2); }
.ctx-compose-bar { position: relative; display: flex; height: 32rpx; border-radius: 10rpx; overflow: hidden; background: rgba(115, 115, 115, .18); }
.ctx-compose-seg { height: 100%; min-width: 1rpx; transition: width .45s ease, opacity .2s ease; }
.ctx-compose-seg.dim { opacity: .35; }
.ctx-compose-seg.active { filter: brightness(1.12); }
.ctx-compose-free { height: 100%; }
.ctx-compose-mask { position: absolute; top: 0; bottom: 0; pointer-events: none; }
.ctx-mask-headroom { background: repeating-linear-gradient(45deg, rgba(245, 158, 11, .24) 0 5px, transparent 5px 10px); }
.ctx-mask-output { background: repeating-linear-gradient(45deg, rgba(65, 118, 230, .24) 0 5px, transparent 5px 10px); }
.theme-dark .ctx-mask-output { background: repeating-linear-gradient(45deg, rgba(122, 170, 255, .24) 0 5px, transparent 5px 10px); }
.ctx-compose-trigger { position: absolute; top: -2rpx; bottom: -2rpx; width: 9px; margin-left: -4.5px; pointer-events: none; }
.ctx-compose-trigger::after { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: var(--amber); }
/* 耗时时间轴：12px 条 + 零/四分位/全程刻度（dsh-context timingStrip） */
.ctx-tstrip { margin-top: 20rpx; }
.ctx-tstrip-bar { position: relative; height: 24rpx; border-radius: 8rpx; overflow: hidden; background: rgba(115, 115, 115, .18); }
.ctx-tstrip-seg { position: absolute; top: 0; bottom: 0; min-width: 1rpx; }
.ctx-tstrip-axis { position: relative; height: 26rpx; margin-top: 10rpx; }
.ctx-tstrip-tick { position: absolute; top: 0; transform: translateX(-50%); font-size: 20rpx; line-height: 26rpx; color: var(--text-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
.ctx-tstrip-tick-first { transform: none; }
.ctx-tstrip-tick-last { transform: translateX(-100%); }
.ctx-t-reasoning{background:var(--ctx-t-reasoning);}
.ctx-t-text{background:var(--ctx-t-text);}
.ctx-t-toolarg{background:var(--ctx-t-toolarg);}
.ctx-t-other{background:var(--ctx-t-other);}
.ctx-span-wait{background:var(--ctx-t-wait);}
.ctx-span-reasoning{background:var(--ctx-t-reasoning);}
.ctx-span-text{background:var(--ctx-t-text);}
.ctx-span-toolarg{background:var(--ctx-t-toolarg);}
.ctx-span-tools{background:var(--ctx-t-tools);}
.ctx-span-other{background:var(--ctx-t-other);}
/* ---- 上下文浏览器（逐值对齐 dsh-context browser.css / base.css / detailSections.css） ---- */
.ctx-br-head-actions{display:flex;align-items:center;gap:8rpx;margin-left:auto;flex-wrap:wrap;}
.ctx-gran{display:flex;gap:4rpx;padding:2rpx;background:var(--fill);border:1rpx solid var(--border);border-radius:12rpx;}
.ctx-gran-btn{padding:6rpx 16rpx;border-radius:10rpx;font-size:22rpx;line-height:1.2;color:var(--text-2);}
.ctx-gran-btn.on{background:var(--ink);color:var(--surface);}
.ctx-br-nav{display:flex;align-items:center;gap:12rpx;margin-top:4rpx;}
.ctx-browser-step{flex:none;min-height:56rpx;padding:0 18rpx;display:flex;align-items:center;justify-content:center;border-radius:12rpx;background:var(--fill);color:var(--text);font-size:22rpx;}
.ctx-browser-step.disabled{opacity:.35;}
.ctx-browser-picker{flex:1;min-width:0;}
.ctx-browser-picker-value{box-sizing:border-box;min-height:56rpx;padding:6rpx 16rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;border-radius:12rpx;background:var(--fill);border:1rpx solid var(--border);font-size:22rpx;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ctx-browser-caret{font-size:18rpx;color:var(--text-3);}
.ctx-br-kinds{flex:none;}
.ctx-br-meta{display:flex;flex-wrap:wrap;align-items:baseline;gap:6rpx 18rpx;margin:14rpx 0 10rpx;font-size:21rpx;color:var(--text-2);}
.ctx-br-meta-strong{font-weight:600;color:var(--text);}
.ctx-br-meta-time{color:var(--text-3);font-variant-numeric:tabular-nums;}
.ctx-br-meta-item{font-size:21rpx;color:var(--text-3);font-variant-numeric:tabular-nums;}
.ctx-br-meta-item:first-of-type{margin-left:auto;}
.ctx-br-bar{display:flex;height:20rpx;margin-bottom:12rpx;border-radius:10rpx;overflow:hidden;background:rgba(115,115,115,.18);}
.ctx-br-bar-seg{height:100%;min-width:1rpx;}
.ctx-br-note{padding:10rpx 0;font-size:20rpx;line-height:1.5;color:var(--text-3);}
.ctx-br-scroll{max-height:62vh;}
.ctx-br-cat{border-top:1rpx solid var(--divider);}
.ctx-br-cat.empty{opacity:.55;}
.ctx-br-cat.on{background:var(--fill);border-radius:12rpx;}
.ctx-br-cat-row{display:flex;align-items:center;gap:12rpx;padding:14rpx 8rpx;min-height:56rpx;font-size:22rpx;}
.ctx-br-chevron{flex:none;width:20rpx;font-size:18rpx;color:var(--text-4);}
.ctx-br-swatch{flex:none;width:16rpx;height:16rpx;border-radius:4rpx;}
.ctx-br-cat-name{flex:0 1 auto;min-width:0;font-size:23rpx;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ctx-br-count{flex:none;font-size:20rpx;color:var(--text-3);font-variant-numeric:tabular-nums;}
.ctx-br-delta{flex:none;padding:0 10rpx;border-radius:8rpx;font-size:20rpx;font-weight:600;font-variant-numeric:tabular-nums;}
.ctx-delta-up{color:#2E8B57;background:rgba(46,185,92,.15);}
.ctx-delta-down{color:#E5484D;background:rgba(229,72,77,.15);}
.ctx-delta-flat{color:var(--text-3);background:transparent;}
.ctx-br-token{margin-left:auto;flex:none;font-size:23rpx;font-weight:600;color:var(--text);font-variant-numeric:tabular-nums;}
.ctx-br-pct{flex:none;width:72rpx;text-align:right;font-size:22rpx;color:var(--text-3);font-variant-numeric:tabular-nums;}
.ctx-br-body{padding:0 0 14rpx 26rpx;}
.ctx-br-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx;margin-bottom:10rpx;}
.ctx-br-search{flex:1;min-width:200rpx;height:56rpx;box-sizing:border-box;padding:0 16rpx;border:1rpx solid var(--border);border-radius:12rpx;background:var(--surface);font-size:22rpx;color:var(--text);}
.ctx-br-elem{padding:10rpx 8rpx;border-radius:10rpx;}
.ctx-br-elem.on{background:var(--fill);}
.ctx-br-elem-row{display:flex;align-items:center;gap:8rpx;flex-wrap:wrap;font-size:22rpx;}
.ctx-br-errdot{flex:none;width:12rpx;height:12rpx;border-radius:50%;background:#E5484D;}
.ctx-br-tag{max-width:220rpx;flex:none;padding:0 10rpx;border-radius:8rpx;background:var(--fill-2);color:var(--text-2);font-size:19rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ctx-br-preview{flex:1;min-width:200rpx;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ctx-br-stamp{flex:none;font-size:19rpx;color:var(--text-3);font-variant-numeric:tabular-nums;}
.ctx-br-time{flex:none;font-size:19rpx;color:var(--text-4);font-variant-numeric:tabular-nums;}
.ctx-br-tok{flex:none;font-size:21rpx;color:var(--text-2);font-variant-numeric:tabular-nums;}
.ctx-br-detail{margin:10rpx 0 4rpx;padding:10rpx 14rpx;border-radius:10rpx;background:var(--fill-2);}
.ctx-br-detail-head{display:flex;align-items:center;gap:16rpx;margin-bottom:6rpx;}
.ctx-br-detail-meta{flex:1;min-width:0;font-size:19rpx;color:var(--text-3);font-variant-numeric:tabular-nums;}
.ctx-br-copy{flex:none;padding:2rpx 12rpx;font-size:19rpx;color:var(--ink);border:1rpx solid var(--border);border-radius:8rpx;background:var(--surface);}
.ctx-br-content{display:block;max-height:640rpx;overflow:auto;white-space:pre-wrap;word-break:break-word;font-size:22rpx;line-height:1.55;color:var(--text-2);}
.ctx-br-source-chip{flex:none;max-width:220rpx;padding:0 8rpx;border-radius:8rpx;background:rgba(46,107,230,.14);color:#2E6BE6;font-size:18rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.theme-dark .ctx-br-source-chip{background:rgba(122,170,255,.16);color:#9CC0FF;}
.ctx-br-tool{margin:8rpx 0 4rpx;padding:10rpx 14rpx;border-radius:10rpx;background:var(--fill-2);}
.ctx-br-tool-desc{font-size:21rpx;line-height:1.5;color:var(--text-2);}
.ctx-br-params{margin-top:10rpx;border-top:1rpx solid var(--divider);}
.ctx-br-param{display:grid;grid-template-columns:minmax(0,140rpx) minmax(0,90rpx) 56rpx minmax(0,1fr);gap:8rpx 4rpx;align-items:center;padding:8rpx 4rpx;border-top:1rpx solid var(--divider);font-size:20rpx;}
.ctx-br-param:first-child{border-top:0;}
.ctx-br-param-name{font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ctx-br-param-type{font-size:18rpx;color:var(--text-3);}
.ctx-br-param-req{text-align:center;color:var(--amber);}
.ctx-br-param-desc{grid-column:1 / -1;font-size:18rpx;line-height:1.45;color:var(--text-3);}
.ctx-br-flat-head{display:flex;align-items:baseline;gap:12rpx;padding:12rpx 0;border-bottom:1rpx solid var(--divider);}
.ctx-br-flat-title{font-size:23rpx;font-weight:600;color:var(--text);}
.ctx-br-note-inline{font-size:19rpx;color:var(--text-4);}
.ctx-br-flat-row{padding:12rpx 8rpx;border-bottom:1rpx solid var(--divider);}
.ctx-br-flat-row.on{background:var(--fill);border-radius:10rpx;}
.ctx-br-flat-line{display:flex;align-items:center;gap:10rpx;font-size:22rpx;min-width:0;}
.ctx-br-pos{flex:none;width:56rpx;font-size:19rpx;color:var(--text-3);font-variant-numeric:tabular-nums;}
.ctx-br-cat-chip{flex:none;padding:0 10rpx;border-radius:8rpx;font-size:19rpx;font-weight:600;color:var(--text);}
.ctx-br-cat-chip.ctx-c-system{background:rgba(97,95,255,.14);border:1rpx solid rgba(97,95,255,.45);}
.ctx-br-cat-chip.ctx-c-tools{background:rgba(254,154,0,.14);border:1rpx solid rgba(254,154,0,.45);}
.ctx-br-cat-chip.ctx-c-user{background:rgba(0,201,80,.14);border:1rpx solid rgba(0,201,80,.45);}
.ctx-br-cat-chip.ctx-c-inject{background:rgba(173,70,255,.14);border:1rpx solid rgba(173,70,255,.45);}
.ctx-br-cat-chip.ctx-c-skill{background:rgba(255,105,0,.14);border:1rpx solid rgba(255,105,0,.45);}
.ctx-br-cat-chip.ctx-c-assistant{background:rgba(43,127,255,.14);border:1rpx solid rgba(43,127,255,.45);}
.ctx-br-cat-chip.ctx-c-tool{background:rgba(0,187,167,.14);border:1rpx solid rgba(0,187,167,.45);}
.ctx-br-flat-label{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ctx-br-flat-meta{padding-left:66rpx;font-size:19rpx;color:var(--text-3);}
/* ---- 文件活动（dsh-context fileCard.css：字形 + 读写搜徽标 + 行数增减 + op 日志） ---- */
.ctx-file-chips{margin-bottom:12rpx;}
.ctx-file-chip-n{margin-left:8rpx;opacity:.75;font-weight:700;font-variant-numeric:tabular-nums;}
.ctx-file-controls{display:flex;flex-direction:column;gap:10rpx;margin-bottom:12rpx;}
.ctx-file-sorts{align-self:flex-start;}
.ctx-file-lane{max-height:640rpx;}
.ctx-file-row{border-top:1rpx solid var(--divider);}
.ctx-file-row.on{margin:0 -8rpx;padding:0 8rpx;border-radius:12rpx;background:var(--fill);}
.ctx-file-row-head{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx;padding:10rpx 0;font-size:22rpx;}
.ctx-file-chevron{flex:none;width:24rpx;font-size:18rpx;color:var(--text-4);}
.ctx-file-glyph{flex:none;width:36rpx;text-align:center;font-size:24rpx;}
.ctx-file-lang{flex:none;min-width:32rpx;height:26rpx;padding:0 6rpx;display:flex;align-items:center;justify-content:center;border-radius:8rpx;font-size:16rpx;font-weight:700;line-height:1;}
.ctx-file-name-wrap{flex:1;min-width:180rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ctx-file-pathdir{color:var(--text-3);}
.ctx-file-pathname{font-weight:600;color:var(--text);}
.ctx-file-badge{flex:none;display:inline-flex;align-items:center;gap:6rpx;padding:0 12rpx;border-radius:999rpx;font-size:19rpx;font-weight:600;}
.ctx-file-badge-dot{width:8rpx;height:8rpx;border-radius:50%;background:currentColor;}
.ctx-file-badge-n{font-variant-numeric:tabular-nums;}
.ctx-file-badge-read{color:#2E6BE6;background:rgba(46,107,230,.14);}
.ctx-file-badge-write{color:#22C55E;background:rgba(34,197,94,.14);}
.ctx-file-badge-search{color:var(--amber);background:rgba(245,158,11,.14);}
.ctx-file-add{flex:none;font-size:20rpx;font-weight:600;color:#2E8B57;font-variant-numeric:tabular-nums;}
.ctx-file-del{flex:none;font-size:20rpx;font-weight:600;color:#E5484D;font-variant-numeric:tabular-nums;}
.ctx-file-error{flex:none;font-size:19rpx;color:#E5484D;}
.ctx-file-time{flex:none;font-size:19rpx;color:var(--text-4);font-variant-numeric:tabular-nums;}
.ctx-file-ops{margin:0 0 10rpx 32rpx;padding-left:16rpx;border-left:2rpx solid var(--border);}
.ctx-file-op{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx;padding:6rpx 0;font-size:20rpx;color:var(--text-2);}
.ctx-file-op-tool{flex:none;max-width:220rpx;padding:0 12rpx;border-radius:999rpx;background:var(--surface);border:1rpx solid var(--divider);font-size:18rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ctx-file-op-detail{flex:1;min-width:180rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text);}
.ctx-file-op-meta{flex:none;font-size:18rpx;color:var(--text-3);font-variant-numeric:tabular-nums;}
/* ---- 编队汇总 / Agent 网络（fleet.css / agentGraph.css） ---- */
.fleet-summary{display:flex;flex-wrap:wrap;align-items:center;gap:12rpx 16rpx;}
.fleet-summary-chips{display:flex;flex-wrap:wrap;gap:8rpx;flex:1;min-width:0;}
.fleet-chip{padding:4rpx 16rpx;border-radius:999rpx;background: transparent;border:1rpx solid var(--divider);font-size:22rpx;color:var(--text-2);font-variant-numeric:tabular-nums;}
.fleet-chip.on{color:var(--success);border-color:rgba(46,184,92,.4);}
.fleet-chip.brand{color:var(--ocean);border-color:rgba(46,107,230,.4);}
.fleet-chip-toggle{color:var(--ocean);background: transparent;border-color:rgba(46,107,230,.4);}
.fleet-progress{flex-basis:100%;display:flex;align-items:center;gap:12rpx;font-size:22rpx;color:var(--text-2);}
.fleet-progress-label{flex:none;}
.fleet-progress-track{flex:none;width:280rpx;height:12rpx;border-radius:8rpx;background:rgba(16,19,24,.16);overflow:hidden;}
.fleet-progress-fill{height:100%;background:var(--ink);border-radius:8rpx;transition:width .45s ease,background-color .45s ease;}
.fleet-progress-fill.done{background:var(--success);}
.fleet-progress-text{font-variant-numeric:tabular-nums;}
.fleet-graph-card{}
/* 标题行是 baseline 对齐：图标改用 center 自对齐，避免和文字基线错位 */
.fleet-title-ic { width: 30rpx; height: 30rpx; flex: none; align-self: center; opacity: .8; margin-right: 10rpx; }
.fleet-graph-sub{font-size:20rpx;}
.fleet-legend-label{flex:none;}
.fleet-chips{display:flex;flex-wrap:wrap;gap:8rpx;margin-bottom:10rpx;}
.fleet-legend{display:flex;flex-wrap:wrap;gap:8rpx 28rpx;margin-bottom:12rpx;font-size:22rpx;color:var(--text-2);}
.fleet-legend-item{display:inline-flex;align-items:center;gap:10rpx;}
.fleet-legend-swatch{width:16rpx;height:16rpx;border-radius:4rpx;}
.fleet-legend-free{width:16rpx;height:16rpx;border-radius:4rpx;background:rgba(16,19,24,.16);}
.fleet-legend-live{width:28rpx;height:0;border-top:4rpx dashed var(--success);}
.fleet-stage{max-height:1120rpx;}
.fleet-stage.all{max-height:none;}
.fleet-canvas{position:relative;margin:0 auto;}
.fleet-links-image{position:absolute;left:0;top:0;pointer-events:none;z-index:0;}
.fleet-links-canvas{position:absolute;left:0;top:0;pointer-events:none;z-index:0;}
.fleet-node{position:relative;z-index:1;}
.fleet-node{position:absolute;box-sizing:border-box;display:flex;flex-direction:column;padding:14rpx 18rpx;border-radius:20rpx;background: transparent;border:1rpx solid var(--border);overflow:hidden;transition:border-color .2s ease,box-shadow .2s ease,opacity .2s ease,transform .2s ease;}
.fleet-node-pressed{opacity:.75;}
.fleet-node.self{border-color:rgba(16,19,24,.55);}
.fleet-node.selected{border-color:var(--ocean);box-shadow:0 0 0 2rpx rgba(46,107,230,.35),0 4rpx 20rpx rgba(16,19,24,.18);transform:translateY(-2rpx);}
.fleet-node-head{display:flex;align-items:flex-start;gap:8rpx;}
/* 与设计稿等比：卡片 140px 高时圆点 9px -> 18rpx（原 20rpx 偏大）。 */
@keyframes fleet-spin{to{transform:rotate(1turn);}}
.fleet-node-title{flex:1;min-width:0;font-size:23rpx;font-weight:650;line-height:1.3;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;overflow-wrap:break-word;}
.fleet-node-badge{flex:none;padding:2rpx 12rpx;border-radius:999rpx;background: transparent;border:1rpx solid var(--divider);font-size:20rpx;color:var(--text-2);}
.fleet-node-metric{margin-top:10rpx;font-size:26rpx;color:var(--text);font-variant-numeric:tabular-nums;}
.fleet-node-bar{display:flex;height:14rpx;margin-top:16rpx;border-radius:8rpx;overflow:hidden;background:rgba(16,19,24,.16);}
.fleet-node-seg{height:100%;min-width:1rpx;}
.fleet-node-foot{margin-top:auto;padding-top:12rpx;display:flex;align-items:center;gap:8rpx;font-size:20rpx;line-height:1.3;color:var(--text-2);}
.fleet-node-meta{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.fleet-node-pct{flex:none;font-weight:600;font-variant-numeric:tabular-nums;}
.fleet-node-open{flex:none;width:40rpx;height:40rpx;line-height:40rpx;text-align:center;border-radius:50%;background: transparent;border:1rpx solid var(--divider);color:var(--ocean);font-size:24rpx;}
.fleet-hint{display:flex;align-items:flex-start;gap:12rpx;margin-top:18rpx;padding:20rpx 22rpx;border-radius:20rpx;background:var(--fill);border:1rpx dashed var(--border-strong);}
.fleet-hint-dot{width:12rpx;height:12rpx;margin-top:10rpx;border-radius:50%;flex-shrink:0;background:var(--text-4);}
.fleet-hint-text{flex:1;min-width:0;font-size:22rpx;line-height:1.6;color:var(--text-3);}
.fleet-task-card{margin-top:18rpx;padding-top:20rpx;}
.fleet-task-row{display:flex;align-items:center;gap:12rpx;padding:9rpx 0;border-bottom:1rpx solid var(--divider);}
.fleet-task-row:last-child{border-bottom:0;}
.fleet-task-status{flex-shrink:0;padding:2rpx 10rpx;border-radius:8rpx;font-size:19rpx;font-weight:600;color:var(--text-2);background:transparent;}
.fleet-task-status.ctx-task-active{color:#2E6BE6;background:rgba(46,107,230,.12);}
.fleet-task-status.ctx-task-done{color:#22A06B;background:rgba(34,160,107,.12);}
.fleet-task-status.ctx-task-failed{color:#FF7178;background:rgba(255,113,120,.14);}
.fleet-task-status.ctx-task-blocked{color:#E07A1F;background:rgba(224,122,31,.14);}
.fleet-task-subject{flex:1;min-width:0;font-size:22rpx;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.fleet-task-owner{flex-shrink:0;max-width:180rpx;font-size:20rpx;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.fleet-task-empty{padding:18rpx 0 6rpx;font-size:22rpx;color:var(--text-3);text-align:center;}
/* Stable keyed bars interpolate when a new snapshot arrives. */
.ctx-trend-controls { display:flex;flex-wrap:wrap;align-items:center;gap:12rpx;margin-bottom:12rpx; }
.ctx-trend-control-group { display:flex;padding:4rpx;border-radius:12rpx;background:var(--fill); }
.ctx-trend-control { box-sizing:border-box;min-height:52rpx;padding:11rpx 16rpx;border:1rpx solid transparent;font-size:22rpx;color:var(--text-3);border-radius:10rpx;transition:background-color .18s ease,color .18s ease,border-color .18s ease,box-shadow .18s ease,transform .18s ease; }
.ctx-trend-control.active { background:var(--surface);color:var(--text);border-color:var(--border-strong);box-shadow:var(--card-shadow),0 0 0 1rpx var(--border-strong);transform:translateY(-1rpx); }
.ctx-trend-aggregate-note { font-size:20rpx;color:var(--text-4); }
.ctx-trend-detail { margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid var(--divider); }
.ctx-trend-detail-rows { display:flex;flex-direction:column;gap:8rpx;margin-top:12rpx; }
.ctx-trend-detail-head { display:flex;align-items:center;flex-wrap:wrap;gap:8rpx 14rpx; }
.ctx-trend-detail-title { font-size:23rpx;font-weight:600;color:var(--text); }
.ctx-trend-detail-time { margin-left:auto;font-size:22rpx;color:var(--text-3);font-variant-numeric:tabular-nums; }
.ctx-trend-marker-chip { padding:2rpx 14rpx;border-radius:12rpx;background:rgba(245,158,11,.12);color:var(--amber);font-size:22rpx;font-variant-numeric:tabular-nums; }
.ctx-trend-tag { padding:2rpx 14rpx;border-radius:10rpx;background:var(--fill);border:1rpx solid var(--border);font-size:22rpx;color:var(--text-2); }
.ctx-trend-metrics { display:flex;flex-wrap:wrap;gap:8rpx;margin:10rpx 0; }
.ctx-trend-metric { padding:2rpx 12rpx;border-radius:10rpx;background:var(--fill);font-size:22rpx;color:var(--text-2);font-variant-numeric:tabular-nums; }
.ctx-trend-metric-delta { font-weight:600; }
.ctx-trend-bar-marker { position:absolute;top:-16px;left:50%;transform:translateX(-50%);font-size:11px;line-height:1;color:var(--amber);z-index:2;pointer-events:none; }
/* Step brief 三行（requestDetail.css .lc-brief） */
.ctx-brief { display:flex;flex-direction:column;gap:4rpx;margin:8rpx 0 10rpx;min-height:150rpx; }
.ctx-brief-row { display:flex;align-items:center;gap:12rpx;min-height:54rpx;padding:6rpx 12rpx;border-radius:12rpx;background:var(--fill); }
.ctx-brief-row.empty { background:transparent; }
.ctx-brief-tag { flex:none;min-width:112rpx;text-align:center;padding:0 12rpx;border-radius:8rpx;background:var(--fill-2);border:1rpx solid var(--border);font-size:22rpx;color:var(--text-2); }
.ctx-brief-chip { max-width:520rpx;display:flex;align-items:center;gap:6rpx;padding:0 14rpx;border-radius:10rpx;background:var(--surface);border:1rpx solid var(--divider);font-size:22rpx;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.ctx-brief-more { font-size:22rpx;color:var(--text-3); }
.ctx-brief-empty { font-size:22rpx;color:var(--text-4); }
.ctx-trend-detail-meta { font-size:20rpx;color:var(--text-4);font-variant-numeric:tabular-nums; }
.ctx-trend-detail-summary { display:flex;flex-wrap:wrap;gap:8rpx 16rpx;margin:12rpx 0;font-size:20rpx;color:var(--text-3);font-variant-numeric:tabular-nums; }
.ctx-trend-markernote { display:flex;align-items:center;gap:8rpx;margin:-4rpx 0 12rpx;padding:8rpx 12rpx;border-radius:10rpx;background:var(--fill);font-size:20rpx;color:var(--text-3); }
.ctx-trend-markernote-text { flex:1;min-width:0; }
.ctx-trend-delta-up, .ctx-trend-detail-delta.ctx-delta-up { color:#E07A1F; }
.ctx-trend-delta-down, .ctx-trend-detail-delta.ctx-delta-down { color:#2E8B57; }
.ctx-trend-detail-row { display:flex;align-items:center;gap:10rpx;padding:7rpx 0;border-top:1rpx solid var(--divider);font-size:21rpx; }
.ctx-trend-detail-name { flex:1;min-width:0;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.ctx-trend-detail-pct { min-width:72rpx;text-align:right;color:var(--text-4);font-variant-numeric:tabular-nums; }
.ctx-trend-detail-value { min-width:92rpx;text-align:right;color:var(--text-2);font-variant-numeric:tabular-nums; }
.ctx-trend-detail-delta { min-width:88rpx;text-align:right;color:var(--text-4);font-variant-numeric:tabular-nums; }
@keyframes ctx-trend-surface-in {
  from { opacity:0;transform:translateY(8rpx) scale(.992); }
  to { opacity:1;transform:translateY(0) scale(1); }
}
.ctx-trend-surface-overview,.ctx-trend-dna { animation:ctx-trend-surface-in .24s cubic-bezier(.2,.7,.2,1) both; }
@media (prefers-reduced-motion:reduce) {
  .ctx-trend-surface-overview,.ctx-trend-dna { animation:none; }
}
/* auto-preview test */
/* 文件 / 变更卡片底部的复制按钮（跟随卡片左对齐） */
.file-copy-btn {
  margin: 4rpx 0 0 8rpx;
  padding-bottom: 6rpx;
}
/* 文件卡片外层：宽度撑满，卡片保持原样，复制按钮在卡片之外 */
.file-card-wrap {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.file-card-wrap .changed-files,
.file-card-wrap .delivered-files {
  width: 100%;
  box-sizing: border-box;
}
.file-card-wrap .file-copy-btn {
  align-self: flex-start;
  margin: 6rpx 0 0 8rpx;
}
/* 每轮底部（含文件/变更卡片行）：复制与上下文跳转按钮必须几何一致。
   file-copy-btn 的 align-self:flex-start / margin-top / padding-bottom 是卡片时代的
   微调，在页脚里会让两个按钮在不同行类型中错位（有的记录对齐、有的不齐）——
   这里统一撤销，只保留 margin-left 的间距。 */
.turn-footer .copy-btn {
  margin-top: 0;
  padding-bottom: 0;
  align-self: auto;
}
/* ---------- 每轮底部：复制按钮 + 用量/时间 ---------- */
.turn-footer-wrap {
  display: block;
}
.turn-footer {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 14rpx;
  padding: 4rpx 0;
}
.turn-footer-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
/* 用量：胶囊底色 + 图标 + 文字 */
.turn-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  /* border-box + 显式高度：总高 44rpx（此前 height:52rpx 是 content-box，
     加上 padding 后实际 68rpx，把整行撑高、图标按钮被衬得偏低）。
     内容 32rpx 图标居中，上下各 6rpx——紧凑但仍有呼吸感。 */
  box-sizing: border-box;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--fill);
  flex-shrink: 0;
}
/* 时间：单独显示在右侧 */
.turn-time {
  font-size: 23rpx;
  line-height: 32rpx;
  color: var(--text-3);
  white-space: nowrap;
  margin-left: 0;
  font-variant-numeric: tabular-nums;
}
.turn-meta-ic {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.7;
  flex-shrink: 0;
}
.turn-meta-text {
  font-size: 23rpx;
  line-height: 32rpx;
  color: var(--text-2);
  white-space: nowrap;
}
/* ---------- 本轮用量详情（贴按钮浮卡，跟随主题） ---------- */
.turn-usage-mask {
  position: fixed;
  inset: 0;
  z-index: 210;
  background: rgba(0, 0, 0, 0.12);
}
.theme-dark .turn-usage-mask {
  background: rgba(0, 0, 0, 0.32);
}
.turn-usage-card {
  position: fixed;
  box-sizing: border-box;
  padding: 24rpx 28rpx 12rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  box-shadow: 0 18rpx 48rpx rgba(7, 24, 43, 0.18);
  display: flex;
  flex-direction: column;
  color: var(--text);
}
.theme-dark .turn-usage-card {
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.55);
}
.turn-usage-card.above {
  transform: translateY(-100%);
}
.turn-usage-card.below {
  transform: none;
}
.turn-usage-total {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 4rpx 20rpx;
  border-bottom: 1rpx solid var(--divider);
}
.turn-usage-ic {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}
.turn-usage-total-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.turn-usage-total-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.turn-usage-rows {
  display: flex;
  flex-direction: column;
  padding: 4rpx 4rpx 6rpx;
}
.turn-usage-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 13rpx 0;
}
.turn-usage-label {
  font-size: 25rpx;
  color: var(--text-2);
}
.turn-usage-value {
  font-size: 25rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
  text-align: right;
}
/* ---------- 上下文统计：流动连接（对齐 dsh-context 的 Agent Flow，竖向布局） ---------- */
.ctx-flow {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 52rpx;
  padding: 0;
  /* 连接线画在绝对定位的画布上：裁剪掉任何越出模块的笔画，
     节点长大后画布尺寸滞后时也不会溢到下方卡片。 */
  overflow: hidden;
}
.ctx-flow-canvas {
  position: absolute;
  left: 0;
  top: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}
.ctx-flow-segment { position: absolute; border-radius: 999rpx; }
.ctx-flow-glow { height: 14px; opacity: 0.13; }
.ctx-flow-dash { height: 1.5px; opacity: 0.55; background-size: 9px 100%; animation: ctx-flow-dash 900ms linear infinite; }
@keyframes ctx-flow-dash { from { background-position: 0 0; } to { background-position: 9px 0; } }
@media (prefers-reduced-motion: reduce) { .ctx-flow-dash { animation: none; } }
.ctx-flow-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}
.ctx-flow-row-top .ctx-flow-node,
.ctx-flow-row-bottom .ctx-flow-node {
  flex: 1 1 0;
  min-width: 0;
}
.ctx-flow-mid {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  justify-content: center;
}
.ctx-flow-mid .ctx-flow-node {
  width: 82%;
}
.ctx-flow-node {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.ctx-flow-node-action { border-style: dashed; transition: border-color .18s ease, background-color .18s ease, transform .18s ease; }
.ctx-flow-node-pressed { border-color: var(--ink); background: var(--fill-2); transform: translateY(1rpx); }
.ctx-flow-self {
  background: var(--surface);
  border: 2rpx solid rgba(15, 17, 21, .40);
  border-radius: 16rpx;
  box-shadow: 0 0 0 6rpx rgba(15, 17, 21, .08);
  padding: 16rpx 28rpx;
}
.ctx-flow-self .ctx-flow-head {
  justify-content: center;
}
.ctx-flow-head {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}
.ctx-flow-total {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 650;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
/* 统计卡胶囊/会话 kv/Agent 网络（逐值对齐 dsh-context stats.css） */
.ctx-flow-label { font-size: 22rpx; font-weight: 600; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ctx-pills { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.ctx-pills-tools { flex-wrap: nowrap; overflow: hidden; }
.ctx-pill { display: inline-flex; align-items: center; gap: 10rpx; padding: 4rpx 16rpx; border-radius: 999rpx; background: var(--surface); border: 1rpx solid var(--divider); color: var(--text-2); font-size: 22rpx; line-height: 1.5; font-variant-numeric: tabular-nums; }
.ctx-pill-pressed { opacity: .65; }
.ctx-pill-value { font-weight: 700; color: var(--text); }
.ctx-pill-word, .ctx-pill-name { max-width: 280rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ctx-pill-count { font-weight: 700; color: var(--text); }
.ctx-pill-dim { opacity: .45; }
.ctx-pill-tint .ctx-pill-value { color: inherit; }
.ctx-kind-inject { color: #22C55E; background: rgba(34, 197, 94, .15); border-color: transparent; }
.ctx-kind-compaction { color: #EC1313; background: rgba(236, 19, 19, .15); border-color: transparent; }
.ctx-kind-prune { color: #8E51FF; background: rgba(142, 81, 255, .15); border-color: transparent; }
.theme-dark .ctx-kind-compaction { color: #F25A5A; }
.ctx-stat-q { width: 22rpx; height: 22rpx; line-height: 20rpx; border-radius: 50%; border: 1rpx solid var(--border); background: var(--surface); color: var(--text-2); font-size: 18rpx; font-weight: 700; text-align: center; flex: none; margin-left: 4rpx; }
.ctx-flow-self-stats { display: flex; align-self: stretch; gap: 32rpx; }
.ctx-flow-kv { flex: 1; display: flex; flex-direction: column; align-items: center; min-width: 0; }
.ctx-flow-kv-value { font-size: 34rpx; font-weight: 700; line-height: 1.2; color: var(--text); font-variant-numeric: tabular-nums; }
.ctx-flow-kv-label { font-size: 22rpx; color: var(--text-2); }
.ctx-flow-kv-btn { border-radius: 8rpx; }
.ctx-flow-kv-pressed { background: var(--fill-2); }
.ctx-flow-rows { display: flex; flex-direction: column; gap: 6rpx; margin-top: 8rpx; font-size: 22rpx; color: var(--text-2); }
.ctx-flow-rowline { display: flex; align-items: baseline; gap: 8rpx; min-width: 0; }
.ctx-flow-rowlabel { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ctx-flow-rowvalue { margin-left: auto; flex: none; font-variant-numeric: tabular-nums; font-weight: 700; color: var(--text); }
.theme-dark .ctx-flow-self {
  background: #2c2c2e;
  border-color: rgba(249, 250, 251, .40);
  box-shadow: 0 0 0 6rpx rgba(249, 250, 251, .08);
}
@media (max-width: 350px) {
  .ctx-flow { gap: 72rpx; }
  .ctx-flow-node { padding: 14rpx 14rpx; }
}
/* ---- 编队成员板（memberBoard / fleet.css） ---- */
/* 编队模块：卡片与筛选 chip 组只把背景改成透明（边框/投影/圆角保留），融入合并面板。
   作用域限定编队——.ctx-card / .ctx-gran / .fleet-card 是浏览器、趋势、文件筛选共用的。 */
.ctx-card.fleet-members,
.ctx-card.fleet-summary,
.ctx-card.fleet-graph-card,
.ctx-card.fleet-comms,
.fleet-card { background: transparent; }
.fleet-member-toolbar .ctx-gran { background: transparent; }
.fleet-task-card .fleet-task-gran { background: transparent; }
.fleet-member-warn { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 8rpx; color: #E5484D; background: rgba(229,72,77,.12); }
.fleet-member-toolbar { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 12rpx; }
.fleet-member-chip-n { margin-left: 6rpx; opacity: .65; font-variant-numeric: tabular-nums; }
.fleet-member-list { display: flex; flex-direction: column; gap: 10rpx; }
.fleet-member { padding: 14rpx 4rpx; border-radius: 0; background: transparent; border: 0; border-top: 4rpx solid var(--border); display: flex; flex-direction: column; gap: 6rpx; }
.fleet-member.selected { box-shadow: 0 0 0 2rpx rgba(46,107,230,.35); transform: translateY(-1rpx); }
.fleet-member-head { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.fleet-member-icon, .fleet-task-icon { display: flex; align-items: center; justify-content: center; border-radius: 11rpx; border: 1rpx solid transparent; }
.fleet-member-icon { position: relative; flex: none; width: 36rpx; height: 36rpx; font-size: 20rpx; }
/* memberBoard / 任务卡共用的头像图标。这个 class 之前没有任何尺寸规则，
   微信 <image> 默认 320x240，会把 36rpx 的方框撑爆。按设计稿取方框的 ~55%。 */
.fleet-member-ic { width: 20rpx; height: 20rpx; flex: none; }
.fleet-member-name { flex: 1; min-width: 0; font-size: 24rpx; font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fleet-member-role { flex: none; padding: 2rpx 10rpx; border-radius: 8rpx; background: var(--surface); border: 1rpx solid var(--divider); font-size: 19rpx; color: var(--text-2); }
.fleet-member-status { display: flex; align-items: baseline; gap: 10rpx; font-size: 21rpx; color: var(--text-2); }
.fleet-member-model { font-size: 19rpx; color: var(--text-4); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fleet-member-error { font-size: 20rpx; line-height: 1.4; color: #E5484D; overflow-wrap: anywhere; }
.fleet-member-meta { font-size: 19rpx; color: var(--text-3); font-variant-numeric: tabular-nums; }
.fleet-member-foot { display: flex; align-items: center; gap: 12rpx; margin-top: 2rpx; }
.fleet-member-tasks { flex: 1; font-size: 19rpx; color: var(--text-4); }
.fleet-member-tasks.on { color: var(--ocean); }
/* ---- 通讯面板（commsPanel / commsRow） ---- */
.fleet-comms-solo { margin-top: 4rpx; }
.fleet-comms-toolbar { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.fleet-comms-btn { padding: 2rpx 16rpx; border-radius: 999rpx; background: var(--surface); border: 1rpx solid var(--border); color: var(--ocean); font-size: 21rpx; }
.fleet-comms-chip { padding: 2rpx 16rpx; border-radius: 999rpx; background: var(--fill); font-size: 21rpx; color: var(--text-2); }
.fleet-comms-chip.stale { background: rgba(245,158,11,.12); color: var(--amber); }
.fleet-comms-filters { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 10rpx; }
.fleet-comms-lane { max-height: 960rpx; overflow-y: auto; }
.fleet-comms-row { position: relative; padding: 10rpx 4rpx 10rpx 20rpx; border-bottom: 1rpx dashed var(--divider); }
.fleet-comms-row::before { content: ''; position: absolute; left: 0; top: 8rpx; bottom: 8rpx; width: 4rpx; border-radius: 2rpx; opacity: .55; }
.fleet-comms-k-relay::before { background: var(--ocean); }
.fleet-comms-k-mailbox::before { background: #AD46FF; }
.fleet-comms-k-settled::before { background: var(--success); }
.fleet-comms-line { display: flex; align-items: baseline; gap: 10rpx; font-size: 21rpx; }
.fleet-comms-time { flex: none; color: var(--text-4); font-variant-numeric: tabular-nums; }
.fleet-comms-kind { flex: none; padding: 0 8rpx; border-radius: 6rpx; background: var(--fill-2); font-size: 18rpx; color: var(--text-2); }
.fleet-comms-route { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8rpx; overflow: hidden; color: var(--ocean); font-weight: 600; }
.fleet-comms-party { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fleet-comms-arrow { position: relative; flex: none; width: 28rpx; height: 20rpx; }
.fleet-comms-arrow-shaft { position: absolute; left: 1rpx; top: 9rpx; width: 19rpx; border-top: 2rpx solid var(--text-4); }
.fleet-comms-arrow::after { content: ''; position: absolute; top: 4rpx; right: 1rpx; width: 0; height: 0; border-top: 6rpx solid transparent; border-bottom: 6rpx solid transparent; border-left: 7rpx solid var(--text-4); }
.fleet-comms-text { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; margin-top: 4rpx; font-size: 21rpx; line-height: 1.5; color: var(--text-2); white-space: pre-wrap; overflow-wrap: anywhere; }
/* ---- 命令执行卡（commandPanel / commandPanel.css） ---- */
.ctx-cmd-kpi { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; margin-bottom: 10rpx; }
.ctx-cmd-kpi-item { display: flex; flex-direction: column; gap: 2rpx; padding: 8rpx 12rpx; border-radius: 12rpx; background: var(--fill); }
.ctx-cmd-kpi-value { font-size: 26rpx; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }
.ctx-cmd-kpi-label { font-size: 18rpx; color: var(--text-3); }
.ctx-cmd-lane { max-height: 720rpx; overflow-y: auto; }
.ctx-cmd-row { border-top: 1rpx solid var(--divider); }
.ctx-cmd-row.on { border-radius: 12rpx; background: var(--fill); }
.ctx-cmd-line { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 6rpx; font-size: 22rpx; }
.ctx-cmd-status { flex: none; width: 28rpx; text-align: center; font-size: 24rpx; font-weight: 700; }
.ctx-cmd-ok { color: var(--success); }
.ctx-cmd-failed, .ctx-cmd-killed { color: #E5484D; }
.ctx-cmd-time { flex: none; font-size: 19rpx; color: var(--text-4); font-variant-numeric: tabular-nums; }
.ctx-cmd-tool { flex: none; padding: 0 8rpx; border-radius: 6rpx; background: var(--fill-2); font-size: 18rpx; color: var(--text-2); }
.ctx-cmd-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); }
.ctx-cmd-dur { flex: none; min-width: 72rpx; text-align: right; font-size: 20rpx; color: var(--text-2); font-variant-numeric: tabular-nums; }
.ctx-cmd-detail { padding: 4rpx 8rpx 14rpx; }
.ctx-cmd-desc { display: block; margin-bottom: 8rpx; font-size: 21rpx; line-height: 1.5; color: var(--text-2); }
.ctx-cmd-code { display: block; max-height: 320rpx; overflow: auto; padding: 12rpx 14rpx; border-radius: 10rpx; background: var(--fill-2); font-family: Menlo, Consolas, monospace; font-size: 20rpx; line-height: 1.5; color: var(--text); white-space: pre-wrap; overflow-wrap: anywhere; }
.ctx-cmd-facts { display: block; margin-top: 8rpx; font-size: 19rpx; color: var(--text-3); font-variant-numeric: tabular-nums; }
.ctx-cmd-actions { display: flex; gap: 12rpx; margin-top: 10rpx; }

/* Fleet cockpit polish: clearer hierarchy while preserving the mobile stack. */
.fleet-toolbar { padding: 16rpx 32rpx 8rpx; }
.fleet-toolbar-title { font-size: 32rpx; letter-spacing: .2rpx; }
.fleet-toolbar-meta { max-width: 360rpx; padding: 4rpx 12rpx; border: 1rpx solid var(--divider); border-radius: 999rpx; background: var(--fill); font-size: 20rpx; }
.fleet-scroll { padding: 12rpx 28rpx 0; }
.cf-fleet-section { display: flex; flex-direction: column; gap: 18rpx; padding-bottom: 8rpx; }
.cf-fleet-section > .ctx-card,
.cf-fleet-section > .fleet-card { margin-top: 0; }
.cf-fleet-section > .ctx-card { padding: 22rpx; border-radius: 24rpx; }
.fleet-summary { align-items: stretch; gap: 16rpx; background: linear-gradient(135deg, rgba(46,107,230,.08), var(--surface) 72%); }
.fleet-summary-chips { gap: 10rpx; }
.fleet-summary .fleet-chi { padding: 8rpx 14rpx; background: transparent; border-color: var(--divider); font-size: 21rpx; }mmary .fleet-chip:first-child { color: var(--text); font-weight: 650; }
.fleet-summary .fleet-chip.on { background: rgba(46,184,92,.08); }
.fleet-progress { flex-basis: 100%; min-width: 0; gap: 12rpx; padding: 12rpx 14rpx; border-radius: 14rpx; background: var(--fill); }
.fleet-progress-label { color: var(--text); font-weight: 600; }
.fleet-progress-track { flex: 1; min-width: 72rpx; width: auto; }
.fleet-graph-card .ctx-card-head { align-items: flex-start; gap: 8rpx 12rpx; margin-bottom: 18rpx; }
.fleet-graph-card .ctx-card-sub { flex: 0 0 100%; margin-left: 0; font-size: 21rpx; line-height: 1.45; white-space: normal; }
.fleet-chips { gap: 8rpx; margin-bottom: 14rpx; }
.fleet-chips .fleet-chip { padding: 6rpx 12rpx; font-size: 20rpx; }
.fleet-legend { gap: 10rpx 22rpx; margin-bottom: 16rpx; padding: 12rpx 14rpx; border-radius: 14rpx; background: transparent; font-size: 20rpx; }
.fleet-legend-swatch,
.fleet-legend-free { width: 18rpx; height: 18rpx; }
.fleet-legend-live { width: 26rpx; }
.fleet-stage { box-sizing: border-box; border: 1rpx solid var(--divider); border-radius: 18rpx; background: transparent; }
/* 网络卡片：只要边框——透明内容、无投影（投影会让透明卡片在白页面上像填充卡）；
   选中态的蓝色外环保留作状态反馈。 */
.fleet-node { border-radius: 18rpx; background: transparent; }
.fleet-node.self { border: 2rpx solid var(--ink); }
.fleet-node.running:not(.self) { border-color: rgba(46,184,92,.62); }
.fleet-node.selected { border-color: var(--ocean); box-shadow: 0 0 0 3rpx rgba(46,107,230,.22), 0 8rpx 22rpx rgba(7,24,43,.14); }
.fleet-node-open { width: 44rpx; height: 44rpx; line-height: 42rpx; background: transparent; border-color: var(--border); font-weight: 600; }
.fleet-members .ctx-card-head,
.fleet-comms .ctx-card-head { align-items: center; gap: 10rpx 14rpx; margin-bottom: 16rpx; }
.fleet-members .ctx-card-title,
.fleet-comms .ctx-card-title { font-size: 28rpx; }
.fleet-members .ctx-card-sub { margin-left: auto; padding: 4rpx 12rpx; border: 1rpx solid var(--divider); border-radius: 999rpx; background: var(--fill); font-size: 20rpx; }
.fleet-comms .ctx-card-sub { flex-basis: 100%; margin-left: 0; white-space: normal; line-height: 1.4; }
.fleet-member-toolbar { gap: 10rpx; margin-bottom: 16rpx; }
.fleet-member-toolbar .ctx-br-search { width: 100%; min-width: 0; height: 72rpx; flex: none; border-radius: 14rpx; background: transparent; }
.fleet-member-toolbar .ctx-gran { width: 100%; box-sizing: border-box; justify-content: space-between; padding: 4rpx; border-radius: 14rpx; }
.fleet-member-toolbar .ctx-gran-btn { flex: 1; min-width: 0; padding: 10rpx 4rpx; text-align: center; white-space: nowrap; font-size: 20rpx; }
.fleet-member-groups { display: flex; flex-direction: column; gap: 24rpx; }
.fleet-member-group { min-width: 0; }
.fleet-member-group-head { display: flex; align-items: baseline; gap: 14rpx; margin-bottom: 12rpx; padding: 0 2rpx 10rpx; border-bottom: 1rpx dashed var(--divider); color: var(--text-2); font-size: 22rpx; font-weight: 650; }
.fleet-member-group-count { color: var(--text-4); font-size: 20rpx; font-variant-numeric: tabular-nums; }
.fleet-member-list { display: flex; flex-direction: column; gap: 12rpx; }
.fleet-member-sort { position: relative; z-index: 1; width: 100%; flex: none; min-width: 180rpx; box-sizing: border-box; border: 1rpx solid var(--border); border-radius: 14rpx; background: transparent; }
.fleet-member-sort.open { z-index: 20; }
.fleet-member-sort-inner { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 68rpx; padding: 0 20rpx; color: var(--text-2); font-size: 21rpx; }
.fleet-member-sort-arrow { color: var(--text-3); font-size: 30rpx; line-height: 1; }
.fleet-sort-menu { position: absolute; top: calc(100% + 8rpx); right: 0; z-index: 21; width: 100%; min-width: 240rpx; box-sizing: border-box; overflow: hidden; border: 1rpx solid var(--border); border-radius: 16rpx; background: var(--surface); box-shadow: 0 14rpx 36rpx rgba(0, 0, 0, .18); }
.fleet-sort-option { min-height: 72rpx; box-sizing: border-box; display: flex; align-items: center; gap: 16rpx; padding: 0 18rpx; border-top: 1rpx solid var(--divider); color: var(--text-2); font-size: 23rpx; }
.fleet-sort-option:first-child { border-top: 0; }
.fleet-sort-option.selected { border-radius: 14rpx; background: rgba(46, 107, 230, .08); color: var(--ocean); font-weight: 600; }
.fleet-sort-option-check { margin-left: auto; font-size: 28rpx; font-weight: 700; }
/* 成员行：透明内容 + 完整边框（与网络卡片一致）；顶部 4rpx 保留各成员色相（wxml 内联 border-top-color） */
.fleet-member { gap: 8rpx; padding: 18rpx 18rpx 16rpx; border-radius: 18rpx; background: transparent; border: 1rpx solid var(--border); border-top-width: 4rpx; transition: box-shadow .18s ease, border-color .18s ease, transform .18s ease; }
.fleet-member.selected { box-shadow: 0 0 0 3rpx rgba(46,107,230,.24), 0 6rpx 18rpx rgba(7,24,43,.08); transform: translateY(-1rpx); }
.fleet-member-head { gap: 10rpx; }
.fleet-member-icon { width: 44rpx; height: 44rpx; border-radius: 14rpx; }
.fleet-member-ic { width: 24rpx; height: 24rpx; }
.fleet-member-name { font-size: 25rpx; }
.fleet-member-role { padding: 4rpx 12rpx; border-radius: 999rpx; }
.fleet-member-status { gap: 12rpx; font-size: 22rpx; }
.fleet-member-model { min-width: 0; flex: 1; text-align: right; }
.fleet-member-meta { font-size: 20rpx; }
.fleet-member-answer { display: flex; align-items: baseline; gap: 8rpx; min-width: 0; color: var(--text-3); font-size: 20rpx; line-height: 1.35; }
.fleet-member-answer-label { flex: none; color: var(--text-4); }
.fleet-member-answer-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-style: italic; }
.fleet-member-foot { min-height: 52rpx; margin-top: 2rpx; padding-top: 8rpx; border-top: 1rpx solid var(--divider); }
.fleet-member-tasks { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 12rpx; border-radius: 999rpx; background: transparent; }
.fleet-member-tasks.on { background: rgba(46,107,230,.08); }
.fleet-comms-toolbar { flex-wrap: wrap; gap: 10rpx; margin-bottom: 14rpx; }
.fleet-comms-btn,
.fleet-comms-chip { min-height: 48rpx; box-sizing: border-box; display: inline-flex; align-items: center; padding: 4rpx 16rpx; border-radius: 999rpx; }
.fleet-comms-btn { font-weight: 600; }
.fleet-comms-lane { max-height: 800rpx; padding: 0 4rpx; }
.fleet-comms-row { padding: 14rpx 8rpx 14rpx 22rpx; }
.fleet-comms-line { flex-wrap: wrap; gap: 6rpx 10rpx; }
.fleet-comms-route { flex-basis: 100%; }
.fleet-comms-text { margin-top: 8rpx; font-size: 22rpx; }
.fleet-task-card { padding: 22rpx; border-radius: 24rpx; }
.fleet-task-card .ctx-card-head { align-items: center; margin-bottom: 12rpx; }
.fleet-task-search{width:100%;background:transparent;}
.fleet-task-gran{margin:14rpx 0 16rpx;}
.fleet-task-icon { position: relative; flex: none; width: 36rpx; height: 36rpx; margin-top: 2rpx; }
.fleet-task-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.fleet-task-line { display: flex; align-items: baseline; gap: 10rpx; min-width: 0; }
.fleet-task-line .fleet-task-subject { flex: 1; min-width: 0; }
.fleet-task-line .fleet-task-status { flex: none; }
.fleet-task-body { font-size: 23rpx; line-height: 1.5; color: var(--text-3); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.fleet-task-foot { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.fleet-task-meta { font-size: 22rpx; color: var(--text-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
.fleet-task-row { display: flex; align-items: flex-start; gap: 10rpx; padding: 12rpx 10rpx; border: 1rpx solid var(--divider); border-radius: 14rpx; background: transparent; }
.fleet-task-row + .fleet-task-row { margin-top: 8rpx; }
.fleet-task-status { padding: 2rpx 10rpx; border-radius: 999rpx; font-size: 19rpx; }
.fleet-task-subject { white-space: normal; line-height: 1.4; overflow-wrap: anywhere; }
.fleet-task-owner { max-width: 140rpx; padding-left: 8rpx; }
.fleet-task-empty { padding: 24rpx 12rpx; border-radius: 14rpx; background: transparent; }
@media (min-width: 620px) {
  .fleet-member-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .fleet-member-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; }
  .fleet-member-toolbar .ctx-br-search { width: auto; flex: 1 1 100%; }
  .fleet-member-toolbar .ctx-gran { width: auto; flex: 1 1 0; }
}
@media (max-width: 350px) {
  .fleet-scroll { padding-left: 20rpx; padding-right: 20rpx; }
  .fleet-summary .fleet-chip { padding-right: 10rpx; padding-left: 10rpx; font-size: 19rpx; }
  .fleet-member-toolbar .ctx-gran-btn { font-size: 18rpx; }
}
@media (prefers-reduced-motion: reduce) {
  .fleet-state-dot.on { animation: none; }
  .fleet-member { transition: none; }
}
/* Wide Fleet panes mirror DSH's cockpit: network left, member/task boards right, comms below at full width. */
@media (min-width: 860px) {
  .fleet-summary { align-items: center; }
  .fleet-progress { flex-basis: auto; min-width: 320rpx; margin-left: auto; }
  .fleet-workspace { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); align-items: stretch; gap: 18rpx; }
  .fleet-graph-card { display: flex; flex-direction: column; min-width: 0; }
  .fleet-stage { flex: 1 1 auto; height: 0; min-height: 320rpx; max-height: none; }
  .fleet-stage.all { height: auto; }
  .fleet-board-column { display: flex; flex-direction: column; gap: 18rpx; min-width: 0; }
  .fleet-board-column > .ctx-card,
  .fleet-board-column > .fleet-card { margin-top: 0; }
  .fleet-member-toolbar { display: grid; grid-template-columns: minmax(160rpx, 1fr) minmax(300rpx, auto) auto; align-items: center; }
  .fleet-member-toolbar .ctx-br-search { width: 100%; min-width: 0; }
  .fleet-member-toolbar .ctx-gran { width: auto; min-width: 0; }
  .fleet-member-toolbar .fleet-member-sort { width: auto; min-width: 240rpx; }
  .fleet-task-card { display: grid; grid-template-columns: minmax(160rpx, 1fr) auto; align-items: center; max-height: 1120rpx; overflow: hidden; }
  .fleet-task-card .ctx-card-head,
  .fleet-task-list { grid-column: 1 / -1; }
  .fleet-task-search { width: 100%; min-width: 0; box-sizing: border-box; }
  .fleet-task-gran { margin: 0 0 0 12rpx; }
  .fleet-task-list { min-height: 0; overflow-y: auto; }
  .fleet-comms { display: flex; flex-direction: column; max-height: 960rpx; overflow: hidden; }
  .fleet-comms-lane { flex: 1 1 auto; min-height: 0; max-height: none; overflow-y: auto; }
}
.fleet-node-state,
.fleet-member-dot,
.fleet-task-dot { position: relative; display: inline-block; flex: none; width: 18rpx; height: 18rpx; box-sizing: border-box; border-radius: 50%; background: transparent; }
.fleet-node-state { margin-top: 5rpx; }
.fleet-member-dot { margin-left: 2rpx; }
.fleet-node-state::after,
.fleet-member-dot::after,
.fleet-task-dot::after { content: ''; position: absolute; inset: 20%; border-radius: 50%; background: var(--text-4); }
.fleet-node-state.done::after,
.fleet-member-dot.done::after,
.fleet-task-dot.done::after { background: var(--success); }
.fleet-node-state.idle::after,
.fleet-member-dot.idle::after,
.fleet-task-dot.idle::after { background: var(--text-4); }
.fleet-node-state.failed::after,
.fleet-member-dot.failed::after,
.fleet-task-dot.failed::after { background: #c44848; }
.fleet-member-dot.warning::after,
.fleet-task-dot.warning::after { background: #e07a1f; }
.fleet-node-state.running,
.fleet-member-dot.running,
.fleet-task-dot.running { border: 0; background: transparent; animation: none; }
.fleet-node-state.running::before,
.fleet-member-dot.running::before,
.fleet-task-dot.running::before { content: ''; position: absolute; inset: 0; border: 1rpx solid var(--text-3); border-radius: 50%; opacity: .25; }
.fleet-node-state.running::after,
.fleet-member-dot.running::after,
.fleet-task-dot.running::after { inset: 0; border: 1rpx solid transparent; border-top-color: var(--text-3); border-radius: 50%; background: transparent; animation: fleet-spin 1.5s linear infinite; }
.fleet-member-dot.done,
.fleet-task-dot.done { background: transparent; }
.fleet-task-icon { width: 44rpx; height: 44rpx; margin-top: 0; }
.fleet-task-row { align-items: flex-start; }
.fleet-task-main { min-width: 0; }
.fleet-task-line { align-items: flex-start; }
.fleet-task-subject { font-size: 24rpx; font-weight: 600; }
.fleet-task-foot { margin-top: 2rpx; }
.fleet-comms-lane { max-height: 960rpx; }
.fleet-comms-route { flex: 1; min-width: 120rpx; flex-basis: auto; }
.fleet-comms-text { margin-top: 4rpx; }
/* Keep the Agent Network panel outline; remove the nested stage frame so the graph shares that panel. */
.ctx-card.fleet-graph-card { background: transparent; border: 1rpx solid var(--border); box-shadow: none; }
.fleet-graph-card .fleet-stage { border: 0; border-radius: 0; background: transparent; }

/* 边输入边渲染：检测到 Markdown 后输入文字变透明，渲染层垫在原位实时刷新。
   键盘不收起、焦点不丢，继续打字仍然进输入框，渲染跟着变。 */

/* 同面渲染：渲染层与输入层字体度量完全一致（28rpx / 42rpx 行盒 / 相同内边距），
   文字原地替换；渲染层在文档流里决定高度，透明输入层 absolute 覆盖接收键入。 */
.composer-input-row.live { position: relative; display: block; }
.composer-input-row.live.previewing { min-height: 76rpx; max-height: 60vh; }
.composer-live .composer-veil { display: none; }
.composer-live .composer-veil.on {
  display: block; position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 6;
  background: var(--surface); overflow-y: auto;
  font-size: 28rpx; line-height: 1.4; color: var(--text);
  padding: 2rpx 4rpx; box-sizing: border-box;
}
.composer-veil-inner { font-size: 28rpx; line-height: 1.4; color: var(--text); overflow-wrap: anywhere; }
.composer-veil-end { height: 10rpx; }

/* 实时渲染时的笔形回编按钮：挂在输入区右上角，点一下回原文编辑。 */
/* 笔形按钮放在渲染区内部右上角：放在行外会被滚动内容盖住（用户反馈"看不到"）。 */
.composer-live-edit { position: absolute; right: 10rpx; top: 8rpx; z-index: 3; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: var(--surface); border: 1rpx solid var(--divider); box-shadow: 0 2rpx 8rpx rgba(7, 24, 43, .12); }
.composer-live-edit-ic { width: 26rpx; height: 26rpx; opacity: .85; }

/* 同面渲染：渲染结果字号与输入框正文完全一致（28rpx / 1.4）。 */
.composer-veil-inner, .composer-veil-inner rich-text { font-size: 28rpx; line-height: 1.4; }
.composer-veil-inner .md-block { margin: 0; }
.composer-veil-inner .md-list { margin: 0; }
.composer-veil-inner .md-li { font-size: 28rpx; line-height: 1.4; }
.composer-veil-inner .md-para,
.composer-veil-inner .md-li-text,
.composer-veil-inner .md-h1, .composer-veil-inner .md-h2,
.composer-veil-inner .md-h3, .composer-veil-inner .md-h4,
.composer-veil-inner .md-h5, .composer-veil-inner .md-h6,
.composer-veil-inner .md-heading { font-size: 28rpx; line-height: 1.4; margin: 0; }
