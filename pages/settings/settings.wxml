<page-meta page-style="{{pageStyle}}" />
<view class="page settings {{themeClass}}">
  <!-- 外观模式（对齐 dsh-mobile v1.6.0 InterfaceStyleSettingsRow） -->
  <view class="group-title">外观</view>
  <view class="card">
    <view class="card-row" bindtap="pickAppearance">
      <text class="card-row-label">界面</text>
      <view class="card-row-value">
        <text>{{appearanceLabel}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
  </view>

  <view class="group-title">新会话默认配置</view>
  <view class="card">
    <view class="card-row" bindtap="pickAgentPreset">
      <text class="card-row-label">Agent 预设</text>
      <view class="card-row-value">
        <text>{{presetLabel}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
    <view class="card-row" bindtap="pickDefaultModel">
      <text class="card-row-label">默认模型</text>
      <view class="card-row-value">
        <text>{{modelLabel}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
    <view class="card-row" bindtap="pickDefaultPermission">
      <text class="card-row-label">权限</text>
      <view class="card-row-value">
        <text>{{permissionLabel}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
  </view>
  <view class="group-hint">与 WebUI 使用同一份部署级设置。修改只影响之后新建的会话，运行中的会话保持启动时的配置。</view>

  <view class="group-title node-group-title">
    <text>公网节点</text>
    <view class="node-count" bindtap="refreshNodes" hover-class="node-count-active">
      <text>{{onlineNodeCount}} 在线 · {{nodeCount}} 个节点</text>
      <image class="chevron-img" src="/assets/icons/refresh-blue.png"/>
    </view>
  </view>
  <view class="card node-list-card">
    <view wx:if="{{!nodes.length}}" class="node-empty">
      <text class="node-empty-title">还没有已配对节点</text>
      <text class="node-empty-desc">连接插件生成的公网配对二维码或配对信息。</text>
    </view>
    <view wx:for="{{nodes}}" wx:key="id" class="node-row {{item.active ? 'node-row-active' : ''}}" data-id="{{item.id}}" bindtap="selectNode">
      <view class="node-main">
        <view class="node-name-line">
          <view class="status-dot {{item.online ? 'connected' : 'disconnected'}}"></view>
          <text class="node-name">{{item.name}}</text>
          <text wx:if="{{item.active}}" class="node-current">当前</text>
        </view>
        <text class="node-id text-mono">{{item.gatewayId || item.id}}</text>
      </view>
      <view class="node-actions">
        <text class="node-status">{{item.statusLabel}}</text>
        <text class="node-copy" data-id="{{item.gatewayId || item.id}}" catchtap="copyNodeId">复制 ID</text>
      </view>
    </view>
    <view class="node-add-row" bindtap="addPublicNode" hover-class="node-add-active">
      <text class="node-add-mark">+</text>
      <text class="node-add-label">添加公网节点</text>
      <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
    </view>
  </view>
  <view class="group-hint">节点 ID 仅用于识别设备，不是访问凭证。分享有效期须由插件/中继签发并校验；当前插件生成的中继配对载荷尚未包含邀请过期字段。</view>

  <view class="group-title">Mobile Gateway</view>
  <view class="card">
    <view class="card-row">
      <text class="card-row-label gw-url text-mono">{{endpoint || '未配置'}}</text>
    </view>
    <view class="card-row">
      <view class="card-row-label gw-status">
        <view class="status-dot {{connectionClass}}"></view>
        <text>{{connectionLabel}}</text>
      </view>
      <view class="card-row-value">
        <text wx:if="{{port}}">Port {{port}}</text>
      </view>
    </view>
    <view class="card-row" bindtap="disconnect">
      <text class="btn-text">断开连接</text>
    </view>
    <view class="card-row" bindtap="pingGateway">
      <text class="btn-text">Ping 网关</text>
    </view>
    <view class="card-row" bindtap="forgetDevice">
      <text class="btn-text-danger">忘记此设备</text>
    </view>
  </view>

  <view class="group-title">DSH Host</view>
  <view class="card">
    <view class="card-row">
      <text class="card-row-label">预览包</text>
      <text class="card-row-value">{{buildLabel}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">版本</text>
      <text class="card-row-value">{{host.version || '—'}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">Provider</text>
      <text class="card-row-value">{{host.provider || '—'}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">Model</text>
      <text class="card-row-value">{{host.model || '—'}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">已连接会话</text>
      <text class="card-row-value">{{host.attachedSessions !== undefined ? host.attachedSessions : '—'}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">工作目录</text>
      <text class="card-row-value text-mono gw-cwd">{{host.cwd || '—'}}</text>
    </view>
  </view>

  <view class="group-title">实验性功能</view>
  <view class="card">
    <view class="card-row">
      <view class="exp-copy">
        <text class="card-row-label">订阅通知</text>
        <text class="exp-desc">发送任务后申请订阅消息授权，回合完成时通过服务通知提醒</text>
      </view>
      <switch checked="{{notifyEnabled}}" color="#2E6BE6" bindchange="toggleNotify"/>
    </view>
  </view>
  <view class="group-hint">实验性功能默认关闭，可能随基础库版本变化不稳定，仅供试用。</view>

  <view class="group-title">关于</view>
  <view class="card">
    <view class="card-row">
      <text class="card-row-label">客户端</text>
      <text class="card-row-value">驭鲸 Harness 小程序版</text>
    </view>
    <view class="card-row" bindtap="openPrivacyPolicy">
      <text class="card-row-label">隐私政策</text>
      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
    <view class="card-row" bindtap="openFiles">
      <text class="card-row-label">工作区文件</text>
      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
  </view>

  <view wx:if="{{pairSheetOpen}}" class="pair-sheet-mask" catchtap="closePairSheet">
    <view class="pair-sheet" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">添加公网节点</text>
          <text class="pair-sheet-subtitle">粘贴插件提供的 Base64URL 配对信息</text>
        </view>
        <text class="pair-sheet-close" bindtap="closePairSheet">关闭</text>
      </view>
      <textarea
        class="pair-payload-input"
        value="{{pairingText}}"
        maxlength="20000"
        auto-height="false"
        placeholder="粘贴完整配对字符串"
        placeholder-class="pair-payload-placeholder"
        bindinput="onPairingInput"
        disabled="{{pairingConnecting}}"
      />
      <text wx:if="{{pairingError}}" class="pair-result {{pairingConnecting ? 'pair-result-pending' : ''}}">{{pairingError}}</text>
      <view class="pair-submit {{!pairingText || pairingConnecting ? 'pair-submit-disabled' : ''}}" bindtap="connectPublicNode">
        <text>{{pairingConnecting ? '连接中…' : '连接节点'}}</text>
      </view>
    </view>
  </view>
</view>
