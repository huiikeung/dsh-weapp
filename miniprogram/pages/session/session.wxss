@import "../../styles/status-appearance.wxss";
@import "../../styles/trajectory.wxss";
@import "../../styles/proc-icon.wxss";
.session {
display: flex;
flex-direction: column;
height: 100vh;
overflow: hidden;
}
.session-panel-hidden { display: none !important; }
.navbar {
display: flex;
align-items: center;
padding: 8rpx 24rpx;
flex-shrink: 0;
}
.nav-back {
width: 64rpx;
height: 64rpx;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
flex-shrink: 0;
margin-right: 16rpx;
background: #FFFFFF;
border: 1rpx solid rgba(0, 0, 0, 0.08);
box-shadow: 0 4rpx 14rpx rgba(7, 24, 43, 0.06);
}
.session.theme-dark .nav-back {
background: rgba(255, 255, 255, 0.10);
border-color: rgba(255, 255, 255, 0.12);
box-shadow: none;
}
.nav-back-ic {
width: 32rpx;
height: 32rpx;
}
.press-dim {
opacity: 0.65;
}
.nav-more {
width: 64rpx;
height: 64rpx;
margin-left: 12rpx;
flex-shrink: 0;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
font-size: 36rpx;
color: var(--ink);
background: rgba(255, 255, 255, 0.9);
box-shadow: 0 4rpx 16rpx rgba(7, 24, 43, 0.08);
flex-shrink: 0;
}
.nav-title {
flex: 1;
margin: 0 20rpx;
overflow: hidden;
white-space: nowrap;
}
.nav-title-inner {
display: inline-block;
max-width: 100%;
overflow: hidden;
text-overflow: ellipsis;
white-space: nowrap;
font-size: 27rpx;
font-weight: 600;
color: var(--ink);
vertical-align: middle;
}
.nav-preset {
display: flex;
align-items: center;
font-size: 26rpx;
color: var(--gray);
margin-right: 16rpx;
flex-shrink: 0;
}
.segmented-row {
display: flex;
align-items: center;
gap: 16rpx;
padding: 10rpx 40rpx 12rpx;
flex-shrink: 0;
}
.segmented {
display: flex;
flex: 1;
min-width: 0;
border-radius: 28rpx;
padding: 3rpx;
background: var(--fill-2);
}
.segment {
flex: 1;
text-align: center;
padding: 10rpx 0;
border-radius: 25rpx;
font-size: 24rpx;
color: var(--text-2);
}
.segment.active {
background: var(--segment-active-bg);
color: var(--segment-active-text);
font-weight: 600;
}
.collab-trigger { display:flex;align-items:center;justify-content:center;gap:8rpx;min-height:88rpx;max-width:190rpx;flex-shrink:0;font-size:24rpx;color:var(--text-2);position:relative; }
.collab-trigger.selected { color:var(--ink); }
.collab-icon { width:30rpx;height:30rpx;flex-shrink:0; }
.collab-count { min-width:24rpx;font-size:22rpx;text-align:center;max-width:56rpx;overflow:hidden;text-overflow:ellipsis; }
.collab-active-dot { width:10rpx;height:10rpx;border-radius:50%;background:#358A68;flex-shrink:0; }
.collab-mask { z-index:120; }
.sheet.collab-sheet { display:flex;flex-direction:column;height:76vh;max-height:90vh;padding:0 0 env(safe-area-inset-bottom);background:var(--surface);color:var(--ink);transition:height 220ms ease; }
.sheet.collab-sheet.is-expanded { height:90vh; }
.collab-resize-handle { display:flex;align-items:center;justify-content:center;align-self:center;width:180rpx;min-height:40rpx;padding:4rpx 0;flex-shrink:0; }
.collab-resize-handle .sheet-handle { height:8rpx;margin:0;flex-shrink:0; }
@media (prefers-reduced-motion:reduce) { .sheet.collab-sheet { transition:none; } }
.collab-heading { display:flex;align-items:center;gap:0;padding:0 20rpx 32rpx 32rpx;flex-shrink:0; }
.collab-title { flex:1;min-width:0;font-size:34rpx;font-weight:600; }
.collab-action { width:88rpx;height:88rpx;min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.collab-action-disc { width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--fill); }
.collab-action-icon { width:34rpx;height:34rpx;display:block; }
.collab-breathe { position:relative;width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center; }
.collab-breathe-dot { width:16rpx;height:16rpx;border-radius:50%;background:var(--success);animation:collab-breathe-dot 2.4s ease-in-out infinite; }
.collab-breathe-halo { position:absolute;width:16rpx;height:16rpx;border-radius:50%;background:var(--success);opacity:0;animation:collab-breathe-halo 2.4s ease-out infinite; }
.collab-refresh.offline .collab-breathe-dot,.collab-refresh.offline .collab-breathe-halo { background:var(--text-4); }
.collab-refresh.is-idle .collab-breathe-dot { background:var(--text-4);animation:none; }
.collab-refresh.is-idle .collab-breathe-halo { opacity:0;animation:none; }
.collab-refresh.busy { opacity:.55; }
.collab-refresh.busy.is-running .collab-breathe-dot,.collab-refresh.busy.is-running .collab-breathe-halo { animation-duration:.9s; }
@keyframes collab-breathe-dot { 0%,100%{transform:scale(.78);opacity:.72} 50%{transform:scale(1);opacity:1} }
@keyframes collab-breathe-halo { 0%{transform:scale(.7);opacity:.45} 70%,100%{transform:scale(2);opacity:0} }
.collab-tabs { margin:0;flex-shrink:0;border-bottom:1rpx solid var(--divider); white-space:nowrap; overflow:hidden; }
.collab-tabs-track { display:flex; gap:0; align-items:stretch; width:max-content; padding:0 28rpx; box-sizing:border-box; }
.collab-tab { position:relative;display:flex;flex:0 0 calc((750rpx - 56rpx) / 4);min-width:0;min-height:44px;box-sizing:border-box;padding:12rpx 4rpx 20rpx;align-items:center;justify-content:center;flex-direction:column;gap:10rpx;font-size:24rpx;line-height:1.4;color:var(--text-2); }
.collab-tab.active { color:var(--ink);font-weight:600; }
.collab-tab-summary { display:flex;align-items:center;justify-content:center;gap:10rpx;max-width:100%;height:34rpx; }
.collab-tab-icon { width:32rpx;height:32rpx;flex-shrink:0; }
.collab-tab.active .collab-tab-icon { filter:brightness(0); }
.theme-dark .collab-tab.active .collab-tab-icon { filter:brightness(0) invert(.95); }
.collab-tab-count { min-width:24rpx;max-width:70rpx;box-sizing:border-box;padding:0 8rpx;border-radius:8rpx;background:var(--fill);font-size:20rpx;font-weight:500;line-height:30rpx;text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.collab-tab.active .collab-tab-count { background:var(--fill-2); }
.collab-tab-label { max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.collab-tab-indicator { position:absolute;bottom:-1rpx;left:50%;width:32rpx;height:4rpx;border-radius:4rpx;background:var(--ink);transform:translateX(-50%);opacity:0;transition:opacity 150ms ease; }
.collab-tab.active .collab-tab-indicator { opacity:1; }
@media (prefers-reduced-motion:reduce) { .collab-breathe-dot,.collab-breathe-halo { animation:none; }.collab-breathe-halo{opacity:0}.collab-tab-indicator { transition:none; } }
.collab-scroll { flex:1;height:0;min-height:0; }
.collab-list,.collab-preview { padding:28rpx 28rpx 48rpx; }
.collab-note { font-size:23rpx;line-height:1.6;color:var(--text-2);margin:12rpx 4rpx 28rpx;overflow-wrap:anywhere; }
.collab-row { display:flex;align-items:center;gap:20rpx;padding:28rpx 22rpx;min-height:104rpx;box-sizing:border-box;border:1rpx solid var(--border);border-radius:22rpx;margin-bottom:24rpx;background:var(--surface); }
.collab-row.current { background:var(--fill-2); }
.collab-row-copy { flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx; }
.collab-row-title { font-size:27rpx;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.collab-subtitle { font-size:23rpx;color:var(--text-2);line-height:1.5;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow-wrap:anywhere; }
.collab-row-meta { display:flex;flex-direction:column;gap:6rpx;align-items:flex-end;max-width:140rpx;flex-shrink:0; }
.collab-status,.collab-current { font-size:22rpx;color:var(--text-2); }
.collab-state { width:12rpx;height:12rpx;border-radius:50%;background:var(--text-2);opacity:.7;flex-shrink:0; }
.collab-state.running,.collab-state.done { background:#358A68;opacity:1; }
.collab-state.failed { background:#E5484D;opacity:1; }
.collab-state.pending { background:#C28220;opacity:1; }
.collab-status.running { color:#287750; }.collab-status.failed,.collab-error { color:#C53E48; }
.collab-error { font-size:23rpx;line-height:1.5;overflow-wrap:anywhere; }
.collab-chevron { width:10rpx;height:10rpx;border-top:2rpx solid var(--text-2);border-right:2rpx solid var(--text-2);transform:rotate(45deg);flex-shrink:0; }
.collab-empty { padding:60rpx 20rpx;text-align:center;color:var(--text-2);font-size:26rpx; }
.collab-back { min-height:88rpx;display:flex;align-items:center;color:var(--text-2);font-size:26rpx; }
.collab-preview-title { font-size:30rpx;font-weight:600;overflow-wrap:anywhere;margin-bottom:16rpx; }
.collab-message { padding:32rpx 0;border-bottom:1rpx solid var(--border); }
.collab-section-label { display:block;font-size:23rpx;color:var(--text-2);margin:16rpx 0; }
.collab-message-text { display:block;font-size:27rpx;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere; }
.collab-task-meta { margin:24rpx 0;color:var(--text-2);font-size:24rpx; }
.theme-dark .collab-status.failed,.theme-dark .collab-error { color:#FF7178; }
.theme-dark .collab-status.running { color:#73C7A0; }
@media (max-width:350px) { .segmented-row { padding-left:24rpx;padding-right:24rpx;gap:12rpx; }.collab-trigger { gap:6rpx; }.collab-tab { font-size:22rpx; } }
.conversation::-webkit-scrollbar,
.trajectory::-webkit-scrollbar {
width: 0;
height: 0;
display: none;
}
.conversation,
.trajectory {
scrollbar-width: none;
-ms-overflow-style: none;
}
.conversation,
.trajectory {
flex: 1;
min-height: 0;
box-sizing: border-box;
padding: 16rpx 40rpx 0;
}
.conversation-inner {
display: flex;
flex-direction: column;
}
.conversation-inner.has-rows {
box-sizing: border-box;
justify-content: flex-end;
}
.conversation-inner > view { flex-shrink: 0; }
.conversation { height: 0; overflow: hidden; }
.conversation,
.trajectory {
padding-bottom: 330rpx;
}
.task-panel,
.goal-panel,
.command-menu {
position: relative;
z-index: 2;
margin: 0 0 12rpx;
border: 1rpx solid var(--border-strong);
background: var(--surface);
box-shadow: 0 8rpx 24rpx rgba(7, 24, 43, 0.08);
}
.task-panel,
.goal-panel {
border-radius: 36rpx;
}
.task-head {
min-height: 88rpx;
padding: 0 28rpx;
display: flex;
align-items: center;
gap: 16rpx;
}
.task-head-ic, .goal-ic { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.task-head-title, .goal-phase { font-size: 29rpx; font-weight: 650; color: var(--text); }
.task-summary { font-size: 25rpx; color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.task-chev { width: 26rpx; height: 26rpx; transition: transform .18s ease; }
.task-chev.open { transform: rotate(180deg); }
.task-list { padding: 0 28rpx 24rpx; }
.task-row { display: flex; align-items: flex-start; gap: 18rpx; padding: 10rpx 0; }
.task-status-ic { width: 32rpx; height: 32rpx; margin-top: 3rpx; flex-shrink: 0; }
.task-status-ic.spin, .goal-spinner { animation: state-spin .9s linear infinite; }
.task-content { font-size: 29rpx; line-height: 1.45; color: var(--text); }
.task-row.completed .task-content { color: var(--text-2); }
.goal-panel { min-height: 92rpx; padding: 0 24rpx 0 28rpx; display: flex; align-items: center; gap: 16rpx; }
.goal-main { display: flex; min-width: 0; flex: 1; align-items: baseline; gap: 16rpx; }
.goal-phase { flex-shrink: 0; }
.goal-objective { min-width: 0; font-size: 28rpx; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goal-action { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.goal-action-ic { width: 36rpx; height: 36rpx; }
.goal-spinner { width: 30rpx; height: 30rpx; border: 4rpx solid rgba(46,107,230,.18); border-top-color: #2E6BE6; border-radius: 50%; }
.command-menu-mask{position:fixed;inset:0;z-index:30;background:transparent}
.command-menu{z-index:31;border-radius:12px;border-color:var(--border);padding:4px;box-sizing:border-box;overflow:hidden;max-height:52vh;display:flex;flex-direction:column}
.file-mention-menu{position:relative;z-index:32;margin:0 12rpx 14rpx;border:1rpx solid var(--border-strong);border-radius:24rpx;background:var(--surface);box-shadow:0 12rpx 36rpx rgba(7,24,43,.18);overflow:hidden;max-height:54vh;display:flex;flex-direction:column}
.file-mention-head{min-height:76rpx;padding:16rpx 20rpx 12rpx 26rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx;border-bottom:1rpx solid var(--divider);flex-shrink:0}
.file-mention-heading{min-width:0;display:flex;flex-direction:column;gap:3rpx}
.file-mention-title{font-size:25rpx;font-weight:550;line-height:1.35;color:var(--text-2)}
.file-mention-path{min-width:0;font-size:21rpx;line-height:1.3;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.file-mention-close{width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:14rpx}
.file-mention-close:active{background:var(--fill-2)}
.file-mention-close .sheet-close-x{width:38rpx;height:38rpx}
.file-mention-scroll{min-height:0;max-height:calc(54vh - 78rpx);padding:6rpx 10rpx 0;box-sizing:border-box}
.file-mention-bottom-space{height:180rpx;flex-shrink:0}
.file-mention-row{min-height:78rpx;padding:8rpx 14rpx;display:flex;align-items:center;gap:18rpx;border-radius:14rpx;box-sizing:border-box}
.file-mention-row:active{background:var(--fill-2)}
.file-mention-icon{width:36rpx;height:36rpx;flex:0 0 36rpx;opacity:.88}
.theme-dark .file-mention-icon{filter:brightness(0) invert(.9)}
.file-mention-name{flex:1;min-width:0;font-size:28rpx;line-height:1.4;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.file-mention-drill{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:14rpx}
.file-mention-drill:active{background:var(--fill)}
.file-mention-chevron{width:28rpx;height:28rpx;opacity:.85}
.file-mention-group-title{margin:10rpx 14rpx 2rpx;padding-top:10rpx;border-top:1rpx solid var(--divider);font-size:22rpx;line-height:1.4;color:var(--text-3)}
.file-mention-session-detail{max-width:32%;flex-shrink:0;font-size:21rpx;line-height:1.3;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.file-mention-state{min-height:112rpx;padding:24rpx;display:flex;align-items:center;justify-content:center;gap:18rpx;box-sizing:border-box;text-align:center;font-size:25rpx;color:var(--text-2)}
.file-mention-error{color:var(--danger,#d94343)}
.file-mention-retry{padding:12rpx 18rpx;border:1rpx solid var(--border);border-radius:999rpx;color:var(--text);font-size:23rpx}
.command-menu-toolbar{display:flex;align-items:center;gap:4px;padding:0;flex-shrink:0}
.command-search{flex:1;min-width:0;height:30px;padding:0;color:var(--text);background:transparent;font-size:12px}
.command-search-placeholder{color:var(--text-3)}
.command-search-field{display:flex;align-items:center;gap:6px;margin:2px 2px 4px;padding:0 7px;border:1px solid transparent;border-radius:6px;flex-shrink:0}
.command-search-field:focus-within{border-color:var(--border-strong);background:var(--fill)}
.command-search-icon{width:14px;height:14px;flex:0 0 14px;opacity:.8}
.command-options{max-height:min(52vh,360px)}
.command-options .command-scroll{max-height:calc(min(52vh,360px) - 76px)}
.command-options-return{min-width:0;flex:1;min-height:30px;display:flex;align-items:center;gap:6px;padding:0 7px;border-radius:6px;cursor:pointer}
.command-options-back{display:block;width:14px;height:14px;flex:0 0 14px;transform:rotate(180deg)}
.command-options-title{min-width:0;font-size:12px;line-height:18px;color:var(--text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.command-options .command-close{width:30px;height:30px;border-radius:6px;cursor:pointer}
.command-close-glyph{position:relative;width:14px;height:14px;color:var(--text-2)}
.command-close-glyph::before,.command-close-glyph::after{content:'';position:absolute;left:6.5px;top:1px;width:1px;height:12px;background:currentColor;border-radius:1px;transform:rotate(45deg)}
.command-close-glyph::after{transform:rotate(-45deg)}
.command-close{width:56rpx;height:56rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.command-close .sheet-close-x{width:46rpx;height:46rpx}
.command-menu-icon-slot{width:20px;height:20px;flex:0 0 20px;display:flex;align-items:center;justify-content:center}
.command-menu-icon{display:block;width:16px;height:16px;flex-shrink:0;filter:grayscale(1);opacity:.85}
.theme-dark .command-monochrome{filter:brightness(0) invert(1);opacity:.8}
.command-row-pressed{background:var(--fill-2)}
.command-retry{flex-shrink:0;padding:8rpx 14rpx;color:var(--text)}
.composer-plus.active{background:var(--fill-2)}
.command-group-title{padding:8px 6px 6px;font-size:11px;font-weight:400;line-height:16px;color:var(--text-3)}
.command-scroll{max-height:36vh;min-height:0}
.command-catalog .command-scroll{max-height:calc(52vh - 10px)}
.command-row,.command-option{min-height:34px;padding:0 8px;box-sizing:border-box;border-radius:8px;display:flex;align-items:center;gap:6px;cursor:pointer}
.command-row:active,.command-option:active,.command-row:focus-visible,.command-option:focus-visible{background:var(--fill-2)}
.command-identity{display:flex;align-items:baseline;gap:6px;min-width:0;max-width:62%;flex:0 1 auto}
.command-name,.command-option-label{min-width:0;font-size:14px;line-height:20px;font-weight:400;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.command-alias{max-width:100px;flex-shrink:0;font-size:12px;line-height:18px;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.command-desc{min-width:0;flex:1;margin-left:8px;font-size:12px;line-height:18px;color:var(--text-3);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media (hover:hover) and (pointer:fine){.command-row:hover,.command-option:hover{background:var(--fill-2)}
}
@media (hover:none),(pointer:coarse){.command-row,.command-option{min-height:44px}
}
.command-options .command-option{min-height:30px;padding:5px 7px;gap:6px;border-radius:6px;font-size:12px;color:var(--text)}
.command-option.selected{background:var(--fill)}
.command-option-main{min-width:0;max-width:65%;flex:0 1 auto;display:flex;align-items:baseline;gap:4px}
.command-options .command-option-label{font-size:12px;line-height:18px}
.command-option-badge{max-width:48px;flex-shrink:0;align-self:flex-start;margin-top:-1px;font-size:8px;line-height:10px;font-weight:600;letter-spacing:.2px;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.command-option-detail{min-width:0;flex:1;margin-left:8px;font-size:11px;line-height:18px;color:var(--text-3);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.command-check-slot{width:14px;height:18px;flex:0 0 14px;margin-left:auto;display:flex;align-items:center;justify-content:center}
.command-check{width:8px;height:4px;border-left:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:translateY(-1px) rotate(-45deg)}
.command-option.command-row-pressed,.command-options-return:active,.command-options .command-close:active{background:var(--fill-2)}
@media (hover:hover) and (pointer:fine){.command-options .command-option:hover,.command-options-return:hover,.command-options .command-close:hover{background:var(--fill-2)}
}
@media (hover:none),(pointer:coarse){.command-options .command-option,.command-options-return{min-height:44px}
.command-options .command-close{width:44px;height:44px}
.command-search{height:40px;font-size:14px}
.command-options .command-option-label{font-size:14px;line-height:20px}
.command-option-detail{font-size:12px;line-height:20px}
.command-options .command-scroll{max-height:calc(52vh - 100px)}
.command-options{max-height:52vh}
}
.command-empty,.command-error{padding:28rpx;text-align:center;font-size:26rpx;color:var(--text-2)}
.command-error{color:#E5484D;display:flex;align-items:center;justify-content:space-between;gap:12rpx;font-size:23rpx}
.command-loading{height:4rpx;overflow:hidden;background:rgba(46,107,230,.12)}
.command-loading-bar{width:42%;height:100%;background:#2E6BE6;animation:command-load 1.1s ease-in-out infinite}
