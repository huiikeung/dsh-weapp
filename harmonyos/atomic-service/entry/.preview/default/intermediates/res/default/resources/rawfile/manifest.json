{
    "darkmode": true,
    "themeLocation": "theme.json",
    "style": "v2",
    "lazyCodeLoading": "requiredComponents",
    "sitemapLocation": "sitemap.json",
    "subPackages": [],
    "preloadRule": {
        "pages/home/home": {
            "network": "all",
            "packages": [
                "pages/session",
                "pages/settings",
                "pages/session-settings",
                "pages/plugins"
            ]
        },
        "pages/session/session": {
            "network": "all",
            "packages": [
                "pages/session-settings",
                "pages/insights",
                "pages/files",
                "pages/workspace-picker"
            ]
        },
        "pages/settings/settings": {
            "network": "all",
            "packages": [
                "pages/add-node",
                "pages/workspace-picker",
                "pages/announcements",
                "pages/cost-meter",
                "pages/schedule",
                "pages/plugin-detail",
                "pages/pairing-admin",
                "pages/redeem-admin"
            ]
        }
    },
    "type": "ascf",
    "independentList": [],
    "subpackages": [],
    "versionType": "debug",
    "debug": true,
    "debugable": true,
    "minPlatformVersion": "10000",
    "global": {
        "window": {
            "navigationBarBackgroundColor": "#FFFFFF",
            "navigationBarTextStyle": "black",
            "navigationBarTitleText": "鲸尾 Harness",
            "backgroundColor": "#FFFFFF",
            "backgroundTextStyle": "light",
            "backgroundColorTop": "#FFFFFF",
            "backgroundColorBottom": "#FFFFFF"
        }
    },
    "features": {
        "lazyCode": "v2"
    },
