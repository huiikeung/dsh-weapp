/* ---------- 过程分组行（对齐 dsh-mobile ConversationProcessRow） ---------- */

/* 过程组（对齐 DSH：左箭头 ▾ 收起 / ▴ 展开 + 标题 + 底部发丝线） */
.process-block {
  padding: 0;
  margin: 0;
}

.process-block.running .process-title {
