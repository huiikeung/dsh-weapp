}
/* DSH composer footer锛氳疆娆?姝ラ銆乀oken/缂撳瓨銆佷笂涓嬫枃鍧囦綅浜庤緭鍏ュ崱涓嬫柟 */
.composer-metrics {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  gap: 20rpx;
  padding: 12rpx 18rpx 0;
  color: var(--text-2);
  box-sizing: border-box;
}
.composer-metric {
