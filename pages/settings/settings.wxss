.settings {
  padding: 20rpx 40rpx 80rpx;
}

.chevron {
  color: var(--gray);
  font-size: 34rpx;
  margin-left: 12rpx;
}

.chevron-img {
  width: 26rpx;
  height: 26rpx;
  margin-left: 12rpx;
  opacity: 0.55;
}

.gw-url {
  font-size: 28rpx;
  color: var(--ink);
  word-break: break-all;
}

.gw-status {
  display: flex;
  align-items: center;
}

.gw-cwd {
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exp-copy {
  display: flex;
  flex-direction: column;
  margin-right: 24rpx;
  flex: 1;
}

.exp-desc {
  font-size: 24rpx;
  color: var(--gray);
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ---------- 深色模式覆盖（page-dark） ---------- */

.page-dark .card {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 28rpx;
  overflow: hidden;
}

.page-dark .card-row + .card-row {
  border-top-color: rgba(255, 255, 255, 0.08);
}

.page-dark .card-row-label {
  color: #FFFFFF;
}

.page-dark .gw-url {
  color: #FFFFFF;
}

.page-dark .gw-cwd {
  color: rgba(255, 255, 255, 0.7);
}

.page-dark .chevron-img {
  opacity: 0.45;
}

.page-dark .btn-text {
  color: var(--ocean);
}

.page-dark .btn-text-danger {
  color: #FF6B6B;
}

.page-dark .status-dot.disconnected {
  background: rgba(255, 255, 255, 0.4);
}
