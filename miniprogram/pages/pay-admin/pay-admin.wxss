/* 支付档位管理 —— 分组卡片式（跟随小程序深浅色主题） */

.pay-wrap { padding: 24rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); }

/* 页头 */
.pay-head { display: flex; align-items: center; gap: 22rpx; margin: 8rpx 4rpx 30rpx; }
.pay-head-icon {
  width: 84rpx; height: 84rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  border-radius: 24rpx;
  background: linear-gradient(140deg, var(--ocean), #1A5CC8);
  color: #fff; font-size: 42rpx; font-weight: 600;
  box-shadow: 0 10rpx 26rpx rgba(46, 107, 230, 0.28);
}
.pay-head-copy { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.pay-head-title { font-size: 40rpx; font-weight: 700; color: var(--text); letter-spacing: 0.5rpx; }
.pay-head-sub { font-size: 23rpx; color: var(--text-2); }

/* 提示条 */
.pay-note { margin: 18rpx 0; padding: 22rpx 26rpx; border-radius: 18rpx; background: var(--fill); color: var(--text-2); font-size: 24rpx; line-height: 1.6; }
.pay-note-warn { border: 1rpx solid rgba(229, 72, 77, 0.22); background: rgba(229, 72, 77, 0.06); color: var(--text); }
.pay-note-link { border: 1rpx solid var(--ocean); color: var(--ocean); font-weight: 500; text-align: center; }

/* 通用卡片 */
.pay-card {
  margin-bottom: 22rpx; overflow: hidden;
  border-radius: 28rpx; background: var(--surface);
  border: 1rpx solid var(--border); box-shadow: var(--card-shadow);
}

/* 分组标题 */
.pay-group-head { display: flex; align-items: baseline; justify-content: space-between; margin: 34rpx 8rpx 6rpx; }
.pay-group-title { font-size: 27rpx; font-weight: 600; color: var(--text); }
.pay-group-meta { font-size: 23rpx; color: var(--text-3); font-variant-numeric: tabular-nums; }
.pay-group-action { font-size: 24rpx; color: var(--ocean); padding: 4rpx 8rpx; margin: -4rpx -8rpx; border-radius: 10rpx; }
.pay-group-action:active { opacity: .6; }
.pay-group-hint { margin: 0 8rpx 18rpx; font-size: 22rpx; color: var(--text-3); line-height: 1.65; }

/* 总开关 */
.pay-switch { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 28rpx 30rpx; }
.pay-switch-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.pay-switch-title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.pay-switch-desc { font-size: 23rpx; color: var(--text-2); line-height: 1.5; }

/* 档位列表 */
.pay-tiers { padding-bottom: 0; }
.tier-item { padding: 22rpx 26rpx; }
.tier-item + .tier-item { border-top: 1rpx solid var(--divider); }
.tier-row { display: flex; align-items: center; gap: 12rpx; }

/* 天数：纯文字 + 箭头 */
.tier-day { display: flex; align-items: center; gap: 8rpx; }
.tier-day-value { font-size: 29rpx; font-weight: 650; color: var(--text); letter-spacing: 0.2rpx; }
.tier-day-caret { font-size: 18rpx; color: var(--ocean); line-height: 1; }

/* 道具 ID：单行内联，弱化存在感 */
.tier-prop-chip {
  flex: none; font-size: 19rpx; font-family: monospace; color: var(--text-3);
  padding: 4rpx 10rpx; border-radius: 8rpx; background: var(--fill);
}

/* 价格：唯一输入框，和这一行文字同一垂直中线 */
.tier-price {
  flex: 1; min-width: 0; max-width: 216rpx; margin-left: auto;
  display: flex; align-items: center; gap: 8rpx;
  height: 64rpx; padding: 0 16rpx; box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}
.theme-light .tier-price { background: rgba(16, 19, 24, 0.035); border-color: rgba(16, 19, 24, 0.05); }
.tier-currency { flex: none; font-size: 24rpx; color: var(--text-3); line-height: 1; }
.tier-price-input {
  flex: 1; min-width: 0; height: 40rpx; padding: 0;
  border: 0; background: transparent; color: var(--text);
  font-size: 31rpx; font-weight: 650; line-height: 40rpx; text-align: right;
}
.tier-price-ph { color: var(--text-4); font-weight: 400; }

/* 删除：无底色小叉 */
.tier-del {
  flex: none; width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
}
.tier-del:active { background: rgba(229, 72, 77, 0.14); }
.tier-del-x { font-size: 30rpx; line-height: 1; color: var(--text-4); }

/* 空状态 / 添加 */
.pay-empty { padding: 56rpx 20rpx; text-align: center; color: var(--text-3); font-size: 24rpx; }
.pay-add {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 28rpx; margin: 0;
  border-top: 1rpx solid var(--divider);
  color: var(--ocean); font-size: 26rpx; font-weight: 500;
}
.pay-add:active { background: var(--fill); }
.pay-add-plus { font-size: 32rpx; font-weight: 300; line-height: 1; }

/* 保存 */
.pay-save {
  display: flex; align-items: center; justify-content: center;
  width: 100%; box-sizing: border-box;
  margin: 26rpx 0 14rpx; min-height: 92rpx; line-height: 1.2; text-align: center;
  border-radius: 24rpx; font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx;
  color: #fff; background: linear-gradient(135deg, var(--ocean), #1A5CC8);
  box-shadow: 0 8rpx 24rpx rgba(46, 107, 230, 0.25);
}
.pay-save:active { transform: scale(0.985); }
.pay-save.is-disabled { background: var(--fill); color: var(--text-3); box-shadow: none; }

/* 结果与脚注 */
.pay-saved { margin: 10rpx 0; padding: 20rpx 24rpx; border-radius: 18rpx; background: rgba(46, 184, 92, 0.08); border: 1rpx solid rgba(46, 184, 92, 0.18); color: var(--success); font-size: 23rpx; line-height: 1.6; }
.pay-footnote { margin-top: 12rpx; padding: 18rpx 22rpx; border-radius: 16rpx; background: var(--fill); color: var(--text-3); font-size: 22rpx; line-height: 1.65; }

/* 非管理员 */
.pay-noauth { padding: 90rpx 40rpx; text-align: center; }
.pay-noauth-text { display: block; color: var(--text-3); font-size: 26rpx; line-height: 1.7; margin-bottom: 30rpx; }

/* 交易记录 */
.pay-summary { display: flex; align-items: stretch; }
.summary-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 28rpx 8rpx; min-width: 0; }
.summary-sep { width: 1rpx; margin: 28rpx 0; background: var(--divider); }
.summary-label { font-size: 21rpx; color: var(--text-3); }
.summary-value { font-size: 30rpx; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }

.order-filters { display: flex; gap: 8rpx; margin: 2rpx 2rpx 16rpx; padding: 6rpx; border-radius: 16rpx; background: var(--fill); }
.order-filter { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 56rpx; border-radius: 12rpx; font-size: 23rpx; color: var(--text-2); }
.order-filter.on { background: var(--surface); color: var(--text); font-weight: 600; box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08); }
.order-filter:active { opacity: 0.7; }

.pay-orders { padding-bottom: 0; margin-top: 2rpx; }
.order-group + .order-group { border-top: 1rpx solid var(--divider); }
.order-date { padding: 18rpx 26rpx 8rpx; font-size: 21rpx; font-weight: 600; color: var(--text-3); letter-spacing: 0.5rpx; }
.order-item { padding: 14rpx 26rpx 18rpx; }
.order-item + .order-item { border-top: 1rpx solid var(--divider); }
.order-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.order-time { font-size: 24rpx; color: var(--text); }
.order-amount { flex: none; font-size: 27rpx; font-weight: 650; color: var(--ocean); }
.order-bottom { display: flex; align-items: center; gap: 12rpx; margin-top: 6rpx; }
.order-no { flex: 1; min-width: 0; font-size: 19rpx; color: var(--text-3); font-family: monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.order-status { flex: none; font-size: 20rpx; color: var(--text-3); }
.order-status.is-delivered { color: var(--success); }
.order-status.is-refunded { color: #E5484D; }
.order-status.is-closed { color: var(--text-4); }
.order-acts { flex: none; display: flex; gap: 14rpx; }
.order-act { font-size: 22rpx; color: var(--ocean); padding: 2rpx 6rpx; }
.order-act:active { opacity: .6; }
.order-act-warn { color: #E5484D; }
.order-toggle { padding: 22rpx; text-align: center; border-top: 1rpx solid var(--divider); font-size: 24rpx; color: var(--ocean); font-weight: 500; }
.order-toggle.is-busy { color: var(--text-3); }
.order-capped { padding: 18rpx 26rpx; border-top: 1rpx solid var(--divider); font-size: 21rpx; color: var(--text-3); text-align: center; line-height: 1.5; }
.order-toggle:active { background: var(--fill); }
/* ===== 玻璃 UI：与设置页共用「设置页玻璃UI」开关与玻璃参数 ===== */
.pay-glass .pay-card {
  border-radius: var(--glass-radius-card, 36rpx);
  background: linear-gradient(165deg, rgba(255, 255, 255, var(--glass-alpha-top, 0.06)), rgba(255, 255, 255, var(--glass-alpha-bottom, 0.015)));
  border: 1rpx solid rgba(255, 255, 255, var(--glass-edge-alpha, 0.38));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 8rpx 32rpx rgba(3, 14, 30, 0.18);
  backdrop-filter: blur(var(--glass-blur-card, 3rpx)) brightness(var(--glass-backdrop-brightness, 1));
  -webkit-backdrop-filter: blur(var(--glass-blur-card, 3rpx)) brightness(var(--glass-backdrop-brightness, 1));
}
.pay-glass .tier-item + .tier-item,
.pay-glass .order-item + .order-item,
.pay-glass .order-group + .order-group,
.pay-glass .order-toggle { border-top-color: rgba(255, 255, 255, 0.12); }

/* 输入框与分段器：半透明层 + 发丝亮边，贴在玻璃卡片上不突兀 */
.pay-glass .tier-price {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.10);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}
.pay-glass .order-filters {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.12);
}
.pay-glass .order-filter.on {
  background: rgba(255, 255, 255, 0.16);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
}
.pay-glass .pay-add:active,
.pay-glass .order-toggle:active { background: rgba(255, 255, 255, 0.08); }

/* 浅色主题：近白磨砂 + 深色发丝边 */
.theme-light .pay-glass .pay-card {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.92), rgba(247, 249, 252, 0.86));
  border-color: rgba(16, 19, 24, 0.08);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.90), 0 8rpx 32rpx rgba(7, 24, 43, 0.10);
}
.theme-light .pay-glass .tier-item + .tier-item,
.theme-light .pay-glass .order-item + .order-item,
.theme-light .pay-glass .order-group + .order-group,
.theme-light .pay-glass .order-toggle { border-top-color: rgba(16, 19, 24, 0.08); }
.theme-light .pay-glass .tier-price,
.theme-light .pay-glass .order-filters {
  background: rgba(255, 255, 255, 0.55);
  border-color: rgba(16, 19, 24, 0.08);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.70);
}
.theme-light .pay-glass .order-filter.on { background: rgba(255, 255, 255, 0.95); }

/* ===== 自定义弹窗（确认退款 / 微信侧订单） ===== */
.pay-dialog-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 60;
  display: flex; align-items: center; justify-content: center;
  padding: 0 52rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(3, 8, 16, 0.52);
  animation: pay-dialog-fade 0.16s ease-out;
}
.pay-dialog {
  width: 100%; max-width: 540rpx; box-sizing: border-box;
  padding: 36rpx 32rpx 26rpx; border-radius: 30rpx;
  background: var(--surface); border: 1rpx solid var(--border);
  box-shadow: 0 24rpx 64rpx rgba(3, 14, 30, 0.38);
  animation: pay-dialog-in 0.18s cubic-bezier(0.2, 0.9, 0.3, 1);
}
.pay-dialog-title { font-size: 31rpx; font-weight: 650; color: var(--text); text-align: center; letter-spacing: 0.3rpx; }
.pay-dialog-body { display: flex; flex-direction: column; gap: 10rpx; margin-top: 20rpx; }
.pay-dialog-line { font-size: 24rpx; line-height: 1.65; color: var(--text-2); word-break: break-all; }
.pay-dialog-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.pay-dialog-btn {
  flex: 1; min-height: 84rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 20rpx; background: var(--fill); color: var(--text-2);
  font-size: 28rpx; font-weight: 500;
}
.pay-dialog-btn-hover { opacity: 0.82; }
.pay-dialog-btn.is-primary {
  color: #FFFFFF; font-weight: 600;
  background: linear-gradient(135deg, var(--ocean), #1A5CC8);
  box-shadow: 0 8rpx 22rpx rgba(46, 107, 230, 0.26);
}
.pay-dialog-btn.is-danger {
  background: linear-gradient(135deg, #E5484D, #C93A3F);
  box-shadow: 0 8rpx 22rpx rgba(229, 72, 77, 0.24);
}
.pay-dialog-btn.is-busy { opacity: 0.6; }

@keyframes pay-dialog-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes pay-dialog-in { from { opacity: 0; transform: translateY(12rpx) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }

/* 玻璃：弹窗用浮起面板材质，遮罩带轻微模糊 */
.pay-glass .pay-dialog {
  border-radius: var(--glass-radius-sheet, 32rpx);
  background: linear-gradient(165deg, rgba(255, 255, 255, var(--glass-alpha-top, 0.10)), rgba(255, 255, 255, var(--glass-alpha-bottom, 0.04)));
  border: 1rpx solid rgba(255, 255, 255, var(--glass-edge-alpha, 0.38));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 24rpx 64rpx rgba(3, 14, 30, 0.42);
  backdrop-filter: blur(var(--glass-blur-sheet, 8rpx)) brightness(var(--glass-backdrop-brightness, 1));
  -webkit-backdrop-filter: blur(var(--glass-blur-sheet, 8rpx)) brightness(var(--glass-backdrop-brightness, 1));
}
.pay-glass .pay-dialog-mask { backdrop-filter: blur(2rpx); -webkit-backdrop-filter: blur(2rpx); }
.pay-glass .pay-dialog-btn:not(.is-primary):not(.is-danger) {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}
.theme-light .pay-glass .pay-dialog {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.94), rgba(247, 249, 252, 0.88));
  border-color: rgba(16, 19, 24, 0.08);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.90), 0 24rpx 64rpx rgba(7, 24, 43, 0.22);
}
.theme-light .pay-glass .pay-dialog-btn:not(.is-primary):not(.is-danger) {
  background: rgba(16, 19, 24, 0.05);
  border-color: rgba(16, 19, 24, 0.08);
}
