}
.segmented-row .nav-more {
  position: absolute;
  right: 20rpx;
  top: 12rpx;
  margin: 0;
}



/* Compact attachment control and icon-led attachment menu. */
.composer-bar .chip.icon {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
}
/* 加号按钮与权限图标同尺寸（24rpx） */
.composer-bar .chip.icon {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
}
.composer-bar .chip.icon .attach-ic { width: 24rpx; height: 24rpx; }
.composer-bar .chip-ic { width: 34rpx; height: 34rpx; margin-right: 8rpx; }

/* 权限控件：图标固定，文字使用剩余宽度，过长时省略 */
.composer-bar .permission-chip {
  flex: 0 1 38%;
  min-width: 0;
  max-width: 38%;
  overflow: hidden;
  white-space: nowrap;
}
.composer-bar .permission-chip .chip-ic {
  flex: 0 0 34rpx;
  margin-right: 8rpx;
}
.composer-bar .permission-chip .chip-label {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: var(--text-2);
}

/* 模型芯片：名字过长省略，右侧思考等级与箭头图标固定不被挤出输入框 */
.composer-bar .chip.model-chip {
  flex: 0 1 44%;
  max-width: 44%;
  min-width: 0;
  overflow: hidden;
}
.chip-model-name {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  max-width: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.model-chip .effort-pill,
.model-chip .chip-ud {
  flex: 0 0 auto;
}
.attach-sheet {
  position: absolute;
  left: 28rpx;
  bottom: 92rpx;
  z-index: 20;
  display: flex;
  gap: 10rpx;
  padding: 12rpx;
  border: 1rpx solid var(--border-strong);
  border-radius: 24rpx;
  background: var(--surface);
  box-shadow: var(--float-shadow);
}
.attach-sheet-item {
  width: 112rpx;
  min-height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 16rpx;
  color: var(--text);
  font-size: 22rpx;
}
.attach-sheet-item:active { background: var(--fill-2); }
.attach-sheet-icon { width: 38rpx; height: 38rpx; }

/* 模型菜单：按运营商分组 + 单选圆圈 */
.model-pop {
  left: 28rpx;
  right: 28rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  max-width: none;
  padding: 8rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}
.model-pop-scroll {
  max-height: 56vh;
  overflow-x: hidden;
}
.model-group-title {
  padding: 18rpx 24rpx 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  color: var(--text-3);
}
.model-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}
.model-row:active {
  background: var(--fill-2);
}
.model-radio {
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  min-width: 38rpx;
  max-width: 38rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--text-3);
  border-radius: 50%;
}
.model-radio.on {
  border-color: transparent;
}
.model-radio-check {
  width: 38rpx;
  height: 38rpx;
  display: block;
}
/* 夜间模式：对勾反白 */
.theme-dark .model-radio-check {
  filter: brightness(0) invert(1);
}
.model-name {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  color: var(--text);
}
.model-row.current .model-name {
  font-weight: 500;
}

/* 思考等级弹窗：与模型弹窗同款样式，锚在输入栏右侧 */
.effort-pop {
  left: auto;
  right: 28rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  min-width: 300rpx;
  max-width: 420rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}

.navbar .nav-back {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}
.navbar .nav-back::after {
  border: 0 !important;
}



.opt-pop.attach-pop {
  position: absolute;
  left: 0;
  right: auto;
  bottom: 88rpx;
  min-width: 240rpx;
  max-width: 320rpx;
  border-radius: 22rpx;
  padding: 8rpx;
}
/* 弹窗菜单使用正常字号与图标尺寸（输入栏 + 图标尺寸不受影响） */
.opt-pop .opt-ic { width: 36rpx; height: 36rpx; }
/* 夜间模式：灰阶图标统一反白，保证对比度 */
.theme-dark .opt-pop .opt-ic {
  filter: brightness(0) invert(1);
  opacity: 0.92;
}
.theme-dark .composer-bar .chip-ic,
.theme-dark .composer-bar .attach-ic,
.theme-dark .pending-file-ic {
  filter: brightness(0) invert(1);
  opacity: 0.92;
}
.opt-pop.attach-pop .opt-row {
  min-height: 72rpx;
  padding: 14rpx 18rpx;
  gap: 14rpx;
}
.opt-pop.attach-pop .opt-label { font-size: 28rpx; }

.opt-pop.permission-pop {
  left: 72rpx;
  right: auto;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  min-width: 320rpx;
  max-width: 420rpx;
  border-radius: 22rpx;
  padding: 8rpx;
}
.opt-pop.permission-pop .opt-row {
  min-height: 72rpx;
  padding: 14rpx 18rpx;
  gap: 14rpx;
}
.opt-pop.permission-pop .opt-label { font-size: 28rpx; }
.attach-sheet { bottom: 76rpx; border-radius: 22rpx; padding: 10rpx; }
.attach-sheet-item { width: 100rpx; min-height: 84rpx; }
