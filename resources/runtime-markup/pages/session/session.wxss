}
.composer-metric.token {
  flex: 0 0 auto;
  justify-content: flex-start;
}
.composer-metric-text,
.composer-metric-dot {
  color: var(--text-2);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: 0;
  font-variant-numeric: tabular-nums;
