  color: var(--text);
}

.code-item-status {
  font-size: 24rpx;
  color: var(--text-2);
}

.code-item-meta {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---------- 发布公告弹窗 ---------- */
.ann-sheet {
  display: flex;
  flex-direction: column;
  height: 90%;
}

.ann-scroll {
  flex: 1;
  min-height: 0;
}

.ann-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.ann-input,
.ann-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: var(--fill);
  border: 1rpx solid var(--border);
  color: var(--text);
  font-size: 29rpx;
  line-height: 1.6;
}

.ann-input {
  height: 88rpx;
}

.ann-textarea {
  height: 260rpx;
}

.ann-placeholder {
  color: var(--text-3);
}

.ann-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.ann-primary {
  flex: 1;
  margin: 0;
  padding: 22rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4C8BF5, #2E6BE6);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  box-shadow: 0 8rpx 24rpx rgba(46, 107, 230, 0.28);
}

.ann-primary::after {
  border: 0;
}

.ann-ghost {
  flex: none;
  margin: 0;
  padding: 22rpx 28rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--text-2);
  font-size: 27rpx;
  line-height: 1.5;
}

.ann-ghost::after {
  border: 0;
}

.ann-hint {
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-3);
  margin-bottom: 20rpx;
}

.ann-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 12rpx;
}

.ann-list-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-2);
}

.ann-item {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ann-item-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.ann-item-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ann-item-status {
  flex: none;
  font-size: 23rpx;
  color: var(--text-3);
}

.ann-item-body {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--text-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.ann-item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 6rpx;
}

/* ---------- 开发者公告弹窗 ---------- */
.devann-sheet {
  display: flex;
  flex-direction: column;
  height: 90%;
}

.devann-scroll {
  flex: 1;
  min-height: 0;
}

.devann-empty {
  padding: 60rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.devann-empty-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}

.devann-empty-desc {
  font-size: 24rpx;
  color: var(--text-3);
}

.devann-item {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.devann-item-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.devann-item-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}

.devann-item-time {
  flex: none;
  font-size: 23rpx;
  color: var(--text-3);
}

.devann-item-body {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  white-space: pre-wrap;
}

.devann-item-body.expanded {
  -webkit-line-clamp: unset;
  display: block;
}

.devann-item-more {
  align-self: flex-start;
  font-size: 24rpx;
  color: var(--ocean);
}

.devann-note {
  padding: 12rpx 4rpx 28rpx;
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
}


/* ---------- 可拖动/点击调整高度的弹窗 ---------- */
.sheet-grabber-zone {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 8rpx 0;
  margin-bottom: 4rpx;
  flex-shrink: 0;
}

.pair-sheet.resizable {
  transition: height 0.24s cubic-bezier(0.32, 0.72, 0, 1);
}

/* ---------- 外观（界面）弹窗 ---------- */
.appearance-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.appearance-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--border);
  background: var(--fill);
}

.appearance-option.selected {
  border-color: rgba(76, 108, 224, 0.55);
  background: rgba(76, 108, 224, 0.10);
}

.appearance-option-icon {
  width: 76rpx;
  height: 52rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid var(--border);
  overflow: hidden;
}

.appearance-auto .appearance-swatch {
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #F5F7FB 0 50%, #1B2130 50% 100%);
}

.appearance-light .appearance-swatch {
  width: 100%;
  height: 100%;
  background: #F5F7FB;
}

.appearance-dark .appearance-swatch {
  width: 100%;
  height: 100%;
  background: #1B2130;
}

.appearance-option-label {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  color: var(--text);
}

.appearance-option-check {
  flex: none;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ocean);
}

/* ---------- 公网访问弹窗内的兑换表单 ---------- */
.public-redeem-form {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(76, 108, 224, 0.35);
  background: rgba(76, 108, 224, 0.08);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.public-redeem-form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.public-redeem-form-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.public-redeem-form-cancel {
  font-size: 25rpx;
  color: var(--text-2);
}

.public-redeem-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  color: var(--text);
  font-size: 29rpx;
  letter-spacing: 1rpx;
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
}

.public-redeem-placeholder {
  color: rgba(128, 136, 150, 0.55);   /* 浅色默认格式提示 */
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  letter-spacing: 1rpx;
}

.public-redeem-form-hint {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.public-redeem-submit {
  margin: 4rpx 0 0;
  padding: 0;
  width: 100%;
  height: 84rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4C8BF5, #2E6BE6);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.public-redeem-submit::after { border: 0; }
.public-redeem-submit[disabled] { opacity: 0.6; }

/* 震动/外观弹窗中的说明 */
.appearance-sheet .pair-sheet-subtitle {
  display: block;
  margin-top: 8rpx;
}

/* 震动设置：测试按钮 */
.haptics-test-row {
  margin-top: 18rpx;
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  background: var(--fill);
  color: var(--text);
  font-size: 27rpx;
  font-weight: 500;
}

.haptics-status {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-3);
  text-align: center;
  overflow-wrap: anywhere;
}
/* 上下文偏好：分段按钮（dsh-context settings.css 的 pill 组） */
.card-row.card-row-stack { display: flex; flex-direction: column; align-items: stretch; gap: 14rpx; }
.card-row.card-row-stack .exp-copy { width: 100%; margin-right: 0; }
.ctx-seg{display:flex;flex-wrap:wrap;gap:6rpx;padding:4rpx;border-radius:14rpx;background:var(--fill);}
.ctx-seg-btn{min-height:48rpx;padding:0 16rpx;display:flex;align-items:center;border-radius:10rpx;font-size:21rpx;color:var(--text-2);}
.ctx-seg-btn.on{background:var(--surface);color:var(--text);box-shadow:0 1rpx 4rpx rgba(0,0,0,.08);}
.ctx-seg-pressed{opacity:.7;}
.ctx-seg-scroll{max-width:100%;}
.ctx-seg-wide{width:100%;flex-wrap:nowrap;box-sizing:border-box;}
.ctx-seg-wide .ctx-seg-btn{flex:1;min-width:0;justify-content:center;padding:0 8rpx;white-space:nowrap;}

/* 存储空间弹窗（dsh-mobile StorageSpaceView） */
.storage-head-row { display:flex; align-items:center; gap:16rpx; min-width:0; }
.storage-back { font-size:26rpx; color:var(--text-2); flex-shrink:0; }
.storage-donut { position:relative; width:320rpx; height:320rpx; margin:6rpx auto 26rpx; border-radius:50%; background:var(--fill-2); box-shadow:0 14rpx 34rpx rgba(0,0,0,.10); }
.storage-donut-hole { position:absolute; left:50%; top:50%; width:226rpx; height:226rpx; margin:-113rpx 0 0 -113rpx; border-radius:50%; background:var(--surface); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6rpx; }
.storage-donut-total { font-size:40rpx; font-weight:650; color:var(--text); font-variant-numeric:tabular-nums; }
.storage-donut-label { font-size:22rpx; letter-spacing:2rpx; color:var(--text-3); }
.storage-hero { padding:30rpx 28rpx 0; margin-bottom:24rpx; background:radial-gradient(120% 74% at 50% 0%, var(--fill) 0%, var(--surface) 64%); }
.storage-list { margin-bottom:18rpx; }
.storage-quota { display:flex; align-items:center; justify-content:space-between; margin-top:6rpx; padding:22rpx 4rpx 26rpx; border-top:1rpx solid var(--divider); font-size:23rpx; color:var(--text-3); }
.storage-quota-copy { display:flex; flex-direction:column; gap:4rpx; }
.storage-quota-hint { font-size:20rpx; color:var(--text-4); }
.storage-quota-value { font-size:24rpx; color:var(--text-2); font-variant-numeric:tabular-nums; }
.storage-row { display:flex; align-items:center; gap:24rpx; padding:26rpx 28rpx; }
.storage-row + .storage-row { border-top:1rpx solid var(--divider); }
.storage-row-right { display:flex; flex-direction:column; align-items:flex-end; gap:4rpx; flex-shrink:0; }
.storage-row-pct { font-size:21rpx; color:var(--text-4); font-variant-numeric:tabular-nums; }
/* 内衬留白：图形永不贴到色块边框（对齐 iOS icon.padding） */
.storage-icon { width:76rpx; height:76rpx; padding:18rpx; box-sizing:border-box; border-radius:19rpx; flex-shrink:0; box-shadow:inset 0 -6rpx 14rpx rgba(0,0,0,.14), inset 0 1rpx 0 rgba(255,255,255,.20); }
.storage-icon-img { width:100%; height:100%; filter:brightness(0) invert(1); opacity:.95; }
.storage-row-copy { flex:1; min-width:0; display:flex; flex-direction:column; gap:6rpx; }
.storage-row-title { font-size:28rpx; color:var(--text); }
.storage-row-detail { font-size:22rpx; color:var(--text-3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.storage-row-size { font-size:26rpx; color:var(--text-2); font-variant-numeric:tabular-nums; flex-shrink:0; }
.storage-state { padding:90rpx 0; text-align:center; color:var(--text-3); font-size:26rpx; }
.storage-detail-card { padding:26rpx 28rpx; }
.storage-detail-head { display:flex; align-items:center; gap:26rpx; }
.storage-detail-size { margin-left:auto; font-size:30rpx; font-weight:650; color:var(--text); font-variant-numeric:tabular-nums; }
.storage-icon-lg { width:112rpx; height:112rpx; padding:26rpx; border-radius:28rpx; }
.storage-detail-title { font-size:32rpx; font-weight:650; color:var(--text); }
.storage-clear-text { flex:1; text-align:center; color:#FA5150; font-size:29rpx; padding:22rpx 0; }
.storage-clear.is-disabled { opacity:.5; }
.storage-row-chevron { flex-shrink:0; }

/* 兑换码「访问时长」居中弹窗 */
.code-modal-mask { position: fixed; inset: 0; z-index: 1200; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(0, 0, 0, .45); }
.code-modal { width: 100%; max-width: 600rpx; max-height: 70vh; box-sizing: border-box; display: flex; flex-direction: column; padding: 28rpx 28rpx 20rpx; border-radius: 24rpx; background: var(--surface); border: 1rpx solid var(--border); box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, .28); }
.code-modal-head { display: flex; flex: none; align-items: center; justify-content: space-between; gap: 16rpx; padding-bottom: 16rpx; }
.code-modal-title { color: var(--text); font-size: 30rpx; font-weight: 620; }
.code-modal-close { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--fill); color: var(--text-2); font-size: 24rpx; }
.code-modal-body { flex: 1; min-height: 0; max-height: 52vh; }
.code-option { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 96rpx; padding: 0 22rpx; border-radius: 16rpx; color: var(--text); font-size: 28rpx; }
.code-option + .code-option { margin-top: 8rpx; }
.code-option.on { background: var(--fill); color: var(--ocean); font-weight: 600; }
.code-option-check { color: var(--ocean); font-size: 26rpx; }
