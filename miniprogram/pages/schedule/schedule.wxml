<view class="page sched {{themeClass}}" style="{{contentFontStyle}}padding-top: {{statusBarH}}px;">
  <view class="sched-header"><button class="sched-back" bindtap="goBack" aria-label="{{ui['返回']}}"><image class="sched-back-image" src="/assets/icons/{{theme === 'dark' ? 'back-white.png' : 'back-black.png'}}" mode="aspectFit"/></button><text class="sched-title">{{ui['自动化任务']}}</text></view>
  <scroll-view class="sched-scroll" scroll-y refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="sched-list">
      <view class="sched-toolbar"><text class="sched-intro">{{ui['让重复的工作自动完成']}}</text><view class="sched-toolbar-actions"><button class="sched-refresh" bindtap="onRefresh" disabled="{{!connected || loading}}" aria-label="{{ui['刷新任务']}}"><image class="sched-refresh-image" src="/assets/icons/{{theme === 'dark' ? 'refresh.png' : 'refresh-ink.png'}}" mode="aspectFit"/></button><button class="sched-primary sched-new" bindtap="newTask" disabled="{{!connected || creating}}">{{ui['＋ 新建']}}</button></view></view>
      <view class="sched-filters"><button class="{{statusFilter === 'all' ? 'selected' : ''}}" data-status="all" bindtap="selectStatus">{{ui['全部']}}</button><button class="{{statusFilter === 'active' ? 'selected' : ''}}" data-status="active" bindtap="selectStatus">{{ui['已开启']}}</button><button class="{{statusFilter === 'inactive' ? 'selected' : ''}}" data-status="inactive" bindtap="selectStatus">{{ui['已结束']}}</button></view>
      <view class="sched-search"><view class="sched-search-icon"></view><input placeholder="{{ui['搜索自动化任务']}}" value="{{search}}" bindinput="onSearch" aria-label="{{ui['搜索自动化任务']}}"/><button wx:if="{{search}}" bindtap="clearSearch" aria-label="{{ui['清空搜索']}}">×</button></view>
      <view wx:if="{{loading && !tasks.length}}" class="sched-state"><view class="sched-spinner"></view><text>{{ui['正在加载自动化任务…']}}</text></view>
      <view wx:elif="{{error && !tasks.length}}" class="sched-state"><image class="sched-state-ic" src="/pages/schedule/assets/icons/sched-offline-gray.svg" mode="aspectFit"/><text class="sched-state-title">{{ui['无法显示自动化任务']}}</text><text class="sched-state-desc">{{ui[error] !== undefined ? ui[error] : error}}</text><button class="sched-outline" bindtap="onRetry">{{ui['重试']}}</button></view>
      <view wx:elif="{{!tasks.length}}" class="sched-state"><image class="sched-state-ic" src="/assets/icons/sched-clock-gray.png" mode="aspectFit"/><text class="sched-state-title">{{ui['还没有自动化任务']}}</text><text class="sched-state-desc">{{ui['在会话中告诉 Agent 任务内容和执行时间，创建后会显示在这里。']}}</text><button class="sched-empty-new" bindtap="newTask" disabled="{{!connected || creating}}" aria-label="{{ui['新建自动化任务']}}">{{ui['新建自动化任务']}}</button></view>
      <block wx:else><view wx:if="{{error}}" class="sched-notice">{{ui[error] !== undefined ? ui[error] : error}}{{ui['；当前显示上次读取的任务。']}}</view><view wx:if="{{!visibleTasks.length}}" class="sched-state"><text class="sched-state-title">{{statusFilter === 'inactive' && !search ? ui['没有已结束的自动化任务'] : ui['没有匹配的自动化任务']}}</text></view></block>
      <view class="sched-rows"><button wx:for="{{visibleTasks}}" wx:key="id" class="sched-task {{item.status === 'inactive' ? 'is-ended' : ''}}" data-id="{{item.id}}" bindtap="openDetail"><view class="sched-task-clock"><image class="sched-task-image" src="/assets/icons/{{theme === 'dark' ? 'automation-white.svg' : 'automation.svg'}}" mode="aspectFit"/></view><view class="sched-task-copy"><view class="sched-task-heading"><text class="sched-task-title">{{item.title}}</text><text class="sched-status {{item.status}}">{{ui[item.statusLabel] !== undefined ? ui[item.statusLabel] : item.statusLabel}}</text></view><text class="sched-task-rule">{{ui[item.ruleFull] !== undefined ? ui[item.ruleFull] : item.ruleFull}}</text><text class="sched-task-prompt">{{item.prompt}}</text><text class="sched-task-next">{{item.status === 'active' ? ui['下次计划时间：'] + item.nextLabel : ui['任务已结束']}}</text></view><view class="sched-chevron"></view></button></view>
    </view>
  </scroll-view>
  <view wx:if="{{selected}}" class="sched-overlay"><view class="sched-mask" bindtap="closeDetail" catchtouchmove="noop"></view><view class="sched-sheet"><view class="sched-handle"></view><view class="sched-sheet-head"><view class="sched-detail-heading"><text class="sched-eyebrow">{{ui['任务详情']}}</text><text class="sched-detail-title">{{selected.title}}</text></view><button class="sched-close" bindtap="closeDetail" aria-label="{{ui['关闭详情']}}">×</button></view>
    <view class="sched-detail-tabs"><button class="{{detailTab === 'rule' ? 'selected' : ''}}" data-tab="rule" bindtap="selectDetailTab">{{ui['规则']}}</button><button class="{{detailTab === 'records' ? 'selected' : ''}}" data-tab="records" bindtap="selectDetailTab">{{ui['任务运行记录']}}</button></view>
    <scroll-view scroll-y class="sched-sheet-scroll"><view class="sched-detail-body">
      <block wx:if="{{detailTab === 'rule'}}"><view class="sched-next"><text>{{selected.status === 'active' ? ui['下次运行'] : ui['任务状态']}}</text><text>{{ui[selected.nextLabel] !== undefined ? ui[selected.nextLabel] : selected.nextLabel}}</text></view><text class="sched-field-label">{{ui['自动化任务内容']}}</text><text class="sched-instruction" selectable>{{selected.prompt}}</text><view class="sched-facts"><view class="sched-fact-row"><text class="sched-fact-label">{{ui['提醒频率']}}</text><text class="sched-fact-value">{{ui[selected.ruleFull] !== undefined ? ui[selected.ruleFull] : selected.ruleFull}}</text></view><view class="sched-fact-row"><text class="sched-fact-label">{{ui['状态']}}</text><text class="sched-fact-value">{{ui[selected.statusLabel] !== undefined ? ui[selected.statusLabel] : selected.statusLabel}}</text></view><view class="sched-fact-row"><text class="sched-fact-label">{{ui['任务 ID']}}</text><text class="sched-fact-value" selectable>{{selected.id}}</text></view></view><button class="sched-session" bindtap="openLinkedSession" disabled="{{!connected}}"><view class="sched-session-copy"><text class="sched-field-label">{{ui['关联会话']}}</text><text>{{selected.sessionLabel}}</text></view><text class="sched-session-action">{{ui['打开 ›']}}</text></button><text wx:if="{{!selected.canEdit}}" class="sched-muted">{{ui['已结束的任务为只读，无法修改时间。']}}</text></block>
      <block wx:else><view class="sched-history-head"><text class="sched-field-label">{{ui['已保存的任务运行记录']}}</text><button class="sched-link" bindtap="refreshHistory" disabled="{{historyLoading || !connected}}">{{ui['刷新']}}</button></view><view wx:if="{{historyError}}" class="sched-error"><text>{{ui[historyError] !== undefined ? ui[historyError] : historyError}}</text><button class="sched-link" bindtap="refreshHistory" disabled="{{!connected}}">{{ui['重试']}}</button></view><view wx:if="{{!history.length && !historyLoading && !historyError}}" class="sched-state"><image class="sched-state-ic" src="/assets/icons/sched-clock-gray.png" mode="aspectFit"/><text>{{ui['暂无任务运行记录']}}</text></view><view wx:for="{{history}}" wx:key="messageId" class="sched-history-row"><view class="sched-history-dot"></view><view class="sched-history-copy"><text class="sched-history-date">{{ui[item.dateLabel] !== undefined ? ui[item.dateLabel] : item.dateLabel}}</text><text wx:if="{{item.prompt}}" class="sched-history-prompt {{item.expanded ? 'expanded' : ''}}" selectable>{{item.prompt}}</text><button wx:if="{{item.prompt}}" class="sched-link" data-id="{{item.messageId}}" bindtap="expandHistory">{{item.expanded ? ui['收起'] : ui['展开']}}</button></view></view><view wx:if="{{historyLoading}}" class="sched-loading"><view class="sched-spinner"></view><text>{{ui['正在加载记录…']}}</text></view><button wx:if="{{historyNext && !historyError}}" class="sched-outline sched-more" bindtap="moreHistory" disabled="{{historyLoading || !connected}}">{{ui['加载更多']}}</button><view wx:if="{{historyPruned && !historyNext}}" class="sched-retention"><text>{{ui['更早的运行记录已清理']}}</text><text>{{ui[historyRetention] !== undefined ? ui[historyRetention] : historyRetention}}</text><text>{{ui['清理记录不影响任务继续运行。']}}</text></view></block>
    </view></scroll-view><view class="sched-detail-footer"><button class="sched-delete" bindtap="onDeleteTap" disabled="{{!connected || busyId}}">{{ui['删除任务']}}</button><button class="sched-primary" bindtap="onEditTap" disabled="{{!selected.canEdit || !connected || busyId}}">{{ui['编辑规则']}}</button></view>
  </view></view>
  <view wx:if="{{editingOpen}}" class="sched-overlay edit-overlay"><view class="sched-mask" bindtap="onEditCancel" catchtouchmove="noop"></view><view class="sched-sheet"><view class="sched-handle"></view><view class="sched-sheet-head"><text class="sched-detail-title">{{ui['编辑自动化任务']}}</text><button class="sched-close" bindtap="onEditCancel" disabled="{{editing.saving}}" aria-label="{{ui['取消编辑']}}">×</button></view><scroll-view scroll-y class="sched-sheet-scroll"><view class="sched-edit-form">
    <text class="sched-field-label">{{ui['任务名称']}}</text><input class="sched-input" value="{{editing.title}}" maxlength="120" data-field="title" bindinput="editField" disabled="{{editing.saving}}" placeholder="{{ui['最多 120 个字符']}}"/>
    <text class="sched-field-label">{{ui['任务内容']}}</text><textarea class="sched-textarea" value="{{editing.prompt}}" maxlength="-1" data-field="prompt" bindinput="editField" disabled="{{editing.saving}}" placeholder="{{ui['希望 Agent 执行的内容']}}"/>
    <text class="sched-field-label">{{ui['运行时间']}}</text><picker range="{{rules}}" range-key="title" value="{{editing.ruleIndex}}" bindchange="pickRule" disabled="{{editing.saving}}"><view class="sched-picker"><text>{{ui['重复']}}</text><text>{{rules[editing.ruleIndex].title}}⌄</text></view></picker>
    <block wx:if="{{editing.kind === 'at'}}"><picker mode="date" value="{{editing.date}}" bindchange="pickDate" disabled="{{editing.saving}}"><view class="sched-picker"><text>{{ui['日期']}}</text><text>{{editing.date}}⌄</text></view></picker></block>
    <block wx:if="{{editing.kind === 'every'}}"><view class="sched-interval"><input class="sched-input" type="digit" value="{{editing.interval}}" data-field="interval" bindinput="editField" disabled="{{editing.saving}}"/><picker range="{{units}}" value="{{editing.unitIndex}}" bindchange="pickUnit" disabled="{{editing.saving}}"><view class="sched-picker">{{units[editing.unitIndex]}}⌄</view></picker></view><text class="sched-muted">{{ui['至少 60 秒。间隔从创建或上次修改规则时起计，不受时区影响。']}}</text></block>
    <block wx:elif="{{editing.kind === 'cron'}}"><input class="sched-input" value="{{editing.expression}}" data-field="expression" bindinput="editField" disabled="{{editing.saving}}" placeholder="0 9 * * 1-5"/><text class="sched-muted">{{ui['5 字段 Cron：分钟、小时、日、月、星期。']}}</text></block>
    <block wx:else><text class="sched-field-label">{{ui['执行时刻']}}</text><input class="sched-input" value="{{editing.time}}" data-field="time" bindinput="editField" disabled="{{editing.saving}}" placeholder="09:00:00" maxlength="8"/></block>
    <view wx:if="{{editing.kind === 'weekly'}}" class="sched-week"><button wx:for="{{weekOptions}}" wx:key="day" class="{{item.selected ? 'selected' : ''}}" data-day="{{item.day}}" bindtap="pickWeek" disabled="{{editing.saving}}">{{item.title}}</button></view>
    <block wx:if="{{editing.kind !== 'every'}}"><text class="sched-field-label">{{ui['时区']}}</text><input class="sched-input" value="{{editing.zone}}" data-field="zone" bindinput="editField" disabled="{{editing.saving}}" placeholder="Asia/Shanghai"/><text class="sched-muted">{{ui['按此 IANA 时区解释时间。主机将校验时区、夏令时和未来执行时间。']}}</text></block>
    <text wx:if="{{editing.error}}" class="sched-error">{{ui[editing.error] !== undefined ? ui[editing.error] : editing.error}}</text>
  </view></scroll-view><view class="sched-edit-footer"><button class="sched-outline" bindtap="onEditCancel" disabled="{{editing.saving}}">{{ui['取消']}}</button><button class="sched-primary" bindtap="onEditSave" disabled="{{!editing.canSave || editing.saving || !connected}}">{{editing.saving ? ui['保存中…'] : ui['保存修改']}}</button></view></view></view>
</view>
