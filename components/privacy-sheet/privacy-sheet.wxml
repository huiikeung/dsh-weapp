<view wx:if="{{mounted}}" class="privacy-overlay {{closing ? 'privacy-overlay-closing' : ''}} {{theme === 'dark' ? 'privacy-dark' : 'privacy-light'}}" catchtouchmove="noop">
  <view class="privacy-sheet {{dragging ? 'privacy-sheet-dragging' : ''}}" style="padding-top:{{topInset}}px;transform:translateY({{dragOffset}}px);" role="dialog" aria-label="隐私政策">
    <view class="privacy-grabber-area" catchtouchstart="onDragStart" catchtouchmove="onDragMove" catchtouchend="onDragEnd" catchtouchcancel="onDragCancel" aria-label="下拉关闭隐私政策">
      <view class="privacy-grabber"></view>
    </view>
    <view class="privacy-header">
      <view class="privacy-heading"><text class="privacy-eyebrow">鲸尾助手小程序版</text><text class="privacy-title">隐私政策</text></view>
      <button class="privacy-close" bindtap="close" hover-class="privacy-pressed" aria-label="关闭隐私政策">关闭</button>
    </view>
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="privacy-scroll" scroll-top="{{scrollTop}}">
      <view class="privacy-content">
        <text class="privacy-updated">更新日期：{{policy.updatedAt}}</text>
        <text class="privacy-intro" selectable>{{policy.intro}}</text>
        <view wx:for="{{policy.sections}}" wx:key="id" class="privacy-section">
          <text class="privacy-section-title">{{item.title}}</text>
          <text wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="privacy-paragraph" selectable>{{paragraph}}</text>
        </view>
        <view class="privacy-links">
          <button class="privacy-link" bindtap="openPlatformPrivacy" hover-class="privacy-pressed">查看微信平台隐私指引</button>
          <button class="privacy-link" open-type="contact" session-from="whaletail-privacy" binderror="onContactError" hover-class="privacy-pressed">联系隐私与客服支持</button>
        </view>
        <text class="privacy-footer">关闭此页仅表示结束阅读，不代表同意授权。</text>
      </view>
    </scroll-view>
  </view>
</view>
