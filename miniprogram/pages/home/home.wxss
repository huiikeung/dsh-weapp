/* 内容水平边距对齐 iOS WorkspaceView：.padding(.horizontal, 22) = 44rpx */
.home {
  padding: 30rpx 44rpx 60rpx;
}

/* ---------- 侧边栏（对齐 dsh-mobile WorkspaceView drawer） ---------- */

.home-root {
  position: relative;
  height: 100vh;
  overflow: hidden;
  /* 内容右移后露出的底层：与深海内容同色，交界处不出现白边 */
  background: var(--navy);
}

.home-content-wrap {
  position: relative;
  height: 100vh;
  background: var(--navy);
  transition: border-radius 0.38s cubic-bezier(0.32, 0.72, 0, 1);
}

.home-content-wrap.shifted {
  border-radius: 96rpx;
  overflow: hidden;
  box-shadow: -4rpx 0 18rpx rgba(0, 0, 0, 0.12), -8rpx 0 52rpx rgba(0, 0, 0, 0.30);
}

/* 深海背景随内容位移：fixed → absolute（相对位移容器） */
.home-deep-bg {
  position: absolute;
  z-index: 0;
}

.home-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
}

.drawer-anim {
  transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1);
}

.drawer {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 52;
  background: #FFFFFF;
  transform: translateX(-100%);
}

.drawer-visible {
  box-shadow: 8rpx 0 40rpx rgba(0, 0, 0, 0.18);
}

.drawer-body {
  padding: calc(20rpx + env(safe-area-inset-top)) 36rpx calc(24rpx + env(safe-area-inset-bottom));
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.drawer-footer { width: 100%; margin-top: auto; padding-top: 24rpx; flex-shrink: 0; }
.drawer-settings { box-sizing: border-box; }

.drawer-brand {
  display: flex;
  align-items: center;
  padding: 0 0 32rpx 24rpx;
  width: 100%;
}

.drawer-whale {
  width: 58rpx;
  height: 58rpx;
  margin-right: 7rpx;      /* 缩小一半，与首页一致 */
  margin-top: -8rpx;
  flex: none;
}

.drawer-brand-badge {
  color: #FFFFFF;
  background: #10151F;
  border: 0;
  border-radius: 8rpx;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 30rpx;
  height: 30rpx;
  padding: 0 12rpx;
  margin-top: 1rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.drawer-whale-dark {
  display: none;
}

.drawer-item {
  display: flex;
  align-items: center;
  width: 100%;
  height: 104rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
}

.drawer-item-active {
  background: rgba(16, 19, 24, 0.06);
}

.drawer-item-ic {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.drawer-item-ic-clock {
  width: 44rpx;
  height: 44rpx;
  margin-left: 0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.drawer-item-ic-dark {
  display: none;
}

.drawer-item-text {
  font-size: 34rpx;
  color: var(--ink);
}

.drawer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.16);
}

.brand-dim {
  opacity: 0.7;
}


/* 顶部品牌行：固定在导航区（与胶囊同行），左边距与内容区对齐，不随内容滚动 */
.topbar {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  /* 与内容区同边距：品牌行 / 选择主机 / 标题 / 卡片左边缘严格对齐 */
  padding-left: 44rpx;
  padding-right: 44rpx;
  /* 透明：让深海背景自然延续到顶，不再出现深色条断层 */
  background: transparent;
}

.host-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.host-row .host-bar {
  margin-bottom: 0;
  min-width: 0;
}

.host-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-mark {
  font-size: 40rpx;
  margin-right: 14rpx;
}

.brand-badge {
  color: #10151F;
  background: #FFFFFF;
  border: 0;
  border-radius: 8rpx;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 30rpx;
  height: 30rpx;          /* 与 whaletail 大写字高一致 */
  padding: 0 12rpx;
  margin-top: 1rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

/* ---------- 配对菜单（对齐 dsh-mobile GatewayAuthenticationMenu） ---------- */

.pair-wrap {
  position: relative;
}

.pair-menu-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
}

/* 配对菜单：与底部弹窗同款深炭玻璃（深色底 + 强模糊 + 发丝亮边） */
.pair-menu {
  position: absolute;
  top: calc(100% + 12rpx);
  right: 0;
  z-index: 100;
  width: 496rpx;
  padding: 12rpx 0;
  background: rgba(10, 14, 24, 0.30);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx) saturate(1.2);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.2);
  border-radius: 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30);
  overflow: hidden;
}

.pair-menu-item {
  display: flex;
  align-items: center;
  height: 116rpx;
  padding: 0 44rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.pair-menu-item-active {
  background: rgba(255, 255, 255, 0.08);
}

.pair-menu-ic {
  width: 36rpx;          /* 固定宽度：保证右侧文字对齐 */
  height: 36rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 扫描图标：CSS 绘制，矢量清晰（四角括 + 3 定位块 + 点阵） */
.ico-scan {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.ico-scan .corner {
  position: absolute;
  width: 11rpx;
  height: 11rpx;
  border: 3rpx solid #FFFFFF;
  box-sizing: border-box;
}

.ico-scan .corner.tl { left: 0; top: 0; border-right: 0; border-bottom: 0; border-top-left-radius: 5rpx; }
.ico-scan .corner.tr { right: 0; top: 0; border-left: 0; border-bottom: 0; border-top-right-radius: 5rpx; }
.ico-scan .corner.bl { left: 0; bottom: 0; border-right: 0; border-top: 0; border-bottom-left-radius: 5rpx; }
.ico-scan .corner.br { right: 0; bottom: 0; border-left: 0; border-top: 0; border-bottom-right-radius: 5rpx; }

.ico-scan .find {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #FFFFFF;
  box-sizing: border-box;
  border-radius: 2rpx;
}

.ico-scan .find::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 3rpx;
  margin-left: -1.5rpx;
  margin-top: -1.5rpx;
  background: #FFFFFF;
  border-radius: 1rpx;
}

.ico-scan .find.a { left: 7rpx; top: 7rpx; }
.ico-scan .find.b { right: 7rpx; top: 7rpx; }
.ico-scan .find.c { left: 7rpx; bottom: 7rpx; }

.ico-scan .dots {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 2rpx;
}

.ico-scan .dots view {
  width: 3rpx;
  height: 3rpx;
  background: #FFFFFF;
  border-radius: 1rpx;
}

/* 键盘图标：CSS 绘制（圆角外框 + 两排键 + 空格条） */
.ico-keyboard {
  position: relative;
  width: 36rpx;                 /* 与另两个图标等宽 */
  height: 26rpx;
  box-sizing: border-box;
  border: 2rpx solid #FFFFFF;
  border-radius: 6rpx;
  padding: 4rpx 4rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ico-keyboard .kb-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ico-keyboard .kb-row view {
  width: 4rpx;
  height: 4rpx;
  background: #FFFFFF;
  border-radius: 1rpx;
}

.ico-keyboard .kb-last {
  justify-content: space-between;
}

.ico-keyboard .kb-bar {
  flex: 1;
  width: auto;
  height: 4rpx;
  margin: 0 2rpx;
  border-radius: 2rpx;
}

.icon-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 18rpx;
  flex-shrink: 0;
  font-size: 38rpx;
  /* Liquid Glass 圆钮：左上高光渐变 + 顶部内发光 + 发丝亮边 */
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 8rpx 24rpx rgba(3, 14, 30, 0.24);
}

/* Hero（iOS：32pt bold 标题 + subheadline 副标题；区块间距 18pt = 36rpx） */
.hero {
  margin-bottom: 36rpx;
}

.title-hero {
  color: #FFFFFF;
  font-size: 64rpx;      /* iOS 32pt bold */
  font-weight: 700;
  letter-spacing: 0;
}

.subtitle-hero {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 30rpx;
}

/* 工作区卡片（与新建会话同款玻璃：渐变高光 + 顶部内发光 + 模糊提饱和） */
.workspace-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;   /* 高度减小一点 */
  margin-bottom: 36rpx;
  border-radius: 36rpx;
  /* 与「新建会话」同一套 Liquid Glass：高光渐变 + 发丝亮边 + 内高光 */
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 8rpx 32rpx rgba(3, 14, 30, 0.18);
}

.ws-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.ws-body {
  flex: 1;
  min-width: 0;
}

.ws-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.ws-path {
  color: rgba(255, 255, 255, 0.55);
  font-size: 24rpx;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ws-right {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.ws-chevron {
  width: 30rpx;
  height: 30rpx;
  margin-left: 18rpx;
}

/* 新建会话（iOS glassSurface radius 18pt + white 8% tint） */
.new-session {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  border-radius: 32rpx;
  padding: 18rpx 0;      /* 卡片高度减小 */
  margin-bottom: 36rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16), 0 8rpx 32rpx rgba(3, 14, 30, 0.18);
  transition: transform 0.18s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.18s ease;
}

.new-session:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.plus-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(255, 255, 255, 0.20);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 22rpx;
}

.new-session-text {
  color: #FFFFFF;
  font-size: 30rpx;      /* iOS headline 17pt */
  font-weight: 600;
}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.conn-label {
  font-size: 24rpx;      /* iOS caption 12pt */
}

.conn-label.connected { color: var(--success); }
.conn-label.connecting { color: var(--amber); }
.conn-label.disconnected { color: rgba(255, 255, 255, 0.60); }
.conn-label.failed { color: #FF8589; }

.status-dot.connecting { background: var(--amber); }
.status-dot.disconnected { background: rgba(255, 255, 255, 0.34); }
.status-dot.failed { background: #FF8589; }

/* 搜索框（与新建会话同款玻璃：渐变高光 + 顶部内发光 + 模糊提饱和） */
.search-box {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  margin-bottom: 36rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 8rpx 32rpx rgba(3, 14, 30, 0.16);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-result-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

/* 配对按钮：对齐 dsh-mobile GlassCircleButton 52dp/22dp 比例 */
.pair-ic {
  width: 48rpx;
  height: 48rpx;
}

.plus-img {
  width: 30rpx;
  height: 30rpx;
}

.search-input {
  flex: 1;
  color: #FFFFFF;
  font-size: 34rpx;      /* iOS body 17pt */
}

.home-data-hint {
  margin: -20rpx 0 16rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 24rpx;
}

/* 会话行（iOS sessionRow：padding-v 10pt / 间距 11pt / 点 7pt /
   分隔线 white 10% 缩进 18pt） */
.session-row {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  position: relative;
  background: transparent;
  border-radius: 16rpx;
}

.session-row::after {
  content: '';
  position: absolute;
  left: 36rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.10);
}

.session-row:last-child::after {
  display: none;
}

.session-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  margin-right: 22rpx;
  flex-shrink: 0;
}

.session-dot.running {
  background: var(--success);
  box-shadow: 0 0 10rpx rgba(46, 184, 92, 0.65);
}

.session-dot.unread {
  background: var(--ocean);
}

.session-body {
  flex: 1;
  min-width: 0;
}

.session-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-sub {
  color: rgba(255, 255, 255, 0.42);
  font-size: 22rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  color: rgba(255, 255, 255, 0.48);
  font-size: 24rpx;
  margin-left: 18rpx;
  flex-shrink: 0;
}

.session-time.running {
  color: #0A84FF;
}

/* 空态（iOS emptySessions：white 4% 底 / radius 15pt / padding 18pt / 左对齐） */
.empty {
  color: rgba(255, 255, 255, 0.5);
  text-align: left;
  padding: 36rpx;
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 30rpx;
}

/* ---------- 切换主机（GatewaySwitcherBar / Sheet） ---------- */

.host-bar {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025));
  border: 1rpx solid rgba(255, 255, 255, 0.20);
  border-radius: 999rpx;
  margin-bottom: 48rpx;
  backdrop-filter: blur(3rpx);
  -webkit-backdrop-filter: blur(3rpx);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14), 0 8rpx 24rpx rgba(3, 14, 30, 0.22);
}

.host-kind {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.host-name {
  color: #FFFFFF;
  font-size: 24rpx;
  max-width: 340rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.host-dot {
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #8E8E93;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.host-dot.on {
  background: var(--success);
}

.host-chev {
  width: 22rpx;
  height: 22rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.host-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 60;
}

/* 主机切换 sheet（对齐 iOS 高 detent 弹层：深炭玻璃 + 抓手 +
   居中标题 + 左侧编辑玻璃钮 + 内嵌分组卡片；
   默认紧凑高度，抓手拖拽/点击展开到近全屏） */
.host-sheet {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 61;
  display: flex;
  flex-direction: column;
  height: auto;
  min-height: 46vh;      /* 默认高度更高 */
  max-height: 86vh;
  background: rgba(10, 14, 24, 0.30);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx) saturate(1.2);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.2);
  border-radius: 40rpx;
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.30);
  transition: height 0.5s cubic-bezier(0.32, 0.72, 0, 1);
}

.host-sheet.expanded {
  height: calc(100vh - 200rpx);
}

.workspace-picker-sheet.expanded {
  height: calc(100vh - 200rpx);
}

.sheet-grabber-zone {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 4rpx;
  flex-shrink: 0;
}

.host-sheet-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  flex-shrink: 0;
}

.host-sheet-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  pointer-events: none;
}

.host-sheet-left {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.host-sheet-edit {
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.30);
}

.host-sheet-right {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.host-sheet-del {
  color: #FF3B30;
  font-size: 28rpx;
  margin-left: 20rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(165deg, rgba(255, 59, 48, 0.22), rgba(255, 59, 48, 0.10));
  border: 1rpx solid rgba(255, 59, 48, 0.45);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.host-diag {
  font-size: 24rpx;
  color: rgba(255, 176, 92, 0.95);
  padding: 10rpx 6rpx 0;
}

.host-section-label {
