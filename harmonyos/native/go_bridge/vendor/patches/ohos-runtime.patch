diff --git a/version/prop.go b/version/prop.go
index 59ca740..315ea15 100644
--- a/version/prop.go
+++ b/version/prop.go
@@ -54,6 +54,11 @@ func OS() string {
 	if runtime.GOOS == "darwin" {
 		return "macOS"
 	}
+	// OpenHarmony 的 Go 移植在工具链里以 build tag 区分，runtime.GOOS 仍是 linux；
+	// 这里显式上报 HarmonyOS，控制台/设备列表才不会被识别成 Linux。
+	if openharmonyBuild {
+		return "HarmonyOS"
+	}
 	return runtime.GOOS
 }
 
