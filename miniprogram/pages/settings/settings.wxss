.preference-option { display: flex; justify-content: space-between; padding: 20rpx; font-size: 28rpx; }
.preference-check { color: var(--ocean); }
.preference-description { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; flex: 1; }
.preference-hint { font-size: 23rpx; line-height: 1.5; color: var(--text-3); }
.preference-font-row { gap: 20rpx; }
.font-stepper { display: flex; align-items: center; flex-shrink: 0; gap: 12rpx; }
.font-step { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; margin: 0; padding: 0; background: var(--fill-2); border-radius: 12rpx; font-size: 30rpx; line-height: 1; color: var(--text); }
.font-step::after { border: none; }
.font-step[disabled] { color: var(--text-4); opacity: .4; background: var(--fill-2); }
.font-value { min-width: 80rpx; text-align: center; font-size: 28rpx; font-variant-numeric: tabular-nums; }
