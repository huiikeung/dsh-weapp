      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
    <button class="card-row about-contact" open-type="contact" session-from="whaletail-settings" binderror="onContactError" hover-class="management-entry-active">
      <text class="card-row-label">{{ui['联系客服']}}</text>
      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </button>
    <view class="card-row">
      <text class="card-row-label">{{ui['客户端']}}</text>
      <text class="card-row-value">{{ui['鲸尾助手小程序版']}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">{{ui['当前版本']}}</text>
      <text class="card-row-value">{{appVersion}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">{{ui['要求网关版本']}}</text>
      <text class="card-row-value about-version-value">{{minGatewayVersion}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">{{ui['已连接网关版本']}}</text>
      <text class="card-row-value">{{connectedGatewayVersion}}</text>
    </view>
    <view class="card-row" bindtap="openPrivacyPolicy" role="button" aria-label="{{ui['查看隐私政策']}}">
      <text class="card-row-label">{{ui['隐私政策']}}</text>
      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
  </view>
  <view class="group-hint">{{ui[gatewayVersionHint] !== undefined ? ui[gatewayVersionHint] : gatewayVersionHint}}</view>
  <privacy-sheet id="settings-privacy" visible="{{privacyOpen}}" theme="{{theme}}" bindclose="closePrivacyPolicy" />

  <view wx:if="{{managementPanel && !pairSheetOpen}}" class="pair-sheet-mask" catchtap="closeManagementPanel" catchtouchmove="noop">
    <view class="pair-sheet management-sheet resizable {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}" style="height: calc({{sheetExpanded.management ? 90 : 62}}vh - var(--glass-sheet-drop, 0px));" catchtap="noop">
      <view class="sheet-grabber-zone" data-sheet="management" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{managementPanel === 'public' ? ui['公网访问'] : (managementPanel === 'gateway' ? ui['网关连接'] : ui['节点管理'])}}</text>
          <text class="pair-sheet-subtitle">{{managementPanel === 'public' ? ui['管理当前微信账号的公网有效期'] : (managementPanel === 'gateway' ? nodeDetail.name : ui['点击节点查看连接信息与操作'])}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeManagementPanel" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <view class="management-scroll">
        <block wx:if="{{managementPanel === 'public'}}">
          <view class="card public-card">
            <view class="public-head">
              <image class="public-icon" src="/assets/icons/node-router.svg" mode="aspectFit"/>
              <view class="public-main">
                <text class="public-title">{{publicTitle}}</text>
                <text class="public-sub">{{publicSub}}</text>
              </view>
            </view>
            <view class="public-detail-row">
              <text class="public-detail-label">{{ui['访问状态']}}</text>
              <view class="public-pill {{publicOn ? 'on' : ''}}">
                <view class="public-pill-dot"></view>
                <text>{{ui[publicStatusLabel] !== undefined ? ui[publicStatusLabel] : publicStatusLabel}}</text>
              </view>
            </view>
            <view class="public-detail-row public-device-row">
              <text class="public-detail-label">{{ui['设备ID']}}</text>
              <text class="public-device-value text-mono" selectable>{{accountDeviceId || (accountBusy ? ui['识别中…'] : (accountIdHint || ui['暂未识别，请重试']))}}</text>
              <text wx:if="{{accountDeviceId}}" class="public-copy-id" data-id="{{accountDeviceId}}" bindtap="copyNodeId">{{ui['复制']}}</text>
            </view>
            <view wx:if="{{publicExpiryLabel}}" class="public-detail-row">
              <text class="public-detail-label">{{ui['访问有效期']}}</text>
              <text class="public-detail-value">{{ui[publicExpiryLabel] !== undefined ? ui[publicExpiryLabel] : publicExpiryLabel}}</text>
            </view>
            <view class="public-actions">
              <button wx:if="{{referralEnabled}}" class="public-share" bindtap="openReferralShare" hover-class="public-share-hover">{{ui['分享']}}</button>
              <button wx:if="{{!redeemFormOpen}}" class="public-redeem" disabled="{{redeemBusy}}" bindtap="redeemRenewal" hover-class="public-share-hover">
                {{redeemBusy ? ui['兑换中…'] : (redeemAvailable ? ui['兑换续期'] : ui['兑换说明'])}}
              </button>
            </view>
            <view wx:if="{{redeemFormOpen}}" class="public-redeem-form">
              <view class="public-redeem-form-head">
                <text class="public-redeem-form-title">{{ui['兑换公网有效期']}}</text>
                <text class="public-redeem-form-cancel" bindtap="closeRedeemForm" role="button">{{ui['取消']}}</text>
              </view>
              <input
                class="public-redeem-input"
                value="{{redeemCode}}"
                bindinput="onRedeemInput"
                maxlength="40"
                placeholder="XXXX-XXXX-XXXX"
                placeholder-class="public-redeem-placeholder"
                confirm-type="done"
                bindconfirm="submitRedeem"
                cursor-spacing="24"
              />
              <view class="public-redeem-form-hint">{{ui['输入管理员提供的兑换码']}}</view>
              <button class="public-redeem-submit" bindtap="submitRedeem" disabled="{{redeemBusy}}">{{redeemBusy ? ui['兑换中…'] : ui['兑换续期']}}</button>
            </view>
            <view wx:if="{{redeemResultLabel}}" class="public-redeem-result">{{ui[redeemResultLabel] !== undefined ? ui[redeemResultLabel] : redeemResultLabel}}</view>
            <view wx:if="{{referralEnabled && sharePayload}}" class="public-share-meta">
              <text class="public-share-expiry">{{ui[shareExpiresLabel] !== undefined ? ui[shareExpiresLabel] : shareExpiresLabel}}</text>
              <view class="public-share-actions">
                <button open-type="share">{{ui['转发']}}</button>
                <text class="public-share-copy" bindtap="copyNodeShare">{{ui['复制邀请']}}</text>
              </view>
            </view>
          </view>
          <view class="group-hint">{{ui[publicHint] !== undefined ? ui[publicHint] : publicHint}}</view>
        </block>
        <block wx:elif="{{managementPanel === 'nodes'}}">
          <view class="node-group-title">
            <text class="node-count">{{onlineNodeCount}} {{ui['在线 ·']}} {{nodeCount}} {{ui['个节点']}}</text>
            <view class="node-head-actions">
              <text wx:if="{{!nodeEditMode}}" class="node-refresh" bindtap="refreshNodes" role="button">{{ui['刷新']}}</text>
              <text
                wx:if="{{nodeEditMode && nodeSelection.length}}"
                class="node-delete-inline"
                bindtap="deleteSelectedNodes"
                role="button"
              >{{nodeSelection.length > 1 ? ui['删除 '] + nodeSelection.length + ui[' 个'] : ui['删除']}}</text>
              <text wx:if="{{nodes.length}}" class="node-edit-toggle" bindtap="toggleNodeEditMode" role="button">{{nodeEditMode ? ui['完成'] : ui['编辑']}}</text>
            </view>
          </view>
          <view class="card node-list-card">
            <view wx:if="{{!nodes.length}}" class="node-empty">
              <text class="node-empty-title">{{ui['还没有已配对节点']}}</text>
              <text class="node-empty-desc">{{ui['点击下方「添加节点」，按引导完成电脑端准备后扫码配对。']}}</text>
            </view>
            <view wx:for="{{nodes}}" wx:key="id" class="node-row {{item.active ? 'node-row-active' : ''}}" data-id="{{item.id}}" bindtap="selectNode" hover-class="management-entry-active" role="button" aria-label="{{ui['查看']}}{{item.name}}{{ui['连接详情']}}">
              <view wx:if="{{nodeEditMode}}" class="node-select" catchtap="toggleNodeSelect" data-id="{{item.id}}">
                <image class="node-select-ic" src="/assets/icons/{{item.selected ? 'circle-filled-white.png' : 'circle-white.png'}}"/>
              </view>
              <!-- 状态点直接放在行里：行是 align-items:center，所以它相对整张卡片垂直居中，
                   而不是贴着「名称」那一行（卡片有两行：名称 + 节点 ID）。 -->
              <view class="status-dot node-dot {{item.online ? 'connected' : 'disconnected'}}"></view>
              <view class="node-main">
                <view class="node-name-line">
                  <text class="node-name">{{item.name}}</text>
                  <text wx:if="{{item.active}}" class="node-current">{{ui['当前']}}</text>
                </view>
                <text class="node-id text-mono">{{item.gatewayId || item.id}}</text>
              </view>
              <view class="node-actions">
                <text class="node-status">{{ui[item.statusLabel] !== undefined ? ui[item.statusLabel] : item.statusLabel}}</text>
                <text class="node-copy" data-id="{{item.gatewayId || item.id}}" catchtap="copyNodeId">{{ui['复制 ID']}}</text>
              </view>
              <image wx:if="{{!nodeEditMode}}" class="node-detail-chevron" src="/assets/icons/chev-right-gray.png"/>
            </view>
          </view>
          <view class="node-pair-actions">
            <button class="node-pair-button" bindtap="addNode" hover-class="node-add-active">
              <text class="node-add-plus">+</text>
              <text class="node-add-text">{{ui['添加节点']}}</text>
            </button>
          </view>
        </block>
        <block wx:elif="{{managementPanel === 'gateway' && nodeDetail}}">
          <view class="card gateway-detail-card">
            <view wx:if="{{nodeDetail.isPublic}}" class="card-row gateway-identity-row">
              <text class="gateway-identity-label">{{ui['公网标识']}}</text>
              <text class="gateway-identity-value text-mono" selectable>{{nodeDetail.identifier}}</text>
              <text class="node-copy gateway-copy" data-id="{{nodeDetail.identifier}}" bindtap="copyNodeId" role="button">{{ui['复制']}}</text>
            </view>
            <view wx:else class="card-row">
              <text class="card-row-label gw-url text-mono" selectable>{{nodeDetail.endpoint || ui['未配置']}}</text>
            </view>
            <view class="card-row gateway-status-row">
              <view class="card-row-label gw-status"><view class="status-dot {{nodeDetail.connection}}"></view><text>{{ui[nodeDetail.connectionLabel] !== undefined ? ui[nodeDetail.connectionLabel] : nodeDetail.connectionLabel}}</text></view>
              <view class="card-row-value"><text wx:if="{{!nodeDetail.isPublic && nodeDetail.port}}">Port {{nodeDetail.port}}</text><text wx:elif="{{nodeDetail.isPublic}}">{{ui['公网连接']}}</text></view>
            </view>
            <button wx:if="{{!nodeDetail.canDisconnect}}" class="card-row gateway-action" bindtap="connectNode" hover-class="management-entry-active"><text class="btn-text">{{nodeDetail.active ? ui['重新连接'] : ui['连接此节点']}}</text></button>
            <button wx:else class="card-row gateway-action" bindtap="disconnect" hover-class="management-entry-active"><text class="btn-text">{{ui['断开连接']}}</text></button>
            <button class="card-row gateway-action" bindtap="pingGateway" disabled="{{!nodeDetail.canPing || nodePingBusy}}" hover-class="management-entry-active"><text class="btn-text">{{nodePingBusy ? ui['Ping 检测中…'] : ui['Ping 网关']}}</text></button>
            <button class="card-row gateway-action" bindtap="forgetDevice" hover-class="management-entry-active"><text class="btn-text-danger">{{ui['忘记此设备']}}</text></button>
          </view>
          <view class="group-hint">{{nodeDetail.isPublic ? ui['通过公网标识识别节点，不展示公网地址。'] : ui['局域网连接保留原地址与端口；不会消耗公网有效期。']}}</view>
        </block>
      </view>
    </view>
  </view>

  <view wx:if="{{referralSheetOpen}}" class="referral-mask" catchtap="closeReferralShare" catchtouchmove="noop">
    <view class="referral-sheet {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}" catchtap="noop">
      <view class="sheet-grabber"></view>
      <text class="referral-title">{{ui['分享']}}</text>
      <text class="referral-subtitle">{{ui['已累计获得']}} {{referralDays}} {{ui['天公网访问']}}</text>
      <text wx:if="{{referralBusy || referralError}}" class="referral-subtitle">{{referralBusy ? ui['正在获取分享信息…'] : referralError}}</text>
      <button class="referral-option" open-type="share" data-referral="true" disabled="{{!referralToken || referralBusy}}">
        <view class="referral-copy"><text>{{ui['好友或群聊']}}</text><text class="referral-desc">{{referralHint || ui['朋友首次有效打开后，自动增加公网时长']}}</text></view><text class="referral-chevron">›</text>
      </button>
      <button class="referral-option" bindtap="openMomentsActivity"><view class="referral-copy"><text>{{ui['朋友圈']}}</text><text class="referral-desc">{{ui['保留满 24 小时，提交凭证审核领取']}}</text></view><text class="referral-chevron">›</text></button>
      <button class="referral-rules" bindtap="openShareRules">{{ui['活动规则']}}</button>
      <button class="referral-cancel" bindtap="closeReferralShare">{{ui['取消']}}</button>
    </view>
  </view>
  <!-- 开发者公告弹窗 -->
  <view wx:if="{{devAnnSheet}}" class="pair-sheet-mask" catchtap="closeDevAnnouncements" catchtouchmove="noop">
    <view class="pair-sheet devann-sheet {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}" catchtap="noop" catchtouchmove="noop" role="dialog" aria-label="{{ui['开发者公告']}}">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <text class="pair-sheet-title">{{ui['开发者公告']}}</text>
        <view class="pair-sheet-close tap" bindtap="closeDevAnnouncements" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <scroll-view class="devann-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{devAnnLoading}}" class="code-message">{{ui['正在加载公告…']}}</view>
        <view wx:if="{{devAnnError}}" class="code-message error">{{ui[devAnnError] !== undefined ? ui[devAnnError] : devAnnError}}</view>
        <view wx:if="{{!devAnnLoading && !devAnnError && !devAnnItems.length}}" class="devann-empty">
          <text class="devann-empty-title">{{ui['暂无开发者公告']}}</text>
          <text class="devann-empty-desc">{{ui['更新说明和使用提醒将发布在这里。']}}</text>
        </view>
        <view
          wx:for="{{devAnnItems}}"
          wx:key="id"
          class="devann-item"
          data-id="{{item.id}}"
          bindtap="toggleDevAnnouncement"
        >
          <view class="devann-item-head">
            <text class="devann-item-title">{{item.title}}</text>
            <text class="devann-item-time">{{item.dateLabel}}</text>
          </view>
          <text class="devann-item-body {{item.expanded ? 'expanded' : ''}}">{{item.content}}</text>
          <text class="devann-item-more">{{item.expanded ? ui['收起'] : ui['展开']}}</text>
        </view>
        <view class="devann-note">{{ui['公告不会索取密码、配对令牌或模型密钥。']}}</view>
      </scroll-view>
    </view>
  </view>

  <!-- 发布公告弹窗（管理员） -->
  <view wx:if="{{annSheet}}" class="pair-sheet-mask" catchtap="closeAnnouncementSheet" catchtouchmove="noop">
    <view class="pair-sheet ann-sheet {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}" catchtap="noop" catchtouchmove="noop" role="dialog" aria-label="{{ui['发布公告']}}">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['发布公告']}}</text>
          <text class="pair-sheet-subtitle">{{ui['发布后在「设置 → 关于 → 开发者公告」展示，与网页管理台同步。请勿发布密钥或个人隐私。']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeAnnouncementSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>

      <view wx:if="{{annLoading}}" class="code-message">{{ui['正在验证管理员身份…']}}</view>
      <view wx:if="{{annError}}" class="code-message error">{{ui[annError] !== undefined ? ui[annError] : annError}}</view>

      <block wx:if="{{annIsAdmin && !annLoading}}">
        <scroll-view class="ann-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="ann-form">
            <input
              class="ann-input"
              value="{{annTitle}}"
              bindinput="annInputTitle"
              maxlength="60"
              placeholder="{{ui['公告标题']}}"
              placeholder-class="ann-placeholder"
              disabled="{{annBusy}}"
            />
            <textarea
              class="ann-textarea"
              value="{{annContent}}"
              bindinput="annInputContent"
              maxlength="2000"
              auto-height="{{false}}"
              placeholder="{{ui['填写更新说明或使用提醒，支持换行']}}"
              placeholder-class="ann-placeholder"
              disabled="{{annBusy}}"
            ></textarea>
          </view>
          <view class="ann-actions">
            <button class="ann-primary" bindtap="annSave" disabled="{{annBusy}}">{{annBusy ? ui['保存中…'] : (annEditingId ? ui['保存修改'] : ui['发布公告'])}}</button>
            <button wx:if="{{annEditingId}}" class="ann-ghost" bindtap="annClearEditor" disabled="{{annBusy}}">{{ui['取消编辑']}}</button>
          </view>
          <view class="ann-hint">{{ui['发布后在「设置 → 关于 → 开发者公告」展示，与网页管理台同步。请勿发布密钥或个人隐私。']}}</view>

          <view class="ann-list-head">
            <text class="ann-list-title">{{ui['公告']}}</text>
            <text class="code-refresh" bindtap="loadAnnouncements">{{ui['刷新']}}</text>
          </view>
          <view wx:if="{{!annItems.length}}" class="code-message">{{ui['暂无公告，发布后会在这里显示。']}}</view>
          <view wx:for="{{annItems}}" wx:key="id" class="ann-item">
            <view class="ann-item-head">
              <text class="ann-item-title">{{item.title}}</text>
              <text class="ann-item-status">{{ui['已发布 ·']}} {{item.timeLabel}}</text>
            </view>
            <text class="ann-item-body">{{item.content}}</text>
            <view class="ann-item-actions">
              <button class="code-btn" data-id="{{item.id}}" bindtap="annEdit" disabled="{{annBusy}}">{{ui['编辑']}}</button>
              <button class="code-btn danger" data-id="{{item.id}}" bindtap="annRemove" disabled="{{annBusy}}">{{ui['删除']}}</button>
            </view>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>

  <!-- 兑换码管理弹窗（管理员） -->
  <view wx:if="{{codeSheet}}" class="pair-sheet-mask" catchtap="closeCodeManagement" catchtouchmove="noop">
    <view
      class="pair-sheet code-sheet {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}"
      catchtap="noop"
      catchtouchmove="noop"
      role="dialog"
      aria-label="{{ui['兑换码管理']}}"
    >
      <view class="sheet-grabber-zone">
        <view class="sheet-grabber"></view>
      </view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['兑换码管理']}}</text>
          <text class="pair-sheet-subtitle">{{ui['管理员生成 · 复制分发 · 用户兑换']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeCodeManagement" role="button"><view class="sheet-close-x"></view></view>
      </view>

      <view wx:if="{{codeLoading}}" class="code-message">{{ui['正在验证管理员身份…']}}</view>
      <view wx:if="{{codeError}}" class="code-message error">{{ui[codeError] !== undefined ? ui[codeError] : codeError}}</view>

      <block wx:if="{{codeIsAdmin && !codeLoading}}">
        <scroll-view class="code-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="code-form">
            <view class="card-row"><text class="card-row-label">{{ui['适用范围']}}</text><text class="code-value">{{ui['全部公网节点']}}</text></view>
            <view class="card-row" bindtap="openCodeDurationPicker" role="button" aria-label="{{ui['访问时长']}}"><text class="card-row-label">{{ui['访问时长']}}</text><text class="code-value">{{codeDurations[codeDurationIndex]}} ›</text></view>
            <view class="card-row" bindtap="openCodeCountPicker" role="button" aria-label="{{ui['可兑换次数']}}"><text class="card-row-label">{{ui['可兑换次数']}}</text><text class="code-value">{{codeCounts[codeCountIndex]}} ›</text></view>
          </view>

          <button class="code-primary" bindtap="codeGenerate" disabled="{{codeBusy}}">{{codeBusy ? ui['生成中…'] : ui['生成兑换码']}}</button>

          <view wx:if="{{codeGenerated}}" class="code-result">
            <text class="code-result-label">{{ui['请妥善保管，可在最近生成列表中再次复制或删除']}}</text>
            <text class="code-result-value" selectable>{{codeGenerated}}</text>
            <text class="code-result-meta">{{codeGeneratedMeta}}</text>
            <view class="code-result-actions">
              <button class="code-btn" bindtap="codeCopyGenerated">{{ui['复制']}}</button>
              <button wx:if="{{codeGeneratedId}}" class="code-btn danger" data-id="{{codeGeneratedId}}" bindtap="codeDeleteItem">{{ui['删除']}}</button>
            </view>
          </view>

          <view class="code-list-head">
            <text class="code-list-title">{{ui['最近生成']}}</text>
            <view class="code-list-actions">
              <text wx:if="{{codeUsedCount}}" class="code-clear" bindtap="codeClearUsed" role="button" aria-label="{{ui['清空已用完的兑换码']}}">{{ui['清空已用完']}} {{codeUsedCount}}</text>
              <text class="code-refresh" bindtap="loadCodes" role="button">{{ui['刷新']}}</text>
            </view>
          </view>
          <view wx:if="{{!codeItems.length}}" class="code-message">{{ui['还没有生成兑换码']}}</view>
          <view wx:for="{{codeItems}}" wx:key="id" class="code-item">
            <view class="code-item-head">
              <text class="code-item-title">{{item.title}}</text>
              <text class="code-item-status">{{ui[item.statusLabel] !== undefined ? ui[item.statusLabel] : item.statusLabel}}</text>
            </view>
            <text class="code-item-meta">{{ui['范围']}} {{item.nodeId ? item.nodeId : ui['全部公网节点']}}</text>
            <text class="code-item-meta">{{ui[item.usageLabel] !== undefined ? ui[item.usageLabel] : item.usageLabel}} · {{ui[item.expiryLabel] !== undefined ? ui[item.expiryLabel] : item.expiryLabel}} {{ui['到期']}}</text>
            <view class="code-item-actions">
              <button class="code-btn" data-id="{{item.id}}" bindtap="codeCopyItem" disabled="{{codeBusy}}">{{ui['复制']}}</button>
              <button wx:if="{{item.canRevoke}}" class="code-btn" data-id="{{item.id}}" bindtap="codeRevokeItem" disabled="{{codeBusy}}">{{ui['停用']}}</button>
              <button class="code-btn danger" data-id="{{item.id}}" bindtap="codeDeleteItem" disabled="{{codeBusy}}">{{ui['删除']}}</button>
            </view>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>

  <view wx:if="{{pairSheetOpen}}" class="pair-sheet-mask" catchtap="closePairSheet" catchtouchmove="noop">
    <view class="pair-sheet resizable {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}" style="height: calc({{sheetExpanded.pair ? 90 : 62}}vh - var(--glass-sheet-drop, 0px));" catchtap="noop">
      <view class="sheet-grabber-zone" data-sheet="pair" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['添加公网节点']}}</text>
          <text class="pair-sheet-subtitle">{{ui['粘贴插件提供的 Base64URL 配对信息']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closePairSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <textarea
        class="pair-payload-input"
        value="{{pairingText}}"
        maxlength="20000"
        auto-height="{{false}}"
        placeholder="{{ui['粘贴完整配对字符串']}}"
        placeholder-class="pair-payload-placeholder"
        bindinput="onPairingInput"
        disabled="{{pairingConnecting}}"
      />
      <text wx:if="{{pairingError}}" class="pair-result {{pairingConnecting ? 'pair-result-pending' : ''}}">{{ui[pairingError] !== undefined ? ui[pairingError] : pairingError}}</text>
      <view class="pair-submit {{!pairingText || pairingConnecting ? 'pair-submit-disabled' : ''}}" bindtap="connectPublicNode">
        <text>{{pairingConnecting ? ui['连接中…'] : ui['连接节点']}}</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{statusStyleSheetOpen}}" class="status-style-mask {{themeClass}}" catchtap="closeStatusStyles" catchtouchmove="noop">
