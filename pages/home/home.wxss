/* ---------- 配对菜单（对齐 dsh-mobile GatewayAuthenticationMenu） ---------- */

.pair-wrap {
  position: relative;
  z-index: 101;
}

.pair-menu-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
}

.pair-menu {
  position: absolute;
  top: calc(100% + 12rpx);
  right: 0;
  z-index: 100;
  width: 496rpx;
  padding: 12rpx 0;
  background: rgba(226, 238, 255, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 56rpx;
  box-shadow: 0 12rpx 48rpx rgba(3, 14, 30, 0.35);
  overflow: hidden;
}

.pair-menu-item {
  display: flex;
  align-items: center;
  height: 116rpx;
  padding: 0 44rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--ink);
}

.pair-menu-item-active {
  background: rgba(16, 19, 24, 0.06);
}

.pair-menu-ic {
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 18rpx;
  font-size: 38rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.hero {
  margin-bottom: 56rpx;
}

.workspace-card {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  margin-bottom: 30rpx;
}

.ws-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.ws-body {
  flex: 1;
  min-width: 0;
}

.ws-title {
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
}

.ws-path {
  color: rgba(255, 255, 255, 0.55);
