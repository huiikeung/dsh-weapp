 .qs-root{display:flex;
flex-direction:column;
width:100%;
box-sizing:border-box;
color:var(--text);
font-variant-numeric:tabular-nums;
}
.qs-sec{display:flex;
flex-direction:column;
gap:6rpx;
min-width:0;
box-sizing:border-box;
}
.qs-row{display:flex;
min-width:0;
align-items:center;
justify-content:space-between;
gap:14rpx;
}
.qs-label{overflow:hidden;
color:var(--text-2);
font-size:24rpx;
line-height:1.45;
text-overflow:ellipsis;
white-space:nowrap;
}
.qs-value{flex:none;
color:var(--text);
font-size:24rpx;
font-weight:500;
line-height:1.45;
}
.qs-title{overflow:hidden;
color:var(--text);
font-size:24rpx;
font-weight:600;
line-height:1.45;
text-overflow:ellipsis;
white-space:nowrap;
}
.qs-link{margin-left:4rpx;
color:var(--text-3);
font-size:24rpx;
}
.qs-bar{overflow:hidden;
height:10rpx;
border-radius:20rpx;
background:var(--fill);
}
.qs-bar-fill{height:100%;
min-width:6rpx;
border-radius:inherit;
background:var(--ocean);
}
.qs-bar-split{display:flex;
gap:2rpx;
}
.qs-bar-split .qs-bar-fill{min-width:0;
}
.qs-bar-seg-toppedUp{background:#f0b35b;
}
.qs-meta{color:var(--text-3);
font-size:24rpx;
line-height:1.45;
}
.qs-tokens{color:var(--text-3);
font-size:24rpx;
line-height:1.45;
}
.qs-today-vals{display:flex;
flex:none;
align-items:baseline;
gap:14rpx;
}
.qs-amount{color:var(--text);
font-size:24rpx;
font-weight:600;
}
.qs-summary .qs-amount{color:var(--ocean);
}
.qs-dot{display:inline-block;
width:16rpx;
height:16rpx;
margin-right:10rpx;
border-radius:6rpx;
background:var(--qs-peak, var(--ocean));
vertical-align:middle;
}
.qs-budget-used{display:none;
}
/* 峰谷相位配色对齐 dsh-cost-meter：峰时橙、谷时/平价品牌蓝、周末与节假日绿。 */
.qs-peak.qs-phase-peak{--qs-peak:#FF9800;
}
.qs-peak.qs-phase-off{--qs-peak:var(--ocean);
}
.qs-peak.qs-phase-weekend,.qs-peak.qs-phase-holiday{--qs-peak:#34A853;
}
.qs-peak .qs-bar-fill{background:var(--qs-peak, var(--ocean));
}
.qs-peak.qs-phase-peak .qs-bar{background:rgba(255,152,0,.14);
}
.qs-peak.qs-phase-weekend .qs-bar,.qs-peak.qs-phase-holiday .qs-bar{background:rgba(52,168,83,.14);
}
.qs-peak-label{display:flex;
flex:1;
min-width:0;
align-items:center;
color:var(--qs-peak, var(--ocean));
font-size:24rpx;
font-weight:400;
}
.qs-peak-name{display:block;flex:0 1 auto;
min-width:0;
overflow:hidden;
text-overflow:ellipsis;
white-space:nowrap;
}
.qs-peak-countdown{flex:none;
margin-left:14rpx;
color:var(--text-2);
font-size:24rpx;
font-weight:400;
white-space:nowrap;
}
.qs-meta-row{display:flex;
align-items:center;
justify-content:space-between;
gap:12rpx;
}
.qs-wins{display:flex;
flex-direction:column;
gap:8rpx;
}
.qs-win{display:flex;
min-width:0;
align-items:center;
gap:16rpx;
}
.qs-win-label{flex:none;
width:92rpx;
color:var(--text-2);
font-size:24rpx;
}
.qs-win .qs-bar{flex:1;
min-width:0;
}
.qs-win-pct{flex:none;
width:86rpx;
color:var(--text);
font-size:24rpx;
text-align:right;
}
.qs-active{outline:3rpx dashed var(--ocean);
outline-offset:3rpx;
border-radius:12rpx;
}
.qs-standard{gap:20rpx;
}
.qs-standard .qs-sec{padding:4rpx 0;
border:0;
border-radius:0;
background:transparent;
box-shadow:none;
gap:8rpx;
}
.qs-standard .qs-sec.qs-card{padding:16rpx 24rpx;
border:1rpx solid var(--border);
border-radius:20rpx;
background:transparent;
box-shadow:none;
}
.qs-summary{gap:12rpx;
padding:18rpx 20rpx 16rpx;
border:1rpx solid var(--border);
border-radius:22rpx;
background:transparent;
box-shadow:none;
}
.qs-summary .qs-sec{padding:8rpx 0;
gap:6rpx;
border:0;
background:transparent;
}
.qs-summary .qs-sec.qs-card{padding:6rpx 0;
border:0;
border-radius:0;
background:transparent;
box-shadow:none;
}
.qs-simple{gap:0;
padding:6rpx 20rpx;
border:1rpx solid var(--border);
border-radius:20rpx;
background:transparent;
box-shadow:none;
}
.qs-simple .qs-sec{padding:14rpx 2rpx;
gap:2rpx;
border:0;
border-bottom:0;
background:transparent;
}
.qs-simple .qs-sec.qs-today,.qs-simple .qs-sec.qs-card{border-bottom:1rpx solid var(--divider);
}
.qs-simple .qs-sec.qs-card{padding:14rpx 2rpx;
border-radius:0;
box-shadow:none;
}
.qs-simple .qs-sec:last-child{border-bottom:0;
}
.qs-simple .qs-label,.qs-simple .qs-value,.qs-simple .qs-title{font-size:24rpx;
}
.qs-simple .qs-win-label,.qs-simple .qs-win-pct{font-size:22rpx;
}
.qs-simple .qs-win-label{width:78rpx;
}
.qs-simple .qs-win-pct{width:74rpx;
}
.qs-simple .qs-meta{display:none;
}
.qs-simple .qs-bar{height:5rpx;
}
.qs-simple .qs-wins{gap:4rpx;
}
.qs-simple .qs-today{padding:10rpx 2rpx 8rpx;
}
.qs-simple .qs-budget-pct{display:none;
}
.qs-simple .qs-budget-used{display:inline;
}
.qs-simple .qs-peak .qs-meta{display:block;
}
.qs-compact{gap:20rpx;
}
.qs-compact .qs-sec{padding:4rpx 0;
border:0;
border-radius:0;
background:transparent;
box-shadow:none;
gap:8rpx;
}
.qs-compact .qs-sec.qs-card{padding:16rpx 24rpx;
border:1rpx solid var(--border);
border-radius:20rpx;
background:transparent;
box-shadow:none;
}
.qs-compact .qs-wins{display:grid;
grid-template-columns:1fr 1fr;
gap:8rpx 20rpx;
}
.qs-compact .qs-win{gap:8rpx;
}
.qs-compact .qs-win-label{width:64rpx;
font-size:22rpx;
}
.qs-compact .qs-win-pct{width:64rpx;
font-size:22rpx;
}


.qs-peak-inline{align-items:center;
gap:10rpx;
}
.qs-peak-inline .qs-peak-label{flex:none;
}
.qs-bar-inline{flex:1;
min-width:0;
height:6rpx;
margin-top:0;
}
.qs-peak-inline-time{flex:0 1 auto;
max-width:none;
overflow:visible;
font-size:24rpx;
color:var(--text-2);
margin-left:auto;
white-space:nowrap;
}
.qs-today-left{display:flex;
align-items:baseline;
gap:16rpx;
min-width:0;
}
.qs-today-left .qs-tokens{margin-left:2rpx;
}

.qs-peak-summary-row{flex-wrap:nowrap;column-gap:6rpx;}
.qs-peak-summary-left{display:flex;flex:1 1 auto;align-items:center;gap:6rpx;min-width:0;}
.qs-peak-summary-left .qs-peak-label{flex:0 0 auto;white-space:nowrap;}
.qs-peak-summary-left .qs-peak-countdown{flex:none;}
.qs-peak-countdown{white-space:nowrap;}
.qs-peak-switch{flex:0 0 auto;margin-left:auto;white-space:nowrap;}
.qs-peak-inline{flex-wrap:wrap;row-gap:2rpx;}
