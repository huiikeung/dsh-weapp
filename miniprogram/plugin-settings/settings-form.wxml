  <view class="config-panel">
    <text wx:if="{{!connected && !config}}" class="config-hint">{{ui['网关已断开，插件状态待重新连接确认']}}</text>
    <text wx:if="{{configStatus === 'loading'}}" class="config-hint">{{ui['正在加载设置…']}}</text>
    <text wx:if="{{configError}}" class="pdetail-err">{{ui[configError] !== undefined ? ui[configError] : configError}}</text>
    <button wx:if="{{configStatus === 'error'}}" class="config-button" bindtap="loadSettings">{{ui['重试']}}</button>
    <block wx:if="{{config}}">
      <text wx:if="{{!connected}}" class="config-hint">{{ui['网关已断开，插件状态待重新连接确认']}}</text>
      <text wx:if="{{!config.writable && config.kind !== 'voice'}}" class="config-hint">{{ui['本部署的设置为只读。']}}</text>
      <block wx:if="{{config.kind === 'web-search'}}">
        <view class="config-toggle"><text class="config-label">{{config.labels.useSearchApi}}</text><dsh-switch checked="{{config.useSearchApi}}" disabled="{{config.disabled || !config.switchAvailable}}" bindchange="onSearchApiChange"/></view>
        <text class="config-hint">{{config.labels.useSearchApiHint}}</text>
        <text class="config-link" bindtap="openSearchGuide">{{config.labels.searchGuide}}</text>
        <view class="config-field"><text class="config-label">{{config.labels.apiKey}}</text>
          <input class="config-input" password value="{{config.secret}}" disabled="{{config.disabled || !config.credential.writable}}" bindinput="onConfigSecret" maxlength="8192"/>
          <text class="config-hint">{{config.labels.apiKeyHint}}</text>
          <text wx:if="{{config.credential.unavailable}}" class="config-hint">{{ui['当前网关尚未开放此功能，请更新网关后重试。']}}</text>
          <text wx:elif="{{config.credential}}" class="config-hint">{{config.credential.configured ? config.labels.apiKeySet : config.labels.apiKeyUnset}}</text>
        </view>
      </block>
      <block wx:if="{{config.kind === 'cot-translation'}}">
        <text class="config-hint">{{config.labels.privacy}}</text>
        <text class="config-hint">{{config.translationPaid ? config.labels.paidNotice : config.labels.anonymousNotice}}</text>
        <text wx:if="{{configProvidersUnavailable}}" class="config-hint">{{config.labels.providerUnavailable}}</text>
      </block>
      <text wx:if="{{config.kind === 'subagent'}}" class="config-heading">{{config.labels.subagentLimitsTitle}}</text>
      <block wx:for="{{config.fields}}" wx:key="id">
        <text wx:if="{{item.group && (index === 0 || config.fields[index - 1].group !== item.group)}}" class="config-heading">{{item.group}}</text>
        <view class="config-field {{item.isChoice && !item.multiline ? 'is-row' : ''}}">
        <view class="config-label-row"><text class="config-label">{{item.label}}</text><text wx:if="{{item.overridden}}" class="config-tag">{{ui['已覆盖']}}</text><button wx:if="{{item.overridden || config.dirty}}" class="config-reset" disabled="{{config.disabled || !item.available}}" data-id="{{item.id}}" bindtap="resetConfigField">{{ui['恢复默认']}}</button></view>
        <view wx:if="{{item.isChoice}}" class="config-input config-select {{config.disabled || !item.available || configProvidersUnavailable ? 'is-disabled' : ''}}" data-id="{{item.id}}" data-index="{{index}}" id="config-choice-{{index}}" bindtap="openConfigChoice" role="button" aria-label="{{item.label}}"><text>{{item.choiceLabels[item.choiceIndex] || item.value}}</text><view class="config-chevron"></view></view>
        <textarea wx:elif="{{item.multiline}}" class="config-input config-textarea" value="{{item.value}}" placeholder="{{item.placeholder}}" disabled="{{config.disabled || !item.available}}" data-id="{{item.id}}" bindinput="onConfigInput" maxlength="8192" auto-height></textarea>
        <input wx:else class="config-input" value="{{item.value}}" placeholder="{{item.placeholder}}" disabled="{{config.disabled || !item.available}}" data-id="{{item.id}}" bindinput="onConfigInput" type="{{item.numeric ? 'digit' : 'text'}}" maxlength="2048"/>
        <text wx:if="{{item.hint}}" class="config-hint">{{item.hint}}</text>
        <text wx:if="{{!item.available}}" class="config-hint">{{ui['该插件当前未加载，暂时无法配置。']}}</text>
        </view>
      </block>
      <block wx:if="{{config.kind === 'voice'}}"><include src="voice-settings.wxml"/></block>
      <view wx:if="{{config.kind !== 'voice'}}" class="config-actions"><button class="config-button config-save" disabled="{{config.disabled || !config.dirty}}" loading="{{configSaving}}" bindtap="saveSettings">{{configSaving ? ui['保存中…'] : ui['保存']}}</button><button class="config-button" disabled="{{configSaving}}" bindtap="discardSettings">{{ui['放弃修改']}}</button></view>
    </block>
  </view>

  <view wx:if="{{choiceSheetOpen}}" class="config-choice-mask" bindtap="closeConfigChoice" catchtouchmove="noop"></view>
  <view wx:if="{{choiceSheetOpen}}" class="config-choice-menu" style="{{choiceMenuStyle}}">
    <scroll-view scroll-y class="config-choice-list">
      <view wx:for="{{choiceSheetOptions}}" wx:key="value" class="config-choice-item {{item.selected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="pickConfigChoice" role="button">
        <text>{{item.label}}</text>
        <text wx:if="{{item.selected}}" class="config-choice-check">✓</text>
      </view>
    </scroll-view>
  </view>
