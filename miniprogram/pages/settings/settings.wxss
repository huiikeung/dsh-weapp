@import "../../styles/status-appearance.wxss";
@import "../../styles/proc-icon.wxss";
.settings {
  padding: 0 40rpx 80rpx;
  color: var(--text);
}

/* DSH desktop AccountSection: 8px section inset, 16px card gap, 20px radius. */
.dsh-account-section { display: flex; flex-direction: column; gap: 32rpx; padding: 16rpx 0 0; color: var(--text); font-size: 26rpx; line-height: 44rpx; }
.dsh-account-card,
.dsh-balance-card { box-sizing: border-box; border: 1rpx solid var(--border); border-radius: 20rpx; background: var(--surface); padding: 24rpx 32rpx; }
/* 箭头用绝对定位贴右缘：微信里 <image> 是原生组件，flex 布局不可靠。 */
.dsh-account-card { position: relative; display: flex; align-items: center; gap: 32rpx; }
.dsh-account-card.has-chevron { padding-right: 76rpx; }
.dsh-account-chevron { position: absolute; right: 32rpx; top: 50%; width: 32rpx; height: 32rpx; transform: translateY(-50%); transition: transform 0.16s ease; }
.dsh-account-chevron.open { transform: translateY(-50%) rotate(90deg); }
.dsh-account-identity { display: flex; flex: 1; align-items: center; gap: 20rpx; min-width: 0; min-height: 88rpx; }
.dsh-account-avatar { width: 64rpx; height: 64rpx; flex: none; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; color: var(--text-3); background: var(--fill); font-size: 21rpx; font-weight: 600; }
.dsh-account-avatar-image { width: 100%; height: 100%; }
.dsh-account-avatar-user { width: 32rpx; height: 32rpx; display: block; }
.dsh-account-avatar-placeholder { line-height: 1; }
.dsh-account-identity-copy { min-width: 0; display: flex; flex-direction: column; }
.dsh-account-name { color: var(--text); font-size: 28rpx; font-weight: 500; line-height: 44rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dsh-account-status, .dsh-account-muted, .dsh-account-secondary { color: var(--text-3); }
.dsh-account-status { display: block; font-size: 26rpx; line-height: 36rpx; }
.dsh-account-info { flex: none; color: var(--text); font-size: 26rpx; line-height: 44rpx; white-space: nowrap; }
.dsh-balance-card { display: flex; flex-direction: column; gap: 16rpx; }
.dsh-balance-row { display: flex; align-items: center; justify-content: space-between; gap: 32rpx; min-height: 80rpx; padding: 12rpx 0; box-sizing: border-box; }
.dsh-balance-row > text:first-child { color: var(--text); }
.dsh-balance-amount { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0; color: var(--text); font-size: 36rpx; font-weight: 510; line-height: 56rpx; }
.dsh-balance-amount text + text::before { content: ' + '; white-space: pre; }
.dsh-balance-bonus { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; }
.dsh-account-divider { border-top: 1rpx solid var(--divider); }
.dsh-account-unavailable { color: var(--text-3); text-decoration: underline; text-underline-offset: 6rpx; }
.dsh-account-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 20rpx; }
.dsh-account-link-button { min-width: 116rpx; height: 72rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 0 28rpx; border: 1rpx solid var(--border-strong); border-radius: 12rpx; color: var(--text); font-size: 28rpx; line-height: 44rpx; white-space: nowrap; }
.dsh-account-primary { color: #fff; background: var(--ocean); border-color: transparent; font-weight: 500; }

.chevron {
  color: var(--gray);
  font-size: 34rpx;
  margin-left: 12rpx;
}

.chevron-img {
  width: 26rpx;
  height: 26rpx;
  margin-left: 12rpx;
  opacity: 0.55;
}

.gw-url {
  font-size: 28rpx;
  color: var(--ink);
  word-break: break-all;
}

.gw-status {
  display: flex;
  align-items: center;
}

.gw-cwd {
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exp-copy {
  display: flex;
  flex-direction: column;
  margin-right: 24rpx;
  flex: 1;
}

.exp-desc {
  font-size: 24rpx;
  color: var(--gray);
  margin-top: 6rpx;
  line-height: 1.5;
}

.clawbot-experimental-row { gap: 12rpx; }
.clawbot-experimental-row .exp-copy { min-width: 0; }
/* ---------- 微信 ClawBot 私聊接线（底部弹层 + 居中会话选择） ---------- */
/* .pair-sheet 本身不是 flex 容器：这里显式做成列布局，
   否则子级 flex:1;height:0 会解析成 0 高度把内容吞掉。 */
.clawbot-sheet { display: flex; flex-direction: column; }
.clawbot-sheet > .sheet-grabber-zone,
.clawbot-sheet > .pair-sheet-head { flex: none; }
/* 横向留白由 .pair-sheet 的 padding 提供，这里不要再加，避免双重内缩 */
.clawbot-sheet-body { flex: 1; height: 0; min-height: 0; box-sizing: border-box; }

.clawbot-hero { display: flex; align-items: center; gap: 18rpx; margin-top: 8rpx; padding: 22rpx 24rpx; border-radius: 20rpx; border: 1rpx solid var(--border); background: var(--fill); }
.clawbot-hero.is-on { border-color: rgba(25, 135, 84, .28); background: rgba(25, 135, 84, .08); }
.clawbot-hero-dot { width: 16rpx; height: 16rpx; flex: none; border-radius: 50%; background: var(--text-3); }
.clawbot-hero.is-on .clawbot-hero-dot { background: #198754; box-shadow: 0 0 0 6rpx rgba(25, 135, 84, .16); }
.clawbot-hero-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.clawbot-hero-title { font-size: 28rpx; font-weight: 600; color: var(--text); }
.clawbot-hero.is-on .clawbot-hero-title { color: #198754; }
.clawbot-hero-sub { font-size: 23rpx; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.clawbot-refresh { flex: none; padding: 8rpx 18rpx; border-radius: 999rpx; border: 1rpx solid var(--border); color: var(--text-2); font-size: 23rpx; line-height: 1.4; }
.clawbot-refresh.tap:active { opacity: .7; }

.clawbot-tile-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.clawbot-tile { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; padding: 18rpx 20rpx; border-radius: 18rpx; background: var(--surface); border: 1rpx solid var(--border); }
.clawbot-tile-label { font-size: 22rpx; color: var(--text-3); }
.clawbot-tile-main { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.clawbot-tile-value { flex: 1; min-width: 0; font-size: 26rpx; font-weight: 500; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.clawbot-tile-chevron { flex: none; font-size: 30rpx; line-height: 1; color: var(--text-3); }
.clawbot-tile-tap:active { opacity: .7; }

.clawbot-message { display: block; margin-top: 16rpx; }
.clawbot-error,
.clawbot-muted,
.clawbot-footnote { display: block; color: var(--text-3); font-size: 23rpx; line-height: 1.55; }
.clawbot-error { margin-top: 16rpx; padding: 14rpx 18rpx; border-radius: 14rpx; background: rgba(196, 72, 72, .1); color: #c44848; overflow-wrap: anywhere; }
.clawbot-footnote { margin-top: 24rpx; }

.clawbot-ops { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
.clawbot-op { flex: 1 1 30%; min-width: 180rpx; min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 0 18rpx; border-radius: 16rpx; border: 1rpx solid var(--border-strong); background: var(--surface); }
.clawbot-op:active { opacity: .72; }
.clawbot-op-title { font-size: 25rpx; font-weight: 500; color: var(--text); text-align: center; }
.clawbot-op.is-danger { border-color: rgba(196, 72, 72, .34); }
.clawbot-op.is-danger .clawbot-op-title { color: #c44848; }
.clawbot-op.is-disabled { opacity: .45; }

.clawbot-pairing { display: flex; flex-direction: column; align-items: center; gap: 12rpx; margin-top: 22rpx; padding: 22rpx; border-radius: 18rpx; background: var(--surface); border: 1rpx solid var(--border); }

/* 居中会话选择弹窗 */
.clawbot-modal-mask { position: fixed; inset: 0; z-index: 1200; display: flex; align-items: center; justify-content: center; padding: 40rpx; background: rgba(0, 0, 0, .45); }
.clawbot-modal { width: 100%; max-width: 620rpx; box-sizing: border-box; display: flex; flex-direction: column; padding: 30rpx 30rpx 24rpx; border-radius: 24rpx; background: var(--surface); border: 1rpx solid var(--border); box-shadow: 0 24rpx 72rpx rgba(0, 0, 0, .3); animation: clawbot-modal-in .18s ease-out; }
@keyframes clawbot-modal-in { from { opacity: 0; transform: translateY(16rpx) scale(.97); } to { opacity: 1; transform: none; } }
.clawbot-modal-head { flex: none; display: flex; align-items: center; gap: 16rpx; }
.clawbot-modal-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; color: var(--text); }
.clawbot-modal-close { flex: none; width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center; border-radius: 14rpx; font-size: 38rpx; color: var(--text-2); background: var(--fill); }
.clawbot-modal-sub { flex: none; margin-top: 8rpx; font-size: 23rpx; color: var(--text-3); }
/* 用 max-height 而非 flex:1（与 .management-scroll 同一写法）：内容少时弹窗自动收缩。 */
.clawbot-modal-body { max-height: 52vh; margin-top: 18rpx; }
.clawbot-modal-empty { padding: 60rpx 20rpx; text-align: center; font-size: 24rpx; color: var(--text-3); }

/* 二维码 / 确认码 / 会话行 */
.clawbot-qr { width: 320rpx; height: 320rpx; border-radius: 16rpx; background: #fff; }
.clawbot-pairing-hint { font-size: 23rpx; color: var(--text-3); text-align: center; }
.clawbot-verify-row { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; width: 100%; }
.clawbot-verify-input { flex: 1; min-width: 0; height: 76rpx; padding: 0 20rpx; box-sizing: border-box; border-radius: 14rpx; border: 1rpx solid var(--border-strong); background: var(--fill); color: var(--text); font-size: 25rpx; }
.clawbot-action { flex: none; min-height: 76rpx; display: flex; align-items: center; justify-content: center; padding: 0 24rpx; border-radius: 14rpx; border: 1rpx solid var(--border-strong); background: var(--surface); color: var(--text); font-size: 24rpx; }
.clawbot-text-action { color: var(--ocean); font-size: 24rpx; line-height: 1.4; }
.clawbot-cancel-login { margin-top: 10rpx; text-align: center; }

.clawbot-session-option { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 20rpx; border-radius: 16rpx; border: 1rpx solid var(--border); background: var(--surface); margin-bottom: 12rpx; }
.clawbot-session-option.selected { border-color: var(--ocean); background: var(--fill); }
.clawbot-session-option:active { opacity: .72; }

.clawbot-session-check { color: var(--ocean); }
.clawbot-session-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 3rpx; }
.clawbot-session-title { color: var(--text); font-size: 24rpx; overflow-wrap: anywhere; }
.clawbot-session-check { flex: none; font-size: 28rpx; }
.clawbot-footnote { margin-top: 18rpx; }

/* ---------- 独立管理入口与面板 ---------- */
.management-entry {
  gap: 20rpx;
  min-height: 112rpx;
}

.management-entry-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.management-entry-desc {
  margin-top: 6rpx;
  color: var(--text-2);
  font-size: 23rpx;
  line-height: 1.5;
}

.management-entry-value {
  flex: none;
  white-space: nowrap;
}

.management-entry-value .chevron-img {
  flex: none;
}

.identity-entry-value { gap: 12rpx; }
.identity-entry-value .chevron-img { margin-left: 0; }
.identity-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  box-sizing: border-box;
  padding: 2rpx 12rpx;
  border: 1rpx solid var(--border-strong);
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--text-2);
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.4;
}
.identity-badge.is-admin { border-color: rgba(46, 107, 230, .26); background: rgba(46, 107, 230, .08); color: var(--ocean); }
.theme-dark .identity-badge.is-admin { border-color: rgba(105, 157, 255, .32); background: rgba(105, 157, 255, .12); }
.identity-entry { min-height: 92rpx; }
.identity-entry .management-entry-copy { align-self: center; }

.management-entry-active {
  background: var(--fill);
}

.management-sheet {
  display: flex;
  flex-direction: column;
  max-height: 92vh;
}

.management-sheet .management-scroll {
  flex: 1;
  min-height: 0;
}

.management-sheet .pair-sheet-head {
  flex-shrink: 0;
  gap: 16rpx;
}

.management-sheet .pair-sheet-head > view:first-child {
  flex: 1;
  min-width: 0;
}
.management-sheet .pair-sheet-subtitle { overflow-wrap: anywhere; word-break: break-all; }
.pair-sheet-close {
  flex: none;
  margin-left: auto;          /* 贴住右侧 */
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 64rpx;
  height: 64rpx;
  padding: 0;
}

/* 标题区可压缩，避免把「关闭」挤成两行 */
.pair-sheet-head > view:first-child {
  flex: 1;
  min-width: 0;
}

/* 标题区可压缩，避免把「关闭」挤成两行 */
.pair-sheet-head > view:first-child {
  flex: 1;
  min-width: 0;
}
.node-detail-chevron { width: 24rpx; height: 24rpx; flex: none; opacity: .55; }
.gateway-detail-card { margin: 0; }
.gateway-identity-row { gap: 16rpx; }
.gateway-identity-label { flex: none; color: var(--text-2); font-size: 25rpx; }
.gateway-identity-value { flex: 1; min-width: 0; color: var(--text); font-size: 25rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gateway-copy { flex: none; padding: 20rpx 0 20rpx 8rpx; }
.gateway-status-row { gap: 16rpx; flex-wrap: wrap; }
.gateway-status-row .card-row-value { flex: none; }
.gateway-detail-card .gw-url { min-width: 0; overflow-wrap: anywhere; }
.gateway-detail-card .gateway-action { display: flex; align-items: center; justify-content: flex-start; width: 100%; margin: 0; padding: 30rpx 32rpx; box-sizing: border-box; min-height: 88rpx; border-radius: 0; background: transparent; text-align: left; font-size: 28rpx; font-weight: normal; line-height: 1.5; color: var(--text); }
.gateway-action::after { border: 0; }
.gateway-action[disabled] { background: transparent; opacity: .45; }

/* 弹窗自身是唯一滚动容器（整个弹窗一起滑），内层不再限高造出「框里滚动」 */
.management-scroll {
  min-height: 0;
}

.public-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  min-height: 52rpx;
}

.public-detail-label {
  flex: none;
  font-size: 25rpx;
  color: var(--text-2);
}

.public-detail-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  word-break: break-all;
  font-size: 24rpx;
  color: var(--text);
}

.public-copy-id {
  flex: none;
  padding: 10rpx 0;
  color: var(--ocean);
  font-size: 24rpx;
}

.node-group-title {
  margin-bottom: 20rpx;
}

.row-desc {
  display: block;
  margin-top: 4rpx;
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 400;
}

.node-head-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.node-edit-toggle {
  color: var(--ocean);
  font-size: 26rpx;
  padding: 6rpx 4rpx;
}

.node-delete-inline {
  color: #E5533C;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(229, 83, 60, 0.10);
  border: 1rpx solid rgba(229, 83, 60, 0.38);
}

.node-select {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}

.node-select-ic {
  width: 40rpx;
  height: 40rpx;
}

.node-refresh {
  padding: 8rpx 0 8rpx 20rpx;
  color: var(--ocean);
  font-size: 25rpx;
}

.node-pair-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}

.node-pair-button {
  flex: 1 1 230rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0;
  padding: 22rpx 16rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 1rpx solid rgba(76, 108, 224, 0.42);
  color: #4C6CE0;
  font-size: 27rpx;
  line-height: 1.5;
}

.node-add-plus {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
}

.node-add-text {
  line-height: 1.4;
}

.node-pair-button.secondary {
  background: var(--fill);
  color: var(--ocean);
}

.node-pair-button::after,
.public-share::after {
  border: 0;
}

.node-row:first-child {
  border-top: 0;
}

/* ---------- 公网访问详情 ---------- */
.public-card {
  padding: 28rpx 28rpx 24rpx;
}

.public-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

/* 图标不带底色：直接使用路由器/信号图形 */
.public-icon {
  flex: none;
  width: 88rpx;
  height: 88rpx;
}

.public-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.public-title {
  color: var(--text);
  font-size: 30rpx;
  font-weight: 600;
}

.public-sub {
  margin-top: 6rpx;
  color: var(--text-2);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.public-pill {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--text-2);
  font-size: 22rpx;
}

.public-pill.on {
  background: rgba(58, 130, 96, 0.14);
  color: #3A8260;
}

.public-pill-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.public-share {
  margin: 24rpx 0 0;
  padding: 0 16rpx;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--fill);
  color: var(--ocean);
  font-size: 30rpx;
  font-weight: 550;
}

.public-share[disabled] {
  background: var(--fill);
  color: var(--text-3);
}

.public-share-hover {
  opacity: 0.75;
}

.public-share-meta {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.public-share-expiry {
  color: var(--text-2);
  font-size: 22rpx;
}

.public-share-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.public-share-actions button {
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 10rpx;
  background: var(--fill);
  color: var(--ocean);
  font-size: 23rpx;
  line-height: 56rpx;
}

.public-share-actions button::after {
  border: 0;
}

.public-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.public-actions .public-share {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.public-redeem {
  flex: 1;
  min-width: 0;
  margin: 0;
  height: 88rpx;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--ocean);
  font-size: 28rpx;
  line-height: 88rpx;
}

.public-redeem::after {
  border: 0;
}

.public-redeem[disabled] {
  color: var(--text-3);
}

.public-redeem-result {
  margin-top: 16rpx;
  color: #3A8260;
  font-size: 23rpx;
}

/* 所有者专属：兑换码生成 */
.public-code-block {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--divider);
}

.public-code-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.public-code-title {
  color: var(--text);
  font-size: 27rpx;
  font-weight: 550;
}

.public-code-desc {
  color: var(--text-2);
  font-size: 22rpx;
}

.public-code-actions {
  display: flex;
  margin-top: 16rpx;
}

.public-code-result {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: var(--fill);
}

.public-code-value {
