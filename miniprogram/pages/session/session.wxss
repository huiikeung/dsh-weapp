  font-size: 22rpx;
  color: var(--text-3);
  background: var(--fill-2);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

/* ===== 上下文注入行（system/插件来源的 user/message） ===== */
.row-context {
  margin: 12rpx 0 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--fill);
}

.context-title {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 上下文浮窗（对齐 iOS popover：锚定环按钮上方，带小箭头） ---------- */

.ctx-pop-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: transparent;
}

.ctx-pop {
  position: absolute;
  right: 0;
  bottom: calc(100% + 14rpx);
  width: min(600rpx, calc(100vw - 56rpx));
  box-sizing: border-box;
  z-index: 81;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  box-shadow: var(--float-shadow);
  padding: 32rpx;
}

/* 指向环按钮的小箭头：中心对准上下文圆环图标
   屏幕右侧 → 圆环中心 = dock 28 + composer 28 + 发送键 84 + 间距 14 + 环 margin 16 + 环半径 22 = 192rpx
   弹窗 right 28 + 箭头 right + 箭头半宽 10 = 192 → 箭头 right = 154rpx */
.ctx-pop::after {
  content: '';
  position: absolute;
  right: 28rpx;
  bottom: -11rpx;
  width: 20rpx;
  height: 20rpx;
  background: var(--surface);
  border-right: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
  transform: rotate(45deg);
}

/* 待发文件条目（+ → 文件） */
.pending-file {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 40rpx 0 14rpx;
  background: var(--fill);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  position: relative;
  margin-right: 14rpx;
}

.pending-file-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.pending-file-name {
  font-size: 24rpx;
  color: var(--text-2);
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 运行指示条（对齐 iOS deep-search-progress） ---------- */

/* 运行指示条（iOS DeepSearchProgressRow） */
.progress-strip {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;            /* 外层 padding-top 8pt */
}

.conversation-progress {
  flex-shrink: 0;
  margin: 16rpx 0 0;
}
.conversation-progress .progress-row { height: auto; min-height: 52rpx; padding: 10rpx 0; align-items: center; }

.progress-row {
  display: flex;
  align-items: flex-start;
  height: 112rpx;               /* iOS 56pt */
  padding: 26rpx 4rpx 0;        /* 内层 padding-top 13pt */
}

/* 鲸尾：PNG 精灵图 + steps() 逐帧位移（60 帧 × 36rpx，20fps，逐像素高清） */
.run-tail {
  width: 36rpx;                 /* 18pt */
  height: 36rpx;
  margin-right: 16rpx;          /* spacing 8 */
  overflow: hidden;
}

.run-tail-sprite {
  width: 2160rpx;               /* 60 帧 × 36rpx */
  height: 36rpx;
  animation: whaleTailPlay 3s steps(60) infinite;   /* 20fps：60 帧 / 20fps = 3s */
  will-change: transform;
}

@keyframes whaleTailPlay {
  from { transform: translateX(0); }
  to { transform: translateX(-2160rpx); }  /* 60 帧无缝循环 */
}

/* 文案流光（对齐 iOS：相位周期 2.2s，[base, highlight, base] 水平扫过） */
.progress-text {
  font-size: 28rpx;             /* 14pt */
  font-weight: 500;             /* medium */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-light .progress-text,
.progress-text {
  color: transparent;
  background-image: linear-gradient(
    100deg,
    #18365A 0%,
    #18365A 38%,
    #5B7FA9 50%,
    #18365A 62%,
    #18365A 100%
  );
  background-size: 220% 100%;
  background-repeat: no-repeat;
  -webkit-background-clip: text;
  background-clip: text;
  animation: runShimmer 2.2s linear infinite;
}

.theme-dark .progress-text {
  background-image: linear-gradient(
    100deg,
    #A8BEDB 0%,
    #A8BEDB 38%,
    #D5E3F4 50%,
    #A8BEDB 62%,
    #A8BEDB 100%
  );
}

@keyframes runShimmer {
  from { background-position: 140% 0; }
  to { background-position: -40% 0; }
}

/* 工具行摘要（对齐 iOS 工具头：摘要标签+注释+失败/等待结果+参数两行） */
.tool-line {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-right: 8rpx;
}

.tool-line-1 {
  display: flex;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
}

.tool-act {
  font-size: 26rpx;
  font-weight: 600;
  color: #F07D14;
}

.tool-note {
  font-size: 22rpx;
  font-family: monospace;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.tool-status {
  font-size: 20rpx;
  color: var(--text-3);
}

.tool-status.err {
  color: #E5533C;
  font-weight: 600;
}

.trace-status {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #34A853;
  flex-shrink: 0;
}

.trace-status.err {
  color: #E5533C;
}

.tool-args {
  font-size: 22rpx;
  font-family: monospace;
  color: var(--text-3);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 滚到底按钮（36×36 玻璃圆） */
.jump-wrap {
  position: absolute;
  right: 0;
  bottom: calc(100% + 16rpx);
  margin: 0;
}

.jump-bottom {
  position: relative;
  width: 72rpx;                 /* 36pt 玻璃圆，对齐 DSH */
  height: 72rpx;
  border-radius: 50%;
  background: rgba(120, 120, 128, 0.24);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.jump-ic {
  width: 32rpx;
  height: 32rpx;
}

@keyframes runSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 运行时：箭头不变，外圈套一条海蓝进度环（对齐 DSH ocean 进度色） */
.jump-ring {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  border: 3rpx solid rgba(46, 107, 230, 0.25);
  border-top-color: #2E6BE6;
  animation: runSpin 0.9s linear infinite;
}

/* 状态行（命令/压缩） */
/* 状态行（iOS .status：spacing 9；subheadline 15pt；vertical 6） */
.delivered-files { display:flex; flex-direction:column; gap:20rpx; min-width:0; }
/* Each turn-tail block is independent, including presented → edited cards. */
.delivered-files + .changed-files,
.changed-files + .delivered-files,
.delivered-files + .delivered-files,
.changed-files + .changed-files { margin-top:20rpx; }
.changed-files { min-width:0; overflow:hidden; border:1rpx solid var(--border-strong); border-radius:24rpx; background:var(--surface); }
.changed-files-head { display:flex; align-items:center; gap:18rpx; padding:20rpx; min-height:84rpx; }
.changed-counts { display:flex; align-items:center; gap:14rpx; flex-shrink:0; font-size:24rpx; font-variant-numeric:tabular-nums; }
.changed-added { color:#138547; }
.changed-deleted { color:#ce3439; }
.theme-dark .changed-added { color:#39c975; }
.theme-dark .changed-deleted { color:#ff6b70; }
.changed-file-list { border-top:1rpx solid var(--divider); }
.changed-file-row { display:flex; align-items:center; gap:16rpx; min-height:88rpx; padding:14rpx 24rpx; box-sizing:border-box; }
.changed-file-icon { width:30rpx; height:36rpx; flex-shrink:0; }
.changed-file-copy { display:flex; flex-direction:column; gap:4rpx; flex:1; min-width:0; }
.changed-file-name { color:var(--text); font-size:26rpx; line-height:1.5; overflow-wrap:anywhere; }
.changed-file-path { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text-2); font-size:22rpx; }
.changed-files .delivered-file-name { white-space:normal; overflow-wrap:anywhere; }
.changed-file-pressed { background:rgba(128,128,128,.12); }
.changes-hunk { margin-bottom:24rpx; font-family:var(--dsh-font-family-code,monospace); font-size:23rpx; line-height:1.65; }
.changes-hunk-label { display:block; color:var(--text-2); padding:10rpx; background:rgba(128,128,128,.08); }
.changes-line { display:block; white-space:pre-wrap; overflow-wrap:anywhere; color:var(--text); padding:0 10rpx; }
.changes-line.add { background:rgba(34,177,88,.12); }
.changes-line.delete { background:rgba(224,62,66,.12); }
.delivered-file { display:flex; align-items:center; gap:18rpx; padding:18rpx; min-width:0; border:1rpx solid var(--border-strong); border-radius:24rpx; background:var(--surface); }
.delivered-file-pressed { opacity:.72; }
.delivered-file-icon { width:64rpx; height:68rpx; flex-shrink:0; display:flex; align-items:center; justify-content:center; border-radius:16rpx; background:rgba(128,128,128,.08); border:1rpx solid var(--divider); }
.delivered-file-icon image { width:40rpx; height:46rpx; }
.delivered-file-copy { flex:1; min-width:0; display:flex; flex-direction:column; gap:6rpx; }
.delivered-file-name { color:var(--text); font-size:28rpx; font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.delivered-file-description { color:var(--text-2); font-size:23rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.delivered-file-controls { display:flex; align-items:center; flex-shrink:0; border:1rpx solid var(--border-strong); border-radius:14rpx; }
.delivered-file-open,.delivered-file-more { display:flex; align-items:center; justify-content:center; width:60rpx; height:72rpx; }
.delivered-file-open image { width:29rpx; height:29rpx; opacity:.8; }
.theme-dark .delivered-file-open image { filter:brightness(0) invert(.8); }
.delivered-file-more { width:46rpx; border-left:1rpx solid var(--divider); }
.delivered-chevron { width:10rpx; height:10rpx; border-right:2rpx solid var(--text-2); border-bottom:2rpx solid var(--text-2); transform:translateY(-3rpx) rotate(45deg); }
.delivered-file-toggle { text-align:center; color:var(--text-2); font-size:24rpx; padding:16rpx; }
.delivered-sheet-head { display:flex; align-items:center; gap:24rpx; margin:16rpx 0 24rpx; color:var(--text); font-size:30rpx; }
.delivered-sheet-head > text { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:600; }
.delivered-sheet-head > view { flex-shrink:0; display:flex; align-items:center; justify-content: flex-end; min-width:72rpx; min-height:64rpx; padding:12rpx; }
.delivered-action { padding:26rpx 12rpx; color:var(--text); font-size:29rpx; border-top:1rpx solid var(--divider); }
.delivered-preview { display:flex; flex-direction:column; height:82vh; }
.delivered-preview > .delivered-action { flex-shrink:0; min-height:88rpx; box-sizing:border-box; }
.delivered-action[aria-disabled="true"] { color:var(--text-2); }
.delivered-preview-scroll { flex:1; min-height:0; height:0; }
.delivered-preview-text { display:block; padding:20rpx 4rpx; white-space:pre-wrap; overflow-wrap:anywhere; font-family:var(--dsh-font-family-code,monospace); font-size:25rpx; line-height:1.65; color:var(--text); }
.delivered-preview-note { color:var(--text-2); font-size:23rpx; padding-bottom:16rpx; }

.row-status {
  display: flex;
  align-items: baseline;
  gap: 18rpx;                     /* spacing 9 */
  min-width: 0;
  padding: 12rpx 0;               /* vertical 6 */
  font-size: 30rpx;               /* subheadline 15pt */
}

.status-ic {
  width: 26rpx;                   /* 13pt */
  height: 26rpx;
  flex-shrink: 0;
  align-self: center;
}

.status-title {
  font-weight: 500;
  color: var(--text);
}

.status-dot {
  color: var(--text-3);
}

.status-text {
  color: var(--text-2);
}

/* ============ 排队消息 dock（对齐 iOS queue dock） ============ */
.queue-dock {
  width: 100%;
  margin: 0 0 12rpx;
  padding: 0;
  box-sizing: border-box;
  z-index: 2;
  flex: none;
}

.queue-panel {
  isolation: isolate;
  position: relative;
  width: 100%;
  padding: 4rpx 0;
  box-sizing: border-box;
  border-radius: 36rpx;
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid var(--border-strong);
  box-shadow: 0 8rpx 24rpx rgba(7, 24, 43, 0.08);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.theme-dark .queue-panel {
  background: var(--surface);
  border-color: var(--border-strong);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.24);
}

.queue-head {
  width: 100%;
  height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.queue-lead {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.queue-head-ic {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.72;
}

.queue-row-ic {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.72;
}

.queue-head-title {
  min-width: 0;
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 48rpx;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.queue-head-status,
.queue-status {
  flex: 0 0 auto;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 36rpx;
  white-space: nowrap;
}

.queue-head-chev {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.queue-head-chev-ic {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.72;
}

.queue-list.capped {
  max-height: 360rpx;
}

.queue-row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 80rpx;
  gap: 8rpx;
  padding: 4rpx 8rpx 4rpx 24rpx;
}

.queue-content {
  min-width: 0;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  padding: 6rpx 0;
}

.queue-preview {
  min-width: 0;
  width: 100%;
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 36rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
}

.queue-attachment-label {
  color: var(--text-2);
  font-size: 22rpx;
  line-height: 30rpx;
}

.queue-attachments {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  max-width: 100%;
  flex: 0 1 auto;
  overflow: hidden;
}

.queue-thumb,
.queue-file {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--surface);
}

.queue-thumb {
  object-fit: cover;
}

.queue-file {
  display: flex;
  align-items: center;
  gap: 4rpx;
  width: 180rpx;
  max-width: 180rpx;
  padding: 0 10rpx;
  overflow: hidden;
}

.queue-file-ic {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  opacity: 0.72;
}

.queue-file-name {
  min-width: 0;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.queue-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.queue-ic-btn {
  width: 72rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 999rpx;
}

.queue-ic {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.72;
}

.queue-ic-btn.busy {
  opacity: 0.5;
}

.queue-sep {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.08);
  margin: 0 20rpx;
}

.theme-dark .queue-sep {
  background: rgba(255, 255, 255, 0.14);
}

/* ============ 会话状态紧凑浮窗（统计胶囊上方） ============ */
.stats-pop-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 5;
  background: transparent;
}
.stats-pop {
  position: absolute;
  bottom: calc(100% + 14rpx);
  z-index: 6;
  box-sizing: border-box;
  width: min(560rpx, calc(100vw - 56rpx));
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  box-shadow: var(--float-shadow);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}
.stats-pop.run { left: 0; right: auto; }
.stats-pop.token { left: 50%; right: auto; transform: translateX(-50%); }
.stats-pop-title{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding-bottom:14rpx;margin-bottom:4rpx;border-bottom:1rpx solid var(--divider);font-size:27rpx;font-weight:600;color:var(--text);font-variant-numeric:tabular-nums}
.stats-pop-title .metric-icon{filter:brightness(0);opacity:1}
.theme-dark .stats-pop-title .metric-icon{filter:brightness(0) invert(1);opacity:1}
.stats-pop-heading {
  min-width: 0;
  flex: 1;
}
.stats-pop-total {
  flex: 0 0 auto;
  margin-left: auto;
  text-align: right;
  white-space: nowrap;
}
.stats-pop-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  padding: 9rpx 0;
}
.stats-pop-label {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  color: var(--text-2);
}
.stats-pop-value {
  flex: 0 0 auto;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.stats-pop-link {
  margin-top: 12rpx;
  padding: 16rpx 0 6rpx;
  border-top: 1rpx solid var(--divider);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.stats-pop-link:active {
  opacity: 0.6;
}

.stats-sheet{position:fixed;left:0;right:0;bottom:0;z-index:220;background:var(--surface);border-radius:40rpx 40rpx 0 0;padding:16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));max-height:70vh;display:flex;flex-direction:column;}.stats-sheet-handle{align-self:center;width:72rpx;height:8rpx;border-radius:8rpx;background:rgba(127,127,127,0.24);margin-bottom:16rpx;}.stats-sheet-title{font-size:32rpx;font-weight:600;color:var(--text);text-align:center;margin-bottom:8rpx;}.stats-sheet-body{flex:1;min-height:0;}.stats-group-title{font-size:24rpx;font-weight:600;color:var(--text-2);padding:20rpx 0 8rpx;}.stats-row{display:flex;align-items:center;justify-content:space-between;padding:12rpx 0;}.stats-row-label{font-size:26rpx;color:var(--text-2);}.stats-row-val{font-size:26rpx;font-weight:500;font-family:monospace;color:var(--text);}.stats-footnote{font-size:22rpx;color:var(--text-3);padding:20rpx 0 8rpx;}.stats-sheet-done{margin-top:16rpx;text-align:center;font-size:28rpx;font-weight:600;color:#2E6BE6;padding:18rpx 0;border-top:1rpx solid var(--divider,rgba(0,0,0,0.06));}

/* ============ 对话空态 ============ */
.conv-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 56rpx;          /* padding h28 */
  gap: 28rpx;                     /* spacing 14 */
}

.conv-empty-logo {
  width: 104rpx;
  height: 78rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.conv-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.conv-empty-desc {
  font-size: 24rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.6;
}

/* ============ 审批卡（对齐 iOS ApprovalRequestView amber 体系） ============ */
.approval-card {
  border: 1rpx solid rgba(245, 156, 13, 0.78);
  background: var(--surface);
  padding: 0;
  overflow: hidden;
}

.approval-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(245, 156, 13, 0.10);
}

.approval-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #F59C0D;
}

.approval-head-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #B26B00;
}

.theme-dark .approval-head-title {
  color: #F59C0D;
}

.approval-replayed {
  font-size: 24rpx;
  color: var(--text-2);
}

.approval-spacer {
  flex: 1;
}

.approval-body {
  padding: 20rpx 24rpx 8rpx;
}

.approval-tool {
  font-size: 26rpx;
  font-family: monospace;
  color: var(--text-2);
  margin-bottom: 8rpx;
}

.approval-reason {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  line-height: 1.5;
}

/* ============ 提问卡补充（对齐 iOS HumanQuestionView） ============ */
.q-spacer {
  flex: 1;
}

.q-abandon {
  font-size: 24rpx;
  color: var(--text-2);
  padding: 6rpx 16rpx;
}

.q-multi-hint {
  font-size: 22rpx;
  color: var(--text-2);
  margin: 4rpx 0 8rpx;
}

.q-recommend {
  display: inline-block;
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #2E6BE6;
  background: rgba(46, 107, 230, 0.12);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  vertical-align: middle;
}

.q-option.selected {
  background: rgba(46, 107, 230, 0.09);
  border: 1rpx solid rgba(46, 107, 230, 0.48);
}

.q-option {
  border: 1rpx solid rgba(127, 127, 127, 0.14);
}

.q-custom-row {
  padding: 14rpx 18rpx;
  border-radius: 26rpx;
  background: rgba(127, 127, 127, 0.08);
  margin-top: 4rpx;
}

.q-custom-hint {
  font-size: 24rpx;
  color: var(--text-2);
}

/* ============ 顶栏连接状态点（8×8pt + 同色外发光，spec §6） ============ */
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #98A2B3;
}

.status-dot.connected {
  background: #2EB85C;
  box-shadow: 0 0 10rpx rgba(46, 184, 92, 0.65);
}

.status-dot.connecting {
  background: #FFAD1F;
  box-shadow: 0 0 10rpx rgba(255, 173, 31, 0.65);
}

.status-dot.failed {
  background: #E5533C;
  box-shadow: 0 0 10rpx rgba(229, 83, 60, 0.65);
}

.status-dot.disconnected {
  background: #98A2B3;
}

/* ============ 选择浮层（权限/模式：图标行 + 当前项对勾） ============ */
.opt-mask {
  position: fixed;
  inset: 0;
  z-index: 199;
}

.opt-pop {
  position: fixed;
  right: 24rpx;
  bottom: calc(320rpx + env(safe-area-inset-bottom));
  min-width: 420rpx;
  max-width: 640rpx;
  z-index: 200;
  background: var(--surface, #FFFFFF);
  border: 1rpx solid var(--border, rgba(0, 0, 0, 0.08));
  border-radius: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.18);
  padding: 8rpx;
}

.opt-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
}

.opt-row.current {
  background: rgba(46, 107, 230, 0.07);
}

.opt-ic {
  width: 34rpx;
  height: 34rpx;
}

.opt-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.opt-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

.opt-desc {
  font-size: 22rpx;
  color: var(--text-2);
}

.opt-check {
  width: 30rpx;
  height: 30rpx;
}

/* ============ 提问卡：单题翻页 + 收起态（对齐 iOS HumanQuestionView） ============ */
.q-collapsed {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 24rpx;
}

.q-collapsed-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.q-collapsed-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.q-collapsed-sub {
  font-size: 22rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.q-head-btn {
  padding: 8rpx;
}

.q-chev {
  width: 30rpx;
  height: 30rpx;
}

.q-chev.flip {
  transform: rotate(180deg);
}

.q-replayed {
  font-size: 22rpx;
  color: var(--text-2);
}

.q-header {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-2);
  margin-bottom: 6rpx;
}

/* 选项前置选择指示器：radio 圆形 / checkbox 方形（iOS largecircle/square 对齐） */
.q-option {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(127, 127, 127, 0.035);
  border: 2rpx solid rgba(127, 127, 127, 0.07);
}

.q-sel {
  flex-shrink: 0;
  width: 38rpx;
  height: 38rpx;
  margin-top: 2rpx;
  border: 3rpx solid rgba(127, 127, 127, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.q-sel.radio {
  border-radius: 50%;
}

.q-sel.box {
  border-radius: 8rpx;
}

.q-option.selected .q-sel {
  border-color: #2E6BE6;
  background: #2E6BE6;
}

.q-sel-ic {
  width: 24rpx;
  height: 24rpx;
}

.q-option-main {
  flex: 1;
  min-width: 0;
}

/* 自定义答案行（pencil.line + 输入框，对齐 iOS） */
.q-custom-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(127, 127, 127, 0.05);
}

.q-pencil {
  width: 28rpx;
  height: 28rpx;
}

.q-custom-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
}

/* 底部翻页器 */
.q-footer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx 8rpx;
  border-top: 1rpx solid var(--divider, rgba(0, 0, 0, 0.06));
  margin-top: 8rpx;
}

.q-page-btn {
  padding: 8rpx;
}

.q-page-btn.disabled {
  opacity: 0.35;
}

.q-page-num {
  font-size: 24rpx;
  color: var(--text-2);
  font-family: monospace;
}

.dock-stack.question-active {
  transform: translateY(-12px);
}

.q-confirm-head {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  margin-bottom: 12rpx;
}

.q-confirm-head .q-header {
  margin: 0;
  font-size: 26rpx;
  font-weight: 500;
}

.question-card .q-question {
