/* 所有者专属：兑换码生成 */
.public-code-block {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--divider);
}

.public-code-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.public-code-title {
  color: var(--text);
  font-size: 27rpx;
  font-weight: 550;
}

.public-code-desc {
  color: var(--text-2);
  font-size: 22rpx;
}

.public-code-actions {
  display: flex;
  margin-top: 16rpx;
}

.public-code-result {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: var(--fill);
}

.public-code-value {
  color: var(--text);
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.public-code-copy {
  color: var(--ocean);
  font-size: 24rpx;
}

.public-code-meta {
  display: block;
  margin-top: 10rpx;
  color: var(--text-2);
  font-size: 21rpx;
}

.public-share-copy {
  color: var(--ocean);
  font-size: 23rpx;
}

.node-group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.node-count {
  display: flex;
  align-items: center;
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 400;
}

.node-count .chevron-img {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.9;
}

.node-count-active,
.node-add-active {
  opacity: 0.65;
}

.node-empty {
  display: flex;
  flex-direction: column;
  padding: 30rpx 32rpx;
}

.node-empty-title {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 600;
}

.node-empty-desc {
  margin-top: 4rpx;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.45;
}

.node-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 32rpx;
  min-height: 104rpx;
  border-top: 1rpx solid var(--divider);
}

.node-row-active {
  background: var(--fill);
}

.node-main {
  flex: 1;
  min-width: 0;
}

.node-name-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.node-name-line .status-dot {
  flex-shrink: 0;
}

.node-name {
  overflow: hidden;
  color: var(--text);
  font-size: 28rpx;
  font-weight: 550;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-current {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(46, 107, 230, 0.10);
  color: var(--ocean);
  font-size: 21rpx;
}

.node-id {
  display: block;
  max-width: 100%;
  margin: 4rpx 0 0 26rpx;
  overflow: hidden;
  color: var(--text-3);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-actions {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.node-status {
  color: var(--text-2);
  font-size: 22rpx;
}

.node-copy {
  color: var(--ocean);
  font-size: 22rpx;
}

.node-add-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  min-height: 88rpx;
  border-top: 1rpx solid var(--divider);
}

.node-share-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid var(--divider);
}

.node-share-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.node-share-title {
  color: var(--text);
  font-size: 27rpx;
  font-weight: 550;
}

.node-share-expiry {
  margin-top: 4rpx;
  color: var(--text-2);
  font-size: 21rpx;
}

.node-share-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 16rpx;
}

.node-share-actions button {
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 8rpx;
  background: var(--fill);
  color: var(--ocean);
  font-size: 23rpx;
  line-height: 56rpx;
}

.node-share-actions button::after {
  border: 0;
}

.node-share-actions button[disabled] {
  color: var(--text-3);
  opacity: 0.55;
}

.node-share-copy-button {
  color: var(--ocean);
  font-size: 23rpx;
}

.node-add-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: rgba(46, 107, 230, 0.12);
  color: var(--ocean);
  font-size: 30rpx;
  line-height: 1;
}

.node-add-label {
  flex: 1;
  color: var(--ocean);
  font-size: 28rpx;
}

.pair-sheet-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.42);
}

.pair-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 10rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--surface);
  color: var(--text);
}

.pair-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 16rpx 0 24rpx;
}

.pair-sheet-head > view {
  display: flex;
  flex-direction: column;
}

.pair-sheet-title {
  color: var(--text);
  font-size: 34rpx;
  font-weight: 650;
}

.pair-sheet-subtitle {
  margin-top: 4rpx;
  color: var(--text-2);
  font-size: 23rpx;
}

.pair-sheet-close {
  padding: 8rpx 0 8rpx 20rpx;
  color: var(--text-2);
  font-size: 25rpx;
}

.pair-payload-input {
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--fill);
  color: var(--text);
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 23rpx;
  line-height: 1.45;
}

.pair-payload-placeholder {
  color: var(--text-4);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.pair-result {
  display: block;
  min-height: 34rpx;
  margin-top: 12rpx;
  color: #D14343;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-word;
}

.pair-result-pending {
  color: var(--text-2);
}

.pair-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 14rpx;
  border-radius: 16rpx;
  background: var(--ocean);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.pair-submit-disabled {
  opacity: 0.45;
}

/* 双主题：基础样式已全部变量化（app.wxss / 上方规则），无需 page-dark 覆盖 */

/* 管理员区：两张卡片之间留出间距（避免贴在一起） */
.settings .card + .card {
  margin-top: 24rpx;
}
.referral-mask { position: fixed; inset: 0; z-index: 1600; background: rgba(0,0,0,.4); display: flex; align-items: flex-end; }
.referral-sheet { width: 100%; box-sizing: border-box; padding: 16rpx 36rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: var(--surface); color: var(--text); }
.referral-title { display: block; font-size: 36rpx; font-weight: 600; text-align: center; margin: 18rpx 0 8rpx; }
.referral-subtitle { display: block; text-align: center; color: var(--text-2); font-size: 24rpx; margin-bottom: 24rpx; }
.referral-sheet .referral-option { display: flex; align-items: center; gap: 22rpx; width: 100%; box-sizing: border-box; margin: 0; padding: 30rpx 8rpx; background: transparent; color: var(--text); font-weight: 400; text-align: left; line-height: 1.5; border-radius: 0; border-bottom: 1rpx solid var(--divider); }
.referral-option::after, .referral-rules::after, .referral-cancel::after { border: 0; }
.referral-option[disabled] {
  opacity: 1;
  background: transparent !important;   /* 覆盖微信 disabled 按钮的灰色底 */
  color: var(--text);                   /* 与「朋友圈」一致，不做置灰 */
}
.referral-option[disabled]::after { border: 0; }
.referral-option[disabled] .referral-copy { color: var(--text); }
.referral-option[disabled] .referral-desc { color: var(--text-3); }
.referral-icon { width: 72rpx; height: 72rpx; border-radius: 22rpx; background: var(--fill); color: var(--ocean); font-size: 30rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.referral-copy { flex: 1; min-width: 0; font-size: 29rpx; }
.referral-copy text { display: block; }
.referral-desc { color: var(--text-2); font-size: 23rpx; margin-top: 6rpx; }
.referral-chevron { color: var(--text-3); font-size: 38rpx; }
.referral-sheet .referral-rules { width: 100%; margin: 14rpx 0 26rpx; padding: 10rpx 0; background: transparent; color: var(--text-2); font-size: 24rpx; font-weight: 400; text-align: left; line-height: 1.8; }
.referral-sheet .referral-cancel { width: 100%; margin: 0; padding: 0; background: var(--fill); color: var(--text); border-radius: 999rpx; font-size: 28rpx; font-weight: 500; line-height: 84rpx; }
/* 覆盖微信 button:not([size=mini]) 的固定宽度与默认按钮排版。 */
.settings .card-row.about-contact { display: flex; width: 100%; max-width: none; margin: 0; padding: 30rpx 32rpx; min-height: 112rpx; align-items: center; justify-content: space-between; background: transparent; color: var(--text); border-radius: 0; text-align: left; font-size: 31rpx; font-weight: normal; line-height: 1.5; box-sizing: border-box; }
.settings .about-contact::after { border: 0; }
.public-device-row { justify-content: flex-start; }
.public-device-row .public-detail-label, .public-device-row .public-copy-id { flex-shrink: 0; }
.public-device-value { flex: 1; min-width: 0; color: var(--text); font-size: 24rpx; line-height: 1.5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: left; }

/* ---------- 自定义导航（与胶囊同行，主题完全可控） ---------- */
.settings .nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: 0;
  margin-right: 20rpx;
  box-sizing: content-box;
}

.settings .nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.settings .nav-back-ic {
  width: 32rpx;
  height: 32rpx;
}

.settings .nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.press-dim {
  opacity: 0.65;
}
.about-version-value { min-width: 0; flex: 1; text-align: right; white-space: normal; overflow-wrap: anywhere; }
