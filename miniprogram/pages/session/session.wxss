  border-radius: 20rpx;
  background: var(--fill-2);
  color: var(--text);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 助手正文复制按钮（对齐 CopyButton） */

.assistant-copy {
