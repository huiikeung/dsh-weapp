  pointer-events: none;
  background: linear-gradient(to bottom, transparent, var(--bg) 24rpx);
}
.theme-dark .composer-backdrop {
  background: linear-gradient(to bottom, transparent, var(--bg) 24rpx);
}
.dock-stack {
  left: 28rpx;
  right: 28rpx;
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  z-index: 60;
}
.composer-top-row {
  position: relative;
  z-index: 2;
  justify-content: flex-start;
  gap: 16rpx;
  margin: 0 0 12rpx;
  padding: 0 28rpx;
}
.preset-capsule,
.stats-pill {
