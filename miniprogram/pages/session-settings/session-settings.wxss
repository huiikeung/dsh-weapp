.session-settings { padding: 0 40rpx calc(60rpx + env(safe-area-inset-bottom)); color: var(--text); }
.session-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 10; padding-left: 40rpx; padding-right: 40rpx; background: var(--bg); display: flex; align-items: center; box-sizing: content-box; }
.session-nav-placeholder { margin-bottom: 20rpx; }
.session-nav-back {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--fill);          /* 与左侧栏设置页一致的圆形底 */
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.session-nav-back::before { content: ''; position: absolute; left: 50%; top: 50%; width: 44px; height: 44px; transform: translate(-50%, -50%); }
.session-nav-back-icon { width: 32rpx; height: 32rpx; }
.session-nav-title { position: absolute; left: 96rpx; right: 96rpx; display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 600; color: var(--text); pointer-events: none; }
.session-nav-pressed { opacity: .65; }
.session-settings .card-row { gap: 24rpx; }
.session-settings .card-row-label { min-width: 0; }
.session-settings .card-row-value { min-width: 0; max-width: 65%; justify-content: flex-end; }
.session-settings .card-row-value > text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chevron-img { width: 26rpx; height: 26rpx; margin-left: 12rpx; flex-shrink: 0; opacity: .55; }
.host-value { max-width: 65%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.utility-mask { position: fixed; z-index: 100; inset: 0; display: flex; align-items: flex-end; background: rgba(0, 0, 0, .42); }
.utility-sheet { width: 100%; max-height: 92vh; box-sizing: border-box; padding: 10rpx 40rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: var(--surface); color: var(--text); display: flex; flex-direction: column; }
.utility-header { position: relative; display: flex; align-items: center; min-height: 64rpx; margin: 8rpx 0 16rpx; padding-right: 68rpx; flex-shrink: 0; }
.utility-title { font-size: 34rpx; font-weight: 650; }
.utility-sheet .utility-close { position: absolute; right: 0; top: 50%; transform: translateY(-50%); display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; margin: 0; padding: 0; background: transparent; border: 0; box-shadow: none; flex-shrink: 0; }
.utility-scroll { min-height: 0; max-height: 50vh; }
.diagnostic-list { border: 1rpx solid var(--border); border-radius: 24rpx; overflow: hidden; }
.diagnostic-row { display: flex; gap: 24rpx; align-items: flex-start; padding: 24rpx; }
.diagnostic-row + .diagnostic-row { border-top: 1rpx solid var(--divider); }
.diagnostic-label { flex: none; color: var(--text-2); font-size: 26rpx; line-height: 1.5; }
.diagnostic-value { flex: 1; min-width: 0; text-align: right; color: var(--text); font-size: 26rpx; line-height: 1.5; overflow-wrap: anywhere; word-break: break-all; white-space: pre-wrap; }
.cache-description { font-size: 29rpx; line-height: 1.7; color: var(--text); padding: 4rpx 0 24rpx; }
.cache-description text { display: block; }
.cache-note { color: var(--text-2); font-size: 25rpx; margin-top: 16rpx; }
.cache-error { color: #BF3D31; font-size: 25rpx; margin-top: 16rpx; }
.theme-dark .cache-error { color: #FF8E82; }
.utility-actions { display: flex; gap: 20rpx; margin-top: 24rpx; flex-shrink: 0; }
.utility-sheet .utility-button { flex: 1; width: 100%; min-width: 0; margin: 0; padding: 24rpx 16rpx; border-radius: 22rpx; font-size: 29rpx; font-weight: 500; line-height: 1.5; }
.utility-button::after, .utility-close::after { border: 0; }
.utility-sheet .utility-cancel { background: var(--fill); color: var(--text); }
.utility-sheet .utility-confirm { background: #BF3D31; color: #FFFFFF; }
.theme-dark .utility-sheet .utility-confirm { background: #A83227; }
.utility-sheet .utility-done { flex: none; margin-top: 24rpx; background: var(--fill); color: var(--text); }
.utility-sheet button[disabled] { opacity: .5; }
.session-settings .build-value { white-space: normal; font-size: 24rpx; overflow-wrap: anywhere; text-align: right; }

/* ---------- 与设置页一致的底部弹窗（选择项） ---------- */
.pair-sheet-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.42);
}

.pair-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 10rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--surface);
  color: var(--text);
  display: flex;
  flex-direction: column;
}

.pair-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 24rpx;
}

.pair-sheet-title {
  color: var(--text);
  font-size: 34rpx;
  font-weight: 650;
}

.pair-sheet-close { display: flex; align-items: center; justify-content: flex-end; width: 64rpx; height: 64rpx; padding: 0; flex-shrink: 0; }

.picker-option-list {
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  flex: none;            /* 高度由上方的 max-height 决定，内部独立滚动 */
  width: 100%;
}

.picker-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  font-size: 30rpx;
  color: var(--text);
}

.picker-option + .picker-option {
  border-top: 1rpx solid var(--divider);
}

.picker-option:active {
  background: var(--fill);
}

.picker-option-label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-option.checked .picker-option-label {
  color: var(--ocean);
  font-weight: 600;
}

.picker-option-check {
  flex: none;
  color: var(--ocean);
  font-size: 30rpx;
  font-weight: 600;
}

/* Agent preset and model cards follow dsh-mobile while staying in the existing sheet. */
.picker-option-list.preset-picker-list,
.picker-option-list.model-picker-list,
.picker-option-list.permission-picker-list {
  border: 0;
  border-radius: 0;
  overflow: visible;
  padding: 0 2rpx 8rpx;
  box-sizing: border-box;
}

.picker-intro {
  margin: 0 8rpx 20rpx;
  color: var(--text-2);
  font-size: 25rpx;
  line-height: 1.55;
}

.preset-option-card,
.model-option-card {
  box-sizing: border-box;
  margin-bottom: 14rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  background: var(--fill);
  transition: background-color 0.16s ease, border-color 0.16s ease, opacity 0.16s ease;
}

.preset-option-card.selected,
.model-option-card.selected {
  border: 1rpx solid var(--text);
}

.preset-option-card.broken {
  opacity: .68;
}

.picker-card-hover,
.model-option-main-hover {
  background: var(--fill-2);
}

.preset-card-head,
.model-option-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.permission-card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.permission-card-icon {
  width: 42rpx;
  height: 42rpx;
  flex: none;
}

.preset-card-name,
.model-option-name {
  flex: 0 1 auto;
  min-width: 0;
  color: var(--text);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}

.preset-card-id {
  flex: none;
  max-width: 190rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--fill-2);
  color: var(--text-2);
  font-size: 21rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-current-badge {
  flex: none;
  margin-left: auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #111315;
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.25;
}

.permission-experimental-badge {
  flex: none;
  padding: 5rpx 9rpx;
  border-radius: 8rpx;
  background: rgba(196, 102, 11, .12);
  color: #B65B00;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: .4rpx;
}

.theme-dark .permission-experimental-badge {
  background: rgba(255, 180, 84, .16);
  color: #FFB454;
}

.preset-card-description {
  display: block;
  margin-top: 14rpx;
  color: var(--text-2);
  font-size: 25rpx;
  line-height: 1.55;
}

.preset-card-warning {
  display: block;
  margin-top: 14rpx;
  color: #C4660B;
  font-size: 23rpx;
  line-height: 1.45;
}

.theme-dark .preset-card-warning {
  color: #FFB454;
}

/* Model groups use provider headings and one bordered card per model. */
.picker-provider-title {
  margin: 18rpx 6rpx 10rpx;
  color: var(--text-2);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.4;
}

.picker-provider-title:first-child {
  margin-top: 0;
}

.model-option-main {
  min-height: 42rpx;
  border-radius: 8rpx;
}

.model-effort-section {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}

.model-effort-label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--text-2);
  font-size: 22rpx;
  font-weight: 500;
}

.model-effort-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.model-effort-chip {
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--text);
  font-size: 22rpx;
  line-height: 1.3;
}

.model-effort-chip.selected {
  border-color: var(--text);
  background: var(--text);
  color: var(--bg);
  font-weight: 600;
}

.model-effort-chip-hover {
  opacity: .72;
}

/* General picker group headings (permissions / reasoning effort) */
.picker-group {
  padding: 20rpx 28rpx 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  color: var(--text-3);
  background: var(--fill);
}

/* ---------- 工作区文件弹窗 ---------- */
.files-toolbar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin: 0 0 12rpx;
}

.files-up {
  padding: 10rpx 4rpx;
  color: var(--ocean);
  font-size: 27rpx;
}

.files-up.disabled {
  visibility: hidden;
}

.files-list {
  flex: none;
}

.files-center {
  padding: 40rpx 20rpx;
  text-align: center;
  color: var(--text-2);
  font-size: 27rpx;
}

.files-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 28rpx;
}

.files-row + .files-row {
  border-top: 1rpx solid var(--divider);
}

.files-row-hover {
  background: var(--fill);
}

.files-row-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.files-row-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.files-row-name {
  font-size: 29rpx;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.files-row-sub {
  font-size: 23rpx;
  color: var(--text-3);
}

.files-row-chevron {
  flex: none;
  color: var(--text-3);
  font-size: 30rpx;
}

/* 当前路径：弹窗底部、左对齐 */
.files-path-footer {
  padding: 16rpx 8rpx 4rpx;
  color: var(--text-2);
  font-size: 24rpx;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* ---------- 可拖动/点击调整高度的弹窗 ---------- */
.sheet-grabber-zone {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 8rpx 0;
  margin-bottom: 4rpx;
  flex-shrink: 0;
}

.pair-sheet.resizable {
  transition: height 0.24s cubic-bezier(0.32, 0.72, 0, 1);
}

/* 选择弹窗展开后列表占用剩余高度 */
.pair-sheet.expanded .picker-option-list {
  max-height: none;
  flex: 1;
  min-height: 0;
}

/* 诊断/清理弹窗展开后内容占满剩余高度；关闭图标无底色无阴影 */
.utility-sheet.expanded .utility-scroll {
  max-height: none;
  flex: 1;
  min-height: 0;
}

.utility-sheet .utility-close .sheet-close-x {
  background: var(--fill);   /* 恢复圆形底，仅去掉外部阴影 */
  box-shadow: none;
}

.utility-close::after { border: 0; box-shadow: none; }
