/* 插件详情页（对齐 dsh-mobile PluginDetailView / PluginComponentSheet） */

.pdetail {
  --pd-bg: #FFFFFF;
  --pd-text: #000000;
  --pd-text2: rgba(60, 60, 67, 0.6);
  --pd-text3: rgba(60, 60, 67, 0.35);
  --pd-fallback: #E5E5EA;
  --pd-capsule: rgba(120, 120, 128, 0.12);
  --pd-warn: #FF9500;
  --pd-err: #FF3B30;
  --pd-dot-ok: #34C759;
  --pd-dot-bad: #FF3B30;
  --pd-dot-off: #8E8E93;
  --pd-divider: rgba(60, 60, 67, 0.12);
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--pd-bg);
  color: var(--pd-text);
}

.pdetail.theme-dark {
  --pd-bg: #000000;
  --pd-text: #FFFFFF;
  --pd-text2: rgba(235, 235, 245, 0.6);
  --pd-text3: rgba(235, 235, 245, 0.35);
  --pd-fallback: #3A3A3C;
  --pd-capsule: rgba(120, 120, 128, 0.24);
  --pd-dot-ok: #30D158;
  --pd-dot-bad: #FF453A;
  --pd-dot-off: #98989D;
}

/* ---------- 头部 ---------- */

.pdetail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx 24rpx;
  flex-shrink: 0;
}

.pdetail-back {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--pd-bg);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pdetail.theme-dark .pdetail-back {
  border-color: rgba(255, 255, 255, 0.10);
}

.press-dim {
  opacity: 0.65;
}

.pdetail-back-ic {
  width: 36rpx;
  height: 36rpx;
}

.pdetail-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--pd-text);
}

.pdetail-scroll {
  flex: 1;
  min-height: 0;
}

.pdetail-body {
  padding: 24rpx 44rpx 60rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pdetail-gap {
  margin-top: 32rpx;
}

/* ---------- 概要 ---------- */

.pdetail-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.pdetail-icon {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.pdetail-icon-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
}

.pdetail-icon-fallback {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: var(--pd-fallback);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pdetail-icon-fallback text {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--pd-text);
  text-transform: uppercase;
}

.pdetail-title-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}

.pdetail-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--pd-text);
}

.pdetail-version {
  font-size: 24rpx;
  color: var(--pd-text2);
  background: var(--pd-capsule);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

.pdetail-pkg {
  font-size: 30rpx;
  color: var(--pd-text2);
  word-break: break-all;
}

.pdetail-desc {
  font-size: 30rpx;
  color: var(--pd-text2);
  line-height: 1.5;
}

.pdetail-warn-sm {
  font-size: 24rpx;
  color: var(--pd-warn);
}

.pdetail-err {
  font-size: 24rpx;
  color: var(--pd-err);
}

/* ---------- 组件列表 ---------- */

.pdetail-entries-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 28rpx;
}

.pdetail-section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--pd-text);
}

.pdetail-entries-count {
  font-size: 26rpx;
  color: var(--pd-text2);
}

.pdetail-entry {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  gap: 12rpx;
}

.pdetail-entry-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.pdetail-entry-icon {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.pdetail-entry-icon-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
}

.pdetail-entry-icon-fallback {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: var(--pd-fallback);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pdetail-entry-icon-fallback text {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--pd-text);
  text-transform: uppercase;
}

.pdetail-entry-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.pdetail-entry-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--pd-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pdetail-entry-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pdetail-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--pd-dot-off);
}

.pdetail-dot.ok { background: var(--pd-dot-ok); }
.pdetail-dot.bad { background: var(--pd-dot-bad); }

.pdetail-entry-status-text {
  font-size: 24rpx;
  color: var(--pd-text2);
}

.pdetail-switch,
.pdetail-entry switch {
  flex-shrink: 0;
  transform: scale(0.86);
}

.pdetail-entry-chev {
  width: 60rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pdetail-chev-img {
  width: 32rpx;
  height: 32rpx;
}

/* 官方配置项 */
.pdetail-ns {
  font-size: 30rpx;
  color: var(--pd-text2);
}

/* ---------- 组件详情弹层 ---------- */

.pdetail-sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 70;
}

.pdetail-sheet {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 71;
  height: 68vh;
  display: flex;
  flex-direction: column;
  background: var(--pd-bg);
  border-radius: 36rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.pdetail-sheet-handle {
  width: 76rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(120, 120, 128, 0.28);
  margin: 16rpx auto 4rpx;
  flex-shrink: 0;
}

.pdetail-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx 20rpx;
  flex-shrink: 0;
}

.pdetail-sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--pd-text);
}

.pdetail-sheet-done {
  font-size: 32rpx;
  color: #007AFF;
}

.pdetail-sheet-body {
  flex: 1;
  min-height: 0;
}

.pdetail-sheet-inner {
  padding: 16rpx 44rpx 60rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pdetail-sheet-id-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.pdetail-sheet-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--pd-text);
}

.pdetail-fields {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 16rpx;
}

.pdetail-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pdetail-field-label {
  font-size: 24rpx;
  color: var(--pd-text2);
}

.pdetail-field-value {
  font-size: 30rpx;
  color: var(--pd-text);
  word-break: break-all;
}
