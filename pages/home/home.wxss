  background: rgba(255, 255, 255, 0.07);
  backdrop-filter: blur(24rpx);
  transition: transform 0.12s ease;
}

.new-session:active {
  transform: scale(0.98);
}

.plus-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
