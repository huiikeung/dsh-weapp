<page-meta page-style="{{pageStyle}}" />
<view class="page settings {{themeClass}}" style="{{contentFontStyle}}">
  <!-- 自定义导航：与右上角胶囊同一水平线，避免原生导航在手动深色时露白 -->
  <view class="nav" style="padding-top:{{navPadTop}}px;height:{{navHeight}}px;">
    <view class="nav-back tap" bindtap="goBack" hover-class="press-dim" role="button" aria-label="{{ui['返回']}}">
      <image class="nav-back-ic" src="/assets/icons/{{theme === 'dark' ? 'back-white.png' : 'back-black.png'}}"/>
    </view>
    <text class="nav-title">{{ui['设置']}}</text>
  </view>
  <view class="nav-placeholder" style="height:{{navPadTop + navHeight}}px;" aria-hidden="true"></view>

  <!-- DSH 客户端账号区：结构与桌面端 AccountSection 对齐。 -->
  <view class="dsh-account-section" aria-label="{{ui['账号与余额']}}">
    <view class="dsh-account-card">
      <view class="dsh-account-identity">
        <view class="dsh-account-avatar">
          <image wx:if="{{dshAccount.avatarUrl}}" class="dsh-account-avatar-image" src="{{dshAccount.avatarUrl}}" mode="aspectFill"/>
          <image wx:else class="dsh-account-avatar-user" mode="aspectFit" src="/assets/icons/account-user{{theme === 'dark' ? '-dark' : ''}}.svg"/>
        </view>
        <view class="dsh-account-identity-copy">
          <text class="dsh-account-name">{{dshAccount.name}}</text>
          <text class="dsh-account-status">{{dshAccountBusy ? ui['加载中…'] : dshAccount.status}}</text>
        </view>
      </view>
    </view>
    <view class="dsh-balance-card">
      <view class="dsh-balance-row">
        <text>{{ui['充值余额']}}</text>
        <view wx:if="{{dshAccount.balance.length}}" class="dsh-balance-amount"><text wx:for="{{dshAccount.balance}}" wx:key="*this">{{item}}</text></view>
        <text wx:elif="{{dshAccount.balanceState === 'signed-out'}}" class="dsh-account-muted">{{ui['登录后查看']}}</text>
        <text wx:elif="{{dshAccount.balanceState === 'loading'}}" class="dsh-account-muted">{{ui['加载中…']}}</text>
        <text wx:else class="dsh-account-unavailable" data-url="{{dshAccount.usageUrl}}" bindtap="openDshAccountLink" role="button">{{ui['前往开放平台查看']}}</text>
      </view>
      <block wx:if="{{dshAccount.showBonusRow}}">
        <view class="dsh-account-divider"></view>
        <view class="dsh-balance-row">
          <text>{{ui['赠金余额']}}</text>
          <view wx:if="{{dshAccount.bonusBalance.length}}" class="dsh-balance-bonus"><view class="dsh-balance-amount"><text wx:for="{{dshAccount.bonusBalance}}" wx:key="*this">{{item}}</text></view></view>
          <text wx:else class="dsh-account-muted">{{ui['加载中…']}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 两个独立入口，具体操作只放在各自面板内。 -->
  <view class="group-title">{{ui['公网访问']}}</view>
  <view class="card">
    <view class="card-row management-entry" bindtap="openPublicAccess" hover-class="management-entry-active" role="button" aria-label="{{ui['公网访问']}}">
      <view class="management-entry-copy">
        <text class="card-row-label">{{publicExpiryLabel || ui['公网访问']}}</text>
        <text class="management-entry-desc">{{ui['兑换公网有效期 · 不影响局域网']}}</text>
      </view>
      <view class="card-row-value management-entry-value">
        <text>{{ui[publicStatusLabel] !== undefined ? ui[publicStatusLabel] : publicStatusLabel}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
  </view>

  <view class="group-title">{{ui['节点管理']}}</view>
  <view class="card">
    <view class="card-row management-entry" bindtap="openNodeManagement" hover-class="management-entry-active" role="button" aria-label="{{ui['节点管理']}}">
      <view class="management-entry-copy">
        <text class="card-row-label">{{activeNodeName || ui['节点管理']}}</text>
        <text class="management-entry-desc">{{onlineNodeCount}} {{ui['个在线 · 扫码或输入配对信息']}}</text>
      </view>
      <view class="card-row-value management-entry-value">
        <text>{{nodeCount}} {{ui['个']}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
  </view>

  <block wx:if="{{isWechatAdmin}}">
  <view class="group-title">{{ui['微信身份']}}</view>
  <view class="card">
    <view class="card-row management-entry">
      <view class="management-entry-copy">
        <text class="card-row-label">{{ui['当前身份']}}</text>
        <text class="management-entry-desc">{{ui[accountHint] !== undefined ? ui[accountHint] : accountHint}}</text>
      </view>
      <view class="card-row-value management-entry-value">
        <text>{{ui[accountLabel] !== undefined ? ui[accountLabel] : accountLabel}}</text>
      </view>
    </view>
  </view>
  </block>
  <block wx:if="{{isWechatAdmin}}">
    <view class="group-title">{{ui['管理员']}}</view>
    <view class="card">
      <view class="card-row management-entry" bindtap="openCodeManagement" hover-class="management-entry-active" role="button">
        <view class="management-entry-copy">
          <text class="card-row-label">{{ui['兑换码管理']}}</text>
          <text class="management-entry-desc">{{ui['生成、复制分发与删除']}}</text>
        </view>
        <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
      </view>
      <view class="card-row management-entry" bindtap="openAnnouncementManagement" hover-class="management-entry-active" role="button">
        <view class="management-entry-copy"><text class="card-row-label">{{ui['发布公告']}}</text><text class="management-entry-desc">{{ui['发布、编辑与删除 · 与后台同步']}}</text></view>
        <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
      </view>
      <view class="card-row management-entry">
        <view class="management-entry-copy"><text class="card-row-label">{{ui['分享活动']}}</text><text class="management-entry-desc">{{shareSaving ? ui['正在保存…'] : (contentLoaded ? ui['关闭后隐藏分享入口，已获时长不变'] : (contentError || ui['正在同步设置…']))}}</text></view>
        <switch checked="{{referralEnabled}}" disabled="{{shareSaving || !contentLoaded || accountBusy}}" color="#2E6BE6" bindchange="toggleReferralSharing" aria-label="{{ui['分享活动开关']}}"/>
      </view>
      <view wx:if="{{contentError}}" class="card-row" bindtap="refreshAppContent" hover-class="management-entry-active" role="button"><text class="card-row-label">{{ui['重试同步分享设置']}}</text></view>
    </view>
  </block>

  <view class="group-title">{{ui['对话']}}</view>
  <view wx:if="{{workStepMenu}}" class="work-step-menu-mask" catchtap="closeWorkStepMenu"></view>
  <view class="card work-step-settings">
    <view class="card-row">
      <view class="work-step-copy"><text class="card-row-label">{{ui['语音输入']}}</text><text class="work-step-hint">{{ui['按住说话，由已连接的 DSH 语音插件转写']}}</text></view>
      <switch checked="{{voiceEnabled}}" color="#2E6BE6" bindchange="toggleVoice" aria-label="{{ui['语音输入']}}"/>
    </view>
    <view wx:if="{{voiceEnabled}}" class="card-row" bindtap="openVoiceSettings" role="button">
      <text class="card-row-label">{{ui['语音插件设置']}}</text><view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
    <view class="card-row work-step-row">
      <view class="work-step-copy"><text class="card-row-label">{{ui['工作步骤展示']}}</text><text class="work-step-hint">{{ui['选择希望看到多少工具调用细节']}}</text></view>
      <view class="work-step-select" bindtap="toggleWorkStepMenu" data-field="mode" role="button" aria-label="{{ui['工作步骤展示：']}}{{ui[workStepModeLabel] !== undefined ? ui[workStepModeLabel] : workStepModeLabel}}"><text>{{ui[workStepModeLabel] !== undefined ? ui[workStepModeLabel] : workStepModeLabel}}</text><image class="work-step-select-chevron" src="/assets/icons/chev-right-gray.png"/></view>
      <view wx:if="{{workStepMenu === 'mode'}}" class="work-step-menu">
        <view wx:for="{{workStepModes}}" wx:key="id" class="work-step-option" bindtap="chooseWorkStep" data-field="mode" data-id="{{item.id}}" role="button"><text>{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text><text class="work-step-selected">{{workStepMode === item.id ? '✓' : ''}}</text></view>
      </view>
    </view>
    <view class="card-row work-step-row">
      <view class="work-step-copy"><text class="card-row-label">{{ui['工作步骤收起时机']}}</text><text class="work-step-hint">{{ui['选择何时自动收起工作步骤']}}</text></view>
      <view class="work-step-select" bindtap="toggleWorkStepMenu" data-field="timing" role="button" aria-label="{{ui['工作步骤收起时机：']}}{{ui[workStepTimingLabel] !== undefined ? ui[workStepTimingLabel] : workStepTimingLabel}}"><text>{{ui[workStepTimingLabel] !== undefined ? ui[workStepTimingLabel] : workStepTimingLabel}}</text><image class="work-step-select-chevron" src="/assets/icons/chev-right-gray.png"/></view>
      <view wx:if="{{workStepMenu === 'timing'}}" class="work-step-menu timing-menu">
        <view wx:for="{{workStepTimings}}" wx:key="id" class="work-step-option" bindtap="chooseWorkStep" data-field="timing" data-id="{{item.id}}" role="button"><text>{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text><text class="work-step-selected">{{workStepTiming === item.id ? '✓' : ''}}</text></view>
      </view>
    </view>
  </view>
  <view class="group-hint">{{ui['完全展开时不自动收起；设置保存在当前小程序。']}}</view>

  <!-- 震动反馈弹窗 -->
  <view wx:if="{{hapticsSheet}}" class="pair-sheet-mask" catchtap="closeHapticsSheet" catchtouchmove="noop">
    <view class="pair-sheet appearance-sheet" catchtap="noop" role="dialog" aria-label="{{ui['震动反馈']}}">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['震动反馈']}}</text>
          <text class="pair-sheet-subtitle">{{ui['点击与滑动时的震动强度，全局生效。']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeHapticsSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <view class="appearance-options">
        <view
          wx:for="{{hapticsOptions}}"
          wx:key="level"
          class="appearance-option {{hapticsLevel === item.level ? 'selected' : ''}}"
          data-level="{{item.level}}"
          bindtap="chooseHaptics"
          role="button"
        >
          <text class="appearance-option-label">{{item.label}}</text>
          <text class="appearance-option-check">{{hapticsLevel === item.level ? '✓' : ''}}</text>
        </view>
      </view>
      <view class="haptics-test-row" bindtap="testHaptics" role="button">{{ui['测试震动']}}</view>
      <view wx:if="{{hapticsStatusText}}" class="haptics-status">{{hapticsStatusText}}</view>
    </view>
  </view>

  <!-- 外观（界面）弹窗 -->
  <view wx:if="{{appearanceSheet}}" class="pair-sheet-mask" catchtap="closeAppearanceSheet" catchtouchmove="noop">
    <view class="pair-sheet appearance-sheet" catchtap="noop" role="dialog" aria-label="{{ui['外观']}}">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['外观']}}</text>
          <text class="pair-sheet-subtitle">{{ui['跟随微信']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeAppearanceSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <view class="appearance-options">
        <view
          wx:for="{{appearanceModes}}"
          wx:key="mode"
          class="appearance-option {{appearanceMode === item.mode ? 'selected' : ''}}"
          data-mode="{{item.mode}}"
          bindtap="chooseAppearance"
          role="button"
        >
          <view class="appearance-option-icon appearance-{{item.mode}}">
            <view class="appearance-swatch"></view>
          </view>
          <text class="appearance-option-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
          <text class="appearance-option-check">{{appearanceMode === item.mode ? '✓' : ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 外观模式（对齐 dsh-mobile v1.6.0 InterfaceStyleSettingsRow） -->
  <view class="group-title">{{ui['外观']}}</view>
  <view class="card">
    <view class="card-row" bindtap="pickAppearance">
      <text class="card-row-label">{{ui['界面']}}</text>
      <view class="card-row-value">
        <text>{{ui[appearanceLabel] !== undefined ? ui[appearanceLabel] : appearanceLabel}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
    <view class="card-row" bindtap="openStatusStyles" role="button" aria-label="{{ui['选择对话状态条样式']}}">
      <text class="card-row-label">{{ui['对话状态条']}}</text>
      <view class="card-row-value"><text>{{ui[statusAppearanceLabel] !== undefined ? ui[statusAppearanceLabel] : statusAppearanceLabel}}</text><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
    <view class="card-row" bindtap="openProcIcons" role="button" aria-label="{{ui['选择执行图标动效']}}">
      <text class="card-row-label">{{ui['执行图标']}}</text>
      <view class="card-row-value"><text>{{ui[procIconLabel] !== undefined ? ui[procIconLabel] : procIconLabel}}</text><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
  </view>

  <view class="group-title">{{ui['通用设置']}}</view>
  <view class="card general-preferences">
    <view class="card-row">
      <view class="exp-copy"><text class="card-row-label">{{ui['首页动画']}}</text><text class="exp-desc">{{ui['控制首页动态海洋背景，关闭后保留静态画面']}}</text></view>
      <switch checked="{{homeAnimationEnabled}}" color="#2E6BE6" bindchange="toggleHomeAnimation" aria-label="{{ui['首页动画']}}"/>
    </view>
    <view class="card-row" bindtap="openHapticsPicker" role="button" aria-label="{{ui['震动反馈']}}">
      <text class="card-row-label">{{ui['震动反馈']}}</text>
      <view class="card-row-value">
        <text>{{hapticsLevel === 'off' ? ui['关闭'] : (hapticsLevel === 'light' ? ui['轻'] : (hapticsLevel === 'medium' ? ui['中'] : ui['重']))}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
    <view class="card-row preference-language-row">
      <text class="card-row-label">{{ui['语言']}}</text>
      <view class="preference-select" bindtap="pickLanguage" role="button"><text>{{ui[languageLabel] !== undefined ? ui[languageLabel] : languageLabel}}</text><view class="preference-chevron {{preferenceMenu === 'language' ? 'expanded' : ''}}" aria-hidden="true"><view class="preference-chevron-line"/></view></view>
      <view wx:if="{{preferenceMenu === 'language'}}" class="preference-menu">
        <view wx:for="{{languageOptions}}" wx:key="id" class="preference-option" bindtap="chooseLanguage" data-id="{{item.id}}" role="button"><text>{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text><text class="preference-check">{{language === item.id ? '✓' : ''}}</text></view>
      </view>
    </view>
    <view class="card-row preference-font-row">
      <view class="preference-description" bindtap="toggleFontSettings" role="button"><text class="card-row-label">{{ui['字号大小']}}</text><text class="preference-hint">{{ui['仅影响会话内容的字号']}}</text></view>
      <view class="font-number-control"><input class="font-number" type="number" value="{{fontSizes.text}}" data-role="text" bindblur="commitFontSize" bindconfirm="commitFontSize" maxlength="2"/><text class="font-unit">px</text></view>
      <view class="font-expand" bindtap="toggleFontSettings" role="button" aria-label="{{fontSettingsExpanded ? ui['收起字体设置'] : ui['更多字体设置']}}"><view class="preference-chevron {{fontSettingsExpanded ? 'expanded' : ''}}" aria-hidden="true"><view class="preference-chevron-line"/></view></view>
    </view>
    <block wx:if="{{fontSettingsExpanded}}">
      <view class="card-row font-detail-row"><view class="preference-description"><text class="card-row-label">{{ui['正文字体']}}</text><text class="preference-hint">{{ui['用于界面与会话正文。多个字体用逗号分隔，留空使用默认字体']}}</text></view><input class="font-family-input" value="{{fontFamilies.text}}" placeholder="{{ui['默认']}}" placeholder-class="font-family-placeholder" data-role="text" bindblur="commitFontFamily" bindconfirm="commitFontFamily" maxlength="500"/></view>
      <view class="card-row font-detail-row"><view class="preference-description"><text class="card-row-label">{{ui['代码字体']}}</text><text class="preference-hint">{{ui['用于代码块、行内代码与工具输出。多个字体用逗号分隔，留空使用默认字体']}}</text></view><input class="font-family-input" value="{{fontFamilies.code}}" placeholder="{{ui['默认']}}" placeholder-class="font-family-placeholder" data-role="code" bindblur="commitFontFamily" bindconfirm="commitFontFamily" maxlength="500"/></view>
      <view class="card-row font-detail-row"><view class="preference-description"><text class="card-row-label">{{ui['代码字号']}}</text><text class="preference-hint">{{ui['用于代码块、行内代码与工具输出']}}</text></view><view class="font-number-control"><input class="font-number" type="number" value="{{fontSizes.code}}" data-role="code" bindblur="commitFontSize" bindconfirm="commitFontSize" maxlength="2"/><text class="font-unit">px</text></view></view>
      <view class="card-row font-detail-row"><view class="preference-description"><text class="card-row-label">{{ui['终端字体']}}</text><text class="preference-hint">{{ui['用于侧栏终端。多个字体用逗号分隔，留空使用默认字体']}}</text></view><input class="font-family-input" value="{{fontFamilies.terminal}}" placeholder="{{ui['默认']}}" placeholder-class="font-family-placeholder" data-role="terminal" bindblur="commitFontFamily" bindconfirm="commitFontFamily" maxlength="500"/></view>
      <view class="card-row font-detail-row"><view class="preference-description"><text class="card-row-label">{{ui['终端字号']}}</text><text class="preference-hint">{{ui['用于侧栏终端']}}</text></view><view class="font-number-control"><input class="font-number" type="number" value="{{fontSizes.terminal}}" data-role="terminal" bindblur="commitFontSize" bindconfirm="commitFontSize" maxlength="2"/><text class="font-unit">px</text></view></view>
      <view class="font-preview-panel"><text class="preference-hint">{{ui['字体预览']}}</text><text class="font-preview-text">{{ui['正文字体']}} · DeepSeek Harness</text><text class="font-preview-code">const answer = 42;</text><text class="font-preview-terminal">$ dsh --version</text><text class="preference-hint">{{ui['实际可用字体取决于设备；找不到的字体将使用后备字体。']}}</text><text class="preference-hint">{{ui['当前小程序暂无侧栏终端；终端偏好已保存，下方预览可查看效果。']}}</text></view>
    </block>

  </view>

  <view class="group-title">{{ui['会话面板']}}</view>
  <view class="card general-preferences">
    <view class="card-row">
      <view class="exp-copy"><text class="card-row-label">{{ui['显示上下文']}}</text><text class="exp-desc">{{ui['在会话顶部显示上下文标签页']}}</text></view>
      <switch checked="{{showContextPanel}}" color="#2E6BE6" bindchange="toggleContextPanel" aria-label="{{ui['显示上下文']}}"/>
    </view>
    <view class="card-row">
      <view class="exp-copy"><text class="card-row-label">{{ui['显示编队']}}</text><text class="exp-desc">{{ui['在会话顶部显示编队标签页']}}</text></view>
      <switch checked="{{showFleetPanel}}" color="#2E6BE6" bindchange="toggleFleetPanel" aria-label="{{ui['显示编队']}}"/>
    </view>
  </view>


  <view class="group-title">{{ui['实验性功能']}}</view>
  <view class="card">
    <view class="card-row">
      <view class="exp-copy">
        <text class="card-row-label">{{ui['订阅通知']}}</text>
        <text class="exp-desc">{{ui['发送任务后申请订阅消息授权，回合完成时通过服务通知提醒']}}</text>
      </view>
      <switch checked="{{notifyEnabled}}" color="#2E6BE6" bindchange="toggleNotify"/>
    </view>
    <view class="card-row clawbot-experimental-row">
      <view class="exp-copy" bindtap="openClawbotPanel" role="button">
        <text class="card-row-label">{{ui['微信 ClawBot 私聊接线']}}</text>
        <text class="exp-desc">{{ui['将微信私聊接入指定 DSH 会话；微信凭据保存在电脑端']}}</text>
      </view>
      <switch checked="{{clawbotStatus ? clawbotStatus.enabled : false}}" disabled="{{clawbotBusy}}" color="#2E6BE6" bindchange="toggleClawbot"/>
    </view>
    <view wx:if="{{clawbotPanelOpen}}" class="clawbot-panel">
      <view class="clawbot-panel-head">
        <view class="clawbot-state {{clawbotStatus && clawbotStatus.enabled ? 'is-on' : ''}}">{{clawbotStateLabel || ui['尚未读取状态']}}</view>
        <view class="clawbot-panel-actions">
          <view class="clawbot-text-action" bindtap="refreshClawbotStatus">{{ui['刷新']}}</view>
          <view class="clawbot-text-action" bindtap="closeClawbotPanel">{{ui['收起']}}</view>
        </view>
      </view>
      <text wx:if="{{clawbotError}}" class="clawbot-error">{{clawbotError}}</text>
      <text wx:if="{{clawbotLoading}}" class="clawbot-muted">{{ui['正在读取 ClawBot 状态…']}}</text>
      <block wx:if="{{clawbotStatus}}">
        <view class="clawbot-info-row"><text>{{ui['接入会话']}}</text><text class="clawbot-info-value">{{clawbotStatus.target ? clawbotStatus.target.title : ui['尚未选择']}}</text></view>
        <view class="clawbot-info-row" wx:if="{{clawbotStatus.message}}"><text>{{ui['状态说明']}}</text><text class="clawbot-info-value">{{clawbotStatus.message}}</text></view>
        <view class="clawbot-info-row" wx:if="{{clawbotStatus.pending || clawbotStatus.uncertain}}"><text>{{ui['待处理 / 不确定消息']}}</text><text class="clawbot-info-value">{{clawbotStatus.pending || 0}} / {{clawbotStatus.uncertain || 0}}</text></view>
        <view class="clawbot-action-row">
          <view class="clawbot-action {{clawbotBusy || clawbotStatus.enabled ? 'is-disabled' : ''}}" bindtap="startClawbotLogin">{{clawbotStatus.paired ? ui['重新绑定微信'] : ui['绑定微信']}}</view>
          <view class="clawbot-action {{clawbotBusy ? 'is-disabled' : ''}}" bindtap="openClawbotSessions">{{ui['选择接入会话']}}</view>
          <view wx:if="{{clawbotStatus.paired}}" class="clawbot-action is-danger {{clawbotBusy || clawbotStatus.enabled ? 'is-disabled' : ''}}" bindtap="disconnectClawbot">{{ui['移除绑定']}}</view>
        </view>
        <view wx:if="{{clawbotStatus.pairing}}" class="clawbot-pairing">
          <image wx:if="{{clawbotQrPath}}" class="clawbot-qr" src="{{clawbotQrPath}}" mode="aspectFit" show-menu-by-longpress="true"/>
          <text wx:else class="clawbot-muted">{{ui['二维码暂不可显示，请更新微信基础库或在电脑端扫码']}}</text>
          <text class="clawbot-pairing-hint">{{clawbotStatus.pairing.status === 'scaned' || clawbotStatus.pairing.status === 'scaned_but_redirect' ? ui['已扫码，请在微信中确认'] : ui['请用微信扫一扫扫描二维码并确认']}}</text>
          <view wx:if="{{clawbotStatus.pairing.status === 'need_verifycode'}}" class="clawbot-verify-row">
            <input class="clawbot-verify-input" value="{{clawbotVerifyCode}}" placeholder="{{ui['输入微信确认码']}}" bindinput="onClawbotVerifyCode" maxlength="128"/>
            <view class="clawbot-action" bindtap="submitClawbotVerifyCode">{{ui['提交确认码']}}</view>
          </view>
          <view class="clawbot-text-action clawbot-cancel-login" bindtap="cancelClawbotLogin">{{ui['取消绑定流程']}}</view>
        </view>
        <view wx:if="{{clawbotSessionsOpen}}" class="clawbot-session-list">
          <text class="clawbot-list-title">{{ui['选择一个普通 DSH 会话作为接入目标']}}</text>
          <view wx:for="{{clawbotSessions}}" wx:key="id" class="clawbot-session-option {{clawbotStatus.target && clawbotStatus.target.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseClawbotSession">
            <view class="clawbot-session-copy"><text class="clawbot-session-title">{{item.title}}</text><text wx:if="{{item.workspaceTitle}}" class="clawbot-muted">{{item.workspaceTitle}}</text></view>
            <text class="clawbot-session-check">{{clawbotStatus.target && clawbotStatus.target.id === item.id ? '✓' : ''}}</text>
          </view>
          <text wx:if="{{!clawbotSessions.length}}" class="clawbot-muted">{{ui['没有可用会话，请先在电脑端新建普通会话']}}</text>
        </view>
        <view class="clawbot-footnote">{{ui['启用后，微信私聊会提交到所选会话；这不会创建新的 Agent 预设或绕过电脑端权限。']}}</view>
      </block>
    </view>
  </view>
  <view class="group-hint">{{ui['实验性功能默认关闭，可能随基础库版本变化不稳定，仅供试用。']}}</view>

  <view class="group-title">{{ui['关于']}}</view>
  <view class="card">
    <view class="card-row management-entry" bindtap="openAnnouncements" hover-class="management-entry-active" role="button">
      <text class="card-row-label">{{ui['开发者公告']}}</text>
      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
    <button class="card-row about-contact" open-type="contact" session-from="whaletail-settings" binderror="onContactError" hover-class="management-entry-active">
      <text class="card-row-label">{{ui['联系客服']}}</text>
      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </button>
    <view class="card-row">
      <text class="card-row-label">{{ui['客户端']}}</text>
      <text class="card-row-value">{{ui['鲸尾助手小程序版']}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">{{ui['当前版本']}}</text>
      <text class="card-row-value">{{appVersion}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">{{ui['要求网关版本']}}</text>
      <text class="card-row-value about-version-value">{{minGatewayVersion}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">{{ui['已连接网关版本']}}</text>
      <text class="card-row-value">{{connectedGatewayVersion}}</text>
    </view>
    <view class="card-row" bindtap="openPrivacyPolicy" role="button" aria-label="{{ui['查看隐私政策']}}">
      <text class="card-row-label">{{ui['隐私政策']}}</text>
      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
  </view>
  <view class="group-hint">{{ui[gatewayVersionHint] !== undefined ? ui[gatewayVersionHint] : gatewayVersionHint}}</view>
  <privacy-sheet id="settings-privacy" visible="{{privacyOpen}}" theme="{{theme}}" bindclose="closePrivacyPolicy" />

  <view wx:if="{{managementPanel && !pairSheetOpen}}" class="pair-sheet-mask" catchtap="closeManagementPanel" catchtouchmove="noop">
    <view class="pair-sheet management-sheet resizable" style="height: {{sheetExpanded.management ? 90 : 62}}vh;" catchtap="noop">
      <view class="sheet-grabber-zone" data-sheet="management" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{managementPanel === 'public' ? ui['公网访问'] : (managementPanel === 'gateway' ? ui['网关连接'] : ui['节点管理'])}}</text>
          <text class="pair-sheet-subtitle">{{managementPanel === 'public' ? ui['管理当前微信账号的公网有效期'] : (managementPanel === 'gateway' ? nodeDetail.name : ui['点击节点查看连接信息与操作'])}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeManagementPanel" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <scroll-view scroll-y enhanced class="management-scroll">
        <block wx:if="{{managementPanel === 'public'}}">
          <view class="card public-card">
            <view class="public-head">
              <image class="public-icon" src="/assets/icons/node-router.svg" mode="aspectFit"/>
              <view class="public-main">
                <text class="public-title">{{publicTitle}}</text>
                <text class="public-sub">{{publicSub}}</text>
              </view>
            </view>
            <view class="public-detail-row">
              <text class="public-detail-label">{{ui['访问状态']}}</text>
              <view class="public-pill {{publicOn ? 'on' : ''}}">
                <view class="public-pill-dot"></view>
                <text>{{ui[publicStatusLabel] !== undefined ? ui[publicStatusLabel] : publicStatusLabel}}</text>
              </view>
            </view>
            <view class="public-detail-row public-device-row">
              <text class="public-detail-label">{{ui['设备ID']}}</text>
              <text class="public-device-value text-mono" selectable>{{accountDeviceId || (accountBusy ? ui['识别中…'] : (accountIdHint || ui['暂未识别，请重试']))}}</text>
              <text wx:if="{{accountDeviceId}}" class="public-copy-id" data-id="{{accountDeviceId}}" bindtap="copyNodeId">{{ui['复制']}}</text>
            </view>
            <view wx:if="{{publicExpiryLabel}}" class="public-detail-row">
              <text class="public-detail-label">{{ui['访问有效期']}}</text>
              <text class="public-detail-value">{{ui[publicExpiryLabel] !== undefined ? ui[publicExpiryLabel] : publicExpiryLabel}}</text>
            </view>
            <view class="public-actions">
              <button wx:if="{{referralEnabled}}" class="public-share" bindtap="openReferralShare" hover-class="public-share-hover">{{ui['分享']}}</button>
              <button wx:if="{{!redeemFormOpen}}" class="public-redeem" disabled="{{redeemBusy}}" bindtap="redeemRenewal" hover-class="public-share-hover">
                {{redeemBusy ? ui['兑换中…'] : (redeemAvailable ? ui['兑换续期'] : ui['兑换说明'])}}
              </button>
            </view>
            <view wx:if="{{redeemFormOpen}}" class="public-redeem-form">
              <view class="public-redeem-form-head">
                <text class="public-redeem-form-title">{{ui['兑换公网有效期']}}</text>
                <text class="public-redeem-form-cancel" bindtap="closeRedeemForm" role="button">{{ui['取消']}}</text>
              </view>
              <input
                class="public-redeem-input"
                value="{{redeemCode}}"
                bindinput="onRedeemInput"
                maxlength="40"
                placeholder="XXXX-XXXX-XXXX"
                placeholder-class="public-redeem-placeholder"
                confirm-type="done"
                bindconfirm="submitRedeem"
                cursor-spacing="24"
              />
              <view class="public-redeem-form-hint">{{ui['输入管理员提供的兑换码']}}</view>
              <button class="public-redeem-submit" bindtap="submitRedeem" disabled="{{redeemBusy}}">{{redeemBusy ? ui['兑换中…'] : ui['兑换续期']}}</button>
            </view>
            <view wx:if="{{redeemResultLabel}}" class="public-redeem-result">{{ui[redeemResultLabel] !== undefined ? ui[redeemResultLabel] : redeemResultLabel}}</view>
            <view wx:if="{{referralEnabled && sharePayload}}" class="public-share-meta">
              <text class="public-share-expiry">{{ui[shareExpiresLabel] !== undefined ? ui[shareExpiresLabel] : shareExpiresLabel}}</text>
              <view class="public-share-actions">
                <button open-type="share">{{ui['转发']}}</button>
                <text class="public-share-copy" bindtap="copyNodeShare">{{ui['复制邀请']}}</text>
              </view>
            </view>
          </view>
          <view class="group-hint">{{ui[publicHint] !== undefined ? ui[publicHint] : publicHint}}</view>
        </block>
        <block wx:elif="{{managementPanel === 'nodes'}}">
          <view class="node-group-title">
            <text class="node-count">{{onlineNodeCount}} {{ui['在线 ·']}} {{nodeCount}} {{ui['个节点']}}</text>
            <view class="node-head-actions">
              <text wx:if="{{!nodeEditMode}}" class="node-refresh" bindtap="refreshNodes" role="button">{{ui['刷新']}}</text>
              <text
                wx:if="{{nodeEditMode && nodeSelection.length}}"
                class="node-delete-inline"
                bindtap="deleteSelectedNodes"
                role="button"
              >{{nodeSelection.length > 1 ? ui['删除 '] + nodeSelection.length + ui[' 个'] : ui['删除']}}</text>
              <text wx:if="{{nodes.length}}" class="node-edit-toggle" bindtap="toggleNodeEditMode" role="button">{{nodeEditMode ? ui['完成'] : ui['编辑']}}</text>
            </view>
          </view>
          <view class="card node-list-card">
            <view wx:if="{{!nodes.length}}" class="node-empty">
              <text class="node-empty-title">{{ui['还没有已配对节点']}}</text>
              <text class="node-empty-desc">{{ui['点击下方「添加节点」，按引导完成电脑端准备后扫码配对。']}}</text>
            </view>
            <view wx:for="{{nodes}}" wx:key="id" class="node-row {{item.active ? 'node-row-active' : ''}}" data-id="{{item.id}}" bindtap="selectNode" hover-class="management-entry-active" role="button" aria-label="{{ui['查看']}}{{item.name}}{{ui['连接详情']}}">
              <view wx:if="{{nodeEditMode}}" class="node-select" catchtap="toggleNodeSelect" data-id="{{item.id}}">
                <image class="node-select-ic" src="/assets/icons/{{item.selected ? 'circle-filled-white.png' : 'circle-white.png'}}"/>
              </view>
              <view class="node-main">
                <view class="node-name-line">
                  <view class="status-dot {{item.online ? 'connected' : 'disconnected'}}"></view>
                  <text class="node-name">{{item.name}}</text>
                  <text wx:if="{{item.active}}" class="node-current">{{ui['当前']}}</text>
                </view>
                <text class="node-id text-mono">{{item.gatewayId || item.id}}</text>
              </view>
              <view class="node-actions">
                <text class="node-status">{{ui[item.statusLabel] !== undefined ? ui[item.statusLabel] : item.statusLabel}}</text>
                <text class="node-copy" data-id="{{item.gatewayId || item.id}}" catchtap="copyNodeId">{{ui['复制 ID']}}</text>
              </view>
              <image wx:if="{{!nodeEditMode}}" class="node-detail-chevron" src="/assets/icons/chev-right-gray.png"/>
            </view>
          </view>
          <view class="node-pair-actions">
            <button class="node-pair-button" bindtap="addNode" hover-class="node-add-active">
              <text class="node-add-plus">+</text>
              <text class="node-add-text">{{ui['添加节点']}}</text>
            </button>
          </view>
        </block>
        <block wx:elif="{{managementPanel === 'gateway' && nodeDetail}}">
          <view class="card gateway-detail-card">
            <view wx:if="{{nodeDetail.isPublic}}" class="card-row gateway-identity-row">
              <text class="gateway-identity-label">{{ui['公网标识']}}</text>
              <text class="gateway-identity-value text-mono" selectable>{{nodeDetail.identifier}}</text>
              <text class="node-copy gateway-copy" data-id="{{nodeDetail.identifier}}" bindtap="copyNodeId" role="button">{{ui['复制']}}</text>
            </view>
            <view wx:else class="card-row">
              <text class="card-row-label gw-url text-mono" selectable>{{nodeDetail.endpoint || ui['未配置']}}</text>
            </view>
            <view class="card-row gateway-status-row">
              <view class="card-row-label gw-status"><view class="status-dot {{nodeDetail.connection}}"></view><text>{{ui[nodeDetail.connectionLabel] !== undefined ? ui[nodeDetail.connectionLabel] : nodeDetail.connectionLabel}}</text></view>
              <view class="card-row-value"><text wx:if="{{!nodeDetail.isPublic && nodeDetail.port}}">Port {{nodeDetail.port}}</text><text wx:elif="{{nodeDetail.isPublic}}">{{ui['公网连接']}}</text></view>
            </view>
            <button wx:if="{{!nodeDetail.canDisconnect}}" class="card-row gateway-action" bindtap="connectNode" hover-class="management-entry-active"><text class="btn-text">{{nodeDetail.active ? ui['重新连接'] : ui['连接此节点']}}</text></button>
            <button wx:else class="card-row gateway-action" bindtap="disconnect" hover-class="management-entry-active"><text class="btn-text">{{ui['断开连接']}}</text></button>
            <button class="card-row gateway-action" bindtap="pingGateway" disabled="{{!nodeDetail.canPing || nodePingBusy}}" hover-class="management-entry-active"><text class="btn-text">{{nodePingBusy ? ui['Ping 检测中…'] : ui['Ping 网关']}}</text></button>
            <button class="card-row gateway-action" bindtap="forgetDevice" hover-class="management-entry-active"><text class="btn-text-danger">{{ui['忘记此设备']}}</text></button>
          </view>
          <view class="group-hint">{{nodeDetail.isPublic ? ui['通过公网标识识别节点，不展示公网地址。'] : ui['局域网连接保留原地址与端口；不会消耗公网有效期。']}}</view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{referralSheetOpen}}" class="referral-mask" catchtap="closeReferralShare" catchtouchmove="noop">
    <view class="referral-sheet" catchtap="noop">
      <view class="sheet-grabber"></view>
      <text class="referral-title">{{ui['分享']}}</text>
      <text class="referral-subtitle">{{ui['已累计获得']}} {{referralDays}} {{ui['天公网访问']}}</text>
      <text wx:if="{{referralBusy || referralError}}" class="referral-subtitle">{{referralBusy ? ui['正在获取分享信息…'] : referralError}}</text>
      <button class="referral-option" open-type="share" data-referral="true" disabled="{{!referralToken || referralBusy}}">
        <view class="referral-copy"><text>{{ui['好友或群聊']}}</text><text class="referral-desc">{{referralHint || ui['朋友首次有效打开后，自动增加公网时长']}}</text></view><text class="referral-chevron">›</text>
      </button>
      <button class="referral-option" bindtap="openMomentsActivity"><view class="referral-copy"><text>{{ui['朋友圈']}}</text><text class="referral-desc">{{ui['保留满 24 小时，提交凭证审核领取']}}</text></view><text class="referral-chevron">›</text></button>
      <button class="referral-rules" bindtap="openShareRules">{{ui['活动规则']}}</button>
      <button class="referral-cancel" bindtap="closeReferralShare">{{ui['取消']}}</button>
    </view>
  </view>
  <!-- 开发者公告弹窗 -->
  <view wx:if="{{devAnnSheet}}" class="pair-sheet-mask" catchtap="closeDevAnnouncements" catchtouchmove="noop">
    <view class="pair-sheet devann-sheet" catchtap="noop" catchtouchmove="noop" role="dialog" aria-label="{{ui['开发者公告']}}">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <text class="pair-sheet-title">{{ui['开发者公告']}}</text>
        <view class="pair-sheet-close tap" bindtap="closeDevAnnouncements" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <scroll-view class="devann-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{devAnnLoading}}" class="code-message">{{ui['正在加载公告…']}}</view>
        <view wx:if="{{devAnnError}}" class="code-message error">{{ui[devAnnError] !== undefined ? ui[devAnnError] : devAnnError}}</view>
        <view wx:if="{{!devAnnLoading && !devAnnError && !devAnnItems.length}}" class="devann-empty">
          <text class="devann-empty-title">{{ui['暂无开发者公告']}}</text>
          <text class="devann-empty-desc">{{ui['更新说明和使用提醒将发布在这里。']}}</text>
        </view>
        <view
          wx:for="{{devAnnItems}}"
          wx:key="id"
          class="devann-item"
          data-id="{{item.id}}"
          bindtap="toggleDevAnnouncement"
        >
          <view class="devann-item-head">
            <text class="devann-item-title">{{item.title}}</text>
            <text class="devann-item-time">{{item.dateLabel}}</text>
          </view>
          <text class="devann-item-body {{item.expanded ? 'expanded' : ''}}">{{item.content}}</text>
          <text class="devann-item-more">{{item.expanded ? ui['收起'] : ui['展开']}}</text>
        </view>
        <view class="devann-note">{{ui['公告不会索取密码、配对令牌或模型密钥。']}}</view>
      </scroll-view>
    </view>
  </view>

  <!-- 发布公告弹窗（管理员） -->
  <view wx:if="{{annSheet}}" class="pair-sheet-mask" catchtap="closeAnnouncementSheet" catchtouchmove="noop">
    <view class="pair-sheet ann-sheet" catchtap="noop" catchtouchmove="noop" role="dialog" aria-label="{{ui['发布公告']}}">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['发布公告']}}</text>
          <text class="pair-sheet-subtitle">{{ui['发布后在「设置 → 关于 → 开发者公告」展示，与网页管理台同步。请勿发布密钥或个人隐私。']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeAnnouncementSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>

      <view wx:if="{{annLoading}}" class="code-message">{{ui['正在验证管理员身份…']}}</view>
      <view wx:if="{{annError}}" class="code-message error">{{ui[annError] !== undefined ? ui[annError] : annError}}</view>

      <block wx:if="{{annIsAdmin && !annLoading}}">
        <scroll-view class="ann-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="ann-form">
            <input
              class="ann-input"
              value="{{annTitle}}"
              bindinput="annInputTitle"
              maxlength="60"
              placeholder="{{ui['公告标题']}}"
              placeholder-class="ann-placeholder"
              disabled="{{annBusy}}"
            />
            <textarea
              class="ann-textarea"
              value="{{annContent}}"
              bindinput="annInputContent"
              maxlength="2000"
              auto-height="{{false}}"
              placeholder="{{ui['填写更新说明或使用提醒，支持换行']}}"
              placeholder-class="ann-placeholder"
              disabled="{{annBusy}}"
            ></textarea>
          </view>
          <view class="ann-actions">
            <button class="ann-primary" bindtap="annSave" disabled="{{annBusy}}">{{annBusy ? ui['保存中…'] : (annEditingId ? ui['保存修改'] : ui['发布公告'])}}</button>
            <button wx:if="{{annEditingId}}" class="ann-ghost" bindtap="annClearEditor" disabled="{{annBusy}}">{{ui['取消编辑']}}</button>
          </view>
          <view class="ann-hint">{{ui['发布后在「设置 → 关于 → 开发者公告」展示，与网页管理台同步。请勿发布密钥或个人隐私。']}}</view>

          <view class="ann-list-head">
            <text class="ann-list-title">{{ui['公告']}}</text>
            <text class="code-refresh" bindtap="loadAnnouncements">{{ui['刷新']}}</text>
          </view>
          <view wx:if="{{!annItems.length}}" class="code-message">{{ui['暂无公告，发布后会在这里显示。']}}</view>
          <view wx:for="{{annItems}}" wx:key="id" class="ann-item">
            <view class="ann-item-head">
              <text class="ann-item-title">{{item.title}}</text>
              <text class="ann-item-status">{{ui['已发布 ·']}} {{item.timeLabel}}</text>
            </view>
            <text class="ann-item-body">{{item.content}}</text>
            <view class="ann-item-actions">
              <button class="code-btn" data-id="{{item.id}}" bindtap="annEdit" disabled="{{annBusy}}">{{ui['编辑']}}</button>
              <button class="code-btn danger" data-id="{{item.id}}" bindtap="annRemove" disabled="{{annBusy}}">{{ui['删除']}}</button>
            </view>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>

  <!-- 兑换码管理弹窗（管理员） -->
  <view wx:if="{{codeSheet}}" class="pair-sheet-mask" catchtap="closeCodeManagement" catchtouchmove="noop">
    <view
      class="pair-sheet code-sheet"
      catchtap="noop"
      catchtouchmove="noop"
      role="dialog"
      aria-label="{{ui['兑换码管理']}}"
    >
      <view class="sheet-grabber-zone">
        <view class="sheet-grabber"></view>
      </view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['兑换码管理']}}</text>
          <text class="pair-sheet-subtitle">{{ui['管理员生成 · 复制分发 · 用户兑换']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeCodeManagement" role="button"><view class="sheet-close-x"></view></view>
      </view>

      <view wx:if="{{codeLoading}}" class="code-message">{{ui['正在验证管理员身份…']}}</view>
      <view wx:if="{{codeError}}" class="code-message error">{{ui[codeError] !== undefined ? ui[codeError] : codeError}}</view>

      <block wx:if="{{codeIsAdmin && !codeLoading}}">
        <scroll-view class="code-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="code-form">
            <view class="card-row"><text class="card-row-label">{{ui['适用范围']}}</text><text class="code-value">{{ui['全部公网节点']}}</text></view>
            <picker range="{{codeDurations}}" value="{{codeDurationIndex}}" bindchange="codePickDuration" disabled="{{codeBusy}}">
              <view class="card-row"><text class="card-row-label">{{ui['访问时长']}}</text><text class="code-value">{{codeDurations[codeDurationIndex]}} ›</text></view>
            </picker>
            <picker range="{{codeCounts}}" value="{{codeCountIndex}}" bindchange="codePickCount" disabled="{{codeBusy}}">
              <view class="card-row"><text class="card-row-label">{{ui['可兑换次数']}}</text><text class="code-value">{{codeCounts[codeCountIndex]}} ›</text></view>
            </picker>
          </view>

          <button class="code-primary" bindtap="codeGenerate" disabled="{{codeBusy}}">{{codeBusy ? ui['生成中…'] : ui['生成兑换码']}}</button>

          <view wx:if="{{codeGenerated}}" class="code-result">
            <text class="code-result-label">{{ui['请妥善保管，可在最近生成列表中再次复制或删除']}}</text>
            <text class="code-result-value" selectable>{{codeGenerated}}</text>
            <text class="code-result-meta">{{codeGeneratedMeta}}</text>
            <view class="code-result-actions">
              <button class="code-btn" bindtap="codeCopyGenerated">{{ui['复制']}}</button>
              <button wx:if="{{codeGeneratedId}}" class="code-btn danger" data-id="{{codeGeneratedId}}" bindtap="codeDeleteItem">{{ui['删除']}}</button>
            </view>
          </view>

          <view class="code-list-head">
            <text class="code-list-title">{{ui['最近生成']}}</text>
            <text class="code-refresh" bindtap="loadCodes">{{ui['刷新']}}</text>
          </view>
          <view wx:if="{{!codeItems.length}}" class="code-message">{{ui['还没有生成兑换码']}}</view>
          <view wx:for="{{codeItems}}" wx:key="id" class="code-item">
            <view class="code-item-head">
              <text class="code-item-title">{{item.title}}</text>
              <text class="code-item-status">{{ui[item.statusLabel] !== undefined ? ui[item.statusLabel] : item.statusLabel}}</text>
            </view>
            <text class="code-item-meta">{{ui['范围']}} {{item.nodeId ? item.nodeId : ui['全部公网节点']}}</text>
            <text class="code-item-meta">{{ui[item.usageLabel] !== undefined ? ui[item.usageLabel] : item.usageLabel}} · {{ui[item.expiryLabel] !== undefined ? ui[item.expiryLabel] : item.expiryLabel}} {{ui['到期']}}</text>
            <view class="code-item-actions">
              <button class="code-btn" data-id="{{item.id}}" bindtap="codeCopyItem" disabled="{{codeBusy}}">{{ui['复制']}}</button>
              <button wx:if="{{item.canRevoke}}" class="code-btn" data-id="{{item.id}}" bindtap="codeRevokeItem" disabled="{{codeBusy}}">{{ui['停用']}}</button>
              <button class="code-btn danger" data-id="{{item.id}}" bindtap="codeDeleteItem" disabled="{{codeBusy}}">{{ui['删除']}}</button>
            </view>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>

  <view wx:if="{{pairSheetOpen}}" class="pair-sheet-mask" catchtap="closePairSheet" catchtouchmove="noop">
    <view class="pair-sheet resizable" style="height: {{sheetExpanded.pair ? 90 : 62}}vh;" catchtap="noop">
      <view class="sheet-grabber-zone" data-sheet="pair" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['添加公网节点']}}</text>
          <text class="pair-sheet-subtitle">{{ui['粘贴插件提供的 Base64URL 配对信息']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closePairSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <textarea
        class="pair-payload-input"
        value="{{pairingText}}"
        maxlength="20000"
        auto-height="{{false}}"
        placeholder="{{ui['粘贴完整配对字符串']}}"
        placeholder-class="pair-payload-placeholder"
        bindinput="onPairingInput"
        disabled="{{pairingConnecting}}"
      />
      <text wx:if="{{pairingError}}" class="pair-result {{pairingConnecting ? 'pair-result-pending' : ''}}">{{ui[pairingError] !== undefined ? ui[pairingError] : pairingError}}</text>
      <view class="pair-submit {{!pairingText || pairingConnecting ? 'pair-submit-disabled' : ''}}" bindtap="connectPublicNode">
        <text>{{pairingConnecting ? ui['连接中…'] : ui['连接节点']}}</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{statusStyleSheetOpen}}" class="status-style-mask {{themeClass}}" catchtap="closeStatusStyles" catchtouchmove="noop">
  <view class="status-style-sheet resizable" style="height: {{sheetExpanded.statusStyle ? 90 : 72}}vh;" catchtap="noop">
    <view class="sheet-grabber-zone" data-sheet="statusStyle" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
    <view class="status-style-head"><view><view class="status-style-title">{{ui['对话状态条']}}</view><view class="status-style-hint">{{ui['只改变外观，保留原有文案和计时']}}</view></view></view>
    <scroll-view class="status-style-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{statusStyleChoices}}" wx:key="id" class="status-style-option {{statusAppearance === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseStatusStyle" role="button" aria-label="{{ui[item.label] !== undefined ? ui[item.label] : item.label}} {{statusAppearance === item.id ? ui['已选择'] : ''}}">
        <view class="status-style-option-head"><text class="status-style-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text><text class="status-style-check">{{statusAppearance === item.id ? ui['已选择'] : ''}}</text></view>
        <view class="status-style-preview status-look-{{item.id}}"><view class="status-tail"><image class="status-tail-image" mode="aspectFit" src="/assets/icons/official-sway-{{theme === 'dark' ? 'dark' : 'light'}}.gif"/></view><view class="status-text-motion"><text class="status-gradient" style="{{theme === 'dark' ? item.darkStyle : item.lightStyle}}">{{ui['正在思考，用时 12 秒…']}}</text></view></view>
        <view class="status-style-description">{{item.detail}}</view>
      </view>
    </scroll-view>
    <view class="status-style-footer">{{ui['只改变文字流光 · 自动保存']}}</view>
  </view>
</view>

<view wx:if="{{procIconSheetOpen}}" class="status-style-mask {{themeClass}}" catchtap="closeProcIcons" catchtouchmove="noop">
  <view class="status-style-sheet resizable" style="height: {{sheetExpanded.procIcon ? 90 : 72}}vh;" catchtap="noop">
    <view class="sheet-grabber-zone" data-sheet="procIcon" catchtouchstart="sheetGrabStart" catchtouchmove="sheetGrabMove" catchtouchend="sheetGrabEnd"><view class="sheet-grabber"></view></view>
    <view class="status-style-head"><view><view class="status-style-title">{{ui['执行图标']}}</view><view class="status-style-hint">{{ui['只改变执行中标题前的方形动效，标题与步骤保持不变']}}</view></view></view>
    <scroll-view class="status-style-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{procIconChoices}}" wx:key="id" class="status-style-option {{procIconStyle === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseProcIcon" role="button" aria-label="{{ui[item.label] !== undefined ? ui[item.label] : item.label}} {{procIconStyle === item.id ? ui['已选择'] : ''}}">
        <view class="status-style-option-head"><text class="status-style-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text><text class="status-style-check">{{procIconStyle === item.id ? ui['已选择'] : ''}}</text></view>
        <view class="status-style-preview proc-preview"><view class="proc-loader proc-look-{{item.id}}"><block wx:if="{{item.id === 'cells'}}"><view class="proc-cell c1"></view><view class="proc-cell c2"></view><view class="proc-cell c3"></view><view class="proc-cell c4"></view></block><image wx:else class="proc-loader-image" mode="aspectFit" src="/assets/icons/{{item.file}}-{{theme === 'dark' ? 'dark' : 'light'}}.gif"/></view><text class="proc-preview-title">{{ui['正在执行命令']}}</text></view>
        <view class="status-style-description">{{item.detail}}</view>
      </view>
    </scroll-view>
    <view class="status-style-footer">{{ui['图标动效保存在当前小程序 · 自动保存']}}</view>
  </view>
</view>
