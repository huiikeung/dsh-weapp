/* 创建工作区页 —— 对齐 dsh-mobile v1.6.0 WorkspaceDirectoryBrowserSheet
   浅色: bg #F3F3F8, card #FFF, 按钮 surface 88%
   深色: bg #171A20, card #22262D
   创建按钮: 双主题始终纯黑 */

.picker {
  height: 100vh;
  overflow: hidden;
}

/* ---------- 弹层容器 ---------- */

.dir-sheet {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F3F3F8;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.theme-dark .dir-sheet {
  background: #171A20;
}

.dir-sheet-handle {
  width: 76rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(16, 19, 26, 0.18);
  margin: 16rpx auto 8rpx;
  flex-shrink: 0;
}

.theme-dark .dir-sheet-handle {
  background: rgba(241, 244, 250, 0.30);
}

/* ---------- 头部 ---------- */

.dir-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 132rpx;
  padding: 0 36rpx;
  flex-shrink: 0;
}

.dir-head-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

/* 新建文件夹按钮：透明背景 */
.dir-head-btn {
  position: absolute;
  left: 36rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dir-head-btn.disabled {
  opacity: 0.4;
}

/* 文件夹图标颜色随主题：浅色用 ink 版，深色用 white 版 */
.dir-head-folder {
  width: 52rpx;
  height: 52rpx;
}

.dir-head-badge {
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #F3F3F8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-dark .dir-head-badge {
  background: #171A20;
}

.dir-head-badge text {
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: -4rpx;
}

/* 取消按钮：透明背景 */
.dir-head-cancel {
  position: absolute;
  right: 36rpx;
  height: 96rpx;
  padding: 0 40rpx;
  border-radius: 48rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text);
}

/* ---------- 当前目录 ---------- */

.dir-cwd {
  padding: 0 44rpx;
  flex-shrink: 0;
}

.dir-cwd-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
}

.dir-cwd-path {
  display: block;
  font-size: 26rpx;
  color: var(--text-4);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 目录列表卡片 ---------- */

.dir-list-card {
  flex: 1;
  min-height: 0;
  margin: 28rpx 36rpx 0;
  background: #FFFFFF;
  border-radius: 56rpx 56rpx 0 0;
  overflow: hidden;
}

.theme-dark .dir-list-card {
  background: #22262D;
}

.dir-list {
  height: 100%;
  box-sizing: border-box;
  padding: 20rpx 36rpx;
}

.dir-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--text-3);
  font-size: 30rpx;
  gap: 20rpx;
}

.dir-error {
  color: #E5484D;
}

.dir-empty {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-4);
  font-size: 27rpx;
}

.dir-row {
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
}

.dir-row.disabled {
  opacity: 0.3;
}

.dir-row.highlight {
  background: rgba(46, 107, 230, 0.20);
}

.dir-row-hover {
  background: rgba(16, 19, 26, 0.04);
}

.theme-dark .dir-row-hover {
  background: rgba(241, 244, 250, 0.06);
}

.dir-row-icon {
  position: relative;
  width: 68rpx;
  flex-shrink: 0;
}

.dir-row-ic {
  width: 50rpx;
  height: 50rpx;
}

.dir-row-badge {
  position: absolute;
  right: 6rpx;
  top: -6rpx;
  width: 26rpx;
  height: 26rpx;
}

.dir-row-body {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.dir-row-name {
  display: block;
  font-size: 32rpx;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dir-row-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}

.dir-row-chev {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.dir-divider {
  height: 1rpx;
  margin-left: 116rpx;
  background: var(--divider);
}

/* ---------- 底部创建栏（dsh-mobile 始终纯黑按钮） ---------- */

.dir-create-bar {
  padding: 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.dir-create-path {
  font-size: 24rpx;
  color: var(--text-4);
  max-width: 100%;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dir-create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 104rpx;
  border-radius: 28rpx;
  background: #000000;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.dir-create-btn.disabled {
  opacity: 0.45;
}

.dir-create-add {
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
}

.dir-creating-hint {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

/* ---------- 加载转圈 ---------- */

.dir-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(16, 19, 26, 0.15);
  border-top-color: rgba(16, 19, 26, 0.7);
  border-radius: 50%;
  animation: dir-spin 0.8s linear infinite;
  flex-shrink: 0;
}

.theme-dark .dir-spinner {
  border-color: rgba(241, 244, 250, 0.25);
  border-top-color: rgba(241, 244, 250, 0.9);
}

.dir-spinner.small {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
  margin-right: 16rpx;
}

.dir-spinner.light {
  border-color: rgba(255, 255, 255, 0.30);
  border-top-color: #FFFFFF;
  width: 38rpx;
  height: 38rpx;
  margin-right: 18rpx;
}

@keyframes dir-spin {
  to {
    transform: rotate(360deg);
  }
}
