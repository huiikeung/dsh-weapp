<page-meta page-style="{{pageStyle}}" />
<import src="../../styles/proc-icon.wxml" />
<view class="page settings {{themeClass}} {{settingsGlassEnabled ? 'settings-glass-ui' : 'settings-native-ui'}}" style="{{contentFontStyle}}; --glass-alpha-top: {{glassAlphaTop}}; --glass-alpha-bottom: {{glassAlphaBottom}}; --glass-edge-alpha: {{glassEdgeAlpha}}; --glass-blur-sheet: {{glassBlurSheet}}; --glass-blur-card: {{glassBlurCard}}; --glass-radius-sheet: {{glassRadiusSheet}}; --glass-radius-card: {{glassRadiusCard}}; --glass-radius-choice: {{glassRadiusChoice}}; --glass-backdrop-brightness: {{glassBackdropBrightness}}; {{settingsGlassEnabled ? '' : '--surface: ' + nativeSurfaceColor + '; --fill: ' + nativeFillColor + ';'}}">
  <!-- 自定义导航：与右上角胶囊同一水平线，避免原生导航在手动深色时露白 -->
  <view class="nav" style="padding-top:{{navPadTop}}px;height:{{navHeight}}px;">
    <view class="nav-back tap" bindtap="goBack" hover-class="press-dim" role="button" aria-label="{{ui['返回']}}">
      <image class="nav-back-ic" src="/assets/icons/{{theme === 'dark' ? 'back-white.png' : 'back-black.png'}}"/>
    </view>
    <text class="nav-title">{{ui['设置']}}</text>
  </view>
  <view class="nav-placeholder" style="height:{{navPadTop + navHeight}}px;" aria-hidden="true"></view>

  <!-- DSH 客户端账号区：结构与桌面端 AccountSection 对齐。
       是否显示由「通用设置 → 显示账号卡片」的开关决定（默认隐藏），
       会话设置页顶部的账号区跟随同一个开关。 -->
  <view wx:if="{{showAccountCard && dshAccountVisible}}" class="dsh-account-section" aria-label="{{ui['账号与余额']}}">
    <view class="dsh-account-card {{dshAccount.signedIn ? 'tappable has-chevron' : ''}}" bindtap="toggleDshBalance" hover-class="press-dim" role="button" aria-expanded="{{dshBalanceExpanded}}" aria-label="{{ui['账号与余额']}}">
      <view class="dsh-account-identity">
        <view class="dsh-account-avatar">
          <image wx:if="{{dshAccount.avatarUrl}}" class="dsh-account-avatar-image" src="{{dshAccount.avatarUrl}}" mode="aspectFill"/>
          <image wx:else class="dsh-account-avatar-user" mode="aspectFit" src="/assets/icons/account-user{{theme === 'dark' ? '-dark' : ''}}.svg"/>
        </view>
        <view class="dsh-account-identity-copy">
          <text class="dsh-account-name">{{dshAccount.name}}</text>
          <text class="dsh-account-status">{{dshAccountBusy ? ui['加载中…'] : dshAccount.status}}</text>
        </view>
      </view>
      <image wx:if="{{dshAccount.signedIn}}" class="dsh-account-chevron {{dshBalanceExpanded ? 'open' : ''}}" src="/assets/icons/chev-right-gray.png"/>
      <view wx:if="{{!dshAccount.signedIn && !dshAccountBusy}}" class="dsh-account-link-button dsh-account-primary" catchtap="explainDshAccountSignIn" hover-class="press-dim" role="button" aria-label="{{ui['登录']}}">{{ui['登录']}}</view>
    </view>
    <view wx:if="{{dshBalanceExpanded && dshAccount.signedIn}}" class="dsh-balance-card">
      <view class="dsh-balance-row">
        <text>{{ui['充值余额']}}</text>
        <view wx:if="{{dshAccount.balanceText}}" class="dsh-balance-amount"><text>{{dshAccount.balanceText}}</text></view>
        <text wx:elif="{{dshAccount.balanceState === 'signed-out'}}" class="dsh-account-muted">{{ui['登录后查看']}}</text>
        <text wx:elif="{{dshAccount.balanceState === 'loading'}}" class="dsh-account-muted">{{ui['加载中…']}}</text>
        <text wx:else class="dsh-account-unavailable" data-url="{{dshAccount.usageUrl}}" bindtap="openDshAccountLink" role="button">{{ui['前往开放平台查看']}}</text>
      </view>
      <block wx:if="{{dshAccount.showBonusRow}}">
        <view class="dsh-account-divider"></view>
        <view class="dsh-balance-row">
          <text>{{ui['赠金余额']}}</text>
          <view wx:if="{{dshAccount.bonusBalance.length}}" class="dsh-balance-bonus"><view class="dsh-balance-amount"><text wx:for="{{dshAccount.bonusBalance}}" wx:key="*this">{{item}}</text></view></view>
          <text wx:else class="dsh-account-muted">{{ui['加载中…']}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="group-title">{{ui['连接']}}</view>
  <view class="card {{settingsGlassEnabled ? 'settings-glass-card' : ''}}">

        <view class="card-row management-entry" bindtap="openPublicAccess" hover-class="management-entry-active" role="button" aria-label="{{ui['公网访问']}}">
          <view class="management-entry-copy">
            <view class="card-row-label">{{ui['公网访问']}}</view>
          </view>
          <view class="card-row-value management-entry-value">
            <text>{{ui[publicValueLabel] !== undefined ? ui[publicValueLabel] : publicValueLabel}}</text>
            <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
          </view>
        </view>


        <view class="card-row management-entry" bindtap="openNodeManagement" hover-class="management-entry-active" role="button" aria-label="{{ui['节点管理']}}">
          <view class="management-entry-copy">
            <view class="card-row-label">{{ui['节点管理']}}</view>
          </view>
          <view class="card-row-value management-entry-value">
            <text>{{nodeCount}} {{ui['个']}}</text>
            <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
          </view>
        </view>

    <block wx:if="{{accountIdentityReady}}">
      <view wx:if="{{isWechatAdmin}}" class="card-row management-entry" bindtap="openAdminSheet" hover-class="management-entry-active" role="button" aria-label="{{ui['公网权限']}}">
        <view class="management-entry-copy">
          <text class="card-row-label">{{ui['公网权限']}}</text>
        </view>
        <view class="card-row-value management-entry-value identity-entry-value">
          <view class="identity-badge is-admin">{{identityBadgeLabel}}</view>
          <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
        </view>
      </view>
      <view wx:else class="card-row management-entry identity-entry">
        <view class="management-entry-copy">
          <text class="card-row-label">{{ui['公网权限']}}</text>
        </view>
        <view class="card-row-value management-entry-value identity-entry-value">
          <view class="identity-badge">{{identityBadgeLabel}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="group-title">{{ui['对话']}}</view>
  <view class="card work-step-settings {{settingsGlassEnabled ? 'settings-glass-card' : ''}}">
    <view class="card-row">
      <view class="work-step-copy"><text class="card-row-label">{{ui['语音输入']}}</text><text class="work-step-hint">{{ui['按住说话，由已连接的 DSH 语音插件转写']}}</text></view>
      <dsh-switch checked="{{voiceEnabled}}" aria-label="{{ui['语音输入']}}" bindchange="toggleVoice"/>
    </view>
    <view wx:if="{{voiceEnabled}}" class="card-row" bindtap="openVoiceSettings" role="button">
      <text class="card-row-label">{{ui['语音插件设置']}}</text><view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
    <view class="card-row work-step-row work-step-mode-row {{choiceMenu === 'mode' ? 'work-step-row-open' : ''}}">
      <view class="work-step-copy"><text class="card-row-label">{{ui['工作步骤展示']}}</text><text class="work-step-hint">{{ui['选择希望看到多少工具调用细节']}}</text></view>
      <view class="work-step-select" bindtap="toggleWorkStepMenu" data-field="mode" role="button" aria-label="{{ui['工作步骤展示：']}}{{ui[workStepModeLabel] !== undefined ? ui[workStepModeLabel] : workStepModeLabel}}"><text>{{ui[workStepModeLabel] !== undefined ? ui[workStepModeLabel] : workStepModeLabel}}</text><image class="work-step-select-chevron" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
    <view class="card-row work-step-row work-step-timing-row {{choiceMenu === 'timing' ? 'work-step-row-open' : ''}}">
      <view class="work-step-copy"><text class="card-row-label">{{ui['工作步骤收起时机']}}</text><text class="work-step-hint">{{ui['选择何时自动收起工作步骤']}}</text></view>
      <view class="work-step-select" bindtap="toggleWorkStepMenu" data-field="timing" role="button" aria-label="{{ui['工作步骤收起时机：']}}{{ui[workStepTimingLabel] !== undefined ? ui[workStepTimingLabel] : workStepTimingLabel}}"><text>{{ui[workStepTimingLabel] !== undefined ? ui[workStepTimingLabel] : workStepTimingLabel}}</text><image class="work-step-select-chevron" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
  </view>
  <view class="group-hint">{{ui['完全展开时不自动收起；设置保存在当前小程序。']}}</view>
  <!-- 选择弹窗内容模板：底部弹窗与锚点菜单共用 -->
  <template name="choiceRows">
    <view class="settings-choice-content">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="settings-choice-row"
        hover-class="settings-choice-row-pressed"
        data-kind="{{kind}}"
        data-id="{{item.id}}"
        bindtap="chooseChoice"
        role="button"
        aria-label="{{ui[item.label] !== undefined ? ui[item.label] : item.label}}"
      >
        <image class="settings-choice-ic" src="/assets/icons/{{item.id === current ? 'check-fill-white.png' : 'circle-white.png'}}" mode="aspectFit"/>
        <text class="settings-choice-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
      </view>
    </view>
  </template>

  <!-- 形态一：底部弹窗（受设置页「底部弹窗」开关控制，皮肤跟随「玻璃UI样式」） -->
  <view wx:if="{{choiceMenu && choiceSheet}}" class="choice-sheet-mask" catchtap="closeChoiceMenu" catchtouchmove="noop">
    <view class="choice-sheet {{settingsGlassEnabled ? 'choice-sheet-glass' : ''}}" catchtap="noop" role="dialog" aria-label="{{choiceTitle}}">
      <view class="choice-sheet-grabber"><view class="choice-sheet-grabbar"></view></view>
      <scroll-view scroll-y class="choice-sheet-body" show-scrollbar="{{false}}">
        <template is="choiceRows" data="{{items: choiceOptions, current: choiceCurrent, kind: choiceMenu, ui: ui}}"/>
      </scroll-view>
    </view>
  </view>

  <!-- 形态二：贴行的锚点菜单 -->
  <view wx:if="{{choiceMenu && !choiceSheet}}" class="settings-choice-mask" catchtap="closeChoiceMenu" catchtouchmove="noop"></view>
  <view
    wx:if="{{choiceMenu && !choiceSheet}}"
    class="settings-choice {{settingsGlassEnabled ? 'settings-choice-glass' : ''}}"
    style="left: {{choiceLeft}}px; top: {{choiceTop}}px; width: {{choiceWidth}}px; height: {{choiceHeight}}px; transform-origin: 50% {{choiceOriginY}}px;"
    catchtap="noop"
    role="dialog"
    aria-label="{{choiceTitle}}"
  >
    <scroll-view class="settings-choice-scroll" scroll-y show-scrollbar="{{false}}">
      <template is="choiceRows" data="{{items: choiceOptions, current: choiceCurrent, kind: choiceMenu, ui: ui}}"/>
    </scroll-view>
  </view>

  <!-- 震动反馈弹窗 -->
  <view wx:if="{{hapticsSheet}}" class="pair-sheet-mask" catchtap="closeHapticsSheet" catchtouchmove="noop">
    <view class="pair-sheet appearance-sheet {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}" catchtap="noop" role="dialog" aria-label="{{ui['震动反馈']}}">
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['震动反馈']}}</text>
          <text class="pair-sheet-subtitle">{{ui['点击与滑动时的震动强度，全局生效。']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeHapticsSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <view class="appearance-options">
        <view
          wx:for="{{hapticsOptions}}"
          wx:key="level"
          class="appearance-option {{hapticsLevel === item.level ? 'selected' : ''}}"
          data-level="{{item.level}}"
          bindtap="chooseHaptics"
          role="button"
        >
          <text class="appearance-option-label">{{item.label}}</text>
          <text class="appearance-option-check">{{hapticsLevel === item.level ? '✓' : ''}}</text>
        </view>
      </view>
      <view class="haptics-test-row" bindtap="testHaptics" role="button">{{ui['测试震动']}}</view>
      <view wx:if="{{hapticsStatusText}}" class="haptics-status">{{hapticsStatusText}}</view>
    </view>
  </view>

  <!-- 外观（界面）弹窗 -->
  <view wx:if="{{appearanceSheet}}" class="pair-sheet-mask" catchtap="closeAppearanceSheet" catchtouchmove="noop">
    <view class="pair-sheet appearance-sheet {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}" catchtap="noop" role="dialog" aria-label="{{ui['外观']}}">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['外观']}}</text>
          <text class="pair-sheet-subtitle">{{ui['跟随微信']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeAppearanceSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <view class="appearance-options">
        <view
          wx:for="{{appearanceModes}}"
          wx:key="mode"
          class="appearance-option {{appearanceMode === item.mode ? 'selected' : ''}}"
          data-mode="{{item.mode}}"
          bindtap="chooseAppearance"
          role="button"
        >
          <view class="appearance-option-icon">
            <view class="appearance-glyph appearance-glyph-{{item.mode}}"></view>
          </view>
          <text class="appearance-option-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text>
          <text class="appearance-option-check">{{appearanceMode === item.mode ? '✓' : ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 字体与字号弹窗 -->
  <view wx:if="{{fontSheet}}" class="pair-sheet-mask" catchtap="closeFontSheet" catchtouchmove="noop">
    <view class="pair-sheet resizable font-sheet {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}" style="height: calc(90vh - var(--glass-sheet-drop, 0px));" catchtap="noop" role="dialog" aria-label="{{ui['字号大小']}}">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['字号大小']}}</text>
          <text class="pair-sheet-subtitle">{{ui['仅影响会话内容的字号']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeFontSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <scroll-view class="font-sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="management-scroll">
        <view class="card general-preferences {{settingsGlassEnabled ? 'settings-glass-card' : ''}}">
        <view class="card-row preference-font-row" bindtap="toggleFontSettings" role="button" aria-expanded="{{fontSettingsExpanded}}" aria-label="{{ui['字号大小']}}">
              <view class="preference-description"><text class="card-row-label">{{ui['字号大小']}}</text><text class="preference-hint">{{ui['仅影响会话内容的字号']}}</text></view>
              <view class="font-number-control" catchtap="noop"><input class="font-number" type="number" value="{{fontSizes.text}}" data-role="text" bindblur="commitFontSize" bindconfirm="commitFontSize" maxlength="2"/><text class="font-unit">px</text></view>
            </view>
        <block wx:if="{{fontSettingsExpanded}}">
              <view class="card-row font-detail-row"><view class="preference-description"><text class="card-row-label">{{ui['正文字体']}}</text><text class="preference-hint">{{ui['用于界面与会话正文。多个字体用逗号分隔，留空使用默认字体']}}</text></view><input class="font-family-input" value="{{fontFamilies.text}}" placeholder="{{ui['默认']}}" placeholder-class="font-family-placeholder" data-role="text" bindblur="commitFontFamily" bindconfirm="commitFontFamily" maxlength="500"/></view>
              <view class="card-row font-detail-row"><view class="preference-description"><text class="card-row-label">{{ui['代码字体']}}</text><text class="preference-hint">{{ui['用于代码块、行内代码与工具输出。多个字体用逗号分隔，留空使用默认字体']}}</text></view><input class="font-family-input" value="{{fontFamilies.code}}" placeholder="{{ui['默认']}}" placeholder-class="font-family-placeholder" data-role="code" bindblur="commitFontFamily" bindconfirm="commitFontFamily" maxlength="500"/></view>
              <view class="card-row font-detail-row"><view class="preference-description"><text class="card-row-label">{{ui['代码字号']}}</text><text class="preference-hint">{{ui['用于代码块、行内代码与工具输出']}}</text></view><view class="font-number-control"><input class="font-number" type="number" value="{{fontSizes.code}}" data-role="code" bindblur="commitFontSize" bindconfirm="commitFontSize" maxlength="2"/><text class="font-unit">px</text></view></view>
              <view class="card-row font-detail-row"><view class="preference-description"><text class="card-row-label">{{ui['终端字体']}}</text><text class="preference-hint">{{ui['用于侧栏终端。多个字体用逗号分隔，留空使用默认字体']}}</text></view><input class="font-family-input" value="{{fontFamilies.terminal}}" placeholder="{{ui['默认']}}" placeholder-class="font-family-placeholder" data-role="terminal" bindblur="commitFontFamily" bindconfirm="commitFontFamily" maxlength="500"/></view>
              <view class="card-row font-detail-row"><view class="preference-description"><text class="card-row-label">{{ui['终端字号']}}</text><text class="preference-hint">{{ui['用于侧栏终端']}}</text></view><view class="font-number-control"><input class="font-number" type="number" value="{{fontSizes.terminal}}" data-role="terminal" bindblur="commitFontSize" bindconfirm="commitFontSize" maxlength="2"/><text class="font-unit">px</text></view></view>
              <view class="font-preview-panel"><text class="preference-hint">{{ui['字体预览']}}</text><text class="font-preview-text">{{ui['正文字体']}} · DeepSeek Harness</text><text class="font-preview-code">const answer = 42;</text><text class="font-preview-terminal">$ dsh --version</text><text class="preference-hint">{{ui['实际可用字体取决于设备；找不到的字体将使用后备字体。']}}</text><text class="preference-hint">{{ui['当前小程序暂无侧栏终端；终端偏好已保存，下方预览可查看效果。']}}</text></view>
            </block>
        </view>
      </view>
      </scroll-view>
    </view>
  </view>
  <!-- 存储空间弹窗（dsh-mobile StorageSpaceView） -->
  <view wx:if="{{storageSheet}}" class="pair-sheet-mask" catchtap="closeStorageSheet" catchtouchmove="noop">
    <view class="pair-sheet resizable {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}" style="height: calc(90vh - var(--glass-sheet-drop, 0px));" catchtap="noop" role="dialog" aria-label="{{ui['存储空间']}}">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view class="storage-head-row">
          <view wx:if="{{storageDetailInfo}}" class="storage-back tap" bindtap="backToStorageList" hover-class="press-dim" role="button" aria-label="{{ui['返回']}}">{{ui['返回']}}</view>
          <text class="pair-sheet-title">{{storageDetailInfo ? ui[storageDetailInfo.title] : ui['存储空间']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeStorageSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <view class="management-scroll">
        <block wx:if="{{storageLoading || !storageUsage}}">
          <view class="storage-state"><text>{{ui['正在统计…']}}</text></view>
        </block>
        <block wx:elif="{{storageDetailInfo}}">
          <view class="card storage-detail-card">
            <view class="storage-detail-head">
              <view class="storage-icon storage-icon-lg" style="background:linear-gradient(180deg, {{storageDetailInfo.color}}, {{storageDetailInfo.color}}C4);"><image class="storage-icon-img" src="{{storageDetailInfo.icon}}" mode="aspectFit"/></view>
              <view class="storage-row-copy"><text class="storage-detail-title">{{ui[storageDetailInfo.title]}}</text><text class="storage-row-detail">{{ui[storageDetailInfo.detail]}}</text></view>
              <text class="storage-detail-size">{{storageDetailInfo.bytesText}}</text>
            </view>
          </view>
          <view class="card">
            <view class="card-row storage-clear {{storageBusy ? 'is-disabled' : ''}}" bindtap="clearStorageCategory" hover-class="management-entry-active" role="button" aria-label="{{ui['清理本机缓存']}}">
              <text class="storage-clear-text">{{storageBusy ? ui['清理中…'] : ui['清理本机缓存']}}</text>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="card storage-hero">
            <view class="storage-donut" style="{{storageUsage.gradient ? 'background:conic-gradient(' + storageUsage.gradient + ');' : ''}}">
              <view class="storage-donut-hole">
                <text class="storage-donut-total">{{storageUsage.totalText}}</text>
                <text class="storage-donut-label">{{ui['本机缓存']}}</text>
              </view>
            </view>
            <view wx:if="{{storageUsage.storageText}}" class="storage-quota">
              <view class="storage-quota-copy">
                <text>{{ui['微信键值存储']}}</text>
                <text class="storage-quota-hint">{{ui['不含图片与文件']}}</text>
              </view>
              <text class="storage-quota-value">{{storageUsage.storageText}}</text>
            </view>
          </view>

          <view class="card storage-list">
            <view class="storage-row" wx:for="{{storageUsage.categories}}" wx:key="key" bindtap="openStorageDetail" data-key="{{item.key}}" hover-class="management-entry-active" role="button" aria-label="{{ui[item.title]}}">
              <view class="storage-icon" style="background:linear-gradient(180deg, {{item.color}}, {{item.color}}C4);"><image class="storage-icon-img" src="{{item.icon}}" mode="aspectFit"/></view>
              <view class="storage-row-copy"><text class="storage-row-title">{{ui[item.title]}}</text><text class="storage-row-detail">{{ui[item.detail]}}</text></view>
              <view class="storage-row-right">
                <text class="storage-row-size">{{item.bytesText}}</text>
                <text wx:if="{{item.pctText}}" class="storage-row-pct">{{item.pctText}}</text>
              </view>
              <image class="chevron-img storage-row-chevron" src="/assets/icons/chev-right-gray.png"/>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>
  <!-- 管理员弹窗 -->
  <view wx:if="{{adminSheet}}" class="pair-sheet-mask" catchtap="closeAdminSheet" catchtouchmove="noop">
    <view class="pair-sheet resizable {{settingsGlassEnabled ? 'settings-glass-sheet' : ''}}" style="height: calc(90vh - var(--glass-sheet-drop, 0px));" catchtap="noop" role="dialog" aria-label="{{ui['公网权限']}}">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['公网权限']}}</text>
          <text class="pair-sheet-subtitle">{{ui['兑换码管理']}} · {{ui['发布公告']}} · {{ui['分享活动']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closeAdminSheet" role="button"><view class="sheet-close-x"></view></view>
      </view>
      <view class="management-scroll">
        <block wx:if="{{isWechatAdmin}}">
          <view class="group-title">{{ui['管理员']}}</view>
          <view class="card">

                  <view class="card-row management-entry" bindtap="openCodeManagement" hover-class="management-entry-active" role="button">
                    <view class="management-entry-copy">
