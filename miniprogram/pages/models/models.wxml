<page-meta page-style="{{pageStyle}}" />
<view class="page models {{themeClass}}" style="{{contentFontStyle}}">
  <!-- 导航：与 DSH 客户端「设置 → 模型」一致的自定义标题栏 -->
  <view class="models-nav" style="padding-top: {{statusBarH}}px;">
    <view class="models-back tap" bindtap="goBack" hover-class="models-press" role="button" aria-label="{{ui['返回']}}">
      <image class="models-back-ic" src="/assets/icons/{{theme === 'dark' ? 'back-white.png' : 'back-black.png'}}" mode="aspectFit"/>
    </view>
    <text class="models-title">{{ui['模型']}}</text>
  </view>

  <scroll-view class="models-scroll" scroll-y refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullRefresh">
    <view class="models-body">
      <text class="models-intro">{{ui['管理已配置提供商的模型；修改会同步到 DSH 客户端。']}}</text>

      <view wx:if="{{loading && !providers.length}}" class="models-state">
        <view class="models-spinner"></view>
        <text class="models-state-text">{{ui['正在读取模型…']}}</text>
      </view>

      <view wx:elif="{{error && !providers.length}}" class="models-state">
        <text class="models-state-title">{{ui[error] !== undefined ? ui[error] : error}}</text>
        <button class="models-outline-btn" bindtap="onPullRefresh">{{ui['重试']}}</button>
      </view>

      <view wx:elif="{{!providers.length}}" class="models-state">
        <text class="models-state-title">{{ui['还没有可配置的模型提供商']}}</text>
        <text class="models-state-desc">{{ui['请先在 DSH 客户端 → 设置 → 模型中添加模型提供商，保存后会自动同步到这里。']}}</text>
      </view>

      <block wx:else>
        <view wx:if="{{error}}" class="models-notice">{{ui[error] !== undefined ? ui[error] : error}}</view>
        <view class="models-section-head">
          <text class="models-section-title">{{ui['模型提供商']}}</text>
          <view class="models-section-refresh tap" bindtap="onPullRefresh" hover-class="models-press" role="button" aria-label="{{ui['刷新']}}">{{ui['刷新']}}</view>
        </view>
        <view wx:for="{{providers}}" wx:key="id" class="provider-card {{expandedId === item.id ? 'expanded' : ''}}">
          <view class="provider-row" data-id="{{item.id}}" bindtap="toggleProvider" hover-class="provider-row-pressed" role="button" aria-expanded="{{expandedId === item.id}}">
            <text class="provider-name">{{item.name}}</text>
            <text wx:if="{{item.custom}}" class="provider-badge">{{ui['自定义']}}</text>
            <view class="provider-dot {{item.status}}" aria-hidden="true"></view>
            <view class="provider-actions">
              <view class="provider-edit">{{expandedId === item.id ? ui['完成'] : ui['编辑']}}</view>
            </view>
          </view>

          <view wx:if="{{expandedId === item.id}}" class="provider-body">
            <view class="provider-meta">
              <view class="provider-meta-row">
                <text class="provider-meta-label">{{ui['API 协议']}}</text>
                <text class="provider-meta-value">{{item.apiLabel || '—'}}</text>
              </view>
              <view class="provider-meta-row">
                <text class="provider-meta-label">{{ui['接口地址']}}</text>
                <text class="provider-meta-value provider-meta-mono" selectable>{{item.baseURL || ui['默认端点']}}</text>
              </view>
            </view>

            <view class="provider-models-head">
              <text class="provider-models-title">{{ui['模型']}}</text>
              <text class="provider-models-count">{{item.count}}{{ui[' 个模型']}}</text>
            </view>

            <view wx:if="{{!item.models.length}}" class="provider-models-empty">{{ui['这个提供商还没有模型']}}</view>
            <view wx:for="{{item.models}}" wx:for-item="model" wx:key="id" class="model-row">
              <view class="model-copy">
                <view class="model-title-row">
                  <text class="model-name">{{model.name}}</text>
                  <text wx:if="{{model.isDefault}}" class="model-default-badge">{{ui['默认']}}</text>
                </view>
                <text class="model-id" selectable>{{model.id}}</text>
                <text wx:if="{{model.meta}}" class="model-meta">{{model.meta}}</text>
              </view>
              <view class="model-delete tap" data-provider="{{item.id}}" data-model="{{model.id}}" catchtap="askDeleteModel" hover-class="models-press" role="button" aria-label="{{ui['删除']}} {{model.name}}">{{ui['删除']}}</view>
            </view>

            <view class="model-add tap" data-id="{{item.id}}" bindtap="openAddModel" hover-class="model-add-pressed" role="button">
              <text class="model-add-plus">＋</text>
              <text class="model-add-label">{{ui['添加模型']}}</text>
            </view>
          </view>
        </view>

        <view class="provider-add tap" bindtap="openProviderSheet" hover-class="provider-add-pressed" role="button">
          <text class="provider-add-plus">＋</text>
          <text class="provider-add-label">{{ui['添加模型提供商']}}</text>
        </view>
        <view class="models-footer-hint">{{ui['提供商配置与 API Key 会写入 DSH，数据和 DSH 客户端双向同步。']}}</view>
      </block>
    </view>
  </scroll-view>

  <!-- 添加模型：底部弹窗（字段参照 DSH 客户端模型行编辑） -->
  <view wx:if="{{addOpen}}" class="models-mask" bindtap="closeAddModel" catchtouchmove="noop"></view>
  <view wx:if="{{addOpen}}" class="models-sheet" catchtap="noop" role="dialog" aria-label="{{ui['添加模型']}}">
    <view class="models-handle"></view>
    <view class="models-sheet-head">
      <view class="models-sheet-heading">
        <text class="models-sheet-title">{{ui['添加模型']}}</text>
        <text class="models-sheet-subtitle">{{addProviderName}}</text>
      </view>
      <view class="models-sheet-close tap" bindtap="closeAddModel" hover-class="models-press" role="button" aria-label="{{ui['取消']}}">×</view>
    </view>
    <scroll-view class="models-sheet-body" scroll-y>
      <view class="discovery-panel">
        <view class="discovery-head">
          <view class="discovery-copy">
            <text class="field-label">{{ui['自动获取模型']}}</text>
            <text class="field-hint">{{ui['从提供商端点读取可用模型，勾选后批量添加。']}}</text>
          </view>
          <view class="discovery-btn tap {{discovering || !supportsModelConfig ? 'disabled' : ''}}" bindtap="runAddDiscovery" role="button">
            <view wx:if="{{discovering}}" class="mini-spinner"></view>
            <text>{{discovering ? ui['正在获取…'] : ui['获取可用模型']}}</text>
          </view>
        </view>
        <text wx:if="{{!supportsModelConfig}}" class="field-hint">{{ui['当前网关暂不支持自动获取模型：请重启 DSH 加载新版网关后重试。']}}</text>
        <text wx:elif="{{discoveryError}}" class="field-error">{{discoveryError}}</text>
        <block wx:if="{{discoveryResults.length}}">
          <input class="field-input discovery-search" value="{{discoveryQuery}}" bindinput="onDiscoveryQuery" placeholder="{{ui['搜索模型']}}" placeholder-class="field-placeholder"/>
          <view class="discovery-toolbar">
            <text class="discovery-count">{{discoverySelectedCount}}{{ui[' 个已选择']}}</text>
            <view class="discovery-all tap" bindtap="toggleAllDiscovery" role="button">{{ui['全选/取消全选']}}</view>
          </view>
          <scroll-view class="discovery-list" scroll-y>
            <view wx:for="{{discoveryVisible}}" wx:key="id" class="discovery-row {{item.selected ? 'on' : ''}}" data-id="{{item.id}}" bindtap="toggleDiscoveryResult" role="checkbox" aria-checked="{{item.selected}}">
              <view class="discovery-check">{{item.selected ? '✓' : ''}}</view>
              <view class="discovery-row-copy">
                <text class="discovery-name">{{item.name}}</text>
                <text class="discovery-id">{{item.id}}</text>
                <text wx:if="{{item.meta}}" class="discovery-meta">{{item.meta}}</text>
              </view>
            </view>
            <view wx:if="{{!discoveryVisible.length}}" class="discovery-empty">{{ui['没有匹配的模型']}}</view>
          </scroll-view>
          <view class="discovery-add tap {{discoverySelectedCount && !saving ? '' : 'disabled'}}" bindtap="addDiscoveredSelected" role="button">{{ui['添加所选']}}<text wx:if="{{discoverySelectedCount}}" class="discovery-add-count">（{{discoverySelectedCount}}）</text></view>
        </block>
      </view>
      <text class="sheet-section-title">{{ui['手动添加']}}</text>
      <view class="field">
        <text class="field-label">{{ui['模型 ID']}}</text>
        <input class="field-input field-mono" value="{{form.id}}" data-field="id" bindinput="onFormInput" placeholder="{{ui['上游接口使用的模型 ID']}}" placeholder-class="field-placeholder" maxlength="200"/>
      </view>
      <view class="field">
        <text class="field-label">{{ui['显示名称（可选）']}}</text>
        <input class="field-input" value="{{form.name}}" data-field="name" bindinput="onFormInput" placeholder="{{ui['显示名称（可选）']}}" placeholder-class="field-placeholder" maxlength="200"/>
      </view>
      <view class="field-grid">
        <view class="field field-half">
          <text class="field-label">{{ui['上下文窗口']}}</text>
          <input class="field-input" type="number" value="{{form.contextWindow}}" data-field="contextWindow" bindinput="onFormInput" placeholder="1000000" placeholder-class="field-placeholder"/>
        </view>
        <view class="field field-half">
          <text class="field-label">{{ui['最大输出 Token']}}</text>
          <input class="field-input" type="number" value="{{form.maxTokens}}" data-field="maxTokens" bindinput="onFormInput" placeholder="8192" placeholder-class="field-placeholder"/>
        </view>
      </view>
      <view class="field">
        <text class="field-label">{{ui['输入类型']}}</text>
        <view class="input-chips">
          <view class="input-chip {{form.text ? 'on' : ''}}" data-input="text" bindtap="toggleInputType" role="checkbox" aria-checked="{{form.text}}">
            <text class="input-chip-check">{{form.text ? '✓' : ''}}</text>
            <text>{{ui['文本']}}</text>
          </view>
          <view class="input-chip {{form.image ? 'on' : ''}}" data-input="image" bindtap="toggleInputType" role="checkbox" aria-checked="{{form.image}}">
            <text class="input-chip-check">{{form.image ? '✓' : ''}}</text>
            <text>{{ui['图片']}}</text>
          </view>
        </view>
      </view>
      <text class="field-hint">{{ui['留空表示使用提供商默认值；模型 ID 必须与上游一致。']}}</text>
      <text wx:if="{{formError}}" class="field-error">{{formError}}</text>
    </scroll-view>
    <view class="models-sheet-actions">
      <view class="sheet-btn" bindtap="closeAddModel" hover-class="models-press" role="button">{{ui['取消']}}</view>
      <view class="sheet-btn primary {{saving ? 'disabled' : ''}}" bindtap="submitAddModel" hover-class="models-press" role="button">{{saving ? ui['正在保存…'] : ui['添加']}}</view>
    </view>
  </view>

  <!-- 删除模型确认 -->
  <view wx:if="{{deleteOpen}}" class="models-mask" bindtap="cancelDelete" catchtouchmove="noop"></view>
  <view wx:if="{{deleteOpen}}" class="models-sheet models-confirm" catchtap="noop" role="dialog" aria-label="{{ui['删除模型？']}}">
    <view class="models-handle"></view>
    <view class="models-sheet-head">
      <view class="models-sheet-heading"><text class="models-sheet-title">{{ui['删除模型？']}}</text></view>
      <view class="models-sheet-close tap" bindtap="cancelDelete" hover-class="models-press" role="button" aria-label="{{ui['取消']}}">×</view>
    </view>
    <view class="models-confirm-body"><text class="models-confirm-text">{{deleteTarget.message}}</text></view>
    <view class="models-sheet-actions">
      <view class="sheet-btn" bindtap="cancelDelete" hover-class="models-press" role="button">{{ui['取消']}}</view>
      <view class="sheet-btn danger {{deleting ? 'disabled' : ''}}" bindtap="confirmDelete" hover-class="models-press" role="button">{{deleting ? ui['正在保存…'] : ui['删除']}}</view>
    </view>
  </view>

  <!-- 添加模型提供商：版式与 DSH 客户端一致（内置目录 / 自定义 API + 获取可用模型） -->
  <view wx:if="{{providerSheetOpen}}" class="models-mask" bindtap="closeProviderSheet" catchtouchmove="noop"></view>
  <view wx:if="{{providerSheetOpen}}" class="models-sheet provider-sheet" catchtap="noop" role="dialog" aria-label="{{ui['添加模型提供商']}}">
    <view class="models-handle"></view>
    <view class="models-sheet-head">
      <view class="models-sheet-heading">
        <text class="models-sheet-title">{{ui['添加模型提供商']}}</text>
        <text class="models-sheet-subtitle">{{ui['提供商配置会写入 DSH 的 llm-pi-ai 设置。']}}</text>
      </view>
      <view class="models-sheet-close tap" bindtap="closeProviderSheet" hover-class="models-press" role="button" aria-label="{{ui['取消']}}">×</view>
    </view>
    <scroll-view class="models-sheet-body" scroll-y>
      <view wx:if="{{!supportsModelConfig}}" class="provider-notice">{{ui['当前网关暂不支持添加模型提供商：请重启 DSH 加载新版网关后重试。']}}</view>

      <view class="mode-tabs">
        <view class="mode-tab {{providerMode === 'catalog' ? 'on' : ''}}" data-mode="catalog" bindtap="setProviderMode" role="button">{{ui['第三方模型提供商']}}</view>
        <view class="mode-tab {{providerMode === 'custom' ? 'on' : ''}}" data-mode="custom" bindtap="setProviderMode" role="button">{{ui['自定义模型 API']}}</view>
      </view>

      <block wx:if="{{providerMode === 'catalog'}}">
        <view class="field">
          <text class="field-label">{{ui['提供商']}}</text>
          <input class="field-input" value="{{catalogQuery}}" bindinput="onCatalogQuery" placeholder="{{ui['搜索内置提供商']}}" placeholder-class="field-placeholder"/>
          <scroll-view class="catalog-list" scroll-y>
            <view wx:for="{{catalogVisible}}" wx:key="id" class="catalog-row {{providerDraft.providerId === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="selectCatalogProvider" role="button">
              <view class="catalog-radio">{{providerDraft.providerId === item.id ? '●' : ''}}</view>
              <view class="catalog-row-copy">
                <text class="catalog-name">{{item.name}}</text>
                <text class="catalog-id">{{item.id}}</text>
                <text wx:if="{{item.defaultBaseURL}}" class="catalog-url">{{item.defaultBaseURL}}</text>
              </view>
            </view>
            <view wx:if="{{!catalogVisible.length}}" class="discovery-empty">{{ui['没有匹配的提供商']}}</view>
          </scroll-view>
          <text wx:if="{{providerDraft.nativeAuthHint}}" class="field-hint">{{ui['原生认证环境变量：']}}{{providerDraft.nativeAuthHint}}</text>
        </view>
        <view class="field">
          <text class="field-label">{{ui['API Key（可选）']}}</text>
          <input class="field-input" password value="{{providerDraft.apiKey}}" data-field="apiKey" bindinput="onProviderDraftInput" placeholder="{{ui['留空则使用原生认证或环境变量']}}" placeholder-class="field-placeholder" maxlength="8192"/>
        </view>
      </block>

      <block wx:else>
        <view class="field">
          <text class="field-label">{{ui['Provider ID']}}</text>
          <input class="field-input field-mono" value="{{providerDraft.providerId}}" data-field="providerId" bindinput="onProviderDraftInput" placeholder="{{ui['唯一标识，例如 my-relay']}}" placeholder-class="field-placeholder" maxlength="64"/>
        </view>
        <view class="field">
          <text class="field-label">{{ui['显示名称（可选）']}}</text>
          <input class="field-input" value="{{providerDraft.displayName}}" data-field="displayName" bindinput="onProviderDraftInput" placeholder="{{ui['显示名称（可选）']}}" placeholder-class="field-placeholder" maxlength="200"/>
        </view>
        <view class="field">
          <text class="field-label">{{ui['API 协议']}}</text>
          <view class="protocol-chips">
            <view wx:for="{{providerProtocols}}" wx:key="id" class="protocol-chip {{providerDraft.api === item.id ? 'on' : ''}}" data-api="{{item.id}}" bindtap="pickProviderProtocol" role="button">{{item.label}}</view>
          </view>
        </view>
        <view class="field">
          <text class="field-label">{{ui['接口地址']}}</text>
          <input class="field-input field-mono" value="{{providerDraft.baseURL}}" data-field="baseURL" bindinput="onProviderDraftInput" placeholder="https://gateway.example/v1" placeholder-class="field-placeholder" maxlength="2048"/>
        </view>
        <view class="field">
          <text class="field-label">{{ui['API Key（可选）']}}</text>
          <input class="field-input" password value="{{providerDraft.apiKey}}" data-field="apiKey" bindinput="onProviderDraftInput" placeholder="{{ui['留空则使用原生认证或环境变量']}}" placeholder-class="field-placeholder" maxlength="8192"/>
        </view>
      </block>

      <view class="discovery-panel">
        <view class="discovery-head">
          <view class="discovery-copy">
            <text class="field-label">{{ui['自动获取模型']}}</text>
            <text class="field-hint">{{ui['从提供商端点读取可用模型，勾选后批量添加。']}}</text>
          </view>
          <view class="discovery-btn tap {{providerDiscovering || !supportsModelConfig ? 'disabled' : ''}}" bindtap="runProviderDiscovery" role="button">
            <view wx:if="{{providerDiscovering}}" class="mini-spinner"></view>
            <text>{{providerDiscovering ? ui['正在获取…'] : ui['获取可用模型']}}</text>
          </view>
        </view>
        <text wx:if="{{providerDiscoveryError}}" class="field-error">{{providerDiscoveryError}}</text>
        <block wx:if="{{providerDiscoveryResults.length}}">
          <input class="field-input discovery-search" value="{{providerDiscoveryQuery}}" bindinput="onProviderDiscoveryQuery" placeholder="{{ui['搜索模型']}}" placeholder-class="field-placeholder"/>
          <view class="discovery-toolbar">
            <text class="discovery-count">{{providerSelectedCount}}{{ui[' 个已选择']}}</text>
            <view class="discovery-all tap" bindtap="toggleProviderDiscoveryAll" role="button">{{ui['全选/取消全选']}}</view>
          </view>
          <scroll-view class="discovery-list" scroll-y>
            <view wx:for="{{providerDiscoveryVisible}}" wx:key="id" class="discovery-row {{item.selected ? 'on' : ''}}" data-id="{{item.id}}" bindtap="toggleProviderDiscovery" role="checkbox" aria-checked="{{item.selected}}">
              <view class="discovery-check">{{item.selected ? '✓' : ''}}</view>
              <view class="discovery-row-copy">
                <text class="discovery-name">{{item.name}}</text>
                <text class="discovery-id">{{item.id}}</text>
                <text wx:if="{{item.meta}}" class="discovery-meta">{{item.meta}}</text>
              </view>
            </view>
            <view wx:if="{{!providerDiscoveryVisible.length}}" class="discovery-empty">{{ui['没有匹配的模型']}}</view>
          </scroll-view>
        </block>
      </view>

      <text wx:if="{{providerError}}" class="field-error">{{providerError}}</text>
      <text class="field-hint">{{ui['至少选择一个模型；创建后可在本页继续增删。']}}</text>
    </scroll-view>
    <view class="models-sheet-actions">
      <view class="sheet-btn" bindtap="closeProviderSheet" hover-class="models-press" role="button">{{ui['取消']}}</view>
      <view class="sheet-btn primary {{providerBusy || !supportsModelConfig ? 'disabled' : ''}}" bindtap="createProvider" hover-class="models-press" role="button">{{providerBusy ? ui['正在保存…'] : ui['添加提供商']}}</view>
    </view>
  </view>
</view>
