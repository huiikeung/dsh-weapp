.settings {
  padding: 0 40rpx 80rpx;
  color: var(--text);
}

.chevron {
  color: var(--gray);
  font-size: 34rpx;
  margin-left: 12rpx;
}

.chevron-img {
  width: 26rpx;
  height: 26rpx;
  margin-left: 12rpx;
  opacity: 0.55;
}

.gw-url {
  font-size: 28rpx;
  color: var(--ink);
  word-break: break-all;
}

.gw-status {
  display: flex;
  align-items: center;
}

.gw-cwd {
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exp-copy {
  display: flex;
  flex-direction: column;
  margin-right: 24rpx;
  flex: 1;
}

.exp-desc {
  font-size: 24rpx;
  color: var(--gray);
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ---------- 独立管理入口与面板 ---------- */
.management-entry {
  gap: 20rpx;
  min-height: 112rpx;
}

.management-entry-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.management-entry-desc {
  margin-top: 6rpx;
  color: var(--text-2);
  font-size: 23rpx;
  line-height: 1.5;
}

.management-entry-value {
  flex: none;
  white-space: nowrap;
}

.management-entry-value .chevron-img {
  flex: none;
}

.management-entry-active {
  background: var(--fill);
}

.management-sheet {
  display: flex;
  flex-direction: column;
  max-height: 85vh;
}

.management-sheet .pair-sheet-head {
  flex-shrink: 0;
  gap: 16rpx;
}

.management-sheet .pair-sheet-head > view { flex: 1; min-width: 0; }
.management-sheet .pair-sheet-subtitle { overflow-wrap: anywhere; word-break: break-all; }
.management-sheet .pair-sheet-close { flex-shrink: 0; min-height: 64rpx; }
.node-detail-chevron { width: 24rpx; height: 24rpx; flex: none; opacity: .55; }
.gateway-detail-card { margin: 0; }
.gateway-identity-row { gap: 16rpx; }
.gateway-identity-label { flex: none; color: var(--text-2); font-size: 25rpx; }
.gateway-identity-value { flex: 1; min-width: 0; color: var(--text); font-size: 25rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gateway-copy { flex: none; padding: 20rpx 0 20rpx 8rpx; }
.gateway-status-row { gap: 16rpx; flex-wrap: wrap; }
.gateway-status-row .card-row-value { flex: none; }
.gateway-detail-card .gw-url { min-width: 0; overflow-wrap: anywhere; }
.gateway-detail-card .gateway-action { display: flex; align-items: center; justify-content: flex-start; width: 100%; margin: 0; padding: 30rpx 32rpx; box-sizing: border-box; min-height: 88rpx; border-radius: 0; background: transparent; text-align: left; font-size: 28rpx; font-weight: normal; line-height: 1.5; color: var(--text); }
.gateway-action::after { border: 0; }
.gateway-action[disabled] { background: transparent; opacity: .45; }

.management-scroll {
  min-height: 0;
  max-height: 65vh;
}

.public-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  min-height: 52rpx;
}

.public-detail-label {
  flex: none;
  font-size: 25rpx;
  color: var(--text-2);
}

.public-detail-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  word-break: break-all;
  font-size: 24rpx;
  color: var(--text);
}

.public-copy-id {
  flex: none;
  padding: 10rpx 0;
  color: var(--ocean);
  font-size: 24rpx;
}

.node-group-title {
  margin-bottom: 20rpx;
}

.row-desc {
  display: block;
  margin-top: 4rpx;
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 400;
}

.node-head-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.node-edit-toggle {
  color: var(--ocean);
  font-size: 26rpx;
  padding: 6rpx 4rpx;
}

.node-delete-inline {
  color: #E5533C;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(229, 83, 60, 0.10);
  border: 1rpx solid rgba(229, 83, 60, 0.38);
}

.node-select {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}

.node-select-ic {
  width: 40rpx;
  height: 40rpx;
}

.node-refresh {
  padding: 8rpx 0 8rpx 20rpx;
  color: var(--ocean);
  font-size: 25rpx;
}

.node-pair-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}

.node-pair-button {
  flex: 1 1 230rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0;
  padding: 22rpx 16rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 1rpx solid rgba(76, 108, 224, 0.42);
  color: #4C6CE0;
  font-size: 27rpx;
  line-height: 1.5;
}

.node-add-plus {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
}

.node-add-text {
  line-height: 1.4;
}

.node-pair-button.secondary {
  background: var(--fill);
  color: var(--ocean);
}

.node-pair-button::after,
.public-share::after {
  border: 0;
}

.node-row:first-child {
  border-top: 0;
}

/* ---------- 公网访问详情 ---------- */
.public-card {
  padding: 28rpx 28rpx 24rpx;
}

.public-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

/* 图标不带底色：直接使用路由器/信号图形 */
.public-icon {
  flex: none;
  width: 88rpx;
  height: 88rpx;
}

.public-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.public-title {
  color: var(--text);
  font-size: 30rpx;
  font-weight: 600;
}

.public-sub {
  margin-top: 6rpx;
  color: var(--text-2);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.public-pill {
  flex: none;
