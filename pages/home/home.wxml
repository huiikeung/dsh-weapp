<view class="page page-dark home-root">
  <!-- 侧边栏（对齐 dsh-mobile WorkspaceView drawerContent：品牌字标 + 插件 / 定时任务） -->
  <view
    class="drawer {{drawerAnim && !drawerDragging ? 'drawer-anim' : ''}} {{drawerOpen || drawerDragging ? 'drawer-visible' : ''}} {{sheetTheme === 'dark' ? 'drawer-dark' : ''}}"
    style="width: {{drawerW}}px; transform: translateX({{drawerX}}px);"
    catchtouchmove="onDrawerTouchMove"
    bindtouchstart="onDrawerTouchStart"
    bindtouchend="onDrawerTouchEnd"
    bindtouchcancel="onDrawerTouchEnd"
  >
    <view class="drawer-body" style="padding-top: {{drawerTopPad}}px;">
      <view class="drawer-brand">
        <image class="drawer-whale drawer-whale-light" src="/assets/icons/whale-ink.png" mode="aspectFit"/>
        <image class="drawer-whale drawer-whale-dark" src="/assets/icons/whale-white.png" mode="aspectFit"/>
        <view class="drawer-brand-text">whaletail</view>
        <view class="drawer-brand-badge">HARNESS</view>
      </view>
      <view class="drawer-item" hover-class="drawer-item-active" bindtap="openPlugins">
        <image class="drawer-item-ic" src="/assets/icons/pinwheel-ink.png"/>
        <image class="drawer-item-ic drawer-item-ic-dark" src="/assets/icons/pinwheel-white.png"/>
        <text class="drawer-item-text">插件</text>
      </view>
      <view class="drawer-item" hover-class="drawer-item-active" bindtap="openScheduledTasks">
        <image class="drawer-item-ic drawer-item-ic-clock" src="/assets/icons/clock-dark.png"/>
        <image class="drawer-item-ic drawer-item-ic-clock drawer-item-ic-dark" src="/assets/icons/clock-white.png"/>
        <text class="drawer-item-text">定时任务</text>
      </view>
      <view class="drawer-footer">
        <view class="drawer-item drawer-settings" hover-class="drawer-item-active" bindtap="openSettings" role="button" aria-label="设置">
          <image class="drawer-item-ic" src="/assets/icons/settings-ink.svg" mode="aspectFit"/>
          <image class="drawer-item-ic drawer-item-ic-dark" src="/assets/icons/settings-white.svg" mode="aspectFit"/>
          <text class="drawer-item-text">设置</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 主内容：抽屉打开时右移 + 圆角 + 阴影（对齐 iOS workspaceContent） -->
  <view
    class="home-content-wrap {{contentShifted ? 'shifted' : ''}} {{drawerAnim && !drawerDragging ? 'drawer-anim' : ''}}"
    style="transform: {{contentX ? 'translateX(' + contentX + 'px)' : 'none'}};"
    bindtouchstart="onContentTouchStart"
    bindtouchend="onContentTouchEnd"
  >
    <!-- 深海背景随内容一起位移（对齐 iOS DeepOceanBackground 在 workspaceContent 内） -->
    <view class="deep-bg home-deep-bg"><ocean-background id="home-ocean" active="{{oceanActive}}" reduced-motion="{{oceanReducedMotion}}" /></view>

    <!-- 顶部品牌行：与右上角胶囊同行（导航区内固定，不随内容滚动），左边距对齐内容区 -->
    <view class="topbar" style="top: {{topbarTop}}px; height: {{topbarHeight}}px;">
      <view class="brand-row tap" hover-class="brand-dim" bindtap="openDrawer">
        <image class="brand-whale" src="/assets/icons/whale-white.png" mode="aspectFit"/>
        <view class="brand-text">whaletail</view>
        <view class="brand-badge">HARNESS</view>
      </view>
    </view>

    <scroll-view class="home-scroll" scroll-y="{{!workspacePickerOpen}}" show-scrollbar="{{false}}">
    <view class="home" style="padding-top: {{homePadTop}}px;">

      <!-- 配对菜单遮罩：点击空白处关闭（留在 wrap 内保证与 pair-menu 同层叠上下文） -->
      <view
        wx:if="{{pairMenuVisible}}"
        class="pair-menu-mask"
        catchtap="closePairMenu"
        catchtouchmove="noop"
      ></view>

      <!-- 主机切换行：选择主机（左） + 配对/设置（右，与下文右边距对齐） -->
      <view class="host-row">
        <view class="host-bar glass-press" bindtap="openHostSwitcher">
          <image class="host-kind" src="/assets/icons/{{hostKindIcon}}"/>
          <view class="host-name">{{hostLabel}}</view>
          <view class="host-dot {{hostOnline ? 'on' : ''}}"></view>
          <image class="host-chev" src="/assets/icons/chev-down-white.png"/>
        </view>
        <view class="host-actions">
          <view class="pair-wrap">
            <view class="icon-btn glass-press" catchtap="togglePairMenu" role="button" aria-label="设备配置">
              <image class="icon-img pair-ic" src="/assets/icons/person-key-white.svg" mode="aspectFit"/>
            </view>
            <!-- 对齐 dsh-mobile GatewayAuthenticationMenu：点击弹出两个配对选项 -->
            <view wx:if="{{pairMenuVisible}}" class="pair-menu">
              <view class="pair-menu-item" hover-class="pair-menu-item-active" catchtap="pairByScan">
                <view class="pair-menu-ic" aria-hidden="true">
                  <view class="ico-scan">
                    <view class="corner tl"></view><view class="corner tr"></view>
                    <view class="corner bl"></view><view class="corner br"></view>
                    <view class="find a"></view><view class="find b"></view><view class="find c"></view>
                    <view class="dots"><view></view><view></view><view></view><view></view></view>
                  </view>
                </view>
                <text>扫描二维码</text>
              </view>
              <view class="pair-menu-item" hover-class="pair-menu-item-active" catchtap="pairByManual">
                <view class="pair-menu-ic" aria-hidden="true">
                  <view class="ico-keyboard">
                    <view class="kb-row"><view></view><view></view><view></view><view></view><view></view></view>
                    <view class="kb-row"><view></view><view></view><view></view><view></view><view></view></view>
                    <view class="kb-row kb-last"><view></view><view class="kb-bar"></view><view></view></view>
                  </view>
                </view>
                <text>手动输入配对信息</text>
              </view>
              <view class="pair-menu-item" hover-class="pair-menu-item-active" catchtap="openPairGuide" role="button" aria-label="配置引导">
                <view class="pair-menu-ic" aria-hidden="true">
                  <image class="pair-guide-icon" src="/assets/icons/setup-guide-white.svg" mode="aspectFit"/>
                </view>
                <text>配置引导</text>
              </view>
            </view>
          </view>
          <view class="icon-btn glass-press" catchtap="openSessionSettings" role="button" aria-label="会话设置">
            <image class="icon-img" src="/assets/icons/sliders-white.svg" mode="aspectFit"/>
          </view>
        </view>
      </view>

      <view class="hero">
        <view class="title-hero">探索未至之境</view>
        <view wx:if="{{connectionClass === 'connected'}}" class="subtitle-hero">已连接 whaletail Harness 预览版</view>
      </view>

      <!-- 工作区选择器 -->
      <view class="workspace-card glass glass-press {{workspacePickerOpen ? 'workspace-card-menu-open' : ''}}" bindtap="openWorkspacePicker" role="button" aria-label="选择工作区" aria-hidden="{{workspacePickerOpen}}">
        <image class="ws-icon" src="/assets/icons/workspace-folder-blue.svg" mode="aspectFit"/>
        <view class="ws-body">
          <view class="ws-title">{{currentWorkspace.title || '未选择工作区'}}</view>
          <view class="ws-path text-mono">{{currentWorkspace.path || '轻触以切换工作区'}}</view>
        </view>
        <view class="ws-right">
          <view class="status-dot {{connectionClass}}"></view>
          <image class="ws-chevron" src="/assets/icons/chev-down-white.png"/>
        </view>
      </view>

      <!-- 新建会话 -->
      <view class="new-session glass-press" bindtap="newSession">
        <view class="plus-circle"><image class="plus-img" src="/assets/icons/plus-white.png"/></view>
        <text class="new-session-text">新建会话</text>
      </view>

      <!-- 最近会话 -->
      <view class="recent-header">
        <view class="section-title">最近会话</view>
        <view class="conn-label {{connectionClass}}">{{connectionLabel}}</view>
      </view>

      <view class="search-box glass">
        <image class="search-icon" src="/assets/icons/search-white.png"/>
        <input
          class="search-input"
          placeholder="搜索会话内容"
          placeholder-class="field-placeholder"
          value="{{searchQuery}}"
          bindinput="onSearchInput"
          confirm-type="search"
        />
      </view>

      <view wx:if="{{homeDataHint}}" class="home-data-hint">{{homeDataHint}}</view>

      <view class="session-list">
        <block wx:for="{{displaySessions}}" wx:key="sessionId">
          <view
            class="session-row glass-press"
            bindtap="openSession"
            data-id="{{item.sessionId}}"
            data-title="{{item.displayTitle}}"
            data-preset="{{item.agentPreset}}"
            bindlongpress="sessionActions"
            data-index="{{index}}"
          >
            <image wx:if="{{item.searchIcon}}" class="search-result-ic" src="/assets/icons/{{item.searchIcon}}"/>
            <view class="session-dot {{item.running ? 'running' : (item.hasUnread ? 'unread' : '')}}"></view>
            <view class="session-body">
              <view class="session-title">{{item.displayTitle}}</view>
              <view class="session-sub text-mono">{{item.idLabel}}</view>
            </view>
            <view class="session-time {{item.running ? 'running' : ''}}">{{item.running ? '运行中' : item.timeLabel}}</view>
          </view>
        </block>
        <view wx:if="{{!displaySessions.length}}" class="empty">{{emptySessionsText}}</view>
      </view>
    </view>
    </scroll-view>
  </view>

  <!-- 抽屉遮罩：压暗主内容，点击关闭（对齐 iOS dim + tap-to-close） -->
  <view
    wx:if="{{drawerOpen || drawerDragging}}"
    class="drawer-mask {{drawerAnim && !drawerDragging ? 'drawer-anim' : ''}}"
    style="opacity: {{maskOpacity}};"
    catchtap="closeDrawer"
    catchtouchmove="noop"
  ></view>

  <!-- 切换主机 sheet（GatewaySwitcherSheet 对齐） -->
  <view wx:if="{{hostSheetOpen}}" class="host-mask" bindtap="closeHostSwitcher"></view>
  <view wx:if="{{hostSheetOpen}}" class="host-sheet {{hostSheetExpanded ? 'expanded' : ''}}">
    <view class="sheet-grabber-zone"
      catchtouchstart="onHostSheetGrabStart"
      catchtouchmove="onHostSheetGrabMove"
      catchtouchend="onHostSheetGrabEnd">
      <view class="sheet-grabber"></view>
    </view>
    <view class="host-sheet-head">
      <view class="host-sheet-left">
        <view class="host-sheet-edit tap" bindtap="toggleHostEditMode">{{hostEditMode ? '完成' : '编辑'}}</view>
      </view>
      <view class="host-sheet-title">切换主机</view>
      <view class="host-sheet-right">
        <view wx:if="{{hostEditMode && hostSelection.length}}" class="host-sheet-del tap" bindtap="deleteHosts">{{hostSelection.length > 1 ? '批量删除' : '删除'}}</view>
      </view>
    </view>
    <view class="host-section-label">我的主机</view>
    <view class="host-list">
      <view class="host-group">
        <view wx:for="{{hostRows}}" wx:key="id" class="host-opt">
          <view wx:if="{{hostEditMode}}" class="host-select tap" catchtap="toggleHostSelect" data-id="{{item.id}}">
            <image class="host-select-ic" src="/assets/icons/{{item.selected ? 'circle-filled-white.png' : 'circle-white.png'}}"/>
          </view>
          <image class="host-row-kind" src="/assets/icons/{{item.kindIcon}}"/>
          <view class="host-row-body tap" bindtap="pickHost" data-id="{{item.id}}">
            <view class="host-row-name">{{item.displayName}}</view>
            <view class="host-row-sub {{item.isActive ? 'on' : ''}}">{{item.subLabel}}</view>
          </view>
          <view class="host-dot {{item.online ? 'on' : ''}}"></view>
          <view wx:if="{{hostEditMode}}" class="host-edit tap" catchtap="editHostOpen" data-id="{{item.id}}">
            <image class="host-edit-ic" src="/assets/icons/pencil-white.png"/>
          </view>
        </view>
        <view wx:if="{{!hostRows.length}}" class="host-empty">暂无已保存的主机，请扫码添加</view>
      </view>
    </view>
  </view>

  <!-- 编辑主机 -->
  <view wx:if="{{hostEditOpen}}" class="host-mask" bindtap="cancelHostEdit"></view>
  <view wx:if="{{hostEditOpen}}" class="host-edit-panel">
    <view class="host-edit-title">编辑主机</view>
    <view class="host-edit-hint">留空使用网关提供的名称：{{editingGatewayName}}</view>
    <input class="host-edit-input" placeholder="主机别名（留空使用网关名称）" placeholder-class="host-edit-ph" value="{{editAlias}}" bindinput="onHostAliasInput" maxlength="80"/>
    <view class="host-edit-sub">设备类型</view>
    <view class="host-kind-row">
      <view class="host-kind-opt {{editKind === 'desktopcomputer' ? 'on' : ''}} tap" bindtap="setHostKind" data-kind="desktopcomputer">电脑</view>
      <view class="host-kind-opt {{editKind === 'server.rack' ? 'on' : ''}} tap" bindtap="setHostKind" data-kind="server.rack">服务器</view>
    </view>
    <view class="host-edit-actions">
      <view class="host-edit-btn-cancel tap" bindtap="cancelHostEdit">取消</view>
      <view class="host-edit-btn-save tap" bindtap="saveHostEdit">保存</view>
    </view>
  </view>

  <!-- 工作区选择：卡片锚点弹窗（对齐 iOS workspaceCard 的 Menu） -->
  <view wx:if="{{workspacePickerOpen}}" class="ws-pop-mask" catchtap="closeWorkspacePicker" catchtouchmove="noop"></view>
  <view
    wx:if="{{workspacePickerOpen}}"
    class="ws-pop"
    style="left: {{popLeft}}px; top: {{popTop}}px; width: {{popWidth}}px; height: {{popHeight}}px; transform-origin: 50% {{popOriginY}}px;"
    catchtap="noop"
    role="dialog" aria-label="选择工作区"
  >
    <scroll-view class="ws-pop-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="ws-pop-content">
    <view class="ws-pop-row" hover-class="ws-pop-row-pressed" bindtap="selectUngrouped" role="button" aria-label="未分组">
      <image class="ws-pop-ic" src="/assets/icons/{{currentWorkspace.ungrouped ? 'check-fill-ink.png' : 'tray-ink.png'}}" mode="aspectFit"/>
      <text class="ws-pop-label">未分组</text>
    </view>
    <view wx:if="{{pickerWorkspaces.length}}" class="ws-pop-divider"></view>
    <block wx:for="{{pickerWorkspaces}}" wx:key="workspaceId">
      <view class="ws-pop-row" hover-class="ws-pop-row-pressed" bindtap="selectWorkspace" data-id="{{item.workspaceId}}" role="button" aria-label="{{item.title}}">
        <image class="ws-pop-ic" src="/assets/icons/{{item.workspaceId === currentWorkspaceId ? 'check-fill-ink.png' : 'folder-ink.png'}}" mode="aspectFit"/>
        <text class="ws-pop-label">{{item.title}}</text>
      </view>
    </block>
    <view class="ws-pop-divider"></view>
    <view class="ws-pop-row" hover-class="ws-pop-row-pressed" bindtap="openDirSheet" role="button" aria-label="添加工作区">
      <image class="ws-pop-ic" src="/assets/icons/plus-ink.png" mode="aspectFit"/>
      <text class="ws-pop-label">添加工作区</text>
    </view>
    </view>
    </scroll-view>
  </view>

  <!-- 目录浏览器弹层（对齐 dsh-mobile v1.6.0 WorkspaceDirectoryBrowserSheet） -->
  <view wx:if="{{dirSheetOpen}}" class="host-mask" bindtap="closeDirSheet"></view>
  <view wx:if="{{dirSheetOpen}}" class="dir-sheet">
    <view class="dir-sheet-handle"></view>
    <!-- 头部：新建文件夹 / 标题 / 取消 -->
    <view class="dir-head">
      <view class="dir-head-btn tap {{dirLoading || dirCreatingWs || dirCreatingDir ? 'disabled' : ''}}" bindtap="newDirectory">
        <image class="dir-head-folder" src="/assets/icons/ic-dir-folder-white.png"/>
        <view class="dir-head-badge"><text>+</text></view>
      </view>
      <text class="dir-head-title">选择工作区目录</text>
      <view class="dir-head-cancel tap" bindtap="closeDirSheet">取消</view>
    </view>
    <!-- 当前目录 -->
    <view class="dir-cwd">
      <text class="dir-cwd-label">当前目录</text>
      <text class="dir-cwd-path text-mono">{{dirPath || '正在读取…'}}</text>
    </view>
    <!-- 目录列表 -->
    <view class="dir-list-card">
      <scroll-view class="dir-list" scroll-y>
        <view wx:if="{{dirLoading && !dirEntries.length}}" class="dir-loading">
          <view class="dir-spinner"></view>
          <text>正在读取远程目录…</text>
        </view>
        <block wx:else>
          <view
            class="dir-row {{parentPath ? '' : 'disabled'}}"
            hover-class="dir-row-hover"
            bindtap="goParentDir"
          >
            <view class="dir-row-icon"><image class="dir-row-ic" src="/assets/icons/ic-dir-parent-ocean.png"/></view>
            <view class="dir-row-body">
              <text class="dir-row-name">..</text>
              <text class="dir-row-sub">返回上一级</text>
            </view>
            <image class="dir-row-chev" src="/assets/icons/ic-dir-chevron-mist.png"/>
          </view>
          <view class="dir-divider"></view>
          <block wx:for="{{dirEntries}}" wx:key="path">
            <view class="dir-row {{item.highlight ? 'highlight' : ''}}" hover-class="dir-row-hover" bindtap="openDirEntry" data-index="{{index}}">
              <view class="dir-row-icon">
                <image class="dir-row-ic" src="/assets/icons/ic-dir-folder-blue.png"/>
                <image wx:if="{{item.hidden}}" class="dir-row-badge" src="/assets/icons/ic-dir-badge-question.png"/>
              </view>
              <view class="dir-row-body">
                <text class="dir-row-name">{{item.name}}</text>
                <text wx:if="{{item.hidden}}" class="dir-row-sub">隐藏目录</text>
              </view>
              <image class="dir-row-chev" src="/assets/icons/ic-dir-chevron-mist.png"/>
            </view>
            <view wx:if="{{index < dirEntries.length - 1}}" class="dir-divider"></view>
          </block>
        </block>
      </scroll-view>
    </view>
    <!-- 底部创建栏 -->
    <view class="dir-create-bar">
      <text wx:if="{{dirPath}}" class="dir-create-path text-mono">{{dirPath}}</text>
      <view class="dir-create-btn {{dirPath && !dirCreatingWs && !dirCreatingDir && !dirLoading ? '' : 'disabled'}}" bindtap="createWorkspaceHere">
        <view wx:if="{{dirCreatingWs}}" class="dir-spinner light"></view>
        <image wx:else class="dir-create-add" src="/assets/icons/ic-dir-add-white.png"/>
        <text>在当前目录创建工作区</text>
      </view>
      <view wx:if="{{dirCreatingDir}}" class="dir-creating-hint">
        <view class="dir-spinner small"></view>
        <text>正在创建文件夹…</text>
      </view>
    </view>
  </view>

  <!-- 手动配对弹层（对齐 dsh-mobile v1.6.0 ManualGatewayPairingSheet） -->
  <view wx:if="{{manualSheetOpen}}" class="host-mask" bindtap="closeManualSheet"></view>
  <view wx:if="{{manualSheetOpen}}" class="manual-sheet {{manualSheetExpanded ? 'expanded' : ''}}">
    <view class="sheet-grabber-zone"
      catchtouchstart="onManualSheetGrabStart"
      catchtouchmove="onManualSheetGrabMove"
      catchtouchend="onManualSheetGrabEnd">
      <view class="sheet-grabber"></view>
    </view>
    <view class="manual-sheet-head">
      <text class="manual-sheet-title">设备认证</text>
      <view class="manual-sheet-done tap" bindtap="closeManualSheet">完成</view>
    </view>
    <scroll-view class="manual-sheet-body" scroll-y>
      <view class="manual-sec-title">手动输入配对信息</view>
      <view class="manual-sec-desc">粘贴 Harness WebUI 提供的 Base64URL 配对字符串。长期设备 token 只会安全保存在本机。</view>
      <textarea
        class="manual-input text-mono"
        value="{{pairingText}}"
        bindinput="onPairingTextInput"
        placeholder="粘贴 Base64URL 配对字符串或完整配对信息"
        placeholder-class="manual-input-ph"
        maxlength="-1"
      />
      <view wx:if="{{pairingResult}}" class="manual-result {{pairingResultClass}}">{{pairingResult}}</view>
      <view class="manual-connect {{pairingText && !pairingConnecting ? '' : 'disabled'}}" bindtap="connectManualPairing">
        <view wx:if="{{pairingConnecting}}" class="dir-spinner light small-spin"></view>
        <image wx:else class="manual-connect-ic" src="/assets/icons/ic-link-white.png"/>
        <text>{{pairingConnecting ? '连接中…' : '连接'}}</text>
      </view>
    </scroll-view>
  </view>
</view>
