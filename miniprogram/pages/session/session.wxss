.fleet-sort-menu { position: absolute; top: calc(100% + 8rpx); right: 0; z-index: 21; width: 100%; min-width: 240rpx; box-sizing: border-box; overflow: hidden; border: 1rpx solid var(--border); border-radius: 16rpx; background: var(--surface); box-shadow: 0 14rpx 36rpx rgba(0, 0, 0, .18); }
.fleet-sort-option { min-height: 72rpx; box-sizing: border-box; display: flex; align-items: center; gap: 16rpx; padding: 0 18rpx; border-top: 1rpx solid var(--divider); color: var(--text-2); font-size: 23rpx; }
.fleet-sort-option:first-child { border-top: 0; }
.fleet-sort-option.selected { border-radius: 14rpx; background: rgba(46, 107, 230, .08); color: var(--ocean); font-weight: 600; }
.fleet-sort-option-check { margin-left: auto; font-size: 28rpx; font-weight: 700; }
.fleet-member { gap: 8rpx; padding: 18rpx 18rpx 16rpx; border-radius: 18rpx; background: transparent; border: 1rpx solid var(--border); border-top-width: 4rpx; transition: box-shadow .18s ease, border-color .18s ease, transform .18s ease; }
.fleet-member.selected { box-shadow: 0 0 0 3rpx rgba(46,107,230,.24), 0 6rpx 18rpx rgba(7,24,43,.08); transform: translateY(-1rpx); }
.fleet-member-head { gap: 10rpx; }
.fleet-member-icon { width: 44rpx; height: 44rpx; border-radius: 14rpx; }
.fleet-member-ic { width: 24rpx; height: 24rpx; }
.fleet-member-name { font-size: 25rpx; }
.fleet-member-role { padding: 4rpx 12rpx; border-radius: 999rpx; }
.fleet-member-status { gap: 12rpx; font-size: 22rpx; }
.fleet-member-model { min-width: 0; flex: 1; text-align: right; }
.fleet-member-meta { font-size: 20rpx; }
.fleet-member-answer { display: flex; align-items: baseline; gap: 8rpx; min-width: 0; color: var(--text-3); font-size: 20rpx; line-height: 1.35; }
.fleet-member-answer-label { flex: none; color: var(--text-4); }
.fleet-member-answer-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-style: italic; }
.fleet-member-foot { min-height: 52rpx; margin-top: 2rpx; padding-top: 8rpx; border-top: 1rpx solid var(--divider); }
.fleet-member-tasks { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 12rpx; border-radius: 999rpx; background: transparent; }
.fleet-member-tasks.on { background: rgba(46,107,230,.08); }
.fleet-comms-toolbar { flex-wrap: wrap; gap: 10rpx; margin-bottom: 14rpx; }
.fleet-comms-btn,
.fleet-comms-chip { min-height: 48rpx; box-sizing: border-box; display: inline-flex; align-items: center; padding: 4rpx 16rpx; border-radius: 999rpx; }
.fleet-comms-btn { font-weight: 600; }
.fleet-comms-lane { max-height: 800rpx; padding: 0 4rpx; }
.fleet-comms-row { padding: 14rpx 8rpx 14rpx 22rpx; }
.fleet-comms-line { flex-wrap: wrap; gap: 6rpx 10rpx; }
.fleet-comms-route { flex-basis: 100%; }
.fleet-comms-text { margin-top: 8rpx; font-size: 22rpx; }
.fleet-task-card { padding: 22rpx; border-radius: 24rpx; }
.fleet-task-card .ctx-card-head { align-items: center; margin-bottom: 12rpx; }
.fleet-task-search{width:100%;background:transparent;}
.fleet-task-gran{margin:14rpx 0 16rpx;}
.fleet-task-icon { position: relative; flex: none; width: 36rpx; height: 36rpx; margin-top: 2rpx; }
.fleet-task-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.fleet-task-line { display: flex; align-items: baseline; gap: 10rpx; min-width: 0; }
.fleet-task-line .fleet-task-subject { flex: 1; min-width: 0; }
.fleet-task-line .fleet-task-status { flex: none; }
.fleet-task-body { font-size: 23rpx; line-height: 1.5; color: var(--text-3); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.fleet-task-foot { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.fleet-task-meta { font-size: 22rpx; color: var(--text-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
.fleet-task-row { display: flex; align-items: flex-start; gap: 10rpx; padding: 12rpx 10rpx; border: 1rpx solid var(--divider); border-radius: 14rpx; background: transparent; }
.fleet-task-row + .fleet-task-row { margin-top: 8rpx; }
.fleet-task-status { padding: 2rpx 10rpx; border-radius: 999rpx; font-size: 19rpx; }
.fleet-task-subject { white-space: normal; line-height: 1.4; overflow-wrap: anywhere; }
.fleet-task-owner { max-width: 140rpx; padding-left: 8rpx; }
.fleet-task-empty { padding: 24rpx 12rpx; border-radius: 14rpx; background: transparent; }
@media (min-width: 620px) {
.fleet-member-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.fleet-member-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; }
.fleet-member-toolbar .ctx-br-search { width: auto; flex: 1 1 100%; }
.fleet-member-toolbar .ctx-gran { width: auto; flex: 1 1 0; }
}
@media (max-width: 350px) {
.fleet-scroll { padding-left: 20rpx; padding-right: 20rpx; }
.fleet-summary .fleet-chip { padding-right: 10rpx; padding-left: 10rpx; font-size: 19rpx; }
.fleet-member-toolbar .ctx-gran-btn { font-size: 18rpx; }
}
@media (prefers-reduced-motion: reduce) {
.fleet-state-dot.on { animation: none; }
.fleet-member { transition: none; }
}
@media (min-width: 860px) {
.fleet-summary { align-items: center; }
.fleet-progress { flex-basis: auto; min-width: 320rpx; margin-left: auto; }
.fleet-workspace { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); align-items: stretch; gap: 18rpx; }
.fleet-graph-card { display: flex; flex-direction: column; min-width: 0; }
.fleet-stage { flex: 1 1 auto; height: 0; min-height: 320rpx; max-height: none; }
.fleet-stage.all { height: auto; }
.fleet-board-column { display: flex; flex-direction: column; gap: 18rpx; min-width: 0; }
.fleet-board-column > .ctx-card,
.fleet-board-column > .fleet-card { margin-top: 0; }
.fleet-member-toolbar { display: grid; grid-template-columns: minmax(160rpx, 1fr) minmax(300rpx, auto) auto; align-items: center; }
.fleet-member-toolbar .ctx-br-search { width: 100%; min-width: 0; }
.fleet-member-toolbar .ctx-gran { width: auto; min-width: 0; }
.fleet-member-toolbar .fleet-member-sort { width: auto; min-width: 240rpx; }
.fleet-task-card { display: grid; grid-template-columns: minmax(160rpx, 1fr) auto; align-items: center; max-height: 1120rpx; overflow: hidden; }
.fleet-task-card .ctx-card-head,
.fleet-task-list { grid-column: 1 / -1; }
.fleet-task-search { width: 100%; min-width: 0; box-sizing: border-box; }
.fleet-task-gran { margin: 0 0 0 12rpx; }
.fleet-task-list { min-height: 0; overflow-y: auto; }
.fleet-comms { display: flex; flex-direction: column; max-height: 960rpx; overflow: hidden; }
.fleet-comms-lane { flex: 1 1 auto; min-height: 0; max-height: none; overflow-y: auto; }
}
.fleet-node-state,
.fleet-member-dot,
.fleet-task-dot { position: relative; display: inline-block; flex: none; width: 18rpx; height: 18rpx; box-sizing: border-box; border-radius: 50%; background: transparent; }
.fleet-node-state { margin-top: 5rpx; }
.fleet-member-dot { margin-left: 2rpx; }
.fleet-node-state::after,
.fleet-member-dot::after,
.fleet-task-dot::after { content: ''; position: absolute; inset: 20%; border-radius: 50%; background: var(--text-4); }
.fleet-node-state.done::after,
.fleet-member-dot.done::after,
.fleet-task-dot.done::after { background: var(--success); }
.fleet-node-state.idle::after,
.fleet-member-dot.idle::after,
.fleet-task-dot.idle::after { background: var(--text-4); }
.fleet-node-state.failed::after,
.fleet-member-dot.failed::after,
.fleet-task-dot.failed::after { background: #c44848; }
.fleet-member-dot.warning::after,
.fleet-task-dot.warning::after { background: #e07a1f; }
.fleet-node-state.running,
.fleet-member-dot.running,
.fleet-task-dot.running { border: 0; background: transparent; animation: none; }
.fleet-node-state.running::before,
.fleet-member-dot.running::before,
.fleet-task-dot.running::before { content: ''; position: absolute; inset: 0; border: 1rpx solid var(--text-3); border-radius: 50%; opacity: .25; }
.fleet-node-state.running::after,
.fleet-member-dot.running::after,
.fleet-task-dot.running::after { inset: 0; border: 1rpx solid transparent; border-top-color: var(--text-3); border-radius: 50%; background: transparent; animation: fleet-spin 1.5s linear infinite; }
.fleet-member-dot.done,
.fleet-task-dot.done { background: transparent; }
.fleet-task-icon { width: 44rpx; height: 44rpx; margin-top: 0; }
.fleet-task-row { align-items: flex-start; }
.fleet-task-main { min-width: 0; }
.fleet-task-line { align-items: flex-start; }
.fleet-task-subject { font-size: 24rpx; font-weight: 600; }
.fleet-task-foot { margin-top: 2rpx; }
.fleet-comms-lane { max-height: 960rpx; }
.fleet-comms-route { flex: 1; min-width: 120rpx; flex-basis: auto; }
.fleet-comms-text { margin-top: 4rpx; }
.ctx-card.fleet-graph-card { background: transparent; border: 1rpx solid var(--border); box-shadow: none; }
.fleet-graph-card .fleet-stage { border: 0; border-radius: 0; background: transparent; }
.composer-input-row.live { position: relative; display: block; }
.composer-input-row.live.previewing { min-height: 76rpx; max-height: 60vh; }
.composer-live .composer-veil { display: none; }
.composer-live .composer-veil.on {
display: block; position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 6;
background: var(--surface); overflow-y: auto;
font-size: 28rpx; line-height: 1.4; color: var(--text);
padding: 2rpx 4rpx; box-sizing: border-box;
}
.composer-veil-inner { font-size: 28rpx; line-height: 1.4; color: var(--text); overflow-wrap: anywhere; }
.composer-veil-end { height: 10rpx; }
.composer-live-edit { position: absolute; right: 10rpx; top: 8rpx; z-index: 3; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: var(--surface); border: 1rpx solid var(--divider); box-shadow: 0 2rpx 8rpx rgba(7, 24, 43, .12); }
.composer-live-edit-ic { width: 26rpx; height: 26rpx; opacity: .85; }
.composer-veil-inner, .composer-veil-inner rich-text { font-size: 28rpx; line-height: 1.4; }
.composer-veil-inner .md-block { margin: 0; }
.composer-veil-inner .md-list { margin: 0; }
.composer-veil-inner .md-li { font-size: 28rpx; line-height: 1.4; }
.composer-veil-inner .md-para,
.composer-veil-inner .md-li-text,
.composer-veil-inner .md-h1, .composer-veil-inner .md-h2,
.composer-veil-inner .md-h3, .composer-veil-inner .md-h4,
.composer-veil-inner .md-h5, .composer-veil-inner .md-h6,
.composer-veil-inner .md-heading { font-size: 28rpx; line-height: 1.4; margin: 0; }
