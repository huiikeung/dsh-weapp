<!-- 插件（对齐 dsh-mobile PluginsView：官方/已安装分组 + 启用开关 + 实验性徽标） -->
<view class="page plugins {{themeClass}}" style="padding-top: {{statusBarH}}px;">
  <view class="plugins-header">
    <view class="plugins-back tap" hover-class="sched-back-hover" bindtap="goBack">
      <image class="plugins-back-ic" src="/assets/icons/{{theme === 'dark' ? 'back-white.png' : 'back-black.png'}}"/>
    </view>
    <text class="plugins-title">插件</text>
    <view class="plugins-refresh {{loading ? 'disabled' : ''}} tap" hover-class="brand-dim" bindtap="onRefresh">
      <image class="plugins-refresh-ic" src="/assets/icons/refresh-blue.png"/>
    </view>
  </view>

  <scroll-view class="plugins-scroll" scroll-y refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="plugins-body">
      <text class="plugins-hint">安装、启用和配置插件</text>

      <text wx:if="{{!connected}}" class="plugins-warn">网关已断开，插件状态待重新连接确认</text>
      <text wx:if="{{notice}}" class="plugins-warn">{{notice}}</text>

      <!-- 错误态（对齐 ContentUnavailableView：有错误就显示，与目录无关） -->
      <view wx:if="{{error}}" class="plugins-state">
        <image class="plugins-state-ic" src="/assets/icons/plugin-error-gray.png"/>
        <text class="plugins-state-title">{{error}}</text>
        <text class="plugins-state-desc">请检查网关连接后重试</text>
      </view>
      <view wx:elif="{{loading && !catalog}}" class="plugins-state">
        <view class="plugins-spinner"></view>
      </view>

      <block wx:if="{{catalog && catalog.canManage}}">
        <!-- 官方 -->
        <view class="plugin-section">
          <view class="plugin-section-head">
            <text class="plugin-section-title">官方</text>
            <text class="plugin-section-count">{{catalog.officialTotal}}</text>
          </view>
          <view wx:for="{{catalog.officialBundles}}" wx:key="name" class="plugin-row">
            <view class="plugin-line tap" hover-class="plugin-line-hover" bindtap="openBundle" data-name="{{item.name}}">
              <view class="plugin-icon">
                <image wx:if="{{item.icon}}" class="plugin-icon-img" src="{{item.icon}}"/>
                <view wx:else class="plugin-icon-fallback"><text>{{item.initial}}</text></view>
              </view>
              <view class="plugin-line-body">
                <view class="plugin-line-title-row">
                  <text class="plugin-line-title">{{item.title}}</text>
                  <text wx:if="{{item.experimental}}" class="plugin-badge">实验性</text>
                </view>
                <text wx:if="{{item.description}}" class="plugin-line-sub">{{item.description}}</text>
              </view>
            </view>
            <view wx:if="{{pendingName === item.name}}" class="plugins-spinner small"></view>
            <switch
              class="plugin-switch"
              checked="{{item.enabled}}"
              color="{{theme === 'dark' ? '#1D447F' : '#245AC4'}}"
              disabled="{{item.toggleDisabled}}"
              bindchange="onBundleToggle"
              data-name="{{item.name}}"
              data-enabled="{{item.enabled}}"
            />
          </view>
          <view wx:for="{{catalog.officialItems}}" wx:key="id" class="plugin-row">
            <view class="plugin-line tap" hover-class="plugin-line-hover" bindtap="openOfficial" data-id="{{item.id}}">
              <view class="plugin-icon">
                <view class="plugin-icon-fallback"><text>{{item.initial}}</text></view>
              </view>
              <view class="plugin-line-body">
                <view class="plugin-line-title-row">
                  <text class="plugin-line-title">{{item.title}}</text>
                </view>
                <text wx:if="{{item.description}}" class="plugin-line-sub">{{item.description}}</text>
              </view>
              <image class="plugin-chev" src="/assets/icons/chev-right-gray.png"/>
            </view>
          </view>
        </view>

        <!-- 已安装 -->
        <view class="plugin-section" wx:if="{{catalog.installedBundles.length}}">
          <view class="plugin-section-head">
            <text class="plugin-section-title">已安装</text>
            <text class="plugin-section-count">{{catalog.installedBundles.length}}</text>
          </view>
          <view wx:for="{{catalog.installedBundles}}" wx:key="name" class="plugin-row">
            <view class="plugin-line tap" hover-class="plugin-line-hover" bindtap="openBundle" data-name="{{item.name}}">
              <view class="plugin-icon">
                <image wx:if="{{item.icon}}" class="plugin-icon-img" src="{{item.icon}}"/>
                <view wx:else class="plugin-icon-fallback"><text>{{item.initial}}</text></view>
              </view>
              <view class="plugin-line-body">
                <view class="plugin-line-title-row">
                  <text class="plugin-line-title">{{item.title}}</text>
                  <text wx:if="{{item.experimental}}" class="plugin-badge">实验性</text>
                </view>
                <text wx:if="{{item.description}}" class="plugin-line-sub">{{item.description}}</text>
              </view>
            </view>
            <view wx:if="{{pendingName === item.name}}" class="plugins-spinner small"></view>
            <switch
              class="plugin-switch"
              checked="{{item.enabled}}"
              color="{{theme === 'dark' ? '#1D447F' : '#245AC4'}}"
              disabled="{{item.toggleDisabled}}"
              bindchange="onBundleToggle"
              data-name="{{item.name}}"
              data-enabled="{{item.enabled}}"
            />
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
