              <view
                wx:for="{{nativeBgPresets}}"
                wx:key="id"
                class="native-bg-chip {{nativeBgValue === item.value ? 'active' : ''}}"
                data-value="{{item.value}}"
                bindtap="pickNativeBgPreset"
                role="button"
              >{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</view>
            </view>
          </view>
          
</view>
</view>
