}

.event-body-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-2);
  white-space: pre-wrap;
  word-break: break-word;
}

.event-body-stack {
  flex: 1;
  min-width: 0;
}

.event-body-stack .code-block {
  margin: 12rpx 0;
}

/* ===== 过程组内 disclosures（iOS 节点树指标） ===== */
.disclosure {
  margin: 0;
  border-bottom: 1rpx solid rgba(142, 142, 147, 0.12);
}

.disclosure-head {
  display: flex;
  align-items: center;
  gap: 16rpx;                     /* spacing 8 */
  min-width: 0;
  min-height: 66rpx;
  padding: 10rpx 0;
  box-sizing: border-box;
}

.disclosure-head.bundle {
  padding: 4rpx 0 4rpx 4rpx;      /* leading 2 / vertical 2 */
}

.disclosure-head.tool {
