    animation: none;
  }
}

.user-image-single,
.user-image-stack {
  margin-bottom: 0;
}

.user-image-single.with-text,
.user-image-stack.with-text {
  margin-bottom: 16rpx;
}

.user-image-count {
  right: 150rpx;
  bottom: 64rpx;
  width: 90rpx;
  height: 52rpx;
  box-sizing: border-box;
  padding: 0;
  border-radius: 24rpx;
  text-align: center;
  line-height: 52rpx;
  font-size: 24rpx;
}

.theme-dark .nav-more .nav-ic {
  filter: invert(1);
}

.nav-more .nav-ic {
  width: 36rpx;
