}
.dock-stack[hidden] { display: none !important; }
.composer {
position: relative;
z-index: 1;
padding: 28rpx 28rpx 24rpx;
border-radius: 48rpx;
background: var(--surface);
border: 1rpx solid var(--border-strong);
box-shadow: var(--float-shadow);
}
.voice-input-wrap { position:relative; }
.dock-stack.voice-holding { opacity:0; }
.voice-touch-surface { position:absolute; inset:0; z-index:2; min-height:44px; }
.voice-progress { display:flex; justify-content:space-between; align-items:center; color:var(--text-2); font-size:24rpx; }
.voice-inline-action { padding:18rpx 12rpx; min-height:44px; box-sizing:border-box; display:flex; align-items:center; color:var(--text); }
.voice-transcript { border-top:1rpx solid var(--divider); margin-top:12rpx; font-size:26rpx; }
.voice-transcript-hint { display:block; color:var(--text-2); padding-top:16rpx; font-size:24rpx; }
.voice-transcript-text { display:block; max-height:180rpx; overflow:auto; padding-top:12rpx; color:var(--text); }
.voice-transcript-actions { display:flex; justify-content:flex-end; gap:20rpx; }
.composer-input-row { display:flex; align-items:flex-start; gap:8rpx; width:100%; }
.composer-input-row .composer-input { flex:1 1 auto; width:auto; min-width:0; }
.composer-slash-chip { display: none; align-items: center; gap: 2rpx; flex-shrink: 0; align-self: center; margin-right: 4rpx; }
.composer-slash-chip.on { display: flex; }
.composer-slash-token { color: var(--ocean); font-size: 28rpx; }
.composer-slash-x { padding: 0 2rpx; color: var(--ocean); font-size: 18rpx; opacity: .66; }
.composer-refs { display: none; flex-wrap: wrap; align-items: center; gap: 2rpx 22rpx; margin: 2rpx 0 8rpx; }
.composer-refs.on { display: flex; }
.composer-refs[hidden] { display: none !important; }
.composer-ref-chip { display: flex; align-items: center; gap: 8rpx; min-width: 0; max-width: 100%; padding: 4rpx 4rpx 4rpx 2rpx; border-radius: 12rpx; }
.composer-ref-icon { width: 30rpx; height: 30rpx; flex: 0 0 30rpx; }
.theme-dark .composer-ref-icon { filter: brightness(1.5); }
.composer-ref-label { min-width: 0; max-width: 520rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; line-height: 1.4; color: #5483E8; }
.theme-dark .composer-ref-label { color: #8FB4F2; }
.composer-ref-remove { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; }
.composer-ref-remove:active { background: var(--fill-2); }
.composer-ref-x { font-size: 24rpx; line-height: 1; color: #5483E8; opacity: .6; }
.theme-dark .composer-ref-x { color: #8FB4F2; }
.composer-input {
