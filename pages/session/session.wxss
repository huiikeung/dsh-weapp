  position: absolute;
  right: 20rpx;
  top: 12rpx;
  margin: 0;
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}



/* Center the whole conversation/trajectory segmented control. */
.segmented-row {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 12rpx 0;
