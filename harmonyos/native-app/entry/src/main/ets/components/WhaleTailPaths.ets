/**
 * 鲸尾 60 帧矢量轮廓（由 iOS RunningWhaleTailSprite 追踪而来，坐标已缩放到 16.4×16.4）。
 * 用 ArkUI Path 直接填充，颜色可即时跟随主题，不受 SVG/位图着色缓存影响。
 */
const TAIL_FRAME_CACHE: string[] = [];

/**
 * 取第 index 帧的「已归零」路径：原始数据是雪碧图坐标（帧 i 整体在 x = -i*16.4），
 * 这里把 x 统一平移回 [0,16.4]，这样不用 viewPort/translate 也能在 16.4 的槽里画出来。
 */
export function tailFramePath(index: number): string {
  const frame: number = ((index % 60) + 60) % 60;
  const cached: string | undefined = TAIL_FRAME_CACHE[frame];
  if (cached !== undefined) {
    return cached;
  }
  const dx: number = frame * 16.4;
  const raw: string = WHALE_TAIL_PATHS[frame];
  const normalized: string = raw.replace(/(-?\d+(?:\.\d+)?)\s+(-?\d+(?:\.\d+)?)/g,
    (match: string, x: string, y: string): string => {
      const nx: string = (parseFloat(x) + dx).toFixed(2);
      return nx + ' ' + y;
    });
  TAIL_FRAME_CACHE[frame] = normalized;
  return normalized;
}

