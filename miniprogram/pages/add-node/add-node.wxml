<page-meta page-style="{{pageStyle}}" />
<view class="page add-node {{themeClass}}" style="{{contentFontStyle}}">
  <!-- 自定义导航 -->
  <view class="nav" style="padding-top:{{navPadTop}}px;height:{{navHeight}}px;">
    <view class="nav-back tap" bindtap="goBack" hover-class="press-dim">
      <image class="nav-back-ic" src="/assets/icons/{{theme === 'dark' ? 'back-white.png' : 'back-black.png'}}"/>
    </view>
    <text class="nav-title">{{ui['添加节点']}}</text>
  </view>

  <!-- 进度点 -->
  <view class="steps">
    <block wx:for="{{dots}}" wx:key="index">
      <view wx:if="{{index > 0}}" class="step-line {{index <= step ? 'on' : ''}}"></view>
      <view class="step-dot {{index <= step ? 'on' : ''}}"></view>
    </block>
  </view>

  <scroll-view scroll-y class="body">
    <!-- 第一步：电脑端准备 -->
    <block wx:if="{{step === 0}}">
      <view class="section">
        <text class="section-title">{{ui['电脑端准备']}}</text>
        <text class="section-sub">{{ui['在电脑上完成三步，再用小程序扫码配对。']}}</text>

        <view class="card-step">
          <view class="step-head">
            <view class="step-no">1</view>
            <text class="step-title">{{ui['安装微信连接插件']}}</text>
          </view>
          <text class="step-text">{{ui['打开 DSH 桌面端，在「插件 → 添加插件」中输入下方名称，安装并启用。带插件管理器的 Web 端也可这样安装。']}}</text>
          <view class="code-row">
            <text class="code-text text-mono">{{pluginName}}</text>
            <view class="code-copy tap" bindtap="copyPlugin" hover-class="press-dim">
              <image class="code-copy-ic" src="/assets/icons/copy-gray.png"/>
            </view>
          </view>
        </view>

        <view class="card-step">
          <view class="step-head">
            <view class="step-no">2</view>
            <text class="step-title">{{ui['确认插件已生效']}}</text>
          </view>
          <text class="step-text">{{ui['按安装结果提示操作；若提示需要重启，请保存工作后正常重启对应的 DSH。已生效时无需重启，仅刷新 Web 网页不会重启服务。']}}</text>
        </view>

        <view class="card-step">
          <view class="step-head">
            <view class="step-no">3</view>
            <text class="step-title">{{ui['显示小程序配对码']}}</text>
          </view>
          <text class="step-text">{{ui['打开「微信连接」插件详情，或「设置 → 微信连接」，显示当前节点的小程序配对码。下一步用本小程序扫码。']}}</text>
        </view>
      </view>
      <view class="footer">
        <button class="btn-ghost" bindtap="prev" hover-class="btn-press">{{ui['上一步']}}</button>
        <button class="btn-primary" bindtap="toPair" hover-class="btn-press">{{ui['已完成，去配对']}}</button>
      </view>
    </block>

    <!-- 第二步：扫码配对 -->
    <block wx:else>
      <view class="section">
        <text class="section-title">{{ui['扫码配对']}}</text>
        <text class="section-sub">{{ui['扫码绑定你的 Agent 节点，建立手机与电脑的安全连接。配对后支持同一局域网内安全直连，也支持公网连接。']}}</text>
        <view class="pair-actions">
          <button class="btn-scan" bindtap="scan" hover-class="btn-press" disabled="{{scanning}}">
            <view class="btn-ic" aria-hidden="true">
              <view class="ico-scan">
                <view class="corner tl"></view><view class="corner tr"></view>
                <view class="corner bl"></view><view class="corner br"></view>
                <view class="find a"></view><view class="find b"></view><view class="find c"></view>
                <view class="dots"><view></view><view></view><view></view><view></view></view>
              </view>
            </view>
            <text class="btn-label">{{scanning ? ui['正在连接…'] : ui['扫描配对']}}</text>
          </button>
          <button class="btn-ghost pair-ghost" bindtap="manual" hover-class="btn-press">
            <view class="btn-ic" aria-hidden="true">
              <view class="ico-keyboard">
                <view class="kb-row"><view></view><view></view><view></view><view></view><view></view></view>
                <view class="kb-row"><view></view><view></view><view></view><view></view><view></view></view>
                <view class="kb-row kb-last"><view></view><view class="kb-bar"></view><view></view></view>
              </view>
            </view>
            <text class="btn-label">{{ui['输入配对信息']}}</text>
          </button>
        </view>
        <text wx:if="{{pairError}}" class="pair-error">{{ui[pairError] !== undefined ? ui[pairError] : pairError}}</text>
      </view>
      <view class="footer">
        <button class="btn-ghost" bindtap="prev" hover-class="btn-press">{{ui['上一步']}}</button>
      </view>
    </block>
  </scroll-view>

  <!-- 底部弹窗：粘贴配对信息（与设置页同款） -->
  <view wx:if="{{pairSheetOpen}}" class="pair-sheet-mask" catchtap="closePairSheet" catchtouchmove="noop">
    <view class="pair-sheet" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{ui['输入配对信息']}}</text>
          <text class="pair-sheet-subtitle">{{ui['粘贴插件提供的 Base64URL 配对信息']}}</text>
        </view>
        <view class="pair-sheet-close tap" bindtap="closePairSheet"><view class="sheet-close-x"></view></view>
      </view>
      <textarea
        class="pair-payload-input"
        value="{{pairingText}}"
        maxlength="20000"
        auto-height="{{false}}"
        placeholder="{{ui['粘贴完整配对字符串']}}"
        placeholder-class="pair-payload-placeholder"
        bindinput="onPairingInput"
        disabled="{{pairingConnecting}}"
      />
      <text wx:if="{{pairingError}}" class="pair-result {{pairingConnecting ? 'pair-result-pending' : ''}}">{{ui[pairingError] !== undefined ? ui[pairingError] : pairingError}}</text>
      <view class="pair-submit {{!pairingText || pairingConnecting ? 'pair-submit-disabled' : ''}}" bindtap="connectPublicNode">
        <text>{{pairingConnecting ? ui['连接中…'] : ui['连接节点']}}</text>
      </view>
    </view>
  </view>
</view>
<public-access-dialog visible="{{publicAccessDialogOpen}}" dialog="{{publicAccessDialog}}" theme="{{theme}}" bindconfirm="onPublicAccessDialogConfirm" />
