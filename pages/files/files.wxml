<page-meta page-style="{{pageStyle}}" />
<view class="page files {{themeClass}}">
  <view class="wf">
    <!-- 头部行：上一级 / 新建目录（标题在系统导航栏） -->
    <view class="wf-header">
      <view wx:if="{{!isRoot}}" class="wf-back tap" bindtap="goUp">‹ 上一级</view>
      <view wx:else class="wf-back-ph"></view>
      <view class="wf-new tap {{loading ? 'disabled' : ''}}" bindtap="newDirectory">新建目录</view>
    </view>

    <!-- 路径栏：小图标 + 完整路径 + 加载中 -->
    <view class="wf-pathbar">
      <image class="wf-path-icon" src="/assets/icons/ic-dir-folder-blue.png"/>
      <text class="wf-path">{{displayPath}}</text>
      <view wx:if="{{loading}}" class="wf-spinner"></view>
    </view>
    <view class="wf-bar-divider"></view>

    <!-- 文件列表 -->
    <scroll-view class="wf-list" scroll-y>
      <view wx:if="{{loading && !entries.length}}" class="wf-center">
        <view class="wf-spinner large"></view>
        <text class="wf-center-text">正在读取工作区文件…</text>
      </view>
      <view wx:elif="{{error}}" class="wf-center">
        <text class="wf-center-text">{{error}}</text>
      </view>
      <block wx:else>
        <view wx:if="{{!entries.length}}" class="wf-center">
          <text class="wf-center-text">此目录为空</text>
        </view>
        <block wx:for="{{entries}}" wx:key="path">
          <view
            class="wf-row {{loading ? 'disabled' : ''}}"
            hover-class="wf-row-hover"
            bindtap="openEntry"
            data-index="{{index}}"
          >
            <image class="wf-row-icon" src="/assets/icons/{{item.iconFile}}"/>
            <view class="wf-row-body">
              <text class="wf-row-name">{{item.name}}</text>
              <text wx:if="{{item.subLabel}}" class="wf-row-sub">{{item.subLabel}}</text>
            </view>
            <image wx:if="{{item.kind === 'dir'}}" class="wf-row-chev" src="/assets/icons/ic-dir-chevron-mist.png"/>
          </view>
          <view wx:if="{{index < entries.length - 1}}" class="wf-divider"></view>
        </block>
      </block>
      <view class="wf-list-spacer"></view>
    </scroll-view>
  </view>
</view>
