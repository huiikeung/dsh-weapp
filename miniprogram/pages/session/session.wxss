}

.theme-dark .process-block.running .process-title {
  color: #A8BEDB;
}

.process-head {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;                     /* spacing 7 */
  min-width: 0;
  padding: 14rpx 0;               /* vertical 7 */
}

.process-title {
  font-size: 30rpx;               /* subheadline 15pt */
  font-weight: 500;               /* medium */
  color: var(--text-2);           /* secondary */
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.process-command-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  transition: opacity 0.14s ease;
}

.process-chevron {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  position: absolute;
  left: 0;
  opacity: 0;
  transform: rotate(90deg);       /* 收起：▾ */
  transition: transform 0.18s ease, opacity 0.14s ease;
}

.process-chevron.open {
  transform: rotate(-90deg);      /* 展开：▴ */
}

.process-hairline {
  height: 1rpx;                   /* gray 16% */
  background: rgba(142, 142, 147, 0.16);
}

.process-body {
  padding: 0;
}

.process-command-detail {
  margin: 10rpx 0 14rpx 4rpx;
  padding: 22rpx 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  background: var(--surface-glass);
  color: var(--text);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 26rpx;
  line-height: 1.48;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 展开内的 disclosure（Think / 工具，对齐 ProcessDisclosure） */

/* ===== 事件行（iOS ConversationFallbackEventRow：图标18宽 + 标题 tint + · + 预览） ===== */
.event-row {
  padding: 4rpx 0;                /* vertical 2 */
}

.event-head {
  display: flex;
  align-items: center;
  gap: 16rpx;                     /* spacing 8 */
  min-width: 0;
}

.event-glyph {
  width: 36rpx;                   /* frame width 18 */
  height: 36rpx;
  flex-shrink: 0;
}

.event-title {
  font-size: 30rpx;               /* subheadline 15pt */
  color: var(--text);
  flex-shrink: 0;
  max-width: 46%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-title.tint-green { color: #34A853; }    /* iOS .green */
.event-title.tint-purple { color: #7A54C7; }   /* DSHColor.purple */
.event-title.tint-orange { color: #F07D14; }   /* DSHColor.orange */

.event-dot {
  color: var(--text-3);           /* tertiary */
  flex-shrink: 0;
}

.event-preview {
  font-size: 30rpx;               /* subheadline */
  color: var(--text-2);           /* secondary */
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-spacer {
  flex: 1;
}

.event-chevron {
  width: 26rpx;                   /* caption semibold */
  height: 26rpx;
  flex-shrink: 0;
  transition: transform 0.18s ease;
}

.event-chevron.open {
  transform: rotate(90deg);
}

/* 事件详情体（iOS：1px 灰线 + compact markdown secondary；leading 5/top 5/bottom 3） */
.event-body {
  display: flex;
  gap: 20rpx;                     /* spacing 10 */
  padding: 10rpx 0 6rpx 10rpx;    /* leading 5 / top 5 / bottom 3 */
}

.event-rule {
  width: 2rpx;                    /* 1pt gray 24% */
  background: rgba(142, 142, 147, 0.24);
