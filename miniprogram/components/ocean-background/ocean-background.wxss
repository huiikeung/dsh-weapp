:host { display: block; width: 100%; height: 100%; pointer-events: none; }
.ocean-background { position: absolute; inset: 0; overflow: hidden; pointer-events: none; background: linear-gradient(180deg, #1D3A6B 0%, #17315B 38%, #0D2044 68%, #07182b 100%); }
.ocean-frame, .ocean-grain, .ocean-depth, .ocean-settle { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
/* The animation preference keeps the artwork static without perpetual effects. */
.ocean-static .ocean-grain,
.ocean-static .ocean-settle { animation: none; }
.ocean-static .ocean-grain { display: none; }
.ocean-static .ocean-settle { opacity: 0.1; }
.ocean-buffer { opacity: 0; }
/* Film grain: compensates JPEG quantization; see scripts/generate-grain-texture.cjs. */
.ocean-grain { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0.07; mix-blend-mode: overlay; background-image: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAwAAAAMCAAAAABzHgM7AAAAlklEQVR42gXBDQ9CQBgA4PeXKsSYCYkbTedq5+tymNKWi9Mv7Xng/MHKLLuNcUPCJVB9LdNW0lx3wJ0plNuD9GILwIw4NRITj/P3B3iqkB4MeEkPBaQV7d3u3oYdX4Cki81Yzm+nDEG7erFLi9pLsj0orxLpyO6tyfzBmD9zw2Jxq4sSCm2shfoejlwSwCxyHCS0lfrNH0+3SNZKtaboAAAAAElFTkSuQmCC"); background-repeat: repeat; background-size: 96rpx 96rpx; animation: ocean-grain-shift 1.1s steps(1) infinite; }
.ocean-paused .ocean-grain { animation-play-state: paused; }
.ocean-still .ocean-grain { animation: none; }
@keyframes ocean-grain-shift {
  0% { background-position: 0 0; }
  25% { background-position: 7px -17px; }
  50% { background-position: 19px 13px; }
  75% { background-position: 27px 3px; }
}
.ocean-depth { background: linear-gradient(180deg, transparent, rgba(6, 23, 43, 0.12) 50%, rgba(0, 0, 0, 0.58)); }
.ocean-settle { background: #020711; animation: ocean-settle 24s ease-in-out both; }
.ocean-paused .ocean-settle { animation-play-state: paused; }
.ocean-still .ocean-settle { animation: none; }
.ocean-still .ocean-settle { opacity: 0.08; }
@keyframes ocean-settle { from { opacity: 0; } to { opacity: 0.10; } }
@media (prefers-reduced-motion: reduce) { .ocean-settle { animation: none; opacity: 0.16; } }
