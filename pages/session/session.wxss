.session {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* ---------- 顶部导航 ---------- */

.navbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  flex-shrink: 0;
}

.nav-back,
.nav-more {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 16rpx rgba(7, 24, 43, 0.08);
  flex-shrink: 0;
}

.nav-more {
  font-size: 34rpx;
  letter-spacing: 2rpx;
}

.nav-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin: 0 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-preset {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--gray);
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* ---------- 分段控件（iOS 对齐，双主题） ---------- */

.segmented {
  display: flex;
  margin: 8rpx 40rpx 20rpx;
  border-radius: 999rpx;
  padding: 8rpx;
  background: rgba(118, 118, 128, 0.24);
  flex-shrink: 0;
}

.segment {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  color: var(--text-2);
}

.segment.active {
  background: var(--segment-active-bg);
  color: var(--segment-active-text);
  font-weight: 600;
}

/* ---------- 对话 ---------- */

.conversation,
.trajectory {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 0 40rpx;
}

.load-more {
  text-align: center;
  color: var(--gray);
  font-size: 25rpx;
  padding: 20rpx 0;
}

.row-user {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.row-user-title {
  font-size: 26rpx;
  color: var(--text-3);
  margin-bottom: 10rpx;
}

.row-user-text {
  font-size: 31rpx;
  color: var(--text);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.row-assistant {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.row-streaming-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 14rpx;
}

.row-event {
  padding: 20rpx 0;
  display: flex;
  align-items: center;
}

.event-tag {
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--fill);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.event-tag.error {
  color: #E5484D;
  background: rgba(229, 72, 77, 0.14);
}

.event-text {
  font-size: 26rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 折叠行（思考 / 工具） ---------- */

.fold {
  background: var(--fill);
  border: 1rpx solid var(--border-strong);
  border-radius: 18rpx;
  margin: 14rpx 0;
  overflow: hidden;
}

.fold-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.fold-glyph {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.tool-glyph {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.fold-title {
  flex: 1;
  font-size: 27rpx;
  color: var(--text);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fold-chevron {
  width: 24rpx;
  height: 24rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
  transform: rotate(-90deg);
  transition: transform 0.18s ease;
}

.fold-chevron.open {
  transform: rotate(0deg);
}

.tool-status {
  font-size: 24rpx;
  color: var(--text-3);
  margin-left: 14rpx;
  flex-shrink: 0;
}

.tool-status.done { color: var(--success); }
.tool-status.error { color: #E5484D; }

.fold-body {
  padding: 0 24rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-2);
  white-space: pre-wrap;
  word-break: break-all;
}

/* ---------- Markdown ---------- */

.md-block {
  margin: 10rpx 0;
}

.md-para {
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--text);
  display: block;
}

.md-heading {
  display: block;
  color: var(--text);
  font-weight: 700;
  margin-top: 20rpx;
}

.md-h1 { font-size: 40rpx; }
.md-h2 { font-size: 36rpx; }
.md-h3 { font-size: 33rpx; }
.md-h4, .md-h5, .md-h6 { font-size: 31rpx; }

.md-inline-code {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 0.86em;
  color: var(--text);
  background: var(--fill);
  border-radius: 12rpx;
  padding: 2rpx 8rpx;
}

.md-quote {
  display: block;
  border-left: 6rpx solid rgba(191, 212, 255, 0.45);
  padding-left: 20rpx;
  color: var(--text-2);
  font-size: 29rpx;
  margin: 16rpx 0;
}

.md-hr {
  height: 1rpx;
  background: var(--border-strong);
  margin: 30rpx 0;
}

.md-list {
  margin: 10rpx 0;
}

.md-li {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0;
}

.md-li-marker {
  color: var(--text-3);
  margin-right: 16rpx;
  font-size: 29rpx;
  flex-shrink: 0;
}

.md-li-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text);
}

/* ---------- Markdown 表格（深色，iOS 对齐） ---------- */

/* 对齐 dsh-mobile Markwon TablePlugin：边框 onSurface 20%、表头底色 onSurface 8%、隔行 3.5% */

.md-table {
  margin: 20rpx 0;
  border: 1rpx solid var(--border-strong);
  border-radius: 10rpx;
  overflow: hidden;
}

.md-tr {
  display: flex;
  border-bottom: 1rpx solid var(--border-strong);
}

.md-tr:last-child {
  border-bottom: none;
}

.md-tr:nth-child(odd):not(.md-tr-head) {
  background: var(--fill);
}

.md-td {
  flex: 1;
  min-width: 0;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--text);
  border-left: 1rpx solid var(--border-strong);
  word-break: break-word;
}

.md-td:first-child {
  border-left: none;
}

.md-tr-head .md-td {
  font-weight: 600;
  color: var(--text);
  font-size: 30rpx;
  background: var(--fill);
}

/* ---------- 代码块 ---------- */

.code-block {
  position: relative;
  background: var(--fill);
  border: 1rpx solid var(--border-strong);
  border-radius: 20rpx;
  overflow: hidden;
  margin: 20rpx 0;
}

.code-lang {
  font-size: 23rpx;
  color: var(--text-4);
  padding: 18rpx 28rpx 0;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.code-body {
  padding: 12rpx 28rpx 26rpx;
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text);
  white-space: pre-wrap;
  word-break: break-all;
  max-height: 480rpx;
  overflow-y: auto;
}

.code-copy {
  position: absolute;
  top: 14rpx;
  right: 20rpx;
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--fill-2);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

/* ---------- 图片附件 ---------- */

.attach-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.attach-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  margin: 0 16rpx 16rpx 0;
  background: rgba(16, 19, 24, 0.06);
}

.conv-bottom {
  height: 20rpx;
}

/* ---------- 轨迹 ---------- */

.trace-summary {
  background: var(--fill);
  border: 1rpx solid var(--border-strong);
  border-radius: 22rpx;
  padding: 28rpx 28rpx 22rpx;
  margin-bottom: 24rpx;
}

.trace-summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 22rpx;
}

.trace-total {
  color: var(--text);
  font-weight: 600;
}

.trace-lane {
  display: flex;
  align-items: center;
  margin: 12rpx 0;
}

.lane-label {
  width: 110rpx;
  font-size: 25rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

.lane-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--fill-2);
  overflow: hidden;
}

.lane-fill {
  height: 100%;
  border-radius: 999rpx;
}

.lane-fill.input { background: var(--ocean); }
.lane-fill.model { background: var(--purple); }
.lane-fill.tools { background: var(--orange); }

.trace-axis {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  color: var(--text-4);
  margin-top: 14rpx;
}

.trace-turn {
  display: flex;
  align-items: center;
  margin: 28rpx 0 10rpx;
}

.trace-turn text {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 26rpx;
  color: var(--text-3);
  flex-shrink: 0;
  margin-right: 18rpx;
}

.trace-turn-line {
  flex: 1;
  height: 1rpx;
  background: var(--border-strong);
}

.trace-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.trace-badge {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 21rpx;
  border-radius: 10rpx;
  padding: 5rpx 12rpx;
  flex-shrink: 0;
  margin-right: 14rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.trace-badge.user {
  color: var(--ocean);
  background: rgba(46, 107, 230, 0.14);
}

.trace-badge.assistant {
  color: var(--purple);
  background: rgba(122, 84, 199, 0.14);
}

.trace-badge.tool {
  color: var(--orange);
  background: rgba(240, 125, 20, 0.14);
}

.trace-badge.event {
  color: var(--text-2);
  background: var(--fill-2);
}

.trace-label {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 26rpx;
  color: var(--text);
  font-weight: 600;
  margin-right: 14rpx;
  flex-shrink: 0;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trace-preview {
  flex: 1;
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 25rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trace-seq {
  font-size: 24rpx;
  color: var(--text-4);
  margin: 0 10rpx 0 14rpx;
  flex-shrink: 0;
}

.trace-chevron {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.empty {
  text-align: center;
  color: var(--text-4);
  padding: 80rpx 0;
  font-size: 27rpx;
}

/* ---------- 待处理卡片 ---------- */

.pending-card {
  margin: 0 40rpx 20rpx;
  background: var(--surface);
  border: 1rpx solid rgba(46, 107, 230, 0.45);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--float-shadow);
  flex-shrink: 0;
}

.pending-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.q-item {
  margin-bottom: 18rpx;
}

.q-question {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.q-detail {
  font-size: 25rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
}

.q-options {
  display: flex;
  flex-direction: column;
}

.q-option {
  border: 1rpx solid var(--border-strong);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}

.q-option.selected {
  border-color: var(--ocean);
  background: rgba(46, 107, 230, 0.18);
}

.q-option-label {
  font-size: 28rpx;
  color: var(--text);
}

.q-option-desc {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.q-custom {
  background: var(--fill);
  border: 1rpx solid var(--border-strong);
  color: var(--text);
}

.pending-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.pending-btn {
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  margin-left: 18rpx;
}

.pending-btn.ghost {
  color: var(--text-2);
  border: 1rpx solid var(--border-strong);
}

.pending-btn.primary {
  color: #FFFFFF;
  background: var(--ocean);
}

.pending-btn.disabled {
  opacity: 0.5;
}

.approval-tool {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 30rpx;
  color: var(--text);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.approval-reason {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 10rpx;
}

/* ---------- composer 上方行（预设胶囊 + 统计胶囊） ---------- */

.composer-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 14rpx;
  flex-shrink: 0;
}

.preset-capsule {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  box-shadow: var(--float-shadow);
  max-width: 60%;
}

.preset-capsule-ic {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.preset-capsule-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preset-capsule-chev {
  width: 20rpx;
  height: 20rpx;
  margin-left: 12rpx;
  opacity: 0.45;
  flex-shrink: 0;
}

/* ---------- 会话统计胶囊 ---------- */

.stats-pill {
  display: flex;
  align-items: center;
  margin-left: auto;
  background: var(--surface);
  border: 1rpx solid var(--border-strong);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  flex-shrink: 0;
  box-shadow: var(--float-shadow);
}

.stats-pill-text {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: var(--text-2);
}

.stats-pill-chev {
  width: 24rpx;
  height: 24rpx;
  margin-left: 12rpx;
}

/* ---------- 输入面板 ---------- */

.composer {
  margin: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  padding: 28rpx 28rpx 18rpx;
  border-radius: 48rpx;
  background: var(--surface);
  border: 1rpx solid var(--border-strong);
  box-shadow: var(--float-shadow);
  flex-shrink: 0;
}

.composer-input {
  width: 100%;
  min-height: 88rpx;
  max-height: 320rpx;
  font-size: 31rpx;
  color: var(--text);
  box-sizing: border-box;
}

.composer-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.composer-thumb {
  position: relative;
  margin-right: 14rpx;
}

.composer-thumb-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
}

.composer-thumb-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.7);
  color: var(--text);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-bar {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

/* 对齐 dsh-mobile：输入栏控件为扁平图标+文字（onSurface 62%），无胶囊底色 */
.chip {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-2);
  padding: 10rpx 8rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.chip.icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  padding: 0;
  margin-right: 0;
}

.composer-spacer {
  flex: 1;
}

.send-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--ocean);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.send-btn.disabled {
  opacity: 0.48;
}

.send-btn.stop {
  background: var(--ocean);
}

.stop-square {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: #FFFFFF;
}

.composer-stats {
  display: none;
}

/* ---------- 抽屉 ---------- */

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 75vh;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--surface);
}

.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border-strong);
  margin: 8rpx auto 24rpx;
}

.sheet-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.sheet-title-text {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 30rpx;
  color: var(--text);
  font-weight: 600;
  margin-left: 16rpx;
}

.sheet-body {
  flex: 1;
  min-height: 0;
}

.sheet-copy {
  text-align: center;
  flex-shrink: 0;
}

/* ===== 图标资产尺寸（iOS 对齐） ===== */
.nav-ic {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.event-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.trace-summary-stats {
  display: flex;
  align-items: center;
}

.stat-ic {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.trace-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.trace-dot.dot-user { background: var(--ocean); }
.trace-dot.dot-assistant { background: var(--purple); }
.trace-dot.dot-tool { background: var(--orange); }
.trace-dot.dot-event { background: var(--gray); }

.pending-title {
  display: flex;
  align-items: center;
}

.q-ic {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.chip {
  display: flex;
  align-items: center;
}

.chip-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.chip-ud {
  width: 18rpx;
  height: 18rpx;
  margin-left: 10rpx;
  opacity: 0.3;
}

.chip.effort,
.effort-pill {
  color: var(--text);
  background: rgba(122, 84, 199, 0.16);
  border-radius: 14rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
}

.chip.effort {
  border: 0;
  padding: 8rpx 18rpx;
}

.context-ring {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  position: relative;
  flex-shrink: 0;
}

.context-ring-in {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  border-radius: 50%;
  background: var(--surface);
}

.attach-ic {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.thumb-x {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.send-ic {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.sheet-copy {
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.trace-badge.event {
  background: rgba(142, 142, 147, 0.14);
  color: var(--gray);
}

/* ---------- 深色补充覆盖（theme-dark，随外观模式切换） ---------- */

.theme-dark .nav-back,
.theme-dark .nav-more {
  background: var(--fill-2);
  border: 1rpx solid var(--border-strong);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

/* 深色模式图标反色 */
.theme-dark .nav-ic {
  filter: invert(1) brightness(0.9);
}
