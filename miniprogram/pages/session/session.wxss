opacity: 0.75;
margin: 6rpx auto 20rpx;
}
.session-menu-mask { background: rgba(0, 0, 0, .42); z-index: 1000; visibility: hidden; pointer-events: none; opacity: 0; transition: opacity 160ms ease-out, visibility 0s 160ms; }
.session-menu-mask.is-open { visibility: visible; pointer-events: auto; opacity: 1; transition-delay: 0s; }
