/* 自绘开关：开/关几何尺寸一致，仅配色不同；深色由 JS 加 .dk 类，配色不依赖外部级联。 */
.sw { position: relative; flex: none; width: 86rpx; height: 46rpx; border-radius: 999rpx;
  background: rgba(120, 120, 128, .32); transition: background-color .18s ease; }
.sw.on { background: #000000; }
.sw-knob { position: absolute; left: 4rpx; top: 4rpx; width: 38rpx; height: 38rpx;
  border-radius: 50%; background: #FFFFFF; transition: transform .18s ease, background-color .18s ease; }
.sw.on .sw-knob { transform: translateX(40rpx); }
.sw.dis { opacity: .45; }

/* 深色：ON=白轨黑点，OFF=深灰轨浅灰点 */
.sw.dk { background: #3A3A3C; }
.sw.dk.on { background: #FFFFFF; }
.sw.dk .sw-knob { background: #C7C7CC; }
.sw.dk.on .sw-knob { background: #000000; }
