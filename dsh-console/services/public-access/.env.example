# 域名解析到服务器后填写。不要将真实 .env 提交 Git。
CONSOLE_DOMAIN=console.example.com
CONSOLE_ORIGIN=https://console.example.com
# 两次独立运行 openssl rand -hex 32，分别填入下方。
ACCESS_MASTER_KEY=请替换为64位随机十六进制密钥
CONSOLE_SETUP_TOKEN=请替换为独立的随机初始化密钥

# Optional Account Kit fallback; prefer encrypted configuration in the admin console.
# HUAWEI_CLIENT_ID=
# HUAWEI_CLIENT_SECRET=
# HUAWEI_ADMIN_OPENIDS=

# 虚拟支付（个人主体 · 道具直购）。取值：MP 后台 → 支付与交易 → 虚拟支付 → 基本配置。
# AppID/AppSecret 复用网页后台「微信与华为管理员」或 WECHAT_APP_ID / WECHAT_APP_SECRET，不需要另填。
# 不填则 /app-content 的 payment.ready 为 false，用户端隐藏支付卡片；兑换码不受影响。
# XPAY_OFFER_ID=1450000000
# XPAY_APP_KEY=现网 AppKey（沙箱联调换成沙箱 AppKey）
# 0=现网（生产必须 0，错用 1 支付会报 15011）；1=沙箱
# XPAY_ENV=0
# 发货推送 URL = https://<你的域名>/pay/notify；Token / EncodingAESKey 必须与 MP 后台「发货推送配置」完全一致。
# XPAY_MSG_TOKEN=与后台 Token 一致的随机串
# XPAY_MSG_AES_KEY=与后台 EncodingAESKey 一致的 43 位字符串（安全模式必填）
# plaintext / aes / compatible，必须与后台「消息加解密方式」一致；建议 aes（安全模式）。
# XPAY_MSG_ENCRYPT=aes
