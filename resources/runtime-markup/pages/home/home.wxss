  height: 26rpx;
}

.dir-row-body {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.dir-row-name {
  display: block;
  font-size: 32rpx;
  color: #F1F4FA;
  overflow: hidden;
  text-overflow: ellipsis;
