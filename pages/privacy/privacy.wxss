.privacy {
  min-height: 100vh;
  background: var(--bg);
}

.privacy-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx 0;
}

.privacy-fallback-ic {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
}

.privacy-fallback-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.privacy-fallback-url {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-3);
  word-break: break-all;
  text-align: center;
}

.privacy-actions {
  display: flex;
  margin-top: 48rpx;
}

.privacy-btn {
  min-width: 200rpx;
  text-align: center;
  padding: 20rpx 40rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border-strong);
  color: var(--text);
  font-size: 28rpx;
  margin: 0 12rpx;
}

.privacy-btn-primary {
  background: var(--ocean);
  border-color: var(--ocean);
  color: #FFFFFF;
}

.privacy-fallback-hint {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: var(--text-4);
  text-align: center;
  line-height: 1.6;
}
