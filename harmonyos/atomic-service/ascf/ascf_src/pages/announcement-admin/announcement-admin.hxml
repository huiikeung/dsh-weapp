<page-meta page-style="{{pageStyle}}"/>
<view class="editor-page {{themeClass}}" style="{{contentFontStyle}}">
  <text class="editor-intro">{{ui['发布后在「设置 → 关于 → 开发者公告」展示，与网页管理台同步。请勿发布密钥或个人隐私。']}}</text>
  <view has:if="{{loading || error}}" class="editor-message" role="alert">{{loading ? ui['正在验证管理员身份…'] : error}}</view>
  <button has:if="{{!loading && error}}" class="editor-secondary" bindtap="refresh" disabled="{{busy}}">{{ui['重新加载列表']}}</button>
  <block has:if="{{isAdmin}}">
    <view class="editor-card">
      <text class="editor-heading">{{editingId ? ui['编辑公告'] : ui['发布公告']}}</text>
      <text class="editor-label">{{ui['标题']}}</text><input class="editor-input" value="{{title}}" maxlength="60" bindinput="inputTitle" disabled="{{busy}}" placeholder="{{ui['公告标题（最多 60 字）']}}" placeholder-class="editor-placeholder" aria-label="{{ui['公告标题']}}"/>
      <text class="editor-label">{{ui['正文']}}</text><textarea class="editor-textarea" value="{{content}}" maxlength="3000" bindinput="inputContent" disabled="{{busy}}" placeholder="{{ui['填写更新说明或使用提醒，支持换行']}}" placeholder-class="editor-placeholder" aria-label="{{ui['公告正文']}}"/>
      <text class="editor-count">{{content.length}} / 3000</text>
      <button class="editor-primary" hover-class="editor-primary-hover" bindtap="save" loading="{{busy}}" disabled="{{busy || !title || !content}}">{{editingId ? ui['保存修改'] : ui['发布公告']}}</button>
      <button has:if="{{editingId}}" class="editor-secondary" bindtap="clearEditor" disabled="{{busy}}">{{ui['取消编辑']}}</button>
    </view>
    <view class="editor-list-head"><text class="editor-heading">{{ui['已发布 ·']}} {{items.length}}</text><button class="editor-link" bindtap="refresh" disabled="{{busy}}">{{ui['刷新']}}</button></view>
    <view has:if="{{!items.length}}" class="editor-message">{{ui['暂无公告，发布后会在这里显示。']}}</view>
    <view has:for="{{items}}" has:key="id" class="editor-card"><text class="editor-item-title">{{item.title}}</text><text class="editor-preview">{{item.content}}</text><view class="editor-actions"><button class="editor-link" data-id="{{item.id}}" bindtap="edit" disabled="{{busy}}">{{ui['编辑']}}</button><button class="editor-link editor-danger" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">{{ui['删除']}}</button></view></view>
  </block>
</view>
