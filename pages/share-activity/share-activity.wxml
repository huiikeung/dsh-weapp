<page-meta page-style="{{pageStyle}}" />
<view class="activity-page {{themeClass}}">
  <view wx:if="{{error}}" class="activity-message" role="alert">{{error}}</view>
  <view wx:if="{{loading}}" class="activity-message">正在同步活动信息…</view>
  <view wx:elif="{{!enabled && !error}}" class="activity-message">活动暂未开放，已有公网有效期不受影响。</view>
  <view wx:if="{{incoming}}" class="activity-card invitation-card">
    <text class="card-title">朋友邀请你认识鲸尾</text><text class="activity-intro">确认后，服务端使用当前微信在本小程序中的身份去重，符合规则才为邀请人增加时长。</text>
    <text wx:if="{{openResult}}" class="activity-message">{{openResult}}</text>
    <button wx:if="{{!accepted}}" class="activity-primary" bindtap="acceptInvitation" disabled="{{busy || loading || !enabled}}">确认有效打开</button>
    <button class="activity-secondary" bindtap="enterApp">进入鲸尾</button>
  </view>
  <view class="activity-card reward-overview">
    <image class="activity-logo" src="/assets/brand/app-icon-black-1024.png" mode="aspectFit"/>
    <text class="activity-heading">鲸尾 · 远程助手</text>
    <text class="activity-intro">随时连接自己的 DSH，查看进展、继续对话。</text>
    <text class="activity-reward-hint">朋友首次有效打开，按阶梯获赠公网访问</text>
    <text class="overview-label">分享累计获得</text><view class="reward-number">{{earnedDays}}<text> 天</text></view><text class="activity-intro">{{validOpens}} 位朋友有效打开 · 公网时长自动累加</text>
    <button wx:if="{{enabled}}" class="activity-primary" open-type="share" disabled="{{!inviteToken || loading}}">分享给好友或群聊</button>
    <view class="activity-links"><button bindtap="toggleRules">{{rulesOpen ? '收起规则' : '活动规则'}}</button><button bindtap="refresh" disabled="{{busy || loading}}">刷新记录</button></view>
    <text class="activity-intro activity-scope">仅赠送公网服务，不影响局域网，不分享设备权限。</text>
  </view>
  <view wx:if="{{rulesOpen}}" class="activity-card">
    <text class="card-title">好友分享规则</text>
    <view wx:for="{{tiers}}" wx:key="from" class="rule-row"><text>{{item.label}}</text><text>每人 +{{item.days}} 天</text></view>
    <text class="activity-intro">按累计有效人数决定本次奖励，不补发历史差额。同一微信在整个活动中只计一次；自己打开、重复打开不计奖。无需连接电脑，但必须由微信服务端核验身份并确认打开。不同微信不等于不同实体设备。</text>
  </view>
  <view class="activity-card">
    <view class="card-heading"><text class="card-title">分享到朋友圈</text><text class="reward-chip">审核通过 +{{momentsDays}} 天</text></view>
    <text class="activity-intro">每日可登记一次（北京时间）。发布后先上传截图，满 24 小时后上传仍保留的截图，后台审核通过才发奖。截图是人工审核依据，不能自动证明一直保留。</text>
    <view wx:if="{{enabled}}" class="activity-actions"><button class="activity-secondary" bindtap="momentsGuide">分享方法</button><button class="activity-secondary" bindtap="uploadProof" disabled="{{busy || loading}}">登记今日截图</button></view>
    <view wx:for="{{moments}}" wx:key="id" class="moment-item">
      <view class="rule-row"><text>{{item.day}}</text><text>{{item.statusLabel}}</text></view>
      <text wx:if="{{item.status === 'waiting'}}" class="activity-intro">复核时间：{{item.eligibleLabel}}</text><text wx:if="{{item.note}}" class="activity-intro">审核说明：{{item.note}}</text>
      <button wx:if="{{item.canSubmit}}" class="activity-secondary" data-id="{{item.id}}" bindtap="uploadProof" disabled="{{busy || !enabled}}">提交保留截图</button>
    </view>
  </view>
  <view wx:if="{{records.length}}" class="activity-card"><text class="card-title">奖励记录</text><view wx:for="{{records}}" wx:key="id" class="record-item"><view><text>{{item.label}}</text><text class="record-time">{{item.timeLabel}}</text></view><text class="reward-chip">+{{item.days}} 天</text></view></view>
  <text class="activity-footer">鲸尾 · 只分享服务，不分享设备权限</text>
</view>
