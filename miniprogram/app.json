{
  "pages": [
    "pages/home/home",
    "pages/session/session",
    "pages/share-activity/share-activity",
    "pages/privacy/privacy"
  ],
  "window": {
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "鲸尾 Harness",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "backgroundColorTop": "@bgColor",
    "backgroundColorBottom": "@bgColor"
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json",
  "subPackages": [
    {
      "root": "pages/settings",
      "name": "settings",
      "pages": [
        "settings"
      ]
    },
    {
      "root": "pages/plugins",
      "name": "plugins",
      "pages": [
        "plugins"
      ]
    },
    {
      "root": "pages/cost-meter",
      "name": "cost-meter",
      "pages": [
        "cost-meter"
      ]
    },
    {
      "root": "pages/plugin-detail",
      "name": "plugin-detail",
      "pages": [
        "plugin-detail"
      ]
    },
    {
      "root": "pages/schedule",
      "name": "schedule",
      "pages": [
        "schedule"
      ]
    },
    {
      "root": "pages/announcement-admin",
      "name": "announcement-admin",
      "pages": [
        "announcement-admin"
      ]
    },
    {
      "root": "pages/pairing-admin",
      "name": "pairing-admin",
      "pages": [
        "pairing-admin"
      ]
    },
    {
      "root": "pages/redeem-admin",
      "name": "redeem-admin",
      "pages": [
        "redeem-admin"
      ]
    },
    {
      "root": "pages/session-settings",
      "name": "session-settings",
      "pages": [
        "session-settings"
      ]
    },
    {
      "root": "pages/add-node",
      "name": "add-node",
      "pages": [
        "add-node"
      ]
    },
    {
      "root": "pages/workspace-picker",
      "name": "workspace-picker",
      "pages": [
        "workspace-picker"
      ]
    },
    {
      "root": "pages/insights",
      "name": "insights",
      "pages": [
        "insights"
      ]
    },
    {
      "root": "pages/files",
      "name": "files",
      "pages": [
        "files"
      ]
    },
    {
      "root": "pages/announcements",
      "name": "announcements",
      "pages": [
        "announcements"
      ]
    }
  ],
  "preloadRule": {
    "pages/session/session": {
      "network": "all",
      "packages": [
        "pages/session-settings",
        "pages/insights",
        "pages/files"
      ]
    },
    "pages/home/home": {
      "network": "all",
      "packages": [
        "pages/session-settings",
        "pages/add-node"
      ]
    },
    "pages/settings/settings": {
      "network": "all",
      "packages": [
        "pages/add-node",
        "pages/workspace-picker",
        "pages/announcements"
      ]
    }
  }
}
