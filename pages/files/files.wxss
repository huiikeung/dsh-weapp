.files {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.crumbs {
  flex-shrink: 0;
  padding: 24rpx 32rpx 10rpx;
  white-space: nowrap;
}

.crumb-row {
  display: inline-flex;
  align-items: center;
}

.crumb {
  font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 25rpx;
  color: var(--ink);
}

.crumb-sep {
  color: var(--gray);
  margin: 0 12rpx;
}

.entries {
  flex: 1;
  min-height: 0;
  padding: 10rpx 32rpx 0;
  box-sizing: border-box;
}

.entry {
  display: flex;
  align-items: center;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid var(--divider);
}

.entry-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.entry-body {
  flex: 1;
  min-width: 0;
}

.entry-name {
  font-size: 30rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-sub {
  font-size: 23rpx;
  color: var(--gray);
  margin-top: 4rpx;
}

.entry-chevron {
  width: 26rpx;
  height: 26rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.entry-spacer {
  height: 40rpx;
}

.empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray);
  font-size: 27rpx;
}

.empty.error {
  color: #E5484D;
}

.actions-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--divider);
  flex-shrink: 0;
  background: var(--surface);
}

.btn-text.strong {
  color: var(--ocean);
  font-weight: 600;
}

/* ---------- 深色补充覆盖（跟随微信 darkmode） ---------- */

@media (prefers-color-scheme: dark) {
  .entry-chevron {
    opacity: 0.5;
    filter: invert(1);
  }
}
