<page-meta page-style="{{pageStyle}}" />
<view class="page picker {{themeClass}}">
  <!-- 目录浏览器（对齐 dsh-mobile v1.6.0 WorkspaceDirectoryBrowserSheet） -->
  <view class="dir-sheet">
    <view class="dir-sheet-handle"></view>

    <!-- 头部：新建文件夹 / 标题 / 取消 -->
    <view class="dir-head">
      <view class="dir-head-btn tap {{dirLoading || dirCreatingWs || dirCreatingDir || !dirPath ? 'disabled' : ''}}" bindtap="newDirectory">
        <image class="dir-head-folder" src="/assets/icons/{{theme === 'dark' ? 'ic-dir-folder-white' : 'ic-dir-folder-ink'}}.png"/>
        <view class="dir-head-badge"><text>+</text></view>
      </view>
      <text class="dir-head-title">选择工作区目录</text>
      <view class="dir-head-cancel tap" bindtap="goBack">取消</view>
    </view>

    <!-- 当前目录 -->
    <view class="dir-cwd">
      <text class="dir-cwd-label">当前目录</text>
      <text class="dir-cwd-path text-mono">{{dirPath || '正在读取…'}}</text>
    </view>

    <!-- 目录列表卡片 -->
    <view class="dir-list-card">
      <scroll-view class="dir-list" scroll-y scroll-into-view="{{scrollInto}}">
        <view wx:if="{{dirLoading && !dirEntries.length}}" class="dir-loading">
          <view class="dir-spinner"></view>
          <text>正在读取远程目录…</text>
        </view>
        <view wx:elif="{{dirError}}" class="dir-loading dir-error">{{dirError}}</view>
        <block wx:else>
          <view id="dir-parent" class="dir-row {{parentPath ? '' : 'disabled'}}" hover-class="dir-row-hover" bindtap="goParentDir">
            <view class="dir-row-icon"><image class="dir-row-ic" src="/assets/icons/ic-dir-parent-ocean.png"/></view>
            <view class="dir-row-body">
              <text class="dir-row-name">..</text>
              <text class="dir-row-sub">返回上一级</text>
            </view>
            <image class="dir-row-chev" src="/assets/icons/ic-dir-chevron-mist.png"/>
          </view>
          <view class="dir-divider"></view>
          <block wx:if="{{!dirEntries.length && !dirLoading}}">
            <view class="dir-empty">此目录没有子文件夹</view>
          </block>
          <block wx:for="{{dirEntries}}" wx:key="path">
            <view
              id="dir-{{index}}"
              class="dir-row {{item.highlight ? 'highlight' : ''}}"
              hover-class="dir-row-hover"
              bindtap="openDirEntry"
              data-index="{{index}}"
            >
              <view class="dir-row-icon">
                <image class="dir-row-ic" src="/assets/icons/ic-dir-folder-ocean.png"/>
                <image wx:if="{{item.hidden}}" class="dir-row-badge" src="/assets/icons/ic-dir-badge-question.png"/>
              </view>
              <view class="dir-row-body">
                <text class="dir-row-name">{{item.name}}</text>
                <text wx:if="{{item.hidden}}" class="dir-row-sub">隐藏目录</text>
              </view>
              <image class="dir-row-chev" src="/assets/icons/ic-dir-chevron-mist.png"/>
            </view>
            <view wx:if="{{index < dirEntries.length - 1}}" class="dir-divider"></view>
          </block>
        </block>
      </scroll-view>
    </view>

    <!-- 底部创建栏 -->
    <view class="dir-create-bar">
      <text wx:if="{{dirPath}}" class="dir-create-path text-mono">{{dirPath}}</text>
      <view class="dir-create-btn {{dirPath && !dirCreatingWs && !dirCreatingDir && !dirLoading ? '' : 'disabled'}}" bindtap="createWorkspaceHere">
        <view wx:if="{{dirCreatingWs}}" class="dir-spinner light"></view>
        <image wx:else class="dir-create-add" src="/assets/icons/ic-dir-add-white.png"/>
        <text>在当前目录创建工作区</text>
      </view>
      <view wx:if="{{dirCreatingDir}}" class="dir-creating-hint">
        <view class="dir-spinner small"></view>
        <text>正在创建文件夹…</text>
      </view>
    </view>
  </view>
</view>
