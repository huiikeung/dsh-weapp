<!-- 卡片外观弹窗：悬浮 / 光线 / 描边 / 圆角（自带主题容器，否则浅色规则匹配不到） -->
<view class="{{themeClass}}">
<view wx:if="{{cardStyleOpen}}" class="glass-style-mask {{settingsGlassSheetEnabled ? '' : 'glass-style-mask-pass'}}" catchtap="closeCardStyleSheet" catchtouchmove="noop"></view>
  <view wx:if="{{cardStyleOpen}}" class="glass-style-sheet {{settingsGlassSheetEnabled ? '' : 'native-skin'}}" catchtap="noop" role="dialog" aria-label="{{ui['卡片样式设置']}}">
    <view wx:if="{{settingsGlassSheetEnabled}}" class="sheet-grabber"></view>
    <view class="glass-style-head">
      <text class="glass-style-title">{{ui['卡片样式设置']}}</text>
      <view class="glass-style-actions">
        <view class="glass-style-reset tap" catchtap="resetCardStyle" role="button">{{ui['重置为默认']}}</view>
        <view class="glass-style-done tap" catchtap="closeCardStyleSheet" role="button">{{ui['完成']}}</view>
      </view>
    </view>
    <view class="card-style-mode" role="tablist" aria-label="{{ui['卡片样式设置']}}">
      <view class="card-style-mode-btn {{cardStyleMode === 'light' ? 'on' : ''}}" bindtap="switchCardStyleMode" data-mode="light" role="button" aria-pressed="{{cardStyleMode === 'light'}}">{{ui['浅色']}}</view>
      <view class="card-style-mode-btn {{cardStyleMode === 'dark' ? 'on' : ''}}" bindtap="switchCardStyleMode" data-mode="dark" role="button" aria-pressed="{{cardStyleMode === 'dark'}}">{{ui['深色']}}</view>
    </view>
    <view class="card-preview-stage plain">
      <view class="card-preview-card" style="border-radius: {{cardRadiusRpx}}; {{cardPreviewStyle}}">
        <view class="card-preview-dot"></view>
        <view class="card-preview-copy">
          <text class="card-preview-title">{{ui['预览']}}</text>
          <text wx:if="{{cardStyleMode === 'light'}}" class="card-preview-sub">{{ui['悬浮']}} {{cardFloat}} · {{ui['底色']}} {{cardFill}} · {{ui['光线']}} {{cardLight}} · {{ui['柔光']}} {{cardGlow}} · {{ui['描边']}} {{cardEdge}} · {{ui['圆角']}} {{cardRadius}}rpx</text>
          <text wx:else class="card-preview-sub">{{ui['悬浮']}} {{cardFloat}} · {{ui['底色']}} {{cardFill}} · {{ui['描边']}} {{cardEdge}} · {{ui['圆角']}} {{cardRadius}}rpx</text>
        </view>
      </view>
    </view>
      <view class="glass-alpha-row">
        <text class="glass-style-label">{{ui['悬浮']}}</text>
        <view class="glass-alpha-control">
          <slider class="glass-alpha-slider" min="{{cardFloatMin}}" max="{{cardFloatMax}}" step="1" value="{{cardFloat}}" activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}" backgroundColor="rgba(150, 150, 155, 0.35)" block-size="22" aria-label="{{ui['悬浮']}}" data-field="float" bindchanging="onCardStyleChanging" bindchange="onCardStyleChange"/>
          <text class="glass-alpha-value">{{cardFloat}}%</text>
        </view>
      </view>
      <view class="glass-alpha-row">
        <text class="glass-style-label">{{ui['底色']}}</text>
        <view class="glass-alpha-control">
          <slider class="glass-alpha-slider" min="{{cardFillMin}}" max="{{cardFillMax}}" step="1" value="{{cardFill}}" activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}" backgroundColor="rgba(150, 150, 155, 0.35)" block-size="22" aria-label="{{ui['底色']}}" data-field="fill" bindchanging="onCardStyleChanging" bindchange="onCardStyleChange"/>
          <text class="glass-alpha-value">{{cardFill}}%</text>
        </view>
      </view>
      <view wx:if="{{cardStyleMode === 'light'}}" class="glass-alpha-row">
        <text class="glass-style-label">{{ui['光线']}}</text>
        <view class="glass-alpha-control">
          <slider class="glass-alpha-slider" min="{{cardLightMin}}" max="{{cardLightMax}}" step="1" value="{{cardLight}}" activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}" backgroundColor="rgba(150, 150, 155, 0.35)" block-size="22" aria-label="{{ui['光线']}}" data-field="light" bindchanging="onCardStyleChanging" bindchange="onCardStyleChange"/>
          <text class="glass-alpha-value">{{cardLight}}%</text>
        </view>
      </view>
      <view wx:if="{{cardStyleMode === 'light'}}" class="glass-alpha-row">
        <text class="glass-style-label">{{ui['柔光']}}</text>
        <view class="glass-alpha-control">
          <slider class="glass-alpha-slider" min="{{cardGlowMin}}" max="{{cardGlowMax}}" step="1" value="{{cardGlow}}" activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}" backgroundColor="rgba(150, 150, 155, 0.35)" block-size="22" aria-label="{{ui['柔光']}}" data-field="glow" bindchanging="onCardStyleChanging" bindchange="onCardStyleChange"/>
          <text class="glass-alpha-value">{{cardGlow}}%</text>
        </view>
      </view>
      <view class="glass-alpha-row">
        <text class="glass-style-label">{{ui['描边']}}</text>
        <view class="glass-alpha-control">
          <slider class="glass-alpha-slider" min="{{cardEdgeMin}}" max="{{cardEdgeMax}}" step="1" value="{{cardEdge}}" activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}" backgroundColor="rgba(150, 150, 155, 0.35)" block-size="22" aria-label="{{ui['描边']}}" data-field="edge" bindchanging="onCardStyleChanging" bindchange="onCardStyleChange"/>
          <text class="glass-alpha-value">{{cardEdge}}%</text>
        </view>
      </view>
      <view class="glass-alpha-row">
        <text class="glass-style-label">{{ui['圆角']}}</text>
        <view class="glass-alpha-control">
          <slider class="glass-alpha-slider" min="{{cardRadiusMin}}" max="{{cardRadiusMax}}" step="1" value="{{cardRadius}}" activeColor="{{theme === 'dark' ? '#FFFFFF' : '#10131A'}}" backgroundColor="rgba(150, 150, 155, 0.35)" block-size="22" aria-label="{{ui['圆角']}}" data-field="radius" bindchanging="onCardStyleChanging" bindchange="onCardStyleChange"/>
          <text class="glass-alpha-value">{{cardRadius}}rpx</text>
        </view>
      </view>
  </view>
</view>

<!-- 兑换码「可兑换次数」：居中弹窗 -->
<view wx:if="{{codeCountPickerOpen}}" class="code-modal-mask {{themeClass}}" catchtap="closeCodeCountPicker" catchtouchmove="noop">
  <view class="code-modal" catchtap="noop" role="dialog" aria-label="{{ui['可兑换次数']}}">
    <view class="code-modal-head">
