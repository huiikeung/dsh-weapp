/* Start at the input card's actual top, including keyboard/attachment changes. */
.composer-surface { position: relative; flex-shrink: 0; min-width: 0; }
.composer-backdrop {
  position: absolute;
  left: -28rpx;
  right: -28rpx;
  top: 0;
