    <view class="status-style-footer">{{ui['只改变文字流光 · 自动保存']}}</view>
  </view>
</view>

<view wx:if="{{procIconSheetOpen}}" class="status-style-mask {{themeClass}}" catchtap="closeProcIcons" catchtouchmove="noop">
