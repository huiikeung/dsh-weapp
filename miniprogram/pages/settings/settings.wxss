.work-step-menu-mask { position:fixed;inset:0;z-index:80;background:transparent; }
.work-step-menu { position:absolute;right:0;top:100rpx;z-index:81;min-width:240rpx;padding:8rpx;background:var(--surface);border:1rpx solid var(--border);border-radius:24rpx;box-shadow:0 10rpx 40rpx rgba(0,0,0,.12); }
.work-step-option { display:flex;align-items:center;justify-content:space-between;gap:28rpx;min-height:76rpx;padding:8rpx 20rpx;font-size:26rpx; }
