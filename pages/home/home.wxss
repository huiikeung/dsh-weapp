.manual-sec-desc {
  font-size: 30rpx;
  line-height: 1.5;
  color: rgba(241, 244, 250, 0.52);
  margin: 12rpx 0 44rpx;
}

.manual-input {
  width: 100%;
  min-height: 420rpx;
  box-sizing: border-box;
  background: rgba(241, 244, 250, 0.025);
  border: 1rpx solid rgba(241, 244, 250, 0.10);
  border-radius: 40rpx;
  padding: 32rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: rgba(241, 244, 250, 0.88);
}

.manual-input-ph {
  color: rgba(241, 244, 250, 0.25);
}

.manual-result {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.manual-result.connecting {
  color: var(--mist);
}

.manual-result.error {
  color: #FF8589;
}

.manual-connect {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100rpx;
  border-radius: 32rpx;
  background: var(--ocean);
  margin-top: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.manual-connect.disabled {
  background: rgba(46, 107, 230, 0.45);
}

.manual-connect-ic {
  width: 40rpx;
  height: 40rpx;
  margin-right: 18rpx;
}

.small-spin {
  width: 38rpx;
  height: 38rpx;
  border-width: 3rpx;
  margin-right: 18rpx;
}
