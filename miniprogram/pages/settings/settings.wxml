        <view class="status-style-option-head"><text class="status-style-label">{{ui[item.label] !== undefined ? ui[item.label] : item.label}}</text><text class="status-style-check">{{statusAppearance === item.id ? ui['已选择'] : ''}}</text></view>
        <view class="status-style-preview status-look-{{item.id}}"><view class="status-tail"><canvas type="2d" id="statusPreviewCanvas-{{item.id}}" class="status-tail-canvas" style="width:28rpx;height:28rpx;"></canvas></view><view class="status-text-motion"><text class="status-gradient" style="{{theme === 'dark' ? item.darkStyle : item.lightStyle}}">{{ui['正在思考，用时 12 秒…']}}</text></view></view>
        <view class="status-style-description">{{item.detail}}</view>
      </view>
