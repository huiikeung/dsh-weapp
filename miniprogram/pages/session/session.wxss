.session-menu-mask.is-open .session-menu { transform: translateY(0); }
.session-menu-grabber-zone { padding: 10rpx 0 6rpx; margin: -10rpx 0 0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
