          <view wx:for="{{sheetGateway.accounts}}" wx:for-item="account" wx:key="id" class="cost-gateway-account">
            <text class="cost-gateway-label">{{account.label}} · {{account.provider}}</text>
            <view wx:for="{{account.rows}}" wx:for-item="win" wx:key="key" class="cost-quota-row inline">
              <view class="cost-quota-head"><text class="cost-quota-label">{{win.label}}</text><text class="cost-quota-percent">{{win.percentText}}</text></view>
              <view class="cost-progress"><view class="cost-progress-fill" style="width:{{win.barWidth}};"></view></view>
            </view>
          </view>
        </block>
        <view class="cost-divider"></view>
        <view class="cost-row">
          <view class="cost-row-copy"><text class="cost-row-label">{{ui['允许非回环 HTTP']}}</text></view>
          <switch color="#16856D" checked="{{sheetGateway.allowInsecureHttp}}" data-index="{{sheetGateway.index}}" bindchange="onGatewayInsecure"/>
        </view>
        <view class="cost-field">
          <text class="cost-field-label">{{ui['允许的主机']}}<text class="cost-field-optional">{{ui['逗号分隔']}}</text></text>
          <input class="cost-field-input" value="{{sheetGateway.allowedHostsText}}" data-index="{{sheetGateway.index}}" data-field="allowedHostsText" bindinput="onGatewayFieldInput" bindblur="onGatewayFieldBlur" maxlength="255"/>
        </view>
        <view class="cost-divider"></view>
        <view class="cost-field">
          <text class="cost-field-label">{{ui['Management Key']}}<text class="cost-field-optional">{{ui['保存在电脑端凭据库']}}</text></text>
          <block wx:if="{{sheetGateway.keyConfigured && !keyEditing}}">
            <view class="cost-credential-btn" bindtap="editGatewayKey" role="button">{{ui['编辑凭据']}}</view>
            <text class="cost-field-hint">{{ui['已配置：密钥只写入电脑端 DSH 凭据库，不回显']}}</text>
          </block>
          <block wx:else>
            <input class="cost-field-input" type="text" value="{{sheetGateway.keyDraft}}" data-index="{{sheetGateway.index}}" bindinput="onGatewayKeyInput" bindblur="onGatewayKeyBlur" placeholder="{{ui['输入密钥']}}" maxlength="4096"/>
            <view class="cost-key-actions">
              <button class="cost-key-btn" bindtap="saveGatewayKey" data-index="{{sheetGateway.index}}">{{ui['保存']}}</button>
              <button wx:if="{{sheetGateway.keyConfigured}}" class="cost-key-btn ghost" bindtap="clearGatewayKey" data-index="{{sheetGateway.index}}">{{ui['清除']}}</button>
            </view>
          </block>
        </view>
        <view class="cost-row-buttons">
          <view class="cost-mini-btn" bindtap="saveGateway" data-index="{{sheetGateway.index}}">{{ui['保存该来源设置']}}</view>
          <view class="cost-mini-btn danger" bindtap="removeGateway" data-index="{{sheetGateway.index}}">{{ui['删除']}}</view>
        </view>
      </scroll-view>
      <view class="cost-sheet-foot">
        <view class="cost-sheet-btn" bindtap="refreshGateway" data-index="{{sheetGateway.index}}" role="button">{{ui['刷新']}}</view>
        <view class="cost-sheet-btn primary" bindtap="closeSheet" role="button">{{ui['完成']}}</view>
      </view>
    </view>
  </view>

  <!-- ============ 弹窗：自定义余额配置 ============ -->
  <view wx:if="{{sheet === 'custom'}}" class="cost-sheet-mask" bindtap="closeSheet">
    <view class="cost-sheet {{sheetDragging ? 'dragging' : ''}}" style="transform: translateY({{sheetDragY}}px);" catchtap="noop">
      <view class="cost-sheet-grabber" catchtouchstart="onSheetGrabStart" catchtouchmove="onSheetGrabMove" catchtouchend="onSheetGrabEnd" aria-hidden="true">
        <view class="cost-sheet-grabbar"></view>
      </view>
      <view class="cost-sheet-head">
        <text class="cost-sheet-title">{{sheetCustom.label || ui['自定义余额']}}</text>
        <view class="cost-sheet-close" bindtap="closeSheet" role="button" aria-label="{{ui['关闭']}}">✕</view>
      </view>
      <scroll-view scroll-y class="cost-sheet-body">
        <!-- ============ 开关 ============ -->
        <view class="cost-card">
          <view class="cost-row">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['启用']}}</text><text class="cost-row-hint">{{sheetCustom.status === 'ok' ? sheetCustom.amountText : sheetCustom.message || ui['待刷新']}}</text></view>
            <switch color="#16856D" checked="{{sheetCustom.enabled}}" data-index="{{sheetCustom.index}}" bindchange="toggleCustom"/>
          </view>
          <view class="cost-divider"></view>
          <view class="cost-row" bindtap="pickCustomAdapter" data-index="{{sheetCustom.index}}" role="button">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['类型']}}</text></view>
            <view class="cost-row-value">{{sheetCustom.adapter === 'aliyun' ? '阿里云余额' : sheetCustom.adapter === 'tokenrhythm' ? 'Token Rhythm' : ui['自定义 HTTP']}}<text class="cost-chevron">›</text></view>
          </view>
        </view>

        <!-- ============ 基本信息 ============ -->
        <view class="cost-sheet-section">{{ui['基本信息']}}</view>
        <view class="cost-card">
          <view class="cost-field">
            <text class="cost-field-label">{{ui['名称']}}</text>
            <input class="cost-field-input" value="{{sheetCustom.label}}" data-index="{{sheetCustom.index}}" data-field="label" bindinput="onCustomFieldInput" bindblur="onCustomFieldBlur" placeholder="{{ui['例如：赛博']}}" maxlength="40"/>
          </view>
          <view class="cost-divider"></view>
          <view class="cost-field">
            <text class="cost-field-label">{{ui['英文名称']}}<text class="cost-field-optional">{{ui['可选']}}</text></text>
            <input class="cost-field-input" value="{{sheetCustom.labelEn}}" data-index="{{sheetCustom.index}}" data-field="labelEn" bindinput="onCustomFieldInput" bindblur="onCustomFieldBlur" placeholder="saibo" maxlength="40"/>
          </view>
          <view class="cost-divider"></view>
          <view class="cost-field cost-field-inline">
            <text class="cost-field-label">{{ui['单位']}}</text>
            <input class="cost-field-input short" value="{{sheetCustom.unit}}" data-index="{{sheetCustom.index}}" data-field="unit" bindinput="onCustomFieldInput" bindblur="onCustomFieldBlur" placeholder="USD" maxlength="16"/>
          </view>
          <view class="cost-divider"></view>
          <view class="cost-row" bindtap="pickCustomDisplay" data-index="{{sheetCustom.index}}" role="button">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['显示位置']}}</text></view>
            <view class="cost-row-value">{{sheetCustom.displayLabel}}<text class="cost-chevron">›</text></view>
          </view>
          <view class="cost-divider"></view>
          <view class="cost-row" bindtap="pickCustomRefresh" data-index="{{sheetCustom.index}}" role="button">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['刷新间隔']}}</text></view>
            <view class="cost-row-value">{{sheetCustom.refreshMinutes}} {{ui['分钟']}}<text class="cost-chevron">›</text></view>
          </view>
        </view>

        <!-- ============ 接口请求（仅自定义 HTTP） ============ -->
        <block wx:if="{{sheetCustom.adapter === 'custom'}}">
          <view class="cost-sheet-section">{{ui['接口请求']}}</view>
          <view class="cost-card">
            <view class="cost-field">
              <text class="cost-field-label">{{ui['接口地址']}}</text>
              <input class="cost-field-input" value="{{sheetCustom.request.url}}" data-index="{{sheetCustom.index}}" data-field="url" bindinput="onCustomRequestInput" bindblur="onCustomRequestBlur" placeholder="https://api.example.com/balance" maxlength="2048"/>
            </view>
            <view class="cost-divider"></view>
            <view class="cost-row" bindtap="pickCustomMethod" data-index="{{sheetCustom.index}}" role="button">
              <view class="cost-row-copy"><text class="cost-row-label">{{ui['请求方法']}}</text></view>
              <view class="cost-row-value">{{sheetCustom.request.method}}<text class="cost-chevron">›</text></view>
            </view>
            <view class="cost-divider"></view>
            <view class="cost-field">
              <text class="cost-field-label">{{ui['请求头']}}<text class="cost-field-optional">{{ui['JSON，支持变量占位']}}</text></text>
              <textarea class="cost-field-input cost-field-textarea cost-field-mono" value="{{sheetCustom.headersText}}" data-index="{{sheetCustom.index}}" data-field="headersText" bindinput="onCustomFieldInput" bindblur="onCustomFieldBlur" placeholder="{{ui['请求头默认模板']}}" maxlength="4096" cursor-spacing="24" show-confirm-bar="{{false}}"/>
            </view>
            <view wx:if="{{sheetCustom.request.method !== 'GET'}}">
              <view class="cost-divider"></view>
              <view class="cost-field">
                <text class="cost-field-label">{{ui['请求体']}}<text class="cost-field-optional">{{ui['JSON，留空不发送']}}</text></text>
                <textarea class="cost-field-input cost-field-textarea cost-field-mono" value="{{sheetCustom.bodyText}}" data-index="{{sheetCustom.index}}" data-field="body" bindinput="onCustomRequestInput" bindblur="onCustomRequestBlur" placeholder="{}" maxlength="8192" cursor-spacing="24" show-confirm-bar="{{false}}"/>
              </view>
            </view>
          </view>
        </block>

        <!-- ============ 解析规则 ============ -->
        <view class="cost-sheet-section">{{ui['解析规则']}}<text class="cost-section-note">{{ui['JSON 路径，可用 op:path|path']}}</text></view>
        <view class="cost-card">
          <view class="cost-field">
            <text class="cost-field-label">{{ui['解析规则']}}<text class="cost-field-optional">{{ui['留空则不解析']}}</text></text>
            <textarea class="cost-field-input cost-field-textarea cost-field-mono" value="{{sheetCustom.extractText}}" data-index="{{sheetCustom.index}}" data-field="extractText" bindinput="onCustomFieldInput" bindblur="onCustomFieldBlur" placeholder="{{ui['解析规则默认模板']}}" maxlength="4096" cursor-spacing="24" show-confirm-bar="{{false}}"/>
            <text wx:if="{{sheetCustom.extractError}}" class="cost-field-error">{{sheetCustom.extractError}}</text>
          </view>
        </view>

        <!-- ============ 高级 ============ -->
        <view class="cost-sheet-section">{{ui['高级']}}</view>
        <view class="cost-card">
          <view class="cost-row">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['按显示币种折算']}}</text></view>
            <switch color="#16856D" checked="{{sheetCustom.convertToDisplayCurrency}}" data-index="{{sheetCustom.index}}" bindchange="onCustomConvert"/>
          </view>
          <view class="cost-divider"></view>
          <view class="cost-row">
            <view class="cost-row-copy"><text class="cost-row-label">{{ui['允许非回环 HTTP']}}</text></view>
            <switch color="#16856D" checked="{{sheetCustom.allowInsecureHttp}}" data-index="{{sheetCustom.index}}" bindchange="onCustomInsecure"/>
          </view>
          <view class="cost-divider"></view>
          <view class="cost-field">
            <text class="cost-field-label">{{ui['允许的主机']}}<text class="cost-field-optional">{{ui['逗号分隔']}}</text></text>
            <input class="cost-field-input" value="{{sheetCustom.allowedHostsText}}" data-index="{{sheetCustom.index}}" data-field="allowedHostsText" bindinput="onCustomFieldInput" bindblur="onCustomFieldBlur" placeholder="saibo.xytnb.xyz" maxlength="255"/>
          </view>
          <view class="cost-divider"></view>
          <view class="cost-field">
            <text class="cost-field-label">{{ui['密钥值']}}<text class="cost-field-optional">{{sheetCustom.keyVarLabel}}</text></text>
            <block wx:if="{{sheetCustom.keyConfigured && !keyEditing}}">
              <view class="cost-credential-btn" bindtap="editCustomKey" role="button">{{ui['编辑凭据']}}</view>
              <text class="cost-field-hint">{{ui['已配置：密钥只写入电脑端 DSH 凭据库，不回显']}}</text>
            </block>
            <block wx:else>
              <input class="cost-field-input" type="text" value="{{sheetCustom.keyDraft}}" data-index="{{sheetCustom.index}}" bindinput="onCustomKeyInput" bindblur="onCustomKeyBlur" placeholder="{{ui['输入密钥']}}" maxlength="4096"/>
              <view class="cost-key-actions">
                <button class="cost-key-btn" bindtap="saveCustomKey" data-index="{{sheetCustom.index}}">{{ui['保存']}}</button>
                <button wx:if="{{sheetCustom.keyConfigured}}" class="cost-key-btn ghost" bindtap="clearCustomKey" data-index="{{sheetCustom.index}}">{{ui['清除']}}</button>
              </view>
            </block>
          </view>
        </view>

        <view class="cost-row-buttons">
          <view class="cost-mini-btn" bindtap="saveCustom" data-index="{{sheetCustom.index}}">{{ui['保存该条配置']}}</view>
          <view class="cost-mini-btn danger" bindtap="removeCustom" data-index="{{sheetCustom.index}}">{{ui['删除']}}</view>
        </view>
      </scroll-view>
      <view class="cost-sheet-foot">
        <view class="cost-sheet-btn" bindtap="refreshCustom" data-index="{{sheetCustom.index}}" role="button">{{ui['刷新']}}</view>
        <view class="cost-sheet-btn primary" bindtap="closeSheet" role="button">{{ui['完成']}}</view>
      </view>
    </view>
  </view>
</view>
