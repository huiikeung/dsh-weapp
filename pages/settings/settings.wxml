<page-meta page-style="{{pageStyle}}" />
<view class="page settings {{themeClass}}">
  <!-- 自定义导航：与右上角胶囊同一水平线，避免原生导航在手动深色时露白 -->
  <view class="nav" style="padding-top:{{navPadTop}}px;height:{{navHeight}}px;">
    <view class="nav-back tap" bindtap="goBack" hover-class="press-dim" role="button" aria-label="返回">
      <image class="nav-back-ic" src="/assets/icons/{{theme === 'dark' ? 'back-white.png' : 'back-black.png'}}"/>
    </view>
    <text class="nav-title">设置</text>
  </view>

  <!-- 两个独立入口，具体操作只放在各自面板内。 -->
  <view class="group-title">公网访问</view>
  <view class="card">
    <view class="card-row management-entry" bindtap="openPublicAccess" hover-class="management-entry-active" role="button" aria-label="公网访问">
      <view class="management-entry-copy">
        <text class="card-row-label">{{publicExpiryLabel || '公网访问'}}</text>
        <text class="management-entry-desc">兑换公网有效期 · 不影响局域网</text>
      </view>
      <view class="card-row-value management-entry-value">
        <text>{{publicStatusLabel}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
  </view>

  <view class="group-title">节点管理</view>
  <view class="card">
    <view class="card-row management-entry" bindtap="openNodeManagement" hover-class="management-entry-active" role="button" aria-label="节点管理">
      <view class="management-entry-copy">
        <text class="card-row-label">{{activeNodeName || '节点管理'}}</text>
        <text class="management-entry-desc">{{onlineNodeCount}} 个在线 · 扫码或输入配对信息</text>
      </view>
      <view class="card-row-value management-entry-value">
        <text>{{nodeCount}} 个</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
  </view>

  <block wx:if="{{isWechatAdmin}}">
  <view class="group-title">微信身份</view>
  <view class="card">
    <view class="card-row management-entry">
      <view class="management-entry-copy">
        <text class="card-row-label">当前身份</text>
        <text class="management-entry-desc">{{accountHint}}</text>
      </view>
      <view class="card-row-value management-entry-value">
        <text>{{accountLabel}}</text>
      </view>
    </view>
  </view>
  </block>
  <block wx:if="{{isWechatAdmin}}">
    <view class="group-title">管理员</view>
    <view class="card">
      <view class="card-row management-entry" bindtap="openCodeManagement" hover-class="management-entry-active" role="button">
        <view class="management-entry-copy">
          <text class="card-row-label">兑换码管理</text>
          <text class="management-entry-desc">生成、复制分发与删除</text>
        </view>
        <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
      </view>
      <view class="card-row management-entry" bindtap="openAnnouncementManagement" hover-class="management-entry-active" role="button">
        <view class="management-entry-copy"><text class="card-row-label">发布公告</text><text class="management-entry-desc">发布、编辑与删除 · 与后台同步</text></view>
        <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
      </view>
      <view class="card-row management-entry">
        <view class="management-entry-copy"><text class="card-row-label">分享活动</text><text class="management-entry-desc">{{shareSaving ? '正在保存…' : (contentLoaded ? '关闭后隐藏分享入口，已获时长不变' : (contentError || '正在同步设置…'))}}</text></view>
        <switch checked="{{referralEnabled}}" disabled="{{shareSaving || !contentLoaded || accountBusy}}" color="#2E6BE6" bindchange="toggleReferralSharing" aria-label="分享活动开关"/>
      </view>
      <view wx:if="{{contentError}}" class="card-row" bindtap="refreshAppContent" hover-class="management-entry-active" role="button"><text class="card-row-label">重试同步分享设置</text></view>
    </view>
  </block>

  <!-- 外观模式（对齐 dsh-mobile v1.6.0 InterfaceStyleSettingsRow） -->
  <view class="group-title">外观</view>
  <view class="card">
    <view class="card-row" bindtap="pickAppearance">
      <text class="card-row-label">界面</text>
      <view class="card-row-value">
        <text>{{appearanceLabel}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
    <view class="card-row" bindtap="pickLanguage">
      <text class="card-row-label">语言</text>
      <view class="card-row-value">
        <text>{{languageLabel}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
    <view class="card-row" bindtap="pickFontSize">
      <text class="card-row-label">字体大小</text>
      <view class="card-row-value">
        <text>{{fontSizeLabel}}</text>
        <image class="chevron-img" src="/assets/icons/chev-right-gray.png"/>
      </view>
    </view>
  </view>


  <view class="group-title">实验性功能</view>
  <view class="card">
    <view class="card-row">
      <view class="exp-copy">
        <text class="card-row-label">订阅通知</text>
        <text class="exp-desc">发送任务后申请订阅消息授权，回合完成时通过服务通知提醒</text>
      </view>
      <switch checked="{{notifyEnabled}}" color="#2E6BE6" bindchange="toggleNotify"/>
    </view>
  </view>
  <view class="group-hint">实验性功能默认关闭，可能随基础库版本变化不稳定，仅供试用。</view>

  <view class="group-title">关于</view>
  <view class="card">
    <view class="card-row management-entry" bindtap="openAnnouncements" hover-class="management-entry-active" role="button">
      <text class="card-row-label">开发者公告</text>
      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
    <button class="card-row about-contact" open-type="contact" session-from="whaletail-settings" binderror="onContactError" hover-class="management-entry-active">
      <text class="card-row-label">联系客服</text>
      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </button>
    <view class="card-row">
      <text class="card-row-label">客户端</text>
      <text class="card-row-value">鲸尾助手小程序版</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">当前版本</text>
      <text class="card-row-value">{{appVersion}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">要求网关版本</text>
      <text class="card-row-value about-version-value">{{minGatewayVersion}}</text>
    </view>
    <view class="card-row">
      <text class="card-row-label">已连接网关版本</text>
      <text class="card-row-value">{{connectedGatewayVersion}}</text>
    </view>
    <view class="card-row" bindtap="openPrivacyPolicy" role="button" aria-label="查看隐私政策">
      <text class="card-row-label">隐私政策</text>
      <view class="card-row-value"><image class="chevron-img" src="/assets/icons/chev-right-gray.png"/></view>
    </view>
  </view>
  <view class="group-hint">{{gatewayVersionHint}}</view>
  <privacy-sheet id="settings-privacy" visible="{{privacyOpen}}" theme="{{theme}}" bindclose="closePrivacyPolicy" />

  <view wx:if="{{managementPanel && !pairSheetOpen}}" class="pair-sheet-mask" catchtap="closeManagementPanel" catchtouchmove="noop">
    <view class="pair-sheet management-sheet" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">{{managementPanel === 'public' ? '公网访问' : (managementPanel === 'gateway' ? '网关连接' : '节点管理')}}</text>
          <text class="pair-sheet-subtitle">{{managementPanel === 'public' ? '管理当前微信账号的公网有效期' : (managementPanel === 'gateway' ? nodeDetail.name : '点击节点查看连接信息与操作')}}</text>
        </view>
        <text class="pair-sheet-close" bindtap="closeManagementPanel" role="button">{{managementPanel === 'gateway' ? '返回' : '关闭'}}</text>
      </view>
      <scroll-view scroll-y enhanced class="management-scroll">
        <block wx:if="{{managementPanel === 'public'}}">
          <view class="card public-card">
            <view class="public-head">
              <image class="public-icon" src="/assets/icons/node-router.svg" mode="aspectFit"/>
              <view class="public-main">
                <text class="public-title">{{publicTitle}}</text>
                <text class="public-sub">{{publicSub}}</text>
              </view>
            </view>
            <view class="public-detail-row">
              <text class="public-detail-label">访问状态</text>
              <view class="public-pill {{publicOn ? 'on' : ''}}">
                <view class="public-pill-dot"></view>
                <text>{{publicStatusLabel}}</text>
              </view>
            </view>
            <view class="public-detail-row public-device-row">
              <text class="public-detail-label">设备ID</text>
              <text class="public-device-value text-mono" selectable>{{accountDeviceId || (accountBusy ? '识别中…' : (accountIdHint || '暂未识别，请重试'))}}</text>
              <text wx:if="{{accountDeviceId}}" class="public-copy-id" data-id="{{accountDeviceId}}" bindtap="copyNodeId">复制</text>
            </view>
            <view wx:if="{{publicExpiryLabel}}" class="public-detail-row">
              <text class="public-detail-label">访问有效期</text>
              <text class="public-detail-value">{{publicExpiryLabel}}</text>
            </view>
            <view class="public-actions">
              <button wx:if="{{referralEnabled}}" class="public-share" bindtap="openReferralShare" hover-class="public-share-hover">分享</button>
              <button class="public-redeem" disabled="{{redeemBusy}}" bindtap="redeemRenewal" hover-class="public-share-hover">
                {{redeemBusy ? '兑换中…' : (redeemAvailable ? '兑换续期' : '兑换说明')}}
              </button>
            </view>
            <view wx:if="{{redeemResultLabel}}" class="public-redeem-result">{{redeemResultLabel}}</view>
            <view wx:if="{{referralEnabled && sharePayload}}" class="public-share-meta">
              <text class="public-share-expiry">{{shareExpiresLabel}}</text>
              <view class="public-share-actions">
                <button open-type="share">转发</button>
                <text class="public-share-copy" bindtap="copyNodeShare">复制邀请</text>
              </view>
            </view>
          </view>
          <view class="group-hint">{{publicHint}}</view>
        </block>
        <block wx:elif="{{managementPanel === 'nodes'}}">
          <view class="node-group-title">
            <text class="node-count">{{onlineNodeCount}} 在线 · {{nodeCount}} 个节点</text>
            <view class="node-head-actions">
              <text wx:if="{{!nodeEditMode}}" class="node-refresh" bindtap="refreshNodes" role="button">刷新</text>
              <text
                wx:if="{{nodeEditMode && nodeSelection.length}}"
                class="node-delete-inline"
                bindtap="deleteSelectedNodes"
                role="button"
              >{{nodeSelection.length > 1 ? '删除 ' + nodeSelection.length + ' 个' : '删除'}}</text>
              <text wx:if="{{nodes.length}}" class="node-edit-toggle" bindtap="toggleNodeEditMode" role="button">{{nodeEditMode ? '完成' : '编辑'}}</text>
            </view>
          </view>
          <view class="card node-list-card">
            <view wx:if="{{!nodes.length}}" class="node-empty">
              <text class="node-empty-title">还没有已配对节点</text>
              <text class="node-empty-desc">点击下方「添加节点」，按引导完成电脑端准备后扫码配对。</text>
            </view>
            <view wx:for="{{nodes}}" wx:key="id" class="node-row {{item.active ? 'node-row-active' : ''}}" data-id="{{item.id}}" bindtap="selectNode" hover-class="management-entry-active" role="button" aria-label="查看{{item.name}}连接详情">
              <view wx:if="{{nodeEditMode}}" class="node-select" catchtap="toggleNodeSelect" data-id="{{item.id}}">
                <image class="node-select-ic" src="/assets/icons/{{item.selected ? 'circle-filled-white.png' : 'circle-white.png'}}"/>
              </view>
              <view class="node-main">
                <view class="node-name-line">
                  <view class="status-dot {{item.online ? 'connected' : 'disconnected'}}"></view>
                  <text class="node-name">{{item.name}}</text>
                  <text wx:if="{{item.active}}" class="node-current">当前</text>
                </view>
                <text class="node-id text-mono">{{item.gatewayId || item.id}}</text>
              </view>
              <view class="node-actions">
                <text class="node-status">{{item.statusLabel}}</text>
                <text class="node-copy" data-id="{{item.gatewayId || item.id}}" catchtap="copyNodeId">复制 ID</text>
              </view>
              <image wx:if="{{!nodeEditMode}}" class="node-detail-chevron" src="/assets/icons/chev-right-gray.png"/>
            </view>
          </view>
          <view class="node-pair-actions">
            <button class="node-pair-button" bindtap="addNode" hover-class="node-add-active">
              <text class="node-add-plus">+</text>
              <text class="node-add-text">添加节点</text>
            </button>
          </view>
        </block>
        <block wx:elif="{{managementPanel === 'gateway' && nodeDetail}}">
          <view class="card gateway-detail-card">
            <view wx:if="{{nodeDetail.isPublic}}" class="card-row gateway-identity-row">
              <text class="gateway-identity-label">公网标识</text>
              <text class="gateway-identity-value text-mono" selectable>{{nodeDetail.identifier}}</text>
              <text class="node-copy gateway-copy" data-id="{{nodeDetail.identifier}}" bindtap="copyNodeId" role="button">复制</text>
            </view>
            <view wx:else class="card-row">
              <text class="card-row-label gw-url text-mono" selectable>{{nodeDetail.endpoint || '未配置'}}</text>
            </view>
            <view class="card-row gateway-status-row">
              <view class="card-row-label gw-status"><view class="status-dot {{nodeDetail.connection}}"></view><text>{{nodeDetail.connectionLabel}}</text></view>
              <view class="card-row-value"><text wx:if="{{!nodeDetail.isPublic && nodeDetail.port}}">Port {{nodeDetail.port}}</text><text wx:elif="{{nodeDetail.isPublic}}">公网连接</text></view>
            </view>
            <button wx:if="{{!nodeDetail.canDisconnect}}" class="card-row gateway-action" bindtap="connectNode" hover-class="management-entry-active"><text class="btn-text">{{nodeDetail.active ? '重新连接' : '连接此节点'}}</text></button>
            <button wx:else class="card-row gateway-action" bindtap="disconnect" hover-class="management-entry-active"><text class="btn-text">断开连接</text></button>
            <button class="card-row gateway-action" bindtap="pingGateway" disabled="{{!nodeDetail.canPing || nodePingBusy}}" hover-class="management-entry-active"><text class="btn-text">{{nodePingBusy ? 'Ping 检测中…' : 'Ping 网关'}}</text></button>
            <button class="card-row gateway-action" bindtap="forgetDevice" hover-class="management-entry-active"><text class="btn-text-danger">忘记此设备</text></button>
          </view>
          <view class="group-hint">{{nodeDetail.isPublic ? '通过公网标识识别节点，不展示公网地址。' : '局域网连接保留原地址与端口；不会消耗公网有效期。'}}</view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{referralSheetOpen}}" class="referral-mask" catchtap="closeReferralShare" catchtouchmove="noop">
    <view class="referral-sheet" catchtap="noop">
      <view class="sheet-grabber"></view>
      <text class="referral-title">分享</text>
      <text class="referral-subtitle">已累计获得 {{referralDays}} 天公网访问</text>
      <text wx:if="{{referralBusy || referralError}}" class="referral-subtitle">{{referralBusy ? '正在获取分享信息…' : referralError}}</text>
      <button class="referral-option" open-type="share" data-referral="true" disabled="{{!referralToken || referralBusy}}">
        <view class="referral-copy"><text>好友或群聊</text><text class="referral-desc">{{referralHint || '朋友首次有效打开后，自动增加公网时长'}}</text></view><text class="referral-chevron">›</text>
      </button>
      <button class="referral-option" bindtap="openMomentsActivity"><view class="referral-copy"><text>朋友圈</text><text class="referral-desc">保留满 24 小时，提交凭证审核领取</text></view><text class="referral-chevron">›</text></button>
      <button class="referral-rules" bindtap="openShareRules">活动规则</button>
      <button class="referral-cancel" bindtap="closeReferralShare">取消</button>
    </view>
  </view>
  <view wx:if="{{pairSheetOpen}}" class="pair-sheet-mask" catchtap="closePairSheet" catchtouchmove="noop">
    <view class="pair-sheet" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="pair-sheet-head">
        <view>
          <text class="pair-sheet-title">添加公网节点</text>
          <text class="pair-sheet-subtitle">粘贴插件提供的 Base64URL 配对信息</text>
        </view>
        <text class="pair-sheet-close" bindtap="closePairSheet">关闭</text>
      </view>
      <textarea
        class="pair-payload-input"
        value="{{pairingText}}"
        maxlength="20000"
        auto-height="{{false}}"
        placeholder="粘贴完整配对字符串"
        placeholder-class="pair-payload-placeholder"
        bindinput="onPairingInput"
        disabled="{{pairingConnecting}}"
      />
      <text wx:if="{{pairingError}}" class="pair-result {{pairingConnecting ? 'pair-result-pending' : ''}}">{{pairingError}}</text>
      <view class="pair-submit {{!pairingText || pairingConnecting ? 'pair-submit-disabled' : ''}}" bindtap="connectPublicNode">
        <text>{{pairingConnecting ? '连接中…' : '连接节点'}}</text>
      </view>
    </view>
  </view>
</view>
